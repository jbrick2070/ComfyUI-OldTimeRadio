# --- 2026-04-23 vendor hygiene ---
# Failed clone fragments (OneDrive blocked sandbox cleanup); we don't
# vendor external packs anyway (MIT reimplementation policy).  Belt +
# suspenders: anything under nodes/vendor/ is non-versioned.
nodes/vendor/
# Reference clones staged in /tmp during license-audit sessions
/tmp/otr_vendor_stage/

# --- 2026-04-30 AI-agent exhaust hygiene ---
# Recurring tail/scan helpers and their captured output, produced by
# the AI coding agent's PowerShell tailers.  These were polluting
# git status on every session (see 2026-04-30 round-robin QA report).
# Pattern-level ignore so they stop reappearing instead of one-shot
# cleanup.
.claude_tail_*
.tailer_*
.otr_tailer_*
.otr_*.tmp.*
_tail_*.ps1
_scan_*.ps1
_anomaly_scan.ps1
_episode_scan.ps1
_ledger_inspect.ps1
_progress.ps1
# Pytest output dumps
pytest_*.txt
# Backup workflow files (use git history instead)
workflows/*.json.bak

# --- 2026-04-30 QA tooling exemptions ---
# The blanket `scripts/_*.py` ignore above (line ~71) hid the
# consultation clients used by the round-robin pattern.  Force them
# back in by exception so future variants don't get silently dropped.
!scripts/_consult_openai.py
!scripts/_consult_nvidia.py
!scripts/_consult_round_robin.py

# --- 2026-06-05: the indextts2 Path-B worker is essential source, not a
# per-task script. It was scratch-only under `scripts/_*.py`, went missing, and
# silently broke the default char voice (node 81 failed closed). Keep it
# versioned by exception so it can never disappear again. ---
!scripts/_otr_indextts2_worker.py

# --- 2026-06-09 v1.4 capstone soak: essential source, not per-task scratch.
# The soak driver + the one-shot engine smoke + the verified launch recipe are
# the production-stable stamp's tooling -- keep them versioned by exception.
!scripts/_otr_soak_capstone.py
!scripts/_otr_single_engine_smoke.py
!scripts/_otr_soak_server_launch.cmd
!scripts/_otr_soak_marathon.py
# Per-image-engine live GPU smoke tools (the image counterpart to the video-only
# _otr_single_engine_smoke.py): drive the engine recipe via /prompt + measure the
# resident peak. Keep versioned by exception.
!scripts/_otr_lumina_image_smoke.py
!scripts/_otr_qwen_image_smoke.py

# --- 2026-05-04 BUG-LOCAL-090: news_history.json moved to
# <output>/otr/state/ ---
# The legacy <repo>/config/news_history.json is read-only-fallback for
# migration carry-forward. Pin it as ignored so the per-machine state
# never accidentally enters git history.
config/news_history.json

# --- 2026-05-08 stale-debris hygiene ---
# Catchalls that slipped past the existing patterns during 2026-05-08
# autonomous cleanup. .function_calls is an AI-tool exhaust file;
# outputs_scratch/ is a Cowork-side scratchpad mirror.
.function_calls
outputs_scratch/
outputs_scratch_*/

# --- 2026-05-30 temp git-diff dump hygiene ---
# Raw `git diff` captures (e.g. docs/s28_diff_tmp.txt, 3.9 MB) were committed
# by accident. Ignore the pattern so sprint diff dumps never re-enter.
*_diff_tmp.txt
docs/*_tmp.txt
# Untracked sprint QA-dump leftover that is OneDrive-locked on disk (removed
# from git in the docs prune; ignore so it stays out of `git status`).
docs/2026-05-13-S28-new-forbidden-hits.txt

# --- 2026-06-01 OpenRouter catalog cache ---
# The four-dropdown router caches the OpenRouter /models list at
# models/openrouter_models.json (per-machine discovery data, refreshed via
# scripts/otr_openrouter_refresh.py). Already covered by the models/ rule
# above; pinned explicitly so the cache file is unmistakably non-versioned.
models/openrouter_models.json


# --- 2026-06-04 root scratch hygiene (run/test/soak/bakeoff artifacts) ---
# These land in the repo root from test/soak/install runs. None are tracked;
# this just stops git from surfacing ~180 loose files in `git status`.
# Root-anchored (leading /) so tracked nodes/_otr_*.py SOURCE is unaffected.
# Real root files (requirements.txt, *.md docs, the workflow JSONs) are NOT matched.
/_otr_*
/*.DONE
/*_STOP
/*.err
/*.out
/*_results.jsonl

# --- 2026-06-06 matrix-run output hygiene ---
# scripts/_otr_matrix_out/ is generated test-matrix exhaust (logs, pytest
# captures, matrix_results.jsonl, MATRIX_DONE marker). Reproducible output,
# not source -- keep it on disk but out of git history and `git status`.
scripts/_otr_matrix_out/

# --- 2026-06-13 run-exhaust hygiene (soak / probe / sweep / motion-clip output) ---
# GPU soak/sweep/motion runs drop ~50 MB of reproducible output into scripts/ and
# docs/ every session: the 115-file soak-results dir, leg .err/.watchdog logs,
# coverage-sweep shards, run digests/reports, and LTX/Wan motion clips. NOT source.
# Deleted the 2026-06-12/13 batch from disk; pattern-ignore so they never re-clutter
# git status. Canonical renders live under output/otr/{episodes,obs} (already ignored
# via output/). Tracked READMEs inside the probe dirs stay tracked (ignore != untrack).
scripts/_otr_soak_capstone_results/
scripts/_otr_*_probes/
scripts/coverage_sweep*.json
scripts/coverage_sweep*.err
scripts/*.log.err
scripts/*.log.watchdog
scripts/overnight_soak_*.json
scripts/overnight_soak_*.md
scripts/*_digest.md
scripts/longterm_soak_*.md
scripts/_otr_ref_audit_report.json
docs/ltx_motion_clips/
docs/*/wan_clips/
*.webm

