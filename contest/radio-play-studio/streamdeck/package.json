{
  "name": "streamdeck-otr",
  "version": "0.1.0",
  "description": "Radio Play Studio on a Stream Deck +: dials pick the story, a key makes the episode and shows its progress",
  "license": "MIT",
  "type": "module",
  "author": "Jeffrey A. Brick",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbrick2070/ComfyUI-OldTimeRadio.git",
    "directory": "contest/radio-play-studio/streamdeck"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.jbrick2070.otr.sdPlugin",
    "link": "streamdeck link com.jbrick2070.otr.sdPlugin",
    "pack": "npm run build && streamdeck pack com.jbrick2070.otr.sdPlugin --output dist --force",
    "images": "esbuild scripts/render-static-images.ts --bundle --platform=node --format=esm --outfile=release/render-static-images.mjs --log-level=warning && node release/render-static-images.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "ignore": "7.0.14",
    "rollup": "^4.40.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
