     # which transformers routes through accelerate, yet it was never declared.
@@ -36,13 +39,21 @@
     # kokoro is the DEFAULT announcer voice in the shipped canonical workflow.
     # Without it a fresh install reaches its FIRST SPOKEN LINE and dies on
     # KPipeline.__init__() got an unexpected keyword argument 'repo_id'.
-    "kokoro>=0.7.16",
+    # Not installable on Python 3.13 (numpy==1.26.4 pin on 0.7.16; Requires-
