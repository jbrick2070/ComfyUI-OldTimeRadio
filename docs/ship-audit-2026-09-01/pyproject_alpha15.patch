@@ -19,7 +19,10 @@
     "beautifulsoup4>=4.12",
     "tokenizers>=0.22,<=0.23",
     "sentencepiece>=0.1.99",
-    "bitsandbytes>=0.42.0",
+    # CUDA-only library; no marker here blocked the whole registry install on
+    # macOS (2026-09-01 ship audit). The loader already fails loud when bnb is
+    # missing while quant_policy demands it.
+    "bitsandbytes>=0.42.0; sys_platform != 'darwin'",
     # See requirements.txt for the full note: the loader passes
