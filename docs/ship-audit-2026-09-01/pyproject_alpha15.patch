+    "kokoro>=0.7.16; python_version < '3.13'",
     # pyloudnorm is imported by scene_sequencer to master every episode to
     # -14 LUFS. Its import is try/except with a deliberate fallback, so a
     # missing install does not crash -- it quietly ships a differently
     # mastered, quieter episode and says so only in one warning line. That
     # silence is why it went unnoticed for so long.
     "pyloudnorm>=0.1.1",
+    # Imported by shipped nodes, declared only in requirements.txt until now
+    # (2026-09-01 ship audit: pycairo unguarded in scope_draw.py and
