#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
source /workspace/otr-config/otr-runtime.env
if [ -f /root/.otr_openrouter.env ]; then
  chmod 600 /root/.otr_openrouter.env
  set -a
  # shellcheck disable=SC1091
  source /root/.otr_openrouter.env
  set +a
fi
if [ -z "${OPENROUTER_API_KEY:-}" ]; then
  echo OPENROUTER_KEY_MISSING
  exit 7
fi
# Operator correction: ChatGPT on creative AND technical. Do not inherit
# the local OPENROUTER_MODEL_A=opus fallback.
export OPENROUTER_MODEL_A='~openai/gpt-latest'
export OPENROUTER_MODEL_B='~openai/gpt-latest'
export OPENROUTER_MAX_TOKENS_PER_RUN=800000
echo OPENROUTER_KEY_CHARS=${#OPENROUTER_API_KEY}
echo OPENROUTER_MODEL_A=$OPENROUTER_MODEL_A
echo OPENROUTER_MODEL_B=$OPENROUTER_MODEL_B

OTR="${OTR_REPO_ROOT:-/workspace/runpod-slim/ComfyUI/custom_nodes/ComfyUI-OldTimeRadio}"
PY="${COMFY_PY:-/workspace/runpod-slim/ComfyUI/.venv-py313/bin/python}"
LOG=/workspace/otr-config/foley_mystory_3act_chatgpt.log
COMFY_LOG=/workspace/otr-config/comfy_8188.log

cd "$OTR"
git fetch origin main
git reset --hard origin/main
echo AFTER=$(git log -1 --oneline)
HEAD=$(git rev-parse --short HEAD)

if [ -d /tmp/_otr_padstrip ]; then
  cp /tmp/_otr_padstrip/_otr_json.py "$OTR/nodes/_otr_json.py"
  cp /tmp/_otr_padstrip/_otr_my_story.py "$OTR/nodes/_otr_my_story.py"
  cp /tmp/_otr_padstrip/otr_shot_lock.py "$OTR/nodes/otr_shot_lock.py"
  cp /tmp/_otr_padstrip/_otr_slot_drama_contract.py "$OTR/nodes/_otr_slot_drama_contract.py"
  cp /tmp/_otr_padstrip/_otr_casting.py "$OTR/nodes/_otr_casting.py"
  cp /tmp/_otr_padstrip/_otr_scifi_news_pro.py "$OTR/nodes/_otr_scifi_news_pro.py"
  cp /tmp/_otr_padstrip/ghost_signal_author.py "$OTR/nodes/_otr_video_engines/ghost_signal_author.py"
  echo PATCHED_PADDED_JSON_KEYS
fi

"$PY" - <<'PY'
import json
from pathlib import Path
p = Path("/workspace/runpod-slim/ComfyUI/custom_nodes/ComfyUI-OldTimeRadio/workflows/variants/otr_16gb_foley.json")
data = json.loads(p.read_text())
writer = next(n for n in data["nodes"] if n["type"] == "OTR_LedgerScriptWriter")
names = [i["widget"]["name"] for i in writer["inputs"] if isinstance(i.get("widget"), dict)]
bank = writer["widgets_values"][names.index("source_bank")]
print("FOLEY_ON_DISK_BANK=%r" % bank)
if bank != "roll (any eligible bank)":
    raise SystemExit("foley json was pinned; refusing to continue")
print("FOLEY_JSON_UNCHANGED_ROLL")
PY

if ss -lntp | grep -q ':8188'; then
  pids=$(ss -lntp | awk '/:8188/{print}' | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u)
  echo KILL_8188 $pids
  for pid in $pids; do kill "$pid" || true; done
  sleep 4
fi
if ss -lntp | grep -q ':8188'; then
  pids=$(ss -lntp | awk '/:8188/{print}' | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u)
  echo KILL_8188_FORCE $pids
  for pid in $pids; do kill -9 "$pid" || true; done
  sleep 2
fi
if ss -lntp | grep -q ':8188'; then
  echo PORT_STILL_UP
  ss -lntp | grep ':8188' || true
  exit 6
fi

pkill -f otr_canonical_api_run.py || true

export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
cd "$OTR_COMFY_ROOT"
: > "$COMFY_LOG"
nohup "$PY" main.py --listen 0.0.0.0 --port 8188 --disable-metadata \
  > "$COMFY_LOG" 2>&1 &
echo BOOT_PID=$!
ok=0
for i in $(seq 1 45); do
  if curl -fsS http://127.0.0.1:8188/system_stats >/dev/null 2>&1; then
    echo SERVER_HEALTHY i=$i HEAD=$HEAD
    ok=1
    break
  fi
  sleep 8
done
if [ "$ok" -ne 1 ]; then
  echo SERVER_NOT_UP
  tail -n 80 "$COMFY_LOG" || true
  exit 4
fi
grep -n "All 25 nodes" "$COMFY_LOG" | tail -n 3 || true
nvidia-smi --query-gpu=name,memory.used --format=csv,noheader || true

"$PY" - <<'PY'
import json, urllib.request
raw = urllib.request.urlopen("http://127.0.0.1:8188/object_info/OTR_LedgerScriptWriter", timeout=30).read()
info = json.loads(raw)
node = info["OTR_LedgerScriptWriter"]["input"]["required"]
slot = node["openrouter_slot_a_model"][0]
creative = node["creative_writing_model"][0]
want = "~openai/gpt-latest"
print("SLOT_A_HAS_GPT", want in slot)
print("CREATIVE_HAS_OPENROUTER", "openrouter:slot-a" in creative)
if want not in slot or "openrouter:slot-a" not in creative:
    raise SystemExit("openrouter chatgpt slug not in live dropdowns")
print("OPENROUTER_DROPDOWNS_OK")
PY

cd "$OTR"
: > "$LOG"
nohup "$PY" scripts/otr_canonical_api_run.py \
  --workflow workflows/variants/otr_16gb_foley.json \
  --act-count 3 \
  --source-bank my_story \
  --creative-model openrouter:slot-a \
  --technical-model openrouter:slot-a \
  --set 'OTR_LedgerScriptWriter.openrouter_slot_a_model=~openai/gpt-latest' \
  --set 'OTR_LedgerScriptWriter.openrouter_slot_b_model=~openai/gpt-latest' \
  --comfyui-url http://127.0.0.1:8188 \
  --timeout 0 \
  --run-label foley3_chatgpt \
  > "$LOG" 2>&1 &
echo RUNNER_PID=$!
sleep 25
echo "=== runner ==="
tail -n 80 "$LOG" || true
echo "=== comfy ==="
grep -E 'got prompt|house DEFAULT_IDEA|All 25 nodes|my_story|OpenRouter|openrouter|Error|Traceback|NVIDIA' "$COMFY_LOG" | tail -n 50 || tail -n 30 "$COMFY_LOG"
echo "=== queue ==="
curl -fsS http://127.0.0.1:8188/queue || true
echo
