      "widgets_values": [
        "{\n  \"episode_title\": \"The Saturn Broadcast\",\n  \"voice_assignments\": {\n    \"LEMMY\": {\n      \"voice_preset\": \"v2/en_speaker_8\",\n      \"notes\": \"Male, 50s, gravelly, weathered, confident\"\n    },\n    \"KENJI CROSS\": {\n      \"voice_preset\": \"v2/en_speaker_3\",\n      \"notes\": \"Male, 30s, urgent, clipped military cadence\"\n    },\n    \"ANNOUNCER\": {\n      \"voice_preset\": \"v2/en_speaker_4\",\n      \"notes\": \"Female, 40s, warm authoritative broadcast voice\"\n    }\n  },\n  \"sfx_plan\": [\n    {\n      \"cue_id\": \"sfx_001\",\n      \"type\": \"sfx\",\n      \"description\": \"low frequency console hum\",\n      \"generation_prompt\": \"deep industrial drone of old analog electronics, subtle electromagnetic hum, distant air handler, mono\"\n    },\n    {\n      \"cue_id\": \"sfx_002\",\n      \"type\": \"sfx\",\n      \"description\": \"red alert klaxon, distant\",\n      \"generation_prompt\": \"muffled alarm klaxon pulsing through thick bulkhead doors, distant urgent warning, rhythmic low-frequency whoop\"\n    }\n  ],\n  \"music_plan\": [\n    {\n      \"cue_id\": \"opening\",\n      \"duration_sec\": 12,\n      \"generation_prompt\": \"1940s old time radio sci-fi opening, brass fanfare with theremin lead, upright bass, AM radio character, confident and mysterious\"\n    },\n    {\n      \"cue_id\": \"closing\",\n      \"duration_sec\": 8,\n      \"generation_prompt\": \"1940s old time radio sci-fi closing sting, brass and strings resolving, tube warmth, fades to silence\"\n    },\n    {\n      \"cue_id\": \"interstitial\",\n      \"duration_sec\": 4,\n      \"generation_prompt\": \"short act-break stinger, single brass hit with cymbal swell, tube warmth, mono\"\n    }\n  ],\n  \"pacing\": {\n    \"beat_pause_ms\": 100\n  },\n  \"visual_plan\": {\n    \"characters\": {\n      \"LEMMY\": {\n        \"portrait_prompt\": \"Cinematic portrait of a weathered male spacer in his 50s, long dark hair streaked with grey, deep facial scars along the jawline, prominent muttonchop sideburns, worn leather flight jacket over a patched grey jumpsuit, dangling silver pendant, piercing eyes, ambient red alert lighting on his face, high fidelity 35mm film grain\"\n      },\n      \"KENJI CROSS\": {\n        \"portrait_prompt\": \"Cinematic portrait of a disciplined male officer in his 30s, close-cropped black hair, sharp cheekbones, clean-shaven, pressed charcoal military uniform with silver rank insignia on the collar, alert posture, cold blue console light on his face, high fidelity 35mm film grain\"\n      },\n      \"ANNOUNCER\": {\n        \"portrait_prompt\": \"Cinematic portrait of a poised broadcast announcer in her 40s, hair pulled back, vintage headset with boom microphone, warm amber studio lamp lighting, soft focus 1940s radio studio aesthetic, 35mm film grain\"\n      }\n    },\n    \"scenes\": [\n      {\n        \"scene_id\": \"scene_1\",\n        \"shot_description\": \"LEMMY at the comms console, a signal is coming in from Saturn\",\n        \"visual_prompt\": \"Cinematic wide shot of dim cramped starship comms bay, red alert pulse slowly pulsing overhead, blue holographic console glow, banks of 1980s-style analog readouts, industrial grey riveted panels, atmospheric volumetric haze\"\n      },\n      {\n        \"scene_id\": \"scene_2\",\n        \"shot_description\": \"LEMMY and KENJI CROSS argue in the corridor about whether to respond\",\n        \"visual_prompt\": \"Cinematic medium shot of narrow starship corridor lit by flickering emergency strip lighting, long perspective lines of bulkhead ribs, condensation streaks on metal walls, amber warning stripes on the floor, volumetric haze, cold steel atmosphere\"\n      },\n      {\n        \"scene_id\": \"scene_3\",\n        \"shot_description\": \"LEMMY alone in the captain's ready room, making the call\",\n        \"visual_prompt\": \"Cinematic close shot of captain's ready room, dim desk lamp casting a warm pool of light on a cluttered metal desk covered in maps and data tablets, large porthole window showing distant Saturn and its rings, warm amber lamp light contrasted against cold blue starlight, cinematic 35mm film aesthetic\"\n      }\n    ]\n  }\n}\n",
