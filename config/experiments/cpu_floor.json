{
    "id": "cpu_floor",
    "display_name": "CPU floor -- a TEST FIXTURE for scripts/build_variants.py, not a tier anyone installs. Cloud writer via Comfy Credits; no local LLM. It is deliberately absent from SHIPPING_SET so it never emits a user-facing graph. For CPU-only rendering open otr_canonical with no profile, which is the proven path; otr_cpu_low was retired 2026-09-23.",
    "status": "draft",
    "platform": "any",
    "device_backend": "cpu",
    "gpu_vendor": "none",
    "toolchains": [],
    "allow_sidecars": false,
    "role_overrides": {
        "announcer_visual": "still_flat",
        "music_visual": "viz_green",
        "character_visual": "still_motion",
        "announcer_image": "google_image",
        "music_image": "google_image",
        "character_image": "google_image"
    },
    "slot_overrides": {
        "cast_voice_policy": "auto_registry",
        "announcer_voice_engine": "kokoro",
        "music_engine": "musicgen",
        "video_render_engine": "still_motion"
    },
    "features": {
        "burn_captions": true,
        "caption_style": "sdh_standard"
    },
    "seed_policy": {
        "request_seed": 42,
        "seed_mode": "request_hash",
        "cast_seed_env": null,
        "style_seed_env": null
    },
    "llm": {
        "device": "cpu",
        "attn_impl": "sdpa",
        "quant_policy": "none",
        "vram_ceiling_gb": 0,
        "creative_model": "comfy:slot-a",
        "technical_model": "comfy:slot-b",
        "openrouter_slot_a_model": "(enable OpenRouter)",
        "openrouter_slot_b_model": "(enable OpenRouter)",
        "comfy_slot_a_model": "anthropic/claude-sonnet-5",
        "comfy_slot_b_model": "openai/gpt-5.6-luna",
        "google_api_slot_a_model": "(select Google API model)",
        "google_api_slot_b_model": "(select Google API model)",
        "lane_allowlist": [
            "openrouter",
            "comfy_credits",
            "google_api"
        ]
    },
    "video": {
        "device_policy": "cpu",
        "dtype_policy": "no_fp8_no_fp4"
    },
    "image": {
        "dtype_policy": "no_fp8_no_fp4"
    },
    "audio": {
        "voice_device": "cpu"
    },
    "render": {
        "fps": 25,
        "canvas_w": 832,
        "canvas_h": 480,
        "composite_res": "1920x1080",
        "composite_w": 1920,
        "composite_h": 1080,
        "frame_budget": 25,
        "beats": 40
    },
    "preflight": {
        "required_models": [],
        "required_keys": [
            "OTR_COMFY_API_KEY",
            "OTR_GOOGLE_API_KEY"
        ]
    },
    "launch": {
        "boot_contract": "cpu",
        "sage_attention": false,
        "extra_args": [],
        "env": {}
    }
}