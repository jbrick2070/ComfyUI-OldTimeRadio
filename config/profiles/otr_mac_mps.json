{
  "id": "otr_mac_mps",
  "display_name": "Apple Silicon MPS -- VERIFIED on an M4 / 16 GB (2026-09-08: six episodes in otr/obs/). Press Run and it works with NO downloads: the three visual lanes are procgen (viz_mxc_cpu / viz_green / viz_camera), voices are kokoro, music is stable_audio_3. The image roles name sd15 -- INERT under this wiring, because no viz_* lane consumes a still, and the engine that mints one the moment you switch a lane to still_flat / still_pan / still_word (fetch its 2.1 GB checkpoint first). For local video diffusion swap a lane to ltx098_low_video and read docs/MAC_PORTABILITY_GUIDE.md section 7. 16 GB is the floor and it is tight; a 32 GB Mac has more headroom but nothing above has been measured there.",
  "status": "shipping",
  "platform": "mac",
  "device_backend": "mps",
  "gpu_vendor": "apple",
  "toolchains": [],
  "allow_sidecars": false,
  "role_overrides": {
    "announcer_visual": "viz_mxc_cpu",
    "music_visual": "viz_green",
    "character_visual": "viz_camera",
    "announcer_image": "sd15",
    "music_image": "sd15",
    "character_image": "sd15"
  },
  "slot_overrides": {
    "voice_bank": "kokoro_builtin",
    "cast_voice_policy": "auto_registry",
    "announcer_voice_engine": "kokoro",
    "music_engine": "musicgen",
    "video_render_engine": "viz_camera"
  },
  "features": {
    "burn_captions": true,
    "caption_style": "sdh_standard"
  },
  "seed_policy": {
    "request_seed": 42,
    "seed_mode": "request_hash",
    "cast_seed_env": null,
    "style_seed_env": null
  },
  "llm": {
    "device": "mps",
    "attn_impl": "sdpa",
    "quant_policy": "none",
    "vram_ceiling_gb": 10.0,
    "gguf_n_ctx": 4096,
    "gguf_quant": "Q4_K_M",
    "creative_model": "Qwen/Qwen3.5-4B",
    "technical_model": "Qwen/Qwen3.5-4B",
    "openrouter_slot_a_model": "(enable OpenRouter)",
    "openrouter_slot_b_model": "(enable OpenRouter)",
    "comfy_slot_a_model": "(enable Comfy Credits)",
    "comfy_slot_b_model": "(enable Comfy Credits)",
    "google_api_slot_a_model": "(select Google API model)",
    "google_api_slot_b_model": "(select Google API model)",
    "lane_allowlist": [
      "transformers",
      "gguf",
      "openrouter",
      "comfy_credits",
      "google_api"
    ]
  },
  "video": {
    "device_policy": "mps",
    "dtype_policy": "no_fp8_no_fp4"
  },
  "image": {
    "dtype_policy": "no_fp8_no_fp4"
  },
  "audio": {
    "voice_device": "mps"
  },
  "render": {
    "fps": 25,
    "canvas_w": 832,
    "canvas_h": 480,
    "composite_res": "1920x1080",
    "composite_w": 1920,
    "composite_h": 1080,
    "frame_budget": 17,
    "beats": 40
  },
  "preflight": {
    "required_models": [
      "v1-5-pruned-emaonly-fp16.safetensors"
    ],
    "required_keys": []
  },
  "launch": {
    "sage_attention": false,
    "extra_args": [],
    "env": {}
  }
}
