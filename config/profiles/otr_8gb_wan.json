{
  "id": "otr_8gb_wan",
  "display_name": "8 GB - Wan 2.2 TI2V 5B (wan_8gb)",
  "status": "draft",
  "platform": "any",
  "device_backend": "cuda",
  "gpu_vendor": "nvidia",
  "toolchains": [],
  "allow_sidecars": false,
  "role_overrides": {
    "announcer_visual": "wan_ti2v",
    "music_visual": "wan_ti2v",
    "character_visual": "wan_ti2v",
    "announcer_image": "z_image_turbo",
    "music_image": "z_image_turbo",
    "character_image": "z_image_turbo"
  },
  "slot_overrides": {
    "voice_bank": "bark_legacy",
    "cast_voice_policy": "auto_registry",
    "char_voice_engine": "bark",
    "announcer_voice_engine": "kokoro",
    "music_engine": "stable_audio_3",
    "video_render_engine": "wan_ti2v"
  },
  "features": {
    "burn_captions": true,
    "caption_style": "sdh_standard"
  },
  "seed_policy": {
    "request_seed": 42,
    "seed_mode": "request_hash",
    "cast_seed_env": null,
    "style_seed_env": null
  },
  "llm": {
    "device": "cuda",
    "attn_impl": "sdpa",
    "quant_policy": "none",
    "vram_ceiling_gb": 6.8,
    "gguf_n_ctx": 2048,
    "gguf_quant": "Q4_K_M",
    "creative_model": "unsloth/gemma-4-12b-it-GGUF",
    "technical_model": "unsloth/gemma-4-12b-it-GGUF",
    "openrouter_slot_a_model": "(enable OpenRouter)",
    "openrouter_slot_b_model": "(enable OpenRouter)",
    "comfy_slot_a_model": "(enable Comfy Credits)",
    "comfy_slot_b_model": "(enable Comfy Credits)",
    "google_api_slot_a_model": "(select Google API model)",
    "google_api_slot_b_model": "(select Google API model)",
    "lane_allowlist": [
      "transformers",
      "gguf",
      "openrouter",
      "comfy_credits",
      "google_api"
    ]
  },
  "video": {
    "device_policy": "cuda",
    "dtype_policy": "fp8_ok",
    "max_render_frames": 81
  },
  "image": {
    "dtype_policy": "fp8_ok"
  },
  "audio": {
    "voice_device": "cuda"
  },
  "render": {
    "fps": 25,
    "canvas_w": 832,
    "canvas_h": 480,
    "composite_res": "1920x1080",
    "composite_w": 1920,
    "composite_h": 1080,
    "frame_budget": 17,
    "beats": 40
  },
  "preflight": {
    "required_models": [
      "wan2.2-ti2v-5b",
      "umt5-xxl-encoder",
      "wan2.2_vae"
    ],
    "required_keys": []
  },
  "launch": {
    "sage_attention": false,
    "extra_args": [],
    "env": {
      "OTR_VIDEO_LANDSCAPE_CANVAS": "832x480",
      "OTR_WAN_TI2V_MAX_FRAMES": "81"
    }
  }
}
