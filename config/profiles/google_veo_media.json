{
  "id": "google_veo_media",
  "display_name": "Google BYO media (image + Veo video)",
  "status": "draft",
  "platform": "any",
  "device_backend": "cpu",
  "gpu_vendor": "nvidia",
  "toolchains": [],
  "allow_sidecars": false,
  "role_overrides": {
    "announcer_visual": "google_veo_video",
    "music_visual": "google_veo_video",
    "character_visual": "google_veo_video",
    "announcer_image": "google_image",
    "music_image": "google_image",
    "character_image": "google_image"
  },
  "slot_overrides": {},
  "features": {
    "burn_captions": true,
    "caption_style": "sdh_standard"
  },
  "seed_policy": {
    "request_seed": 42,
    "seed_mode": "request_hash",
    "cast_seed_env": null,
    "style_seed_env": null
  },
  "llm": {
    "device": "cuda",
    "attn_impl": "sdpa",
    "quant_policy": "bnb_nf4",
    "vram_ceiling_gb": 14.5,
    "gguf_n_ctx": 4096,
    "gguf_quant": "Q8_0",
    "creative_model": "mistralai/Mistral-Nemo-Instruct-2407",
    "technical_model": "mistralai/Mistral-Nemo-Instruct-2407",
    "openrouter_slot_a_model": "(enable OpenRouter)",
    "openrouter_slot_b_model": "(enable OpenRouter)",
    "comfy_slot_a_model": "(enable Comfy Credits)",
    "comfy_slot_b_model": "(enable Comfy Credits)",
    "google_api_slot_a_model": "(select Google API model)",
    "google_api_slot_b_model": "(select Google API model)",
    "lane_allowlist": ["transformers", "gguf", "openrouter", "comfy_credits", "google_api"]
  },
  "video": {
    "device_policy": "cuda",
    "dtype_policy": "fp8_ok"
  },
  "image": {
    "dtype_policy": "fp8_ok"
  },
  "audio": {
    "voice_device": "cuda"
  },
  "render": {
    "fps": 25,
    "canvas_w": 832,
    "canvas_h": 480,
    "composite_res": "1920x1080",
    "composite_w": 1920,
    "composite_h": 1080,
    "frame_budget": 25,
    "beats": 40
  },
  "preflight": {
    "required_models": [],
    "required_keys": ["OTR_GOOGLE_API_KEY"]
  },
  "launch": {
    "sage_attention": false,
    "extra_args": [],
    "env": {}
  }
}
