        "character_visual": "cloud_ltx25_audio_in",
        "announcer_image": "cloud_flux_pro",
        "music_image": "cloud_flux_pro",
        "character_image": "cloud_flux_pro"
    },
    "slot_overrides": {
        "cast_voice_policy": "auto_registry",
        "char_voice_engine": "cloud_elevenlabs",
        "announcer_voice_engine": "cloud_elevenlabs",
