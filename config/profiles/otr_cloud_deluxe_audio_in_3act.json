{
    "id": "otr_cloud_deluxe_audio_in_3act",
    "display_name": "Comfy Cloud 3-act deluxe AUDIO-IN -- Sonnet 5 creative + GPT 5.6 Luna tech (Comfy Credits), LTX 2.5 Audio-to-Video driven by the episode mix. Flux Pro stills. OpenRouter stays on the picker. Needs OTR_COMFY_API_KEY.",
    "status": "shipping",
    "platform": "any",
    "device_backend": "cpu",
    "gpu_vendor": "none",
    "toolchains": [],
    "allow_sidecars": false,
    "role_overrides": {
        "announcer_visual": "cloud_ltx25_audio_in",
