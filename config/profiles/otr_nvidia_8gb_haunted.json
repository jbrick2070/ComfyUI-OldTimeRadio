{
  "id": "otr_nvidia_8gb_haunted",
  "display_name": "8GB NVIDIA: HAUNTED (AnimateDiff v3, ~3.7GB weights, no image model needed; video lane is silent -- kokoro voices + musicgen are still muxed in) -- NO HF TOKEN NEEDED",
  "status": "shipping",
  "platform": "any",
  "device_backend": "cuda",
  "gpu_vendor": "nvidia",
  "toolchains": [],
  "allow_sidecars": false,
  "role_overrides": {
    "announcer_visual": "animatediff15_v3_haunted_video",
    "music_visual": "animatediff15_v3_haunted_video",
    "character_visual": "animatediff15_v3_haunted_video",
    "announcer_image": "z_image_turbo",
    "music_image": "z_image_turbo",
    "character_image": "z_image_turbo"
  },
  "slot_overrides": {
    "voice_bank": "kokoro_builtin",
    "cast_voice_policy": "auto_registry",
    "char_voice_engine": "kokoro",
    "announcer_voice_engine": "kokoro",
    "music_engine": "musicgen",
    "video_render_engine": "animatediff15_v3_haunted_video"
  },
  "features": {
    "burn_captions": true,
    "caption_style": "sdh_standard"
  },
  "seed_policy": {
    "request_seed": 42,
    "seed_mode": "request_hash",
    "cast_seed_env": null,
    "style_seed_env": null
  },
  "llm": {
    "device": "cuda",
    "attn_impl": "sdpa",
    "quant_policy": "none",
    "vram_ceiling_gb": 6.8,
    "gguf_n_ctx": 2048,
    "gguf_quant": "Q4_K_M",
    "creative_model": "google/gemma-4-E2B-it",
    "technical_model": "google/gemma-4-E2B-it",
    "openrouter_slot_a_model": "(enable OpenRouter)",
    "openrouter_slot_b_model": "(enable OpenRouter)",
    "comfy_slot_a_model": "(enable Comfy Credits)",
    "comfy_slot_b_model": "(enable Comfy Credits)",
    "google_api_slot_a_model": "(select Google API model)",
    "google_api_slot_b_model": "(select Google API model)",
    "lane_allowlist": [
      "transformers",
      "gguf",
      "openrouter",
      "comfy_credits",
      "google_api"
    ]
  },
  "video": {
    "device_policy": "cuda",
    "dtype_policy": "no_fp8_no_fp4"
  },
  "image": {
    "dtype_policy": "fp8_ok"
  },
  "audio": {
    "voice_device": "cuda"
  },
  "render": {
    "fps": 25,
    "canvas_w": 512,
    "canvas_h": 288,
    "composite_res": "1920x1080",
    "composite_w": 1920,
    "composite_h": 1080,
    "frame_budget": 25,
    "beats": 40
  },
  "preflight": {
    "required_models": [
      "google/gemma-4-E2B-it",
      "v1-5-pruned-emaonly-fp16.safetensors",
      "v3_sd15_mm.ckpt",
      "v3_sd15_adapter.ckpt"
    ],
    "required_keys": []
  },
  "launch": {
    "sage_attention": false,
    "extra_args": [],
    "env": {}
  }
}
