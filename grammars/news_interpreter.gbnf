# news_interpreter.gbnf
#
# GBNF grammar for nodes/news_interpreter.NewsBriefs LLM-authored output.
# Shipped as a loader-side hint -- the news_interpreter module itself
# is strictly LLM-agnostic and does NOT pass this grammar to
# generate_fn. A future llama.cpp-backed loader can pick it up by
# convention:  <repo>/grammars/<module_name>.gbnf
#
# Per ADR docs/news_interpreter_adr.md sections 3.4 + 4.5.
#
# Structural enforcement (field names, JSON shape, array bounds).
# Length caps on the brief fields are NOT encoded in the grammar
# (GBNF length caps bloat the grammar significantly); pydantic
# enforces those after parsing.
#
# Schema:
#   {
#     "casting_brief":    string  (<=200 chars enforced by pydantic),
#     "script_brief":     string  (<=350 chars enforced by pydantic),
#     "news_close_brief": string  (<=250 chars enforced by pydantic),
#     "key_terms":        [ string, string, ... ]   (2-6 entries,
#                         each <=40 chars enforced by pydantic)
#   }

root ::= "{" ws
         "\"casting_brief\"" ws ":" ws string ws "," ws
         "\"script_brief\"" ws ":" ws string ws "," ws
         "\"news_close_brief\"" ws ":" ws string ws "," ws
         "\"key_terms\"" ws ":" ws key-terms-array ws
         "}"

# 2-6 string entries (one required + 1-5 additional).
key-terms-array ::= "[" ws string ("," ws string){1,5} ws "]"

# Standard JSON string. Length caps deferred to pydantic.
string ::= "\"" ([^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""

ws ::= [ \t\n]*
