{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/cheap_families.py' | ForEach-Object { \"'$n++; if($n -ge 1 -and $n -le 390) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"    1: \"\"\"Cheap radio-floor video families -- the no-heavy-engine adapters (A-S3 / CW-4).\r\n    2: \r\n    3: The first concrete video engines registered in the platform: cheap, CPU/ffmpeg\r\n    4: families that need NO heavy model, so a watchable episode (M1) renders before any\r\n    5: GPU engine exists. Each registers exactly like a future heavy engine (HuMo / LTX\r\n    6: / Wan) -- model-agnostic, selected per role; no model is \"primary\".\r\n    7: \r\n    8: Families (schemas.FAMILIES): ``static_motion`` (still_motion -- a still with a slow\r\n    9: pan), ``static_image_gen`` (still_pan -- a provided still with a pan / still_flat --\r\n   10: the same still held flat). Each produces an ALWAYS-SILENT ``CanonicalClip``\r\n   11: (``has_audio`` is always False -- audio is added ONLY by ``OTR_MasterAudioMux``,\r\n   12: V-1). (The ``abstract`` procedural floor + the ``station_card`` card were RETIRED\r\n   13: 2026-06-30, C0; the ``abstract`` family name lives on via ``eng_visualizer``.)\r\n   14: \r\n   15: Cold-import clean (V-12): module scope imports only the dep-free registry + the\r\n   16: role vocabulary. ffmpeg / PIL / numpy / torch are imported LAZILY inside\r\n   17: ``render_clip`` (the render slice wires up with the interactive episode smoke;\r\n   18: the platform's selection / role-filter / usability logic is fully CPU-tested\r\n   19: without rendering).\r\n   20: \"\"\"\r\n   21: from __future__ import annotations\r\n   22: \r\n   23: import logging\r\n   24: \r\n   25: from .registry import register\r\n   26: from .._otr_shared.still_plan_helpers import StillPlanRow\r\n   27: from .frame_contract import FrameContract\r\n   28: from .wan_shared import ffprobe_clip_fields, validate_silent_clip_contract\r\n   29: \r\n   30: log = logging.getLogger(\"OTR.video.cheap_families\")\r\n   31: \r\n   32: \r\n   33: #: S1 (2026-07-25) per-model still plan for the cheap still-based families\r\n   34: #: (still_motion / still_pan / still_flat / still_word). All Shape A --\r\n   35: #: scene spine per spec section 3. FILE-LOCAL, fully declared. Note the\r\n   36: #: spec's note in section 3: for the still_* engines, requiredness is\r\n   37: #: DECLARED here, never derived from ``required_inputs`` (which would be a\r\n   38: #: back door around the plan). Nothing reads the plan at S1 -- S2 wires it in.\r\n   39: _CHEAP_FAMILY_STILL_PLAN = (\r\n   40:     StillPlanRow(kind=\"scene_open\", cardinality=\"per_beat\",\r\n   41:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n   42:                  framing_geometry=(\r\n   43:                      \"full-frame macro, centered subject\"),\r\n   44:                  style_tail_policy=\"full\"),\r\n   45:     StillPlanRow(kind=\"scene_beat\", cardinality=\"per_beat\",\r\n   46:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n   47:                  framing_geometry=(\r\n   48:                      (\"cinematic three-quarter framing, people shown with \"\r\n   49:                       \"full heads and clear headroom inside frame, faces \"\r\n   50:                       \"unobstructed, balanced composition\")),\r\n   51:                  style_tail_policy=\"full\"),\r\n   52:     StillPlanRow(kind=\"scene_character\", cardinality=\"per_beat\",\r\n   53:                  target_class=\"scene\", aspect=\"wide\", required=\"always\",\r\n   54:                  framing_geometry=(\r\n   55:                      (\"cinematic medium shot, the character framed within a \"\r\n   56:                       \"wide 16:9 environment, full head and shoulders with \"\r\n   57:                       \"clear headroom inside frame, face unobstructed, \"\r\n   58:                       \"balanced landscape composition\")),\r\n   59:                  style_tail_policy=\"full\"),\r\n   60:     StillPlanRow(kind=\"portrait\", cardinality=\"per_subject\",\r\n   61:                  target_class=\"portrait\", aspect=\"inherit_engine\",\r\n   62:                  required=\"never\",\r\n   63:                  framing_geometry=(\"in-character cinematic medium shot, head \"\r\n   64:                                    \"and shoulders, face clearly visible, \"\r\n   65:                                    \"subject centred with natural headroom \"\r\n   66:                                    \"above the head (never crop the top of the \"\r\n   67:                                    \"head)\"),\r\n   68:                  style_tail_policy=\"full\"),\r\n   69: )\r\n   70: \r\n   71: \r\n   72: class _CheapFamilyBase:\r\n   73:     \"\"\"Shared shell for a cheap, no-heavy-engine video family. Render lifecycle\r\n   74:     is the ffmpeg/CPU slice (lazy); the registry only reads the core metadata.\"\"\"\r\n   75: \r\n   76:     name = \"cheap\"\r\n   77:     roles: tuple = ()\r\n   78:     default_roles: tuple = ()\r\n   79:     #: Still-aspect identity (2026-06-17): every cheap floor / still family fills\r\n   80:     #: the 16:9 canvas (BUG-407: PORTRAIT is HuMo-ONLY). Subclasses inherit this;\r\n   81:     #: still_parallax / mesh_stage (which extend this base) are wide too.\r\n   82:     render_aspect = \"wide\"\r\n   83:     commercial_clean = True\r\n   84:     requires_flag = None            # cheap families are always available (no opt-in)\r\n   85:     invocable = True\r\n   86:     invocability_reason = \"\"\r\n   87:     family = \"abstract\"\r\n   88:     required_inputs: tuple = ()\r\n   89:     #: THE FRAME LADDER (chunk 7a, 2026-07-26). UNBOUNDED, and that is a\r\n   90:     #: real declaration rather than a shrug: ``_frame_count(request, fps)``\r\n   91:     #: derives the length from the beat's own duration, so any length at any\r\n   92:     #: rate is legal and there is nothing to split. ``max_frames=0`` means no\r\n   93:     #: ceiling, and an engine with no ceiling never needs a second clip.\r\n   94:     #: CONTINUITY none -- a cheap family paints its OWN still on every frame\r\n   95:     #: and has no mechanism that would consume a predecessor's terminal frame.\r\n   96:     #: Inherited by still_motion / still_pan / still_flat / still_word AND by\r\n   97:     #: mesh_stage, whose camera walk is equally unbounded.\r\n   98:     frame_contract = FrameContract(\r\n   99:         min_frames=1,\r\n  100:         max_frames=0,\r\n  101:         quantum=1,\r\n  102:         allow_tail_trim=True,\r\n  103:     )\r\n  104:     engine_version = \"1\"\r\n  105:     #: True when this family animates a provided still (asset_refs.init_image /\r\n  106:     #: still) with a pan; False families always synthesize a procedural\r\n  107:     #: floor. Either way render_clip ALWAYS produces a valid silent clip.\r\n  108:     uses_still = False\r\n  109:     #: When True a MISSING/absent base still is a LOUD failure (NO dark lavfi\r\n  110:     #: floor fallback) instead of the synthesized slate. still_word sets this:\r\n  111:     #: its whole contract is \"hold the minted word/title still\" -- a silent\r\n  112:     #: black floor would swallow a mint failure exactly where it matters\r\n  113:     #: (NO FALLBACKS, operator directive 2026-07-02). Default False keeps every\r\n  114:     #: other cheap family's always-renders floor behavior byte-identical.\r\n  115:     _require_still = False\r\n  116: \r\n  117:     def load(self) -> None:  # cheap families hold no resident weights\r\n  118:         return None\r\n  119: \r\n  120:     def unload(self) -> None:\r\n  121:         return None\r\n  122: \r\n  123:     def assert_usable(self, host_caps, profile, request_template=None):\r\n  124:         \"\"\"Cheap families are usable wherever ffmpeg exists; the real ffmpeg\r\n  125:         check runs in render_clip. Returns the validated name (no heavy dep).\"\"\"\r\n  126:         return self.name\r\n  127: \r\n  128:     def prepare(self, host_caps, profile, session_ctx):  # pragma: no cover\r\n  129:         return {\"engine_id\": self.name}\r\n  130: \r\n  131:     # ---- canvas / input resolution (pure; CPU-testable) ----\r\n  132:     @staticmethod\r\n  133:     def _get(request):\r\n  134:         return request.get if isinstance(request, dict) else (\r\n  135:             lambda k, d=None: getattr(request, k, d))\r\n  136: \r\n  137:     def _canvas_dims(self, request):\r\n  138:         \"\"\"(width, height, fps) from the request canvas, with platform defaults\r\n  139:         (832x480 @ 25) when a field is absent. The cheap floor never stretches:\r\n  140:         a still is scaled to cover with one uniform scale (bridge), a synth source\r\n  141:         fills the canvas exactly.\"\"\"\r\n  142:         get = self._get(request)\r\n  143:         canvas = get(\"canvas\") or {}\r\n  144:         c_get = canvas.get if isinstance(canvas, dict) else (\r\n  145:             lambda k, d=None: getattr(canvas, k, d))\r\n  146:         w = int(c_get(\"w\", 0) or 0) or 832\r\n  147:         h = int(c_get(\"h\", 0) or 0) or 480\r\n  148:         fps = int(c_get(\"fps\", 0) or 0) or 25\r\n  149:         return w, h, fps\r\n  150: \r\n  151:     def _frame_count(self, request, fps):\r\n  152:         \"\"\"The clip length in frames (timing.target_frame_count), defaulting to one\r\n  153:         second (``fps`` frames) when unspecified so the floor always renders.\"\"\"\r\n  154:         get = self._get(request)\r\n  155:         timing = get(\"timing\") or {}\r\n  156:         t_get = timing.get if isinstance(timing, dict) else (\r\n  157:             lambda k, d=None: getattr(timing, k, d))\r\n  158:         n = int(t_get(\"target_frame_count\", 0) or 0)\r\n  159:         return n if n > 0 else int(fps)\r\n  160: \r\n  161:     def _still_path(self, request):\r\n  162:         \"\"\"A provided still/portrait path from asset_refs (or \"\" when none).\"\"\"\r\n  163:         get = self._get(request)\r\n  164:         assets = get(\"asset_refs\") or {}\r\n  165:         if isinstance(assets, dict):\r\n  166:             for key in (\"still\", \"init_image\", \"image\"):\r\n  167:                 v = assets.get(key)\r\n  168:                 if isinstance(v, str) and v:\r\n  169:                     return v\r\n  170:                 if isinstance(v, dict) and v.get(\"path\"):\r\n  171:                     return v[\"path\"]\r\n  172:         return \"\"\r\n  173: \r\n  174:     def _lavfi_source(self, w, h, fps):\r\n  175:         \"\"\"The libavfilter source for this family's synthesized floor (a dark\r\n  176:         radio-slate field by default; a family may override for its own look).\"\"\"\r\n  177:         return \"color=c=0x0A0E14:s=%dx%d:r=%d\" % (int(w), int(h), int(fps))\r\n  178: \r\n  179:     def render_clip(self, request, prepared=None):\r\n  180:         \"\"\"Render ONE always-silent CanonicalClip via ffmpeg (the CPU radio floor).\r\n  181: \r\n  182:         A provided still (asset_refs) is animated with a gentle pan when\r\n  183:         ``uses_still``; otherwise the family's libavfilter source is synthesized.\r\n  184:         Output is the platform's silent bt709 / yuv420p contract (V-1: only\r\n  185:         OTR_MasterAudioMux ever adds audio). This family's canonicalize() is\r\n  186:         identity, so the canonical clip is returned here directly. With valid\r\n  187:         inputs it ALWAYS succeeds -- the fallback-chain terminus the A-S6 chain\r\n  188:         humo -> humo_1.7B -> still_motion converges on.\"\"\"\r\n  189:         from . import wrapper_bridge as _wb       # lazy import: cold-import clean\r\n  190:         import os\r\n  191:         from ._tmp import otr_engine_tmp_mp4\r\n  192:         w, h, fps = self._canvas_dims(request)\r\n  193:         n = self._frame_count(request, fps)\r\n  194:         out_path = otr_engine_tmp_mp4(\"otr_floor_%s_\" % self.name)\r\n  195:         still = self._still_path(request) if self.uses_still else \"\"\r\n  196:         if still and os.path.exists(still):\r\n  197:             # ``_still_motion`` chooses the pan (cover+crop, default) vs the\r\n  198:             # FLAT hold (fit+pad, no crop -> a face is never cut) -- the still_flat\r\n  199:             # 'just a still, no motion' contract.\r\n  200:             if getattr(self, \"_still_motion\", True):\r\n  201:                 cmd = _wb.ffmpeg_still_motion_cmd(still, out_path, w, h, fps, n)\r\n  202:             else:\r\n  203:                 cmd = _wb.ffmpeg_still_static_cmd(still, out_path, w, h, fps, n)\r\n  204:         elif self._require_still:\r\n  205:             # NO FALLBACKS (operator 2026-07-02): a still-REQUIRED family\r\n  206:             # (still_word) refuses the dark lavfi floor -- a missing base still\r\n  207:             # is a mint failure and must be LOUD, never a silently-black clip.\r\n  208:             raise RuntimeError(\r\n  209:                 \"%s requires a base still but none was provided/exists \"\r\n  210:                 \"(asset_refs still/init_image=%r) -- refusing the dark floor \"\r\n  211:                 \"(NO FALLBACKS). The image phase must mint this beat's still \"\r\n  212:                 \"before the video render.\" % (self.name, still))\r\n  213:         else:\r\n  214:             cmd = _wb.ffmpeg_lavfi_floor_cmd(\r\n  215:                 out_path, w, h, fps, n, source=self._lavfi_source(w, h, fps))\r\n  216:         _wb.run_ffmpeg(cmd)\r\n  217:         # M7 (added 2026-07-27, post-push QA fan-out). These four families\r\n  218:         # (still_motion / still_pan / still_flat / still_word) never touch\r\n  219:         # encode_frames_to_silent_mp4 -- they build the mp4 from an ffmpeg arg\r\n  220:         # list instead -- so the sweep that added the proof to every ENCODER\r\n  221:         # walked straight past them, and _floor_clip goes on to hand-write\r\n  222:         # container / codec / pixel_format / color_* as literals. still_motion\r\n  223:         # is also the terminus of the documented humo -> humo_1.7B ->\r\n  224:         # still_motion degrade chain, so it is the LAST place a self-declared\r\n  225:         # clip should be trusted. Safe to prove: all four command builders end\r\n  226:         # in the same _bt709_encode_args tail as the encoder, so a floor clip\r\n  227:         # already satisfies this contract by construction.\r\n  228:         validate_silent_clip_contract(ffprobe_clip_fields(out_path), fps)\r\n  229:         # M7 COUNT half (2026-07-28). The colour/stream half landed above on\r\n  230:         # 2026-07-27; the count stayed self-declared -- ``n`` is what was ASKED\r\n  231:         # for, and _floor_clip stamped it as CanonicalClip.frame_count, the\r\n  232:         # integer timing authority the composite positions the beat by.\r\n  233:         # All three builders use ffmpeg's frame-exact ``-frames:v`` rather than\r\n  234:         # a duration, so a miscount is less likely here than from a Python\r\n  235:         # generator -- but \"less likely\" is what the first encoder's count was\r\n  236:         # too, right up until the sweep looked. This reads the muxer's own\r\n  237:         # count off the SAME stream read ffprobe_clip_fields just performed, so\r\n  238:         # it costs no decode.\r\n  239:         proven = _wb.proven_frame_count(out_path, n)\r\n  240:         return self._floor_clip(request, out_path, fps, proven)\r\n  241: \r\n  242:     def _floor_clip(self, request, out_path, fps, n):\r\n  243:         \"\"\"Pure: shape the rendered floor mp4 into the silent CanonicalClip dict\r\n  244:         (bt709 / yuv420p; frame_count is the integer timing authority).\"\"\"\r\n  245:         get = self._get(request)\r\n  246:         return {\r\n  247:             \"clip_id\": get(\"shot_id\") or get(\"request_id\") or (\"%s_clip\" % self.name),\r\n  248:             \"type\": \"video\", \"path\": out_path,\r\n  249:             \"container\": \"mp4\", \"codec\": \"h264\", \"pixel_format\": \"yuv420p\",\r\n  250:             \"fps\": int(fps), \"frame_count\": int(n),\r\n  251:             \"has_audio\": False,            # V-1: only OTR_MasterAudioMux emits audio\r\n  252:             \"color_primaries\": \"bt709\", \"transfer\": \"bt709\", \"matrix\": \"bt709\",\r\n  253:             \"engine_id\": self.name, \"family\": self.family,\r\n  254:         }\r\n  255: \r\n  256:     def canonicalize(self, raw, request, profile):\r\n  257:         \"\"\"Identity: render_clip already emits the canonical silent clip dict.\"\"\"\r\n  258:         return raw\r\n  259: \r\n  260:     def teardown(self, prepared) -> None:  # pragma: no cover\r\n  261:         return None\r\n  262: \r\n  263: \r\n  264: # 2026-06-30 (C0, operator directive): ``AbstractFamily`` (engine_id \"abstract\")\r\n  265: # and ``StationCardFamily`` (engine_id \"station_card\") were RETIRED -- abstract was\r\n  266: # redundant with the real ``visualizer`` audio-reactive scope (and the future\r\n  267: # ``visualizer_rainbow`` fills the fun audio-reactive slot), and station_card was the\r\n  268: # broken black card. Both are UNREGISTERED + their CAPABILITIES rows removed. The\r\n  269: # family NAME \"abstract\" survives (visualizer is family=\"abstract\"; the cheap-base\r\n  270: # default + schemas.FAMILIES keep it). NO FALLBACKS (2026-07-02, Sprint A): the\r\n  271: # UNIVERSAL_FLOOR/chain machinery was RIPPED -- there is no floor terminus role.\r\n  272: \r\n  273: \r\n  274: @register\r\n  275: class StillMotionFamily(_CheapFamilyBase):\r\n  276:     name = \"still_motion\"\r\n  277:     family = \"static_motion\"\r\n  278:     #: S1 per-model still plan (Shape A -- see module constant above).\r\n  279:     still_plan = _CHEAP_FAMILY_STILL_PLAN\r\n  280:     roles = (\"announcer_visual\", \"music_visual\", \"character_video\")\r\n  281:     # rip-sfx-broll (2026-07-01): its only default role (retired_role_a) was\r\n  282:     # removed. NO FALLBACKS (2026-07-02, Sprint A): still_motion lost its\r\n  283:     # UNIVERSAL_FLOOR role with the chain rip -- it stays a REGISTERED\r\n  284:     # SELECTABLE engine (capability: text_prompt), but nothing degrades to it\r\n  285:     # and no role auto-defaults to it.\r\n  286:     default_roles = ()\r\n  287:     required_inputs = (\"text_prompt\",)\r\n  288:     uses_still = True               # pan over a provided still when present\r\n  289:     accepts_still = True            # C1: mint the selected still (coverage gate) so\r\n  290:     #                                 a still_motion beat shows the chosen image, not\r\n  291:     #                                 the dark floor (D2 BLACK fix)\r\n  292: \r\n  293: \r\n  294: # 2026-06-18: the cheap ``visualizer`` floor stub was SUPERSEDED by the real\r\n  295: # procedural CRT scope engine (nodes/_otr_video_engines/eng_visualizer.py,\r\n  296: # engine_id \"visualizer\"). The stub here was a minimal ffmpeg-floor family; the new\r\n  297: # engine is the faithful full-colour resurrection (audio analysis + the ring /\r\n  298: # particles / grid / waveform / bars / CRT-post look) and OWNS the \"visualizer\"\r\n  299: # name now. Removed to avoid a duplicate registration (the scope-visualizer plan\r\n  300: # wrongly assumed the name was unregistered).\r\n  301: \r\n  302: \r\n  303: @register\r\n  304: class StillPanFamily(_CheapFamilyBase):\r\n  305:     \"\"\"A provided still given a slow pan/zoom (cover+crop) for the beat --\r\n  306:     the 'still, but moving' option. CPU/ffmpeg-only, no weights, no VRAM, always\r\n  307:     renders -> commercial-clean. The still is minted by the SEPARATELY-chosen image\r\n  308:     engine; this family only animates it (so it is independent of the image engine).\r\n  309:     ``_still_motion`` defaults True (the pan); contrast ``still_flat`` (flat hold).\"\"\"\r\n  310:     name = \"still_pan\"\r\n  311:     family = \"static_image_gen\"\r\n  312:     #: S1 per-model still plan (Shape A).\r\n  313:     still_plan = _CHEAP_FAMILY_STILL_PLAN\r\n  314:     # A plain still needs only text_prompt (supplied by EVERY role), so it is the\r\n  315:     # fast, universal \"just a still\" pick -- eligible in all roles. BUG-LOCAL-401:\r\n  316:     # music_visual was missing, so music_video_model='still_pan'\r\n  317:     # failed OTR_VideoDirector role validation even though a still is valid there.\r\n  318:     roles = (\"announcer_visual\", \"music_visual\", \"character_video\")\r\n  319:     default_roles = ()              # selectable peer; not the in-stack default\r\n  320:     required_inputs = (\"text_prompt\",)\r\n  321:     commercial_clean = True         # own ffmpeg + the chosen still; no model license\r\n  322:     uses_still = True               # animate a provided still (pan) when present\r\n  323:     accepts_still = True            # C1: mint the selected still (coverage gate) so an\r\n  324:     #                                 opener/beat that picks still_pan shows the chosen\r\n  325:     #                                 image instead of the dark floor (D2 BLACK fix)\r\n  326: \r\n  327: \r\n  328: @register\r\n  329: class StillFlatFamily(_CheapFamilyBase):\r\n  330:     \"\"\"A DEAD-FLAT still: the selected image held STATIC (no pan/zoom, fit+pad so a\r\n  331:     face is NEVER cropped) for the beat -- the 'I want stills, not video' option\r\n  332:     (operator 2026-06-18). Eligible in every role; CPU/ffmpeg-only, no weights, no\r\n  333:     VRAM, always renders -> commercial-clean + validated. ``accepts_still`` so the\r\n  334:     image dispatcher mints the role's selected still for it (the central coverage\r\n  335:     gate); ``_still_motion=False`` selects the flat hold over the pan.\"\"\"\r\n  336:     name = \"still_flat\"\r\n  337:     family = \"static_image_gen\"\r\n  338:     #: S1 per-model still plan (Shape A).\r\n  339:     still_plan = _CHEAP_FAMILY_STILL_PLAN\r\n  340:     roles = (\"announcer_visual\", \"music_visual\", \"character_video\")\r\n  341:     default_roles = ()              # selectable peer; not an auto-default\r\n  342:     required_inputs = (\"text_prompt\",)\r\n  343:     commercial_clean = True         # own ffmpeg + the chosen still; no model license\r\n  344:     uses_still = True               # display the provided still...\r\n  345:     _still_motion = False           # ...STATIC (flat hold, fit+pad, no crop)\r\n  346:     accepts_still = True            # mint the selected still for it (coverage gate)\r\n  347: \r\n  348: \r\n  349: @register\r\n  350: class StillWordFamily(_CheapFamilyBase):\r\n  351:     \"\"\"still_word: a ``still_flat`` SIBLING whose base still is minted from a\r\n  352:     WORD/TITLE-driven prompt instead of the cinematic scene composer -- the\r\n  353:     'the words ARE the picture' option (Sprint B, 2026-07-03, operator).\r\n  354: \r\n  355:     MODEL-AGNOSTIC by construction: the IMAGE engine that mints the base still\r\n  356:     is chosen INDEPENDENTLY in the image dropdown; this VIDEO engine only holds\r\n  357:     the minted still dead-flat (fit+pad, no crop -- identical render mechanics\r\n  358:     to ``still_flat``). The ONLY delta vs still_flat is the PROMPT, composed\r\n  359:     upstream by ``otr_meta_brief_image_prompt.compose_still_word_prompt``\r\n  360:     (character/announcer beats -> the beat's spoken line as a readable word\r\n  361:     card; music beats -> an abstract picture of the episode title, no words).\r\n  362: \r\n  363:     NO FALLBACKS: ``_require_still`` makes a missing base still fail LOUD in\r\n  364:     render_clip -- never the dark floor -- because a black floor is exactly how\r\n  365:     a word/title mint failure would hide. Selectable per role; never a default\r\n  366:     (``default_roles=()``).\"\"\"\r\n  367:     name = \"still_word\"\r\n  368:     family = \"static_image_gen\"\r\n  369:     #: S1 per-model still plan (Shape A).\r\n  370:     still_plan = _CHEAP_FAMILY_STILL_PLAN\r\n  371:     roles = (\"announcer_visual\", \"music_visual\", \"character_video\")\r\n  372:     default_roles = ()              # selectable peer; never an auto-default\r\n  373:     required_inputs = (\"text_prompt\",)\r\n  374:     commercial_clean = True         # own ffmpeg + the chosen still; no model license\r\n  375:     uses_still = True               # display the provided (word/title) still...\r\n  376:     _still_motion = False           # ...STATIC (flat hold, fit+pad, no crop)\r\n  377:     accepts_still = True            # the image dispatcher mints its worded/title still\r\n  378:     _require_still = True           # NO dark floor: a missing still fails LOUD\r\n  379: \r\n  380: \r\n  381: __all__ = [\r\n  382:     \"StillMotionFamily\", \"StillPanFamily\", \"StillFlatFamily\", \"StillWordFamily\",\r\n  383: ]\r\n","exit_code":0,"status":"completed"}}
