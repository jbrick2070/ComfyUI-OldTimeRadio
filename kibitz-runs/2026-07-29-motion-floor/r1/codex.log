{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'tests/test_credits_roll_spec.py' | ForEach-Object { \"'$n++; if($n -ge 980 -and $n -le 1090) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  980:     led.data = _led() if data is None else data\r\n  981:     monkeypatch.setattr(pl, \"get_ledger\", lambda: led)\r\n  982:     return led\r\n  983: \r\n  984: \r\n  985: @needs_ffmpeg\r\n  986: def test_a_presentation_failure_returns_the_EPISODE_with_a_zero_tail(\r\n  987:         tmp_path, monkeypatch):\r\n  988:     \"\"\"The whole point of the boundary. The console failed to compose; the\r\n  989:     episode is finished and sitting on disk. Hand it back.\"\"\"\r\n  990:     _roll_ledger(monkeypatch)\r\n  991:     body = tmp_path / \"body.mp4\"\r\n  992:     _silent_video(body, 1.0, size=\"1280x720\")\r\n  993: \r\n  994:     def _explode(*_a, **_k):\r\n  995:         raise RuntimeError(\"libx264 fell over\")\r\n  996: \r\n  997:     monkeypatch.setattr(cr, \"render_credits_clip\", _explode)\r\n  998:     out, tail, report = cr.OTRCreditsRoll().roll(\r\n  999:         str(body), json.dumps({\"clips\": []}))\r\n 1000: \r\n 1001:     assert out == str(body), \"the finished episode must be handed back as-is\"\r\n 1002:     assert tail == 0.0, (\r\n 1003:         \"the mux's credits-aware guard must be told there is NO tail; a \"\r\n 1004:         \"non-zero declaration here would make it reserve time for a console \"\r\n 1005:         \"that was never appended\")\r\n 1006:     rep = json.loads(report)\r\n 1007:     assert rep[\"ok\"] is False and rep[\"credits_rendered\"] is False\r\n 1008:     assert rep[\"reason\"] == \"presentation_failure\"\r\n 1009:     assert \"libx264 fell over\" in rep[\"error\"]\r\n 1010: \r\n 1011: \r\n 1012: @needs_ffmpeg\r\n 1013: def test_a_backdrop_extraction_failure_is_also_presentation_only(\r\n 1014:         tmp_path, monkeypatch):\r\n 1015:     \"\"\"Frame extraction sits INSIDE the glass half: the body is readable (it\r\n 1016:     probed fine two lines earlier), we simply could not make a picture.\"\"\"\r\n 1017:     _roll_ledger(monkeypatch)\r\n 1018:     body = tmp_path / \"body.mp4\"\r\n 1019:     _silent_video(body, 1.0, size=\"1280x720\")\r\n 1020:     monkeypatch.setattr(cr, \"extract_final_frame\", lambda *a, **k: (_ for _ in ()).throw(\r\n 1021:         cr.CreditsDataError(\"no frame\")))\r\n 1022:     out, tail, report = cr.OTRCreditsRoll().roll(\r\n 1023:         str(body), json.dumps({\"clips\": []}))\r\n 1024:     assert out == str(body) and tail == 0.0\r\n 1025:     assert json.loads(report)[\"ok\"] is False\r\n 1026: \r\n 1027: \r\n 1028: def test_a_missing_body_is_TERMINAL(tmp_path, monkeypatch):\r\n 1029:     _roll_ledger(monkeypatch)\r\n 1030:     with pytest.raises(cr.CreditsDataError, match=\"credits input video missing\"):\r\n 1031:         cr.OTRCreditsRoll().roll(str(tmp_path / \"nope.mp4\"), \"{}\")\r\n 1032: \r\n 1033: \r\n 1034: @needs_ffmpeg\r\n 1035: def test_a_malformed_manifest_is_TERMINAL(tmp_path, monkeypatch):\r\n 1036:     _roll_ledger(monkeypatch)\r\n 1037:     body = tmp_path / \"body.mp4\"\r\n 1038:     _silent_video(body, 1.0, size=\"1280x720\")\r\n 1039:     with pytest.raises(cr.CreditsDataError, match=\"unparseable\"):\r\n 1040:         cr.OTRCreditsRoll().roll(str(body), \"{not json\")\r\n 1041: \r\n 1042: \r\n 1043: @needs_ffmpeg\r\n 1044: def test_missing_ledger_TRUTH_is_TERMINAL_not_degraded(tmp_path, monkeypatch):\r\n 1045:     \"\"\"The half that must NOT soften. A ledger missing a receipt the card is\r\n 1046:     obliged to show would publish credits claiming less than the build knows --\r\n 1047:     the one failure this card exists to prevent. It raises from\r\n 1048:     build_credits_layout, ABOVE the try, so the glass half never sees it.\"\"\"\r\n 1049:     hollow = _led()\r\n 1050:     hollow[\"meta\"] = dict(hollow.get(\"meta\") or {})\r\n 1051:     hollow[\"meta\"].pop(\"episode_title\", None)\r\n 1052:     _roll_ledger(monkeypatch, hollow)\r\n 1053:     body = tmp_path / \"body.mp4\"\r\n 1054:     _silent_video(body, 1.0, size=\"1280x720\")\r\n 1055:     with pytest.raises(cr.CreditsDataError):\r\n 1056:         cr.OTRCreditsRoll().roll(str(body), json.dumps({\"clips\": []}))\r\n 1057: \r\n 1058: \r\n 1059: @needs_ffmpeg\r\n 1060: def test_an_all_DIRECTORY_episode_now_publishes(tmp_path, monkeypatch):\r\n 1061:     \"\"\"THE mesh_stage DEFECT, closed.\r\n 1062: \r\n 1063:     An episode rendered entirely by mesh_stage has only frame DIRECTORIES in\r\n 1064:     its clip manifest and no mp4 at all. The old backdrop planner searched that\r\n 1065:     manifest for a loopable file clip, found none, and raised -- so the\r\n 1066:     terminal node refused an episode that had rendered every one of its shots.\r\n 1067:     The manifest is no longer consulted: the backdrop is the body video's own\r\n 1068:     final frame, and the body always exists because it is this node's input.\r\n 1069:     \"\"\"\r\n 1070:     _roll_ledger(monkeypatch)\r\n 1071:     body = tmp_path / \"body.mp4\"\r\n 1072:     _silent_video(body, 1.0, size=\"1280x720\")\r\n 1073:     frames_dir = tmp_path / \"shot_000_frames\"\r\n 1074:     frames_dir.mkdir()\r\n 1075:     manifest = {\"clips\": [\r\n 1076:         {\"shot_id\": \"s0\", \"path\": str(frames_dir), \"exists\": True},\r\n 1077:         {\"shot_id\": \"s1\", \"path\": str(frames_dir), \"exists\": True}]}\r\n 1078: \r\n 1079:     out, tail, report = cr.OTRCreditsRoll().roll(str(body), json.dumps(manifest))\r\n 1080:     rep = json.loads(report)\r\n 1081:     assert rep[\"ok\"] is True and rep[\"credits_rendered\"] is True\r\n 1082:     assert rep[\"backdrop_source\"] == \"body_final_frame\"\r\n 1083:     assert tail > 0.0 and os.path.exists(out) and out != str(body)\r\n","exit_code":0,"status":"completed"}}
