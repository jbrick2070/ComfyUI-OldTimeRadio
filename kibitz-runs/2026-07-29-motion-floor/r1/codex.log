{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'tests/test_multiclip_coverage_plan.py' | ForEach-Object { \"'$n++; if($n -ge 780 -and $n -le 825) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  780:     # passed by 39x. The floor now sits just under the real value, and the\r\n  781:     # refusal count is asserted too so coverage cannot drain into the `except`.\r\n  782:     assert checked >= 27954, (\r\n  783:         \"grid produced only %d multi-clip plans (measured 27954 at the time \"\r\n  784:         \"this was written) -- coverage has collapsed, or the grid moved and \"\r\n  785:         \"this floor needs re-measuring\" % checked)\r\n  786:     assert refused <= 12000, (\r\n  787:         \"%d targets refused -- coverage is draining into the except branch\"\r\n  788:         % refused)\r\n  789: \r\n  790: \r\n  791: def test_the_segment_count_ceiling_is_INCLUSIVE():\r\n  792:     \"\"\"``max_segments`` is a count the partitioner may actually use.\r\n  793: \r\n  794:     Added because a mutation round SURVIVED: turning the walk's\r\n  795:     ``range(2, max_segments + 1)`` into ``range(2, max_segments)`` broke\r\n  796:     nothing in the suite, so the boundary was pinned by nobody and a\r\n  797:     silently-narrowed search would have looked exactly like a genuine refusal.\r\n  798: \r\n  799:     17 * 3 == 51 on this ladder with no trim allowed, so 51 needs EXACTLY\r\n  800:     three segments: at two it is honestly uncoverable, at three it is exact.\r\n  801:     That makes the pair a boundary rather than a single-sided assertion.\r\n  802:     \"\"\"\r\n  803:     contract = fc.FrameContract(min_frames=9, max_frames=17, quantum=8,\r\n  804:                                 allow_tail_trim=False,\r\n  805:                                 continuity=fc.CONTINUITY_SOFT_REFERENCE)\r\n  806:     with pytest.raises(cp.CoveragePlanError, match=\"no exact multi-clip\"):\r\n  807:         cp.partition_beat(51, contract, max_segments=2)\r\n  808: \r\n  809:     plan = cp.partition_beat(51, contract, max_segments=3)\r\n  810:     assert plan.segment_count == 3\r\n  811:     assert [s.render_frames for s in plan.segments] == [17, 17, 17]\r\n  812:     assert plan.total_visible_frames == 51\r\n  813: \r\n  814: \r\n  815: def test_a_trimmed_plan_never_starves_its_LAST_segment():\r\n  816:     \"\"\"The trim guard's contract, asserted as a property.\r\n  817: \r\n  818:     RECORDED HONESTLY: two mutants of the guard itself\r\n  819:     (``lengths[-1]`` -> ``lengths[0]``, and deleting the guard outright)\r\n  820:     SURVIVED a mutation round, and the reason is not a missing test -- it is\r\n  821:     that the guard cannot fire. ``_candidate_totals`` yields the SMALLEST\r\n  822:     reachable total at or above what is required, so the overshoot it hands\r\n  823:     back is never big enough to eat a whole final segment. An exhaustive\r\n  824:     sweep over every ladder with ``min<=10, quantum in {1,2,3,4,8}, max<=80``\r\n  825:     and nine discrete menus (including the real Veo and Pixverse ones) found\r\n","exit_code":0,"status":"completed"}}
