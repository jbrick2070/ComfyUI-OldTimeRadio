= cr._sc(cr._COL3_X, 720)\r\n  464:         reg = im.crop((x, cr._sc(cr._COL3_VIEW_Y, 720), im.width, 720 - 40))\r\n  465:         return hashlib.sha1(reg.tobytes()).hexdigest()\r\n  466: \r\n  467:     t_early = cr._LEAD_HOLD_S + 2.0\r\n  468:     t_mid = min(dur - cr._TAIL_HOLD_S - 2.0, t_early + 6.0)\r\n  469:     assert col3_hash(t_early) != col3_hash(t_mid), \\\r\n  470:         \"col 3 text did not scroll (static-crop / overflow-only regression)\"\r\n  471: \r\n  472: \r\n  473: def test_scroll_still_inputs_are_looped_timed(monkeypatch, tmp_path):\r\n  474:     \"\"\"Regression (shipped-obs bug 2026-07-04): col 3 rendered BLANK the whole roll\r\n  475:     because base_png/scroll_png were fed as plain single-frame `-i <png>` inputs.\r\n  476:     A single still is one frame at t=0, so the col-3 crop y-expr (which scrolls on\r\n  477:     `t`) was frozen at y=0 = the blank top pad. They MUST be LOOPED, fps-timed image\r\n  478:     inputs so `t` advances. Capture the render argv and assert `-loop 1 -framerate`\r\n  479:     precedes each still input -- a guard the fade-masked motion test above missed.\"\"\"\r\n  480:     backdrop = _backdrop_png(tmp_path / \"bd.png\")\r\n  481:     seen = {}\r\n  482:     real_run = cr.subprocess.run\r\n  483: \r\n  484:     def _spy(cmd, *a, **k):\r\n  485:         if isinstance(cmd, (list, tuple)) and any(\r\n  486:                 isinstance(c, str) and c.endswith(\".scroll.png\") for c in cmd):\r\n  487:             seen[\"cmd\"] = [str(c) for c in cmd]\r\n  488:             with open(cmd[-1], \"wb\") as fh:            # satisfy the size>0 check\r\n  489:                 fh.write(b\"\\x00\" * 32)\r\n  490: \r\n  491:             class _R:\r\n  492:                 returncode = 0\r\n  493:                 stderr = \"\"\r\n  494:             return _R()\r\n  495:         return real_run(cmd, *a, **k)\r\n  496: \r\n  497:     monkeypatch.setattr(cr.subprocess, \"run\", _spy)\r\n  498:     cr.render_credits_clip(_layout(), str(