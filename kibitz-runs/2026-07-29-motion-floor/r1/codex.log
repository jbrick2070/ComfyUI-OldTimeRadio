(tmp_path / \"out.mp4\"))\r\n  531:     src = open(cr.__file__, encoding=\"utf-8\").read()\r\n  532:     assert \"copy2\" not in src\r\n  533: \r\n  534: \r\n  535: # --------------------------------------------------------------------------- #\r\n  536: # Node surface (widget-drift guard)\r\n  537: # --------------------------------------------------------------------------- #\r\n  538: def test_node_surface_two_force_inputs_no_widgets():\r\n  539:     it = cr.OTRCreditsRoll.INPUT_TYPES()\r\n  540:     req = it[\"required\"]\r\n","exit_code":0,"status":"completed"}}
