{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/coverage_plan.py' | ForEach-Object { \"'$n++; if($n -ge 270 -and $n -le 430) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  270: \r\n  271: def partition_beat(target_visible_frames, contract, *, join_mode=None,\r\n  272:                    max_segments=64) -> CoveragePlan:\r\n  273:     \"\"\"THE ENTRY POINT: cover ``target_visible_frames`` exactly.\r\n  274: \r\n  275:     Raises :class:`CoveragePlanError` when no exact cover exists, rather than\r\n  276:     returning a plan whose assembled length would drift from the beat's audio.\r\n  277:     \"\"\"\r\n  278:     target = int(target_visible_frames)\r\n  279:     if target < 1:\r\n  280:         raise CoveragePlanError(\r\n  281:             \"target_visible_frames must be >= 1, got %r\" % (target_visible_frames,))\r\n  282: \r\n  283:     mode = join_mode or join_mode_for(contract, target)\r\n  284:     if mode not in JOIN_MODES:\r\n  285:         raise CoveragePlanError(\"unknown join_mode %r\" % (mode,))\r\n  286: \r\n  287:     # ---- one render, the whole beat -------------------------------------- #\r\n  288:     if mode == JOIN_SINGLE:\r\n  289:         if contract.is_legal_length(target):\r\n  290:             return CoveragePlan(target, mode,\r\n  291:                                 (CoverageSegment(0, target),))\r\n  292:         if contract.allow_tail_trim:\r\n  293:             render = contract.smallest_legal_at_least(target)\r\n  294:             if render is not None:\r\n  295:                 return CoveragePlan(\r\n  296:                     target, mode,\r\n  297:                     (CoverageSegment(0, render, trim_tail=render - target),))\r\n  298:         raise CoveragePlanError(\r\n  299:             \"beat of %d visible frame(s) is not a legal single render for this \"\r\n  300:             \"contract (min=%s max=%s quantum=%s discrete=%s allow_tail_trim=%s) \"\r\n  301:             \"and JOIN_SINGLE was forced by the caller, so there is no second \"\r\n  302:             \"clip to cover the remainder\"\r\n  303:             % (target, contract.min_frames, contract.max_frames,\r\n  304:                contract.quantum, contract.discrete_frames,\r\n  305:                contract.allow_tail_trim))\r\n  306: \r\n  307:     # ---- multi-clip ------------------------------------------------------- #\r\n  308:     # Under CHAIN every successor duplicates its predecessor's terminal frame,\r\n  309:     # so covering `target` visible frames with k segments requires rendering\r\n  310:     # `target + (k - 1)` frames in total.\r\n  311:     drop = 1 if mode == JOIN_CHAIN else 0\r\n  312:     splitter = (_discrete_partition if contract.discrete_frames\r\n  313:                 else _ladder_partition)\r\n  314: \r\n  315:     # ONE WALK, AND THE LOWEST COUNT WINS (W1, 2026-07-29). Each count gets\r\n  316:     # both of its chances -- an exact cover first, then a TRIMMED total the\r\n  317:     # contract already permits -- before the search advances.\r\n  318:     #\r\n  319:     # This used to be TWO walks. The first tried an exact cover at every count\r\n  320:     # from 2 to ``max_segments``; only once that entire walk failed did a\r\n  321:     # second walk start again at count 2 looking for a trimmed one. So an\r\n  322:     # exact cover at a HIGH count always beat a trimmed cover at a LOW one,\r\n  323:     # which contradicts the count-first contract stated at the top of this\r\n  324:     # module -- and it cost real renders. A 184-frame HuMo beat (33 + 4k\r\n  325:     # ladder, jump cut, tail trim allowed) planned ``[85, 33, 33, 33]``:\r\n  326:     # ``c`` segments reach totals congruent to ``c`` modulo 4, so an exact\r\n  327:     # cover of 184 needs a count divisible by 4, and the first is FOUR. All\r\n  328:     # the while ``[153, 33]`` with two frames trimmed was legal at count 2.\r\n  329:     # Four model loads, four renders and four seams, to avoid discarding two\r\n  330:     # frames the beat audio never asked for.\r\n  331:     #\r\n  332:     # A trim is not a last resort to be reached once the ladder is exhausted.\r\n  333:     # It is part of what a given COUNT can do, and the adapter said so itself\r\n  334:     # by declaring ``allow_tail_trim``.\r\n  335:     #\r\n  336:     # WHAT THIS DELIBERATELY DOES NOT DO: bound the trim. A pre-push fan-out\r\n  337:     # asked whether a low count should ever be refused for discarding too\r\n  338:     # much, and built the case -- covering 1019 frames from a ``(10, 999)``\r\n  339:     # discrete menu, two segments give ``[999, 999]`` and throw away 979\r\n  340:     # frames where three give ``[999, 10, 10]`` exactly. A bound was written\r\n  341:     # and MEASURED, and it cost more than it saved: on a ``min=4 max=12\r\n  342:     # quantum=8`` ladder it turned ``[12, 12]`` into ``[12, 4, 4]`` -- a third\r\n  343:     # render, a third model load and a third seam, to recover four frames --\r\n  344:     # and it did that to 4,885 cases across the sweep grid. No contract in\r\n  345:     # this tree has a menu gap wide enough to produce the pathological case\r\n  346:     # (the widest shipped menus are Veo's 100/150/200 and Pixverse's 125/200,\r\n  347:     # whose worst trim is 25 frames), so the bound was reverted and the\r\n  348:     # observation filed instead. Revisit if an adapter ever declares a menu\r\n  349:     # whose largest entry dwarfs its smallest.\r\n  350:     for count in range(2, int(max_segments) + 1):\r\n  351:         required = target + drop * (count - 1)\r\n  352: \r\n  353:         lengths = splitter(required, contract, count)\r\n  354:         if lengths is not None:\r\n  355:             return _build(target, mode, lengths, drop)\r\n  356: \r\n  357:         if not contract.allow_tail_trim:\r\n  358:             continue\r\n  359: \r\n  360:         # ---- no exact cover at this count; trim the tail ------------------ #\r\n  361:         #\r\n  362:         # THE SEARCH RANGE IS DERIVED, NOT GUESSED (2026-07-25 QA fix). This\r\n  363:         # used to try only ``extra in range(1, quantum + 1)``, on the\r\n  364:         # assumption that any shortfall could be bridged within one quantum\r\n  365:         # step. That is false whenever ``count * min_frames`` overshoots the\r\n  366:         # required total by more than one step -- which happens routinely just\r\n  367:         # above ``max_frames`` when ``min_frames`` is large relative to the\r\n  368:         # gap. An adversarial sweep found 832 beats that WERE coverable by\r\n  369:         # trimming and were refused anyway. Smallest repro: min=4 max=5\r\n  370:         # quantum=1 target=6, where [4, 4] with a 2-frame tail trim is a\r\n  371:         # perfectly legal cover.\r\n  372:         #\r\n  373:         # The honest range comes from the ladder itself: for a given segment\r\n  374:         # count the total render must be congruent to ``count * min_frames``\r\n  375:         # modulo the quantum, so the smallest legal total at or above the\r\n  376:         # required total is fully determined. There is nothing left to guess.\r\n  377:         for total in _candidate_totals(required, contract, count):\r\n  378:             lengths = splitter(total, contract, count)\r\n  379:             if lengths is None:\r\n  380:                 continue\r\n  381:             trim = total - required\r\n  382:             # The trim comes off the LAST segment, which must still\r\n  383:             # contribute at least one visible frame after its head drop.\r\n  384:             if lengths[-1] - drop - trim < 1:\r\n  385:                 continue\r\n  386:             return _build(target, mode, lengths, drop, trim_tail=trim)\r\n  387: \r\n  388:     raise CoveragePlanError(\r\n  389:         \"no exact multi-clip cover of %d visible frame(s) exists for this \"\r\n  390:         \"contract (min=%s max=%s quantum=%s discrete=%s allow_tail_trim=%s) \"\r\n  391:         \"within %d segments -- refusing to emit a plan whose assembled length \"\r\n  392:         \"would drift from the beat audio\"\r\n  393:         % (target, contract.min_frames, contract.max_frames, contract.quantum,\r\n  394:            contract.discrete_frames, contract.allow_tail_trim, max_segments))\r\n  395: \r\n  396: \r\n  397: def _build(target, mode, lengths, drop, trim_tail=0):\r\n  398:     segments = []\r\n  399:     for index, render in enumerate(lengths):\r\n  400:         segments.append(CoverageSegment(\r\n  401:             index=index,\r\n  402:             render_frames=int(render),\r\n  403:             drop_head=(drop if index else 0),\r\n  404:             trim_tail=(int(trim_tail) if index == len(lengths) - 1 else 0),\r\n  405:         ))\r\n  406:     plan = CoveragePlan(target, mode, tuple(segments))\r\n  407:     validate_coverage_plan(plan, None)   # arithmetic self-check, contract-free\r\n  408:     return plan\r\n  409: \r\n  410: \r\n  411: def validate_coverage_plan(plan: CoveragePlan, contract):\r\n  412:     \"\"\"Validate a plan at a BOUNDARY. Raises :class:`CoveragePlanError`.\r\n  413: \r\n  414:     Called on BOTH sides of the wire -- where the plan is serialized and again\r\n  415:     before it is executed -- because a plan that survives serialization but not\r\n  416:     execution is exactly the class of defect a durable stamp is supposed to\r\n  417:     prevent. ``contract`` may be ``None`` to check the arithmetic alone.\r\n  418:     \"\"\"\r\n  419:     if not plan.segments:\r\n  420:         raise CoveragePlanError(\"coverage plan has no segments\")\r\n  421:     if plan.join_mode not in JOIN_MODES:\r\n  422:         raise CoveragePlanError(\"unknown join_mode %r\" % (plan.join_mode,))\r\n  423: \r\n  424:     for index, seg in enumerate(plan.segments):\r\n  425:         if seg.index != index:\r\n  426:             raise CoveragePlanError(\r\n  427:                 \"segment %d carries index %d -- segment order is the assembly \"\r\n  428:                 \"order and must be dense and ascending\" % (index, seg.index))\r\n  429:         if seg.render_frames < 1:\r\n  430:             raise CoveragePlanError(\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/frame_contract.py' | ForEach-Object { \"'$n++; if($n -ge 90 -and $n -le 230) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/frame_contract.py' | ForEach-Object { \"'$n++; if($n -ge 90 -and $n -le 230) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"   90: @dataclass(frozen=True)\r\n   91: class FrameContract:\r\n   92:     \"\"\"The STATIC, PURE set of render lengths an adapter will accept.\r\n   93: \r\n   94:     ``min_frames`` / ``max_frames``\r\n   95:         Inclusive bounds on ONE render call. ``max_frames`` is the adapter's\r\n   96:         own hard ceiling, not a VRAM guess.\r\n   97:     ``quantum``\r\n   98:         Legal lengths are ``min_frames + k * quantum``. An ``8n+1`` engine\r\n   99:         declares ``min_frames=9, quantum=8``. ``1`` means any length in range.\r\n  100:     ``discrete_frames``\r\n  101:         For providers that only accept a fixed menu of clip lengths (Veo's\r\n  102:         4/6/8 SECONDS). When non-empty this REPLACES the min/max/quantum\r\n  103:         arithmetic and the legal lengths are exactly these values.\r\n  104: \r\n  105:         THE UNIT IS FRAMES, NOT SECONDS. ``coverage_plan`` compares these\r\n  106:         numbers against ``target_visible_frames`` directly, so a provider menu\r\n  107:         expressed in seconds MUST be multiplied by :attr:`native_fps` at the\r\n  108:         declaration site. Veo's 4/6/8 s at 24 fps declares ``(96, 144, 192)``.\r\n  109:         The field was named ``discrete_durations`` until 2026-07-26; it was\r\n  110:         renamed because the old name invited exactly that seconds-for-frames\r\n  111:         substitution, and a validator cannot catch it -- ``(4, 6, 8)`` is a\r\n  112:         perfectly well-formed frame menu, just a wrong one.\r\n  113:     ``native_fps``\r\n  114:         The frame rate these frame numbers are expressed at, or ``0`` for an\r\n  115:         engine that renders at whatever the canvas asks for. Static and\r\n  116:         informational: it is what lets the matrix report seconds, and what\r\n  117:         tells a reader that a 24 fps provider is being planned against a\r\n  118:         25 fps canvas. It is NOT read by the partitioner.\r\n  119:     ``allow_tail_trim``\r\n  120:         Whether the assembler may render the smallest covering length and trim\r\n  121:         the excess at canonicalization. Discrete-duration lanes REQUIRE this --\r\n  122:         4/6/8s durations cannot sum to an arbitrary beat.\r\n  123:     ``continuity``\r\n  124:         One of :data:`CONTINUITY_MODES`.\r\n  125: \r\n  126:     Frozen, so a contract cannot be mutated after an adapter publishes it --\r\n  127:     the partitioner and the image phase must read the same numbers.\r\n  128:     \"\"\"\r\n  129: \r\n  130:     min_frames: int = 1\r\n  131:     max_frames: int = 0            # 0 == \"unbounded / not declared\"\r\n  132:     quantum: int = 1\r\n  133:     discrete_frames: tuple = field(default_factory=tuple)\r\n  134:     native_fps: int = 0            # 0 == \"renders at the canvas rate\"\r\n  135:     allow_tail_trim: bool = False\r\n  136:     continuity: str = CONTINUITY_NONE\r\n  137: \r\n  138:     def __post_init__(self):\r\n  139:         if self.continuity not in CONTINUITY_MODES:\r\n  140:             raise FrameContractError(\r\n  141:                 \"continuity %r is not one of %r\" % (self.continuity,\r\n  142:                                                     CONTINUITY_MODES))\r\n  143:         if int(self.min_frames) < 1:\r\n  144:             raise FrameContractError(\r\n  145:                 \"min_frames must be >= 1, got %r\" % (self.min_frames,))\r\n  146:         if int(self.quantum) < 1:\r\n  147:             raise FrameContractError(\r\n  148:                 \"quantum must be >= 1, got %r\" % (self.quantum,))\r\n  149:         if self.max_frames and int(self.max_frames) < int(self.min_frames):\r\n  150:             raise FrameContractError(\r\n  151:                 \"max_frames %r is below min_frames %r\"\r\n  152:                 % (self.max_frames, self.min_frames))\r\n  153:         if int(self.native_fps) < 0:\r\n  154:             raise FrameContractError(\r\n  155:                 \"native_fps must be >= 0, got %r\" % (self.native_fps,))\r\n  156:         if self.discrete_frames:\r\n  157:             if any(int(d) < 1 for d in self.discrete_frames):\r\n  158:                 raise FrameContractError(\r\n  159:                     \"discrete_frames must all be >= 1, got %r\"\r\n  160:                     % (self.discrete_frames,))\r\n  161:             if not self.allow_tail_trim:\r\n  162:                 # A fixed menu of lengths cannot sum to an arbitrary beat, so\r\n  163:                 # without tail trimming there are beats this engine could never\r\n  164:                 # cover exactly -- that is a contract that lies.\r\n  165:                 raise FrameContractError(\r\n  166:                     \"discrete_frames requires allow_tail_trim=True: a fixed \"\r\n  167:                     \"length menu cannot sum to an arbitrary beat length\")\r\n  168: \r\n  169:     # -- pure queries -------------------------------------------------- #\r\n  170: \r\n  171:     def is_legal_length(self, n: int) -> bool:\r\n  172:         \"\"\"True iff ``n`` is a length this adapter will accept in one call.\"\"\"\r\n  173:         n = int(n)\r\n  174:         if self.discrete_frames:\r\n  175:             return n in tuple(int(d) for d in self.discrete_frames)\r\n  176:         if n < int(self.min_frames):\r\n  177:             return False\r\n  178:         if self.max_frames and n > int(self.max_frames):\r\n  179:             return False\r\n  180:         return (n - int(self.min_frames)) % int(self.quantum) == 0\r\n  181: \r\n  182:     def legal_lengths(self) -> tuple:\r\n  183:         \"\"\"Every legal length, ascending. Empty when unbounded (nothing to\r\n  184:         enumerate -- callers must use :meth:`is_legal_length` instead).\"\"\"\r\n  185:         if self.discrete_frames:\r\n  186:             return tuple(sorted(int(d) for d in self.discrete_frames))\r\n  187:         if not self.max_frames:\r\n  188:             return ()\r\n  189:         return tuple(range(int(self.min_frames), int(self.max_frames) + 1,\r\n  190:                            int(self.quantum)))\r\n  191: \r\n  192:     def largest_legal_at_most(self, n: int):\r\n  193:         \"\"\"The largest legal length <= ``n``, or None if there is none.\"\"\"\r\n  194:         n = int(n)\r\n  195:         if self.discrete_frames:\r\n  196:             fits = [int(d) for d in self.discrete_frames if int(d) <= n]\r\n  197:             return max(fits) if fits else None\r\n  198:         if n < int(self.min_frames):\r\n  199:             return None\r\n  200:         capped = min(n, int(self.max_frames)) if self.max_frames else n\r\n  201:         steps = (capped - int(self.min_frames)) // int(self.quantum)\r\n  202:         return int(self.min_frames) + steps * int(self.quantum)\r\n  203: \r\n  204:     def smallest_legal_at_least(self, n: int):\r\n  205:         \"\"\"The smallest legal length >= ``n``, or None if it exceeds the\r\n  206:         ceiling. Used with ``allow_tail_trim`` to cover a remainder exactly.\"\"\"\r\n  207:         n = max(int(n), int(self.min_frames))\r\n  208:         if self.discrete_frames:\r\n  209:             fits = [int(d) for d in self.discrete_frames if int(d) >= n]\r\n  210:             return min(fits) if fits else None\r\n  211:         steps = -(-(n - int(self.min_frames)) // int(self.quantum))  # ceil div\r\n  212:         candidate = int(self.min_frames) + steps * int(self.quantum)\r\n  213:         if self.max_frames and candidate > int(self.max_frames):\r\n  214:             return None\r\n  215:         return candidate\r\n  216: \r\n  217: \r\n  218: #: What an engine that declares NOTHING resolves to: unbounded, quantum 1, no\r\n  219: #: chaining. Every length is legal, so it never splits and never refuses -- the\r\n  220: #: pre-7a behaviour of the whole tree, kept as the honest answer for a stub, a\r\n  221: #: custom slot, or an adapter that failed to import. No REGISTERED engine may\r\n  222: #: resolve to it; ``tests/test_engine_contract_roster.py`` fails by name if one\r\n  223: #: does.\r\n  224: SINGLE_ONLY = FrameContract()\r\n  225: \r\n  226: \r\n  227: def frame_contract_for(engine) -> FrameContract:\r\n  228:     \"\"\"Resolve one adapter's declared contract, defaulting to SINGLE_ONLY.\r\n  229: \r\n  230:     Accepts either a ``frame_contract()`` method or a ``frame_contract``\r\n","exit_code":0,"status":"completed"}}
