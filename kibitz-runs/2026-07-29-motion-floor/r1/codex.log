n346:     accepts_still = True            # mint the selected still for it (coverage gate)\r\n347: \r\n348: \r\n349: @register\r\n350: class StillWordFamily(_CheapFamilyBase):\r\n351:     \"\"\"still_word: a ``still_flat`` SIBLING whose base still is minted from a\r\n352:     WORD/TITLE-driven prompt instead of the cinematic scene composer -- the\r\n353:     'the words ARE the picture' option (Sprint B, 2026-07-03, operator).\r\n354: \r\n355:     MODEL-AGNOSTIC by construction: the IMAGE engine that mints the base still\r\n356:     is chosen INDEPENDENTLY in the image dropdown; this VIDEO engine only holds\r\n357:     the minted still dead-flat (fit+pad, no crop -- identical render mechanics\r\n358:     to ``still_flat``). The ONLY delta vs still_flat is the PROMPT, composed\r\n359:     upstream by ``otr_meta_brief_image_prompt.compose_still_word_prompt``\r\n360:     (character/announcer beats -> the beat's spoken line as a readable word\r\n361:     card; music beats -> an abstract picture of the episode title, no words).\r\n362: \r\n363:     NO FALLBACKS: ``_require_still`` makes a missing base still fail LOUD in\r\n364:     render_clip -- never the dark floor -- because a black floor is exactly how\r\n365:     a word/title mint failure would hide. Selectable per role; never a default\r\n366:     (``default_roles=()``).\"\"\"\r\n367:     name = \"still_word\"\r\n368:     family = \"static_image_gen\"\r\n369:     #: S1 per-model still plan (Shape A).\r\n370:     still_plan = _CHEAP_FAMILY_STILL_PLAN\r\n371:     roles = (\"announcer_visual\", \"music_visual\", \"character_video\")\r\n372:     default_roles = ()              # selectable peer; never an auto-default\r\n373:     required_inputs = (\"text_prompt\",)\r\n374:     commercial_clean = True         # own ffmpeg + the chosen still; no model license\r\n375:     uses_still = True               # display the provided (word/title) still...\r\n376:     _still_motion = False           # ...STATIC (flat hold, fit+pad,