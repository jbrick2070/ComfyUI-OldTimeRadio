{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/eng_wan_ti2v.py' | ForEach-Object { \"'$n++; if($n -ge 520 -and $n -le 760) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  520:         would describe a cell that does not exist.\r\n  521: \r\n  522:         NOTHING IS RESOLVED ON A PRODUCTION LEG. The early return is structural,\r\n  523:         not an optimisation -- it keeps the \"never parse what cannot bind\"\r\n  524:         guarantee from depending on every accessor staying correct forever, and\r\n  525:         keeps a production leg from emitting the demotion notice twice.\r\n  526: \r\n  527:         The tile geometry is reported ONLY when tiled decode ran: a knob the\r\n  528:         render never reached is not a departure that describes the clip.\"\"\"\r\n  529:         if not _WR.prequalification_active(PREQUALIFICATION_ENV):\r\n  530:             return {}\r\n  531:         knobs = self._resolve_render_config() if knobs is None else knobs\r\n  532:         resolved = {\r\n  533:             \"steps\": knobs[\"steps\"], \"cfg\": knobs[\"cfg\"],\r\n  534:             \"shift\": knobs[\"shift\"], \"sampler\": knobs[\"sampler\"],\r\n  535:             \"scheduler\": knobs[\"scheduler\"],\r\n  536:             \"negative\": self._negative_prompt(),\r\n  537:             \"tiled_vae\": self._tiled_vae(),\r\n  538:         }\r\n  539:         if resolved[\"tiled_vae\"]:\r\n  540:             for key in _WR.VAE_TILE_BOUNDS:\r\n  541:                 resolved[key] = self._tile_geometry(key)\r\n  542:         return _RD.departures(WAN_TI2V_RECIPE, resolved)\r\n  543: \r\n  544:     def _recipe_receipt(self, knobs=None):\r\n  545:         \"\"\"THE stamp. The single stamp site goes through here and nowhere else\r\n  546:         -- a second site reaching for the bare constant would put an unmarked,\r\n  547:         or an unnamed, sweep clip into the durable ledger.\"\"\"\r\n  548:         return _WR.recipe_receipt(RECIPE_WAN_TI2V, PREQUALIFICATION_ENV,\r\n  549:                                   self._recipe_departures(knobs))\r\n  550: \r\n  551:     def _floor_length(self, target_frame_count, width=None, height=None):\r\n  552:         \"\"\"The VRAM-PREDICTED render length (4n+1) for this beat (clip-fill fix).\r\n  553: \r\n  554:         REPLACES the old hard 17-frame \"8GB floor\" that froze every wan clip to\r\n  555:         0.68s: ``motion_common.compute_real_frame_budget`` reads live free VRAM\r\n  556:         (zero-cost ``mem_get_info``) + a cost model to PREDICT how many of the\r\n  557:         beat's audio-derived ``target_frame_count`` frames fit under the ceiling --\r\n  558:         never react-to-OOM. The render then ping-pong-extends this (possibly short)\r\n  559:         render up to the full target so the beat is FILLED with motion. The motion\r\n  560:         floor (17) always wins; an absolute hard cap for a tiny/8GB card comes\r\n  561:         from ``OTR_WAN_TI2V_MAX_FRAMES`` or, on a production leg, the tier's\r\n  562:         ledger-stamped ``max_render_frames`` (default = the engine max, not 17).\"\"\"\r\n  563:         from . import wrapper_bridge as _wb\r\n  564:         target = int(target_frame_count or _TI2V_DEFAULT_FRAMES)\r\n  565:         # Hard-cap resolution (2026-07-24 WAN 8GB launch contract). BEFORE this,\r\n  566:         # the ONLY channel was the env pin -- which a production episode leg can\r\n  567:         # never see, because it is submitted to an already-booted server and\r\n  568:         # `launch.env` applies to the server process. An 8GB leg therefore\r\n  569:         # inherited the 177-frame engine max, asked for a whole 7s beat, and died\r\n  570:         # in the cost model (2026-07-23 wan_8gb__lumina_image__media_archive).\r\n  571:         # Order: explicit env pin (operator override) -> the tier's\r\n  572:         # profile-carried ceiling (ledger-stamped, the normal path) -> engine max.\r\n  573:         _raw_env = (os.environ.get(\"OTR_WAN_TI2V_MAX_FRAMES\") or \"\").strip()\r\n  574:         try:\r\n  575:             hard_cap = int(_raw_env) if _raw_env else 0\r\n  576:         except (TypeError, ValueError):\r\n  577:             hard_cap = 0\r\n  578:         if hard_cap <= 0:\r\n  579:             hard_cap = self.profile_max_render_frames()\r\n  580:         if hard_cap <= 0:\r\n  581:             hard_cap = _TI2V_MAX_FRAMES\r\n  582:         hard_cap = max(_TI2V_MIN_FRAMES, min(hard_cap, _TI2V_MAX_FRAMES))\r\n  583:         target = max(1, min(target, hard_cap))\r\n  584:         if width is None or height is None:\r\n  585:             width, height = _TI2V_COST_REF_W, _TI2V_COST_REF_H\r\n  586:         budget = _MC.compute_real_frame_budget(\r\n  587:             _MC.free_vram_mb(), target, int(width), int(height), self.name)\r\n  588:         return _wb.quantize_frames_4n1(\r\n  589:             budget, min_frames=_TI2V_MIN_FRAMES, max_frames=hard_cap)\r\n  590: \r\n  591:     def _build_graph(self, request, image_name, plan, length, width, height):\r\n  592:         \"\"\"The declarative Wan TI2V-5B graph (wrapper_bridge.run_graph format).\r\n  593:         ``Wan22ImageToVideoLatent`` builds the latent from the VAE + init image; the\r\n  594:         KSampler takes the CLIPTextEncode positive/negative DIRECTLY (unlike the\r\n  595:         14B's WanImageToVideo, which bundles them). ModelSamplingSD3 applies the 5B\r\n  596:         sigma shift (default 5.0).\"\"\"\r\n  597:         from . import wrapper_bridge as _wb\r\n  598:         W = _wb.Wire\r\n  599:         names = self._loader_names()\r\n  600:         get = request.get if isinstance(request, dict) else (\r\n  601:             lambda k, d=None: getattr(request, k, d))\r\n  602:         cfg_knobs = self._resolve_render_config()        # range-checked, fail-closed\r\n  603:         steps = cfg_knobs[\"steps\"]\r\n  604:         cfg = cfg_knobs[\"cfg\"]\r\n  605:         shift = cfg_knobs[\"shift\"]\r\n  606:         sampler = cfg_knobs[\"sampler\"]\r\n  607:         scheduler = cfg_knobs[\"scheduler\"]\r\n  608:         positive = get(\"text_prompt\") or \"subtle natural motion\"\r\n  609:         negative = self._negative_prompt()               # frozen, fail-closed\r\n  610:         if self._loader_mode() == \"gguf\":\r\n  611:             unet_inputs = {\"unet_name\": names[\"unet\"]}\r\n  612:         else:\r\n  613:             unet_inputs = {\"unet_name\": names[\"unet\"], \"weight_dtype\": \"default\"}\r\n  614:         # CLIPLoaderGGUF takes clip_name + type ONLY (no `device` arg, verified vs\r\n  615:         # /object_info 2026-06-18); the core CLIPLoader also takes device.\r\n  616:         if self._clip_loader_mode() == \"gguf\":\r\n  617:             clip_inputs = {\"clip_name\": names[\"clip\"], \"type\": \"wan\"}\r\n  618:         else:\r\n  619:             clip_inputs = {\"clip_name\": names[\"clip\"], \"type\": \"wan\",\r\n  620:                            \"device\": \"default\"}\r\n  621:         return {\r\n  622:             \"unet\": {\"class\": \"unet\", \"inputs\": unet_inputs},\r\n  623:             \"modelsampling\": {\"class\": \"modelsampling\",\r\n  624:                               \"inputs\": {\"model\": W(\"unet\", 0), \"shift\": shift}},\r\n  625:             \"clip\": {\"class\": \"clip\", \"inputs\": clip_inputs},\r\n  626:             \"pos\": {\"class\": \"pos\",\r\n  627:                     \"inputs\": {\"text\": positive, \"clip\": W(\"clip\", 0)}},\r\n  628:             \"neg\": {\"class\": \"neg\",\r\n  629:                     \"inputs\": {\"text\": negative, \"clip\": W(\"clip\", 0)}},\r\n  630:             \"vae\": {\"class\": \"vae\", \"inputs\": {\"vae_name\": names[\"vae\"]}},\r\n  631:             \"loadimage\": {\"class\": \"loadimage\", \"inputs\": {\"image\": image_name}},\r\n  632:             \"latent\": {\"class\": \"latent\",\r\n  633:                        \"inputs\": {\"width\": int(width), \"height\": int(height),\r\n  634:                                   \"length\": int(length), \"batch_size\": 1,\r\n  635:                                   \"vae\": W(\"vae\", 0),\r\n  636:                                   \"start_image\": W(\"loadimage\", 0)}},\r\n  637:             \"ksampler\": {\"class\": \"ksampler\",\r\n  638:                          \"inputs\": {\"seed\": int(plan.get(\"seed\", 0)), \"steps\": steps,\r\n  639:                                     \"cfg\": cfg, \"sampler_name\": sampler,\r\n  640:                                     \"scheduler\": scheduler, \"denoise\": 1.0,\r\n  641:                                     \"model\": W(\"modelsampling\", 0),\r\n  642:                                     \"positive\": W(\"pos\", 0),\r\n  643:                                     \"negative\": W(\"neg\", 0),\r\n  644:                                     \"latent_image\": W(\"latent\", 0)}},\r\n  645:             \"vaedecode\": {\"class\": \"vaedecode\",\r\n  646:                           \"inputs\": self._vaedecode_inputs(W)},\r\n  647:         }\r\n  648: \r\n  649:     def _vaedecode_inputs(self, W):\r\n  650:         \"\"\"VAEDecode inputs; the tiled path adds the schema-verified tile/temporal\r\n  651:         knobs (FROZEN; temporal_size = frames decoded at a time = the big\r\n  652:         video-VAE peak lever).\"\"\"\r\n  653:         base = {\"samples\": W(\"ksampler\", 0), \"vae\": W(\"vae\", 0)}\r\n  654:         if not self._tiled_vae():\r\n  655:             return base\r\n  656:         # ``_tile_geometry`` is the ONE implementation (LANE 2). It used to be a\r\n  657:         # closure here, and ``_recipe_departures`` would have needed a second\r\n  658:         # copy to report what a sweep cell actually decoded with.\r\n  659:         _i = self._tile_geometry\r\n  660:         base.update({\r\n  661:             \"tile_size\": _i(\"vae_tile\"),\r\n  662:             \"overlap\": _i(\"vae_overlap\"),\r\n  663:             \"temporal_size\": _i(\"vae_temporal\"),\r\n  664:             \"temporal_overlap\": _i(\"vae_temporal_overlap\"),\r\n  665:         })\r\n  666:         return base\r\n  667: \r\n  668:     # ---- residency ----\r\n  669:     def load(self):\r\n  670:         \"\"\"Fail CLOSED until installed, then resolve the installed CORE Wan node\r\n  671:         classes. Weights load when the loader nodes execute in render_clip.\"\"\"\r\n  672:         if not self._installed():\r\n  673:             raise RuntimeError(\r\n  674:                 \"wan_ti2v not installed: UNET missing at %s -- fetch the Wan2.2 \"\r\n  675:                 \"TI2V-5B GGUF, set OTR_ENABLE_WAN_TI2V=1\" % self._ckpt_path())\r\n  676:         from . import wrapper_bridge as _wb\r\n  677:         self._classes = _wb.resolve_graph_classes(self._node_candidates())\r\n  678:         self._loaded = True\r\n  679: \r\n  680:     def render_clip(self, request, prepared):\r\n  681:         \"\"\"Drive ONE image->video clip via the in-process Wan TI2V-5B graph: stage\r\n  682:         the init image, execute the graph, encode the decoded IMAGE batch to a\r\n  683:         SILENT bt709 clip (V-1), retain the MODEL patcher for V-4 teardown, and\r\n  684:         assert the mid-render NVML ceiling. M7 ffprobe-proves the silent-clip\r\n  685:         contract before the mux trusts it. Fail-closed NAMED on a missing node /\r\n  686:         init image.\"\"\"\r\n  687:         from . import wrapper_bridge as _wb\r\n  688:         from ._tmp import otr_engine_tmp_mp4\r\n  689:         plan = self._build_render_request(request)            # pure, CPU-tested\r\n  690:         if not plan[\"init_image\"]:\r\n  691:             raise _wb.GraphExecutionError(\r\n  692:                 \"wan_ti2v requires init_image (got %r)\" % plan[\"init_image\"])\r\n  693:         classes = getattr(self, \"_classes\", None) \\\r\n  694:             or _wb.resolve_graph_classes(self._node_candidates())\r\n  695:         width, height = self._dims(request)\r\n  696:         image_name = self._materialize_init_image(\r\n  697:             request, plan[\"init_image\"], width, height)\r\n  698:         # CLIP-FILL: PREDICT the VRAM-affordable render length for THIS canvas\r\n  699:         # (never react-to-OOM); the short render is ping-pong-extended to the beat\r\n  700:         # target below so the composite never freeze-fills the beat.\r\n  701:         length = self._floor_length(plan[\"target_frame_count\"], width, height)\r\n  702:         graph = self._build_graph(request, image_name, plan, length, width, height)\r\n  703:         # free_after_use: the umt5 text-encode frees before the 5B UNET + the 2.2\r\n  704:         # VAE decode; \"unet\" kept for V-4 patcher teardown, \"vae\" for the decode,\r\n  705:         # the terminal for the IMAGE read-out. The NVML peak probe spans the whole\r\n  706:         # render window so the render-phase peak gates the ceiling.\r\n  707:         probe = _MC.VramPeakProbe(interval_s=0.1).start()\r\n  708:         try:\r\n  709:             results = _wb.run_graph(graph, classes, free_after_use=True,\r\n  710:                                     keep={\"unet\", \"vae\", self._TERMINAL})\r\n  711:             images = results[self._TERMINAL][0]               # VAEDecode IMAGE batch\r\n  712:         finally:\r\n  713:             render_peak = probe.stop()\r\n  714:         bucket = prepared.setdefault(\"patchers\", self._patchers) \\\r\n  715:             if isinstance(prepared, dict) else self._patchers\r\n  716:         model = results.get(\"unet\", (None,))[0]\r\n  717:         if model is not None and callable(getattr(model, \"detach\", None)) \\\r\n  718:                 and id(model) not in {id(p) for p in bucket}:\r\n  719:             bucket.append(model)\r\n  720:         frames = _wb.images_to_uint8(images)\r\n  721:         # CLIP-FILL: ping-pong-extend the VRAM-bounded short render up to the\r\n  722:         # beat's audio-derived target so the composite fills the beat with motion\r\n  723:         # instead of holding the last frame (the 0.68s-then-freeze bug). A no-op\r\n  724:         # when the native render already meets the target (extend returns as-is).\r\n  725:         target_frames = int(plan.get(\"target_frame_count\") or 0)\r\n  726:         n_native = len(frames)\r\n  727:         if target_frames > n_native:\r\n  728:             frames = _wb.extend_frames_to_target(frames, target_frames)\r\n  729:             _LOG.warning(\r\n  730:                 \"[OTR video] wan_ti2v CLIP-FILL: rendered %d frame(s) -> \"\r\n  731:                 \"ping-pong extended to %d (beat target %d) @ %dx%d so the beat \"\r\n  732:                 \"is FILLED with motion (no hold-last-frame freeze)\",\r\n  733:                 n_native, len(frames), target_frames, width, height)\r\n  734:         out_path = otr_engine_tmp_mp4(\"otr_wan_ti2v_\")\r\n  735:         path, n = _wb.encode_frames_to_silent_mp4(frames, out_path, self.target_fps)\r\n  736:         # M7: PROVE the silent-clip color/stream contract on the emitted mp4.\r\n  737:         validate_silent_clip_contract(ffprobe_clip_fields(path), self.target_fps)\r\n  738:         if not os.environ.get(\"OTR_TEST_MODE\"):\r\n  739:             post_mb = _MC.vram_used_mb() or 0\r\n  740:             _LOG.info(\"[OTR video] wan_ti2v VRAM render-phase peak %s MB / post %s \"\r\n  741:                       \"MB\", render_peak, post_mb)\r\n  742:         # NEWBUG-1 (2026-07-20): thread the MEASURED render-window peak into the raw\r\n  743:         # so _clip_from_raw stamps it -> the manifest vram_peak_mb receipt is populated\r\n  744:         # for the wan lane (was ALWAYS None: the peak was logged, never returned).\r\n  745:         # Required for the wan_8gb VRAM-acceptance telemetry.\r\n  746:         #\r\n  747:         # `recipe` is the same shape of receipt for the render CONFIG: it rides\r\n  748:         # _clip_from_raw -> the manifest row -> stamp_durable(meta.render_engines),\r\n  749:         # so a published episode can be asked which recipe rendered it. It was\r\n  750:         # None on every WAN clip until the freeze landed.\r\n  751:         return {\"out_path\": path, \"frame_count\": n, \"vram_peak_mb\": render_peak,\r\n  752:                 \"recipe\": self._recipe_receipt()}\r\n  753: \r\n  754:     def canonicalize(self, raw, request, profile):\r\n  755:         return self._clip_from_raw(raw, request)\r\n  756: \r\n  757: \r\n  758: __all__ = [\"WanTi2vEngine\", \"RECIPE_WAN_TI2V\", \"WAN_TI2V_RECIPE\",\r\n  759:            \"PREQUALIFICATION_ENV\"]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/otr_credits_roll.py' | ForEach-Object { \"'$n++; if($n -ge 1130 -and $n -le 1470) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/otr_credits_roll.py' | ForEach-Object { \"'$n++; if($n -ge 1130 -and $n -le 1470) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":" 1130: # =========================================================================== #\r\n 1131: # Duration + backdrop\r\n 1132: # =========================================================================== #\r\n 1133: def compute_credits_duration_s(roll_px: int, view_h: int,\r\n 1134:                                pps: float = _SCROLL_PPS) -> tuple:\r\n 1135:     \"\"\"Returns (dur_s, effective_pps) for the CLASSIC credits roll.\r\n 1136: \r\n 1137:     ``roll_px`` = the full travel distance of the col-3 canvas (content_h +\r\n 1138:     view_h): the content enters from BELOW the viewport and fully exits above\r\n 1139:     it, so EVERY line passes through the viewport -- nothing is ever clipped,\r\n 1140:     and it ALWAYS rolls regardless of transcript length (roundtable R1: the old\r\n 1141:     overflow-only ``content_h - view_h`` model left short episodes static +\r\n 1142:     clipped). Over the ceiling -> SPEED UP (never truncate).\"\"\"\r\n 1143:     if pps <= 0:\r\n 1144:         raise CreditsDataError(f\"pps must be > 0 (got {pps})\")\r\n 1145:     roll_px = max(1, int(roll_px))\r\n 1146:     dur = _LEAD_HOLD_S + roll_px / pps + _TAIL_HOLD_S\r\n 1147:     eff = pps\r\n 1148:     if dur > _MAX_HOLD_S:\r\n 1149:         eff = roll_px / max(1.0, _MAX_HOLD_S - _LEAD_HOLD_S - _TAIL_HOLD_S)\r\n 1150:         dur = _MAX_HOLD_S\r\n 1151:     return (round(dur, 3), eff)\r\n 1152: \r\n 1153: \r\n 1154: def extract_final_frame(video_path: str, out_png: str) -> str:\r\n 1155:     \"\"\"The backdrop: the BODY VIDEO's own final frame, frozen.\r\n 1156: \r\n 1157:     REPLACES ``plan_backdrop`` (2026-07-29, WIRE-W6), which hunted the clip\r\n 1158:     manifest for the last loopable FILE clip and raised when it found none.\r\n 1159: \r\n 1160:     THE DEFECT THAT KILLED: it excluded DIRECTORY clips, because ffmpeg\r\n 1161:     ``-stream_loop -1 -i <dir>`` crashes -- and ``mesh_stage`` writes a frame\r\n 1162:     directory rather than an mp4. So an episode rendered ENTIRELY by mesh_stage\r\n 1163:     had no file clip at all, and the terminal node of the graph refused the\r\n 1164:     whole finished episode. It rendered 7 of 7 shots and published nothing. Not\r\n 1165:     a regression -- true since 2026-07-03, and found by the 2026-07-28\r\n 1166:     engine-coverage campaign.\r\n 1167: \r\n 1168:     THE FIX IS TO STOP LOOKING THERE. ``otr_silent_composite`` has ALREADY\r\n 1169:     flattened every directory clip into the assembled body video by the time\r\n 1170:     this node runs, so the body video is a complete, always-present, always-mp4\r\n 1171:     record of the same pixels -- and it is already this node's own input. One\r\n 1172:     source instead of two. CreditsRoll no longer knows what a directory clip\r\n 1173:     is, and cannot be broken again by a new clip KIND it has never heard of.\r\n 1174: \r\n 1175:     LOOK DELTA, STATED PLAINLY BECAUSE IT IS VISIBLE: the operator's 2026-06-17\r\n 1176:     contract said the console rides over the last drama clip LOOPED. It now\r\n 1177:     rides over that clip's final frame HELD. Still drama, still darkened, still\r\n 1178:     never black -- but motionless for the length of the roll. Ratified in the\r\n 1179:     2026-07-28 wiring arc (r3, unamended by r4); flagged here for an eyeball\r\n 1180:     because a panel cannot judge how a 52-second held frame reads.\r\n 1181: \r\n 1182:     ``-sseof -3`` seeks three seconds from the END and takes the last frame\r\n 1183:     that decodes, which is robust on a container whose duration metadata is\r\n 1184:     approximate. RAISES: a body video whose final frame cannot be read is not\r\n 1185:     a presentation problem, it is an unreadable body.\r\n 1186:     \"\"\"\r\n 1187:     cmd = [_ffmpeg_bin(), \"-y\", \"-sseof\", \"-3\", \"-i\", video_path,\r\n 1188:            \"-update\", \"1\", \"-frames:v\", \"1\", \"-q:v\", \"2\", out_png]\r\n 1189:     r = subprocess.run(cmd, capture_output=True, text=True)\r\n 1190:     if r.returncode != 0 or not os.path.exists(out_png) \\\r\n 1191:             or os.path.getsize(out_png) == 0:\r\n 1192:         # A very short body may have nothing 3s from the end; take frame 0.\r\n 1193:         r = subprocess.run(\r\n 1194:             [_ffmpeg_bin(), \"-y\", \"-i\", video_path,\r\n 1195:              \"-update\", \"1\", \"-frames:v\", \"1\", \"-q:v\", \"2\", out_png],\r\n 1196:             capture_output=True, text=True)\r\n 1197:     if r.returncode != 0 or not os.path.exists(out_png) \\\r\n 1198:             or os.path.getsize(out_png) == 0:\r\n 1199:         raise CreditsDataError(\r\n 1200:             \"could not extract a backdrop frame from the body video %r \"\r\n 1201:             \"(rc=%s): %s\" % (video_path, r.returncode, (r.stderr or \"\")[-500:]))\r\n 1202:     return out_png\r\n 1203: \r\n 1204: \r\n 1205: # =========================================================================== #\r\n 1206: # ffmpeg render + append (every failure RAISES; no source-copy)\r\n 1207: # =========================================================================== #\r\n 1208: def _ffmpeg_bin() -> str:\r\n 1209:     # Honor OTR_FFMPEG (the sibling video nodes' config path) before PATH, so\r\n 1210:     # credits never fail on a box where ffmpeg is configured but not on PATH.\r\n 1211:     cand = (os.environ.get(\"OTR_FFMPEG\") or \"\").strip()\r\n 1212:     p = (cand if (cand and (os.path.isfile(cand) or shutil.which(cand)))\r\n 1213:          else shutil.which(\"ffmpeg\"))\r\n 1214:     if not p:\r\n 1215:         raise CreditsDataError(\r\n 1216:             \"ffmpeg not found (OTR_FFMPEG / PATH) -- cannot render credits\")\r\n 1217:     return p\r\n 1218: \r\n 1219: \r\n 1220: def _ffprobe_bin() -> str:\r\n 1221:     cand = (os.environ.get(\"OTR_FFPROBE\") or \"\").strip()\r\n 1222:     p = (cand if (cand and (os.path.isfile(cand) or shutil.which(cand)))\r\n 1223:          else shutil.which(\"ffprobe\"))\r\n 1224:     if not p:\r\n 1225:         raise CreditsDataError(\r\n 1226:             \"ffprobe not found (OTR_FFPROBE / PATH) -- cannot render credits\")\r\n 1227:     return p\r\n 1228: \r\n 1229: \r\n 1230: def _probe_video(path: str) -> dict:\r\n 1231:     out = subprocess.run(\r\n 1232:         [_ffprobe_bin(), \"-v\", \"error\", \"-select_streams\", \"v:0\",\r\n 1233:          \"-show_entries\", \"stream=width,height,r_frame_rate\",\r\n 1234:          \"-show_entries\", \"format=duration\", \"-of\", \"json\", path],\r\n 1235:         capture_output=True, text=True)\r\n 1236:     if out.returncode != 0:\r\n 1237:         raise CreditsDataError(f\"ffprobe failed on {path!r}: {out.stderr}\")\r\n 1238:     data = json.loads(out.stdout or \"{}\")\r\n 1239:     st = (data.get(\"streams\") or [{}])[0]\r\n 1240:     num, _, den = str(st.get(\"r_frame_rate\") or \"25/1\").partition(\"/\")\r\n 1241:     fps = float(num) / float(den or 1)\r\n 1242:     try:\r\n 1243:         dur = float((data.get(\"format\") or {}).get(\"duration\") or 0.0)\r\n 1244:     except (TypeError, ValueError):\r\n 1245:         dur = 0.0\r\n 1246:     return {\"w\": int(st.get(\"width\") or 0), \"h\": int(st.get(\"height\") or 0),\r\n 1247:             \"fps\": fps, \"duration\": dur}\r\n 1248: \r\n 1249: \r\n 1250: def render_credits_clip(layout: dict, backdrop_path: str, out_path: str,\r\n 1251:                         *, w: int, h: int, fps: float) -> float:\r\n 1252:     \"\"\"Render the SILENT credits console clip: static base (cols 1-2) + the\r\n 1253:     scrolling col-3 canvas, over the LOOPED darkened backdrop, with a fade in/out.\r\n 1254:     Returns the clip duration (== declared credits tail). RAISES on any failure.\"\"\"\r\n 1255:     base_img = render_static_base(layout, w, h)\r\n 1256:     scroll_img = render_scroll_canvas(layout[\"col3_flow\"],\r\n 1257:                                       _sc(_COL3_W, h), h)\r\n 1258:     col3_x = _sc(_COL3_X, h)\r\n 1259:     col3_y = _sc(_COL3_VIEW_Y, h)\r\n 1260:     view_h = min(_sc(_COL3_VIEW_H, h), h - col3_y - _sc(40, h))\r\n 1261:     # CLASSIC ROLL (roundtable R1 fix): pad the scroll canvas view_h transparent\r\n 1262:     # at TOP and BOTTOM so the content ENTERS from below the viewport and EXITS\r\n 1263:     # above the top -- EVERY line passes through the viewport, nothing is ever\r\n 1264:     # clipped, and it ALWAYS rolls regardless of transcript length. The crop\r\n 1265:     # window travels y = 0 .. roll_px where roll_px = content_h + view_h.\r\n 1266:     from PIL import Image as _Image\r\n 1267:     _padded = _Image.new(\r\n 1268:         \"RGBA\", (scroll_img.width, scroll_img.height + 2 * view_h), (0, 0, 0, 0))\r\n 1269:     _padded.paste(scroll_img, (0, view_h))\r\n 1270:     scroll_img = _padded\r\n 1271:     roll_px = scroll_img.height - view_h            # = content_h + view_h\r\n 1272:     dur, eff_pps = compute_credits_duration_s(roll_px, view_h)\r\n 1273: \r\n 1274:     base_png = out_path + \".base.png\"\r\n 1275:     scroll_png = out_path + \".scroll.png\"\r\n 1276:     base_img.convert(\"RGBA\").save(base_png)\r\n 1277:     scroll_img.convert(\"RGBA\").save(scroll_png)\r\n 1278:     try:\r\n 1279:         yexpr = \"clip((t-%.3f)*%.4f\\\\,0\\\\,%d)\" % (_LEAD_HOLD_S, eff_pps, roll_px)\r\n 1280:         fade_out_st = max(0.0, dur - _FADE_OUT_S)\r\n 1281:         cmd = [\r\n 1282:             _ffmpeg_bin(), \"-y\",\r\n 1283:             # The backdrop is a STILL (the body video's frozen final frame --\r\n 1284:             # see `extract_final_frame`), so it is looped like the other two\r\n 1285:             # image inputs rather than `-stream_loop`ed like a clip. It still\r\n 1286:             # feeds the same scale/crop/darken chain below, so the console's\r\n 1287:             # look is unchanged apart from the frame being held.\r\n 1288:             \"-loop\", \"1\", \"-framerate\", f\"{fps}\", \"-i\", backdrop_path,\r\n 1289:             # base + scroll are STILLS: they MUST be looped image inputs at the clip\r\n 1290:             # fps so each carries an advancing per-frame timestamp. Fed as a plain\r\n 1291:             # `-i <png>` they are a SINGLE frame at t=0, so the col-3 crop y-expr\r\n 1292:             # (which scrolls on `t`) is frozen at y=0 -> the blank top pad, and the\r\n 1293:             # whole scroll column renders empty for the entire roll (the shipped bug).\r\n 1294:             \"-loop\", \"1\", \"-framerate\", f\"{fps}\", \"-i\", base_png,\r\n 1295:             \"-loop\", \"1\", \"-framerate\", f\"{fps}\", \"-i\", scroll_png,\r\n 1296:             \"-filter_complex\",\r\n 1297:             (f\"[0:v]scale={w}:{h}:force_original_aspect_ratio=increase,\"\r\n 1298:              f\"crop={w}:{h},eq=brightness=-0.32,fps={fps}[bg];\"\r\n 1299:              f\"[bg][1:v]overlay=0:0[b1];\"\r\n 1300:              # The crop y-expr scrolls per-frame (this ffmpeg evaluates crop x/y\r\n 1301:              # per frame; proven by the text-scroll test). The REAL fix is the\r\n 1302:              # classic-roll model above (roll_px = content_h + view_h): a large,\r\n 1303:              # length-independent travel so col 3 ALWAYS visibly rolls and nothing\r\n 1304:              # is clipped (the old overflow-only model left short episodes static).\r\n 1305:              f\"[2:v]crop=w={_sc(_COL3_W, h)}:h={view_h}:x=0:y='{yexpr}'[sc];\"\r\n 1306:              f\"[b1][sc]overlay={col3_x}:{col3_y}[cv];\"\r\n 1307:              f\"[cv]fade=t=in:st=0:d={_FADE_IN_S:.2f},\"\r\n 1308:              f\"fade=t=out:st={fade_out_st:.2f}:d={_FADE_OUT_S:.2f}[v]\"),\r\n 1309:             \"-map\", \"[v]\", \"-an\",\r\n 1310:             \"-t\", f\"{dur:.3f}\",\r\n 1311:             \"-c:v\", \"libx264\", \"-pix_fmt\", \"yuv420p\", \"-preset\", \"veryfast\",\r\n 1312:             \"-crf\", \"18\", out_path,\r\n 1313:         ]\r\n 1314:         r = subprocess.run(cmd, capture_output=True, text=True)\r\n 1315:         if r.returncode != 0 or not os.path.exists(out_path) \\\r\n 1316:                 or os.path.getsize(out_path) == 0:\r\n 1317:             raise CreditsDataError(\r\n 1318:                 f\"credits console render failed (rc={r.returncode}): \"\r\n 1319:                 f\"{(r.stderr or '')[-1000:]}\")\r\n 1320:     finally:\r\n 1321:         for p in (base_png, scroll_png):\r\n 1322:             try:\r\n 1323:                 os.remove(p)\r\n 1324:             except OSError:\r\n 1325:                 pass\r\n 1326:     return dur\r\n 1327: \r\n 1328: \r\n 1329: def append_credits(body_path: str, credits_path: str, out_path: str) -> str:\r\n 1330:     \"\"\"Concat body + credits (both silent, matching params) via the concat\r\n 1331:     demuxer, stream-copy. NO source-copy fallback: any failure RAISES.\"\"\"\r\n 1332:     if not os.path.exists(body_path):\r\n 1333:         raise CreditsDataError(f\"body video missing: {body_path!r}\")\r\n 1334:     if not os.path.exists(credits_path):\r\n 1335:         raise CreditsDataError(f\"credits clip missing: {credits_path!r}\")\r\n 1336:     lst = out_path + \".concat.txt\"\r\n 1337:     with open(lst, \"w\", encoding=\"utf-8\") as f:\r\n 1338:         for p in (body_path, credits_path):\r\n 1339:             f.write(\"file '%s'\\n\" % p.replace(\"\\\\\", \"/\").replace(\"'\", r\"'\\''\"))\r\n 1340:     try:\r\n 1341:         r = subprocess.run(\r\n 1342:             [_ffmpeg_bin(), \"-y\", \"-f\", \"concat\", \"-safe\", \"0\", \"-i\", lst,\r\n 1343:              \"-c\", \"copy\", out_path],\r\n 1344:             capture_output=True, text=True)\r\n 1345:         if r.returncode != 0 or not os.path.exists(out_path) \\\r\n 1346:                 or os.path.getsize(out_path) == 0:\r\n 1347:             raise CreditsDataError(\r\n 1348:                 f\"credits append (concat) failed (rc={r.returncode}): \"\r\n 1349:                 f\"{(r.stderr or '')[-800:]}\")\r\n 1350:     finally:\r\n 1351:         try:\r\n 1352:             os.remove(lst)\r\n 1353:         except OSError:\r\n 1354:             pass\r\n 1355:     return out_path\r\n 1356: \r\n 1357: \r\n 1358: # =========================================================================== #\r\n 1359: # The terminal node (wired 93 -> OTR_CreditsRoll -> 85)\r\n 1360: # =========================================================================== #\r\n 1361: class OTRCreditsRoll:\r\n 1362:     \"\"\"Registered as ``OTR_CreditsRoll``. Appends the late SIGNAL LOST console\r\n 1363:     to node 93's output and hands the mux (85) the video path + the DECLARED\r\n 1364:     credits-tail duration (credits-aware guard).\"\"\"\r\n 1365: \r\n 1366:     CATEGORY = \"OldTimeRadio/v2/video\"\r\n 1367:     FUNCTION = \"roll\"\r\n 1368:     RETURN_TYPES = (\"STRING\", \"FLOAT\", \"STRING\")\r\n 1369:     RETURN_NAMES = (\"video_with_credits_path\", \"declared_credits_tail_s\",\r\n 1370:                     \"report\")\r\n 1371:     OUTPUT_NODE = False\r\n 1372: \r\n 1373:     @classmethod\r\n 1374:     def INPUT_TYPES(cls):\r\n 1375:         return {\"required\": {\r\n 1376:             \"video_path\": (\"STRING\", {\r\n 1377:                 \"forceInput\": True,\r\n 1378:                 \"tooltip\": \"Node 93 output (captions/bars already burned).\"}),\r\n 1379:             \"clip_manifest_json\": (\"STRING\", {\r\n 1380:                 \"forceInput\": True,\r\n 1381:                 \"tooltip\": \"Node 92 slot 1 (third fan-out consumer).\"}),\r\n 1382:         }}\r\n 1383: \r\n 1384:     def roll(self, video_path, clip_manifest_json):\r\n 1385:         from .production_ledger import get_ledger\r\n 1386: \r\n 1387:         if not video_path or not os.path.exists(video_path):\r\n 1388:             raise CreditsDataError(\r\n 1389:                 f\"credits input video missing: {video_path!r}\")\r\n 1390:         try:\r\n 1391:             manifest = json.loads(clip_manifest_json or \"\")\r\n 1392:         except (TypeError, ValueError) as exc:\r\n 1393:             raise CreditsDataError(\r\n 1394:                 f\"clip_manifest_json unparseable: {exc}\") from exc\r\n 1395: \r\n 1396:         # ---- TERMINAL: the body, and the TRUTH the card is a view of ------ #\r\n 1397:         #\r\n 1398:         # THE BOUNDARY (wiring arc r4/A7, 2026-07-29). This node is the LAST\r\n 1399:         # one in the graph, so everything it raises costs a whole rendered\r\n 1400:         # episode. But it may not simply never fail, because the standing\r\n 1401:         # policy is that the card is a VIEW OF THE DURABLE LEDGER, not the\r\n 1402:         # ledger: a record may never elide. So the two halves are split.\r\n 1403:         #\r\n 1404:         # Above this line is TRUTH. An unreadable body, a malformed manifest,\r\n 1405:         # a ledger missing a receipt the card is obliged to show -- these stay\r\n 1406:         # terminal, and `build_credits_layout` keeps raising exactly as it did.\r\n 1407:         # Degrading here would publish an episode whose credits silently claim\r\n 1408:         # less than the build actually knows, which is the one failure this\r\n 1409:         # card exists to prevent.\r\n 1410:         led = get_ledger()\r\n 1411:         vp = _probe_video(video_path)\r\n 1412:         w = vp[\"w\"] or 1920\r\n 1413:         h = vp[\"h\"] or 1080\r\n 1414:         layout = build_credits_layout(led.data, w=w, h=h, manifest=manifest)\r\n 1415: \r\n 1416:         base, ext = os.path.splitext(video_path)\r\n 1417:         credits_clip = base + \"_credits\" + (ext or \".mp4\")\r\n 1418:         backdrop_png = base + \"_credits_backdrop.png\"\r\n 1419:         out = base + \"_with_credits\" + (ext or \".mp4\")\r\n 1420: \r\n 1421:         # ---- PRESENTATION-ONLY: everything that makes GLASS ---------------- #\r\n 1422:         #\r\n 1423:         # Below this line is glass. Frame extraction, the dim/overlay, the\r\n 1424:         # console composition and its encode all produce a PICTURE of truth\r\n 1425:         # already established above. If any of them fails, the honest outcome\r\n 1426:         # is the finished episode WITHOUT a credits tail plus a receipt saying\r\n 1427:         # so -- never the loss of the episode. `declared_credits_tail_s` goes\r\n 1428:         # to 0.0 so the downstream mux's credits-aware guard is told the truth\r\n 1429:         # about what it is receiving, and the report carries ok=False with the\r\n 1430:         # reason rather than a cheerful default.\r\n 1431:         try:\r\n 1432:             extract_final_frame(video_path, backdrop_png)\r\n 1433:             tail_s = render_credits_clip(\r\n 1434:                 layout, backdrop_png, credits_clip, w=w, h=h, fps=vp[\"fps\"])\r\n 1435:             append_credits(video_path, credits_clip, out)\r\n 1436:         except Exception as exc:                      # noqa: BLE001 -- see above\r\n 1437:             log.error(\r\n 1438:                 \"[OTR_CreditsRoll] PRESENTATION FAILURE -- returning the \"\r\n 1439:                 \"finished body with NO credits tail rather than losing the \"\r\n 1440:                 \"episode: %s\", exc)\r\n 1441:             return (video_path, 0.0, json.dumps({\r\n 1442:                 \"ok\": False, \"declared_credits_tail_s\": 0.0,\r\n 1443:                 \"credits_rendered\": False,\r\n 1444:                 \"reason\": \"presentation_failure\",\r\n 1445:                 \"error\": str(exc)[:500],\r\n 1446:                 \"hero\": layout[\"hero\"], \"output\": video_path},\r\n 1447:                 ensure_ascii=True))\r\n 1448:         finally:\r\n 1449:             try:\r\n 1450:                 os.remove(backdrop_png)\r\n 1451:             except OSError:\r\n 1452:                 pass\r\n 1453: \r\n 1454:         report = json.dumps({\r\n 1455:             \"ok\": True, \"declared_credits_tail_s\": round(tail_s, 3),\r\n 1456:             \"credits_rendered\": True,\r\n 1457:             \"hero\": layout[\"hero\"], \"cols\": [len(layout[\"col1\"]),\r\n 1458:                                              len(layout[\"col3_flow\"])],\r\n 1459:             \"backdrop_source\": \"body_final_frame\", \"output\": out},\r\n 1460:             ensure_ascii=True)\r\n 1461:         log.info(\"[OTR_CreditsRoll] appended %.1fs console (hero=%r backdrop=\"\r\n 1462:                  \"body final frame) -> %s\", tail_s, layout[\"hero\"], out)\r\n 1463:         return (out, float(tail_s), report)\r\n 1464: \r\n 1465: \r\n 1466: __all__ = [\r\n 1467:     \"OTRCreditsRoll\", \"CreditsDataError\", \"build_credits_layout\",\r\n 1468:     \"compute_credits_duration_s\", \"extract_final_frame\", \"render_static_base\",\r\n 1469:     \"render_scroll_canvas\", \"render_credits_clip\", \"append_credits\",\r\n 1470: ]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/otr_silent_composite.py' | ForEach-Object { \"'$n++; if($n -ge 400 -and $n -le 610) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/otr_silent_composite.py' | ForEach-Object { \"'$n++; if($n -ge 400 -and $n -le 610) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  400:                      r.get(\"shot_id\"), r.get(\"engine_id\"))\r\n  401:             cursor = slot_end\r\n  402:     else:                                                  # SEQUENTIAL (legacy)\r\n  403:         for r in rows:\r\n  404:             n = int(r.get(\"target_frame_count\") or 0)\r\n  405:             if r.get(\"exists\") and r.get(\"path\"):\r\n  406:                 _fill = _should_loop_fill(r, n)\r\n  407:                 _warn_clip_underrun(r, n, will_loop=_fill)\r\n  408:                 emit(\"clip\", r.get(\"path\"), n, 0, r.get(\"shot_id\"),\r\n  409:                      r.get(\"engine_id\"), loop=_fill,\r\n  410:                      bg_still_path=r.get(\"bg_still_path\"))\r\n  411:             elif floor_available:\r\n  412:                 start = min(cursor, max(0, ff - n)) if ff else cursor\r\n  413:                 emit(\"floor\", \"\", n, start, r.get(\"shot_id\"), r.get(\"engine_id\"))\r\n  414:             else:\r\n  415:                 emit(\"black\", \"\", n, 0, r.get(\"shot_id\"), r.get(\"engine_id\"))\r\n  416:             cursor += n\r\n  417:     if target_total_frames is not None and int(target_total_frames) > cursor:\r\n  418:         # Tail to the master length (the closing-theme region, A/V-sync). Hold\r\n  419:         # the LAST drama clip on screen as the backdrop (operator 2026-06-17\r\n  420:         # \"credits over the scene\" look): a short clip loops, a long one plays\r\n  421:         # its head; fall back to the procgen END-slice / black when there is no\r\n  422:         # real clip. NOTE (credits enrichment 2026-07-03): this fills only to the\r\n  423:         # MASTER length; the credits POST-ROLL past the master (the old BUG-410\r\n  424:         # floor-extend) is GONE -- the unified credits roll is now a SILENT tail\r\n  425:         # appended LATE by OTR_CreditsRoll. It used to reproduce this\r\n  426:         # looped-last-clip backdrop by re-reading the clip manifest; since\r\n  427:         # 2026-07-29 (WIRE-W6) it freezes the final frame of the body video\r\n  428:         # THIS function assembles, so the manifest has exactly one reader.\r\n  429:         tail_n = int(target_total_frames) - cursor\r\n  430:         _clip_rows = [r for r in rows if r.get(\"exists\") and r.get(\"path\")]\r\n  431:         if positioned:\r\n  432:             _last_clip = (max(_clip_rows, key=lambda r: float(r.get(\"start_s\") or 0))\r\n  433:                           if _clip_rows else None)\r\n  434:         else:\r\n  435:             _last_clip = _clip_rows[-1] if _clip_rows else None\r\n  436:         if _last_clip is not None:\r\n  437:             emit(\"clip\", _last_clip.get(\"path\"), tail_n, 0,\r\n  438:                  _last_clip.get(\"shot_id\"), _last_clip.get(\"engine_id\"), loop=True,\r\n  439:                  bg_still_path=_last_clip.get(\"bg_still_path\"))\r\n  440:         else:\r\n  441:             emit(gap_src, \"\", tail_n, _floor_aligned(cursor, tail_n))\r\n  442:         cursor = int(target_total_frames)\r\n  443:     return segments, cursor\r\n  444: \r\n  445: \r\n  446: def timeline_quality_report(manifest, segments):\r\n  447:     \"\"\"S-A legibility floor (staged commit 1): a SEPARATE post-plan view that\r\n  448:     asserts each real-clip beat DELIVERS its planned visible span and flags any\r\n  449:     beat that would freeze. PURE -- never overwrites the raw manifest\r\n  450:     ``frame_count`` (which stays engine-produced); it only reads the planned\r\n  451:     segments.\r\n  452: \r\n  453:     In positioned mode, a later beat owns its start boundary, so intentional\r\n  454:     crossfade overlap frames are trimmed from the earlier beat's visible slot.\r\n  455:     ``target_frame_count`` remains the full render request; the added\r\n  456:     ``planned_visible_frame_count`` and ``overlap_trimmed_frame_count`` make the\r\n  457:     distinction explicit. ``delivered_frames_ok`` is True when NO visible slot\r\n  458:     is held on an under-length clip. Sequential manifests retain their strict\r\n  459:     delivered == requested contract.\"\"\"\r\n  460:     clips = {str(r.get(\"shot_id\")): r\r\n  461:              for r in ((manifest or {}).get(\"clips\") or [])\r\n  462:              if r.get(\"shot_id\") and int((r or {}).get(\"target_frame_count\") or 0) > 0}\r\n  463:     positioned = (bool(clips)\r\n  464:                   and int((manifest or {}).get(\"total_target_frames\") or 0) > 0\r\n  465:                   and all(r.get(\"start_s\") is not None for r in clips.values()))\r\n  466:     seg_by_shot = {}\r\n  467:     for s in (segments or []):\r\n  468:         if s.get(\"source\") == \"clip\" and s.get(\"shot_id\"):\r\n  469:             seg_by_shot.setdefault(str(s[\"shot_id\"]), []).append(s)\r\n  470:     beats = []\r\n  471:     ok_all = True\r\n  472:     for sid, r in clips.items():\r\n  473:         tgt = int(r.get(\"target_frame_count\") or 0)\r\n  474:         raw = int(r.get(\"frame_count\") or 0)\r\n  475:         segs = seg_by_shot.get(sid, [])\r\n  476:         delivered = sum(int(s.get(\"n_frames\") or 0) for s in segs)\r\n  477:         planned_visible = delivered\r\n  478:         looped = any(s.get(\"loop\") for s in segs)\r\n  479:         if not segs:\r\n  480:             status = \"no_clip_segment\"\r\n  481:         elif raw > 0 and raw < planned_visible:\r\n  482:             status = \"looped_fill\" if looped else \"held_last_frame\"\r\n  483:         else:\r\n  484:             status = \"ok\"\r\n  485:         beats.append({\r\n  486:             \"shot_id\": sid, \"beat_id\": r.get(\"beat_id\"),\r\n  487:             \"engine_id\": r.get(\"engine_id\"), \"target_frame_count\": tgt,\r\n  488:             \"requested_frame_count\": tgt, \"frame_count\": raw,\r\n  489:             \"rendered_frame_count\": raw,\r\n  490:             \"delivered_frame_count\": delivered,\r\n  491:             \"planned_visible_frame_count\": planned_visible,\r\n  492:             \"overlap_trimmed_frame_count\": (\r\n  493:                 max(0, tgt - planned_visible) if positioned else 0),\r\n  494:             \"looped\": bool(looped), \"quality_status\": status})\r\n  495:         if status == \"held_last_frame\":\r\n  496:             ok_all = False\r\n  497:         elif not positioned and segs and delivered != tgt:\r\n  498:             ok_all = False\r\n  499:     return {\"delivered_frames_ok\": ok_all, \"beats\": beats,\r\n  500:             \"underran\": [b for b in beats\r\n  501:                          if b[\"quality_status\"] in (\"looped_fill\", \"held_last_frame\")]}\r\n  502: \r\n  503: \r\n  504: _FREEZE_RE = None\r\n  505: \r\n  506: \r\n  507: def parse_freezedetect(stderr):\r\n  508:     \"\"\"Parse ffmpeg ``freezedetect`` stderr into a list of frozen spans\r\n  509:     ``[{start, end}]`` (seconds). PURE -- offline-testable. An open\r\n  510:     freeze_start with no freeze_end (frozen through EOF) yields end=None.\"\"\"\r\n  511:     global _FREEZE_RE\r\n  512:     if _FREEZE_RE is None:\r\n  513:         import re\r\n  514:         _FREEZE_RE = re.compile(\r\n  515:             r\"lavfi\\.freezedetect\\.freeze_(start|end)[:=]\\s*([0-9.]+)\")\r\n  516:     spans = []\r\n  517:     cur = None\r\n  518:     for tag, val in _FREEZE_RE.findall(stderr or \"\"):\r\n  519:         v = float(val)\r\n  520:         if tag == \"start\":\r\n  521:             cur = {\"start\": v, \"end\": None}\r\n  522:             spans.append(cur)\r\n  523:         elif tag == \"end\" and cur is not None:\r\n  524:             cur[\"end\"] = v\r\n  525:             cur = None\r\n  526:     return spans\r\n  527: \r\n  528: \r\n  529: def freezedetect_silent(video_path, *, ffmpeg=\"ffmpeg\", noise_db=-60, dur_s=2.0):\r\n  530:     \"\"\"Run ffmpeg ``freezedetect`` over the SILENT video only (never the master)\r\n  531:     and return the parsed frozen spans. Used by the S-A live legibility proof;\r\n  532:     NOT wired into the default assemble path (it adds a full decode pass).\r\n  533:     FAIL-SOFT: returns ``[]`` if ffmpeg is unavailable.\"\"\"\r\n  534:     fb = _ffmpeg_bin(ffmpeg)\r\n  535:     if not fb or not os.path.isfile(video_path):\r\n  536:         return []\r\n  537:     p = _run([fb, \"-hide_banner\", \"-i\", video_path, \"-vf\",\r\n  538:               \"freezedetect=n=%ddB:d=%s\" % (int(noise_db), str(dur_s)),\r\n  539:               \"-map\", \"0:v:0\", \"-f\", \"null\", os.devnull])\r\n  540:     return parse_freezedetect((p.stderr or \"\") + (p.stdout or \"\"))\r\n  541: \r\n  542: \r\n  543: def _seg_vf(w, h, fps, start_frame, sharpen=True):\r\n  544:     \"\"\"The per-segment ``-vf`` chain: an optional source trim, then the SHARED\r\n  545:     scale chain (lanczos+unsharp when ``sharpen``), then the tpad last-frame hold.\r\n  546:     PRESERVES the ``trim -> scale/unsharp/pad/fps -> tpad`` ordering. ``sharpen``\r\n  547:     is True for a real clip (the soft-native fix) and False for the procgen-floor\r\n  548:     slice (byte-identical to the legacy chain).\"\"\"\r\n  549:     trim = (\"trim=start_frame=%d,setpts=PTS-STARTPTS,\" % int(start_frame)) \\\r\n  550:         if int(start_frame) > 0 else \"\"\r\n  551:     return _scale_filter(\r\n  552:         w, h, fps, sharpen=sharpen, pre=trim,\r\n  553:         post=\",tpad=stop_mode=clone:stop_duration=3600\")\r\n  554: \r\n  555: \r\n  556: def _color_args(out_path):\r\n  557:     # TAG bt709 identity (never matrix-convert) + canonical yuv420p H.264.\r\n  558:     return [\"-vsync\", \"cfr\", \"-pix_fmt\", \"yuv420p\",\r\n  559:             \"-color_primaries\", \"bt709\", \"-color_trc\", \"bt709\", \"-colorspace\", \"bt709\",\r\n  560:             \"-c:v\", \"libx264\", \"-crf\", \"18\", \"-preset\", \"fast\", out_path]\r\n  561: \r\n  562: \r\n  563: def _encode_segment(fb, src, n_frames, seg_path, *, w, h, fps, start_frame=0,\r\n  564:                     loop=False, sharpen=True):\r\n  565:     \"\"\"One canonical silent segment of EXACTLY ``n_frames`` from ``src`` (a clip,\r\n  566:     or the floor sliced at ``start_frame``): truncates a long source, holds the\r\n  567:     last frame (tpad clone) for a short one. FAIL CLOSED on ffmpeg error.\r\n  568: \r\n  569:     ``loop=True`` stream-loops the input (-stream_loop -1) so a SHORT source\r\n  570:     REPEATS to fill ``n_frames`` -- the credits-tail backdrop keeps moving\r\n  571:     instead of freezing on the last frame (operator 2026-06-17). The tpad clone\r\n  572:     in _seg_vf stays as a safety but never triggers under an infinite loop.\r\n  573: \r\n  574:     ``sharpen`` is True for a real engine clip (lanczos+unsharp soft-native fix)\r\n  575:     and False for the procgen-floor slice (NOT sharpened -- byte-identical).\"\"\"\r\n  576:     loop_args = [\"-stream_loop\", \"-1\"] if loop else []\r\n  577:     cmd = [fb, \"-y\", \"-loglevel\", \"error\"] + loop_args + [\"-i\", src, \"-an\",\r\n  578:            \"-vf\", _seg_vf(w, h, fps, start_frame, sharpen=sharpen),\r\n  579:            \"-frames:v\", str(int(n_frames))] + _color_args(seg_path)\r\n  580:     p = _run(cmd)\r\n  581:     if p.returncode != 0:\r\n  582:         raise ValueError(\"OTR_SilentComposite: segment encode failed (%s) :: %s\"\r\n  583:                          % (os.path.basename(seg_path), p.stderr.strip()[:200]))\r\n  584: \r\n  585: \r\n  586: def _encode_black(fb, n_frames, seg_path, *, w, h, fps):\r\n  587:     \"\"\"A generated black segment of EXACTLY ``n_frames`` (the ultimate gap-fill\r\n  588:     so an episode with neither a clip nor a floor still assembles).\"\"\"\r\n  589:     cmd = [fb, \"-y\", \"-loglevel\", \"error\",\r\n  590:            \"-f\", \"lavfi\", \"-i\", \"color=c=black:s=%dx%d:r=%d\" % (w, h, fps),\r\n  591:            \"-frames:v\", str(int(n_frames))] + _color_args(seg_path)\r\n  592:     p = _run(cmd)\r\n  593:     if p.returncode != 0:\r\n  594:         raise ValueError(\"OTR_SilentComposite: black segment failed (%s) :: %s\"\r\n  595:                          % (os.path.basename(seg_path), p.stderr.strip()[:200]))\r\n  596: \r\n  597: \r\n  598: # --------------------------------------------------------------------------- #\r\n  599: # Directory-clip read path (3D plan 7.2 -- the character_3d alpha handoff).\r\n  600: # A clip row may point at a DIRECTORY of straight-alpha RGBA frames (PNG/EXR,\r\n  601: # sorted by name) instead of an mp4. The segment encoder lists the frames via\r\n  602: # the shared nodes/_otr_video_engines/directory_clip.py rule, plays them at\r\n  603: # the canonical fps via an ffconcat list (no %06d numbering assumption),\r\n  604: # OVERLAYS them centered on the background (the floor slice when available,\r\n  605: # else black -- the W7 provider-plate composite arrives with the 3D lane),\r\n  606: # and FLATTENS to opaque yuv420p. ffmpeg's overlay expects STRAIGHT\r\n  607: # (non-premultiplied) alpha -- exactly the validated contract. The webm/vp9 /\r\n  608: # mov/prores4444 alpha-VIDEO branches are CUT from v1 [H-RT, GPT].\r\n  609: # --------------------------------------------------------------------------- #\r\n  610: def _is_frame_dir(path) -> bool:\r\n","exit_code":0,"status":"completed"}}
