t)\r\n  578:     return extend_frames_to_target(arr, target)\r\n  579: \r\n  580: \r\n  581: # --------------------------------------------------------------------------- #\r\n  582: # ffmpeg command builders (pure) + runners (the ffmpeg leaf)\r\n  583: # --------------------------------------------------------------------------- #\r\n  584: def _bt709_encode_args(crf):\r\n  585:     \"\"\"The shared silent-clip encode tail: H.264, yuv420p, bt709, NO audio\r\n","exit_code":0,"status":"completed"}}
