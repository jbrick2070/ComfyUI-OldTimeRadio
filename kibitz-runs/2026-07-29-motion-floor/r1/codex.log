{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/render_driver.py' | ForEach-Object { \"'$n++; if($n -ge 3570 -and $n -le 3705) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":" 3570:         from . import frame_contract as _fc  # type: ignore\r\n 3571:     except ImportError:  # pragma: no cover -- flat test imports\r\n 3572:         import coverage_plan as _cp  # type: ignore\r\n 3573:         import frame_contract as _fc  # type: ignore\r\n 3574: \r\n 3575:     # THE TIER CEILING, read ONCE off the ledger the plan rode in on, through\r\n 3576:     # the SAME normalizer ``otr_shot_lock._planning_ceiling`` stamped it with\r\n 3577:     # (B3). ``.get`` with no key present reads as unpinned, which is every\r\n 3578:     # hand-built fixture and both HTTP entry points.\r\n 3579:     ceiling = _fc.normalized_planning_ceiling(\r\n 3580:         ((ledger or {}).get(\"video\") or {}).get(\"max_render_frames\"))\r\n 3581: \r\n 3582:     checked = 0\r\n 3583:     for shot in ((ledger or {}).get(\"video\") or {}).get(\"shots\") or ():\r\n 3584:         if not isinstance(shot, dict):\r\n 3585:             continue\r\n 3586:         raw = shot.get(\"coverage_plan\")\r\n 3587:         if not isinstance(raw, dict) or not raw:\r\n 3588:             continue\r\n 3589:         plan = _cp.CoveragePlan.from_dict(raw)\r\n 3590:         target = int(shot.get(\"target_frame_count\") or 0)\r\n 3591:         if target and int(plan.target_visible_frames) != target:\r\n 3592:             raise RenderError(\r\n 3593:                 \"COVERAGE PLAN: shot %s carries a plan for %d visible frame(s) \"\r\n 3594:                 \"but the beat's target is %d. The plan and the beat disagree, \"\r\n 3595:                 \"so the assembled clip would drift from the beat audio. \"\r\n 3596:                 \"NO FALLBACK.\" % (shot.get(\"shot_id\"),\r\n 3597:                                   plan.target_visible_frames, target))\r\n 3598:         contract = None\r\n 3599:         engine_id = str(shot.get(\"engine_id\") or \"\")\r\n 3600:         if engine_id and _vreg.is_registered(engine_id):\r\n 3601:             try:\r\n 3602:                 contract = _fc.frame_contract_for(_vreg.get_engine(engine_id))\r\n 3603:             except Exception:  # noqa: BLE001 -- arithmetic-only check instead\r\n 3604:                 contract = None\r\n 3605:         # THE EFFECTIVE CONTRACT + ITS RECEIPT (B3), derived OUTSIDE the except\r\n 3606:         # above: that catch means \"this adapter is unbuildable, fall back to an\r\n 3607:         # arithmetic-only check\", and a misconfigured tier ceiling must not be\r\n 3608:         # absorbed into it. ``PlanningCapError`` is a ValueError and is NOT a\r\n 3609:         # ``CoveragePlanError``, so the narrow catch below would let it escape\r\n 3610:         # this boundary unformatted -- wrap it here, named.\r\n 3611:         effective = contract\r\n 3612:         expected = None\r\n 3613:         if contract is not None:\r\n 3614:             try:\r\n 3615:                 effective = _fc.effective_frame_contract(\r\n 3616:                     engine_id, contract, ceiling)\r\n 3617:                 expected = _fc.coverage_contract_receipt(\r\n 3618:                     engine_id, contract, ceiling)\r\n 3619:             except _fc.PlanningCapError as exc:\r\n 3620:                 raise RenderError(\r\n 3621:                     \"COVERAGE PLAN: shot %s cannot be checked against this \"\r\n 3622:                     \"tier's render-length ceiling: %s. NO FALLBACK.\"\r\n 3623:                     % (shot.get(\"shot_id\"), exc)) from exc\r\n 3624:         raw_receipt = shot.get(\"coverage_contract\")\r\n 3625:         if raw_receipt is not None and not (\r\n 3626:                 isinstance(raw_receipt, dict) and raw_receipt):\r\n 3627:             raise RenderError(\r\n 3628:                 \"COVERAGE CONTRACT: shot %s carries a coverage_contract of %r, \"\r\n 3629:                 \"which is not a receipt. An empty or malformed receipt is not \"\r\n 3630:                 \"the same as no receipt -- one means nothing narrowed, the \"\r\n 3631:                 \"other means the ledger is damaged. NO FALLBACK.\"\r\n 3632:                 % (shot.get(\"shot_id\"), raw_receipt))\r\n 3633:         stamped = raw_receipt or None\r\n 3634:         if contract is not None:\r\n 3635:             if stamped != expected:\r\n 3636:                 raise RenderError(\r\n 3637:                     \"COVERAGE CONTRACT: shot %s was planned under %r but this \"\r\n 3638:                     \"ledger re-derives %r for engine %r at ceiling %d. The plan \"\r\n 3639:                     \"was built against a contract that is no longer the one in \"\r\n 3640:                     \"force -- a moved tier ceiling, a re-declared adapter, or \"\r\n 3641:                     \"an engine swapped after the plan was stamped. NO FALLBACK.\"\r\n 3642:                     % (shot.get(\"shot_id\"), stamped, expected,\r\n 3643:                        engine_id or \"?\", ceiling))\r\n 3644:         elif isinstance(stamped, dict):\r\n 3645:             # The adapter will not resolve here, so the full receipt cannot be\r\n 3646:             # re-derived -- but BOTH facts the receipt carries about its own\r\n 3647:             # provenance can still be held to the ledger: the ceiling it was\r\n 3648:             # planned under, and the engine it was planned FOR.\r\n 3649:             #\r\n 3650:             # THE ENGINE HALF WAS MISSING (2026-07-27, post-code panel, two\r\n 3651:             # seats independently, each with a live repro). Comparing only the\r\n 3652:             # ceiling let a stale ltx_8gb receipt ride a shot whose engine had\r\n 3653:             # been swapped to something unregistered: same ceiling, no\r\n 3654:             # contract to re-derive, and the fall-through validated the plan\r\n 3655:             # arithmetic-only -- a plan built for an 8n+1 ladder accepted for\r\n 3656:             # an engine never checked against any length. The registered-engine\r\n 3657:             # branch above compares the whole receipt, engine id included; this\r\n 3658:             # branch has to say the same thing with less information.\r\n 3659:             if str(stamped.get(\"engine_id\") or \"\") != engine_id:\r\n 3660:                 raise RenderError(\r\n 3661:                     \"COVERAGE CONTRACT: shot %s was planned for engine %r but \"\r\n 3662:                     \"now carries %r, whose adapter cannot be resolved here. A \"\r\n 3663:                     \"plan built under one engine's ceiling may not be executed \"\r\n 3664:                     \"by another. NO FALLBACK.\"\r\n 3665:                     % (shot.get(\"shot_id\"), stamped.get(\"engine_id\"),\r\n 3666:                        engine_id or \"?\"))\r\n 3667:             if _fc.normalized_planning_ceiling(\r\n 3668:                     stamped.get(\"max_render_frames\")) != ceiling:\r\n 3669:                 raise RenderError(\r\n 3670:                     \"COVERAGE CONTRACT: shot %s was planned under a \"\r\n 3671:                     \"render-length ceiling of %r but this ledger carries %d, \"\r\n 3672:                     \"and its adapter (%s) cannot be resolved here to re-derive \"\r\n 3673:                     \"the rest. NO FALLBACK.\"\r\n 3674:                     % (shot.get(\"shot_id\"), stamped.get(\"max_render_frames\"),\r\n 3675:                        ceiling, engine_id or \"?\"))\r\n 3676:         try:\r\n 3677:             _cp.validate_coverage_plan(plan, effective)\r\n 3678:         except _cp.CoveragePlanError as exc:\r\n 3679:             raise RenderError(\r\n 3680:                 \"COVERAGE PLAN: shot %s carries a plan its adapter (%s) cannot \"\r\n 3681:                 \"execute: %s. NO FALLBACK.\"\r\n 3682:                 % (shot.get(\"shot_id\"), engine_id or \"?\", exc)) from exc\r\n 3683:         checked += 1\r\n 3684:     if checked:\r\n 3685:         _LOG.debug(\"[OTR.render_driver] COVERAGE PLANS OK: %d shot(s)\", checked)\r\n 3686:     return checked\r\n 3687: \r\n 3688: \r\n 3689: def resolve_final_shot_engines(ledger):\r\n 3690:     \"\"\"THE ROUTE LOCK: resolve every shot's FINAL effective engine, once.\r\n 3691: \r\n 3692:     Both engine mutations in this build run here and nowhere else that matters:\r\n 3693:     the ``OTR_FORCE_ENGINE_MAP`` rewrite (:func:`apply_engine_override`) and\r\n 3694:     the radio-is-host redirect (:func:`_enforce_radio_is_host`). After this\r\n 3695:     returns, ``shot[\"engine_id\"]`` / ``shot[\"family\"]`` are the engine that\r\n 3696:     will actually render the beat.\r\n 3697: \r\n 3698:     WHY THIS EXISTS (2026-07-25, kibitz per-beat-stills r1; codex\r\n 3699:     ``gpt-5.6-sol`` high and agy ``Gemini 3.6 Flash (High)`` found the same\r\n 3700:     ordering defect independently, and the judge's anchor had it too):\r\n 3701:     ``otr_video_render_batch`` validated the still spine BEFORE either\r\n 3702:     mutation had run -- ``apply_engine_override`` fires inside\r\n 3703:     :func:`run_real_episode`, and ``_enforce_radio_is_host`` fires per shot\r\n 3704:     inside :func:`build_request_from_shot`, which is later still. So with a\r\n 3705:     force map set, or on any announcer/music beat whose picked engine is a\r\n","exit_code":0,"status":"completed"}}
