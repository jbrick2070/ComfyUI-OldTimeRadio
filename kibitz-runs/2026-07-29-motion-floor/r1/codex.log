{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'tests/test_multiclip_coverage_plan.py' | ForEach-Object { \"'$n++; if($n -ge 150 -and $n -le 290) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  150:     assert plan.total_visible_frames == 313\r\n  151:     assert plan.segment_count >= 2\r\n  152:     for seg in plan.segments:\r\n  153:         assert LTX8.is_legal_length(seg.render_frames)\r\n  154: \r\n  155: \r\n  156: @pytest.mark.parametrize(\"target\", [170, 200, 500])\r\n  157: def test_an_8n_plus_1_chain_can_only_assemble_to_8m_plus_1(target):\r\n  158:     \"\"\"A REAL ARITHMETIC LIMIT, pinned rather than papered over.\r\n  159: \r\n  160:     Chaining k segments of ``9 + 8a`` and dropping one duplicated head frame\r\n  161:     each assembles to ``8m + 1`` visible frames, always. So a beat whose target\r\n  162:     is not congruent to 1 mod 8 has NO exact cover on this ladder, and the\r\n  163:     partitioner must REFUSE rather than emit a plan that drifts from the beat\r\n  164:     audio. Covering such a beat requires tail trimming -- see the companion\r\n  165:     test below -- which is why ``allow_tail_trim`` is part of the declaration\r\n  166:     and not an assembler-side convenience.\r\n  167:     \"\"\"\r\n  168:     assert target % 8 != 1              # the premise of the case\r\n  169:     with pytest.raises(cp.CoveragePlanError, match=\"no exact multi-clip cover\"):\r\n  170:         cp.partition_beat(target, LTX8)\r\n  171: \r\n  172: \r\n  173: @pytest.mark.parametrize(\"target\", [170, 200, 500])\r\n  174: def test_tail_trim_covers_the_beats_the_bare_ladder_cannot(target):\r\n  175:     trimmable = fc.FrameContract(min_frames=9, max_frames=161, quantum=8,\r\n  176:                                  allow_tail_trim=True,\r\n  177:                                  continuity=fc.CONTINUITY_STRICT_FIRST_FRAME)\r\n  178:     plan = cp.partition_beat(target, trimmable)\r\n  179:     assert plan.total_visible_frames == target\r\n  180:     assert sum(s.trim_tail for s in plan.segments) > 0\r\n  181:     cp.validate_coverage_plan(plan, trimmable)\r\n  182: \r\n  183: \r\n  184: # ---------------------------------------------------------------------------\r\n  185: # Join-mode selection comes from the adapter's own declaration\r\n  186: # ---------------------------------------------------------------------------\r\n  187: \r\n  188: def test_a_beat_that_FITS_never_splits():\r\n  189:     \"\"\"Splitting is for beats that overflow, not a thing that happens to\r\n  190:     everyone now that the opt-in is gone. 17 is on this ladder, so one clip.\"\"\"\r\n  191:     plan = cp.partition_beat(17, fc.FrameContract(min_frames=9, max_frames=161,\r\n  192:                                                   quantum=8))\r\n  193:     assert plan.join_mode == cp.JOIN_SINGLE\r\n  194:     assert plan.segment_count == 1\r\n  195:     assert plan.is_multi_clip is False\r\n  196: \r\n  197: \r\n  198: def test_an_engine_over_its_cap_SPLITS_rather_than_padding():\r\n  199:     \"\"\"It must NOT silently ping-pong, loop-fill or hold a frame -- those are\r\n  200:     exactly the three silent coverage mechanisms this build removes.\r\n  201: \r\n  202:     REWRITTEN chunk 7a (2026-07-26). This was\r\n  203:     ``test_single_only_engine_over_its_cap_is_terminal`` and asserted that a\r\n  204:     beat past the cap RAISED, because an engine had to opt in to multi-clip and\r\n  205:     this one had not. The operator deleted the opt-in -- \"everything gets an\r\n  206:     equal term\" -- so the answer to a beat past the cap is no longer a refusal,\r\n  207:     it is the second clip that multi-clip coverage exists to provide.\r\n  208: \r\n  209:     The invariant the old test was really defending is unchanged and is what is\r\n  210:     asserted here: the beat gets its EXACT frame count out of real rendered\r\n  211:     clips. No padding, no held frame. Only the mechanism changed.\r\n  212:     \"\"\"\r\n  213:     contract = fc.FrameContract(min_frames=9, max_frames=161, quantum=8,\r\n  214:                                 allow_tail_trim=True,\r\n  215:                                 continuity=fc.CONTINUITY_STRICT_FIRST_FRAME)\r\n  216:     plan = cp.partition_beat(400, contract)\r\n  217:     assert plan.segment_count > 1\r\n  218:     assert plan.total_visible_frames == 400\r\n  219:     assert all(contract.is_legal_length(s.render_frames) for s in plan.segments)\r\n  220: \r\n  221: \r\n  222: def test_a_chained_8n1_ladder_needs_the_TAIL_TRIM_to_reach_400():\r\n  223:     \"\"\"Why the test above carries ``allow_tail_trim=True``, written down.\r\n  224: \r\n  225:     The first draft of it omitted the flag and refused, which looked like a bug\r\n  226:     in the partitioner and was not. On an 8n+1 ladder every segment is\r\n  227:     ``9 + 8a``, and under CHAIN covering ``t`` visible frames with ``k``\r\n  228:     segments requires rendering ``t + k - 1``. Setting those equal:\r\n  229:     ``9k + 8S = 399 + k``, i.e. ``8(k + S) = 399`` -- and 399 is not divisible\r\n  230:     by 8, for any segment count. So 400 visible frames has NO exact chained\r\n  231:     cover on this ladder, and the refusal was correct.\r\n  232: \r\n  233:     The tail trim is what makes it coverable: render one step past and drop the\r\n  234:     remainder. Pinning the refusal keeps the fix honest -- the flag is buying a\r\n  235:     real capability, not papering over arithmetic nobody checked.\r\n  236:     \"\"\"\r\n  237:     no_trim = fc.FrameContract(min_frames=9, max_frames=161, quantum=8,\r\n  238:                                allow_tail_trim=False,\r\n  239:                                continuity=fc.CONTINUITY_STRICT_FIRST_FRAME)\r\n  240:     with pytest.raises(cp.CoveragePlanError, match=\"no exact multi-clip cover\"):\r\n  241:         cp.partition_beat(400, no_trim)\r\n  242: \r\n  243: \r\n  244: def test_a_beat_no_amount_of_splitting_can_cover_is_STILL_terminal():\r\n  245:     \"\"\"The refusal did not go away -- it moved to where it is still true.\r\n  246: \r\n  247:     An engine that forbids the tail trim can only cover totals its ladder sums\r\n  248:     to exactly. Give it a ladder whose every entry is odd and ask for an even\r\n  249:     total that no combination reaches, and there is genuinely no honest plan --\r\n  250:     so it raises rather than shipping a clip that drifts from the beat audio.\r\n  251:     That is the property the pre-7a test was reaching for, stated in terms that\r\n  252:     survive the opt-in's removal.\r\n  253:     \"\"\"\r\n  254:     picky = fc.FrameContract(min_frames=9, max_frames=9, quantum=1,\r\n  255:                              allow_tail_trim=False,\r\n  256:                              continuity=fc.CONTINUITY_SOFT_REFERENCE)\r\n  257:     # Only 9 is legal, so reachable totals are 9, 18, 27... 400 is not one.\r\n  258:     with pytest.raises(cp.CoveragePlanError, match=\"no exact multi-clip cover\"):\r\n  259:         cp.partition_beat(400, picky)\r\n  260: \r\n  261: \r\n  262: def test_a_beat_inside_one_render_stays_one_clip():\r\n  263:     plan = cp.partition_beat(161, LTX8)\r\n  264:     assert plan.segment_count == 1\r\n  265: \r\n  266: \r\n  267: def test_soft_reference_engines_jump_cut_rather_than_pretend():\r\n  268:     \"\"\"HuMo's reference is an identity hint and Veo's lastFrame is\r\n  269:     interpolation inside ONE clip -- neither locks frame 0.\"\"\"\r\n  270:     plan = cp.partition_beat(400, JUMPY)\r\n  271:     assert plan.join_mode == cp.JOIN_JUMP\r\n  272:     assert all(s.drop_head == 0 for s in plan.segments)\r\n  273: \r\n  274: \r\n  275: def test_discrete_duration_lane_partitions_over_its_menu():\r\n  276:     plan = cp.partition_beat(400, VEO)\r\n  277:     assert plan.total_visible_frames == 400\r\n  278:     for seg in plan.segments:\r\n  279:         assert seg.render_frames in VEO.discrete_frames\r\n  280:     cp.validate_coverage_plan(plan, VEO)\r\n  281: \r\n  282: \r\n  283: # ---------------------------------------------------------------------------\r\n  284: # Boundary validation -- called on BOTH sides of the wire\r\n  285: # ---------------------------------------------------------------------------\r\n  286: \r\n  287: def test_round_trip_through_the_durable_stamp():\r\n  288:     plan = cp.partition_beat(169, LTX8)\r\n  289:     restored = cp.CoveragePlan.from_dict(plan.to_dict())\r\n  290:     assert restored == plan\r\n","exit_code":0,"status":"completed"}}
