{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/otr_shot_lock.py' | ForEach-Object { \"'$n++; if($n -ge 1100 -and $n -le 1245) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":" 1100:     render side calls, so there is exactly one definition in the tree.\r\n 1101:     \"\"\"\r\n 1102:     try:\r\n 1103:         from ._otr_video_engines import frame_contract as _fc  # type: ignore\r\n 1104:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1105:         from _otr_video_engines import frame_contract as _fc  # type: ignore\r\n 1106:     return _fc.normalized_planning_ceiling(\r\n 1107:         (policy or {}).get(\"max_render_frames\"))\r\n 1108: \r\n 1109: \r\n 1110: def _stamp_coverage_plan(shot, beat_id, *, max_render_frames):\r\n 1111:     \"\"\"Attach this beat's durable ``coverage_plan`` to its shot row (chunk 3b).\r\n 1112: \r\n 1113:     Resolves the shot's engine to its declared :class:`FrameContract` and\r\n 1114:     partitions the beat's ``target_frame_count`` into legal render segments.\r\n 1115:     Validated here, at the plan boundary, so a plan that cannot be executed\r\n 1116:     never reaches the wire.\r\n 1117: \r\n 1118:     ``max_render_frames`` IS REQUIRED, keyword-only, and has no default (B3,\r\n 1119:     2026-07-26). It is the tier's render-length ceiling off the same ``policy``\r\n 1120:     dict the ledger stamp reads, and for the engines in\r\n 1121:     ``frame_contract.PLANNING_CAP_ENGINES`` it NARROWS the contract this beat\r\n 1122:     is partitioned against -- see :func:`frame_contract.effective_frame_contract`\r\n 1123:     for why that allowlist is one engine long and why WAN must stay out of it.\r\n 1124:     A default of 0 was proposed and rejected: it would let a caller that forgot\r\n 1125:     the ceiling plan silently unpinned, which is the exact silent-fallback\r\n 1126:     shape this build exists to remove. There is one caller; it passes the\r\n 1127:     value. When the ceiling narrows anything, the resulting contract is stamped\r\n 1128:     beside the plan as ``shot[\"coverage_contract\"]`` and the render boundary\r\n 1129:     re-derives it and requires exact equality.\r\n 1130: \r\n 1131:     FAIL-CLOSED ON A REAL PARTITION FAILURE, tolerant of an ABSENT one. A\r\n 1132:     :class:`CoveragePlanError` means the adapter genuinely cannot cover this\r\n 1133:     beat -- for a ``single_only`` engine that means the beat exceeds its cap,\r\n 1134:     which today is answered by ping-pong, loop-fill or a held frame, i.e. the\r\n 1135:     three silent mechanisms this build removes. That must surface, so it\r\n 1136:     propagates. An engine that is simply not registered yet (a custom slot, a\r\n 1137:     test stub) gets NO plan rather than a guessed one: the row stays absent and\r\n 1138:     the render path behaves exactly as it did before 3b.\r\n 1139: \r\n 1140:     ALSO MINTS THE JUMP-STILL REQUESTS (2026-07-25, chunk 4). A jump segment is\r\n 1141:     an independent render with nothing to begin from, so every segment after\r\n 1142:     the first owes the image phase its own still. They are minted HERE, where\r\n 1143:     ``beat_id`` is authoritative rather than re-derived, and stamped durably so\r\n 1144:     the image dispatcher and the still spine can READ the ids.\r\n 1145: \r\n 1146:     ONLY FOR A LANE THAT ACTUALLY CONSUMES A STILL (2026-07-25 QA fix). The\r\n 1147:     question is asked with ``render_driver._still_spine_requires_scene`` -- the\r\n 1148:     SAME predicate the spine will use to demand the stills back. That identity\r\n 1149:     is the point. Minting unconditionally created a contradiction with a real\r\n 1150:     failure: for an audio-reactive visualizer beat (no scene object, no\r\n 1151:     required target) the image dispatcher correctly concluded the lane needs no\r\n 1152:     still and skipped, while the spine still demanded every stamped request and\r\n 1153:     raised ``RenderError`` before the first render. Two policies over one state,\r\n 1154:     whichever fires first wins -- the defect shape this build exists to remove.\r\n 1155:     One predicate, asked at the mint, and the disagreement cannot be\r\n 1156:     constructed.\r\n 1157:     \"\"\"\r\n 1158:     target = int(shot.get(\"target_frame_count\") or 0)\r\n 1159:     if target < 1:\r\n 1160:         return                      # a zero-length beat has nothing to cover\r\n 1161:     engine_id = str(shot.get(\"engine_id\") or \"\")\r\n 1162:     if not engine_id:\r\n 1163:         return\r\n 1164:     try:\r\n 1165:         from ._otr_video_engines import registry as _vreg_local  # type: ignore\r\n 1166:         from ._otr_video_engines import frame_contract as _fc  # type: ignore\r\n 1167:         from ._otr_video_engines import coverage_plan as _cp  # type: ignore\r\n 1168:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1169:         from _otr_video_engines import registry as _vreg_local  # type: ignore\r\n 1170:         from _otr_video_engines import frame_contract as _fc  # type: ignore\r\n 1171:         from _otr_video_engines import coverage_plan as _cp  # type: ignore\r\n 1172:     if not _vreg_local.is_registered(engine_id):\r\n 1173:         return\r\n 1174:     try:\r\n 1175:         declared = _fc.frame_contract_for(_vreg_local.get_engine(engine_id))\r\n 1176:     except Exception:  # noqa: BLE001 -- an unbuildable engine gets no plan\r\n 1177:         return\r\n 1178:     # THE TIER CEILING PLANS (B3, 2026-07-26), and this call sits OUTSIDE the\r\n 1179:     # except above ON PURPOSE. It raises PlanningCapError for a ceiling no\r\n 1180:     # legal segment fits under, and that catch means \"unbuildable engine, give\r\n 1181:     # it no plan\" -- absorbing a misconfigured ceiling into it would produce a\r\n 1182:     # beat with NO coverage plan, indistinguishable in the log from an\r\n 1183:     # unregistered engine, which is chunk 1a's swallowed-fail-closed shape.\r\n 1184:     # Three independent reviewers named this line before it was written.\r\n 1185:     #\r\n 1186:     # ``declared`` STAYS BOUND to the static contract. Both derivations below\r\n 1187:     # take the DECLARED one: feeding the already-narrowed contract back into\r\n 1188:     # ``coverage_contract_receipt`` makes it compare equal to itself and return\r\n 1189:     # None, so the receipt would silently never be stamped and the render\r\n 1190:     # boundary would have nothing to check.\r\n 1191:     contract = _fc.effective_frame_contract(engine_id, declared,\r\n 1192:                                             max_render_frames)\r\n 1193:     plan = _cp.partition_beat(target, contract)\r\n 1194:     _cp.validate_coverage_plan(plan, contract)\r\n 1195: \r\n 1196:     # AN AUDIO-DRIVEN LANE CANNOT BE SPLIT YET, AND SAYS SO (2026-07-26,\r\n 1197:     # chunk 7a QA panel). A lane that REQUIRES an audio_ref generates its\r\n 1198:     # frames FROM that audio -- HuMo animates a mouth against speech. Splitting\r\n 1199:     # such a beat into segments needs each segment to receive its own slice of\r\n 1200:     # that speech, and nothing in this build slices it: ``_voice_audio_for_line``\r\n 1201:     # takes a line and returns one path, with no segment index anywhere in its\r\n 1202:     # signature or its callers.\r\n 1203:     #\r\n 1204:     # So a split HuMo beat would hand EVERY segment the whole line from its\r\n 1205:     # start, and the assembled clip would speak the opening syllables three\r\n 1206:     # times over while the audio ran on. That is a sync defect that ships as a\r\n 1207:     # finished episode -- the exact failure class this build exists to remove,\r\n 1208:     # and worse than the refusal because nothing in the log would say so.\r\n 1209:     #\r\n 1210:     # Refusing here is not a new gate; it is the SAME refusal moved earlier and\r\n 1211:     # given a reason. ``humo_14B_169`` already raised ``MirrorExtensionForbidden``\r\n 1212:     # at render time for any beat past its 49-frame cap -- after the GPU work,\r\n 1213:     # with a message about mirroring. This one lands at plan time, names the\r\n 1214:     # beat, and says what is actually missing.\r\n 1215:     if plan.is_multi_clip:\r\n 1216:         try:\r\n 1217:             engine_obj = _vreg_local.get_engine(engine_id)\r\n 1218:         except Exception:  # noqa: BLE001\r\n 1219:             engine_obj = None\r\n 1220:         required = tuple(getattr(engine_obj, \"required_inputs\", ()) or ())\r\n 1221:         if \"audio_ref\" in required:\r\n 1222:             raise _cp.CoveragePlanError(\r\n 1223:                 \"beat %s needs %d clips on %s (%d frames, cap %s), but %s \"\r\n 1224:                 \"renders frames FROM its audio_ref and nothing in this build \"\r\n 1225:                 \"slices that audio per segment -- every segment would receive \"\r\n 1226:                 \"the whole line from its start and the assembled beat would \"\r\n 1227:                 \"repeat the opening syllables. NO FALLBACK: per-segment audio \"\r\n 1228:                 \"is the prerequisite, not a workaround.\"\r\n 1229:                 % (beat_id, plan.segment_count, engine_id, target,\r\n 1230:                    contract.max_frames or \"none\", engine_id))\r\n 1231: \r\n 1232:     shot[\"coverage_plan\"] = plan.to_dict()\r\n 1233:     # THE SIBLING RECEIPT (B3). Present only when the tier ceiling actually\r\n 1234:     # narrowed something, and its ABSENCE is as load-bearing as its content:\r\n 1235:     # ``render_driver.assert_coverage_plans`` re-derives this with the same\r\n 1236:     # function and refuses on any difference, so a ceiling that appeared,\r\n 1237:     # vanished or moved between plan time and render time is terminal rather\r\n 1238:     # than silently re-planned. Stamped BEFORE the still-lane early return --\r\n 1239:     # whether a lane owes stills has nothing to do with what it may render.\r\n 1240:     receipt = _fc.coverage_contract_receipt(engine_id, declared,\r\n 1241:                                             max_render_frames)\r\n 1242:     if receipt is not None:\r\n 1243:         shot[\"coverage_contract\"] = receipt\r\n 1244:     if not _lane_consumes_a_still(shot, engine_id):\r\n 1245:         return\r\n","exit_code":0,"status":"completed"}}
