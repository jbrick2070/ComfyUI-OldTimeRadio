{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/eng_cloud_video.py' | ForEach-Object { \"'$n++; if($n -ge 920 -and $n -le 1030) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"  920:         return clip\r\n  921: \r\n  922: \r\n  923: # word_razzle Phase 1 (2026-07-03): the ANIMATED word-card cloud i2v engine.\r\n  924: # Pixverse is the --audit-i2v Phase-0 pick (promptable, non-V3, required image\r\n  925: # init + prompt + seed + duration_seconds + motion_mode). A word_razzle beat's\r\n  926: # base still (a still_word / word-card still, or any scene still) is fed as the\r\n  927: # init image; the engine adds a LIVING-POSTER world-motion prompt whose whole\r\n  928: # job is to keep the lettering readable EVERY frame (the operator acceptance\r\n  929: # bar). motion_mode / quality / duration_seconds are provider COMBOs (the pin\r\n  930: # excludes option lists) so the adapter ships documented defaults, all\r\n  931: # env-overridable -- the same discipline as the kling mode default. mute_only:\r\n  932: # the provider audio is stripped (must_strip_audio); the master mix is frozen\r\n  933: # upstream and muxed LAST. NO FALLBACK: a missing init still fails LOUD.\r\n  934: _RAZZLE_MOTION_ENV = \"OTR_CLOUD_RAZZLE_MOTION_PROMPT\"\r\n  935: _RAZZLE_MOTION_DEFAULT = (\r\n  936:     \"living period poster, gentle atmospheric motion around the lettering -- \"\r\n  937:     \"drifting mist, soft neon flicker, subtle parallax depth -- the words stay \"\r\n  938:     \"crisp, sharp and fully legible in every frame, letterforms never warp, \"\r\n  939:     \"melt or distort\")\r\n  940: _RAZZLE_NEG_ENV = \"OTR_CLOUD_RAZZLE_NEG\"\r\n  941: _RAZZLE_NEG_DEFAULT = visual_safety_negative(\r\n  942:     \"warped text, melting letters, distorted typography, \"\r\n  943:     \"illegible words, garbled text, flickering letters\")\r\n  944: \r\n  945: \r\n  946: class CloudWordRazzleEngine(_CloudVideoBase):\r\n  947:     \"\"\"word_razzle: animate a word-card still into a living period poster.\"\"\"\r\n  948: \r\n  949:     name = \"word_razzle\"\r\n  950:     #: THE FRAME LADDER (chunk 7a, 2026-07-26). Pixverse serves a fixed\r\n  951:     #: TWO-ENTRY menu, 5 s or 8 s -- `_duration_seconds` ends\r\n  952:     #: `return 8 if secs > 5 else 5`, so a 12-second beat silently\r\n  953:     #: becomes an 8-second clip today. As frames at the 25 fps canvas\r\n  954:     #: rate: 5 s = 125, 8 s = 200.\r\n  955:     frame_contract = FrameContract(\r\n  956:         discrete_frames=(125, 200),\r\n  957:         native_fps=25,\r\n  958:         allow_tail_trim=True,\r\n  959:         continuity=CONTINUITY_SOFT_REFERENCE,\r\n  960:     )\r\n  961:     node_key = \"cloud_pixverse_i2v\"\r\n  962:     family = \"image_to_video\"\r\n  963:     required_inputs = (\"init_image\", \"text_prompt\")\r\n  964:     reactivity = \"mute_only\"\r\n  965:     #: S1 per-model still plan (Shape A base) -- the word-card init still is\r\n  966:     #: minted by an image engine upstream (still_word / any scene still), so\r\n  967:     #: the plan matches the standard scene-spine shape.\r\n  968:     still_plan = _CLOUD_VIDEO_SHAPE_A_BASE_PLAN\r\n  969: \r\n  970:     def _razzle_prompt(self, request) -> str:\r\n  971:         \"\"\"The world-motion + text-preservation prompt. The base motion clause\r\n  972:         (env-overridable) LEADS; the beat's own text_prompt (scene/subject) is\r\n  973:         appended so the animation matches the beat, never overriding the\r\n  974:         readability directive.\"\"\"\r\n  975:         motion = os.environ.get(_RAZZLE_MOTION_ENV, \"\").strip() or _RAZZLE_MOTION_DEFAULT\r\n  976:         beat = str(_req_get(request, \"text_prompt\") or \"\").strip()\r\n  977:         prompt = f\"{motion}. {beat}\".strip().rstrip(\".\") if beat else motion\r\n  978:         return append_visual_safety_clause(prompt)\r\n  979: \r\n  980:     def _duration_seconds(self, request) -> int:\r\n  981:         \"\"\"The provider duration (seconds). Derived from the beat's frame\r\n  982:         target (timing.target_frame_count / fps) and clamped to Pixverse's\r\n  983:         supported 5s / 8s tiers; env OTR_CLOUD_PIXVERSE_DURATION overrides.\"\"\"\r\n  984:         env = os.environ.get(\"OTR_CLOUD_PIXVERSE_DURATION\", \"\").strip()\r\n  985:         if env:\r\n  986:             # THE ENV MAY NOT LEAVE THE MENU (chunk 7b, 2026-07-26). This\r\n  987:             # branch used to `return int(env)` outright, skipping the 5/8 bucket\r\n  988:             # ladder every other path goes through -- so an operator could send\r\n  989:             # Pixverse a 20-second ask that this adapter's own declared\r\n  990:             # ``discrete_frames=(125, 200)`` says is impossible, and the\r\n  991:             # coverage plan had already partitioned the beat over 5s/8s clips.\r\n  992:             # A non-integer was silently swallowed here too, the only duration\r\n  993:             # env in this file that failed quietly rather than loud.\r\n  994:             legal = sorted(\r\n  995:                 int(d) // _RAZZLE_FPS for d in type(self).frame_contract.discrete_frames)\r\n  996:             try:\r\n  997:                 secs = int(env)\r\n  998:             except ValueError as exc:\r\n  999:                 raise _fc.ContractEnvConflict(\r\n 1000:                     \"%s: OTR_CLOUD_PIXVERSE_DURATION=%r is not a whole number \"\r\n 1001:                     \"of seconds. Pixverse serves %s s and nothing between them.\"\r\n 1002:                     % (self.name, env, legal)) from exc\r\n 1003:             if secs not in legal:\r\n 1004:                 raise _fc.ContractEnvConflict(\r\n 1005:                     \"%s: OTR_CLOUD_PIXVERSE_DURATION=%d is not on Pixverse's \"\r\n 1006:                     \"menu %s s, which this adapter declares as \"\r\n 1007:                     \"discrete_frames=%r at %d fps. The beat was already \"\r\n 1008:                     \"partitioned over those lengths. NO FALLBACK.\"\r\n 1009:                     % (self.name, secs, legal,\r\n 1010:                        type(self).frame_contract.discrete_frames, _RAZZLE_FPS))\r\n 1011:             return secs\r\n 1012:         canvas = _req_get(request, \"canvas\") or {}\r\n 1013:         c_get = canvas.get if isinstance(canvas, dict) else (\r\n 1014:             lambda k, d=None: getattr(canvas, k, d))\r\n 1015:         fps = int(c_get(\"fps\", 25) or 25) or 25\r\n 1016:         timing = _req_get(request, \"timing\") or {}\r\n 1017:         t_get = timing.get if isinstance(timing, dict) else (\r\n 1018:             lambda k, d=None: getattr(timing, k, d))\r\n 1019:         n = int(t_get(\"target_frame_count\", 0) or 0)\r\n 1020:         secs = int(round(n / fps)) if n else 5\r\n 1021:         return 8 if secs > 5 else 5\r\n 1022: \r\n 1023:     def _partner_inputs(self, request):\r\n 1024:         return {\r\n 1025:             \"image\": self._init_image_input(request),\r\n 1026:             \"prompt\": self._razzle_prompt(request),\r\n 1027:             \"negative_prompt\": visual_safety_negative(\r\n 1028:                 os.environ.get(_RAZZLE_NEG_ENV, \"\").strip()\r\n 1029:                 or _RAZZLE_NEG_DEFAULT),\r\n 1030:             \"motion_mode\": os.environ.get(\"OTR_CLOUD_PIXVERSE_MOTION\", \"normal\"),\r\n","exit_code":0,"status":"completed"}}
