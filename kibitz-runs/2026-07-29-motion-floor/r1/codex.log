n  394:         cr.extract_final_frame(str(bad), str(tmp_path / \"bd.png\"))\r\n  395: \r\n  396: \r\n  397: # --------------------------------------------------------------------------- #\r\n  398: # PIL renderers (no ffmpeg needed -- PIL/numpy only)\r\n  399: # --------------------------------------------------------------------------- #\r\n  400: def test_static_base_renders_full_frame():\r\n  401:     img = cr.render_static_base(_layout(), 1920, 1080)\r\n  402:     assert img.size == (1920, 1080)\r\n  403: \r\n  404: \r\n  405: def test_scroll_canvas_grows_with_transcript():\r\n  406:     lay = _layout()\r\n  407:     a = cr.render_scroll_canvas(lay[\"col3_flow\"], 600, 1080)\r\n  408:     led = _led()\r\n  409:     led[\"lines\"] = led[\"lines\"] * 12                   # much longer script\r\n  410:     lay2 = cr.build_credits_layout(led, w=1920, h=1080, manifest={\"clips\": [\r\n  411:         {\"shot_id\": \"s0\", \"path\": \"a.mp4\", \"exists\": True}]})\r\n  412:     b = cr.render_scroll_canvas(lay2[\"col3_flow\"], 600, 1080)\r\n  413:     assert b.height > a.height                          # nothing dropped -> taller\r\n  414: \r\n  415: \r\n  416: # --------------------------------------------------------------------------- #\r\n  417: # ffmpeg render + append (silent tail, no source-copy)\r\n  418: # --------------------------------------------------------------------------- #\r\n  419: @needs_ffmpeg\r\n  420: def test_console_clip_renders_silent_and_declares_duration(tmp_path):\r\n  421:     backdrop = _backdrop_png(tmp_path / \"bd.png\")       # a HELD frame now\r\n  422:     out = tmp_path / \"credits.mp4\"\r\n  423:     dur = cr.render_credits_clip(_layout(), str(backdrop), str(out),\r\n  424:                                  w=1280, h=720, fps=25.0)\r\n  425:     assert out.exists() and out.stat().st_size > 0\r\n  426:     assert _count_audio_streams(str(out)) == 0         # silent tail\r\n  427:     assert _count_frames(str(out)) == pytest.approx(d