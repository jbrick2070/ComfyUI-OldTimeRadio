y has >= target frames (or target\r\n  511:     <= 0). A single frame cannot mirror into motion, so it is repeated (the caller\r\n  512:     surfaces that LOUD). ``frames`` is the uint8 ``[N,H,W,C]`` array from\r\n  513:     :func:`images_to_uint8`; numpy is imported lazily (cold-import V-12). Pure;\r\n  514:     CPU-testable.\"\"\"\r\n  515:     import numpy as np\r\n  516:     arr = np.asarray(frames)\r\n  517:     n = int(arr.shape[0]) if arr.ndim else 0\r\n  518:     target = int(target_frame_count or 0)\r\n  519:     if n == 0 or target <= n:\r\n  520:         return arr\r\n  521:     if n < 2:                                   # no motion to mirror -> repeat\r\n  522:         reps = (target + n - 1) // n\r\n  523:         return np.ascontiguousarray(np.concatenate([arr] * reps, axis=0)[:target])\r\n  524:     cycle = np.concatenate([arr, arr[-2:0:-1]], axis=0)   # period 2N-2, seamless\r\n  525:     reps = (target + len(cycle) - 1) // len(cycle)\r\n  526:     tiled = np.concatenate([cycle] * reps, axis=0)\r\n  527:     return np.ascontiguousarray(tiled[:target])\r\n  528: \r\n  529: \r\n  530: class MirrorExtensionForbidden(ValueError):\r\n  531:     \"\"\"A short render on an AUDIO-SYNCED lane cannot be mirror-extended.\r\n  532: \r\n  533:     Raised by :func:`fit_frames_to_target` when ``allow_mirror=False`` and the\r\n  534:     render is shorter than the audio target. Carries the numbers so the caller\r\n  535:     can name the tier and the remedy.\r\n  536:     \"\"\"\r\n  537: \r\n  538:     def __init__(self, rendered, target):\r\n  539:         self.rendered = int(rendered)\r\n  540:         self.target = int(target)\r\n  541:         super().__init__(\r\n  542:             \"audio-synced render is %d frame(s) but the beat's audio needs %d; \"\r\n  543:             \"mirror-extension is FORBIDDEN on a lip-synced lane (it would play \"\r\n  544:             \"the mouth backwards)\" % (self.rendered, self.target))\r\n  545: \r\n  546: \r\n  547: def fit