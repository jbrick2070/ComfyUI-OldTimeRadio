{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$n=0; Get-Content -LiteralPath '\"'nodes/_otr_video_engines/registry.py' | ForEach-Object { \"'$n++; if($n -ge 40 -and $n -le 330) { '\"'{0,5}: {1}' -f \"'$n,$_ } }'","aggregated_output":"   40:     \"get_engine\",\r\n   41:     \"is_registered\",\r\n   42:     \"all_engine_names\",\r\n   43:     \"engines_for_role\",\r\n   44:     \"default_engine_for_role\",\r\n   45:     \"assert_usable\",\r\n   46:     \"descriptor_for_engine\",\r\n   47:     \"audit_engine_roster\",\r\n   48: ]\r\n   49: \r\n   50: \r\n   51: \r\n   52: @runtime_checkable\r\n   53: class VideoEngine(Protocol):\r\n   54:     \"\"\"Contract every video-engine adapter implements.\r\n   55: \r\n   56:     A structural SUPERSET of the shipped ``AudioEngine(Protocol)`` core (see\r\n   57:     :class:`~nodes._otr_shared.engine_registry_base.EngineCore`) -- anchored on\r\n   58:     that proven shape (AS-4), NOT a fresh divergent protocol. The registry only\r\n   59:     reads the CORE members (``name`` / ``roles`` / ``default_roles`` /\r\n   60:     ``commercial_clean`` / ``requires_flag`` / ``load`` / ``unload``); the render\r\n   61:     lifecycle below is the per-clip contract that ``OTR_VideoRenderBatch`` walks\r\n   62:     (built out by the CW-4+ adapters). Adapters duck-type -- inheritance is never\r\n   63:     required.\r\n   64: \r\n   65:     ``family`` is one of: ``audio_driven_face`` | ``lipsync_overlay`` |\r\n   66:     ``image_to_video`` | ``text_to_video`` | ``static_image_gen`` |\r\n   67:     ``static_motion`` | ``abstract`` (the 3D ``character_3d`` family ships with\r\n   68:     Subproject B). ``required_inputs`` declares the request-level inputs the\r\n   69:     engine needs (tokens shared with ``role_compat``: ``text_prompt`` /\r\n   70:     ``init_image`` / ``audio_ref`` / ``base_clip_ref``).\r\n   71: \r\n   72:     Reduced-capability engines may set ``canonicalize = None`` (e.g. an\r\n   73:     image-gen adapter reused via the same pattern in C1): the registry never\r\n   74:     calls render-lifecycle methods, so optional ones may be absent or ``None``.\r\n   75:     \"\"\"\r\n   76: \r\n   77:     # --- registry-facing core (mirrors AudioEngine(Protocol)) ---\r\n   78:     name: str\r\n   79:     roles: tuple\r\n   80:     default_roles: tuple\r\n   81:     commercial_clean: bool\r\n   82:     requires_flag: Optional[str]\r\n   83: \r\n   84:     def load(self) -> None: ...\r\n   85:     def unload(self) -> None: ...\r\n   86: \r\n   87:     # --- video-specific identity ---\r\n   88:     family: str\r\n   89:     required_inputs: tuple\r\n   90:     invocable: bool\r\n   91:     invocability_reason: str\r\n   92: \r\n   93:     # --- multi-clip coverage declaration (2026-07-25, chunk 2; OPTIONAL) ---\r\n   94:     # ``frame_contract`` declares the STATIC legal render lengths and the\r\n   95:     # continuity mode (see :mod:`frame_contract`). It is optional and adapters\r\n   96:     # duck-type as always: an adapter that declares nothing resolves to\r\n   97:     # ``frame_contract.SINGLE_ONLY`` -- one render per beat, no chaining, i.e.\r\n   98:     # exactly today's behaviour. Multi-clip is opt-in and provable PER ENGINE;\r\n   99:     # it is never inherited by default.\r\n  100:     def frame_contract(self): ...\r\n  101: \r\n  102:     # --- render lifecycle (CW-4+ adapters implement; not called by registry) ---\r\n  103:     def assert_usable(self, host_caps, profile, request_template=None): ...\r\n  104:     def prepare(self, host_caps, profile, session_ctx): ...\r\n  105:     def render_clip(self, request, prepared): ...\r\n  106:     def canonicalize(self, raw, request, profile): ...\r\n  107:     def teardown(self, prepared) -> None: ...\r\n  108: \r\n  109: \r\n  110: class VideoEngineRegistry(EngineRegistry):\r\n  111:     \"\"\"The VIDEO registry: eligibility is CAPABILITY, not the legacy `roles` list.\r\n  112: \r\n  113:     C2 (D1 drift fix, 2026-06-30). Production already validates per-role picks by\r\n  114:     CAPABILITY (``role_compat.engine_fits_role``: an engine fits a role iff the role\r\n  115:     can supply every ``required_inputs`` token). The shared base, however, still\r\n  116:     gated ``engines_for_role`` / ``assert_usable`` on the per-engine ``roles``\r\n  117:     whitelist -- so a capability-fit engine (e.g. ltx_video for character_video) was\r\n  118:     rejected by the registry while production accepted it, and the soak filled a\r\n  119:     still instead of the video. These two methods are overridden HERE -- not in\r\n  120:     :class:`EngineRegistry`, which also serves the IMAGE + AUDIO registries -- to\r\n  121:     delegate to ``role_compat``. ``roles`` is now UI-SORT metadata only\r\n  122:     (``default_roles`` still sorts the dropdown).\r\n  123: \r\n  124:     FAIL-SOFT: fall back to the legacy ``roles`` whitelist ONLY when an engine\r\n  125:     declares no ``required_inputs`` (``None`` / missing) OR the role is unknown to\r\n  126:     role_compat -- NEVER for ``required_inputs == ()`` (a valid capability that fits\r\n  127:     EVERY role; e.g. a pure-procedural engine). ``RoleCompatError`` (unknown role) is\r\n  128:     wrapped so the public contract is preserved: ``engines_for_role`` filters it out\r\n  129:     via the legacy path; ``assert_usable`` raises :class:`EngineUnusable`.\r\n  130:     \"\"\"\r\n  131: \r\n  132:     def _descriptor(self, name: str) -> dict:\r\n  133:         \"\"\"The role_compat EngineDescriptor for a REGISTERED engine. ``required_inputs``\r\n  134:         is read straight off the adapter -- ``None`` (missing) is the fail-soft trigger\r\n  135:         and is preserved distinct from ``()`` (declared, fits all roles).\"\"\"\r\n  136:         eng = self._registry[name]\r\n  137:         ri = getattr(eng, \"required_inputs\", None)\r\n  138:         return {\r\n  139:             \"engine_id\": name,\r\n  140:             \"roles\": tuple(getattr(eng, \"roles\", ()) or ()),\r\n  141:             \"required_inputs\": tuple(ri) if ri is not None else None,\r\n  142:         }\r\n  143: \r\n  144:     def _capability_decision(self, name: str, role: str):\r\n  145:         \"\"\"``(decided, fits)``. ``decided is False`` -> the caller must fall back to\r\n  146:         the legacy ``roles`` whitelist (no capability declared, or unknown role).\"\"\"\r\n  147:         desc = self._descriptor(name)\r\n  148:         if desc[\"required_inputs\"] is None:\r\n  149:             return (False, False)                 # no capability declared -> legacy\r\n  150:         try:\r\n  151:             return (True, _role_compat.engine_fits_role(desc, role))\r\n  152:         except _role_compat.RoleCompatError:\r\n  153:             return (False, False)                 # unknown role -> legacy\r\n  154: \r\n  155:     def engines_for_role(self, role: str) -> list:\r\n  156:         \"\"\"Names serving ``role`` BY CAPABILITY (default engine[s] first).\r\n  157: \r\n  158:         Fail-soft: an engine with no declared ``required_inputs``, or any engine when\r\n  159:         ``role`` is unknown to role_compat, is filtered by the legacy ``roles`` list.\r\n  160:         The default-for-role engine still sorts first (``default_roles``).\"\"\"\r\n  161:         names = []\r\n  162:         for name, eng in self._registry.items():\r\n  163:             decided, fits = self._capability_decision(name, role)\r\n  164:             if decided:\r\n  165:                 if fits:\r\n  166:                     names.append(name)\r\n  167:             elif role in tuple(getattr(eng, \"roles\", ()) or ()):\r\n  168:                 names.append(name)                # legacy fail-soft\r\n  169:         names.sort(\r\n  170:             key=lambda n: (\r\n  171:                 role not in tuple(getattr(self._registry[n], \"default_roles\", ()) or ()),\r\n  172:                 n,\r\n  173:             )\r\n  174:         )\r\n  175:         return names\r\n  176: \r\n  177:     def assert_usable(self, name: str, role: str) -> str:\r\n  178:         \"\"\"Validate ``name`` may run for ``role`` BY CAPABILITY; FAIL CLOSED.\r\n  179: \r\n  180:         ``MALFORMED_CONFIG`` -- not registered. ``INCOMPATIBLE_PROFILE`` -- the role\r\n  181:         cannot supply the engine's ``required_inputs`` (capability), or (fail-soft,\r\n  182:         for an engine with no declared inputs / an unknown role) the legacy ``roles``\r\n  183:         list does not list ``role``. Never silently resolves to another engine.\"\"\"\r\n  184:         if not self.is_registered(name):\r\n  185:             raise EngineUnusable(\r\n  186:                 name, role, EngineUsabilityReason.MALFORMED_CONFIG,\r\n  187:                 f\"no {self.kind} engine named '{name}' is registered\",\r\n  188:                 kind=self.kind,\r\n  189:             )\r\n  190:         decided, fits = self._capability_decision(name, role)\r\n  191:         if decided:\r\n  192:             if not fits:\r\n  193:                 desc = self._descriptor(name)\r\n  194:                 raise EngineUnusable(\r\n  195:                     name, role, EngineUsabilityReason.INCOMPATIBLE_PROFILE,\r\n  196:                     f\"engine '{name}' requires inputs {tuple(desc['required_inputs'])} \"\r\n  197:                     f\"which role '{role}' does not supply\",\r\n  198:                     kind=self.kind,\r\n  199:                 )\r\n  200:             return name\r\n  201:         # Fail-soft: no capability declared (or unknown role) -> legacy `roles` gate.\r\n  202:         eng = self._registry[name]\r\n  203:         if role not in tuple(getattr(eng, \"roles\", ()) or ()):\r\n  204:             raise EngineUnusable(\r\n  205:                 name, role, EngineUsabilityReason.INCOMPATIBLE_PROFILE,\r\n  206:                 f\"engine '{name}' serves roles \"\r\n  207:                 f\"{tuple(getattr(eng, 'roles', ()))}, not '{role}'\",\r\n  208:                 kind=self.kind,\r\n  209:             )\r\n  210:         return name\r\n  211: \r\n  212: \r\n  213: # One registry instance for the video namespace (its own dict; no audio\r\n  214: # cross-pollution). Module-level functions bind to it so the public API matches\r\n  215: # the shipped audio registry's function surface 1:1 (AS-4 \"one pattern\").\r\n  216: _VIDEO_REGISTRY = VideoEngineRegistry(\"video\")\r\n  217: \r\n  218: register = _VIDEO_REGISTRY.register\r\n  219: get_engine = _VIDEO_REGISTRY.get_engine\r\n  220: is_registered = _VIDEO_REGISTRY.is_registered\r\n  221: all_engine_names = _VIDEO_REGISTRY.all_engine_names\r\n  222: engines_for_role = _VIDEO_REGISTRY.engines_for_role\r\n  223: default_engine_for_role = _VIDEO_REGISTRY.default_engine_for_role\r\n  224: assert_usable = _VIDEO_REGISTRY.assert_usable\r\n  225: \r\n  226: \r\n  227: def descriptor_for_engine(name: str) -> dict:\r\n  228:     \"\"\"The role_compat EngineDescriptor (``engine_id`` / ``roles`` /\r\n  229:     ``required_inputs``) for a registered video engine. The SHARED builder the C2\r\n  230:     registry override + the C4 capability matrix test both read, so the eligibility\r\n  231:     rule has ONE source. Raises ``KeyError`` for an unregistered name.\"\"\"\r\n  232:     return _VIDEO_REGISTRY._descriptor(name)\r\n  233: \r\n  234: # Re-export the protocol core under the video namespace for adapters that prefer\r\n  235: # an explicit base reference (duck-typing still works without it).\r\n  236: __all__.append(\"EngineCore\")\r\n  237: \r\n  238: \r\n  239: # ---------------------------------------------------------------------------\r\n  240: # GATE B S1 -- per-engine capability DECLARATIONS (the registry TABLE, not the\r\n  241: # adapters). Consumed by nodes/_otr_shared/capability_profiles.py to DERIVE the\r\n  242: # per-profile enable-set -- never hand-listed per profile. A new engine ships\r\n  243: # its own row here; zero profile edits.\r\n  244: #\r\n  245: # Keys per row (validated by capability_profiles.validate_declaration):\r\n  246: #   required_toolchain     None, or \"cu128_toolkit\" (source builds; operator-\r\n  247: #                          blocked per the 3D plan -- keeps hunyuan/trellis dark).\r\n  248: #   requires_sidecar       True when the engine runs in an isolated sidecar venv.\r\n  249: #   device_backends        backends the engine can run on, e.g. [\"cuda\", \"cpu\",\r\n  250: #                          \"mps\"]; GPU-only rows list just [\"cuda\"].\r\n  251: #   requires_vendor        None, or \"nvidia\" when the adapter hard-gates on a\r\n  252: #                          vendor-only API (e.g. an NVML VRAM-telemetry probe).\r\n  253: #   needs_fp8_te           True when the engine's default weights are an\r\n  254: #                          fp8-scaled UNET/text-encoder artifact.\r\n  255: #   needs_fp4_te           True when the engine's default weights are an\r\n  256: #                          fp4-scaled UNET/text-encoder artifact.\r\n  257: #   practical_without_gpu  True when the engine can run with no GPU at all\r\n  258: #                          (procgen/CPU lanes; the cpu_floor tier filter).\r\n  259: #   sidecar_conditional    True when requires_sidecar depends on runtime\r\n  260: #                          config rather than being a fixed True/False.\r\n  261: #   model_requirements     informational model-asset ids for the S5 wizard.\r\n  262: # ---------------------------------------------------------------------------\r\n  263: CAPABILITIES = {\r\n  264:     # \"abstract\" + \"station_card\" rows REMOVED 2026-06-30 (C0 -- \"registry IS the\r\n  265:     # menu\"): both engines were UNREGISTERED (abstract redundant with visualizer;\r\n  266:     # station_card the broken black card), and the registry-consistency invariant\r\n  267:     # forbids a CAPABILITIES row without a registered engine.\r\n  268:     \"still_motion\": {\r\n  269:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  270:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  271:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  272:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  273:         \"model_requirements\": []},\r\n  274:     # viz_green (renamed from \"visualizer\" 2026-06-30, item 2; old saved values\r\n  275:     # resolve via otr_video_director._LEGACY_ENGINE_ALIASES).\r\n  276:     \"viz_green\": {\r\n  277:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  278:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  279:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  280:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  281:         \"model_requirements\": []},\r\n  282:     # viz_mxc_cpu (2026-06-30): the OTR rainbow visualizer -- pure numpy/PIL/ffmpeg,\r\n  283:     # no GPU/shaders. required_toolchain None (a GL/torch toolchain would disable it on\r\n  284:     # every shipped profile). GPU shader tier (viz_mxc_gpu) is a deferred separate row.\r\n  285:     \"viz_mxc_cpu\": {\r\n  286:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  287:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  288:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  289:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  290:         \"model_requirements\": []},\r\n  291:     # viz_mxc_mandala (2026-06-30): Cosmic Radio Mandala -- pycairo vector CPU\r\n  292:     # painter, no GPU/shaders. required_toolchain None: pycairo is NOT in\r\n  293:     # the main requirements (lazy-imported + probed by assert_usable so a box\r\n  294:     # without system libcairo never breaks any OTHER engine's install).\r\n  295:     \"viz_mxc_mandala\": {\r\n  296:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  297:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  298:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  299:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  300:         \"model_requirements\": []},\r\n  301:     # viz_camera (2026-07-05): OTR-native Golden Flicker camera visualizer --\r\n  302:     # pure numpy/PIL/ffmpeg, audio-optional, no external golden-flicker import.\r\n  303:     \"viz_camera\": {\r\n  304:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  305:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  306:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  307:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  308:         \"model_requirements\": []},\r\n  309:     \"still_flat\": {\r\n  310:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  311:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  312:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  313:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  314:         \"model_requirements\": []},\r\n  315:     \"still_pan\": {\r\n  316:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  317:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  318:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  319:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  320:         \"model_requirements\": []},\r\n  321:     # still_word (Sprint B, 2026-07-03): a still_flat sibling -- same CPU/ffmpeg\r\n  322:     # flat-hold render (zero VRAM), the delta is the WORD/TITLE-driven prompt its\r\n  323:     # base still is minted from (compose_still_word_prompt). Model-agnostic: any\r\n  324:     # image engine mints the still. cpu class, cpu_ok True, no model assets.\r\n  325:     \"still_word\": {\r\n  326:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  327:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  328:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  329:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  330:         \"model_requirements\": []},\r\n","exit_code":0,"status":"completed"}}
