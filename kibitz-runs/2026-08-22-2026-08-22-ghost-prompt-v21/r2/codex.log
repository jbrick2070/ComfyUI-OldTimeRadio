imports\r\n  632:             from _otr_visual_styles import effective_negative  # type: ignore\r\n  633:         pack_negative = str(effective_negative(style) or \"\")\r\n  634: \r\n  635:     head = \", \".join(parts)\r\n  636:     for chunk in pack_negative.split(\",\"):\r\n  637:         phrase = chunk.strip()\r\n  638:         if not phrase or phrase.lower() in seen:\r\n  639:             continue\r\n  640:         candidate = \"%s, %s\" % (head, phrase)\r\n  641:         if len(candidate) > GHOST_NEGATIVE_MAX_CHARS:\r\n  642:             break\r\n  643:         head = candidate\r\n  644:         seen.add(phrase.lower())\r\n  645:     return head\r\n  646: \r\n  647: \r\n  648: # --------------------------------------------------------------------------- #\r\n  649: # The composer.\r\n  650: # --------------------------------------------------------------------------- #\r\n  651: \r\n  652: #: Slots the trimmer may drop, in the order it drops them. The subject sigil,\r\n  653: #: the authored motion clause, the mid-shot floor and the shot law are ABSENT\r\n  654: #: from this tuple on purpose: they are the four things the lane exists to\r\n  655: #: guarantee, so if they alone exceed the ceiling that is a composer defect to\r\n  656: #: fail on, not a prompt to quietly truncate.\r\n  657: GHOST_TRIM_ORDER = (\"story_accent\", \"emotion\", \"framing\")\r\n  658: \r\n  659: \r\n  660: class GhostPromptError(ValueError):\r\n 1840:                       temperature=_gsa.GHOST_BATCH_TEMPERATURE,\r\n 1841:                       max_new_tokens=budget)\r\n 1842:             leaves = _gsa.parse_batch_response(raw, ids)\r\n 1843:             _ghost_validate_batch(leaves, specs, style, meta, names)\r\n 1844:             if attempt > 1:\r\n 1845:                 log.warning(\"[OTR_ShotLock] Ghost author: batch accepted on \"\r\n 1846:                             \"the retry\")\r\n 1847:             return leaves, \"writer_llm\", \"\"\r\n 1848:         except _gsa.GhostAuth