{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'function Show-Lines($Path,$Start,$End){$i=0; Get-Content -LiteralPath $Path | ForEach-Object {$i++; if($i -ge $Start -and $i -le $End){'\"'{0,5}: {1}' -f \"'$i,$_}}}; Show-Lines '\"'nodes\\\\_otr_video_engines\\\\ghost_signal_author.py' 400 685; Show-Lines 'nodes\\\\_otr_video_engines\\\\ghost_signal_author.py' 686 988\"","aggregated_output":"  400: def map_arc(arc_phase) -> str:\r\n  401:     \"\"\"A mapped arc cue, or ``\"\"`` when the value carries no visual meaning.\"\"\"\r\n  402:     return GHOST_ARC_CUES.get(_norm(arc_phase).lower(), \"\")\r\n  403: \r\n  404: \r\n  405: # --------------------------------------------------------------------------- #\r\n  406: # Deterministic mode scheduling.\r\n  407: # --------------------------------------------------------------------------- #\r\n  408: \r\n  409: def _hash_int(*parts) -> int:\r\n  410:     payload = \"|\".join(str(p) for p in parts)\r\n  411:     return int(hashlib.sha256(payload.encode(\"utf-8\")).hexdigest()[:16], 16)\r\n  412: \r\n  413: \r\n  414: def schedule_ghost_modes(entries, episode_seed) -> dict:\r\n  415:     \"\"\"``{beat_id: mode}`` for one episode's whole Ghost timeline.\r\n  416: \r\n  417:     ``entries`` is the ORDERED list of ``(beat_id, role)`` pairs -- ordered\r\n  418:     because the anti-run rule is a property of the timeline, not of a beat.\r\n  419: \r\n  420:     CHARACTER BEATS RUN :data:`GHOST_CHARACTER_CYCLE` from a hashed offset --\r\n  421:     ``figure, object, figure, signal``, so half of them show a person and no two\r\n  422:     adjacent entries are equal, which means a character can never start a run\r\n  423:     and never needs correcting.\r\n  424: \r\n  425:     BOOKENDS alternate ``object``/``signal`` from their own hashed offset. Only\r\n  426:     a bookend may be corrected, and only when it would create a THIRD identical\r\n  427:     mode in a row -- which keeps clip planning stable and keeps the correction\r\n  428:     away from the assignments the recurrence design depends on.\r\n  429:     \"\"\"\r\n  430:     seed = _hash_int(episode_seed, \"ghost_mode_schedule\", GHOST_AUTHOR_VERSION)\r\n  431:     char_offset = seed % len(GHOST_CHARACTER_CYCLE)\r\n  432:     bookend_offset = (seed >> 8) % len(GHOST_NON_FIGURE_MODES)\r\n  433: \r\n  434:     out = {}\r\n  435:     scheduled = []\r\n  436:     char_n = 0\r\n  437:     bookend_n = 0\r\n  438:     for beat_id, role in entries:\r\n  439:         beat_id = str(beat_id)\r\n  440:         if normalize_role(role) == \"character_video\":\r\n  441:             mode = GHOST_CHARACTER_CYCLE[\r\n  442:                 (char_offset + char_n) % len(GHOST_CHARACTER_CYCLE)]\r\n  443:             char_n += 1\r\n  444:             fixed = True\r\n  445:         else:\r\n  446:             mode = GHOST_NON_FIGURE_MODES[\r\n  447:                 (bookend_offset + bookend_n) % len(GHOST_NON_FIGURE_MODES)]\r\n  448:             bookend_n += 1\r\n  449:             fixed = False\r\n  450:         if (not fixed and len(scheduled) >= 2\r\n  451:                 and scheduled[-1] == mode and scheduled[-2] == mode):\r\n  452:             # The other non-figure representation, deterministically.\r\n  453:             mode = GHOST_NON_FIGURE_MODES[\r\n  454:                 (GHOST_NON_FIGURE_MODES.index(mode) + 1)\r\n  455:                 % len(GHOST_NON_FIGURE_MODES)]\r\n  456:         scheduled.append(mode)\r\n  457:         out[beat_id] = mode\r\n  458:     return out\r\n  459: \r\n  460: \r\n  461: # --------------------------------------------------------------------------- #\r\n  462: # The recurrence motif -- a compact, allowlisted, NON-FACE identity.\r\n  463: # --------------------------------------------------------------------------- #\r\n  464: \r\n  465: #: Colour tokens, split out of the composer's costume bucket. Colour is the one\r\n  466: #: property that survives 512x288 across a sliding context, so it anchors all\r\n  467: #: three representations of one character.\r\n  468: MOTIF_COLOUR_WORDS = (\r\n  469:     \"black\", \"white\", \"red\", \"green\", \"blue\", \"brown\", \"grey\", \"gray\",\r\n  470:     \"crimson\", \"scarlet\", \"navy\", \"olive\", \"amber\", \"gold\", \"golden\",\r\n  471:     \"silver\", \"rust\", \"ochre\", \"violet\", \"purple\", \"cream\", \"tan\", \"charcoal\",\r\n  472: )\r\n  473: \r\n  474: #: Garment tokens. ``figure`` carries one so the person on screen is wearing\r\n  475: #: something a sampler can draw; the non-figure modes have no use for a coat.\r\n  476: MOTIF_GARMENT_WORDS = (\r\n  477:     \"coat\", \"overcoat\", \"trenchcoat\", \"greatcoat\", \"jacket\", \"uniform\",\r\n  478:     \"cloak\", \"cape\", \"gown\", \"dress\", \"suit\", \"waistcoat\", \"vest\", \"apron\",\r\n  479:     \"shawl\", \"robe\", \"hat\", \"fedora\", \"cap\", \"helmet\", \"hood\", \"scarf\",\r\n  480: )\r\n  481: \r\n  482: #: Silhouette tokens. ``figure`` alone carries one.\r\n  483: MOTIF_SILHOUETTE_WORDS = (\r\n  484:     \"tall\", \"short\", \"broad\", \"slight\", \"stooped\", \"lean\", \"heavyset\",\r\n  485:     \"wiry\", \"angular\", \"round\", \"towering\", \"compact\", \"gaunt\", \"stocky\",\r\n  486:     \"willowy\", \"slender\", \"squat\", \"burly\", \"spare\", \"rangy\", \"narrow\",\r\n  487: )\r\n  488: \r\n  489: #: Prop tokens, carried by all three representations of one character.\r\n  490: MOTIF_PROP_WORDS = (\r\n  491:     \"lantern\", \"lamp\", \"torch\", \"candle\", \"revolver\", \"pistol\", \"rifle\",\r\n  492:     \"knife\", \"blade\", \"sword\", \"dagger\", \"book\", \"ledger\", \"journal\",\r\n  493:     \"letter\", \"map\", \"chart\", \"cane\", \"staff\", \"umbrella\", \"satchel\",\r\n  494:     \"case\", \"briefcase\", \"pipe\", \"flask\", \"bottle\", \"glass\", \"cup\", \"key\",\r\n  495:     \"rope\", \"chain\", \"hammer\", \"wrench\", \"microphone\", \"headset\",\r\n  496:     \"telegraph\", \"camera\", \"watch\", \"spyglass\", \"telescope\", \"basket\",\r\n  497:     \"crate\", \"lockbox\",\r\n  498: )\r\n  499: \r\n  500: #: Deterministic fills, used when a cast row supplied no allowlisted token of\r\n  501: #: that kind. Checked in, never generated, never asked of a model.\r\n  502: MOTIF_FALLBACK_POOLS = {\r\n  503:     \"colour\": (\"amber\", \"rust\", \"olive\", \"charcoal\", \"cream\", \"navy\"),\r\n  504:     \"garment\": (\"coat\", \"uniform\", \"shawl\", \"jacket\", \"hood\", \"scarf\"),\r\n  505:     \"silhouette\": (\"lean\", \"broad\", \"slight\", \"tall\", \"compact\", \"angular\"),\r\n  506:     \"prop\": (\"lantern\", \"key\", \"ledger\", \"satchel\", \"chart\", \"telegraph\"),\r\n  507: }\r\n  508: \r\n  509: #: Bookend motifs, by ``(role, mode)``. Real radio HARDWARE that recurs while\r\n  510: #: the unchanged pack cue keeps supplying the anime / archive / material look.\r\n  511: #: A Ghost bookend with an empty motif is invalid, which is why these are\r\n  512: #: constants rather than an optional derivation.\r\n  513: #:\r\n  514: #: They used to read \"radio dial emblem\" and \"broadcast waveform signal\". An\r\n  515: #: emblem is not a thing and a waveform is a graph, and the bookends rendered as\r\n  516: #: texture accordingly. A bakelite radio set is a thing.\r\n  517: GHOST_BOOKEND_MOTIFS = {\r\n  518:     (\"announcer_visual\", \"object\"): \"a bakelite radio set\",\r\n  519:     (\"announcer_visual\", \"signal\"): \"a glowing radio dial\",\r\n  520:     (\"music_visual\", \"object\"): \"a broadcast console\",\r\n  521:     (\"music_visual\", \"signal\"): \"a spinning turntable\",\r\n  522: }\r\n  523: \r\n  524: \r\n  525: def _first_allowlisted(phrases, vocabulary) -> str:\r\n  526:     \"\"\"The first allowlisted WORD found across ``phrases``, in source order.\r\n  527: \r\n  528:     A WORD, never the phrase it came from: copying the phrase is how a cast\r\n  529:     row's prose -- and its landmarks, its hair, its jaw -- would get back into\r\n  530:     a prompt that is supposed to have left all of that behind.\r\n  531:     \"\"\"\r\n  532:     allowed = tuple(vocabulary)\r\n  533:     for phrase in phrases:\r\n  534:         words = _WORD_RE.findall(str(phrase or \"\").lower())\r\n  535:         for candidate in allowed:\r\n  536:             if candidate in words:\r\n  537:                 return candidate\r\n  538:     return \"\"\r\n  539: \r\n  540: \r\n  541: def _motif_tokens(components, seed_int) -> dict:\r\n  542:     \"\"\"The four allowlisted motif tokens for one character.\r\n  543: \r\n  544:     ``components`` is ``ghost_signal_prompt.distill_sigil_components``'s bucket\r\n  545:     map. The LANDMARK bucket is deliberately not read: an asymmetrical facial\r\n  546:     landmark is exactly the face-adjacent recurrence Prompt v2 replaces.\r\n  547:     \"\"\"\r\n  548:     components = components if isinstance(components, dict) else {}\r\n  549:     costume = components.get(\"costume\") or \"\"\r\n  550:     prop = components.get(\"prop\") or \"\"\r\n  551:     silhouette = components.get(\"silhouette\") or \"\"\r\n  552: \r\n  553:     # COLOUR AND GARMENT ARE SCANNED ACROSS BOTH NON-FACE BUCKETS, in costume-\r\n  554:     # first order. The sigil's buckets are GREEDY -- one phrase is consumed by\r\n  555:     # the first bucket that matches it -- so a cast row reading \"a broad steady\r\n  556:     # man in a charcoal overcoat\" lands whole in the SILHOUETTE bucket and the\r\n  557:     # costume bucket then falls to its neutral pool. Reading only the costume\r\n  558:     # bucket would have thrown away the character's real colour and worn a\r\n  559:     # pooled one instead, which is the opposite of a recurrence cue.\r\n  560:     #\r\n  561:     # The LANDMARK bucket is never scanned. That is where the jaw, the brow,\r\n  562:     # the scar and the hair live, and face-adjacent recurrence is exactly what\r\n  563:     # Prompt v2 exists to replace.\r\n  564:     out = {}\r\n  565:     out[\"colour\"] = _first_allowlisted((costume, silhouette),\r\n  566:                                        MOTIF_COLOUR_WORDS)\r\n  567:     out[\"garment\"] = _first_allowlisted((costume, silhouette),\r\n  568:                                         MOTIF_GARMENT_WORDS)\r\n  569:     out[\"silhouette\"] = _first_allowlisted((silhouette,),\r\n  570:                                            MOTIF_SILHOUETTE_WORDS)\r\n  571:     out[\"prop\"] = _first_allowlisted((prop,), MOTIF_PROP_WORDS)\r\n  572:     for kind, pool in MOTIF_FALLBACK_POOLS.items():\r\n  573:         if not out.get(kind):\r\n  574:             out[kind] = pool[_hash_int(seed_int, \"motif\", kind) % len(pool)]\r\n  575:     return out\r\n  576: \r\n  577: \r\n  578: def motif_for_character(components, mode, *, seed_int=0) -> str:\r\n  579:     \"\"\"The compact recurrence motif for one character in one representation.\r\n  580: \r\n  581:     All three representations share COLOUR + PROP, which is what makes the\r\n  582:     episode read as related; ``figure`` additionally carries the silhouette,\r\n  583:     which is the only body property this model holds across a sliding context.\r\n  584:     \"\"\"\r\n  585:     mode = str(mode or \"\")\r\n  586:     tokens = _motif_tokens(components, seed_int)\r\n  587:     # \"an olive key\", not \"a olive key\". The motif is prompt text a person reads\r\n  588:     # in a receipt and a sampler reads as language; a broken article is a small\r\n  589:     # thing that makes both of them worse.\r\n  590:     article = \"an\" if tokens[\"colour\"][:1] in \"aeiou\" else \"a\"\r\n  591:     if mode == \"figure\":\r\n  592:         # A PERSON, SAID PLAINLY. The first draft said \"<silhouette> silhouette\r\n  593:         # with a <colour> <prop>\", and SD1.5 drew vertical black shapes -- it\r\n  594:         # does not know that a \"silhouette\" is supposed to be someone. v1 said\r\n  595:         # \"a man, a broad steady figure, a charcoal coat, holding a folded\r\n  596:         # chart\" and got a man in a coat. This is that, minus the name leak.\r\n  597:         return \"a %s figure in %s %s %s, carrying %s %s\" % (\r\n  598:             tokens[\"silhouette\"], article, tokens[\"colour\"], tokens[\"garment\"],\r\n  599:             \"an\" if tokens[\"prop\"][:1] in \"aeiou\" else \"a\", tokens[\"prop\"])\r\n  600:     if mode in (\"object\", \"signal\"):\r\n  601:         # THE PROP AS ITSELF. \"charcoal lantern emblem\" is not a thing; a\r\n  602:         # charcoal lantern is. The two beats that survived the first draft are\r\n  603:         # the two whose leaf named a real object, which is the whole finding.\r\n  604:         return \"%s %s %s\" % (article, tokens[\"colour\"], tokens[\"prop\"])\r\n  605:     raise GhostAuthorError(\"unknown Ghost representation mode %r\" % (mode,))\r\n  606: \r\n  607: \r\n  608: def motif_for_bookend(role, mode) -> str:\r\n  609:     \"\"\"The checked-in bookend motif. Missing pair is a constant defect.\"\"\"\r\n  610:     key = (normalize_role(role), str(mode or \"\"))\r\n  611:     motif = GHOST_BOOKEND_MOTIFS.get(key)\r\n  612:     if not motif:\r\n  613:         raise GhostAuthorError(\r\n  614:             \"no Ghost bookend motif for role/mode %r -- an empty bookend \"\r\n  615:             \"motif is invalid, so this is a composer constant defect rather \"\r\n  616:             \"than a beat to fall back on\" % (key,))\r\n  617:     return motif\r\n  618: \r\n  619: \r\n  620: # --------------------------------------------------------------------------- #\r\n  621: # Specs -- what ShotLock projects and what the model actually receives.\r\n  622: # --------------------------------------------------------------------------- #\r\n  623: \r\n  624: def opaque_id(ordinal) -> str:\r\n  625:     \"\"\"``g000``, ``g001``, ... -- the model never sees a ledger identifier.\"\"\"\r\n  626:     return \"g%03d\" % int(ordinal)\r\n  627: \r\n  628: \r\n  629: def build_ghost_author_specs(rows, *, model_id) -> list:\r\n  630:     \"\"\"Project ShotLock rows into the ordered, safe author specs.\r\n  631: \r\n  632:     Each ``row`` is a dict with ``beat_id``, ``role``, ``mode``, ``motif_cue``,\r\n  633:     ``sanitized_intent``, ``normalized_emotion`` and ``mapped_arc`` -- all of\r\n  634:     them already safe. This function adds the opaque id, the ordinal and the\r\n  635:     request hash, and refuses anything shaped wrong.\r\n  636:     \"\"\"\r\n  637:     specs = []\r\n  638:     for ordinal, row in enumerate(rows or ()):\r\n  639:         role = normalize_role((row or {}).get(\"role\"))\r\n  640:         if not role:\r\n  641:             raise GhostAuthorError(\r\n  642:                 \"Ghost author row %d has role %r, which this lane does not \"\r\n  643:                 \"author\" % (ordinal, (row or {}).get(\"role\")))\r\n  644:         mode = str((row or {}).get(\"mode\") or \"\")\r\n  645:         if mode not in GHOST_MODES:\r\n  646:             raise GhostAuthorError(\r\n  647:                 \"Ghost author row %d has mode %r; expected one of %s\"\r\n  648:                 % (ordinal, mode, \", \".join(GHOST_MODES)))\r\n  649:         if role != \"character_video\" and mode == \"figure\":\r\n  650:             raise GhostAuthorError(\r\n  651:                 \"Ghost author row %d is a %s bookend scheduled as figure -- a \"\r\n  652:                 \"radio console is not a person\" % (ordinal, role))\r\n  653:         motif_cue = _norm(row.get(\"motif_cue\"))\r\n  654:         if not motif_cue:\r\n  655:             raise GhostAuthorError(\r\n  656:                 \"Ghost author row %d has an empty motif_cue; the recurrence \"\r\n  657:                 \"cue is the identity mechanism and may not be absent\"\r\n  658:                 % (ordinal,))\r\n  659:         beat_id = _norm(row.get(\"beat_id\"))\r\n  660:         if not beat_id:\r\n  661:             raise GhostAuthorError(\r\n  662:                 \"Ghost author row %d has no beat_id\" % (ordinal,))\r\n  663:         spec = {\r\n  664:             \"author_version\": GHOST_AUTHOR_VERSION,\r\n  665:             \"beat_id\": beat_id,\r\n  666:             \"mapped_arc\": _norm(row.get(\"mapped_arc\")),\r\n  667:             \"mode\": mode,\r\n  668:             \"model_id\": _norm(model_id),\r\n  669:             \"motif_cue\": motif_cue,\r\n  670:             \"motif_sha256\": hashlib.sha256(\r\n  671:                 motif_cue.encode(\"utf-8\")).hexdigest(),\r\n  672:             \"normalized_emotion\": _norm(row.get(\"normalized_emotion\")),\r\n  673:             \"ordinal\": int(ordinal),\r\n  674:             \"role\": role,\r\n  675:             \"sanitized_intent\": _norm(row.get(\"sanitized_intent\")),\r\n  676:             \"schema_version\": GHOST_AUTHOR_SCHEMA_VERSION,\r\n  677:             \"template_sha256\": GHOST_TEMPLATE_SHA256,\r\n  678:         }\r\n  679:         spec[\"request_sha256\"] = request_sha256(spec)\r\n  680:         spec[\"id\"] = opaque_id(ordinal)\r\n  681:         specs.append(spec)\r\n  682:     return specs\r\n  683: \r\n  684: \r\n  685: #: THE THIRTEEN HASHED KEYS, and there is no second spelling of this set.\r\n  686: GHOST_REQUEST_HASH_KEYS = (\r\n  687:     \"author_version\", \"beat_id\", \"mapped_arc\", \"mode\", \"model_id\",\r\n  688:     \"motif_cue\", \"motif_sha256\", \"normalized_emotion\", \"ordinal\", \"role\",\r\n  689:     \"sanitized_intent\", \"schema_version\", \"template_sha256\",\r\n  690: )\r\n  691: \r\n  692: \r\n  693: def request_sha256(spec) -> str:\r\n  694:     \"\"\"SHA-256 over compact, sorted, canonical JSON of the thirteen keys.\r\n  695: \r\n  696:     ``beat_id`` is the CANONICAL ledger identity (``b000_music_open`` included).\r\n  697:     Neither the cast-time temporary ``shot_id=beat_id`` nor the durable\r\n  698:     ``shot_id=\"shot_\"+beat_id`` is hashed -- they differ on purpose, and hashing\r\n  699:     either would make the temporary and durable objects disagree.\r\n  700:     \"\"\"\r\n  701:     payload = {key: spec.get(key) for key in GHOST_REQUEST_HASH_KEYS}\r\n  702:     missing = [k for k, v in payload.items() if v is None]\r\n  703:     if missing:\r\n  704:         raise GhostAuthorError(\r\n  705:             \"Ghost request hash is missing key(s) %s\" % \", \".join(missing))\r\n  706:     blob = json.dumps(payload, sort_keys=True, separators=(\",\", \":\"),\r\n  707:                       ensure_ascii=False)\r\n  708:     return hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()\r\n  709: \r\n  710: \r\n  711: def output_sha256(drawable_beat) -> str:\r\n  712:     \"\"\"The accepted leaf's own bytes -- never the disposition-bearing wrapper.\r\n  713: \r\n  714:     Hashing the wrapper would make ``source`` part of the digest, so the same\r\n  715:     text replayed under ``source=replay`` would hash differently from the text\r\n  716:     that was authored. The leaf is the artifact; the disposition is a receipt.\r\n  717:     \"\"\"\r\n  718:     return hashlib.sha256(str(drawable_beat or \"\").encode(\"utf-8\")).hexdigest()\r\n  719: \r\n  720: \r\n  721: def build_batch_prompt(specs) -> str:\r\n  722:     \"\"\"The single user message for one whole episode's Ghost batch.\"\"\"\r\n  723:     lines = [GHOST_BATCH_RULES, GHOST_BATCH_HEADER]\r\n  724:     for spec in specs:\r\n  725:         parts = [\"id=%s\" % spec[\"id\"], \"mode=%s\" % spec[\"mode\"],\r\n  726:                  \"motif=%s\" % spec[\"motif_cue\"]]\r\n  727:         if spec.get(\"sanitized_intent\"):\r\n  728:             parts.append(\"happening=%s\" % spec[\"sanitized_intent\"])\r\n  729:         if spec.get(\"normalized_emotion\"):\r\n  730:             parts.append(\"mood=%s\" % spec[\"normalized_emotion\"])\r\n  731:         if spec.get(\"mapped_arc\"):\r\n  732:             parts.append(\"story=%s\" % spec[\"mapped_arc\"])\r\n  733:         lines.append(\"- \" + \"; \".join(parts))\r\n  734:     return \"\\n\".join(lines)\r\n  735: \r\n  736: \r\n  737: # --------------------------------------------------------------------------- #\r\n  738: # Strict parsing. One envelope, no salvage.\r\n  739: # --------------------------------------------------------------------------- #\r\n  740: \r\n  741: _FENCE_RE = re.compile(\r\n  742:     r\"\\A\\s*```(?:json)?\\s*\\n(?P<body>.*?)\\n?\\s*```\\s*\\Z\", re.DOTALL)\r\n  743: \r\n  744: \r\n  745: def _strip_one_fence(raw) -> str:\r\n  746:     \"\"\"Remove EXACTLY one enclosing markdown fence -- transport, not content.\r\n  747: \r\n  748:     One, and only one: a response wrapped twice, or with prose either side of\r\n  749:     the fence, is a response that did not follow the instruction, and pretending\r\n  750:     otherwise is how a parser starts accepting anything.\r\n  751:     \"\"\"\r\n  752:     text = str(raw or \"\").strip()\r\n  753:     match = _FENCE_RE.match(text)\r\n  754:     return match.group(\"body\").strip() if match else text\r\n  755: \r\n  756: \r\n  757: def _object_pairs_hook(pairs):\r\n  758:     seen = set()\r\n  759:     for key, _value in pairs:\r\n  760:         if key in seen:\r\n  761:             raise GhostAuthorParseError(\r\n  762:                 \"Ghost batch response repeats the key %r\" % (key,))\r\n  763:         seen.add(key)\r\n  764:     return dict(pairs)\r\n  765: \r\n  766: \r\n  767: def parse_batch_response(raw, expected_ids) -> dict:\r\n  768:     \"\"\"``{opaque_id: drawable_beat}``, or raise.\r\n  769: \r\n  770:     ACCEPTS EXACTLY ONE SHAPE:\r\n  771:     ``{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": \"...\"}, ...]}`` -- every\r\n  772:     expected id present exactly once, no unknown id, no extra field on the\r\n  773:     envelope or on a row, no trailing object after the JSON.\r\n  774:     \"\"\"\r\n  775:     expected = list(expected_ids or ())\r\n  776:     body = _strip_one_fence(raw)\r\n  777:     if not body:\r\n  778:         raise GhostAuthorParseError(\"Ghost batch response is empty\")\r\n  779:     decoder = json.JSONDecoder(object_pairs_hook=_object_pairs_hook)\r\n  780:     try:\r\n  781:         payload, end = decoder.raw_decode(body)\r\n  782:     except GhostAuthorParseError:\r\n  783:         raise\r\n  784:     except ValueError as exc:\r\n  785:         raise GhostAuthorParseError(\r\n  786:             \"Ghost batch response is not JSON: %s\" % (exc,)) from exc\r\n  787:     if body[end:].strip():\r\n  788:         raise GhostAuthorParseError(\r\n  789:             \"Ghost batch response carries trailing content after the JSON \"\r\n  790:             \"object -- prose and second objects are not transport wrapping\")\r\n  791:     if not isinstance(payload, dict):\r\n  792:         raise GhostAuthorParseError(\r\n  793:             \"Ghost batch response is a %s, not an object\"\r\n  794:             % type(payload).__name__)\r\n  795:     if set(payload) != {\"shots\"}:\r\n  796:         raise GhostAuthorParseError(\r\n  797:             \"Ghost batch envelope must carry exactly one key 'shots'; got %s\"\r\n  798:             % (\", \".join(sorted(payload)) or \"nothing\"))\r\n  799:     rows = payload.get(\"shots\")\r\n  800:     if not isinstance(rows, list):\r\n  801:         raise GhostAuthorParseError(\"Ghost batch 'shots' is not a list\")\r\n  802:     out = {}\r\n  803:     for row in rows:\r\n  804:         if not isinstance(row, dict):\r\n  805:             raise GhostAuthorParseError(\r\n  806:                 \"Ghost batch row is a %s, not an object\" % type(row).__name__)\r\n  807:         if set(row) != {\"id\", \"drawable_beat\"}:\r\n  808:             raise GhostAuthorParseError(\r\n  809:                 \"Ghost batch row must carry exactly id + drawable_beat; got %s\"\r\n  810:                 % \", \".join(sorted(row)))\r\n  811:         shot_id = row.get(\"id\")\r\n  812:         leaf = row.get(\"drawable_beat\")\r\n  813:         if not isinstance(shot_id, str) or not isinstance(leaf, str):\r\n  814:             raise GhostAuthorParseError(\r\n  815:                 \"Ghost batch row id/drawable_beat must both be strings\")\r\n  816:         if shot_id not in expected:\r\n  817:             raise GhostAuthorParseError(\r\n  818:                 \"Ghost batch row carries unknown id %r\" % (shot_id,))\r\n  819:         if shot_id in out:\r\n  820:             raise GhostAuthorParseError(\r\n  821:                 \"Ghost batch repeats id %r\" % (shot_id,))\r\n  822:         out[shot_id] = _norm(leaf)\r\n  823:     missing = [i for i in expected if i not in out]\r\n  824:     if missing:\r\n  825:         raise GhostAuthorParseError(\r\n  826:             \"Ghost batch response is missing id(s) %s\" % \", \".join(missing))\r\n  827:     return out\r\n  828: \r\n  829: \r\n  830: # --------------------------------------------------------------------------- #\r\n  831: # Leaf validation. SHAPE AND BOUNDARY SAFETY -- never a story-vocabulary judge.\r\n  832: # --------------------------------------------------------------------------- #\r\n  833: \r\n  834: def validate_drawable_beat(leaf, *, mode, names=()) -> tuple:\r\n  835:     \"\"\"``(ok, reason)`` for one authored leaf.\r\n  836: \r\n  837:     This is deliberately NOT a quality gate. It checks that the leaf is the\r\n  838:     right shape, that nothing crossed the boundary that was not supposed to\r\n  839:     (a name, a second person, a field label), and that it did not answer a\r\n  840:     question Python already answered (lettering, camera, style, a negation, a\r\n  841:     person in a non-figure mode). Whether the picture is any good is the\r\n  842:     operator's eye, not a word list.\r\n  843:     \"\"\"\r\n  844:     text = _norm(leaf)\r\n  845:     if not text:\r\n  846:         return False, \"empty\"\r\n  847:     if \"\\n\" in str(leaf) or \"\\r\" in str(leaf):\r\n  848:         return False, \"line break\"\r\n  849:     if len(text) > GHOST_LEAF_MAX_CHARS:\r\n  850:         return False, \"over %d characters\" % GHOST_LEAF_MAX_CHARS\r\n  851:     if \":\" in text:\r\n  852:         return False, \"carries a field label\"\r\n  853:     words = text.split()\r\n  854:     if len(words) < GHOST_LEAF_MIN_WORDS:\r\n  855:         return False, \"under %d words\" % GHOST_LEAF_MIN_WORDS\r\n  856:     if len(words) > GHOST_LEAF_MAX_WORDS:\r\n  857:         return False, \"over %d words\" % GHOST_LEAF_MAX_WORDS\r\n  858:     lowered = set(_WORD_RE.findall(text.lower()))\r\n  859:     if lowered & _LETTERING_WORDS:\r\n  860:         return False, \"asks for lettering\"\r\n  861:     if lowered & _BOILERPLATE_WORDS:\r\n  862:         return False, \"carries camera/style boilerplate\"\r\n  863:     if lowered & _ABSTRACT_SUBJECT_WORDS:\r\n  864:         return False, \"names a texture instead of a thing\"\r\n  865:     if _SECOND_PERSON_RE.search(text):\r\n  866:         return False, \"addresses a second person\"\r\n  867:     if _NEGATION_RE.search(text):\r\n  868:         return False, \"negates in the positive channel\"\r\n  869:     stripped = strip_cast_names(text, names)\r\n  870:     if stripped.lower() != text.lower():\r\n  871:         return False, \"carries a cast name\"\r\n  872:     if str(mode) in GHOST_NON_FIGURE_MODES and (lowered & _HUMAN_WORDS):\r\n  873:         return False, \"requests a person in %s mode\" % (mode,)\r\n  874:     tail = words[-1].strip(\",.;:-\").lower()\r\n  875:     if tail in _gsp._DANGLING_TAIL_WORDS:\r\n  876:         return False, \"ends on a dangling function word\"\r\n  877:     return True, \"\"\r\n  878: \r\n  879: \r\n  880: # --------------------------------------------------------------------------- #\r\n  881: # The deterministic batch. Complete clauses, never a free-text slice.\r\n  882: # --------------------------------------------------------------------------- #\r\n  883: \r\n  884: #: Complete, checked-in, mode-specific clauses. Every one of them is a whole\r\n  885: #: drawable idea -- which is precisely what the v1 six-word slice was not.\r\n  886: GHOST_FALLBACK_CLAUSES = {\r\n  887:     \"figure\": (\r\n  888:         \"a figure turns slowly toward a lit doorway\",\r\n  889:         \"a figure steps forward across a bare wooden floor\",\r\n  890:         \"a figure lifts one hand and holds it against the light\",\r\n  891:         \"a figure leans over a table and goes still\",\r\n  892:         \"a figure straightens and looks off past the frame\",\r\n  893:         \"a figure turns away and walks into the dark\",\r\n  894:     ),\r\n  895:     \"object\": (\r\n  896:         \"it tilts on the table as a shadow crosses it\",\r\n  897:         \"it catches a rising glow along one worn edge\",\r\n  898:         \"it rocks once on the wood and settles again\",\r\n  899:         \"it stands on a desk while dust drifts across it\",\r\n  900:         \"it turns a quarter and the highlight slides away\",\r\n  901:         \"it sinks slowly into the shadow at the table edge\",\r\n  902:     ),\r\n  903:     \"signal\": (\r\n  904:         \"a lamp swings past it and the shadow sweeps the wall\",\r\n  905:         \"light crawls across it and steadies against the back wall\",\r\n  906:         \"a warm beam finds it and holds on its worn edge\",\r\n  907:         \"it sits in the dark as a slow light passes over it\",\r\n  908:         \"the light on it narrows to a single bright band\",\r\n  909:         \"the light leaves it and the room goes dim\",\r\n  910:     ),\r\n  911: }\r\n  912: \r\n  913: #: The bookends get their own phase-specific clauses so an episode does not\r\n  914: #: open and close on the same picture, which is what a shared pack register\r\n  915: #: produced on every v1 episode.\r\n  916: GHOST_FALLBACK_BOOKENDS = {\r\n  917:     (\"opening\", \"object\"): \"it lights from cold to warm on the studio desk\",\r\n  918:     (\"opening\", \"signal\"): \"a warm light finds it in the dark studio\",\r\n  919:     (\"closing\", \"object\"): \"it dims slowly and the highlight leaves its edge\",\r\n  920:     (\"closing\", \"signal\"): \"the light slides off it and the studio goes dark\",\r\n  921: }\r\n  922: \r\n  923: \r\n  924: def _bookend_phase(beat_id, ordinal, total) -> str:\r\n  925:     \"\"\"``opening`` or ``closing`` for a bookend, by id then by position.\"\"\"\r\n  926:     bid = str(beat_id or \"\").lower()\r\n  927:     if \"open\" in bid:\r\n  928:         return \"opening\"\r\n  929:     if \"clos\" in bid or \"end\" in bid:\r\n  930:         return \"closing\"\r\n  931:     return \"opening\" if int(ordinal) * 2 < int(total or 1) else \"closing\"\r\n  932: \r\n  933: \r\n  934: def deterministic_leaf(spec, *, episode_seed, used=(), total=0) -> str:\r\n  935:     \"\"\"One complete checked-in clause for a spec, unique within the batch.\r\n  936: \r\n  937:     Deterministic collision PROBING rather than modulo-and-hope: two beats in\r\n  938:     the same mode would otherwise land on the same clause about one time in\r\n  939:     six, and an episode that says the same sentence twice is exactly the\r\n  940:     repetition this sprint exists to remove.\r\n  941:     \"\"\"\r\n  942:     mode = str(spec.get(\"mode\") or \"\")\r\n  943:     role = normalize_role(spec.get(\"role\"))\r\n  944:     ordinal = int(spec.get(\"ordinal\") or 0)\r\n  945:     if role != \"character_video\":\r\n  946:         phase = _bookend_phase(spec.get(\"beat_id\"), ordinal, total)\r\n  947:         candidate = GHOST_FALLBACK_BOOKENDS.get((phase, mode), \"\")\r\n  948:         if candidate and candidate not in used:\r\n  949:             return candidate\r\n  950:     pool = GHOST_FALLBACK_CLAUSES.get(mode) or ()\r\n  951:     if not pool:\r\n  952:         raise GhostAuthorError(\r\n  953:             \"no deterministic Ghost clause pool for mode %r\" % (mode,))\r\n  954:     start = _hash_int(episode_seed, spec.get(\"beat_id\"), mode,\r\n  955:                       GHOST_AUTHOR_VERSION) % len(pool)\r\n  956:     for step in range(len(pool)):\r\n  957:         candidate = pool[(start + step) % len(pool)]\r\n  958:         if candidate not in used:\r\n  959:             return candidate\r\n  960:     return pool[start]\r\n  961: \r\n  962: \r\n  963: def deterministic_batch(specs, *, episode_seed, already_used=()) -> dict:\r\n  964:     \"\"\"``{opaque_id: leaf}`` -- a complete batch, never a partial salvage.\r\n  965: \r\n  966:     ``already_used`` carries leaves decided elsewhere in the SAME episode --\r\n  967:     replayed rows, typically. Without it a mixed episode could hand two beats\r\n  968:     the same checked-in clause, because each call would probe for collisions\r\n  969:     only against its own subset, and an episode that says the same sentence\r\n  970:     twice is the repetition this sprint exists to remove.\r\n  971:     \"\"\"\r\n  972:     out = {}\r\n  973:     used = [str(leaf) for leaf in (already_used or ())]\r\n  974:     total = len(specs or ())\r\n  975:     for spec in specs or ():\r\n  976:         leaf = deterministic_leaf(spec, episode_seed=episode_seed,\r\n  977:                                   used=used, total=total)\r\n  978:         used.append(leaf)\r\n  979:         out[spec[\"id\"]] = leaf\r\n  980:     return out\r\n  981: \r\n  982: \r\n  983: # --------------------------------------------------------------------------- #\r\n  984: # The stored object.\r\n  985: # --------------------------------------------------------------------------- #\r\n  986: \r\n  987: #: THE EXACT FIELD SET. Extra or missing keys are a malformed object, and a\r\n  988: #: malformed object fails closed rather than degrading to v1.\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'function Show-Lines($Path,$Start,$End){$i=0; Get-Content -LiteralPath $Path | ForEach-Object {$i++; if($i -ge $Start -and $i -le $End){'\"'{0,5}: {1}' -f \"'$i,$_}}}; Show-Lines '\"'nodes\\\\_otr_video_engines\\\\ghost_signal_prompt.py' 100 165; Show-Lines 'nodes\\\\_otr_video_engines\\\\ghost_signal_prompt.py' 800 910; Show-Lines 'tests\\\\test_ghost_signal_author.py' 130 220; Show-Lines 'tests\\\\test_ghost_signal_author.py' 300 400; Get-ChildItem -Recurse -File -Include *.py | Where-Object { \"'$_.FullName -notlike '\"'*\\\\.claude\\\\worktrees\\\\*' } | Select-String -Pattern 'schedule_ghost_modes\\\\(' | ForEach-Object { '{0}:{1}: {2}' -f \"'$_.Path,$_.LineNumber,$_.Line.Trim() }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'function Show-Lines($Path,$Start,$End){$i=0; Get-Content -LiteralPath $Path | ForEach-Object {$i++; if($i -ge $Start -and $i -le $End){'\"'{0,5}: {1}' -f \"'$i,$_}}}; Show-Lines '\"'nodes\\\\_otr_video_engines\\\\ghost_signal_prompt.py' 100 165; Show-Lines 'nodes\\\\_otr_video_engines\\\\ghost_signal_prompt.py' 800 910; Show-Lines 'tests\\\\test_ghost_signal_author.py' 130 220; Show-Lines 'tests\\\\test_ghost_signal_author.py' 300 400; Get-ChildItem -Recurse -File -Include *.py | Where-Object { \"'$_.FullName -notlike '\"'*\\\\.claude\\\\worktrees\\\\*' } | Select-String -Pattern 'schedule_ghost_modes\\\\(' | ForEach-Object { '{0}:{1}: {2}' -f \"'$_.Path,$_.LineNumber,$_.Line.Trim() }'","aggregated_output":"  100: \r\n  101: #: The affirmative closing directive. AFFIRMATIVE because the negative channel\r\n  102: #: is live on this lane (cfg 8.0 with a real unconditional branch), so\r\n  103: #: exclusions belong in the negative and the positive states what to draw.\r\n  104: GHOST_SHOT_LAW = \"steady legible silhouette, one clear action, unbroken shot\"\r\n  105: \r\n  106: #: THE PROMPT v2 SHOT LAWS, one per representation, ALL AFFIRMATIVE, and since\r\n  107: #: 2026-08-22 ALL THREE NAME A PHYSICAL THING.\r\n  108: #:\r\n  109: #: There is no ``no people`` here and there never will be. The negative channel\r\n  110: #: is live on this lane, so exclusion belongs there; a positive clause that\r\n  111: #: attends to an absent human is a request for the model to think about one.\r\n  112: #:\r\n  113: #: THE FIRST DRAFT OF THESE LAWS IS WHAT TANKED THE PICTURES, and it is worth\r\n  114: #: writing down exactly how. They read \"one isolated emblem FILLING THE\r\n  115: #: COMPOSITION\" and \"an ABSTRACT SIGNAL FIELD filling the composition\" -- which\r\n  116: #: are instructions toward abstraction, and a 512x288 SD1.5 obliges by painting\r\n  117: #: TEXTURE instead of a subject. Measured across a same-seed pair: the v1 arm\r\n  118: #: rendered a recognisable subject on 4 of 4 sampled beats (a period radio set,\r\n  119: #: a figure at a lectern, a document, a tuning dial); the first-draft v2 arm\r\n  120: #: rendered 0 of 4, and its LLM-authored sibling managed 2 of 8 -- both of them\r\n  121: #: on the only beats whose authored leaf happened to name a real object (a\r\n  122: #: lantern, a radio dial).\r\n  123: #:\r\n  124: #: So the rule the evidence actually supports: LEGIBILITY TRACKS CONCRETE NOUNS.\r\n  125: #: ``object`` and ``signal`` still keep a person out of frame, but they do it by\r\n  126: #: naming a REAL THING to look at -- an object on a surface, an object lit from\r\n  127: #: within -- rather than by asking for a field of nothing.\r\n  128: GHOST_MODE_LAWS_V2 = {\r\n  129:     \"figure\": (\"mid-shot or wider, whole figure legible, one clear action, \"\r\n  130:                \"unbroken shot\"),\r\n  131:     \"object\": (\"the object fills the frame on a real surface, one clear \"\r\n  132:                \"action, unbroken shot\"),\r\n  133:     # \"LIT AGAINST\", not \"lit from within\": the motif prop is whatever the cast\r\n  134:     # row supplied, and most of them do not glow. A satchel lit from within is\r\n  135:     # a request the sampler cannot honour; a satchel lit against a dark room\r\n  136:     # with light moving across it is a picture, and it still keeps a person out\r\n  137:     # of frame, which is the only thing this mode owed.\r\n  138:     \"signal\": (\"the object lit against a dark room, moving light across it, \"\r\n  139:                \"unbroken shot\"),\r\n  140: }\r\n  141: \r\n  142: #: Role framing floors. The character floor is a MID-SHOT: closer than that and\r\n  143: #: the model starts trying to render a face it cannot hold.\r\n  144: GHOST_FRAMING = {\r\n  145:     \"character_video\": \"mid-shot or wider, whole figure legible\",\r\n  146:     \"announcer_visual\": \"medium shot of the console, dial face centered\",\r\n  147:     \"music_visual\": \"wide abstract frame, no people\",\r\n  148: }\r\n  149: \r\n  150: # --------------------------------------------------------------------------- #\r\n  151: # Sigil vocabularies. Checked in, pinned by tests, deliberately small.\r\n  152: #\r\n  153: # These are matched as WHOLE WORDS against a candidate phrase. A bucket takes\r\n  154: # the FIRST phrase that matches it, in the source's own order, so a cast row\r\n  155: # that leads with its strongest cue keeps that cue.\r\n  156: # --------------------------------------------------------------------------- #\r\n  157: \r\n  158: #: Bucket 1 -- silhouette / body shape. The single most durable property across\r\n  159: #: a sliding context: a tall thin figure stays a tall thin figure.\r\n  160: SIGIL_SILHOUETTE_WORDS = frozenset({\r\n  161:     \"tall\", \"short\", \"broad\", \"slight\", \"stooped\", \"lean\", \"heavyset\",\r\n  162:     \"wiry\", \"angular\", \"round\", \"towering\", \"compact\", \"gaunt\", \"stocky\",\r\n  163:     \"willowy\", \"hulking\", \"slender\", \"squat\", \"burly\", \"spare\", \"massive\",\r\n  164:     \"diminutive\", \"rangy\", \"thickset\", \"bent\", \"straight-backed\", \"narrow\",\r\n  165: })\r\n  800:             \"Ghost Signal protected slots compose to %d chars, over the %d \"\r\n  801:             \"ceiling, with nothing droppable left (slots=%s). The composer or \"\r\n  802:             \"the sigil ceiling is wrong -- runtime truncation is NOT the \"\r\n  803:             \"preservation mechanism for the subject, the authored motion \"\r\n  804:             \"clause, the mid-shot floor or the shot law.\"\r\n  805:             % (len(positive), GHOST_PROMPT_MAX_CHARS, \",\".join(slots)))\r\n  806: \r\n  807:     return {\r\n  808:         \"positive\": positive,\r\n  809:         \"negative\": compose_ghost_negative(style),\r\n  810:         \"slots\": slots,\r\n  811:     }\r\n  812: \r\n  813: \r\n  814: #: The v2 ordered slots, and there are only four. Everything v1 emitted from\r\n  815: #: the ledger's raw surfaces -- the beat intent, the traits, the arc phase, the\r\n  816: #: pack motion register -- is gone: an authored drawable leaf replaces all of\r\n  817: #: it, and re-adding any of them would be re-adding the defect.\r\n  818: GHOST_V2_SLOTS = (\"pack_cue\", \"motif\", \"leaf\", \"law\")\r\n  819: \r\n  820: \r\n  821: def compose_ghost_prompt_v2(role, style, mode, motif_cue,\r\n  822:                             drawable_beat) -> dict:\r\n  823:     \"\"\"Compose one Ghost PROMPT v2 positive plus its unchanged negative.\r\n  824: \r\n  825:     PURE AND SCALAR. It takes no ledger, no shot, no cast row and no engine --\r\n  826:     only the five values the render driver and the author-time admission check\r\n  827:     both already hold, which is what makes it impossible for those two to\r\n  828:     compose different text from the same stored object.\r\n  829: \r\n  830:     It never reads raw ``beat_intent``, raw traits, raw ``arc_phase``, a pack\r\n  831:     motion register, an open subject or a motion clause. Those are not\r\n  832:     parameters, so a future edit cannot quietly reach for one.\r\n  833: \r\n  834:     Returns ``{\"positive\", \"negative\", \"components\", \"slots\"}``. ``components``\r\n  835:     is the four PROTECTED pieces by name, returned alongside the joined string\r\n  836:     so a caller can prove each survived a downstream transform without parsing\r\n  837:     prose back out of the result.\r\n  838:     \"\"\"\r\n  839:     role = str(role or \"\")\r\n  840:     mode = str(mode or \"\")\r\n  841:     motif = _normalize_ws(motif_cue)\r\n  842:     leaf = _normalize_ws(drawable_beat)\r\n  843: \r\n  844:     if role not in GHOST_FRAMING:\r\n  845:         raise GhostPromptError(\r\n  846:             \"Ghost Prompt v2 does not compose for role %r\" % (role,))\r\n  847:     law = GHOST_MODE_LAWS_V2.get(mode)\r\n  848:     if not law:\r\n  849:         raise GhostPromptError(\r\n  850:             \"Ghost Prompt v2 mode %r is not one of %s\"\r\n  851:             % (mode, \", \".join(sorted(GHOST_MODE_LAWS_V2))))\r\n  852:     if role != \"character_video\" and mode == \"figure\":\r\n  853:         raise GhostPromptError(\r\n  854:             \"Ghost Prompt v2 refuses figure mode on the %s bookend -- a radio \"\r\n  855:             \"console is not a person, and the mode scheduler never assigns \"\r\n  856:             \"this pairing\" % (role,))\r\n  857:     if not motif:\r\n  858:         raise GhostPromptError(\r\n  859:             \"Ghost Prompt v2 has no recurrence motif for a %s beat. The motif \"\r\n  860:             \"IS the identity mechanism on this lane; an empty one is a \"\r\n  861:             \"characterless episode, not a shorter prompt.\" % (role,))\r\n  862:     if not leaf:\r\n  863:         raise GhostPromptError(\r\n  864:             \"Ghost Prompt v2 has no drawable beat for a %s beat -- the \"\r\n  865:             \"authored leaf is the only content slot, so an empty one is a \"\r\n  866:             \"blank picture\" % (role,))\r\n  867: \r\n  868:     body = \", \".join((motif, leaf, law))\r\n  869:     positive = _prefix_pack_cue(style, body)\r\n  870: \r\n  871:     # The pack cue as the CUE ITSELF, recovered from what the shared authority\r\n  872:     # actually prepended rather than re-derived here -- a second derivation is\r\n  873:     # a second chance to disagree with `prefix_style_cue` about the bytes.\r\n  874:     pack_cue = \"\"\r\n  875:     if positive != body and positive.endswith(body):\r\n  876:         pack_cue = positive[:len(positive) - len(body)].strip().rstrip(\r\n  877:             \".\").strip()\r\n  878: \r\n  879:     return {\r\n  880:         \"positive\": positive,\r\n  881:         \"negative\": compose_ghost_negative(style),\r\n  882:         \"components\": {\r\n  883:             \"pack_cue\": pack_cue,\r\n  884:             \"motif\": motif,\r\n  885:             \"leaf\": leaf,\r\n  886:             \"law\": law,\r\n  887:         },\r\n  888:         \"slots\": [name for name in GHOST_V2_SLOTS\r\n  889:                   if name != \"pack_cue\" or pack_cue],\r\n  890:     }\r\n  891: \r\n  892: \r\n  893: def _join(pieces) -> str:\r\n  894:     \"\"\"Join the ordered slot pieces into one comma-separated prompt.\"\"\"\r\n  895:     return \", \".join(text for _, text in pieces if _normalize_ws(text))\r\n  896: \r\n  897: \r\n  898: def _prefix_pack_cue(style, prompt) -> str:\r\n  899:     \"\"\"Front-anchor the pack's style token. ADDITIVE ONLY -- the shared\r\n  900:     ``prefix_style_cue`` authority, never a second copy of it here.\"\"\"\r\n  901:     if style is None:\r\n  902:         return prompt\r\n  903:     try:\r\n  904:         from .._otr_visual_styles import prefix_style_cue  # type: ignore\r\n  905:     except ImportError:  # pragma: no cover -- flat test imports\r\n  906:         from _otr_visual_styles import prefix_style_cue  # type: ignore\r\n  907:     return prefix_style_cue(style, prompt)\r\n  908: \r\n  909: \r\n  910: __all__ = [\r\n  130:           \"sanitized_intent\": \"\", \"normalized_emotion\": \"\", \"mapped_arc\": \"\"}],\r\n  131:         model_id=\"m/x\")\r\n  132:     assert specs[0][\"id\"] == \"g000\"\r\n  133:     assert \"music_opening_001\" not in gsa.build_batch_prompt(specs)\r\n  134: \r\n  135: \r\n  136: # --------------------------------------------------------------------------- #\r\n  137: # 2. Deterministic representation scheduling.\r\n  138: # --------------------------------------------------------------------------- #\r\n  139: \r\n  140: TIMELINE = [(\"music_opening_001\", \"music_visual\"), (\"b001\", \"announcer_visual\"),\r\n  141:             (\"b002\", \"character_video\"), (\"b003\", \"character_video\"),\r\n  142:             (\"b004\", \"character_video\"), (\"b005\", \"character_video\"),\r\n  143:             (\"b006\", \"announcer_visual\"), (\"music_closing_001\",\r\n  144:                                            \"music_visual\")]\r\n  145: \r\n  146: \r\n  147: def test_the_schedule_is_deterministic_on_the_episode_seed():\r\n  148:     a = gsa.schedule_ghost_modes(TIMELINE, 1013426535)\r\n  149:     b = gsa.schedule_ghost_modes(TIMELINE, 1013426535)\r\n  150:     assert a == b\r\n  151:     assert gsa.schedule_ghost_modes(TIMELINE, 999) != a\r\n  152: \r\n  153: \r\n  154: def test_no_bookend_ever_takes_figure_mode():\r\n  155:     \"\"\"A radio console is not a person.\"\"\"\r\n  156:     for seed in range(24):\r\n  157:         modes = gsa.schedule_ghost_modes(TIMELINE, seed)\r\n  158:         for beat_id, role in TIMELINE:\r\n  159:             if role != \"character_video\":\r\n  160:                 assert modes[beat_id] in gsa.GHOST_NON_FIGURE_MODES\r\n  161: \r\n  162: \r\n  163: def test_no_run_of_three_identical_representations():\r\n  164:     for seed in range(64):\r\n  165:         modes = gsa.schedule_ghost_modes(TIMELINE, seed)\r\n  166:         run = [modes[b] for b, _r in TIMELINE]\r\n  167:         for i in range(len(run) - 2):\r\n  168:             assert not (run[i] == run[i + 1] == run[i + 2]), (seed, run)\r\n  169: \r\n  170: \r\n  171: def test_at_least_half_the_character_clips_are_non_figure():\r\n  172:     \"\"\"An unmodified period-three cycle satisfies the quota by construction.\"\"\"\r\n  173:     chars = [b for b, r in TIMELINE if r == \"character_video\"]\r\n  174:     for seed in range(64):\r\n  175:         modes = gsa.schedule_ghost_modes(TIMELINE, seed)\r\n  176:         picked = [modes[b] for b in chars]\r\n  177:         non_figure = sum(1 for m in picked if m != \"figure\")\r\n  178:         assert non_figure * 2 >= len(picked), (seed, picked)\r\n  179: \r\n  180: \r\n  181: def test_character_modes_are_an_unmodified_cycle():\r\n  182:     \"\"\"Only a bookend may be corrected; a character assignment never moves.\"\"\"\r\n  183:     cycle = gsa.GHOST_CHARACTER_CYCLE\r\n  184:     chars = [b for b, r in TIMELINE if r == \"character_video\"]\r\n  185:     for seed in range(32):\r\n  186:         picked = [gsa.schedule_ghost_modes(TIMELINE, seed)[b] for b in chars]\r\n  187:         # ANY rotation, not the first index that matches. `figure` appears\r\n  188:         # TWICE in the cycle, so `cycle.index(picked[0])` picks 0 even for a run\r\n  189:         # that legitimately started at index 2 -- a test bug that fails a\r\n  190:         # perfectly correct schedule.\r\n  191:         rotations = [tuple(cycle[(off + i) % len(cycle)]\r\n  192:                            for i in range(len(picked)))\r\n  193:                      for off in range(len(cycle))]\r\n  194:         assert tuple(picked) in rotations, (seed, picked)\r\n  195: \r\n  196: \r\n  197: def test_half_the_character_beats_show_a_person():\r\n  198:     \"\"\"The episode lost its people in the first draft; this is the floor.\"\"\"\r\n  199:     chars = [b for b, r in TIMELINE if r == \"character_video\"]\r\n  200:     assert (gsa.GHOST_CHARACTER_CYCLE.count(\"figure\") * 2\r\n  201:             == len(gsa.GHOST_CHARACTER_CYCLE))\r\n  202:     for seed in range(64):\r\n  203:         modes = gsa.schedule_ghost_modes(TIMELINE, seed)\r\n  204:         figures = sum(1 for b in chars if modes[b] == \"figure\")\r\n  205:         assert figures * 2 >= len(chars) - 1, (seed, figures)\r\n  206: \r\n  207: \r\n  208: # --------------------------------------------------------------------------- #\r\n  209: # 3. The recurrence motif -- compact, allowlisted, and NOT a face.\r\n  210: # --------------------------------------------------------------------------- #\r\n  211: \r\n  212: def test_the_motif_carries_no_face_landmark_or_cast_prose():\r\n  213:     comp = _components()\r\n  214:     # The row really does carry a facial landmark, and the distiller really\r\n  215:     # does bucket it -- so its absence below is a choice, not an accident.\r\n  216:     assert \"scar\" in comp[\"landmark\"]\r\n  217:     for mode in gsa.GHOST_MODES:\r\n  218:         motif = gsa.motif_for_character(comp, mode, seed_int=comp[\"seed_int\"])\r\n  219:         low = motif.lower()\r\n  220:         for banned in (\"jaw\", \"brow\", \"hair\", \"scar\", \"cheek\", \"face\", \"man\",\r\n  300:     '{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": \"x\", \"mode\": \"object\"}]}',\r\n  301:     '{\"shots\": [{\"id\": \"g000\"}]}',\r\n  302:     '{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": \"a\"}, '\r\n  303:     '{\"id\": \"g000\", \"drawable_beat\": \"b\"}]}',\r\n  304:     '{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": \"a\"}], \"note\": \"hi\"}',\r\n  305:     '{\"shots\": {\"g000\": \"a rust clasp turns\"}}',\r\n  306:     '{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": 7}]}',\r\n  307:     '[{\"id\": \"g000\", \"drawable_beat\": \"a\"}]',\r\n  308:     \"```json\\n```json\\n%s\\n```\\n```\" % GOOD,\r\n  309: ])\r\n  310: def test_every_other_shape_is_refused(raw):\r\n  311:     with pytest.raises(gsa.GhostAuthorParseError):\r\n  312:         gsa.parse_batch_response(raw, [\"g000\"])\r\n  313: \r\n  314: \r\n  315: def test_a_duplicate_json_key_is_refused():\r\n  316:     raw = ('{\"shots\": [{\"id\": \"g000\", \"drawable_beat\": \"a rust clasp turns\", '\r\n  317:            '\"drawable_beat\": \"something else\"}]}')\r\n  318:     with pytest.raises(gsa.GhostAuthorParseError):\r\n  319:         gsa.parse_batch_response(raw, [\"g000\"])\r\n  320: \r\n  321: \r\n  322: # --------------------------------------------------------------------------- #\r\n  323: # 5. Leaf validation -- shape and boundary, never a taste judge.\r\n  324: # --------------------------------------------------------------------------- #\r\n  325: \r\n  326: def test_a_good_leaf_passes_in_every_mode():\r\n  327:     for mode, leaf in (\r\n  328:             (\"figure\", \"an outline lifts one arm into a narrow band of light\"),\r\n  329:             (\"object\", \"the clasp turns and a slow shadow crosses it\"),\r\n  330:             (\"signal\", \"the lamp glows awake and steadies in the dark hall\")):\r\n  331:         ok, why = gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)\r\n  332:         assert ok, (mode, why)\r\n  333: \r\n  334: \r\n  335: def test_a_leaf_that_names_a_texture_is_rejected_in_every_mode():\r\n  336:     \"\"\"THE REGRESSION THIS RULE EXISTS FOR (measured 2026-08-22).\r\n  337: \r\n  338:     The first live v2 arms rendered unreadable texture on every beat whose leaf\r\n  339:     named static, a waveform or a field, and the only beats that survived were\r\n  340:     the two naming a real object. A 512x288 SD1.5 draws what it is handed.\r\n  341:     \"\"\"\r\n  342:     for leaf in (\"bands of static crush inward and open again\",\r\n  343:                  \"a jagged waveform pulses across a dark screen\",\r\n  344:                  \"a gradient of noise tightens toward one bright point\"):\r\n  345:         for mode in gsa.GHOST_MODES:\r\n  346:             ok, why = gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)\r\n  347:             assert not ok, (mode, leaf)\r\n  348:             assert \"texture\" in why\r\n  349: \r\n  350: \r\n  351: @pytest.mark.parametrize(\"leaf,mode,expect\", [\r\n  352:     (\"\", \"object\", \"empty\"),\r\n  353:     (\"too short here\", \"object\", \"under\"),\r\n  354:     (\"a \" * 40, \"object\", \"over\"),\r\n  355:     (\"x\" * 120 + \" turns slowly into the light\", \"object\", \"over\"),\r\n  356:     (\"face: the clasp turns slowly here\", \"object\", \"field label\"),\r\n  357:     (\"adrian spender turns toward the light\", \"figure\", \"cast name\"),\r\n  358:     (\"your hand turns the clasp slowly here\", \"object\", \"second person\"),\r\n  359:     (\"no people beside the turning clasp here\", \"object\", \"negates\"),\r\n  360:     (\"cinematic 8k detailed clasp turning slowly\", \"object\", \"boilerplate\"),\r\n  361:     (\"the title text glows above the clasp\", \"object\", \"lettering\"),\r\n  362:     (\"a man turns the clasp slowly in light\", \"signal\", \"person in\"),\r\n  363:     (\"a woman leans toward the console light\", \"object\", \"person in\"),\r\n  364:     (\"the clasp turns slowly into the\", \"object\", \"dangling\"),\r\n  365: ])\r\n  366: def test_a_bad_leaf_is_named_by_its_defect(leaf, mode, expect):\r\n  367:     ok, why = gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)\r\n  368:     assert not ok\r\n  369:     assert expect in why\r\n  370: \r\n  371: \r\n  372: def test_a_person_is_legal_in_figure_mode_only():\r\n  373:     leaf = \"a silhouette leans into the narrowing band of light\"\r\n  374:     assert gsa.validate_drawable_beat(leaf, mode=\"figure\", names=NAMES)[0]\r\n  375:     for mode in gsa.GHOST_NON_FIGURE_MODES:\r\n  376:         assert not gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)[0]\r\n  377: \r\n  378: \r\n  379: # --------------------------------------------------------------------------- #\r\n  380: # 6. The request hash -- the replay identity.\r\n  381: # --------------------------------------------------------------------------- #\r\n  382: \r\n  383: def test_the_hash_covers_exactly_the_thirteen_declared_keys():\r\n  384:     assert len(gsa.GHOST_REQUEST_HASH_KEYS) == 13\r\n  385:     spec = _spec()\r\n  386:     payload = {k: spec[k] for k in gsa.GHOST_REQUEST_HASH_KEYS}\r\n  387:     blob = json.dumps(payload, sort_keys=True, separators=(\",\", \":\"),\r\n  388:                       ensure_ascii=False)\r\n  389:     assert spec[\"request_sha256\"] == \\\r\n  390:         hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()\r\n  391: \r\n  392: \r\n  393: @pytest.mark.parametrize(\"field,value\", [\r\n  394:     (\"beat_id\", \"b099\"),\r\n  395:     (\"mode\", \"signal\"),\r\n  396:     (\"motif_cue\", \"oli