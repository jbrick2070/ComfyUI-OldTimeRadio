r\n 1765:         from ._otr_model_loader import (  # type: ignore\r\n 1766:             has_local_resident_llm, unload_llm_if_local_resident)\r\n 1767:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1768:         try:\r\n 1769:             from _otr_model_loader import (  # type: ignore\r\n 1770:                 has_local_resident_llm, unload_llm_if_local_resident)\r\n 1771:         except ImportError:\r\n 1772:             return\r\n 1773:     try:\r\n 1774:         unload_llm_if_local_resident()\r\n 1775:     except Exception as exc:  # noqa: BLE001 -- report, never mask the author\r\n 1776:         # REPORTED, THEN STILL CHECKED. Returning here would skip the one line\r\n 1777:         # that proves anything: an unload that raised is precisely the case\r\n 1778:         # most likely to have left the weights resident, so it is the last\r\n 1779:         # moment to skip asking.\r\n 1780:         warnings.append(\"Ghost author: writer unload raised (%s)\" % (exc,))\r\n 1781:     if has_local_resident_llm():\r\n 1782:         raise RuntimeError(\r\n 1783:             \"[OTR_ShotLock] Ghost author: a local writer LLM is STILL resident \"\r\n 1784:             \"after unload -- refusing to enter the image/video phases holding \"\r\n 1785:             \"writer weights\")\r\n 1786: \r\n 1787: \r\n 1788: def _ghost_validate_batch(leaves, specs, style, meta, names):\r\n 1789:     \"\"\"Raise unless EVERY leaf in the batch is acceptable.\r\n 1790: \r\n 1791:     Whole-batch, deliberately. Salvaging the good rows and re-asking for the\r\n 1792:     bad ones would make an episode's prompts a function of how many attempts\r\n 1793:     each row happened to take, which is neither reproducible nor auditable.\r\n 1794:     \"\"\"\r\n 1795:     _gsa, _gsp = _ghost_modules()\r\n 1796:     seen = {}\r\n 1797:     for spec in specs:\r\n 1798:         leaf = leaves.get(spec[\"id\"], \"\")\r\n 1799:         ok, reason = _gsa.validate_drawable_beat(\r\n 1800:             leaf, mode=spec[\"mode\"], names=names)\r\n 1801:         if not ok:\r\n 1802:             raise _gsa.GhostAuthorValidationError(\r\n 1803:                 \"leaf for %s rejected (%s): %r\" % (spec[\"id\"], reason, leaf))\r\n 1804:         key = leaf.lower()\r\n 1805:         if key in seen:\r\n 1806:             raise _gsa.GhostAuthorValidationError(\r\n 1807:                 \"leaf for %s repeats the one written for %s: %r\"\r\n 1808:                 % (spec[\"id\"], seen[key], leaf))\r\n 1809:         seen[key] = spec[\"id\"]\r\n 1810:         fits, why = _gsa.candidate_fits(\r\n 1811:             role=spec[\"role\"], style=style, mode=spec[\"mode\"],\r\n 1812:             motif_cue=spec[\"motif_cue\"], drawable_beat=leaf, ledger_meta=meta)\r\n 1813:         if not fits:\r\n 1814:             raise _gsa.GhostAuthorValidationError(\r\n 1815:                 \"leaf for %s does not fit (%s): %r\" % (spec[\"id\"], why, leaf))\r\n 1816: \r\n 1817: \r\n 1818: def _ghost_generate_batch(gen, specs, *, style, meta, episode_seed, names,\r\n 1819:                           warnings, already_used=()):\r\n 1820:     \"\"\"``(leaves, source, fallback_reason)`` for one whole batch.\r\n 1821: \r\n 1822:     One call for a normal episode. An invalid batch gets ONE fresh whole-batch\r\n 1823:     retry -- not a conversation -- and a second failure receives the complete\r\n 1824:     deterministic batch with the reason recorded, so the disposition is visible\r\n 1825:     in the ledger rather than inferred from prose in a log.\r\n 1826:     \"\"\"\r\n 1827:     _gsa, _gsp = _ghost_modules()\r\n 1828:     if gen is None:\r\n 1829:         return (_gsa.deterministic_batch(specs, episode_seed=episode_seed,\r\n 1830:                                          already_used=already_used),\r\n 1831:                 \"deterministic_fallback\", \"no writer model configured\")\r\n 1832: \r\n 1833:     prompt = _gsa.build_batch_prompt(specs)\r\n 1834:     budget = _gsa.batch_output_tokens(len(specs))\r\n 1835:     ids = [spec[\"id\"] for spec in specs]\r\n 1836:     reason = \"\"\r\n 1837:     for attempt in (1, 2):\r\n 1838:         try:\r\n 1839:             raw = gen([{\"role\": \"user\", \"content\": prompt}],\r\n 1840:                       temperature=_gsa.GHOST_BATCH_TEMPERATURE,\r\n 1841:                       max_new_tokens=budget)\r\n 1842:             leaves = _gsa.parse_batch_response(raw, ids)\r\n 1843:             _ghost_validate_batch(leaves, specs, style, meta, names)\r\n 1844:             if attempt > 1:\r\n 1845:                 log.warning(\"[OTR_ShotLock] Ghost author: batch accepted on \"\r\n 1846:                             \"the retry\")\r\n 1847:             return leaves, \"writer_llm\", \"\"\r\n 1848:         except _gsa.GhostAuthorError as exc:\r\n 1849:             reason = \"attempt %d rejected: %s\" % (attempt, exc)\r\n 1850:         except Exception as exc:  # noqa: BLE001 -- generation, not a load\r\n 1851:             reason = \"attempt %d generation failed: %s\" % (attempt, exc)\r\n 1852:         warnings.append(\"Ghost author %s\" % reason)\r\n 1853:         log.warning(\"[OTR_ShotLock] Ghost author: %s\", reason)\r\n 1854:     return (_gsa.deterministic_batch(specs, episode_seed=episode_seed,\r\n 1855:                                      already_used=already_used),\r\n 1856:             \"deterministic_fallback\", reason)\r\n 1857: \r\n 1858: \r\n 1859: def _author_ghost_prompts(beats, ledger, engine_for, warnings=None):\r\n 1860:     \"\"\"``{beat_id: ghost_prompt}`` for every Ghost beat in this episode.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:26:  executable coverage -- with its `otr_coverage_index.yaml` row appended in the\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:27:  same change. Then stamp `- promotion: BUG-...` here.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:28:* **The BULK FAN-OUT over the backlog stays the OPERATOR'S**, unchanged. Batch\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:29:  promotion, re-litigating older entries, and any judgment call about whether a\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:30:  historical incident deserves a rule are not a window's to make.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:31:* **When in doubt, record the candidate and leave it.** A window that cannot\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:32:  cleanly establish \"genuinely uncovered\" writes the candidate into\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:259:     `_pass_news_read` BEFORE `_pass_script` and copies the result onto\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:260:     `treatment.news_close_read` (`_otr_scifi_news_pro.py:3616-3618`), and\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:261:     `_script_user_prompt` dumps the WHOLE treatment -- fact included -- into\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:262:     the script writer's own context (line ~1821), while the system prompt\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:263:     simultaneously told it never to state that fact. Telling a small local\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:264:     model (`google/gemma-4-12b-it`) not to repeat a fact sitting in its own\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:265:     context is a much weaker ask than not showing it the fact at all.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:266:  6. **Final fix.** `_script_user_prompt` now excludes `news_close_read` from\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:267:     the treatment dump (`treatment.model_dump(exclude={\"news_close_read\"})`)\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:268:     -- the field stays live for every OTHER consumer (ledger assembly,\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:269:     receipts), only this one prompt-building call blinds itself to it. Added\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:270:     a format-reminder restating the in-fiction constraint at point of use.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:271:- **LIVE-VERIFIED CLEAN on the next render**\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:272:  (`signal_lost_the_last_reading_20260818_122159`, published to `otr/obs/`).\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:273:  Outro: \"The graph reached its zenith in the silence of the observation\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:291:  -> 108/108 (added 4 new regression tests proving the context exclusion).\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:292:  Full suite 11024 -> 11028 passed (the 4 new tests), zero regressions, run\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:293:  twice across the session. `tests/test_scifi_news_pro_script_prompt_\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:294:  excludes_the_read.py` is the new file: proves a populated `news_close_read`\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:295:  never appears in the script writer's own prompt, proves every other\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:296:  Treatment field still does, proves the empty-read case is unaffected.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:297:- Bible: not promoted. The generalisable shape -- \"a downstream generation\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:298:  step's finished OUTPUT gets fed back as CONTEXT to an earlier-labelled step\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:299:  that was explicitly told not to produce that content\" -- is a real,\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:300:  reusable defect class (prompt contamination via pipeline ordering) worth a\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:301:  future delta-scrape entry, but not yet checked against the coverage index\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:302:  for whether it is genuinely uncovered.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:303:- status: FIXED and live-verified on `scifi_news_pro`. The `media_archive`\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:304:  half is FIXED but not live-verified. The character-hallucination finding is\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:312:- fix: NONE YET. Two candidate levers, both visible in the telemetry: (1) fix the synthesis seed PER CHARACTER at cast time (it is already recorded in `meta.voice_cast_decision`) instead of re-rolling per line; (2) reconsider `alpha=1.0`, which gives the per-line delivery vector maximum authority to reshape timbre. **This is a design fork with more than one defensible answer -- emotional range across lines is a FEATURE, and pinning the seed may flatten it -- so it takes a panel before code, per the standing rule.**\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:313:- verify idea: render one episode twice, once with a per-character fixed seed, and compare a speaker-similarity measure between a character's own lines. The operator's ear is the acceptance gate; the metric only ranks candidates.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:314:- **THE MISSING-FILE QUESTION IS ANSWERED AND WAS A DRIVER ERROR (2026-08-18, agy lane, verified by the driver).** The driver claimed \"162 of 206 bank refs point at absent files\" after checking `ComfyUI/models/TTS`. **That is the wrong root.** Refs resolve through `_otr_audio_engines/base.resolve_voice_ref_path` to the MIGRATED models root `C:/ComfyUI-Models/TTS`, where every local reference exists. Proven: `vz_donor_glenn.wav` is on disk there (882 KB) and its SHA256 `c8679a09eff572aa9b564181b18e87525f5b18f290342032b014d30176ae946c` matches the bank's own `ref_sha256` byte for byte. Chain: `OTRVoiceNodeBase._render_per_line` -> `_resolve_clone_ref_path` -> `_resolve_ref_to_disk` -> `resolve_voice_ref_path` -> `IndexTTS2Engine.generate_voice` -> `_resolve_ref` -> `scripts/_otr_indextts2_worker.py` -> `tts.infer(spk_audio_prompt=...)`, and the worker `os.path.exists()`-checks before inference. **So nothing falls back, the reference IS applied, and the fail-closed contract was never violated.** Retracted with it: the claim that ELLIE PALMER's voice was undefined behaviour from a missing file -- she was correctly rendered on Glenn, who is simply a high-pitched male (operator, by ear).\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:315:- **THE ROOT IS THEREFORE CONFIRMED AS THE SEED, NOT THE REFERENCE.** `_otr_resolved_request` reduces `stable_line_seed` per LINE, and `_otr_voice_node_common` derives the engine seed from it -- so a zero-shot model re-samples its latent speaker identity on every line while conditioned on the same reference. Candidate fix from the agy lane, sound in shape: derive the engine seed from CHARACTER identity (`char_id` + `episode_seed`) instead of the line, locking identity across a character's dialogue while the text still supplies prosodic variation, and fixing all cloning engines at once with no worker changes.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:316:- **STILL NEEDS A PANEL BEFORE CODE:** (1) it is a genuine fork -- pinning the seed may FLATTEN the per-line emotional range `alpha=1.0` currently buys; (2) it breaks byte-for-byte reproducibility of shipped episodes, so it must ride an `engine_impl_version` / profile bump rather than silently changing replay.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:317:- **(superseded) DO NOT confuse with the missing-file question.** `vz_donor_glenn.wav` is NOT present under `models/TTS/refs/indextts2/` (162 of 206 bank refs point at absent files), yet IndexTTS2 -- which is explicitly fail-closed, `missing_ref_fallback = None` -- rendered audio for it anyway. **Unexplained, and it must be resolved before this fix is designed:** something maps that id to a real file, and until it is found we cannot say whether a drifted line fell back to a default voice or merely re-rolled the same one. That resolver hunt is the first task, not the fix.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:318:- bible-worthy: LIKELY -- \"identity conserved in the assignment but re-rolled in the synthesis\" is a reusable class. Do not promote before a fix.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:325:- **OPERATOR RULING 2026-08-17: this IS a bug.** In his words: *\"only Lemmy should get Lemmy voice\"*. (In the same message he ruled that the ANNOUNCER's male/female voice split is NOT a bug -- it is a deliberate 50-50 and the announcer shows no portrait -- so do not file that.)\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:326:- **root cause: FOUND AND FIXED. The cameo reference sat in the ordinary `char_voice` pool like any other row, so the seeded draw could hand it to anybody.** Fixed in `8f3c7615` (2026-08-17 07:21): `reserved_voice_ref_ids()` derives the reserved set FROM THE POLICY -- every `local_wav` Lemmy route on any engine -- and `assign_voice_for_slot` drops those ids from the candidate pool. Derived, never a hand-kept list, so adding a route reserves it for free. Only clones of his OWN recording are reserved; the catalogue voices he merely borrows (`bm_george`, `el_daniel`, `gt_algenib`) stay castable, because pulling the preferred announcer out of the pool to protect a cameo would trade one defect for another. The policy path is untouched, so reserving cannot starve Lemmy of his own voice.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:327:- **verified 2026-08-18, three ways.** (1) CORPUS: across the 15 most recent episodes with a cast ledger, exactly two rows put a Lemmy-owned ref on a non-Lemmy character -- `kinetic_motion_clause_live_test` (05:01) and `rivers_embrace` (23:30), **both 2026-08-17**. Every episode from 2026-08-18 onward is clean. (2) SELECTOR: `tests/test_lemmy_voice_stays_reserved.py` sweeps 480 seeded draws across both genders and no reserved reference ever reaches a character slot; it also proves the reserved row IS in the unfiltered pool, so the test cannot pass for the wrong reason. (3) OPERATOR, unprompted 2026-08-18: *\"i do feel we have been seeing the right amount of lemmy to be honest\"*.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:328:- ~~**WHY THE LEAK WAS SEEN 16 HOURS AFTER THE FIX, and it is not a code defect.**~~ **THIS PARAGRAPH WAS WRONG AND IS STRUCK 2026-08-18 NIGHT.** It read: the soak harness never tears its server down, so an evening leg was still executing the module Python loaded that morning, and *\"a stale resident process explains a post-fix sighting without the fix being wrong\"*. The resident-server trap is real and documented (CLAUDE.md section 5) -- **it simply is not what produced this row.**\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:329:- **RE-OPENED AND COMPLETED 2026-08-18 NIGHT: THE 08-17 FIX COVERED ~4% OF PRODUCTION CASTING.** `reserved_voice_ref_ids()` was applied in exactly one place, `assign_voice_for_slot`. But `hybrid_voice_fit_enabled()` (`_otr_casting.py:896`) is **default-ON**, so the live path is: the LLM is shown `build_voice_cards()`, proposes one id, `validate_voice_proposal()` checks it, and `cast_lock.py:884-906` stamps the accepted id and `continue`s -- **never reaching the selector at all**. Measured across 1711 ledgers: **1871 rows stamped from an accepted proposal against 82 fallbacks**. Neither the card builder nor the validator knew reserved ids existed.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:330:- **AND THE ORDERING MADE IT WORST-CASE.** Cards are sorted alphabetically by `voice_ref_id` and capped at 12, so `idx_lemmy_algenib_cockney_v1` sorted FIRST among indextts2 male entries and was handed to the model as **CARD #1 on every male slot**, the position a model favours most.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:331:- **THE CORPUS NUMBERS, STATED SO THEY RECONCILE** (a QA pass caught the first draft implying 20 + 5 = 21). Three different populations: the LLM proposed a reserved id **21 times and it was accepted 21 times**; **18** of those accepted proposals became a final cast row. Separately, **25 cast rows in total carry a reserved id** = **5 legitimate LEMMY rows** + **20 leaks** onto DON PEDRO, MARCELLUS, BANQUO, FLETCHER CORBEN, STARBUCK, FERDINAND, MOE GORDON, Dr. Alexei Petrov and others. Of the 20 leaks, **18 came through the hybrid path and 2 did not** -- and that 2 is not noise, it is the fingerprint of the THIRD pool below.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:381:- surfaced: live acceptance leg 2026-08-17, `scripts/otr_writer_bank_gate.py --banks public_domain --acts 1` on code `b45c5577`, RESULT SUCCESS; episode `signal_lost_the_blackwood_enigma_20260817_172553`. Found by the item-F acceptance leg the operator authorised, not by review.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:382:- symptom: the opening announcer line says *\"Tonight, from the cluttered confines of an office, we gather for 'The Adventure of the Purloined Paper' ...\"*. **That work does not exist.** The adapted source is `Nonsense Novels` by Stephen Leacock (unit *\"Maddened by Mystery, or The Defective Detective\"*), and the EPISODE title is `The Blackwood Enigma`. So the announcer names a THIRD string that is neither the source nor the episode -- a frame/content contradiction on the lane where fidelity outranks arc. The closing coda is CORRECT: *\"Tonight's tale was adapted from Nonsense Novels, by Stephen Leacock.\"*\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:383:- root cause: NOT a threading failure -- item F's fix worked and the fact was delivered. Verified by replaying the shipped ledger through the real code: `identity_from_meta(meta).work_title == \"Nonsense Novels\"`, `source_kind == \"public_domain\"` which IS in `ADAPTATION_SOURCE_KINDS`, so the writer passed it and `_work_line` renders `WORK: a scene from Nonsense Novels` into the prompt. `meta.announcer_intro_rewrite == \"announcer_intro_rewritten\"`, so the second producer wrote this line and it also receives the title. **The model was given the right work and named a different one.** Open question for the panel: whether an obscure collection title (\"Nonsense Novels\") invites invention where a famous one (\"The Tempest\") does not -- the shakespeare leg on the same commit named its work correctly.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:384:- fix: NONE YET, deliberately. This is a design question, not a threading bug, and guessing at seam wording is the mechanism item F already proved unreliable -- that seam has said *\"invent none\"* the whole time.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:385:- verify idea: assert the opening announcer line names the `work_title` the ledger carries, OR names no work at all -- never a third string. Cheap and deterministic against a shipped ledger. Note the existing `tests/test_cross_play_frame_leak.py` CANNOT catch this: it detects names belonging to OTHER manifest rows, and an invented title belongs to none -- the exact residue that file's docstring says the live leg is for.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:386:- bible-worthy: LIKELY YES, but a DIFFERENT class from `11.61` -- that entry is \"the fact never reached the prompt\"; this is \"the fact reached the prompt and the model overrode it\", i.e. supplying material is necessary and not sufficient. Do not promote until there is a fix to claim.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:387:- promotion: PENDING\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:388:- status: OPEN\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:389:\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:390:## PBUG-20260817-03 -- another character's NAME pasted into a character_description\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:391:- surfaced: published ledger on disk, `signal_lost_midnight_circuit_20260803_162229_ledger.json` (found 2026-08-17 while measuring item G; verified by the driver reading the ledger, not inferred)\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:392:- symptom: RICK STEINER's `character_description` opens *\"Late 50s, Seasoned yet vulnerable LUCILLE PENNY. Face: Oval, knitted brows...\"* -- i.e. it carries a DIFFERENT cast member's name, and the face/detail prose that follows belongs to her. A second instance was reported in the same sweep (OYA SATO carrying Hank Griswold's), not independently re-read.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:393:- root cause: **MEASURED 2026-08-17 (second window), no longer unknown -- TWO NAMING AUTHORITIES, resolved inside a prompt.** The pitch names the characters (`meta.source_meta.selected_concept.cast[].name` = LUCILLE PENNY, HAROLD 'HAL' BRIGHT) and that text is restated in `meta.news.casting_brief` (*\"We need a seasoned yet vulnerable LUCILLE PENNY...\"*). The cast pool then assigns DIFFERENT names (RICK STEINER, NIA PHILBIN). `_otr_casting.build_description_prompt` puts the brief on the `Story:` line and the assigned name on the `Name:` line **with no statement of which wins**, and its own CHARACTER VISUAL CONTRACT format reserves a free-text slot right after the age band (`\"<age decade>, <story-linked role>. Face: ...\"`). The model fills that slot with the brief's NAME -- a plausible reading of \"story-linked role\" when the story text keeps naming people. The prior-cast theory is DISPROVEN: LUCILLE PENNY is not a cast row in that episode or anywhere in the 1,710-ledger corpus, so `_format_prior_entry` cannot be the path.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:394:- fix: **ROOT-FIXED AND LIVE-VERIFIED.** Item I shipped the shared name-authority boundary first. The 2026-08-21 `media_archive` extension then added structured `upstream_identity_names` at the interpreter, validated the optional field coherently on both shared payload surfaces, and merged it into that existing boundary without mining prose. Frozen v1 results may omit the key; a fresh v2 response must state it explicitly (including `[]`) so the path cannot default into another no-op. The finished-diff review found that explicit-key gap; it was fixed before acceptance. Historical artifacts remain frozen -- no backrepair.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:395:- verify idea: **CORRECTED -- the original idea here was wrong and would not have caught this episode.** It read *\"assert no `character_description` contains the `name` of any OTHER row in the same cast\"*. Measured over all 1,710 ledgers, that check is wrong in BOTH directions: it returns 47 hits of which roughly 45 are legitimate relational prose (*\"foil to the Time Traveler\"*, *\"Rosalind's loyal best friend\"*), and it does NOT flag `signal_lost_midnight_circuit` at all, because LUCILLE PENNY is nobody's cast row. **The check that works is ENSEMBLE-FOREIGN:** flag a `character_description` containing a proper name that NO cast row owns, sourced from the pitch cast. Measured: **28 rows across 20 of the 124 pitch-bearing ledgers (16%)**, and it flags exactly the two known-bad rows in the reported episode. Extend the same assertion to `meta.visual_plan.characters[NAME].portrait_prompt`, which carries the contaminated string verbatim -- the portraits were painted from the wrong person's face.\r\n  C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_BUG_LOG.md:396:- scale + blast radius: **28 rows / 20 ledgers is a FLOOR, not a total, and the scoping matters.** That count comes from the pitch-cast detector, which can only see the 124 of 1,710 ledgers that recorded `selected_concept.cast`. A second, independent name-shape detector flags **18 rows / 14 ledgers** and its set is NOT the same -- it catches `signal_lost_the_wax_cylinders_whisper_20260805_102216` (OYA SATO <- *\"30s, Henry 'Hank' Griswold.\"*) and `signal_lost_nightshift_erasure_20260809_115705` (RYAN KAPOOR <- *\"60s, EDWARD 'ED' GRISWOLD.\"*), which the pitch detector misses, while missing LUCILLE PENNY, which the pitch detector catches. **So the operator's second reported instance is CONFIRMED**, and the true census is the union of the two, which is not yet computed -- that is item I's job, not this promotion's. Most recent hit `signal_lost_lemmy_provisional_tier_kokoro_acceptance_20260816_210751` (2026-08-16), so this is **live at HEAD, not a retired regime** -- the distinction that separates it from item G. Gender-crossed in both directions (RICK STEINER male <- LUCILLE PENNY; WENDY PALMER female <- SIR REGINALD PENNYWORTH), which is why it accounts for part of item G's portrait-conflict count. Note also that the contamination survives a FREEZE: `baked_ledger.json` carries the RYAN KAPOOR row verbatim in fourteen copies.\r\n> C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\docs\\PROD_B