 >= 3}, key=len,\r\n  365:                         reverse=True):\r\n  366:         out = re.sub(r\"\\b%s\\b\" % re.escape(token), \" \", out,\r\n  367:                      flags=re.IGNORECASE)\r\n  368:     return _norm(out)\r\n  369: \r\n  370: \r\n  371: def sanitize_intent(beat_intent, names=()) -> str:\r\n  372:     \"\"\"The one free-text field the model sees, made safe and lower case.\r\n  373: \r\n  374:     Names removed, field labels removed, second person removed, punctuation\r\n  375:     normalized, and the result bounded. It is a HINT about what happens in the\r\n  376:     beat, never a sentence to copy -- v1's whole defect was copying it.\r\n  377:     \"\"\"\r\n  378:     text = strip_cast_names(beat_intent, names)\r\n  379:     text = _FIELD_LABEL_RE.sub(\" \", text)\r\n  380:     text = _SECOND_PERSON_RE.sub(\" \", text)\r\n  381:     text = text.replace(\"\\r\", \" \").replace(\"\\n\", \" \")\r\n  382:     text = re.sub(r'[\"`]+', \" \", text)\r\n  383:     text = _norm(text).lower().strip(\" ,;:.-\")\r\n  384:     words = text.split()\r\n  385:     if len(words) > 24:\r\n  386:         text = \" \".join(words[:24])\r\n  387:     return _norm(text)\r\n  388: \r\n  389: \r\n  390: def normalize_emotion(traits) -> str:\r\n  391:     \"\"\"The beat's recorded mood as one short lower-case phrase, or ``\"\"``.\"\"\"\r\n  392:     text = _norm(traits).lower().strip(\" ,;:.-\")\r\n  393:     if not text:\r\n  394:         return \"\"\r\n  395:     text = text.split(\",\")[0].strip()\r\n  396:     words = text.split()\r\n  397:     return \" \".join(words[:3])\r\n  398: \r\n  399: \r\n  400: def map_arc(arc_phase) -> str:\r\n  401:     \"\"\"A mapped arc cue, or ``\"\"`` when the value carries no visual meaning.\"\"\"\r\n  402:     return GHOST_ARC_CUES.get(_norm(arc_phase).lower(), \"\")\r\n  403: \r\n  404: \r\n  405: # --------------------------------------------------------------------------- #\r\n  406: # Deterministic mode scheduling.\r\n  407: # --------------------------------------------------------------------------- #\r\n  408: \r\n  409: def _hash_int(*parts) -> int:\r\n  410:     payload = \"|\".join(str(p) for p in parts)\r\n  480:     with pytest.raises(gsa.GhostAuthorValidationError):\r\n  481:         gsa.validate_ghost_prompt_object(obj)\r\n  482: \r\n  483: \r\n  484: def test_a_fallback_must_carry_its_reason_and_a_writer_row_must_not():\r\n  485:     \"\"\"This is what stops a reuse laundering a fallback into proof.\"\"\"\r\n  486:     with pytest.raises(gsa.GhostAuthorValidationError):\r\n  487:         gsa.build_ghost_prompt_object(_spec(), \"the clasp turns slowly here\",\r\n  488:                                       source=\"deterministic_fallback\")\r\n  489:     with pytest.raises(gsa.GhostAuthorValidationError):\r\n  490:         gsa.build_ghost_prompt_object(_spec(), \"the clasp turns slowly here\",\r\n  491:                                       source=\"writer_llm\",\r\n  492:                                       fallback_reason=\"why\")\r\n  493:     assert gsa.build_ghost_prompt_object(\r\n  494:         _spec(), \"the clasp turns slowly here\",\r\n  495:         source=\"deterministic_fallback\", fallback_reason=\"no model\")\r\n  496: \r\n  497: \r\n  498: # --------------------------------------------------------------------------- #\r\n  499: # 8. The deterministic batch -- complete clauses, never a slice.\r\n  500: # --------------------------------------------------------------------------- #\r\n  501: \r\n  502: def _timeline_specs(seed=1013426535):\r\n  503:     modes = gsa.schedule_ghost_modes(TIMELINE, seed)\r\n  504:     comp = _components()\r\n  505:     rows = []\r\n  506:     for beat_id, role in TIMELINE:\r\n  507:         mode = modes[beat_id]\r\n  508:         motif = (gsa.motif_for_character(comp, mode, seed_int=comp[\"seed_int\"])\r\n  509:                  if role == \"character_video\"\r\n  510:                  else gsa.motif_for_bookend(role, mode))\r\n  511:         rows.append({\"beat_id\": beat_id, \"role\": role, \"mode\": mode,\r\n  512:                      \"motif_cue\": motif, \"sanitized_intent\": \"\",\r\n  513:                      \"normalized_emotion\": \"\", \"mapped_arc\": \"\"})\r\n  514:     return gsa.build_ghost_author_specs(rows, model_id=\"m/x\")\r\n  515: \r\n  516: \r\n  517: def test_every_deterministic_clause_is_unique_within_an_episode():\r\n  518:     for seed in (1013426535, 7, 999999):\r\n  519:         specs = _timeline_specs(seed)\r\n  520:         batch = gsa.deterministic_batch(specs, episode_seed=seed)\r\n  521:         assert len(set(batch.values())) == len(batch), seed\r\n  522: \r\n  523: \r\n  524: def test_the_opening_and_closing_bookends_differ():\r\n  525:     specs = _timeline_specs()\r\n  526:     batch = gsa.deterministic_batch(specs, episode_seed=1013426535)\r\n  527:     assert batch[\"g000\"] != batch[specs[-1][\"id\"]]\r\n  528: \r\n  529: \r\n  530: def test_every_deterministic_clause_is_a_complete_valid_leaf():\r\n  531:     specs = _timeline_specs()\r\n  532:     batch = gsa.deterministic_batch(specs, episode_seed=1013426535)\r\n  533:     for spec in specs:\r\n  534:         ok, why = gsa.validate_drawable_beat(\r\n  535:             batch[spec[\"id\"]], mode=spec[\"mode\"], names=NAMES)\r\n  536:         assert ok, (spec[\"mode\"], batch[spec[\"id\"]], why)\r\n  537: \r\n  538: \r\n  539: def test_no_free_text_ever_reaches_a_deterministic_clause():\r\n  540:     \"\"\"The pools are checked in; there is no extraction surface left.\"\"\"\r\n  541:     pool = {c for group in gsa.GHOST_FALLBACK_CLAUSES.values() for c in group}\r\n  542:     pool |= set(gsa.GHOST_FALLBACK_BOOKENDS.values())\r\n  543:     specs = _timeline_specs()\r\n  544:     batch = gsa.deterministic_batch(specs, episode_seed=1013426535)\r\n  545:     assert set(batch.values()) <= pool\r\n  546: \r\n  547: \r\n  548: # --------------------------------------------------------------------------- #\r\n  549: # 9. Composition, banana and the measured window.\r\n  550: # --------------------------------------------------------------------------- #\r\n  780: \r\n  781: def test_a_clock_hand_is_not_a_person():\r\n  782:     \"\"\"A live batch died on this, twice, and dropped an episode to fallback.\r\n  783: \r\n  784:     `_HUMAN_WORDS` used to carry hand/arm/shoulder, so\r\n  785:     \"the silver ledger sits on a desk as a clock hand ticks\" was rejected as\r\n  786:     \"requests a person in object mode\" -- and because one bad leaf rejects the\r\n  787:     WHOLE batch, the episode fell to deterministic clauses over a clock.\r\n  788: \r\n  789:     What object/signal owe is that no FULL FIGURE dominates the shot. They do\r\n  790:     not owe a frame with no body part anywhere in it.\r\n  791:     \"\"\"\r\n  792:     for leaf in (\"the silver ledger sits on a desk as a clock hand ticks\",\r\n  793:                  \"the radio dial turns as a hand adjusts the knob\",\r\n  794:                  \"the lamp tilts and a shoulder passes through the light\"):\r\n  795:         for mode in gsa.GHOST_NON_FIGURE_MODES:\r\n  796:             ok, why = gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)\r\n  797:             assert ok, (mode, leaf, why)\r\n  798: \r\n  799: \r\n  800: def test_a_whole_person_is_still_refused_outside_figure_mode():\r\n  801:     \"\"\"The rule still means what it is for.\"\"\"\r\n  802:     for leaf in (\"a man walks past the console in the dark\",\r\n  803:                  \"a figure leans over the desk and goes still\",\r\n  804:                  \"a woman turns the dial slowly in the dark\"):\r\n  805:         for mode in gsa.GHOST_NON_FIGURE_MODES:\r\n  806:             ok, why = gsa.validate_drawable_beat(leaf, mode=mode, names=NAMES)\r\n  807:             assert not ok, (mode, leaf)\r\n  808:             assert \"person\" in why\r\n  809:         assert gsa.validate_drawable_beat(leaf, mode=\"figure\", names=NAMES)[0]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$i=0; Get-Content -LiteralPath '\"'kibitz-runs\\\\2026-08-22-2026-08-22-ghost-prompt-v21\\\\r2\\\\input.md' | ForEach-Object { \"'$i++; '\"'{0,4}: {1}' -f \"'$i,$_ }; $i=0; Get-Content -LiteralPath '\"'docs\\\\2026-08-22-ghost-prompt-v2-publish-receipt.md' | ForEach-Object { \"'$i++; if($i -ge 213 -and $i -le 312){'\"'{0,4}: {1}' -f \"'$i,$_}}'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$i=0; Get-Content -LiteralPath '\"'kibitz-runs\\\\2026-08-22-2026-08-22-ghost-prompt-v21\\\\r2\\\\input.md' | ForEach-Object { \"'$i++; '\"'{0,4}: {1}' -f \"'$i,$_ }; $i=0; Get-Content -LiteralPath '\"'docs\\\\2026-08-22-ghost-prompt-v2-publish-receipt.md' | ForEach-Object { \"'$i++; if($i -ge 213 -and $i -le 312){'\"'{0,4}: {1}' -f \"'$i,$_}}'","aggregated_output":"   1: # Driver anchor -- Ghost Prompt v2.1, one scoped round\r\n   2: \r\n   3: **Driver:** Claude (Cowork), sole judge. **Round:** ONE, at the operator's\r\n   4: instruction -- this is NOT a four-round arc and must not be reported as one.\r\n   5: **Repo:** `C:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio`,\r\n   6: branch `v2.0-alpha`, HEAD `d1ab7037`.\r\n   7: \r\n   8: Everything below is checkable against the real Windows files. Check it. I want\r\n   9: the claims that are wrong named, not agreed with.\r\n  10: \r\n  11: ## What happened, in order\r\n  12: \r\n  13: 1. **Ghost Prompt v2 shipped** (`a8fad82c`). The Ghost Signal video lane\r\n  14:    (AnimateDiff SD1.5) had a real text defect: `resolve_action()` copied the\r\n  15:    first six regex words of an unmapped free-text `beat_intent` after the\r\n  16:    literal `moves with`, which put CAST NAMES in the picture and ended\r\n  17:    mid-clause. Proven against a published render and hash-matched 8/8 from the\r\n  18:    pre-change composer.\r\n  19: 2. v2 replaced it with \"controlled abstraction\": a Python-owned recurrence\r\n  20:    motif plus ONE short LLM-authored drawable leaf per beat, three\r\n  21:    representations (`figure`/`object`/`signal`), the model never seeing\r\n  22:    dialogue, title, M4 wall, cast prose or names.\r\n  23: 3. **Every gate passed and the pictures got worse.** Suite 12225 green, token\r\n  24:    window measured, control vector exact, three episodes published. The\r\n  25:    operator watched them and said the AnimateDiff output had tanked.\r\n  26: 4. **He was right.** Counting recognisable subjects at frame 40 of every beat:\r\n  27:    v1 archival 4/4 sampled; v2 archival with LLM leaves 2/8; v2 deterministic\r\n  28:    0/4; v2 anime 0/8. The two v2 survivors are the only beats whose leaf named\r\n  29:    a real object (a lantern, a radio dial).\r\n  30: 5. **v2.1** (`f6075592`, `633e68a7`) put concrete nouns back. Re-rendered with\r\n  31:    real LLM leaves: **6/8 recognisable, 2 human figures**.\r\n  32: \r\n  33: ## The claim I want attacked\r\n  34: \r\n  35: **Legibility tracks concrete nouns, and nothing else.** v1 handed SD1.5\r\n  36: `\"a man, a broad steady figure, a charcoal coat, holding a folded chart\"`.\r\n  37: v2 handed it `\"charcoal ledger emblem\"` plus\r\n  38: `\"an abstract signal field filling the composition\"`. A 512x288 SD1.5 obliges by\r\n  39: painting texture.\r\n  40: \r\n  41: v2.1 therefore: mode laws name a physical thing; the motif is the prop itself\r\n  42: (`a charcoal lantern`, not `charcoal lantern emblem`); `figure` says FIGURE and\r\n  43: wears a garment; bookends name real radio hardware; `GHOST_CHARACTER_CYCLE` is\r\n  44: `figure/object/figure/signal` so half the character beats show a person; a leaf\r\n  45: naming a texture (static, waveform, gradient, noise, grain) is rejected.\r\n  46: \r\n  47: **Is that diagnosis right, or did something else cause the regression?**\r\n  48: Alternatives I have NOT ruled out and want tested: the prompts also got SHORTER\r\n  49: (208-317 chars down to 164-203); the negative prompt is unchanged but its\r\n  50: relative weight against a shorter positive is not; the mode laws add three\r\n  51: trailing clauses that may dilute the subject; `video_art` and `anime` packs may\r\n  52: simply be abstract by design and unfairly counted.\r\n  53: \r\n  54: ## Read these\r\n  55: \r\n  56: * `nodes/_otr_video_engines/ghost_signal_author.py` -- `GHOST_CHARACTER_CYCLE`,\r\n  57:   `motif_for_character`, `_ABSTRACT_SUBJECT_WORDS`, `_HUMAN_WORDS`,\r\n  58:   `validate_drawable_beat`, `GHOST_FALLBACK_CLAUSES`, `GHOST_BATCH_RULES`.\r\n  59: * `nodes/_otr_video_engines/ghost_signal_prompt.py` -- `GHOST_MODE_LAWS_V2`,\r\n  60:   `compose_ghost_prompt_v2`.\r\n  61: * `docs/2026-08-22-ghost-prompt-v2-publish-receipt.md` section 4A.\r\n  62: \r\n  63: ## Specific questions\r\n  64: \r\n  65: 1. **`_HUMAN_WORDS` was cut on live evidence.** It carried\r\n  66:    hand/arm/shoulder and rejected `\"the silver ledger sits on a desk as a clock\r\n  67:    hand ticks\"` -- a CLOCK hand -- killing all eight beats twice because one bad\r\n  68:    leaf rejects the whole batch. I removed body parts and kept\r\n  69:    person/people/man/woman/boy/girl/child/crowd/figure/silhouette/face/portrait/\r\n  70:    someone. **Is that set now too permissive for `object`/`signal`?** \"a\r\n  71:    shoulder passes through the light\" now passes in object mode. Is that right?\r\n  72: 2. **Whole-batch rejection.** One bad leaf costs all eight beats and two\r\n  73:    generations. It is deliberate (no partial salvage across attempts, so an\r\n  74:    episode's prompts are not a function of how many tries each row took). Given\r\n  75:    it has now twice dropped an episode to fallback over ONE leaf, is the\r\n  76:    trade still correct, or should a single row be re-asked?\r\n  77: 3. **`GHOST_CHARACTER_CYCLE` is period 4 with `figure` twice.** Check the\r\n  78:    collision-correction interaction in `schedule_ghost_modes`: bookends\r\n  79:    alternate `object`/`signal` from their own offset and only a BOOKEND is ever\r\n  80:    flipped. Can any seed produce a run of three, or starve `figure` below half?\r\n  81: 4. **The abstract-word reject list.** `static`, `waveform`, `gradient`,\r\n  82:    `texture`, `noise`, `grain`, `geometry`, `scanlines`, `interference`. Does\r\n  83:    any of these have a legitimate concrete use a beat would want -- \"grain\" in\r\n  84:    an archival pack, say -- and would rejecting it cost a good leaf?\r\n  85: 5. **Anything in `ghost_signal_author.py` that is simply a bug.** Hash key set,\r\n  86:    parser, tokenizer measurement, fallback collision probing.\r\n  87: \r\n  88: Be specific, cite file:line, and prefer \"I could not verify X\" to a confident\r\n  89: guess. Do not restate the design back to me.\r\n 213: ## 4A. THE OPERATOR WATCHED IT AND IT HAD TANKED THE PICTURES\r\n 214: \r\n 215: **This section exists because everything above it was true and still added up to\r\n 216: a worse show.** Sections 1-4 record a clean build: the text defect was real, the\r\n 217: fix was measured, the control vector was exact, the suite was green and three\r\n 218: episodes published. Then the operator watched them and said the AnimateDiff\r\n 219: winners had tanked. He was right, and nothing in the receipt above would have\r\n 220: told him so -- every gate this sprint passed was a gate on TEXT.\r\n 221: \r\n 222: ### What the pixels say\r\n 223: \r\n 224: Counting recognisable subjects, frame 40 of every beat, all five arms:\r\n 225: \r\n 226: | arm | recognisable | what is actually on screen |\r\n 227: |---|---:|---|\r\n 228: | v1 prompts, `video_art` (the one he remembers as the winner) | **4 human figures** + 4 vivid abstracts | a man standing in a gallery, a figure in motion, a capped silhouette, a dancer |\r\n 229: | v1 prompts, `archival` | **4 of 4** | a period radio set, a figure at a lectern, a document, a tuning dial |\r\n 230: | v2, LLM leaves, `archival` | 2 of 8 | a lantern on a post, a dial -- the rest is texture |\r\n 231: | v2, deterministic, `archival` | 0 of 4 sampled | stripes, static, black blobs |\r\n 232: | v2, LLM leaves, `anime` | **0 of 8** | pattern noise, no subject anywhere |\r\n 233: \r\n 234: ### The mechanism, and it is falsifiable\r\n 235: \r\n 236: Legibility tracks **how much concrete noun is in the prompt**, and nothing else.\r\n 237: The two v2 beats that survived are the only two whose authored leaf named a real\r\n 238: object -- a lantern and a radio dial. Every mush beat named `emblem`, `signal`,\r\n 239: `field` or `waveform`.\r\n 240: \r\n 241: v1 handed SD1.5 *\"a man, a broad steady figure, a charcoal coat, holding a\r\n 242: folded chart\"* and got a man in a coat. v2 handed it *\"charcoal ledger emblem\"*\r\n 243: plus *\"an abstract signal field filling the composition\"*, and a 512x288 SD1.5\r\n 244: obliged by painting texture. **The mode laws were literally instructions toward\r\n 245: abstraction.**\r\n 246: \r\n 247: ### The honest self-assessment\r\n 248: \r\n 249: Two changes shipped where only one was needed. Removing the name leak and the\r\n 250: mid-clause fragment was right and that machinery is untouched. Replacing the\r\n 251: CONCRETE SUBJECT with an abstract one was a separate, unforced change, and it is\r\n 252: what broke the pictures. The plan's premise -- *prefer abstract coolness over\r\n 253: rigid character likeness* -- was the operator's call and remains reasonable; what\r\n 254: this lane proved is that on THIS model, abstraction without a noun is not cool,\r\n 255: it is mush.\r\n 256: \r\n 257: **No gate in this sprint could have caught it, and that is the transferable\r\n 258: lesson.** Every check was on the text: token count, character count, name\r\n 259: absence, dangling tails, component survival. All of them passed. A prompt lane's\r\n 260: acceptance needs at least one countable question about the PICTURE.\r\n 261: \r\n 262: ### v2.1 -- what was changed (`f6075592`, `633e68a7`)\r\n 263: \r\n 264: * mode laws name a physical thing: an object on a real surface, an object lit\r\n 265:   against a dark room. No more \"abstract field filling the composition\".\r\n 266: * the motif is the prop ITSELF -- `a charcoal lantern`, not\r\n 267:   `charcoal lantern emblem`. An emblem is not a thing.\r\n 268: * `figure` says FIGURE and wears a garment. SD1.5 does not know a \"silhouette\"\r\n 269:   is meant to be somebody; handed one it drew vertical black shapes.\r\n 270: * bookends name real radio hardware: a bakelite radio set, a spinning turntable.\r\n 271: * `GHOST_CHARACTER_CYCLE` is figure/object/figure/signal -- half the character\r\n 272:   beats show a person again. The even three-mode cycle made two of every three\r\n 273:   non-figurative and the episode lost its people. This still honours *\"do not\r\n 274:   force the same mediocre person into every clip\"*.\r\n 275: * a leaf naming a texture (static, waveform, gradient, noise, grain) is rejected.\r\n 276: \r\n 277: **A second live leg then caught a bug no unit test would have.** `_HUMAN_WORDS`\r\n 278: carried hand/arm/shoulder, so `object` mode rejected *\"the silver ledger sits on\r\n 279: a desk as a clock hand ticks\"* -- a CLOCK hand -- and, because one bad leaf\r\n 280: rejects the whole batch by design, that killed all eight beats twice and dropped\r\n 281: the episode to deterministic clauses. Body parts are off the list; a whole figure\r\n 282: is still refused outside `figure` mode.\r\n 283: \r\n 284: ### What is proven and what is NOT\r\n 285: \r\n 286: * **Proven:** the v2.1 concrete POOLS render subjects again. On `video_art`,\r\n 287:   roughly 3-4 of 8 beats read as a real thing (a radio set with dial-eyes, a\r\n 288:   metal object on wood, silhouetted figures) against 0-2 before.\r\n 289: * **NOW PROVEN -- the decisive arm rendered and published.** Episode\r\n 290:   `signal_lost_echoes_unheard_20260822_202248`, v2.1 on `archival_documentary`,\r\n 291:   `writer_llm=8` with zero fallback and zero replay, `RESULT SUCCESS` +\r\n 292:   `obs_publish OK`, 23:24.\r\n 293: \r\n 294:   **6 of 8 beats render a recognisable subject and 2 of them are people** --\r\n 295:   piano keys, a lit chain, a person in a white coat, a coil of cream rope on a\r\n 296:   wooden table, a man walking a street with a second figure behind him, a radio\r\n 297:   set on a shelf. Two stay weak (a cabinet, a warm gradient).\r\n 298: \r\n 299:   | arm | recognisable | figures |\r\n 300:   |---|---:|---:|\r\n 301:   | v1 prompts, archival | 4 of 4 sampled | some |\r\n 302:   | v2 prompts, archival, LLM leaves | 2 of 8 | 0 |\r\n 303:   | **v2.1 prompts, archival, LLM leaves** | **6 of 8** | **2** |\r\n 304: \r\n 305:   **Beat 5 is the end-to-end proof.** gemma wrote *\"a hand grabs the cream rope\r\n 306:   on the wooden table\"* and the render is a coil of cream rope on a wooden\r\n 307:   table. That leaf is exactly what the pre-fix `_HUMAN_WORDS` rejected as \"a\r\n 308:   person in object mode\", so the frame exists only because the clock-hand fix\r\n 309:   landed. And the hygiene v2 was built for is intact: no cast name in the\r\n 310:   picture, no sentence cut mid-clause, every prompt measured at one CLIP\r\n 311:   window.\r\n 312: \r\n","exit_code":0,"status":"completed"}}
