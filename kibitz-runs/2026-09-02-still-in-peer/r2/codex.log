ailability(profile, declarations)`` -> the shared availability object\r\n   21:     with one reason code per engine (reused by validator / wizard / logs);\r\n   22:   * ``enabled_engines`` = engines whose declarations fit the profile;\r\n   23:   * ``cross_validate_profile`` -- every profile override must be in the\r\n   24:     enable-set of its namespace (per-engine fit ONLY; NO static co-residency\r\n   25:     rejection -- residency is wrapper_bridge's runtime invariant).\r\n   26: \r\n   27: Dependency-free: stdlib ``json``/``os``/``typing`` only. Importing this module\r\n   28: pulls in no torch / comfy / model framework (V-12 cold-import clean).\r\n   29: \"\"\"\r\n   30: from __future__ import annotations\r\n   31: \r\n   32: import json\r\n   33: import os\r\n   34: from typing import Any, Optional\r\n   35: \r\n   36: __all__ = [\r\n   37:     \"ProfileError\",\r\n   38:     \"PROFILE_DIR\",\r\n   39:     \"load_profile\",\r\n   40:     \"load_widget_mapping\",\r\n   41:     \"validate_profile_shape\",\r\n   42:     \"validate_widget_mapping_shape\",\r\n   43:     \"availability\",\r\n   44:     \"enabled_engines\",\r\n   45:     \"cross_validate_profile\",\r\n   46: ]\r\n   47: \r\n   48: _REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\n   49: PROFILE_DIR = os.path.join(_REPO_ROOT, \"config\", \"profiles\")\r\n   50: WIDGET_MAPPING_PATH = os.path.join(PROFILE_DIR, \"widget_mapping.json\")\r\n   51: \r\n   52: \r\n   53: class ProfileError(ValueError):\r\n   54:     \"\"\"A profile / mapping file failed validation. FAIL CLOSED -- the caller\r\n   55:     must not proceed with a half-understood capability policy.\"\"\"\r\n   56: \r\n   57: \r\n   58: # ---------------------------------------------------------------------------\r\n   59: # S0 -- profile shape (schema v2: platform-portability S2, 2026-07-10 --\r\n   60: # docs/2026-07-09-platform-portability-final.md section 2)\r\n   61: # ---------------------------------------------------------------------------\r\n   62: _PLATFORMS = (\"any\", \"win\", \"mac\", \"linux\")\r\n   63: _DEVICE_BACKENDS = (\"cuda\", \"cpu\", \"mps\")  # ROCm presents as \"cuda\"\r\n   64: _STATUSES = (\"shipping\", \"draft\")\r\n   65: _GPU_VENDORS = (\"nvidia\", \"amd\", \"apple\", \"none\")\r\n   66: _DTYPE_POLICIES = (\"fp8_ok\", \"no_fp8\", \"no_fp8_no_fp4\")\r\n   67: _DEVICE_POLICIES = (\"cuda\", \"cpu\", \"mps\")\r\n   68: \r\n   69: \r\n   70: def _is_positive_int(v: Any) -> bool:\r\n   71:     return isinstance(v, int) and not isinstance(v, bool) and v > 0\r\n   72: \r\n   73: \r\n   74: def _is_res_string(v: Any) -> bool:\r\n   75:     if not isinstance(v, str):\r\n   76:         return False\r\n   77:     parts = v.split(\"x\")\r\n   78:     return len(parts) == 2 and all(p.isdigit() and int(p) > 0 for p in parts)\r\n   79: \r\n   80: \r\n   81: def _is_str_list(v: Any) -> bool:\r\n   82:     return isinstance(v, list) and all(isinstance(s, str) and s for s in v)\r\n   83: \r\n   84: \r\n   85: # key -> (required, validator-callable, human description)\r\n   86: _TOP_LEVEL_KEYS: dict[str, tuple[bool, Any, str]] = {\r\n   87:     \"id\": (True, lambda v: isinstance(v, str) and bool(v), \"non-empty str\"),\r\n   88:     \"display_name\": (True, lambda v: isinstance(v, str) and bool(v), \"non-empty str\"),\r\n   89:     \"status\": (True, lambda v: v in _STATUSES, f\"one of {_STATUSES}\"),\r\n   90:     \"platform\": (True, lambda v: v in _PLATFORMS, f\"one of {_PLATFORMS}\"),\r\n   91:     \"device_backend\": (True, lambda v: v in _DEVICE_BACKENDS, f\"one of {_DEVICE_BACKENDS}\"),\r\n   92:     \"gpu_vendor\": (True, lambda v: v in _GPU_VENDORS, f\"one of {_GPU_VENDORS}\"),\r\n   93:     \"toolchains\": (True, lambda v: isinstance(v, list) and all(isinstance(t, str) for t in v), \"list[str]\"),\r\n   94:     \"allow_sidecars\": (True, lambda v: isinstance(v, bool), \"bool\"),\r\n   95:     \"role_overrides\": (True, lambda v: _is_str_dict(v), \"dict[str, str]\"),\r\n   96:     \"slot_overrides\": (True, lambda v: _is_str_dict(v), \"dict[str, str]\"),\r\n   97:     \"features\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n   98:     \"seed_policy\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n   99:     \"launch\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  100:     \"llm\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  101:     \"video\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  102:     \"image\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  103:     \"audio\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  104:     \"render\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  105:     \"preflight\": (True, lambda v: isinstance(v, dict), \"dict\"),\r\n  106:     # S5: OPTIONAL operator-ratification gate. While non-empty,\r\n  107:     # scripts/build_variants.py REFUSES to emit this profile's variant;\r\n  108:     # the operator ratifies each named decision and clears the list.\r\n  109:     \"ratify_before_emit\": (False, _is_str_list, \"list[str] (optional)\"),\r\n  110:     # Queue item 8 (2026-08-08): OPTIONAL post-render upscale/enhance stage.\r\n  111:     # Absent = registry default {engine: \"off\", device: \"cpu\"} applied by the\r\n  112:     # applier; a byte-identical no-op for every profile that omits it. Present\r\n  113:     # requires at minimum {engine: <name>}; device is optional per\r\n  114:     # _SECTION_OPTIONAL_KEYS.\r\n  115:     \"upscale_stage\": (False, lambda v: isinstance(v, dict), \"dict (optional)\"),\r\n  116: }\r\n  117: \r\n  118: _SEED_POLICY_KEYS = {\r\n  119:     \"request_seed\": lambda v: isinstance(v, int) and not isinstance(v, bool),\r\n  120:     \"seed_mode\": lambda v: isinstance(v, str) and bool(v),\r\n  121:     \"cast_seed_env\": lambda v: v is None or (isinstance(v, str) and bool(v)),\r\n  122:     \"style_seed_env\": lambda v: v is None or (isinstance(v, str) and bool(v)),\r\n  123: }\r\n  124: \r\n  125: _LAUNCH_KEYS = {\r\n  126:     \"sage_attention\": lambda v: isinstance(v, bool),\r\n  127:     \"extra_args\": lambda v: isinstance(v, list) and all(isinstance(a, str) for a in v),\r\n  128:     # v2: launch-only env vars for the generated recipe (names -> values;\r\n  129:     # secrets NEVER go here -- key NAMES belong in preflight.required_keys).\r\n  130:     \"env\": lambda v: isinstance(v, dict) and all(\r\n  131:         isinstance(k, str) and k and isinstance(val, str) for k, val in v.items()),\r\n  132: }\r\n  133: \r\n  134: # --- v2 sections -------------------------------------------------------\r\n  135: _VIDEO_KEYS = {\r\n  136:     \"device_policy\": lambda v: v in _DEVICE_POLICIES,\r\n  137:     \"dtype_policy\": lambda v: v in _DTYPE_POLICIES,\r\n  138: }\r\n  139: #: OPTIONAL video keys (2026-07-24, WAN 8GB launch contract). A tier that does\r\n  140: #: not declare one is UNPINNED -- absent behaves exactly as before, so adding a\r\n  141: #: key here never churns the other profiles.\r\n  142: #:\r\n  143: #: ``max_render_frames`` is the tier's ABSOLUTE local-video render-length\r\n  144: #: ceiling in frames (0 = unpinned = the engine's own max). It is the\r\n  145: #: profile-carried twin of ``OTR_WAN_TI2V_MAX_FRAMES``: the low-VRAM launch\r\n  146: #: contract has to reach a PRODUCTION episode leg, which is submitted to an\r\n  147: #: already-booted server and therefore never sees ``launch.env``. Distinct from\r\n  148: #: ``render.frame_budget``, which is the soak/single harness per-clip frame\r\n  149: #: count (every 16GB tier declares 25 there and must NOT be capped to it).\r\n  150: _VIDEO_OPTIONAL_KEYS = {\r\n  151:     \"max_render_frames\": lambda v: (\r\n  152:         isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 240),\r\n  153: }\r\n  154: # Queue item 8 (2026-08-08): required-if-section-present keys for upscale_stage.\r\n  155: # `engine` is required (must name a real engine); `device` is optional (see\r\n  156: # _UPSCALE_STAGE_OPTIONAL_KEYS below) so a profile writing just\r\n  157: # ``upscale_stage: {\"engine\": \"spandrel_esrgan\"}`` is legal and inherits the\r\n  158: # registry-supplied device default. Sonnet 5 MF-3.\r\n  159: _UPSCALE_STAGE_KEYS = {\r\n  160:     \"engine\": lambda v: isinstance(v, str) and bool(v),\r\n  161: }\r\n  162: _UPSCALE_STAGE_OPTIONAL_KEYS = {\r\n  163:     \"device\": lambda v: isinstance(v, str) and bool(v),\r\n  164: }\r\n  165: #: OPTIONAL launch keys (S8 boot contracts, 2026-08-11). ``boot_contract`` NAMES\r\n  166: #: the server start-up state this profile's lanes need -- see\r\n  167: #: ``nodes/_otr_shared/boot_contracts.py``. It is OPTIONAL on purpose: the key\r\n  168: #: set is closed-validated, so adding a required key here would break all ~20\r\n  169: #: shipped profiles at once, and a profile that names no contract is on the\r\n  170: #: stock ``default`` boot, which is exactly what every one of them meant before\r\n  171: #: this key existed.\r\n  172: #:\r\n  173: #: The NAME is the contract. Launchers resolve its real argv through\r\n  174: #: ``boot_contracts.launch_args_for``; ``launch.env`` remains only the Windows\r\n  175: #: headless compatibility channel for supported clamp knobs. Naming the\r\n  176: #: contract is what lets preflight compare against the running server instead\r\n  177: #: of diffing config dictionaries and guessing intent.\r\n  178: _LAUNCH_OPTIONAL_KEYS = {\r\n  179:     \"boot_contract\": lambda v: isinstance(v, str) and bool(v),\r\n  180: }\r\n  181: #: section name -> its optional-key spec (missing = no optional keys).\r\n  182: _SECTION_OPTIONAL_KEYS = {\r\n  183:     \"video\": _VIDEO_OPTIONAL_KEYS,\r\n  184:     \"upscale_stage\": _UPSCALE_STAGE_OPTIONAL_KEYS,\r\n  185:     \"launch\": _LAUNCH_OPTIONAL_KEYS,\r\n  186: }\r\n  187: _IMAGE_KEYS = {\r\n  188:     \"dtype_policy\": lambda v: v in _DTYPE_POLICIES,\r\n  189: }\r\n  190: _AUDIO_KEYS = {\r\n  191:     \"voice_device\": lambda v: v in _DEVICE_POLICIES,\r\n  192: }\r\n  193: _RENDER_KEYS = {\r\n  194:     \"fps\": _is_positive_int,\r\n  195:     \"canvas_w\": _is_positive_int,\r\n  196:     \"canvas_h\": _is_positive_int,\r\n  197:     \"composite_res\": _is_res_string,\r\n  198:     \"composite_w\": _is_positive_int,\r\n  199:     \"composite_h\": _is_positive_int,\r\n  200:     \"frame_budget\": _is_positive_int,\r\n  201:     \"beats\": _is_positive_int,\r\n  202: }\r\n  203: _PREFLIGHT_KEYS = {\r\n  204:     \"required_models\": _is_str_list,\r\n  205:     \"required_keys\": _is_str_list,\r\n  206: }\r\n  207: \r\n  208: # llm section: 8 model keys (widget-mapped 1:1 to the writer's existing\r\n  209: # model widgets) + the 7 runtime-policy fields. The runtime fields are\r\n  210: # validated by CONSTRUCTING an LLMRuntimePolicy -- ONE enum truth\r\n  211: # (nodes/_otr_shared/llm_policy.py), zero duplication.\r\n  212: _LLM_MODEL_KEYS = (\r\n  213:     \"creative_model\", \"technical_model\",\r\n  214:     \"openrouter_slot_a_model\", \"openrouter_slot_b_model\",\r\n  215:     \"comfy_slot_a_model\", \"comfy_slot_b_model\",\r\n  216:     \"google_api_slot_a_model\", \"google_api_slot_b_model\",\r\n  217: )\r\n  218: _LLM_RUNTIME_KEYS = (\r\n  219:     \"device\", \"attn_impl\", \"quant_policy\", \"vram_ceiling_gb\",\r\n  220:     \"gguf_n_ctx\", \"gguf_quant\", \"lane_allowlist\",\r\n  221: )\r\n  222: \r\n  223: \r\n  224: def _validate_llm_section(sub: Any, source: str) -> None:\r\n  225:     allowed = set(_LLM_MODEL_KEYS) | set(_LLM_RUNTIME_KEYS)\r\n  226:     unknown = set(sub) - allowed\r\n  227:     if unknown:\r\n  228:         raise ProfileError(f\"profile {source}: unknown llm key(s) {sorted(unknown)!r}\")\r\n  229:     missing = [k for k in (*_LLM_MODEL_KEYS, *_LLM_RUNTIME_KEYS) if k not in sub]\r\n  230:     if missing:\r\n  231:         raise ProfileError(f\"profile {source}: llm missing key(s) {missing!r}\")\r\n  232:     for k in _LLM_MODEL_KEYS:\r\n  233:         v = sub[k]\r\n  234:         if not isinstance(v, str):\r\n  235:             raise ProfileError(f\"profile {source}: llm.{k} must be a str; got {v!r}\")\r\n  236:         if k in (\"creative_model\", \"technical_model\") and not v:\r\n  237:             raise ProfileError(f\"profile {source}: llm.{k} must be non-empty\")\r\n  238:     from .llm_policy import LLMPolicyError, LLMRuntimePolicy\r\n  239:     try:\r\n  240:         LLMRuntimePolicy(\r\n  241:             device=sub[\"device\"], attn_impl=sub[\"attn_impl\"],\r\n  242:             quant_policy=sub[\"quant_policy\"],\r\n  243:             vram_ceiling_gb=sub[\"vram_ceiling_gb\"],\r\n  244:             gguf_n_ctx=sub[\"gguf_n_ctx\"], gguf_quant=sub[\"gguf_quant\"],\r\n  245:             lane_allowlist=tuple(sub[\"lane_allowlist\"]),\r\n  246:         )\r\n  247:     except (LLMPolicyError, TypeError) as e:\r\n  248:         raise ProfileError(f\"profile {source}: llm section invalid: {e}\") from e\r\n  249: \r\n  250: \r\n  251: def _is_str_dict(v: Any) -> bool:\r\n  252:     return isinstance(v, dict) and all(\r\n  253:         isinstance(k, str) and isinstance(val, str) and val for k, val in v.items()\r\n  254:     )\r\n  255: \r\n  256: \r\n  257: def validate_profile_shape(profile: Any, source: str = \"<dict>\") -> dict:\r\n  258:     \"\"\"S0 shape validator. Returns the profile on success; raises\r\n  259:     :class:`ProfileError` naming the first offending key otherwise.\r\n  260:     Unknown top-level / seed_policy / launch keys are REJECTED (a typo'd\r\n","exit_code":0,"status":"completed"}}
