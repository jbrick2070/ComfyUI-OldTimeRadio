on_s`` (never ``dur_s``); a missing value\r\n 3788:     # is OMITTED (the Timing default 0.0 applies) -- an explicit None fails\r\n 3789:     # ``model_validate``.\r\n 3790:     _start = (line.get(\"start_s\") if line.get(\"start_s\") is not None\r\n 3791:               else shot.get(\"start_s\"))\r\n 3792:     if _start is not None:\r\n 3793:         req[\"timing\"][\"start_s\"] = float(_start)\r\n 3794:     _dur = (line.get(\"dur_s\") if line.get(\"dur_s\") is not None\r\n 3795:             else shot.get(\"dur_s\"))\r\n 3796:     if _dur is not None:\r\n 3797:         req[\"timing\"][\"target_duration_s\"] = float(_dur)\r\n 3798:     # Thread the beat identity for downstream cache keys (3D plan 7.3: the\r\n 3799:     # CURVE key needs line_id) -- the schema-real Timing.source_line_ids.\r\n 3800:     _sids = shot.get(\"source_line_ids\")\r\n 3801:     req[\"timing\"][\"source_line_ids\"] = (\r\n 3802:         [str(s) for s in _sids] if isinstance(_sids, list) and _sids\r\n 3803:         else ([_beat_id_for_shot(shot)] if _beat_id_for_shot(shot) else []))\r\n 3804:     # char_id rides in conditioning_refs (W7-pre migration: a top-level\r\n 3805:     # char_id is a schema extra; VideoRequest is extra=\"forbid\").\r\n 3806:     if char_id:\r\n 3807:         req[\"conditioning_refs\"][\"char_id\"] = char_id\r\n 3808:     _prune_strict_text_only_request(req, shot.get(\"engine_id\"))\r\n 3809:     return req\r\n 3810: \r\n 3811: \r\n 3812: # --------------------------------------------------------------------------- #\r\n 3813: # The in-process render (the GPU slice)\r\n 3814: # --------------------------------------------------------------------------- #\r\n 3815: def _present_request_tokens(request):\r\n 3816:     \"\"\"The role_compat input tokens a request dict actually carries (mirrors\r\n 3817:     ``schemas.VideoRequest._present_input_tokens`` for plain dicts).\"\"\"\r\n 3818:     get = request.get if isinstance(request, dict) else (\r\n 3819:         lambda k, d=None: getattr(request, k, d))\r\n 3820:     present = set()\r\n 3821:     if get(\"text_prompt\"):\r\n 3822:         present.add(\"text_prompt\")\r\n 3823:     if \"init_image\" in (get(\"asset_refs\") or {}):\r\n 3824:         present.add(\"init_image\")\r\n 3825:     if get(\"audio_ref\") is not None:\r\n 3826:         present.add(\"audio_ref\")\r\n 3827:     if get(\"base_clip_ref\"):\r\n 3828:         present.add(\"base_clip_ref\")\r\n 3829:     return present\r\n 3830: \r\n 3831: \r\n 3832: def _assert_family_inputs_satisfiable(engine_name, request):\r\n 3833:     \"\"\"p3 down-chain request shape (3D plan 7.0): before attempting a fallback\r\n 3834:     CANDIDATE, re-validate the ONE request against the candidate FAMILY's\r\n 3835:     required inputs. A family whose requirements the request cannot satisfy\r\n 3836:     (e.g. ``lipsync_overlay`` needs ``base_clip_ref`` a ``character_3d``\r\n 3837:     request lacks) raises :class:`FamilyInputGap` -- the chain SKIPS it LOUDLY\r\n 3838:     (decision + restamp) instead of feeding the wrong-shaped request to the\r\n 3839:     engine. The no-input floor families are always satisfiable, so termination\r\n","exit_code":0,"status":"completed"}}
