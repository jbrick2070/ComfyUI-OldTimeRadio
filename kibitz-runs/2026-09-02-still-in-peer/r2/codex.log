:     assets = assets or {}\r\n  355:     portrait = assets.get(\"init_image\", \"\")\r\n  356:     audio = assets.get(\"audio_ref\", \"\")\r\n  357:     sid = shot[\"shot_id\"]\r\n  358:     try:\r\n  359:         idx = int(sid.rsplit(\"_\", 1)[-1])\r\n  360:     except ValueError:\r\n  361:         idx = 0\r\n  362:     seed = (idx * 1009 + 7) & 0x7FFFFFFF\r\n  363:     cw, ch = (canvas or (480, 832))\r\n  364:     family = engine_family(str(shot.get(\"engine_id\") or \"\"),\r\n  365:                            shot.get(\"family\")) or \"abstract\"\r\n  366:     return {\r\n  367:         \"shot_id\": sid, \"request_id\": sid,\r\n  368:         \"role\": str(shot.get(\"role\") or \"\"),\r\n  369:         \"family_hint\": family,\r\n  370:         \"profile_id\": str(shot.get(\"profile_id\") or \"\"),\r\n  371:         \"text_prompt\": \"a 1940s radio studio, on air sign illuminated, period broadcast set\",\r\n  372:         \"asset_refs\": {\"init_image\": portrait} if portrait else {},\r\n  373:         \"conditioning_refs\": {},\r\n  374:         \"audio_ref\": {\"path\": audio} if audio else None,\r\n  375:         \"base_clip_ref\": None,\r\n  376:         \"timing\": {\"target_frame_count\": int(frame_count)},\r\n  377:         \"canvas\": {\"w\": int(cw), \"h\": int(ch), \"fps\": 25, \"aspect_policy\": \"pad\"},\r\n  378:         \"seed_bundle\": {\"request_seed\": seed},\r\n  379:         \"observability\": {},\r\n  380:     }\r\n  381: \r\n  382: \r\n  383: # --------------------------------------------------------------------------- #\r\n  384: # Per-beat audio slice from the frozen master mix (read-only).\r\n  385: #\r\n  386: # HuMo needs an ``audio_ref`` WAV per beat.  When the ledger carries no\r\n  387: # per-line ``*_wav_path`` (the common case when individual TTS clips are not\r\n  388: # re-exported as standalone files), we slice the FROZEN master mix by the\r\n  389: # beat's ``[start_s, start_s+dur_s]`` timing that OTR_EpisodeAssembler\r\n  390: # already stamped onto every ``lines[]`` entry.  The master file is opened\r\n  391: # read-only by ffmpeg (``-i``); output goes to a dedicated temp directory so\r\n  392: # the master is NEVER mutated (V-1 / audio spine frozen).\r\n  393: #\r\n  394: # CACHE KEYS -- the 7.3 slice/curve SPLIT (don't over-key the cheap WAV):\r\n  395: # the SLICE key binds the master CONTENT hash\r\n  396: # (``ledger['audio']['master_audio_sha256']``) + start_s + dur_s + sample\r\n  397: # rate + channels + slicer version -- the shipped path-only key\r\n  398: # under-invalidated when a NEW master landed at the SAME path.  The CURVE\r\n  399: # key (the W7 Rhubarb driver's artifact) DERIVES from the slice key and\r\n  400: # additionally binds line_id + fps + driver version + viseme-mapping hash +\r\n  401: # onset policy -- driver-side concerns that must never churn the cheap WAV.\r\n  402: # The HuMo 44.1 kHz mono slice semantics are UNCHANGED; the driver's 16 kHz\r\n  403: # input is a DOWNSAMPLE OF THE SLICE, never a re-slice of the master.\r\n  404: # --------------------------------------------------------------------------- #\r\n  405: \r\n  406: #: Bumps when the SLICE ffmpeg recipe changes (codec/rate/channels/trim\r\n  407: #: semantics) -- part of the slice cache key, so old cached WAVs invalidate.\r\n  408: #: v3 (WIRE-W4c): the recipe grew a silence pad, so every v2 WAV on disk\r\n  409: #: describes a different contract and must not be served to a v3 caller.\r\n","exit_code":1,"status":"failed"}}
