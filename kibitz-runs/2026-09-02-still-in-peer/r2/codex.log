 is stamped, is what makes that safe.\r\n 1098:         \"\"\"\r\n 1099:         raw = raw or {}\r\n 1100:         path = raw.get(\"out_path\", \"\")\r\n 1101:         if path:\r\n 1102:             fields = ffprobe_clip_fields(path)\r\n 1103:             validate_silent_clip_contract(fields, self.target_fps)\r\n 1104:             width = int(fields.get(\"width\") or 0)\r\n 1105:             height = int(fields.get(\"height\") or 0)\r\n 1106:             if width != GHOST_CANVAS_W or height != GHOST_CANVAS_H:\r\n 1107:                 raise RuntimeError(\r\n 1108:                     \"%s produced a %dx%d clip; this lane delivers by clean \"\r\n 1109:                     \"full-frame Lanczos with no pad or crop, so only an exact \"\r\n 1110:                     \"%dx%d source can be enlarged to %dx%d without distorting \"\r\n 1111:                     \"it\" % (self.name, width, height, GHOST_CANVAS_W,\r\n 1112:                             GHOST_CANVAS_H, GHOST_DELIVERY_W, GHOST_DELIVERY_H))\r\n 1113: \r\n 1114:         clip = self._clip_from_raw(raw, request)\r\n 1115:         for key in (\"model_frame_count\", \"cadence_mode\",\r\n 1116:                     \"cadence_source_frame_count\",\r\n 1117:                     \"cadence_delivered_frame_count\", \"cadence_tail_trim\",\r\n 1118:                     \"delivery_scale_mode\"):\r\n 1119:             if key in raw:\r\n 1120:                 clip[key] = raw[key]\r\n 1121:         return clip\r\n 1122: \r\n 1123:     def _clip_from_raw(self, raw, request):\r\n 1124:         \"\"\"The self-declared clip dict :meth:`canonicalize` returns.\"\"\"\r\n 1125:         get = request.get if isinstance(request, dict) else (\r\n 1126:             lambda k, d=None: getattr(request, k, d))\r\n 1127:         raw = raw or {}\r\n 1128:         return {\r\n 1129:             \"clip_id\": (get(\"shot_id\") or get(\"request_id\")\r\n 1130:                         or (\"%s_clip\" % self.name)),\r\n 1131:             \"type\": \"video\",\r\n 1132:             \"path\": raw.get(\"out_path\", \"\"),\r\n 1133:             \"container\": \"mp4\", \"codec\": \"h264\", \"pixel_format\": \"yuv420p\",\r\n 1134:             \"fps\": int(self.target_fps),\r\n 1135:             \"frame_count\": int(raw.get(\"frame_count\", 0) or 0),\r\n 1136:             \"has_audio\": False,     # V-1: only OTR_MasterAudioMux emits audio\r\n 1137:             \"color_primaries\": \"bt709\", \"transfer\": \"bt709\", \"matrix\": \"bt709\",\r\n 1138:             \"engine_id\": self.name, \"family\": self.family,\r\n 1139:             \"vram_peak_mb\": raw.get(\"vram_peak_mb\"),\r\n 1140:             \"recipe\": raw.get(\"recipe\"),\r\n 1141:             \"domain_adapter\": raw.get(\"domain_adapter\"),\r\n 1142:             \"domain_adapter_strength\": raw.get(\"domain_adapter_strength\"),\r\n 1143:             \"native_frame_count\": raw.get(\"native_frame_count\"),\r\n 1144:             \"extension_mode\": raw.get(\"extension_mode\"),\r\n 1145:             \"render_canvas\": raw.get(\"render_canvas\"),\r\n 1146:         }\r\n 1147: \r\n 1148: \r\n 1149: def _sha8(text) -> str:\r\n 1150:     import hashlib\r\n 1151:     return hashlib.sha256(str(text or \"\").encode(\"utf-8\")).hexdigest()[:8]\r\n 1152: \r\n 1153: \r\n 1154: __all__ = [\r\n 1155:     \"GhostSignalEngine\", \"GhostCadenceError\",\r\n 1156:     \"GHOST_RECIPE_RECEIPT\", \"GHOST_CHECKPOINT_NAME\", \"GHOST_MOTION_MODULE_NAME\",\r\n 1157:     \"GHOST_CHECKPOINT_CATEGORY\", \"GHOST_MOTION_CATEGORY\",\r\n 1158:     \"GHOST_CANVAS_W\", \"GHOST_CANVAS_H\",\r\n 1159:     \"GHOST_DELIVERY_W\", \"GHOST_DELIVERY_H\", \"GHOST_DELIVERY_SCALE_MODE\",\r\n 1160:     \"GHOST_STEPS\", \"GHOST_CFG\", \"GHOST_SAMPLER_NAME\", \"GHOST_SCHEDULER\",\r\n 1161:     \"GHOST_DENOISE\", \"GHOST_BETA_SCHEDULE\",\r\n 1162:     \"GHOST_CONTEXT_LENGTH\", \"GHOST_CONTEXT_OVERLAP\",\r\n 1163:     \"GHOST_CONTEXT_FUSE_METHOD\", \"GHOST_CONTEXT_USE_ON_EQUAL_LENGTH\",\r\n 1164:     \"GHOST_CONTEXT_START_PERCENT\", \"GHOST_CONTEXT_GUARANTEE_STEPS\",\r\n 1165:     \"GHOST_SOURCE_FLOOR\", \"GHOST_SOURCE_FPS\", \"GHOST_TARGET_FPS\",\r\n 1166:     \"GHOST_NODE_CANDIDATES\", \"GHOST_ADE_OMITTED_SOCKETS\",\r\n 1167:     \"GHOST_CONTEXT_OMITTED_SOCKETS\",\r\n 1168:     \"NODE_CKPT\", \"NODE_POSITIVE\", \"NODE_NEGATIVE\", \"NODE_CONTEXT\", \"NODE_ADE\",\r\n 1169:     \"NODE_LATENT\", \"NODE_SAMPLER\", \"NODE_DECODE\",\r\n 1170:     \"ghost_unique_source_count\", \"ghost_source_request\",\r\n 1171:     \"ghost_hold2_selector\", \"ghost_hold_selector\", \"ghost_cadence_receipts\",\r\n 1172:     \"GHOST_DEFAULT_HOLD\",\r\n 1173: ]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=2830; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\otr_shot_lock.py' | Select-Object -Skip (\"'$start-1) -First 310 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 2830: # ---------------------------------------------------------------------------\r\n 2831: \r\n 2832: \r\n 2833: class OTRShotLock:\r\n 2834:     \"\"\"Registered as ``OTR_ShotLock``. Single ``ledger['video']`` authority.\"\"\"\r\n 2835: \r\n 2836:     CATEGORY = \"OldTimeRadio/v2/video\"\r\n 2837:     FUNCTION = \"lock\"\r\n 2838:     # episode_id output is ADDITIVE (still-spine ST-6 / DS-3): ShotLock holds\r\n 2839:     # the audio-overlaid ledger, so it is the in-graph episode_id authority;\r\n 2840:     # the saved json wires it into OTR_ImageGenDispatcher.episode_id so every\r\n 2841:     # still lands in episodes/<ep>/stills/. Existing slot indexes unchanged.\r\n 2842:     RETURN_TYPES = (\"STRING\", \"INT\", \"STRING\", \"STRING\", \"STRING\")\r\n 2843:     RETURN_NAMES = (\"patched_ledger_json\", \"video_revision\", \"shot_report\",\r\n 2844:                     \"done\", \"episode_id\")\r\n 2845:     OUTPUT_NODE = False\r\n 2846: \r\n 2847:     @classmethod\r\n 2848:     def INPUT_TYPES(cls):\r\n 2849:         return {\r\n 2850:             \"required\": {\r\n 2851:                 \"script_json\": (\"STRING\", {\r\n 2852:                     \"multiline\": True,\r\n 2853:                     \"default\": \"{}\",\r\n 2854:                     \"forceInput\": True,\r\n 2855:                     \"tooltip\": (\r\n 2856:                         \"Frozen ledger JSON (OTR_LedgerFreezeCascade out1 \"\r\n 2857:                         \"script_json). ShotLock stamps a video section into it.\"\r\n 2858:                     ),\r\n 2859:                 }),\r\n 2860:                 \"audio_done\": (\"STRING\", {\r\n 2861:                     \"multiline\": True,\r\n 2862:                     \"default\": \"\",\r\n 2863:                     \"forceInput\": True,\r\n 2864:                     \"tooltip\": (\r\n 2865:                         \"Audio-done gate (OTR_EpisodeAssembler out3). Wiring it \"\r\n 2866:                         \"orders ShotLock AFTER audio timing freezes so the clip \"\r\n 2867:                         \"budget is bound against the real timeline. Opaque STRING.\"\r\n 2868:                     ),\r\n 2869:                 }),\r\n 2870:                 \"video_policy_json\": (\"STRING\", {\r\n 2871:                     \"multiline\": True,\r\n 2872:                     \"default\": \"{}\",\r\n 2873:                     \"forceInput\": True,\r\n 2874:                     \"tooltip\": \"Per-role selection policy from OTR_VideoDirector.\",\r\n 2875:                 }),\r\n 2876:             },\r\n 2877:             \"optional\": {\r\n 2878:                 # `image_done` (an input socket) and `consistency_gate_warn_only`\r\n 2879:                 # (a widget) were REMOVED 2026-08-28, safety-gated first:\r\n 2880:                 #\r\n 2881:                 # * image_done was a SUPERSEDED UNWIRED FIX. It promised the\r\n 2882:                 #   image-before-video ordering gate, was unlinked in all 62\r\n 2883:                 #   graphs carrying this node, and its parameter was never read\r\n 2884:                 #   -- not even forwarded. The LIVE ordering mechanism is\r\n 2885:                 #   canonical link 267, ImageGenDispatcher.image_done ->\r\n 2886:                 #   VideoRenderBatch.image_done, which bypasses ShotLock\r\n 2887:                 #   entirely. Do NOT wire Dispatcher -> ShotLock instead:\r\n 2888:                 #   ShotLock already feeds the Dispatcher its locked ledger and\r\n 2889:                 #   episode_id, so any edge back closes a 90 -> 91 -> 90 cycle.\r\n 2890:                 #   Removing input index 3 moved gate_in (link 284) dst_slot\r\n 2891:                 #   4 -> 3; repaired by identity in canonical, variants\r\n 2892:                 #   regenerated.\r\n 2893:                 # * consistency_gate_warn_only was displayed, forwarded one\r\n 2894:                 #   hop, and deleted -- a knob controlling nothing. The helper\r\n 2895:                 #   `derive_creative_directives` keeps its own parameter (a\r\n 2896:                 #   direct-call test exercises both values); the NODE no longer\r\n 2897:                 #   advertises a choice it does not honour.\r\n 2898:                 \"gate_in\": (\"STRING\", {\r\n 2899:                     \"multiline\": True,\r\n 2900:                     \"default\": \"\",\r\n 2901:                     \"forceInput\": True,\r\n 2902:                     \"tooltip\": \"Optional ordering signal (opaque STRING).\",\r\n 2903:                 }),\r\n 2904:             },\r\n 2905:         }\r\n 2906: \r\n 2907:     @classmethod\r\n 2908:     def VALIDATE_INPUTS(cls, **kwargs):\r\n 2909:         return True\r\n 2910: \r\n 2911:     @classmethod\r\n 2912:     def IS_CHANGED(cls, **kwargs):\r\n 2913:         \"\"\"Re-lock whenever the ROUTING ENVIRONMENT changes (2026-07-25, 1b).\r\n 2914: \r\n 2915:         ShotLock validates the frozen route against the live environment and\r\n 2916:         mints every shot from it, so a cached lock served across an env change\r\n 2917:         would hand the dispatcher and the render batch a plan built for a route\r\n 2918:         the operator has already replaced. The same fingerprint is used by\r\n 2919:         OTR_VideoDirector, so both ends of the freeze invalidate together.\r\n 2920:         \"\"\"\r\n 2921:         from ._otr_shared import route_freeze as _rf\r\n 2922:         return _rf.snapshot_fingerprint(_rf.routing_env_snapshot())\r\n 2923: \r\n 2924:     # ------------------------------------------------------------------ #\r\n 2925:     def lock(self, script_json, audio_done=\"\", video_policy_json=\"{}\",\r\n 2926:              gate_in=\"\"):\r\n 2927:         from . import _otr_ledger_consumers as _OTRLC\r\n 2928:         try:\r\n 2929:             from .production_ledger import stamp_durable as _stamp_durable\r\n 2930:         except ImportError:  # pragma: no cover -- flat imports\r\n 2931:             from production_ledger import stamp_durable as _stamp_durable  # type: ignore\r\n 2932: \r\n 2933:         led = _OTRLC.load_ledger(script_json)\r\n 2934:         # STRICT HERE, AND ONLY HERE. This is the canonical graph join: it is\r\n 2935:         # gated on the audio_done forceInput, and EpisodeAssembler saves the\r\n 2936:         # durable ledger immediately before minting that string. So a join that\r\n 2937:         # cannot be proved at THIS call site is an anomaly, and quietly\r\n 2938:         # returning the pre-audio ledger would restore the old beat-id space\r\n 2939:         # and make the PBUG-20260811-02 repair inert for the run. The other\r\n 2940:         # caller (SignalLostVideoRenderer, title-card timing only) keeps the\r\n 2941:         # fail-soft default -- see overlay_audio_timing's docstring.\r\n 2942:         led = overlay_audio_timing(led, strict=bool(str(audio_done or \"\").strip()))\r\n 2943:         meta = led.get(\"meta\")\r\n 2944:         if not isinstance(meta, dict):\r\n 2945:             meta = {}\r\n 2946:             led[\"meta\"] = meta\r\n 2947:         try:\r\n 2948:             policy = json.loads(video_policy_json or \"{}\")\r\n 2949:             if not isinstance(policy, dict):\r\n 2950:                 policy = {}\r\n 2951:         except (ValueError, TypeError):\r\n 2952:             policy = {}\r\n 2953: \r\n 2954:         # S4 platform-portability (2026-07-10): a NON-EMPTY policy must be\r\n 2955:         # version 2 (device_policy/dtype_policy present). A v1 policy here\r\n 2956:         # means a stale OTR_VideoDirector emitted it -- fail LOUD before\r\n 2957:         # any render work burns on it.\r\n 2958:         if policy and int(policy.get(\"policy_version\") or 0) != 2:\r\n 2959:             raise ValueError(\r\n 2960:                 \"OTR_ShotLock: video_policy_json carries policy_version=\"\r\n 2961:                 f\"{policy.get('policy_version')!r}; expected 2. Re-run \"\r\n 2962:                 \"OTR_VideoDirector (stale/hand-crafted policy).\")\r\n 2963: \r\n 2964:         # THE ROUTE-FREEZE GUARD (2026-07-25, multi-clip coverage chunk 1b).\r\n 2965:         # OTR_VideoDirector froze effective routing from a captured environment\r\n 2966:         # and stamped that capture into the policy. If the environment has moved\r\n 2967:         # since -- a cached upstream node, an operator exporting\r\n 2968:         # OTR_FORCE_ENGINE_MAP between nodes, a headless leg submitted to a\r\n 2969:         # server booted with a different env -- then the frozen map describes a\r\n 2970:         # route that is no longer real, and every still, prompt and shot planned\r\n 2971:         # from it is planned for engines that will not run. That is precisely\r\n 2972:         # the defect class this build closes, so it is TERMINAL, before any GPU\r\n 2973:         # time or image time is spent. A policy with NO snapshot is a pre-1b or\r\n 2974:         # hand-built ledger and is left alone.\r\n 2975:         _frozen_snapshot = policy.get(\"routing_env_snapshot\")\r\n 2976:         if isinstance(_frozen_snapshot, dict) and _frozen_snapshot:\r\n 2977:             from ._otr_shared import route_freeze as _rf\r\n 2978:             _live_snapshot = _rf.routing_env_snapshot()\r\n 2979:             if not _rf.snapshots_agree(_frozen_snapshot, _live_snapshot):\r\n 2980:                 raise ValueError(\r\n 2981:                     \"OTR_ShotLock: the routing environment CHANGED after \"\r\n 2982:                     \"OTR_VideoDirector froze it. Frozen %r, live %r. The \"\r\n 2983:                     \"frozen route no longer describes what will render, so \"\r\n 2984:                     \"every still and prompt planned from it is planned for the \"\r\n 2985:                     \"wrong engine. Re-run the graph from OTR_VideoDirector with \"\r\n 2986:                     \"the environment you actually want. NO FALLBACK.\"\r\n 2987:                     % (_frozen_snapshot, _live_snapshot))\r\n 2988: \r\n 2989:         canvas = (policy.get(\"canvas\") or {})\r\n 2990:         fps = int(canvas.get(\"fps\") or 25)\r\n 2991:         report: list = []\r\n 2992:         warnings: list = []\r\n 2993:         # CANONICAL REPLAY (campaign item 0): the PLANNED section is reused from\r\n 2994:         # the imported ledger -- no LLM derivation, no re-plan, no revision bump.\r\n 2995:         # The seeds are the same because the request hashes are the same rows.\r\n 2996:         from .production_ledger import replay_descriptor as _replay_descriptor\r\n 2997:         if _replay_descriptor(meta):\r\n 2998:             planned = led.get(\"video\")\r\n 2999:             if not isinstance(planned, dict) or not planned.get(\"shots\"):\r\n 3000:                 raise ValueError(\r\n 3001:                     \"OTR_ShotLock: REPLAY needs the frozen ledger's planned video \"\r\n 3002:                     \"section (video.shots) and the bundle carries none -- freeze an \"\r\n 3003:                     \"episode rendered after the durable planned stamp landed.\")\r\n 3004:             revision = int(planned.get(\"video_revision\") or meta.get(\"video_revision\") or 0)\r\n 3005:             meta[\"video_revision\"] = revision\r\n 3006:             _stamp_durable(sections={\"video\": planned},\r\n 3007:                            meta_updates={\"video_revision\": revision},\r\n 3008:                            source=\"OTR_ShotLock:replay\")\r\n 3009:             patched = json.dumps(led, ensure_ascii=True, separators=(\",\", \":\"))\r\n 3010:             log.warning(\"[OTR_ShotLock] REPLAY: planned section reused (revision %d, \"\r\n 3011:                         \"%d shot(s)), no LLM\", revision, len(planned.get(\"shots\") or []))\r\n 3012:             return (patched, revision,\r\n 3013:                     \"shot_lock: replay reuse of the planned section\",\r\n 3014:                     f\"shot_lock:done:rev={revision}\",\r\n 3015:                     str(led.get(\"episode_id\") or meta.get(\"episode_id\") or \"\"))\r\n 3016: \r\n 3017:         # Brief disposition, ONCE per run (gap-audit G4 restore).\r\n 3018:         try:\r\n 3019:             try:\r\n 3020:                 from ._otr_story_brief_helpers import (  # type: ignore\r\n 3021:                     log_story_brief_disposition)\r\n 3022:             except ImportError:  # pragma: no cover\r\n 3023:                 from _otr_story_brief_helpers import (  # type: ignore\r\n 3024:                     log_story_brief_disposition)\r\n 3025:             log_story_brief_disposition(meta, \"shotlock_m4\", log)\r\n 3026:         except Exception:  # noqa: BLE001\r\n 3027:             pass\r\n 3028: \r\n 3029:         beats = extract_beats(led)\r\n 3030:         budget = compute_clip_budget(beats, fps)\r\n 3031: \r\n 3032:         # The OPENING-MUSIC scene (operator look-QA 2026-06-10): injected\r\n 3033:         # AFTER the budget so the real beats keep their exact cumulative-\r\n 3034:         # samples frame math; the synthetic head beat adds its own frames.\r\n 3035:         _open_beat, _open_frames = derive_opening_music_beat(led, fps)\r\n 3036:         if _open_beat is not None and _open_frames > 0:\r\n 3037:             beats.insert(0, _open_beat)\r\n 3038:             budget[\"per_beat\"][OPENING_MUSIC_BEAT_ID] = _open_frames\r\n 3039:             budget[\"total_frames\"] = int(budget.get(\"total_frames\") or 0) \\\r\n 3040:                 + _open_frames\r\n 3041:             report.append(\r\n 3042:                 \"opening-music scene injected: %d frames (head 0..%.2fs) on \"\r\n 3043:                 \"the music_visual engine\" % (_open_frames,\r\n 3044:                                              _open_frames / max(1, fps)))\r\n 3045: \r\n 3046:         creative, cre_warn = derive_creative_directives(\r\n 3047:             beats, meta, led,\r\n 3048:             # The widget is gone; the helper keeps its parameter and the\r\n 3049:             # shipped value was always False.\r\n 3050:             consistency_gate_warn_only=False,\r\n 3051:             video_policy=policy,\r\n 3052:         )\r\n 3053:         warnings.extend(cre_warn)\r\n 3054: \r\n 3055:         groups, shots = build_execution_plan(beats, budget, creative, policy,\r\n 3056:                                              led, warnings=warnings)\r\n 3057: \r\n 3058:         revision = int(meta.get(\"video_revision\") or 0) + 1\r\n 3059:         video_section = {\r\n 3060:             \"video_revision\": revision,\r\n 3061:             # S4: the v2 policy stamps ride the ledger so render_driver\r\n 3062:             # (and every adapter's assert_usable) sees the SAME device/\r\n 3063:             # dtype truth the directors emitted. Defaults = nv50 baseline\r\n 3064:             # (tolerates an empty policy in unit fixtures).\r\n 3065:             \"policy_version\": 2,\r\n 3066:             \"device_policy\": str(policy.get(\"device_policy\") or \"cuda\"),\r\n 3067:             \"dtype_policy\": str(policy.get(\"dtype_policy\") or \"fp8_ok\"),\r\n 3068:             # WAN 8GB launch contract (2026-07-24): the tier's render-length\r\n 3069:             # ceiling rides the ledger next to the device/dtype stamps, so the\r\n 3070:             # engine sees it on a production leg regardless of how the server\r\n 3071:             # was booted. 0 = unpinned. Beat frame targets are untouched.\r\n 3072:             # ONE normalization (B3): the same helper build_execution_plan\r\n 3073:             # planned against, so the stamped ceiling and the planned ceiling\r\n 3074:             # cannot be two expressions that drift apart.\r\n 3075:             \"max_render_frames\": _planning_ceiling(policy),\r\n 3076:             \"canonical_canvas\": {\r\n 3077:                 \"w\": int(canvas.get(\"w\") or 832),\r\n 3078:                 \"h\": int(canvas.get(\"h\") or 480),\r\n 3079:             },\r\n 3080:             \"fps\": fps,\r\n 3081:             \"execution_groups\": groups,\r\n 3082:             \"roles\": policy.get(\"video_models\") or {},\r\n 3083:             # BOTH maps ride the ledger (2026-07-25, chunk 1b). ``roles`` stays\r\n 3084:             # the PICKED map for continuity; ``roles_effective`` is what every\r\n 3085:             # shot was actually minted from, and ``routing_env_snapshot`` is the\r\n 3086:             # environment it was frozen under. Stamping only the picked map made\r\n 3087:             # an equality failure at render unreplayable -- you could see that\r\n 3088:             # the engines disagreed but not what the plan had believed or why.\r\n 3089:             \"roles_effective\": policy.get(\"effective_video_models\") or {},\r\n 3090:             \"routing_env_snapshot\": policy.get(\"routing_env_snapshot\") or {},\r\n 3091:             \"shots\": shots,\r\n 3092:             \"clip_budget\": {\r\n 3093:                 \"total_frames\": budget[\"total_frames\"],\r\n 3094:             },\r\n 3095:             \"warnings\": warnings,\r\n 3096:         }\r\n 3097:         led[\"video\"] = video_section\r\n 3098:         meta[\"video_revision\"] = revision\r\n 3099:         # THE PLANNED SECTION IS DURABLE (campaign item 0, 2026-09-02). Until\r\n 3100:         # today it lived only on the wire: every later disk write started from\r\n 3101:         # the on-disk file and _merge_with_disk kept no \"video\" key, so 0 of the\r\n 3102:         # 60 newest ledgers carried what the director asked for. Stamped through\r\n 3103:         # the SINGLETON (a disk-only save would desync the state later saves\r\n 3104:         # merge from), LOUD on failure, and never in test mode.\r\n 3105:         try:\r\n 3106:             from .production_ledger import stamp_durable as _stamp_durable\r\n 3107:         except ImportError:  # pragma: no cover -- flat imports\r\n 3108:             from production_ledger import stamp_durable as _stamp_durable  # type: ignore\r\n 3109:         _stamp_durable(sections={\"video\": video_section},\r\n 3110:                        meta_updates={\"video_revision\": revision},\r\n 3111:                        source=\"OTR_ShotLock\")\r\n 3112: \r\n 3113:         report.append(f\"shot_lock_revision={revision} beats={len(beats)} shots={len(shots)}\")\r\n 3114:         report.append(\r\n 3115:             f\"clip_budget: total_frames={budget['total_frames']}\"\r\n 3116:         )\r\n 3117:         report.append(f\"execution_groups={[g['group_id'] for g in groups]}\")\r\n 3118:         for w in warnings:\r\n 3119:             report.append(f\"WARN: {w}\")\r\n 3120:             log.warning(\"[OTR_ShotLock] %s\", w)\r\n 3121: \r\n 3122:         patched = json.dumps(led, ensure_ascii=True, separators=(\",\", \":\"))\r\n 3123:         done = f\"shot_lock:done:rev={revision}\"\r\n 3124:         episode_id = str(led.get(\"episode_id\")\r\n 3125:                          or (led.get(\"meta\") or {}).get(\"episode_id\") or \"\")\r\n 3126:         return (patched, int(revision), \"\\n\".join(report), done, episode_id)\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=70; $i=$start-1; Get-Content -LiteralPath '\"'scripts\\\\otr_canonical_api_run.py' | Select-Object -Skip (\"'$start-1) -First 70 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"   70:         )\r\n   71:     if len(matches) > 1:\r\n   72:         raise SystemExit(\r\n   73:             f\"node type {node_ref!r} appears {len(matches)} times; use id.widget\"\r\n   74:         )\r\n   75:     return matches[0]\r\n   76: \r\n   77: \r\n   78: def _apply_set(workflow: dict, schemas: dict, patch: str) -> str:\r\n   79:     \"\"\"Apply NODE_OR_ID.widget=value through the creative whitelist.\"\"\"\r\n   80:     if \"=\" not in patch:\r\n   81:         raise SystemExit(f\"--set must look like NODE.widget=value, got {patch!r}\")\r\n   82:     left, raw_value = patch.split(\"=\", 1)\r\n   83:     if \".\" not in left:\r\n   84:         raise SystemExit(f\"--set must name NODE.widget, got {patch!r}\")\r\n   85:     node_ref, widget = left.rsplit(\".\", 1)\r\n   86:     nid = _node_id_for(workflow, node_ref)\r\n   87:     value = _parse_value(raw_value)\r\n   88:     patch_creative(workflow, nid, widget, value, schemas)\r\n   89:     return f\"{node_ref}.{widget}={value!r}\"\r\n   90: \r\n   91: \r\n   92: def _apply_writer_shortcuts(workflow: dict, schemas: dict, args) -> list[str]:\r\n   93:     writer_id = _node_id_for(workflow, \"OTR_LedgerScriptWriter\")\r\n   94:     shortcuts: list[tuple[str, Any]] = []\r\n   95:     # `--words` was removed 2026-08-14 with the target_words widget. Episode\r\n   96:     # shape is set with --act-count below; length is an observation.\r\n   97:     if args.title is not None:\r\n   98:         shortcuts.append((\"episode_title\", args.title))\r\n   99:     if getattr(args, \"replay_from\", None):\r\n  100:         # CANONICAL REPLAY (campaign item 0): a bundle directory, patched as a\r\n  101:         # plain string through the creative whitelist -- never through the\r\n  102:         # --set value parser, where a path that happens to parse as JSON would\r\n  103:         # change type.\r\n  104:         shortcuts.append((\"replay_from\", str(args.replay_from)))\r\n  105:     if args.premise is not None:\r\n  106:         shortcuts.append((\"custom_premise\", args.premise))\r\n  107:     if args.source_bank is not None:\r\n  108:         shortcuts.append((\"source_bank\", args.source_bank))\r\n  109:     if args.visual_style is not None:\r\n  110:         shortcuts.append((\"visual_style\", args.visual_style))\r\n  111:     if args.creative_model is not None:\r\n  112:         shortcuts.append((\"creative_writing_model\", args.creative_model))\r\n  113:     if args.technical_model is not None:\r\n  114:         shortcuts.append((\"technical_model\", args.technical_model))\r\n  115:     if args.google_slot_a_model is not None:\r\n  116:         shortcuts.append((\"google_api_slot_a_model\", args.google_slot_a_model))\r\n  117:     if args.google_slot_b_model is not None:\r\n  118:         shortcuts.append((\"google_api_slot_b_model\", args.google_slot_b_model))\r\n  119:     if args.num_characters is not None:\r\n  120:         shortcuts.append((\"num_characters\", int(args.num_characters)))\r\n  121:     if args.act_count is not None:\r\n  122:         shortcuts.append((\"act_count\", str(args.act_count)))\r\n  123: \r\n  124:     applied = []\r\n  125:     for widget, value in shortcuts:\r\n  126:         patch_creative(workflow, writer_id, widget, value, schemas)\r\n  127:         applied.append(f\"OTR_LedgerScriptWriter.{widget}={value!r}\")\r\n  128:     return applied\r\n  129: \r\n  130: \r\n  131: def _schemas(offline: bool) -> dict:\r\n  132:     if not offline:\r\n  133:         return fetch_schemas()\r\n  134:     from nodes import _otr_workflow_apply as workflow_apply\r\n  135: \r\n  136:     return workflow_apply.build_offline_schemas()\r\n  137: \r\n  138: \r\n  139: def build_api_prompt(args) -> tuple[dict, list[str]]:\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=760; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 260 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  760:             \"unique_source_count\": unique,\r\n  761:             \"source_request\": ghost_source_request(target,\r\n  762:                                                    self.hold_factor),\r\n  763:             \"fps\": int(self.target_fps),\r\n  764:         }\r\n  765: \r\n  766:     def _assert_required_inputs(self, plan):\r\n  767:         if not plan[\"text_prompt\"]:\r\n  768:             raise RuntimeError(\r\n  769:                 \"%s requires a composed text_prompt and the request carries \"\r\n  770:                 \"none -- Ghost owns its whole subject, so an empty prompt is a \"\r\n  771:                 \"blank picture, not a default\" % self.name)\r\n  772:         if not plan[\"negative_prompt\"]:\r\n  773:             raise RuntimeError(\r\n  774:                 \"%s requires a composed negative_prompt and the request \"\r\n  775:                 \"carries none. NO ENGINE-SIDE CONSTANT SUBSTITUTES FOR IT: the \"\r\n  776:                 \"lane hygiene head and the pack's effective_negative are the \"\r\n  777:                 \"composer's to author, and a negative invented here would be a \"\r\n  778:                 \"receipt that lies about where it came from\" % self.name)\r\n  779: \r\n  780:     # ---- render --------------------------------------------------------- #\r\n  781:     def render_clip(self, request, prepared):\r\n  782:         \"\"\"One Ghost beat: encode, sample, decode, hold-2, encode a silent MP4.\r\n  783: \r\n  784:         Four bounded executor calls so the large families are not artificially\r\n  785:         pinned by one result dictionary. The cross-stage release law is the\r\n  786:         explicit owner clearing plus the public reclaim seam -- ``free_after_use``\r\n  787:         alone cannot release an external, because ``run_graph`` keeps every\r\n  788:         external id for the duration of that call.\r\n  789:         \"\"\"\r\n  790:         from . import wrapper_bridge as _wb\r\n  791:         from ._tmp import otr_engine_tmp_mp4\r\n  792: \r\n  793:         plan = self._build_render_request(request)\r\n  794:         self._assert_required_inputs(plan)\r\n  795:         classes = self._classes or _wb.resolve_graph_classes(\r\n  796:             self._node_candidates())\r\n  797:         owners = prepared if isinstance(prepared, dict) else {}\r\n  798: \r\n  799:         # ---- STAGE 2: ENCODE ------------------------------------------- #\r\n  800:         encode_graph = {\r\n  801:             NODE_POSITIVE: {\r\n  802:                 \"class\": classes[\"text_encode\"],\r\n  803:                 \"inputs\": {\"text\": plan[\"text_prompt\"],\r\n  804:                            \"clip\": _wb.Wire(\"clip\", 0)}},\r\n  805:             NODE_NEGATIVE: {\r\n  806:                 \"class\": classes[\"text_encode\"],\r\n  807:                 \"inputs\": {\"text\": plan[\"negative_prompt\"],\r\n  808:                            \"clip\": _wb.Wire(\"clip\", 0)}},\r\n  809:         }\r\n  810:         encode_results = _wb.run_graph(\r\n  811:             encode_graph, external_results={\"clip\": owners[\"clip\"]})\r\n  812:         positive_cond = (encode_results[NODE_POSITIVE][0],)\r\n  813:         negative_cond = (encode_results[NODE_NEGATIVE][0],)\r\n  814: \r\n  815:         # The CLIP family goes now: both conditionings are extracted, so every\r\n  816:         # strong reference to it must be gone BEFORE the reclaim seam runs or\r\n  817:         # the seam has nothing to move.\r\n  818:         encode_results.clear()\r\n  819:         del encode_graph\r\n  820:         owners.pop(\"clip\", None)\r\n  821:         _wb.reclaim_idle_models(\"ghost-signal post-encode\")\r\n  822: \r\n  823:         # ---- STAGE 3: SAMPLE ------------------------------------------- #\r\n  824:         sample_graph = {\r\n  825:             NODE_CONTEXT: {\r\n  826:                 \"class\": classes[\"context\"],\r\n  827:                 # The exact six frozen literals. prev_context and view_opts are\r\n  828:                 # OMITTED, not passed None.\r\n  829:                 \"inputs\": {\r\n  830:                     \"context_length\": GHOST_CONTEXT_LENGTH,\r\n  831:                     \"context_overlap\": GHOST_CONTEXT_OVERLAP,\r\n  832:                     \"fuse_method\": GHOST_CONTEXT_FUSE_METHOD,\r\n  833:                     \"use_on_equal_length\": GHOST_CONTEXT_USE_ON_EQUAL_LENGTH,\r\n  834:                     \"start_percent\": GHOST_CONTEXT_START_PERCENT,\r\n  835:                     \"guarantee_steps\": GHOST_CONTEXT_GUARANTEE_STEPS,\r\n  836:                 }},\r\n  837:             NODE_ADE: {\r\n  838:                 \"class\": classes[\"ade\"],\r\n  839:                 # motion_lora / ad_settings / ad_keyframes / sample_settings /\r\n  840:                 # scale_multival / effect_multival / per_block are OMITTED, which\r\n  841:                 # is what leaves the pinned ADE implementation owning its own\r\n  842:                 # normal full-strength behaviour.\r\n  843:                 \"inputs\": {\r\n  844:                     \"model\": _wb.Wire(\"base_model\", 0),\r\n  845:                     \"model_name\": self.motion_module_name,\r\n  846:                     \"beta_schedule\": GHOST_BETA_SCHEDULE,\r\n  847:                     \"context_options\": _wb.Wire(NODE_CONTEXT, 0),\r\n  848:                 }},\r\n  849:             NODE_LATENT: {\r\n  850:                 \"class\": classes[\"latent\"],\r\n  851:                 \"inputs\": {\"width\": GHOST_CANVAS_W,\r\n  852:                            \"height\": GHOST_CANVAS_H,\r\n  853:                            \"batch_size\": plan[\"source_request\"]}},\r\n  854:             NODE_SAMPLER: {\r\n  855:                 \"class\": classes[\"sampler\"],\r\n  856:                 \"inputs\": {\r\n  857:                     \"model\": _wb.Wire(NODE_ADE, 0),\r\n  858:                     \"seed\": plan[\"seed\"],\r\n  859:                     \"steps\": GHOST_STEPS,\r\n  860:                     \"cfg\": GHOST_CFG,\r\n  861:                     \"sampler_name\": GHOST_SAMPLER_NAME,\r\n  862:                     \"scheduler\": GHOST_SCHEDULER,\r\n  863:                     \"positive\": _wb.Wire(\"positive_cond\", 0),\r\n  864:                     \"negative\": _wb.Wire(\"negative_cond\", 0),\r\n  865:                     \"latent_image\": _wb.Wire(NODE_LATENT, 0),\r\n  866:                     \"denoise\": GHOST_DENOISE,\r\n  867:                 }},\r\n  868:         }\r\n  869: \r\n  870:         # THE DOMAIN ADAPTER, on a lane that declares one. MODEL PATH ONLY.\r\n  871:         # The artifact is 256 UNet attention tensors with ZERO text-encoder\r\n  872:         # weights -- read off the checkpoint's own key list rather than taken\r\n  873:         # from its documentation -- so CLIP has nothing to receive and keeps its\r\n  874:         # existing direct path from the checkpoint. ComfyUI maps these legacy\r\n  875:         # diffusers attn-processor keys natively (comfy/lora.py builds the\r\n  876:         # \".processor.to_q\" key; comfy/weight_adapter/lora.py appends\r\n  877:         # \"_lora.up.weight\"), which is exactly the artifact's own spelling, so\r\n  878:         # this is the stock loader with no conversion step and no custom code.\r\n  879:         if self.lora_name:\r\n  880:             sample_graph[NODE_LORA] = {\r\n  881:                 \"class\": classes[\"lora\"],\r\n  882:                 \"inputs\": {\r\n  883:                     \"model\": _wb.Wire(\"base_model\", 0),\r\n  884:                     \"lora_name\": self.lora_name,\r\n  885:                     \"strength_model\": float(self.lora_strength),\r\n  886:                 }}\r\n  887:             sample_graph[NODE_ADE][\"inputs\"][\"model\"] = _wb.Wire(NODE_LORA, 0)\r\n  888: \r\n  889:         def _register_patched(node_id, out_tuple):\r\n  890:             \"\"\"Register a PATCHED model immediately -- before the executor can\r\n  891:             evict it.\r\n  892: \r\n  893:             BOTH patch stages register here, and that is not tidiness. The\r\n  894:             adapter clones a patcher of its own, so a haunted lane holds THREE\r\n  895:             model identities -- base, adapter-patched, ADE-patched -- and every\r\n  896:             one of them must be detached before decode or it stays resident on\r\n  897:             the card for the rest of the episode.\r\n  898:             \"\"\"\r\n  899:             if node_id == NODE_LORA:\r\n  900:                 owner_key = \"lora_model\"\r\n  901:             elif node_id == NODE_ADE:\r\n  902:                 owner_key = \"ade_model\"\r\n  903:             else:\r\n  904:                 return\r\n  905:             if not out_tuple:\r\n  906:                 raise RuntimeError(\r\n  907:                     \"%s: the %s loader returned no MODEL\" % (self.name, node_id))\r\n  908:             patched = out_tuple[0]\r\n  909:             if not callable(getattr(patched, \"detach\", None)):\r\n  910:                 raise RuntimeError(\r\n  911:                     \"%s: the patched %s MODEL has no callable detach() -- \"\r\n  912:                     \"this adapter cannot take ownership of a patcher it cannot \"\r\n  913:                     \"release\" % (self.name, node_id))\r\n  914:             owners[owner_key] = patched\r\n  915:             self._patchers.append(patched)\r\n  916: \r\n  917:         sampled = _wb.run_graph(\r\n  918:             sample_graph,\r\n  919:             external_results={\"base_model\": owners[\"base_model\"],\r\n  920:                               \"positive_cond\": positive_cond,\r\n  921:                               \"negative_cond\": negative_cond},\r\n  922:             terminal=NODE_SAMPLER, on_result=_register_patched)\r\n  923:         sampled_latent = (sampled[0],)\r\n  924: \r\n  925:         # BOTH SAMPLING PATCHERS GO BEFORE DECODE, in ADE-then-base order.\r\n  926:         self._release_sampling_patchers_before_decode(owners)\r\n  927: \r\n  928:         del sample_graph\r\n  929:         positive_cond = None\r\n  930:         negative_cond = None\r\n  931:         del sampled\r\n  932:         _wb.reclaim_idle_models(\"ghost-signal post-sample\")\r\n  933: \r\n  934:         # ---- STAGE 4: DECODE ------------------------------------------- #\r\n  935:         decode_graph = {\r\n  936:             NODE_DECODE: {\r\n  937:                 \"class\": classes[\"decode\"],\r\n  938:                 \"inputs\": {\"samples\": _wb.Wire(\"sampled_latent\", 0),\r\n  939:                            \"vae\": _wb.Wire(\"vae\", 0)}},\r\n  940:         }\r\n  941:         images = _wb.run_graph(\r\n  942:             decode_graph,\r\n  943:             external_results={\"sampled_latent\": sampled_latent,\r\n  944:                               \"vae\": owners[\"vae\"]},\r\n  945:             terminal=NODE_DECODE)[0]\r\n  946: \r\n  947:         frames = _wb.images_to_uint8(images)\r\n  948:         decoded = int(frames.shape[0])\r\n  949:         if decoded != plan[\"source_request\"]:\r\n  950:             raise RuntimeError(\r\n  951:                 \"%s decoded %d frame(s) but asked for exactly %d -- a count \"\r\n  952:                 \"mismatch is a graph fault, and this lane pads nothing, \"\r\n  953:                 \"substitutes no alternate graph and falls back to no still\"\r\n  954:                 % (self.name, decoded, plan[\"source_request\"]))\r\n  955: \r\n  956:         # ---- CADENCE ---------------------------------------------------- #\r\n  957:         # Retain the first U source frames in order; the rest is the structural\r\n  958:         # surplus and is discarded BEFORE conversion, never delivered.\r\n  959:         selector = ghost_hold_selector(plan[\"target_frame_count\"],\r\n  960:                                        self.hold_factor)\r\n  961:         unique = plan[\"unique_source_count\"]\r\n  962:         delivered = frames[[min(i, unique - 1) for i in selector]]\r\n  963: \r\n  964:         out_path = otr_engine_tmp_mp4(\"ghost_signal\")\r\n  965:         out_path, proven = _wb.encode_frames_to_silent_mp4(\r\n  966:             delivered, out_path, int(self.target_fps))\r\n  967:         if int(proven) != int(plan[\"target_frame_count\"]):\r\n  968:             raise RuntimeError(\r\n  969:                 \"%s encoded %s frame(s) where the beat's delivered target is \"\r\n  970:                 \"%d\" % (self.name, proven, plan[\"target_frame_count\"]))\r\n  971: \r\n  972:         raw = {\r\n  973:             \"out_path\": out_path,\r\n  974:             \"frame_count\": int(proven),\r\n  975:             \"recipe\": self._recipe_receipt(),\r\n  976:             # THE DIAL'S POSITION IS PART OF THE RECORD, not an implementation\r\n  977:             # detail. Without it a strength-0 render is bit-for-bit the clean\r\n  978:             # lane -- ComfyUI's LoraLoader returns the model UNPATCHED at 0 and\r\n  979:             # never even opens the adapter -- while stamping a haunted recipe,\r\n  980:             # and nothing downstream could tell the two apart. The recipe id is\r\n  981:             # a constant, so it can only say WHICH lane ran, never WHAT it\r\n  982:             # applied.\r\n  983:             \"domain_adapter\": self.lora_name,\r\n  984:             \"domain_adapter_strength\": (\r\n  985:                 float(self.lora_strength) if self.lora_name else None),\r\n  986:             \"render_canvas\": \"%dx%d\" % (GHOST_CANVAS_W, GHOST_CANVAS_H),\r\n  987:             \"vram_peak_mb\": None,        # no measurement campaign was authorized\r\n  988:         }\r\n  989:         raw.update(_ghost_cadence_receipts_for(self,\r\n  990:             plan[\"target_frame_count\"], plan[\"source_request\"]))\r\n  991:         _LOG.info(\r\n  992:             \"[OTR video] %s beat %s: T=%d U=%d requested=%d decoded=%d \"\r\n  993:             \"tail_trim=%d @ %dx%d -> %dx%d %s\",\r\n  994:             self.name, plan[\"shot_id\"], plan[\"target_frame_count\"], unique,\r\n  995:             plan[\"source_request\"], decoded, raw[\"cadence_tail_trim\"],\r\n  996:             GHOST_CANVAS_W, GHOST_CANVAS_H, GHOST_DELIVERY_W,\r\n  997:             GHOST_DELIVERY_H, GHOST_DELIVERY_SCALE_MODE)\r\n  998:         if self.lora_name:\r\n  999:             applied = float(self.lora_strength)\r\n 1000:             # Stated on EVERY haunted beat, because the operator reads the leg\r\n 1001:             # log to know what he is looking at and the recipe id cannot tell\r\n 1002:             # him which strength produced the picture.\r\n 1003:             _LOG.info(\"%s: domain adapter %s at strength %.4f\",\r\n 1004:                       self.name, self.lora_name, applied)\r\n 1005:             if applied == 0.0:\r\n 1006:                 # Not refused -- this is the legitimate adapter-off control arm\r\n 1007:                 # of a strength sweep. But it is INDISTINGUISHABLE from the\r\n 1008:                 # clean lane by eye, so it says so out loud rather than letting\r\n 1009:                 # a published episode quietly imply the adapter did something.\r\n 1010:                 _LOG.warning(\r\n 1011:                     \"%s: strength is 0.0, so ComfyUI returns the base model \"\r\n 1012:                     \"UNPATCHED -- this beat is the clean %s picture under a \"\r\n 1013:                     \"haunted receipt. That is the adapter-off control arm; if \"\r\n 1014:                     \"it was not meant, %s was not read.\",\r\n 1015:                     self.name, \"animatediff15_v3\", \"OTR_GHOST_HAUNTED_LORA_STRENGTH\")\r\n 1016:         return raw\r\n 1017: \r\n 1018:     def _release_sampling_patchers_before_decode(self, owners):\r\n 1019:         \"\"\"Detach and identity-remove the sampling patchers, outermost first.\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=440; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\wrapper_bridge.py' | Select-Object -Skip (\"'$start-1) -First 140 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  440:         try:                                      # fallback: move weights to CPU\r\n  441:             inner = getattr(patcher, \"model\", None)\r\n  442:             if inner is not None and hasattr(inner, \"to\"):\r\n  443:                 inner.to(\"cpu\")\r\n  444:                 detached += 1\r\n  445:         except Exception:  # noqa: BLE001\r\n  446:             pass\r\n  447:     try:\r\n  448:         import gc\r\n  449:         gc.collect()\r\n  450:         _mm.soft_empty_cache()\r\n  451:     except Exception:  # noqa: BLE001\r\n  452:         pass\r\n  453:     _LOG.warning(\r\n  454:         \"[OTR video] LOUD VRAM reclaim%s: detached %d resident model(s) \"\r\n  455:         \"(encoder eviction; no unload_all_models)\",\r\n  456:         (\" (%s)\" % reason) if reason else \"\", detached)\r\n  457:     return detached\r\n  458: \r\n  459: \r\n  460: def run_graph(graph, classes=None, *, terminal=None, free_after_use=False,\r\n  461:               keep=None, external_results=None, on_result=None,\r\n  462:               audit_node_ids=None, execution_records=None, evict_after_use=None):\r\n  463:     \"\"\"Execute a declarative node graph in dependency order; return the results.\r\n  464: \r\n  465:     ``graph`` maps ``node_id -> {\"class\": <class|name>, \"inputs\": {name: literal |\r\n  466:     Wire(src, slot)}, \"function\": optional}``. A class may be a resolved class\r\n  467:     object OR a name to look up in ``classes`` (the dict from resolve_graph_classes).\r\n  468:     Each node is instantiated, its ``FUNCTION`` method called with the