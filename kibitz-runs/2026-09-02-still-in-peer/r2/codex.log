    init_source = \"jump_segment_still\"\r\n 2665:     elif _segment_still:\r\n 2666:         _LOG.warning(\r\n 2667:             \"[OTR.render_driver] JUMP SEGMENT %d of shot %s KEEPS its mesh \"\r\n 2668:             \"fodder as init_image; its segment still %s is the background \"\r\n 2669:             \"plate, not the mesh subject\", int(segment_index or 0),\r\n 2670:             shot.get(\"shot_id\"), os.path.basename(_segment_still))\r\n 2671:     frame_count = segment_render_frames(shot, segment_index)\r\n 2672:     req = build_request(shot, {\"init_image\": init_image, \"audio_ref\": audio},\r\n 2673:                         frame_count, canvas)\r\n 2674:     # 3D image streams (chunk 5): hand the mesher the STABLE subject id so its\r\n 2675:     # GLB cache keys on the subject (char/object), not the per-beat still hash.\r\n 2676:     if _requires_fodder and _mesh_subject_id:\r\n 2677:         req[\"mesh_subject_id\"] = _mesh_subject_id\r\n 2678:     # ST-4 / pass-02 Gem-3: init observability stamped on the REQUEST's\r\n 2679:     # observability dict (the round-5 pattern, schema-real since the W7-pre\r\n 2680:     # builder migration); run_episode copies them to trace rows so the W7\r\n 2681:     # acceptance check is mechanical.\r\n 2682:     if _mesh_fodder_missing:\r\n 2683:         # LOUD trace degrade: a 3D mesh beat with no clean fodder minted -- the\r\n 2684:         # default \"none\" stamp (init_image is empty) would HIDE that we refused\r\n 2685:         # to mesh the scene still; surface it explicitly (mirrors i2v above).\r\n 2686:         req[\"observability\"][\"init_source\"] = \"missing_mesh_fodder\"\r\n 2687:         # (The separate `mesh_fodder_missing` boolean was removed 2026-08-28:\r\n 2688:         # it restated the durable `init_source` stamp on the same line, and\r\n 2689:         # only a direct-builder test ever read it.)\r\n 2690:     else:\r\n 2691:         req[\"observability\"][\"init_source\"] = (init_source if init_image\r\n 2692:                                                else \"none\")\r\n 2693:     req[\"observability\"][\"init_image\"] = (os.path.basename(init_image)\r\n 2694:                                           if init_image else \"\")\r\n 2695:     # Chunk A2 provenance (r2 codex M5): ADDITIVE observability -- which\r\n 2696:     # visual style governed this request. prompt_field_source joins below\r\n 2697:     # only when a pack field actually fed the prompt text.\r\n 2698:     req[\"observability\"][\"visual_style\"] = _vstyle.style_id\r\n 2699:     # FULL-FRAME landscape for EVERY non-talking-head engine (operator look-QA\r\n 2700:     # 2026-06-10 + 2026-06-14): build_request's default canvas is the HuMo\r\n 2701:     # PORTRAIT (480x832, the accepted talking-head pillarbox). LTX/Wan were given\r\n 2702:     # the landscape canvas in 2026-06-10, but the still/floor families\r\n 2703:     # (still_pan, station_card, still_motion, viz_green) STILL inherited the\r\n 2704:     # 480x832 portrait -> skinny-portrait b-roll pillarboxed in the 16:9 frame\r\n 2705:     # (2026-06-14 operator catch on still_pan). Give the composite landscape\r\n 2706:     # canvas to every engine EXCEPT the face families: audio_driven_face (HuMo)\r\n 2707:     # keeps its accepted portrait pillarbox; lipsync_overlay / character_3d align\r\n 2708:     # to a face. Both dims stay /32-friendly for the LTX latent grid; env-\r\n 2709:     # overridable via OTR_VIDEO_LANDSCAPE_CANVAS.\r\n 2710:     _canvas_fam = engine_family(str(shot.get(\"engine_id\") or \"\"), \"\")\r\n 2711:     # audio_driven_face (HuMo) renders PORTRAIT by default -> keep the accepted\r\n 2712:     # pillarbox. The humo_1.7B_169 variant declares render_aspect='wide' (832x480\r\n 2713:     # 16:9), so it JOINS the landscape composite like LTX (the clip scales to\r\n 2714:     # fill, no pillarbox). The aspect is the SELECTED engine's identity, not a\r\n 2715:     # global toggle. lipsync_overlay / character_3d always align to a