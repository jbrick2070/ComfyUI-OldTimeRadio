{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=2840; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 180 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 2840:     # published clause, and does nothing else. A branch that publishes NOTHING\r\n 2841:     # is never capped -- which is the whole point: the funnel used to cap every\r\n 2842:     # branch at `max(188, pre_transform_length)`, so branches that had promised\r\n 2843:     # nothing (the operator's verbatim OTR_LTX_RADIO_PROMPT override, the M4\r\n 2844:     # wall and its engineered composition tail, the 298-char announcer talking\r\n 2845:     # prompt) were handed zero headroom and lost their tails to any growth.\r\n 2846:     # Publish INSIDE the sub-path that composed the prompt, never at a shared\r\n 2847:     # assignment -- a sibling sub-path must not inherit a budget or a clause it\r\n 2848:     # never authored.\r\n 2849:     _prompt_char_budget = None\r\n 2850:     _prompt_protected_clause = None\r\n 2851:     # THE GHOST SIGNAL BRANCH (2026-08-22), and it runs BEFORE the shared visual prompt.\r\n 2852:     #\r\n 2853:     # CAPABILITY, NEVER AN ENGINE NAME. The branch fires on the engine's declared\r\n 2854:     # `prompt_profile`, resolved without assuming every id on a shot is\r\n 2855:     # registered -- a frozen ledger can carry an engine this build no longer\r\n 2856:     # ships, and `get_engine` on it would raise here rather than at the seam\r\n 2857:     # that actually cares.\r\n 2858:     #\r\n 2859:     # WHY IT OUTRANKS M4. Ghost owns its whole subject: it declares\r\n 2860:     # `accepts_still = False`, so nothing was minted for this beat and there is\r\n 2861:     # no still carrying the look. The ~900-char M4 identity/scene wall is a\r\n 2862:     # prompt written for a lane that HAS a still, and handing it to a 512x288\r\n 2863:     # SD1.5 sampler is how you get murk. The composer reads the same authorities\r\n 2864:     # M4 does -- the pack, the ledger motion clause, the beat's own mood and arc\r\n 2865:     # -- and states them in the order this model can act on.\r\n 2866:     #\r\n 2867:     # It also has to work for the CAST-TIME TEMPORARY SHOT, which is why it sits\r\n 2868:     # before every branch rather than inside one: ShotLock builds a request per\r\n 2869:     # beat through this same function long before the durable rows are minted.\r\n 2870:     _ghost_composed = False\r\n 2871:     #: TRUE ONLY on the Prompt v2 path. It suppresses the common banana funnel\r\n 2872:     #: below for this request and nothing else -- v2 has ALREADY applied the\r\n 2873:     #: route inside its shared finalizer, and letting the funnel transform an\r\n 2874:     #: already-transformed prompt would overwrite a real substitution receipt\r\n 2875:     #: with a zero-substitution one (the transform is idempotent, so the second\r\n 2876:     #: pass genuinely does nothing and would honestly report doing nothing).\r\n 2877:     _ghost_v2_finalized = False\r\n 2878:     _ghost_profile = (\r\n 2879:         getattr(_vreg.get_engine(_eng_id), \"prompt_profile\", None)\r\n 2880:         if _eng_id and _vreg.is_registered(_eng_id) else None)\r\n 2881:     if _ghost_profile == _gsp.GHOST_PROMPT_PROFILE:\r\n 2882:         # PROMPT v2 FIRST, and BEFORE the legacy character-sigil requirement.\r\n 2883:         # A present object is the whole authority for this beat: it carries the\r\n 2884:         # representation, the recurrence motif and the authored drawable leaf,\r\n 2885:         # and it requires no sigil. Absence is explicit v1 compatibility for a\r\n 2886:         # row frozen before this sprint. A present-but-MALFORMED object is\r\n 2887:         # neither -- it fails closed, because a silent v1 downgrade would look\r\n 2888:         # exactly like a healthy legacy replay.\r\n 2889:         _g_obj = shot.get(\"ghost_prompt\")\r\n 2890:         if _g_obj is not None:\r\n 2891:             try:\r\n 2892:                 _gsa.validate_ghost_prompt_object(_g_obj)\r\n 2893:             except _gsa.GhostAuthorError as exc:\r\n 2894:                 raise FamilyInputGap(\r\n 2895:                     \"Ghost Signal beat %s carries a malformed ghost_prompt \"\r\n 2896:                     \"(%s). A stamped object is the render authority for this \"\r\n 2897:                     \"lane; refusing rather than downgrading to the v1 composer.\"\r\n 2898:                     % (shot.get(\"shot_id\"), exc)) from exc\r\n 2899:             # THE CLOUD SAFETY HOOK IS PROVABLY INERT HERE, and it has to be:\r\n 2900:             # `_apply_visual_safety_prompt` fires only for a cloud engine, and\r\n 2901:             # it would append its clause AFTER this branch finalized, defeating\r\n 2902:             # both the component survival check and the token measurement.\r\n 2903:             if _is_cloud_video_engine(_eng_id):\r\n 2904:                 raise FamilyInputGap(\r\n 2905:                     \"Ghost Signal beat %s resolved to CLOUD engine %r. Prompt \"\r\n 2906:                     \"v2 finalizes its own prompt -- style, motif, leaf, law, \"\r\n 2907:                     \"banana receipt and measured window -- so a cloud peer \"\r\n 2908:                     \"would have a safety clause appended after finalization \"\r\n 2909:                     \"and past every check this branch just made.\"\r\n 2910:                     % (shot.get(\"shot_id\"), _eng_id))\r\n 2911:             _g_final = _gsa.finalize_ghost_prompt_v2(\r\n 2912:                 role=_shot_role, style=_vstyle, mode=_g_obj[\"mode\"],\r\n 2913:                 motif_cue=_g_obj[\"motif_cue\"],\r\n 2914:                 drawable_beat=_g_obj[\"drawable_beat\"],\r\n 2915:                 ledger_meta=(ledger or {}).get(\"meta\") or {})\r\n 2916:             _g_positive = str(_g_final[\"positive\"]).strip()\r\n 2917:             _g_negative = str(_g_final[\"negative\"]).strip()\r\n 2918:             req[\"text_prompt\"] = _g_positive\r\n 2919:             req[\"negative_prompt\"] = _g_negative\r\n 2920:             _stamp_prompt_meta(req, _gsp.GHOST_PROMPT_SOURCE, _g_positive,\r\n 2921:                                beat=_beat_id_for_shot(shot))\r\n 2922:             _g_obs = req.setdefault(\"observability\", {})\r\n 2923:             _g_obs[\"prompt_version\"] = _gsp.GHOST_PROMPT_VERSION_V2\r\n 2924:             _g_obs[\"negative_sha8\"] = hashlib.sha256(\r\n 2925:                 _g_negative.encode(\"utf-8\")).hexdigest()[:8]\r\n 2926:             _g_obs[\"negative_chars\"] = len(_g_negative)\r\n 2927:             _g_obs[\"prompt_slots\"] = list(_g_final.get(\"slots\")\r\n 2928:                                           or _gsp.GHOST_V2_SLOTS)\r\n 2929:             _g_obs[\"author_version\"] = _g_obj[\"author_version\"]\r\n 2930:             _g_obs[\"ghost_schema_version\"] = _g_obj[\"schema_version\"]\r\n 2931:             _g_obs[\"ghost_source\"] = _g_obj[\"source\"]\r\n 2932:             _g_obs[\"ghost_fallback_reason\"] = _g_obj[\"fallback_reason\"]\r\n 2933:             _g_obs[\"ghost_model_id\"] = _g_obj[\"model_id\"]\r\n 2934:             _g_obs[\"ghost_mode\"] = _g_obj[\"mode\"]\r\n 2935:             _g_obs[\"ghost_request_sha8\"] = _g_obj[\"request_sha256\"][:8]\r\n 2936:             _g_obs[\"ghost_output_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2937:             _g_obs[\"ghost_drawable_beat\"] = _g_obj[\"drawable_beat\"]\r\n 2938:             _g_obs[\"ghost_drawable_beat_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2939:             _g_obs[\"ghost_motif_cue\"] = _g_obj[\"motif_cue\"]\r\n 2940:             _g_obs[\"positive_clip_tokens\"] = _g_final[\"positive_clip_tokens\"]\r\n 2941:             _g_obs[\"positive_clip_windows\"] = _g_final[\"positive_clip_windows\"]\r\n 2942:             _g_obs[\"negative_clip_tokens\"] = _g_final[\"negative_clip_tokens\"]\r\n 2943:             _g_obs[\"negative_clip_windows\"] = _g_final[\"negative_clip_windows\"]\r\n 2944:             _g_obs[\"clip_window_max\"] = _g_final[\"clip_window_max\"]\r\n 2945:             _g_obs[\"clip_counter\"] = _g_final[\"clip_counter\"]\r\n 2946:             # The finalizer's OWN receipt, installed here so the funnel below\r\n 2947:             # does not run a second, idempotent transform over the same text.\r\n 2948:             _g_obs.update(_g_final[\"banana_receipt\"])\r\n 2949:             _ghost_v2_finalized = True\r\n 2950:             _ghost_composed = True\r\n 2951:             _LOG.warning(\r\n 2952:                 \"[OTR.render_driver] GHOST PROMPT v2: %s beat %s mode=%s \"\r\n 2953:                 \"source=%s composed %d chars / %d SD1 tokens in %d window(s), \"\r\n 2954:                 \"negative %d chars / %d tokens\",\r\n 2955:                 _shot_role, shot.get(\"shot_id\"), _g_obj[\"mode\"],\r\n 2956:                 _g_obj[\"source\"], len(_g_positive),\r\n 2957:                 _g_final[\"positive_clip_tokens\"],\r\n 2958:                 _g_final[\"positive_clip_windows\"], len(_g_negative),\r\n 2959:                 _g_final[\"negative_clip_tokens\"])\r\n 2960:     if _ghost_profile == _gsp.GHOST_PROMPT_PROFILE and not _ghost_composed:\r\n 2961:         # THE v1 COMPATIBILITY PATH, reached only when the row carries NO\r\n 2962:         # ghost_prompt -- a ledger frozen before Prompt v2, or a direct unit\r\n 2963:         # fixture. Every newly built Ghost preflight and row carries v2, so a\r\n 2964:         # production episode never lands here.\r\n 2965:         #\r\n 2966:         # The DRIVER resolves the live authorities; the composer stays pure and\r\n 2967:         # cycle-free. Deliberate: `_ltx_motion_role_key` and the exact-key\r\n 2968:         # `motion_registers` lookup already live here, and a second role-to-\r\n 2969:         # register table in the pure module is a table that drifts once.\r\n 2970:         _g_sids = shot.get(\"source_line_ids\")\r\n 2971:         _g_synthetic = (\r\n 2972:             str(shot.get(\"shot_id\") or \"\").endswith(_OPENING_MUSIC_SUFFIX)\r\n 2973:             or (isinstance(_g_sids, list) and not _g_sids\r\n 2974:                 and _shot_role in (\"announcer_visual\", \"music_visual\")))\r\n 2975:         _g_motion_key = _ltx_motion_role_key(\r\n 2976:             _shot_role, shot.get(\"shot_id\"), _g_synthetic)\r\n 2977:         _g_pack_register = (_vstyle.motion_registers[_g_motion_key]\r\n 2978:                             if _g_motion_key else \"\")\r\n 2979:         # The optional motion-clause pass was ripped 2026-08-27 (it was opt-in,\r\n 2980:         # default OFF, set by no profile, and the Ghost lane was excluded from\r\n 2981:         # it by capability anyway). Ghost resolves its action through the\r\n 2982:         # pack register / beat intent / neutral-action chain, which is what\r\n 2983:         # every production episode already did.\r\n 2984:         _g_clause = None\r\n 2985:         _g_sigil = str(shot.get(\"subject_sigil\") or \"\")\r\n 2986:         # A CHARACTER BEAT WITHOUT ITS DURABLE SIGIL IS A GAP, NOT A DEFAULT.\r\n 2987:         # `build_request` seeds every request with a generic 1940s-studio prompt,\r\n 2988:         # so required-input PRESENCE cannot prove this branch ran -- which is\r\n 2989:         # exactly why the miss is raised by name instead of being papered over by\r\n 2990:         # a seed that would render a lane-wrong picture and look fine doing it.\r\n 2991:         if _shot_role == \"character_video\" and not _g_sigil:\r\n 2992:             raise FamilyInputGap(\r\n 2993:                 \"Ghost Signal beat %s is a character_video shot with no \"\r\n 2994:                 \"subject_sigil. The durable identity is stamped by \"\r\n 2995:                 \"otr_shot_lock.build_execution_plan and this lane cannot \"\r\n 2996:                 \"compose a character without it -- the generic request seed is \"\r\n 2997:                 \"NOT acceptable evidence that a Ghost prompt was built.\"\r\n 2998:                 % (shot.get(\"shot_id\"),))\r\n 2999:         _g_open_subject = \"\"\r\n 3000:         if _shot_role == \"music_visual\":\r\n 3001:             try:\r\n 3002:                 from .._otr_story_brief_helpers import (  # type: ignore\r\n 3003:                     get_open_subject as _g_open)\r\n 3004:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3005:                 from _otr_story_brief_helpers import (  # type: ignore\r\n 3006:                     get_open_subject as _g_open)\r\n 3007:             _g_open_subject = _g_open(\r\n 3008:                 _shot_role, _g_synthetic, (ledger or {}).get(\"meta\") or {},\r\n 3009:                 _vstyle)\r\n 3010:         _g_out = _gsp.compose_ghost_prompt(\r\n 3011:             role=_shot_role, style=_vstyle, subject_sigil=_g_sigil,\r\n 3012:             motion_clause=_g_clause, pack_motion_fallback=_g_pack_register,\r\n 3013:             beat_intent=str(line.get(\"beat_intent\") or \"\"),\r\n 3014:             emotion=str(line.get(\"traits\") or \"\"),\r\n 3015:             story_accent=str(line.get(\"arc_phase\") or \"\"),\r\n 3016:             open_subject=_g_open_subject,\r\n 3017:             sigil_seed=_seed_from_hash(\r\n 3018:                 str(shot.get(\"render_request_hash\") or \"\"),\r\n 3019:                 str(shot.get(\"shot_id\") or \"\")))\r\n","exit_code":0,"status":"completed"}}
