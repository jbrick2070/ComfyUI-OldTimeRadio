 ``observability`` field -- never top-level underscore\r\n353:    extras.\"\"\"\r\n354:    assets = assets or {}\r\n355:    portrait = assets.get(\"init_image\", \"\")\r\n356:    audio = assets.get(\"audio_ref\", \"\")\r\n357:    sid = shot[\"shot_id\"]\r\n358:    try:\r\n359:        idx = int(sid.rsplit(\"_\", 1)[-1])\r\n360:    except ValueError:\r\n361:        idx = 0\r\n362:    seed = (idx * 1009 + 7) & 0x7FFFFFFF\r\n363:    cw, ch = (canvas or (480, 832))\r\n364:    family = engine_family(str(shot.get(\"engine_id\") or \"\"),\r\n365:                           shot.get(\"family\")) or \"abstract\"\r\n366:    return {\r\n367:        \"shot_id\": sid, \"request_id\": sid,\r\n368:        \"role\": str(shot.get(\"role\") or \"\"),\r\n369:        \"family_hint\": family,\r\n370:        \"profile_id\": str(shot.get(\"profile_id\") or \"\"),\r\n371:        \"text_prompt\": \"a 1940s radio studio, on air sign illuminated, period broadcast set\",\r\n372:        \"asset_refs\": {\"init_image\": portrait} if portrait else {},\r\n373:        \"conditioning_refs\": {},\r\n374:        \"audio_ref\": {\"path\": audio} if audio else None,\r\n375:        \"base_clip_ref\": None,\r\n376:        \"timing\": {\"target_frame_count\": int(frame_count)},\r\n377:        \"canvas\": {\"w\": int(cw), \"h\": int(ch), \"fps\": 25, \"aspect_policy\": \"pad\"},\r\n378:        \"seed_bundle\": {\"request_seed\": seed},\r\n379:        \"observability\": {},\r\n380:    }\r\n381:\r\n382:\r\n383:# --------------------------------------------------------------------------- #\r\n384:# Per-beat audio slice from the frozen master mix (read-only).\r\n385:#\r\n4025:    return record\r\n4026:\r\n4027:\r\n4028:#: The ACTUAL render receipt (campaign item 0, 2026-09-02). One per rendered\r\n4029:#: segment, built from what the engine CONSUMED (the request) and RETURNED (the\r\n4030:#: canonical clip) plus the engine's own account of its sampler inputs and model\r\n4031:#: artifacts. ``actual_request_sha`` hashes the CAUSAL fields only, so two A/A\r\n4032:#: nulls of the same frozen ledger produce the same digest and a changed graph\r\n4033:#: setting, still, adapter strength or prompt produces a different one; wall\r\n4034:#: seconds, the peak and the run id ride beside it and never enter the hash.\r\n4035:RENDER_RECEIPT_VERSION = \"render_receipt_v1\"\r\n4036:_RECEIPT_CAUSAL_KEYS = (\r\n4037:    \"receipt_version\", \"engine_id\", \"recipe_id\", \"implementation_version\", \"family\",\r\n4038:    \"role\", \"text_prompt\", \"negative_prompt\", \"seed\", \"comparison_seed_hash\",\r\n4039:    \"target_frame_count\", \"canvas\", \"still_sha256\", \"sampler_inputs\",\r\n4040:    \"model_artifacts\",\r\n4041:)\r\n4042:_ARTIFACT_DIGESTS: dict = {}\r\n4043:\r\n4044:\r\n4045:def _artifact_digest(path):\r\n4046:    \"\"\"sha256 of a model file, computed ONCE per process per (path, size, mtime)\r\n4047:    -- a 2 GB checkpoint is hashed on the first clip and looked up after.\"\"\"\r\n4048:    try:\r\n4049:        st = os.stat(path)\r\n4050:    except OSError:\r\n4051:        return None\r\n4052:    key = (os.path.abspath(path), st.st_size, st.st_mtime_ns)\r\n4053:    hit = _ARTIFACT_DIGESTS.get(key)\r\n4054:    if hit:\r\n4055:        return hit\r\n4056:    h = hashlib.sha256()\r\n4057:    with open(path, \"rb\") as fh:\r\n4058:        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\r\n4059:            h.update(chunk)\r\n4060:    digest = {\"sha256\": h.hexdigest(), \"bytes\": int(st.st_size)}\r\n4061:    _ARTIFACT_DIGESTS[key] = digest\r\n4062:    return digest\r\n4063:\r\n4064:\r\n4065:def _file_sha256(path):\r\n4066:    try:\r\n4067:        h = hashlib.sha256()\r\n4068:        with open(path, \"rb\") as fh:\r\n4069:            for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\r\n4070:                h.update(chunk)\r\n4071:        return h.hexdigest()\r\n4072:    except OSError:\r\n4073:        return None\r\n4074:\r\n4075:\r\n4076:def _req_get(request, key, default=None):\r\n4077:    if isinstance(request, dict):\r\n4078:        return request.get(key, default)\r\n4079:    return getattr(request, key, default)\r\n4080:\r\n4081:\r\n4082:def build_actual_receipt(engine, shot, request, clip, *, segment=None,\r\n4083:                         wall_s=None):\r\n4084:    \"\"\"The ACTUAL receipt for one rendered segment. Pure over its inputs except\r\n4085:    for the artifact digests, which are read from disk once per process.\"\"\"\r\n4086:    seeds = _req_get(request, \"seed_bundle\") or {}\r\n4087:    timing = _req_get(request, \"timing\") or {}\r\n4088:    canvas = _req_get(request, \"canvas\") or {}\r\n4089:    refs = _req_get(request, \"asset_refs\") or {}\r\n4090:    obs = _req_get(request, \"observability\") or {}\r\n4091:    s_get = seeds.get if isinstance(seeds, dict) else (lambda k, d=None: getattr(seeds, k, d))\r\n4092:    t_get = timing.get if isinstance(timing, dict) else (lambda k, d=None: getattr(timing, k, d))\r\n4093:    c_get = canvas.get if isinstance(canvas, dict) else (lambda k, d=None: getattr(canvas, k, d))\r\n4094:    r_get = refs.get if isinstance(refs, dict) else (lambda k, d=None: getattr(refs, k, d))\r\n4095:    still = str(r_get(\"init_image\") or \"\")\r\n4096:    sampler_inputs = None\r\n4097:    fn = getattr(engine, \"sampler_inputs_for\", None)\r\n4098:    if callable(fn):\r\n4099:        try:\r\n4100:            sampler_inputs = fn(request)\r\n4101:        except Exception as exc:  # noqa: BLE001 -- a receipt must not fail a render\r\n4102:            sampler_inputs = {\"error\": \"%s: %s\" % (type(exc).__name__, exc)}\r\n4103:    artifacts = []\r\n4104:    afn = getattr(engine, \"model_artifacts\", None)\r\n4105:    if callable(afn):\r\n4106:        try:\r\n4107:            for name, path in afn() or ():\r\n4108:                if path:\r\n4109:                    artifacts.append({\"name\": str(name), \"path\": os.path.basename(str(path)),\r\n4110:                                      **(_artifact_digest(str(path)) or {\"sha256\": None, \"bytes\": None})})\r\n4111:        except Exception as exc:  # noqa: BLE001\r\n4112:            artifacts.append({\"name\": \"error\", \"path\": \"\", \"sha256\": None,\r\n4113:                              \"bytes\": None, \"error\": \"%s: %s\" % (type(exc).__name__, exc)})\r\n4114:    clip = clip if isinstance(clip, dict) else {}\r\n4115:    receipt = {\r\n4116:        \"receipt_version\": RENDER_RECEIPT_VERSION,\r\n4117:        \"engine_id\": str(getattr(engine, \"name\", \"\") or shot.get(\"engine_id\") or \"\"),\r\n4118:        \"recipe_id\": clip.get(\"recipe\") or getattr(engine, \"recipe_receipt_id\", None),\r\n4119:        \"implementation_version\": str(getattr(engine, \"implementation_version\", \"\") or \"\"),\r\n4120:        \"family\": str(clip.get(\"family\") or getattr(engine, \"family\", \"\") or \"\"),\r\n4121:        \"shot_id\": str(shot.get(\"shot_id\") or \"\"),\r\n4122:        \"beat_id\": str(shot.get(\"beat_id\") or \"\"),\r\n4123:        \"segment_index\": int(getattr(segment, \"index\", 0) or 0) if segment is not None else 0,\r\n4124:        \"role\": str(_req_get(request, \"role\") or shot.get(\"role\") or \"\"),\r\n4125:        \"text_prompt\": str(_req_get(request, \"text_prompt\") or \"\"),\r\n4126:        \"negative_prompt\": str(_req_get(request, \"negative_prompt\") or \"\"),\r\n4127:        \"prompt_sha8\": str((obs.get(\"prompt_sha8\") if isinstance(obs, dict) else \"\") or \"\"),\r\n4128:        \"seed\": int(s_get(\"request_seed\", 0) or 0),\r\n4129:        \"comparison_seed_hash\": str(shot.get(\"render_request_hash\") or \"\"),\r\n4130:        \"target_frame_count\": int(t_get(\"target_frame_count\", 0) or 0),\r\n4131:        \"canvas\": {\"w\": c_get(\"w\"), \"h\": c_get(\"h\"), \"fps\": c_get(\"fps\")},\r\n4132:        \"still_sha256\": _file_sha256(still) if still and os.path.isfile(still) else None,\r\n4133:        \"still_name\": os.path.basename(still) if still else None,\r\n4134:        \"sampler_inputs\": sampler_inputs,\r\n4135:        \"model_artifacts\": artifacts,\r\n4136:        # non-causal, beside the hash\r\n4137:        \"clip_path\": os.path.basename(str(clip.get(\"path\") or \"\")),\r\n4138:        \"frame_count\": clip.get(\"frame_count\"),\r\n4139:        \"vram_peak_mb\": clip.get(\"vram_peak_mb\"),\r\n4140:        \"wall_s\": (round(float(wall_s), 3) if wall_s is not None else None),\r\n4141:        \"status\": \"rendered\",\r\n4142:    }\r\n4143:    causal = {k: receipt.get(k) for k in _RECEIPT_CAUSAL_KEYS}\r\n4144:    receipt[\"actual_request_sha\"] = hashlib.sha256(\r\n4145:        json.dumps(causal, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True,\r\n4146:                   default=str).encode(\"utf-8\")).hexdigest()\r\n4147:    return receipt\r\n4148:\r\n4149:\r\n4150:def render_shot(shot, request, *, oom_engines=frozenset(), oom_shot_id=None,\r\n5140:        check_retired_engine(engine)         # NAMED refusal, after resolution\r\n5141:        if engine not in ENGINE_FAMILY and not _vreg.is_registered(engine):\r\n5142:            raise ValueError(\r\n5143:                \"OTR_FORCE_ENGINE_MAP names unknown engine %r\" % engine)\r\n5144:        out[role] = engine\r\n5145:    return out\r\n5146:\r\n5147:\r\n5148:def frozen_route_from_ledger(ledger):\r\n5149:    \"\"\"The frozen role -> effective-engine map ShotLock stamped, or ``{}``.\r\n5150:\r\n5151:    ``{}`` means this ledger never passed through the OTR_VideoDirector /\r\n5152:    OTR_ShotLock freeze: a legacy fixture, or one of the two shipped HTTP entry\r\n5153:    points (``/otr/video_render_single``, ``/otr/video_render_soak``) that build\r\n5154:    a ledger by hand with no OTR_VideoDirector upstream. Those keep the historic\r\n5155:    mutating behaviour -- see :func:`resolve_final_shot_engines`.\r\n5156:    \"\"\"\r\n5157:    section = (ledger or {}).get(\"video\") or {}\r\n5158:    frozen = section.get(\"roles_effective\")\r\n5159:    return dict(frozen) if isinstance(frozen, dict) and frozen else {}\r\n5160:\r\n5161:\r\n5162:def assert_frozen_route(ledger):\r\n5163:    \"\"\"VERIFY the frozen route instead of re-deriving it. Returns True if a\r\n5164:    frozen route was present (and therefore verified), False if there is none.\r\n5165:\r\n5166:    Never mutates. Raises :class:`RenderError` on ANY disagreement:\r\n5167:\r\n5168:    * the routing ENVIRONMENT moved since the freeze, so the frozen map no\r\n5169:      longer describes what will render;\r\n5170:    * a shot's engine/family is not what the freeze said it would be;\r\n5171:    * a shot disagrees with its own execution group.\r\n5172:\r\n5173:    WHY AN ASSERTION AND NOT A REPAIR (2026-07-25, chunk 1c). Repairing here is\r\n5174:    what the old code did, and it is why the defect survived so long: the\r\n5175:    render phase silently corrected a route the image phase had already planned\r\n5176:    stills for, so the two phases disagreed and only the pixels showed it. If\r\n5177:    the plan and the environment disagree at render time, the stills are\r\n5178:    already wrong and no mutation of the shot rows can un-mint them. Fail loud,\r\n5179:    before GPU time.\r\n5180:    \"\"\"\r\n5181:    frozen = frozen_route_from_ledger(ledger)\r\n5182:    if not frozen:\r\n5183:        return False\r\n5184:\r\n5185:    section = (ledger or {}).get(\"video\") or {}\r\n5186:    try:\r\n5187:        from .._otr_shared import route_freeze as _rf  # type: ignore\r\n5188:    except ImportError:  # pragma: no cover -- flat test imports\r\n5189:        from _otr_shared import route_freeze as _rf  # type: ignore\r\n5190:\r\n5191:    stamped_env = section.get(\"routing_env_snapshot\")\r\n5192:    if isinstance(stamped_env, dict) and stamped_env:\r\n5193:        live_env = _rf.routing_env_snapshot()\r\n5194:        if not _rf.snapshots_agree(stamped_env, live_env):\r\n5195:            raise RenderError(\r\n5196:                \"ROUTE EQUALITY: the routing environment changed after the \"\r\n5197:                \"plan was frozen (frozen %r, live %r). Every still and prompt \"\r\n5198:                \"in this episode was planned for the frozen route, so \"\r\n5199:                \"rendering the live one would render engines the image phase \"\r\n5200:                \"never minted assets for. Re-run from OTR_VideoDirector. \"\r\n5201:                \"NO FALLBACK.\" % (stamped_env, live_env))\r\n5202:\r\n5203:    groups_by_id = {}\r\n5204:    for grp in section.get(\"execution_groups\") or ():\r\n5205:        if isinstance(grp, dict):\r\n5206:            groups_by_id[str(grp.get(\"group_id\") or \"\")] = str(\r\n5207:                grp.get(\"engine_id\") or \"\")\r\n5208:\r\n5209:    for shot in section.get(\"shots\") or ():\r\n5210:        if not isinstance(shot, dict):\r\n5211:            continue\r\n5212:        role = str(shot.get(\"role\") or _role_of_shot(shot) or \"\")\r\n5213:        expected = str(frozen.get(role) or \"\")\r\n5214:        actual = str(shot.get(\"engine_id\") or \"\")\r\n5215:        if not expected:\r\n5216:            # A shot whose role the freeze never covered (2026-07-25 QA). The\r\n5217:            # docstring promises to catch ANY disagreement, and silently\r\n5218:            # skipping an unmapped role is the one hole that promise had: the\r\n5219:            # shot would render on whatever engine its row happens to carry,\r\n5220:            # unverified. Unreachable through OTR_VideoDirector, which fails\r\n5221:            # LOUD on an empty role before the freeze is taken -- so reaching\r\n5222:            # here means a hand-built or tampered ledger, and guessing is\r\n5223:            # exactly the wrong response to that.\r\n5224:            raise RenderError(\r\n5225:                \"ROUTE EQUALITY: shot %s carries role %r, which the frozen \"\r\n5226:                \"route does not cover (frozen roles: %s). A shot whose route \"\r\n5227:                \"was never frozen cannot be verified, so it must not render. \"\r\n5228:                \"NO FALLBACK.\" % (shot.get(\"shot_id\"), role,\r\n5229:                                  \", \".join(sorted(frozen)) or \"<none>\"))\r\n5230:        if actual != expected:\r\n5231:            raise RenderError(\r\n5232:                \"ROUTE EQUALITY: shot %s (role=%s) carries engine %r but the \"\r\n5233:                \"frozen route says %r. The plan and the shot rows disagree, so \"\r\n5234:                \"the stills were minted for a different engine than the one \"\r\n5235:                \"about to render. NO FALLBACK.\"\r\n5236:                % (shot.get(\"shot_id\"), role, actual, expected))\r\n5237:        grp_engine = groups_by_id.get(str(shot.get(\"group_id\") or \"\"))\r\n5238:        if grp_engine and actual and grp_engine != actual:\r\n5239:            raise RenderError(\r\n5240:                \"ROUTE EQUALITY: shot %s carries engine %r but its execution \"\r\n5241:                \"group %r carries %r. A shot must never diverge from its own \"\r\n5242:                \"group. NO FALLBACK.\"\r\n5243:                % (shot.get(\"shot_id\"), actual, shot.get(\"group_id\"), grp_engine))\r\n5244:\r\n5245:    # DEBUG, not INFO: this fires on every healthy episode and is verified\r\n5246:    # twice per render (otr_video_render_batch calls the check, then\r\n5247:    # run_real_episode calls it again as defence in depth). Success is not\r\n5248:    # news; only a mismatch is, and that raises.\r\n5249:    _LOG.debug(\r\n5250:        \"[OTR.render_driver] ROUTE EQUALITY OK: %d shot(s) match the frozen \"\r\n5251:        \"route %r\", len(section.get(\"shots\") or ()), frozen)\r\n5252:    return True\r\n5253:\r\n5254:\r\n5255:def assert_coverage_plans(ledger):\r\n5256:    \"\"\"THE SECOND BOUNDARY: re-validate every stamped coverage plan (chunk 3b).\r\n5257:\r\n5258:    ShotLock validated each plan when it built it; this validates the same\r\n5259:    plans again after they have crossed the wire, immediately before execution.\r\n5260:    Validating at both ends is the point -- a plan that survives serialization\r\n5261:    but not execution is precisely the class of defect a durable stamp is\r\n5262:    supposed to prevent, and only a second check at the far end can catch a\r\n5263:    ledger that was hand-edited, replayed from an older revision, or produced\r\n5264:    by a ShotLock built against a different contract.\r\n5265:\r\n5266:    Re-validated AGAINST THE LIVE CONTRACT, not just for internal arithmetic:\r\n5267:    an adapter whose declared frame contract changed since the plan was made\r\n5268:    (a version bump, a re-registered engine) must not silently execute a plan\r\n5269:    its current contract would reject.\r\n5270:\r\n5271:    Shots with no stamped plan are skipped -- see\r\n5272:    ``otr_shot_lock._stamp_coverage_plan`` for when that is legitimate.\r\n5273:\r\n5274:    ALSO RE-DERIVES THE EFFECTIVE CONTRACT (B3, 2026-07-26). The tier's\r\n5275:    ``max_render_frames`` ceiling narrows what the PLANNER may emit for the\r\n5276:    engines in ``frame_contract.PLANNING_CAP_ENGINES``, so the plan must be\r\n5277:    re-validated against the NARROWED contract here, not the declared one -- a\r\n5278:    161-frame segment is perfectly legal for ``ltx_8gb``'s declaration and\r\n5279:    illegal under a tier that pinned 65. The narrowed contract is also stamped\r\n5280:    beside the plan as ``shot[\"coverage_contract\"]``, re-derived here with the\r\n5281:    same two functions, and compared for EXACT equality. That comparison is\r\n5282:    what catches the cases arithmetic cannot: a ceiling that moved between\r\n5283:    plan time and render time, a receipt that appeared or vanished, and a shot\r\n5284:    whose engine was swapped after the stamp by the legacy force-map path\r\n5285:    (``resolve_final_shot_engines`` mutates and THEN calls this). A stamped\r\n5286:    receipt against a re-derived ``None`` is a refusal, and it should be: the\r\n5287:    plan was built under a ceiling the engine now rendering it does not honour.\r\n5288:    \"\"\"\r\n5289:    try:\r\n5290:        from . import coverage_plan as _cp  # type: ignore\r\n5291:        from . import frame_contract as _fc  # type: ignore\r\n5292:    except ImportError:  # pragma: no cover -- flat test imports\r\n5293:        import coverage_plan as _cp  # type: ignore\r\n5294:        import frame_contract as _fc  # type: ignore\r\n5295:\r\n5296:    # THE TIER CEILING, read ONCE off the ledger the plan rode in on, through\r\n5297:    # the SAME normalizer ``otr_shot_lock._planning_ceiling`` stamped it with\r\n5298:    # (B3). ``.get`` with no key present reads as unpinned, which is every\r\n5299:    # hand-built fixture and both HTTP entry points.\r\n5300:    ceiling = _fc.normalized_planning_ceiling(\r\n5301:        ((ledger or {}).get(\"video\") or {}).get(\"max_render_frames\"))\r\n5302:\r\n5303:    checked = 0\r\n5304:    for shot in ((ledger or {}).get(\"video\") or {}).get(\"shots\") or ():\r\n5305:        if not isinstance(shot, dict):\r\n5306:            continue\r\n5307:        raw = shot.get(\"coverage_plan\")\r\n5308:        if not isinstance(raw, dict) or not raw:\r\n5309:            continue\r\n5310:        plan = _cp.CoveragePlan.from_dict(raw)\r\n5311:        target = int(shot.get(\"target_frame_count\") or 0)\r\n5312:        if target and int(plan.target_visible_frames) != target:\r\n5313:            raise RenderError(\r\n5314:                \"COVERAGE PLAN: shot %s carries a plan for %d visible frame(s) \"\r\n5315:                \"but the beat's target is %d. The plan and the beat disagree, \"\r\n5316:                \"so the assembled clip would drift from the beat audio. \"\r\n5317:                \"NO FALLBACK.\" % (shot.get(\"shot_id\"),\r\n5318:                                  plan.target_visible_frames, target))\r\n5319:        contract = None\r\n5320:        engine_id = str(shot.get(\"engine_id\") or \"\")\r\n5321:        if engine_id and _vreg.is_registered(engine_id):\r\n5322:            try:\r\n5323:                contract = _fc.frame_contract_for(_vreg.get_engine(engine_id))\r\n5324:            except Exception:  # noqa: BLE001 -- arithmetic-only check instead\r\n5325:                contract = None\r\n5326:        # THE EFFECTIVE CONTRACT + ITS RECEIPT (B3), derived OUTSIDE the except\r\n5327:        # above: that catch means \"this adapter is unbuildable, fall back to an\r\n5328:        # arithmetic-only check\", and a misconfigured tier ceiling must not be\r\n5329:        # absorbed into it. ``PlanningCapError`` is a ValueError and is NOT a\r\n5330:        # ``CoveragePlanError``, so the narrow catch below would let it escape\r\n5331:        # this boundary unformatted -- wrap it here, named.\r\n5332:        effective = contract\r\n5333:        expected = None\r\n5334:        if contract is not None:\r\n5335:            try:\r\n5336:                effective = _fc.effective_frame_contract(\r\n5337:                    engine_id, contract, ceiling)\r\n5338:                expected = _fc.coverage_contract_receipt(\r\n5339:                    engine_id, contract, ceiling)\r\n5340:            except _fc.PlanningCapError as exc:\r\n5341:                raise RenderError(\r\n5342:                    \"COVERAGE PLAN: shot %s cannot be checked against this \"\r\n5343:                    \"tier's render-length ceiling: %s. NO FALLBACK.\"\r\n5344:                    % (shot.get(\"shot_id\"), exc)) from exc\r\n5345:        raw_receipt = shot.get(\"coverage_contract\")\r\n5346:        if raw_receipt is not None and not (\r\n5347:                isinstance(raw_receipt, dict) and raw_receipt):\r\n5348:            raise RenderError(\r\n5349:                \"COVERAGE CONTRACT: shot %s carries a coverage_contract of %r, \"\r\n5350:                \"which is not a receipt. An empty or malformed receipt is not \"\r\n5351:                \"the same as no receipt -- one means nothing narrowed, the \"\r\n5352:                \"other means the ledger is damaged. NO FALLBACK.\"\r\n5353:                % (shot.get(\"shot_id\"), raw_receipt))\r\n5354:        stamped = raw_receipt or None\r\n5355:        if contract is not None:\r\n5356:            if stamped != expected:\r\n5357:                raise RenderError(\r\n5358:                    \"COVERAGE CONTRACT: shot %s was planned under %r but this \"\r\n5359:                    \"ledger re-derives %r for engine %r at ceiling %d. The plan \"\r\n5360:                    \"was built against a contract that is no longer the one in \"\r\n5361:                    \"force -- a moved tier ceiling, a re-declared adapter, or \"\r\n5362:                    \"an engine swapped after the plan was stamped. NO FALLBACK.\"\r\n5363:                    % (shot.get(\"shot_id\"), stamped, expected,\r\n5364:                       engine_id or \"?\", ceiling))\r\n5365:        elif isinstance(stamped, dict):\r\n5366:            # The adapter will not resolve here, so the full receipt cannot be\r\n5367:            # re-derived -- but BOTH facts the receipt carries about its own\r\n5368:            # provenance can still be held to the ledger: the ceiling it was\r\n5369:            # planned under, and the engine it was planned FOR.\r\n5370:            #\r\n5371:            # THE ENGINE HALF WAS MISSING (2026-07-27, post-code panel, two\r\n5372:            # seats independently, each with a live repro). Comparing only the\r\n5373:            # ceiling let a stale ltx_8gb receipt ride a shot whose engine had\r\n5374:            # been swapped to something unregistered: same ceiling, no\r\n5375:            # contract to re-derive, and the fall-through validated the plan\r\n5376:            # arithmetic-only -- a plan built for an 8n+1 ladder accepted for\r\n5377:            # an engine never checked against any length. The registered-engine\r\n5378:            # branch above compares the whole receipt, engine id included; this\r\n5379:            # branch has to say the same thing with less information.\r\n5380:            if str(stamped.get(\"engine_id\") or \"\") != engine_id:\r\n5381:                raise RenderError(\r\n5382:                    \"COVERAGE CONTRACT: shot %s was planned for engine %r but \"\r\n5383:                    \"now carries %r, whose adapter cannot be resolved here. A \"\r\n5384:                    \"plan built under one engine's ceiling may not be executed \"\r\n5385:                    \"by another. NO FALLBACK.\"\r\n5386:                    % (shot.get(\"shot_id\"), stamped.get(\"engine_id\"),\r\n5387:                       engine_id or \"?\"))\r\n5388:            if _fc.normalized_planning_ceiling(\r\n5389:                    stamped.get(\"max_render_frames\")) != ceiling:\r\n5390:                raise RenderError(\r\n5391:                    \"COVERAGE CONTRACT: shot %s was planned under a \"\r\n5392:                    \"render-length ceiling of %r but this ledger carries %d, \"\r\n5393:                    \"and its adapter (%s) cannot be resolved here to re-derive \"\r\n5394:                    \"the rest. NO FALLBACK.\"\r\n5395:                    % (shot.get(\"shot_id\"), stamped.get(\"max_render_frames\"),\r\n5396:                       ceiling, engine_id or \"?\"))\r\n5397:        try:\r\n5398:            _cp.validate_coverage_plan(plan, effective)\r\n5399:        except _cp.CoveragePlanError as exc:\r\n5400:            raise RenderError(\r\n5401:                \"COVERAGE PLAN: shot %s carries a plan its adapter (%s) cannot \"\r\n5402:                \"execute: %s. NO FALLBACK.\"\r\n5403:                % (shot.get(\"shot_id\"), engine_id or \"?\", exc)) from exc\r\n5404:        checked += 1\r\n5405:    if checked:\r\n5406:        _LOG.debug(\"[OTR.render_driver] COVERAGE PLANS OK: %d shot(s)\", checked)\r\n5407:    return checked\r\n5408:\r\n5409:\r\n5410:def resolve_final_shot_engines(ledger):\r\nFILE nodes/OTR_LedgerScriptWriter.py\r\nFILE nodes/otr_shot_lock.py\r\nFILE nodes/otr_video_render_batch.py\r\nFILE scripts/otr_canonical_api_run.py\r\n85:    node_ref, widget = left.rsplit(\".\", 1)\r\n86:    nid = _node_id_for(workflow, node_ref)\r\n87:    value = _parse_value(raw_value)\r\n88:    patch_creative(workflow, nid, widget, value, schemas)\r\n89:    return f\"{node_ref}.{widget}={value!r}\"\r\n90:\r\n91:\r\n92:def _apply_writer_shortcuts(workflow: dict, schemas: dict, args) -> list[str]:\r\n93:    writer_id = _node_id_for(workflow, \"OTR_LedgerScriptWriter\")\r\n94:    shortcuts: list[tuple[str, Any]] = []\r\n95:    # `--words` was removed 2026-08-14 with the target_words widget. Episode\r\n96:    # shape is set with --act-count below; length is an observation.\r\n97:    if args.title is not None:\r\n98:        shortcuts.append((\"episode_title\", args.title))\r\n99:    if getattr(args, \"replay_from\", None):\r\n100:        # CANONICAL REPLAY (campaign item 0): a bundle directory, patched as a\r\n101:        # plain string through the creative whitelist -- never through the\r\n102:        # --set value parser, where a path that happens to parse as JSON would\r\n103:        # change type.\r\n104:        shortcuts.append((\"replay_from\", str(args.replay_from)))\r\n105:    if args.premise is not None:\r\n106:        shortcuts.append((\"custom_premise\", args.premise))\r\n107:    if args.source_bank is not None:\r\n108:        shortcuts.append((\"source_bank\", args.source_bank))\r\n109:    if args.visual_style is not None:\r\n110:        shortcuts.append((\"visual_style\", args.visual_style))\r\n111:    if args.creative_model is not None:\r\n112:        shortcuts.append((\"creative_writing_model\", args.creative_model))\r\n113:    if args.technical_model is not None:\r\n114:        shortcuts.append((\"technical_model\", args.technical_model))\r\n115:    if args.google_slot_a_model is not None:\r\n116:        shortcuts.append((\"google_api_slot_a_model\", args.google_slot_a_model))\r\n117:    if args.google_slot_b_model is not None:\r\n118:        shortcuts.append((\"google_api_slot_b_model\", args.google_slot_b_model))\r\n119:    if args.num_characters is not None:\r\n120:        shortcuts.append((\"num_characters\", int(args.num_characters)))\r\n121:    if args.act_count is not None:\r\n122:        shortcuts.append((\"act_count\", str(args.act_count)))\r\n123:\r\n124:    applied = []\r\n125:    for widget, value in shortcuts:\r\n126:        patch_creative(workflow, writer_id, widget, value, schemas)\r\n127:        applied.append(f\"OTR_LedgerScriptWriter.{widget}={value!r}\")\r\n128:    return applied\r\n129:\r\n130:\r\n131:def _schemas(offline: bool) -> dict:\r\n132:    if not offline:\r\n133:        return fetch_schemas()\r\n134:    from nodes import _otr_workflow_apply as workflow_apply\r\n135:\r\n136:    return workflow_apply.build_offline_schemas()\r\n137:\r\n138:\r\n139:def build_api_prompt(args) -> tuple[dict, list[str]]:\r\n140:    # Default: the canonical workflow, with the deliberate path assertion.\r\n141:    # Opt-in --workflow loads an EXPLICIT graph (the story-only scoring graph),\r\n142:    # which is a workflow change the caller has deliberately asked for -- not a\r\n143:    # silent smoke-vs-canonical drift. When --workflow is absent the behaviour is\r\n144:    # byte-identical to before.\r\n145:    explicit = getattr(args, \"workflow\", None)\r\n146:    if explicit:\r\n147:        wf_path = pathlib.Path(explicit).resolve()\r\n148:        if not wf_path.is_file():\r\n149:            raise SystemExit(f\"--workflow missing: {wf_path}\")\r\n150:        print(f\"[canonical-api] workflow={wf_path} (explicit --workflow)\", flush=True)\r\n151:    else:\r\n152:        wf_path = CANONICAL_WORKFLOW.resolve()\r\n153:        expected = (REPO_ROOT / \"workflows\" / \"otr_canonical.json\").resolve()\r\n154:        if wf_path != expected:\r\n155:            raise SystemExit(f\"canonical workflow path mismatch: {wf_path}\")\r\n156:        if not wf_path.is_file():\r\n157:            raise SystemExit(f\"canonical workflow missing: {wf_path}\")\r\n158:        print(f\"[canonical-api] workflow={wf_path}\", flush=True)\r\n159:    schemas = _schemas(args.offline_schemas)\r\n160:    workflow = load_workflow(str(wf_path))\r\n161:\r\n162:    applied: list[str] = []\r\n163:    if getattr(args, \"machine\", None):\r\n164:        # A machine key expands to the same dict a profile file would have\r\n165:        # produced. No file, no second applier -- config/machine_classes.json\r\n166:        # is the only place any of these values exist.\r\n167:        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n168:        from otr_machine_profile import build_profile, resolve\r\n169:        _prof = build_profile(resolve(args.machine))\r\n170:        workflow = apply_profile_to_workflow(workflow, _prof, schemas)\r\n171:        applied.append(\"machine=%s\" % args.machine)\r\n172:    elif args.profile and args.profile.lower() != \"none\":\r\n173:        workflow = apply_profile_to_workflow(workflow, args.profile, schemas)\r\n174:        applied.append(f\"profile={args.profile}\")\r\n175:        checked = _assert_profile_models_present(\r\n176:            args.profile, schemas, offline=bool(args.offline_schemas))\r\n177:        if checked:\r\n178:            print(\"[canonical-api] preflight: %d required model(s) visible to \"\r\n179:                  \"the server: %s\" % (len(checked), \", \".join(checked)),\r\n180:                  flush=True)\r\n181:\r\n182:    applied.extend(_apply_writer_shortcuts(workflow, schemas, args))\r\n183:    for patch in args.set:\r\n184:        applied.append(_apply_set(workflow, schemas, patch))\r\n185:\r\n186:    prompt = workflow_to_api_prompt(workflow, schemas)\r\n187:    return prompt, applied\r\n188:\r\n189:\r\n190:def _server_visible_model_names(schemas) -> set:\r\n191:    \"\"\"Every filename the SERVER offers in any node's combo, from /object_info.\r\n192:\r\n193:    Deliberately not folder_paths: this asks the running server what it can\r\n194:    actually see, which is the only authority that matters, and it needs no\r\n195:    knowledge of extra_model_paths.yaml or of which category a weight lives in.\r\n345:    # prints it as \"visible to the server\". Offline there is no server and\r\n346:    # nothing was verified, so claiming otherwise would contradict the notice\r\n347:    # printed above it in the same run.\r\n348:    return [] if offline else list(gateable)\r\n349:\r\n350:\r\n351:def main(argv: list[str] | None = None) -> int:\r\n352:    global COMFYUI_URL\r\n353:    parser = argparse.ArgumentParser(\r\n354:        description=\"Run the canonical OTR workflow through the ComfyUI API.\"\r\n355:    )\r\n356:    parser.add_argument(\r\n357:        \"--comfyui-url\", default=None,\r\n358:        help=\"running ComfyUI base URL (Desktop normally \"\r\n359:             \"http://127.0.0.1:8188; env/default remains available)\",\r\n360:    )\r\n361:    selector = parser.add_mutually_exclusive_group()\r\n362:    selector.add_argument(\r\n363:        \"--profile\", default=\"none\",\r\n364:        help=\"explicit capability profile id, e.g. none or otr_cloud_lanes\",\r\n365:    )\r\n366:    selector.add_argument(\r\n367:        \"--machine\", default=None,\r\n368:        help=\"a machine key from config/machine_classes.json \"\r\n369:             \"(8gb, 12gb, 16gb, amd). Expands to settings IN MEMORY -- \"\r\n370:             \"there is no per-machine profile file.\",\r\n371:    )\r\n372:    parser.add_argument(\"--title\", default=None)\r\n373:    parser.add_argument(\"--replay-from\", default=None, dest=\"replay_from\",\r\n374:                        help=\"CANONICAL REPLAY: a frozen replay bundle directory \"\r\n375:                             \"(scripts/otr_freeze_replay_bundle.py). The writer, \"\r\n376:                             \"cast, TTS, music and stills pass through frozen; \"\r\n377:                             \"only the video phase and the publish tail run.\")\r\n378:    parser.add_argument(\"--premise\", default=None)\r\n379:    parser.add_argument(\"--source-bank\", default=None)\r\n380:    parser.add_argument(\"--visual-style\", default=None)\r\n381:    parser.add_argument(\"--creative-model\", default=None)\r\n382:    parser.add_argument(\"--technical-model\", default=None)\r\n383:    parser.add_argument(\"--google-slot-a-model\", default=None)\r\n384:    parser.add_argument(\"--google-slot-b-model\", default=None)\r\n385:    parser.add_argument(\"--num-characters\", type=int, default=None)\r\n386:    parser.add_argument(\"--act-count\", default=None)\r\n387:    parser.add_argument(\r\n388:        \"--set\",\r\n389:        action=\"append\",\r\n390:        default=[],\r\n391:        metavar=\"NODE_OR_ID.widget=value\",\r\n392:        help=\"direct creative patch; managed engine widgets are refused\",\r\n393:    )\r\n394:    parser.add_argument(\"--dry-run\", action=\"store_true\",\r\n395:                        help=\"build and dump the API prompt without POST /prompt\")\r\n396:    parser.add_argument(\"--offline-schemas\", action=\"store_true\",\r\n397:                        help=\"use offline node schemas; for unit tests only\")\r\n398:    parser.add_argument(\"--workflow\", default=None,\r\n399:                        help=\"explicit workflow JSON path (opt-in; default = the \"\r\n400:                             \"canonical graph). Used for the story-only scoring \"\r\n401:                             \"graph (writer+freeze, no media).\")\r\n402:    parser.add_argument(\"--dump-prompt\", default=str(DEFAULT_PROMPT_DUMP))\r\n403:    parser.add_argument(\r\n404:        \"--timeout\",\r\n405:        type=int,\r\n406:        default=5400,\r\n407:        help=\"history observation timeout in seconds; 0 waits until terminal\",\r\n408:    )\r\n409:    parser.add_argument(\"--poll-s\", type=int, default=5)\r\n410:    args = parser.parse_args(argv)\r\n411:\r\n412:    if args.comfyui_url is