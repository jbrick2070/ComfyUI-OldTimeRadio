rr = m()\r\n  685:     npy = getattr(arr, \"numpy\", None)\r\n  686:     if callable(npy):\r\n  687:         arr = npy()\r\n  688:     arr = np.asarray(arr)\r\n  689:     if arr.ndim == 3:                              # a single frame -> a batch of 1\r\n  690:         arr = arr[None, ...]\r\n  691:     if arr.dtype != np.uint8:\r\n  692:         arr = np.clip(arr, 0.0, 1.0)\r\n  693:         arr = (arr * 255.0 + 0.5).astype(np.uint8)\r\n  694:     return np.ascontiguousarray(arr)\r\n  695: \r\n  696: \r\n  697: # ``extend_frames_to_target`` -- THE PING-PONG / MIRROR EXTENDER -- WAS DELETED\r\n  698: # HERE on 2026-08-02, under the operator's standing directive: \"no mirrors, no\r\n  699: # ping-pongs -- we need original video for every second of audio.\"\r\n  700: #\r\n  701: # What it did: tiled a short render into a mirror cycle\r\n  702: # ``[0,1,..,N-1,N-2,..,1]`` and trimmed it to the beat length, so a beat the\r\n  703: # engine could not afford in one pass was FILLED rather than left holding its\r\n  704: # last frame. That solved a real bug (the 0.68s-then-freeze) and it was the\r\n  705: # honest answer available in June, when the alternative was a frozen frame.\r\n  706: #\r\n  707: # Why it had to go rather than stay as an option: the back half of every cycle\r\n  708: # is the render played in REVERSE. On a lip-synced lane that is a mouth speaking\r\n  709: # backwards over forward speech. On a scene lane it is motion running backwards\r\n  710: # under dialogue that keeps going forward. It ships as a finished episode either\r\n  711: # way, and it looks like an artifact rather than a shot.\r\n  712: #\r\n  713: # WHAT OWNS THE PROBLEM NOW -- the field this rip had to fill. A beat the engine\r\n  714: # cannot render in one affordable pass is SPLIT by coverage planning into\r\n  715: # multiple native segments, each rendered forward, joined by chain or jump. That\r\n  716: # is the replacement, and it is strictly better: every frame is original, and no\r