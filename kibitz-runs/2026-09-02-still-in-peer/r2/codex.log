d. A\r\n  203:                 # raise here leaves through __enter__ -- and when __enter__\r\n  204:                 # raises, Python NEVER calls __exit__, so close(), teardown()\r\n  205:                 # and the lease release in teardown's own finally would all be\r\n  206:                 # skipped. The lease owner is the LIVE ComfyUI process, so the\r\n  207:                 # stale-lock reclaim (PID-liveness) cannot free it either: every\r\n  208:                 # later heavy render then blocks its full timeout until someone\r\n  209:                 # kills the server or deletes the lock dir by hand.\r\n  210:                 #\r\n  211:                 # This became reachable when session_identity() started doing\r\n  212:                 # real file I/O (it re-stats the weights on every ask, by\r\n  213:                 # design). Tear down what we took, THEN re-raise unchanged --\r\n  214:                 # close() is idempotent and never raises, so it cannot mask the\r\n  215:                 # original failure. BaseException on purpose: a KeyboardInterrupt\r\n  216:                 # in this window strands the lease exactly the same way.\r\n  217:                 self.close()\r\n  218:                 raise\r\n  219:         return self.prepared\r\n  220: \r\n  221:     def begin_segment(self, index, owner=None):\r\n  222:         \"\"\"RE-PROVE the handles, then hand them to segment ``index``.\r\n  223: \r\n  224:         The identity check is here rather than at open because drift happens\r\n  225:         BETWEEN segments -- an env flip while segment 1 was on the GPU. Asking\r\n  226:         once at the top would prove only that the beat started consistent.\r\n  227: \r\n  228:         THE INDEX IS THE CALLER'S, NOT A COUNTER (2026-07-26 QA, chunk-5 lens).\r\n  229:         An earlier draft let ``_render_one`` derive it by incrementing, which\r\n  230:         silently accepted an off-by-one loop, a retried segment relabelled as\r\n  231:         the next one, and two shots interleaved through one session. So the\r\n  232:         caller states which segment it is rendering and this refuses anything\r\n  233:         that is not the next one, in range: a session opened for 3 segments\r\n  234:         serves exactly segments 0, 1, 2, in that order, once each.\r\n  235: \r\n  236:         ``owner`` is the beat the caller believes it is rendering. Two beats on\r\n  237:         the same engine pass the engine check trivially, so without this a\r\n  238:         session held one loop too long would render beat B's shot from beat A's\r\n  239:         handles. Checked only when both sides name one -- a caller that claims\r\n  240:         nothing is not silently blessed, it simply has not made the claim.\r\n  241:         \"\"\"\r\n  242:         index = int(index)\r\n  243:         if self.prepared is None:\r\n  244:             raise SessionError(\r\n  245:                 \"beat session for %r is not open -- begin_segment before \"\r\n  246:                 \"open() would render with no handles\" % (self.beat_id or \"?\",))\r\n  247:         if not 0 <= index < self.segment_count:\r\n  248:             raise SessionError(\r\n  249:                 \"beat session for %r was opened for %d segment(s) but was \"\r\n  250:                 \"asked for segment %d. The count is what the adapter was told \"\r\n  251:                 \"at prepare time, so a segment outside it renders from handles \"\r\n  252:                 \"sized for a different beat.\"\r\n  253:                 % (self.beat_id or \"?\", self.segment_count, index))\r\n  254:         if index != self.segment_index + 1:\r\n  255:             raise SessionError(\r\n  256:                 \"beat session for %r last served segment %d and was asked for \"\r\n  257:                 \"%d. Segments render CONTIGUOUSLY forward, once each: a repeat \"\r\n  258:                 \"is a retry this build does not do, a step backwards is a loop \"\r\n  259:          