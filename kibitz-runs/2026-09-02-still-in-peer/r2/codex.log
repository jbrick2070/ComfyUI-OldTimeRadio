r time.\"\r\n  605:                 % (self.name, \", \".join(missing)), kind=\"video\")\r\n  606: \r\n  607:         for label, token, _category, path, floor in rows:\r\n  608:             try:\r\n  609:                 size = os.path.getsize(path)\r\n  610:             except OSError:\r\n  611:                 size = 0\r\n  612:             if size < floor:\r\n  613:                 raise EngineUnusable(\r\n  614:                     self.name, self.family, EngineUsabilityReason.MISSING_MODEL,\r\n  615:                     \"%s %s %r is only %d bytes (< the %d floor) -- that is a \"\r\n  616:                     \"truncated or wrong file, not the pinned artifact; \"\r\n  617:                     \"re-fetch it\" % (self.name, label, token, size, floor),\r\n  618:                     kind=\"video\")\r\n  619: \r\n  620:         from . import wrapper_bridge as _wb\r\n  621:         mapping = _wb.node_class_mappings()\r\n  622:         absent = []\r\n  623:         for _logical, candidates in self._node_candidates().items():\r\n  624:             try:\r\n  625:                 _wb.resolve_node_class(candidates, mapping)\r\n  626:             except Exception:  # noqa: BLE001 -- collect EVERY miss before raising\r\n  627:                 absent.append(\"/\".join(candidates))\r\n  628:         if absent:\r\n  629:             raise EngineUnusable(\r\n  630:                 self.name, self.family, EngineUsabilityReason.MISSING_MODEL,\r\n  631:                 \"%s missing required ComfyUI node class(es): %s -- Ghost Signal \"\r\n  632:                 \"needs the canonical Kosinkadink ComfyUI-AnimateDiff-Evolved \"\r\n  633:                 \"installed (see docs/2026-08-22-ghost-signal-dependency-lock\"\r\n  634:                 \".json for the pinned commit) and a server restart\"\r\n  635:                 % (self.name, \", \".join(absent)), kind=\"video\")\r\n  636:         return self.name\r\n  637: \r\n  638:     # ---- residency ------------------------------------------------------ #\r\n  639:     def load(self):\r\n  640:         \"\"\"Resolve CLASSES and artifact tokens only. No node runs here.\r\n  641: \r\n  642:         THIS OVERRIDE IS MANDATORY, not stylistic. ``MotionEngineBase.prepare``\r\n  643:         acquires the AS-3 lease and then unconditionally calls ``self.load()``;\r\n  644:         inheriting the base implementation would raise ``NotImplementedError``\r\n  645:         on every single beat.\r\n  646:         \"\"\"\r\n  647:         if not self._installed():\r\n  648:             missing = \", \".join(\r\n  649:                 token for token, path in (\r\n  650:                     (GHOST_CHECKPOINT_NAME, self._ckpt_path()),\r\n  651:                     (self.motion_module_name, self._motion_path()))\r\n  652:                 if not path)\r\n  653:             raise RuntimeError(\r\n  654:                 \"%s not installed: missing %s\" % (self.name, missing))\r\n  655:         from . import wrapper_bridge as _wb\r\n  656:         self._classes = _wb.resolve_graph_classes(self._node_candidates())\r\n  657:         self._artifacts = {\r\n  658:             \"checkpoint\": GHOST_CHECKPOINT_NAME,\r\n  659:             \"motion_module\": self.motion_module_name,\r\n  660:         }\r\n  661:         if self.lora_name:\r\n  662:             self._artifacts[\"domain_adapter\"] = self.lora_name\r\n  663:             self._artifacts[\"domain_adapter_strength\"] = float(\r\n  664:                 self.lora_strength)\r\n  665:         self._loaded = True\r\n  666: \r\n  667:     def unload(self):\r\n  668:         \"\"\"Clear GHOST-OWNED references only, then restore the base flags.\r\n  669: \r\n  670:         It never clears a global model registry and never calls\r\n  671:         ``unload_all_models`` (V-4 / V-5). The staged reclaim seam may detach\r\n  672:         loaded patchers; that is a different act from evicting the world.\r\n  673:         \"\"\"\r\n  674:         self._classes = None\r\n  675:         self._artifacts = None\r\n  676:         super().unload()\r\n  677: \r\n  678:     def prepare(self, host_caps, profile, session_ctx):\r\n  679:         \"\"\"Base prepare (lease + load), then execute ONLY the ``ckpt`` node.\r\n  680: \r\n  681:         The three outputs are split into SEPARATE one-slot handles and the\r\n  682:         combined result tuple is discarded, so a released family can never be\r\n  683:         retained by a tuple nobody remembered was holding it.\r\n  684:         \"\"\"\r\n  685:         prepared = super().prepare(host_caps, profile, session_ctx)\r\n  686:         from . import wrapper_bridge as _wb\r\n  687: \r\n  688:         classes = self._classes or _wb.resolve_graph_classes(\r\n  689:             self._node_candidates())\r\n  690: \r\n  691:         def _register_base(node_id, out_tuple):\r\n  692:             \"\"\"Register the base MODEL patcher THE MOMENT IT EXISTS.\r\n  693: \r\n  694:             A post-``run_graph`` scan is too late: the executor can evict\r\n  695:             between the return and the scan, and a patcher we never registered\r\n  696:             is a patcher teardown cannot detach.\"\"\"\r\n  697:             if node_id != NODE_CKPT:\r\n  698:                 return\r\n  699:             if len(out_tuple) != 3:\r\n  700:                 raise RuntimeError(\r\n  701:                     \"%s: CheckpointLoaderSimple returned %d outputs, expected \"\r\n  702:                     \"exactly 3 (MODEL, CLIP, VAE)\"\r\n  703:                     % (self.name, len(out_tuple)))\r\n  704:             model = out_tuple[0]\r\n  705:             if not callable(getattr(model, \"detach\", None)):\r\n  706:                 raise RuntimeError(\r\n  707:                     \"%s: the checkpoint MODEL has no callable detach() -- this \"\r\n  708:                     \"adapter cannot take ownership of a patcher it cannot \"\r\n  709:                     \"release, and proceeding would strand it resident\"\r\n  710:                     % self.name)\r\n  711:             self._patchers.append(model)\r\n  712: \r\n  713:         ckpt_out = _wb.run_graph(\r\n  714:             {NODE_CKPT: {\"class\": classes[\"checkpoint\"],\r\n  715:                          \"inputs\": {\"ckpt_name\": GHOST_CHECKPOINT_NAME}}},\r\n  716:             terminal=NODE_CKPT, on_result=_register_base)\r\n  717: \r\n  718:         if len(ckpt_out) != 3:\r\n  719:             raise RuntimeError(\r\n  720:                 \"%s: expected MODEL/CLIP/VAE from the checkpoint, got %d \"\r\n  721:                 \"output(s)\" % (self.name, len(ckpt_out)))\r\n  722: \r\n  723:         # SEPARATE ONE-SLOT HANDLES, and the three-slot tuple goes away here.\r\n  724:         prepared[\"base_model\"] = (ckpt_out[0],)\r\n  725:         prepared[\"clip\"] = (ckpt_out[1],)\r\n  726:         prepared[\"vae\"] = (ckpt_out[2],)\r\n  727:         prepared[\"recipe\"] = self._recipe_receipt()\r\n  728:         del ckpt_out\r\n  729:         return prepared\r\n  730: \r\n  731:     # ---- request -------------------------------------------------------- #\r\n  732:     def _build_render_request(self, request):\r\n  733:         \"\"\"PURE: the normalized plan this adapter renders from.\r\n  734: \r\n  735:         The negative is read from the REQUEST FIELD by name and a blank one is\r\n  736:         refused. There is deliberately no ``request.get(\"negative_prompt\") or\r\n  737:         <engine constant>`` here: an engine-side negative constant would let the\r\n  738:         lane render with lettering hygiene the composer never authored, and the\r\n  739:         receipt would describe a negative that did not come from the pack.\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=1; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\beat_session.py' | Select-Object -Skip (\"'$start-1) -First 180 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"    1: \"\"\"THE BEAT SESSION: one model load per BEAT, not one per segment.   26: and 2 used. Half a beat in one recipe and half in another is not a beat.   27: \r\n   28: AND AN ADAPTER MUST BE ABLE TO NAME ITS HANDLES. A multi-segment session whose\r\n   29: engine declares no ``session_identity`` is refused at OPEN, not silently\r\n   30: degraded to per-segment loading: handles nobody can name are handles nobody\r\n   31: can invalidate, and the whole reuse is only safe because the invalidation\r\n   32: works. Single-segment sessions never ask -- there is nothing to drift between.\r\n   33: \r\n   34: Cold-import clean (V-12): stdlib only at module scope.\r\n   35: \"\"\"\r\n   36: \r\n   37: from __future__ import annotations\r\n   38: \r\n   39: import logging\r\n   40: from typing import NamedTuple\r\n   41: \r\n   42: _LOG = logging.getLogger(\"OTR.beat_session\")\r\n   43: \r\n   44: __all__ = [\r\n   45:     \"SessionError\",\r\n   46:     \"SessionIdentityUnavailable\",\r\n   47:     \"SessionIdentityDrift\",\r\n   48:     \"session_identity\",\r\n   49:     \"BeatSession\",\r\n   50:     \"SegmentSlot\",\r\n   51: ]\r\n   52: \r\n   53: \r\n   54: class SessionError(RuntimeError):\r\n   55:     \"\"\"This beat session cannot be run as asked.\"\"\"\r\n   56: \r\n   57: \r\n   58: class SessionIdentityUnavailable(SessionError):\r\n   59:     \"\"\"A multi-segment session was asked for handles nobody can name.\"\"\"\r\n   60: \r\n   61: \r\n   62: class SessionIdentityDrift(SessionError):\r\n   63:     \"\"\"The recipe or the weights moved while the session was open.\"\"\"\r\n   64: \r\n   65: \r\n   66: def session_identity(engine):\r\n   67:     \"\"\"What this adapter's handles ARE -- engine, recipe, weights -- or None.\r\n   68: \r\n   69:     Adapters declare it with an optional ``session_identity()`` method or\r\n   70:     attribute, duck-typed exactly like ``frame_contract``. Return anything\r\n   71:     comparable and stable; a tuple of strings is the shape every caller\r\n   72:     expects. ``None`` (or no declaration) means the adapter does not offer\r\n   73:     one, which single-clip engines never need to.\r\n   74: \r\n   75:     DELIBERATELY NOT CACHED and deliberately NOT wrapped in a try/except. The\r\n   76:     entire job of this function is to notice a value that MOVED, so it is\r\n   77:     re-read every single time it is asked for; and an adapter whose identity\r\n   78:     read RAISES has told us it cannot describe its own handles, which is a\r\n   79:     reason to stop rather than a reason to guess.\r\n   80:     \"\"\"\r\n   81:     declared = getattr(engine, \"session_identity\", None)\r\n   82:     if declared is None:\r\n   83:         return None\r\n   84:     value = declared() if callable(declared) else declared\r\n   85:     if value is None:\r\n   86:         return None\r\n   87:     if isinstance(value, (list, tuple)):\r\n   88:         return tuple(str(part) for part in value)\r\n   89:     return (str(value),)\r\n   90: \r\n   91: \r\n   92: class BeatSession:\r\n   93:     \"\"\"ONE engine, ONE set of handles, ONE beat -- opened and closed once.\r\n   94: \r\n   95:     Use it as a context manager so the close is structural rather than\r\n   96:     remembered::\r\n   97: \r\n   98:         with BeatSession(eng, host_caps=caps, profile=prof,\r\n   99:                          beat_id=bid, segment_count=len(plan.segments)) as s:\r\n  100:             for i, seg in enumerate(plan.segments):\r\n  101:                 prepared = s.begin_segment(i)\r\n  102:                 raw = eng.render_clip(request_for(seg), prepared)\r\n  103: \r\n  104:     There are deliberately NO call counters on this object (cut 2026-07-26 on\r\n  105:     the QA panel's recommendation, and it was right): the acceptance counts\r\n  106:     LOADER calls on the ADAPTER, because an adapter that loads lazily inside\r\n  107:     ``render_clip`` shows one perfect ``prepare`` and three loads. A counter\r\n  108:     here would have measured the bracket, which is the thing that is obviously\r\n  109:     correct, instead of the loading, which is the thing that is not.\r\n  110:     \"\"\"\r\n  111: \r\n  112:     def __init__(self, engine, *, host_caps=None, profile=None, beat_id=\"\",\r\n  113:                  segment_count=1, coverage_planned=None):\r\n  114:         self.engine = engine\r\n  115:         self.host_caps = dict(host_caps or {})\r\n  116:         self.profile = dict(profile or {})\r\n  117:         self.beat_id = str(beat_id or \"\")\r\n  118:         self.segment_count = max(1, int(segment_count or 1))\r\n  119:         #: Is this beat COVERAGE-PLANNED? Distinct from \"does it have more than\r\n  120:         #: one segment\", and adapters need the former. ``None`` falls back to\r\n  121:         #: the segment count, which is what every caller meant before a\r\n  122:         #: one-segment plan could exist. See :meth:`session_ctx`.\r\n  123:         self.coverage_planned = (bool(coverage_planned)\r\n  124:                                  if coverage_planned is not None else None)\r\n  125:         self.prepared = None\r\n  126:         self.identity = None\r\n  127:         self.segment_index = -1\r\n  128:         self._closed = False\r\n  129: \r\n  130:     @property\r\n  131:     def is_multi_segment(self):\r\n  132:         return self.segment_count > 1\r\n  133: \r\n  134:     def session_ctx(self):\r\n  135:         \"\"\"The dict handed to ``prepare``.\r\n  136: \r\n  137:         It was ``{}`` at every call site before this chunk. An adapter that\r\n  138:         wants to size a KV cache, pre-allocate, or simply log honestly needs\r\n  139:         to know it is about to render four clips rather than one -- and it\r\n  140:         must learn that BEFORE it loads, which is the only reason this is a\r\n  141:         prepare-time argument rather than a render-time one.\r\n  142: \r\n  143:         ``multi_clip`` MEANS \"coverage-planned\", not \"more than one segment\"\r\n  144:         (corrected 2026-08-02). ``WanTi2vEngine.render_clip`` branches on it to\r\n  145:         choose ``_planned_length`` over ``_floor_length``.\r\n  146: \r\n  147:         THE ORIGINAL STAKES ARE HISTORY, and the distinction outlived them. The\r\n  148:         clip-fill path selected when False used to PING-PONG-EXTEND a short\r\n  149:         render, so deriving the flag from ``segment_count > 1`` would have routed\r\n  150:         a one-segment coverage plan carrying a tail trim straight into the mirror\r\n  151:         the operator ruled out. That mirror is now DELETED -- a short render on\r\n  152:         an audio-synced lane is terminal and loud (``MirrorExtensionForbidden``),\r\n  153:         and the LTX boomerang went with it on 2026-08-06.\r\n  154: \r\n  155:         The flag is still passed in rather than derived, because the two\r\n  156:         questions remain genuinely different: a one-segment plan IS\r\n  157:         coverage-planned, and the length authority it deserves is the plan's, not\r\n  158:         the adapter's floor. What changed is the consequence of getting it wrong\r\n  159:         -- a loud refusal instead of a silent mirror. It falls back to the\r\n  160:         segment count only when a caller does not say, which is what every\r\n  161:         pre-existing caller meant.\r\n  162:         \"\"\"\r\n  163:         planned = (self.coverage_planned if self.coverage_planned is not None\r\n  164:                    else self.is_multi_segment)\r\n  165:         return {\"beat_id\": self.beat_id,\r\n  166:                 \"segment_count\": self.segment_count,\r\n  167:                 \"multi_clip\": planned,\r\n  168:                 \"coverage_planned\": planned}\r\n  169: \r\n  170:     def open(self):\r\n  171:         \"\"\"Take the handles ONCE. Raises before loading anything if a\r\n  172:         multi-segment beat cannot name what it is about to reuse.\"\"\"\r\n  173:         if self.prepared is not None:\r\n  174:             raise SessionError(\r\n  175:                 \"beat session for %r is already open -- a second open would \"\r\n  176:                 \"strand the first set of handles\" % (self.beat_id or \"?\",))\r\n  177:         if self.is_multi_segment:\r\n  178:             # ASK BEFORE LOADING, BASELINE AFTER (2026-07-26, chunk-5 QA panel).\r\n  179:             # The refusal has to come before the weights land -- refusing after\r\n  180:             # a 10 GB load is not refusing. But the BASELINE is captured after\r\n","exit_code":0,"status":"completed"}}
