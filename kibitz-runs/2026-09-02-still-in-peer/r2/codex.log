451:    except Exception:  # noqa: BLE001\r\n452:        pass\r\n453:    _LOG.warning(\r\n454:        \"[OTR video] LOUD VRAM reclaim%s: detached %d resident model(s) \"\r\n455:        \"(encoder eviction; no unload_all_models)\",\r\n456:        (\" (%s)\" % reason) if reason else \"\", detached)\r\n457:    return detached\r\n458:\r\n459:\r\n460:def run_graph(graph, classes=None, *, terminal=None, free_after_use=False,\r\n461:              keep=None, external_results=None, on_result=None,\r\n462:              audit_node_ids=None, execution_records=None, evict_after_use=None):\r\n463:    \"\"\"Execute a declarative node graph in dependency order; return the results.\r\n464:\r\n465:    ``graph`` maps ``node_id -> {\"class\": <class|name>, \"inputs\": {name: literal |\r\n466:    Wire(src, slot)}, \"function\": optional}``. A class may be a resolved class\r\n467:    object OR a name to look up in ``classes`` (the dict from resolve_graph_classes).\r\n468:    Each node is instantiated, its ``FUNCTION`` method called with the resolved\r\n469:    inputs, and its return normalised to a tuple. Returns ``{node_id: out_tuple}``;\r\n470:    when ``terminal`` is given returns that node's tuple directly. Fail-closed: a\r\n471:    missing class / cycle / a node raising becomes a NAMED GraphExecutionError\r\n472:    (never a silent partial render).\r\n473:\r\n474:    ``free_after_use`` mirrors ComfyUI's executor memory model: a node's outputs\r\n475:    are dropped (and a soft VRAM reclaim run) once every later consumer has run,\r\n488:    classic patcher is released by the reference drop alone, so the classic path is\r\n489:    unchanged. Requires ``free_after_use``; every id must exist in the graph and must\r\n490:    not be in ``keep`` -- both are NAMED errors, not silent no-ops.\r\n491:\r\n492:    ``external_results`` maps node id -> an ALREADY-PRODUCED output tuple the\r\n493:    caller owns (a BeatSession's beat-scoped MODEL/CLIP/VAE handles). Those ids\r\n494:    are legal Wire sources, are never executed, and are added to ``keep`` so a\r\n495:    ``free_after_use`` pass cannot evict a handle the NEXT segment still needs --\r\n496:    without that the first segment's cleanup drops them and segment 1 dies on\r\n497:    \"output slot unavailable\". An id present in both ``graph`` and\r\n498:    ``external_results`` is a NAMED error, not a silent precedence rule. Values\r\n499:    are normalised to tuples exactly like an executed node's output. This stays\r\n500:    ENGINE-AGNOSTIC: it knows nothing about which ids or arities any adapter\r\n501:    hoists -- that contract belongs to the adapter's ``prepare()``.\r\n502:\r\n503:    ``on_result(node_id, out_tuple)`` fires immediately after each EXECUTED\r\n504:    node's output is normalised (never for an external), so a caller can\r\n505:    register a detachable handle the moment it exists. A raising callback is\r\n506:    surfaced NAMED and aborts the graph -- the caller is telling us it cannot\r\n507:    take ownership, which is a reason to unwind, not to continue.\r\n508:\r\n509:    ``audit_node_ids`` opts named nodes into executor-owned positive evidence.\r\n510:    After the real FUNCTION returns, the executor appends one structured record\r\n511:    to the caller's EMPTY ``execution_records`` list and writes the same record\r\n512:    as a compact ``[OTR graph-exec]`` JSON log line. Externals never count.\r\n513:    The adapter chooses what it needs proved; only this executor can say the\r\n514:    node actually returned and what shape it returned.\"\"\"\r\n515:    classes = classes or {}\r\n575:            raise GraphExecutionError(\"node %r has no class\" % nid)\r\n576:        fn_name = node.get(\"function\") or getattr(cls, \"FUNCTION\", None)\r\n577:        if not fn_name:\r\n578:            raise GraphExecutionError(\r\n579:                \"node %r class %r has no FUNCTION\" % (nid, getattr(cls, \"__name__\", cls)))\r\n580:        inst = cls() if isinstance(cls, type) else cls\r\n581:        fn = getattr(inst, fn_name, None)\r\n582:        if not callable(fn):\r\n583:            raise GraphExecutionError(\r\n584:                \"node %r function %r not callable\" % (nid, fn_name))\r\n585:        kwargs = {k: _resolve_value(v, results)\r\n586:                  for k, v in (node.get(\"inputs\") or {}).items()}\r\n587:        try:\r\n588:            out = normalize_node_output(fn(**kwargs))\r\n589:        except Exception as exc:  # noqa: BLE001 -- surfaced NAMED, never silent\r\n590:            raise GraphExecutionError(\r\n591:                \"node %r (%s) raised %s: %s\"\r\n592:                % (nid, fn_name, type(exc).__name__, exc))\r\n593:        results[nid] = out if isinstance(out, tuple) else (out,)\r\n594:        if nid in audit_ids:\r\n595:            audit_ordinal += 1\r\n596:            record = {\r\n597:                \"class_name\": getattr(cls, \"__name__\", type(cls).__name__),\r\n598:                \"node_id\": str(nid),\r\n599:                \"ordinal\": audit_ordinal,\r\n600:                \"output_shapes\": _execution_shape(results[nid]),\r\n601:            }\r\n602:            if execution_records is not None:\r\n603:                execution_records.append(record)\r\n604:            _LOG.info(\"[OTR graph-exec] %s\", json.dumps(\r\n605:                record, sort_keys=True, separators=(\",\", \":\")))\r\n606:        if on_result is not None:\r\n607:            try:\r\n608:                on_result(nid, results[nid])\r\n665:    n -= n % 2\r\n666:    return max(2, n)\r\n667:\r\n668:\r\n669:# --------------------------------------------------------------------------- #\r\n670:# IMAGE-batch -> uint8 frames (numpy lazy; CPU-testable with a numpy array)\r\n671:# --------------------------------------------------------------------------- #\r\n672:def images_to_uint8(images):\r\n673:    \"\"\"A ComfyUI IMAGE batch -> a contiguous uint8 numpy array shaped (B,H,W,C).\r\n674:\r\n675:    ComfyUI IMAGE tensors are float32 in [0,1], shape (B,H,W,C) with C=3 (RGB).\r\n676:    Accepts a torch tensor (duck-typed via .detach().cpu().numpy()) OR a numpy\r\n677:    array, so the conversion math is CPU-testable without torch. numpy is imported\r\n678:    lazily (kept off the cold-import path).\"\"\"\r\n679:    import numpy as np\r\n680:    arr = images\r\n681:    for attr in (\"detach\", \"cpu\"):\r\n682:        m = getattr(arr, attr, None)\r\n683:        if callable(m):\r\n684:            arr = m()\r\n685:    npy = getattr(arr, \"numpy\", None)\r\n686:    if callable(npy):\r\n687:        arr = npy()\r\n688:    arr = np.asarray(arr)\r\n689:    if arr.ndim == 3:                              # a single frame -> a batch of 1\r\n690:        arr = arr[None, ...]\r\n691:    if arr.dtype != np.uint8:\r\n692:        arr = np.clip(arr, 0.0, 1.0)\r\n693:        arr = (arr * 255.0 + 0.5).astype(np.uint8)\r\n694:    return np.ascontiguousarray(arr)\r\n695:\r\n696:\r\n697:# ``extend_frames_to_target`` -- THE PING-PONG / MIRROR EXTENDER -- WAS DELETED\r\n698:# HERE on 2026-08-02, under the operator's standing directive: \"no mirrors, no\r\nFILE nodes/_otr_video_engines/eng_ghost_signal.py\r\n140:NODE_CONTEXT = \"context\"\r\n141:NODE_ADE = \"ade\"\r\n142:NODE_LATENT = \"latent\"\r\n143:NODE_SAMPLER = \"sampler\"\r\n144:NODE_DECODE = \"decode\"\r\n145:#: Built ONLY on a lane that declares ``lora_name`` -- see the seam below.\r\n146:NODE_LORA = \"lora\"\r\n147:\r\n148:#: The SEVEN unique class ids the eight instances resolve to (the repeated text\r\n149:#: class is resolved once). ONE NAME PER ALIAS -- never alternative spellings.\r\n150:#: A miss stops the build; it does not activate runtime probing or a fallback\r\n151:#: node. Every one of these was confirmed live in the Phase-0 capture at\r\n152:#: docs/2026-08-22-ghost-signal-object-info.json.\r\n153:GHOST_NODE_CANDIDATES = {\r\n154:    \"checkpoint\": (\"CheckpointLoaderSimple\",),\r\n155:    \"text_encode\": (\"CLIPTextEncode\",),\r\n156:    \"context\": (\"ADE_StandardStaticContextOptions\",),\r\n157:    \"ade\": (\"ADE_AnimateDiffLoaderGen1\",),\r\n158:    \"latent\": (\"EmptyLatentImage\",),\r\n159:    \"sampler\": (\"KSampler\",),\r\n160:    \"decode\": (\"VAEDecode\",),\r\n161:}\r\n162:\r\n163:#: The ADE optional sockets this lane deliberately leaves UNCONNECTED. Pinned as\r\n164:#: a set so a test can prove the runtime input dictionary contains none of them\r\n165:#: -- omission is the contract, and an invented ``None`` would not be omission.\r\n430:            \"latent\": \"EmptyLatentImage\", \"init_image\": None,\r\n431:        }\r\n432:\r\n433:    def model_artifacts(self):\r\n434:        \"\"\"``[(name, path)]`` of the weight files this lane loads, for the render\r\n435:        receipt's once-per-run digest table.\"\"\"\r\n436:        out = [(\"checkpoint\", self._ckpt_path() or \"\"),\r\n437:               (\"motion_module\", self._motion_path() or \"\")]\r\n438:        lora = getattr(self, \"lora_name\", \"\")\r\n439:        if lora:\r\n440:            out.append((\"adapter\", self._lora_path() or \"\"))\r\n441:        return out\r\n442:\r\n443:    @staticmethod\r\n444:    def _file_receipt(path):\r\n445:        \"\"\"``(size, mtime_ns)`` for a resolved artifact, or ``None``.\r\n446:\r\n447:        Re-stat'ed on every ask rather than cached: the job is to NOTICE a\r\n448:        weight that moved, and two stats are cheap where a hash of 3.9 GB is\r\n449:        not.\"\"\"\r\n450:        try:\r\n451:            st = os.stat(path)\r\n452:        except OSError:\r\n453:            return None\r\n454:        return (st.st_size, st.st_mtime_ns)\r\n455:\r\n456:    def session_identity(self):\r\n457:        \"\"\"What this adapter's HANDLES are: engine, recipe, both artifacts.\r\n458:\r\n459:        PRE-LOAD STABLE, like its siblings -- it may only describe what does not\r\n460:        change across the load, so per-shot state (prompt, seed, frame count) is\r\n461:        deliberately absent. That state lives in :meth:`shot_cache_identity`,\r\n462:        which is a different question with a different answer.\r\n463:        \"\"\"\r\n464:        parts = [self.name, self._recipe_receipt()]\r\n465:        for token, path in (\r\n466:                (GHOST_CHECKPOINT_NAME, self._ckpt_path()),\r\n467:                (self.motion_module_name, self._motion_path())):\r\n468:            parts.append(token)\r\n469:            parts.append(repr(self._file_receipt(path or \"\")))\r\n470:        # THE ADAPTER IS A HANDLE TOO, and its STRENGTH decides what the\r\n471:        # patched model actually is -- two strengths are two different\r\n472:        # sessions, not one session used twice. Absent entirely on the clean\r\n473:        # lanes, so their identity is byte-identical to what it always was.\r\n474:        if self.lora_name:\r\n475:            parts.append(self.lora_name)\r\n476:            parts.append(repr(self._file_receipt(self._lora_path() or \"\")))\r\n477:            parts.append(\"strength=%.4f\" % float(self.lora_strength))\r\n478:        return tuple(parts)\r\n479:\r\n480:    def shot_cache_identity(self, request):\r\n481:        \"\"\"The PER-SHOT identity, and it is deliberately not the session one.\r\n482:\r\n483:        A hit may replay only that same shot's deterministic artifact. Two beats\r\n484:        with identical composed text are still two beats: the shot id and the\r\n485:        resolved seed are in here precisely so a prompt-only cache key can never\r\n486:        collapse them into one, and so no beat can be handed another beat's\r\n487:        source batch or output path.\r\n488:        \"\"\"\r\n489:        plan = self._build_render_request(request)\r\n490:        return (\r\n491:            self.name,\r\n492:            self._recipe_receipt(),\r\n493:            str(plan[\"shot_id\"]),\r\n494:            int(plan[\"seed\"]),\r\n495:            int(plan[\"unique_source_count\"]),\r\n496:            \"%dx%d\" % (GHOST_CANVAS_W, GHOST_CANVAS_H),\r\n497:            GHOST_CHECKPOINT_NAME,\r\n498:            self.motion_module_name,\r\n499:            _sha8(plan[\"text_prompt\"]),\r\n500:            _sha8(plan[\"negative_prompt\"]),\r\n501:        )\r\n502:\r\n503:    # ---- artifact resolution ------------------------------------------- #\r\n504:    @staticmethod\r\n505:    def _resolve_model_file_by_token(categories, name):\r\n675:        self._artifacts = None\r\n676:        super().unload()\r\n677:\r\n678:    def prepare(self, host_caps, profile, session_ctx):\r\n679:        \"\"\"Base prepare (lease + load), then execute ONLY the ``ckpt`` node.\r\n680:\r\n681:        The three outputs are split into SEPARATE one-slot handles and the\r\n682:        combined result tuple is discarded, so a released family can never be\r\n683:        retained by a tuple nobody remembered was holding it.\r\n684:        \"\"\"\r\n685:        prepared = super().prepare(host_caps, profile, session_ctx)\r\n686:        from . import wrapper_bridge as _wb\r\n687:\r\n688:        classes = self._classes or _wb.resolve_graph_classes(\r\n689:            self._node_candidates())\r\n690:\r\n691:        def _register_base(node_id, out_tuple):\r\n692:            \"\"\"Register the base MODEL patcher THE MOMENT IT EXISTS.\r\n693:\r\n694:            A post-``run_graph`` scan is too late: the executor can evict\r\n695:            between the return and the scan, and a patcher we never registered\r\n696:            is a patcher teardown cannot detach.\"\"\"\r\n697:            if node_id != NODE_CKPT:\r\n698:                return\r\n699:            if len(out_tuple) != 3:\r\n700:                raise RuntimeError(\r\n701:                    \"%s: CheckpointLoaderSimple returned %d outputs, expected \"\r\n702:                    \"exactly 3 (MODEL, CLIP, VAE)\"\r\n703:                    % (self.name, len(out_tuple)))\r\n704:            model = out_tuple[0]\r\n705:            if not callable(getattr(model, \"detach\", None)):\r\n706:                raise RuntimeError(\r\n707:                    \"%s: the checkpoint MODEL has no callable detach() -- this \"\r\n708:                    \"adapter cannot take ownership of a patcher it cannot \"\r\n709:                    \"release, and proceeding would strand it resident\"\r\n710:                    % self.name)\r\n711:            self._patchers.append(model)\r\n712:\r\n713:        ckpt_out = _wb.run_graph(\r\n714:            {NODE_CKPT: {\"class\": classes[\"checkpoint\"],\r\n715:                         \"inputs\": {\"ckpt_name\": GHOST_CHECKPOINT_NAME}}},\r\n716:            terminal=NODE_CKPT, on_result=_register_base)\r\n717:\r\n718:        if len(ckpt_out) != 3:\r\n719:            raise RuntimeError(\r\n720:                \"%s: expected MODEL/CLIP/VAE from the checkpoint, got %d \"\r\n721:                \"output(s)\" % (self.name, len(ckpt_out)))\r\n722:\r\n723:        # SEPARATE ONE-SLOT HANDLES, and the three-slot tuple goes away here.\r\n724:        prepared[\"base_model\"] = (ckpt_out[0],)\r\n725:        prepared[\"clip\"] = (ckpt_out[1],)\r\n726:        prepared[\"vae\"] = (ckpt_out[2],)\r\n727:        prepared[\"recipe\"] = self._recipe_receipt()\r\n728:        del ckpt_out\r\n729:        return prepared\r\n730:\r\n731:    # ---- request -------------------------------------------------------- #\r\n732:    def _build_render_request(self, request):\r\n733:        \"\"\"PURE: the normalized plan this adapter renders from.\r\n734:\r\n735:        The negative is read from the REQUEST FIELD by name and a blank one is\r\n905:            if not out_tuple:\r\n906:                raise RuntimeError(\r\n907:                    \"%s: the %s loader returned no MODEL\" % (self.name, node_id))\r\n908:            patched = out_tuple[0]\r\n909:            if not callable(getattr(patched, \"detach\", None)):\r\n910:                raise RuntimeError(\r\n911:                    \"%s: the patched %s MODEL has no callable detach() -- \"\r\n912:                    \"this adapter cannot take ownership of a patcher it cannot \"\r\n913:                    \"release\" % (self.name, node_id))\r\n914:            owners[owner_key] = patched\r\n915:            self._patchers.append(patched)\r\n916:\r\n917:        sampled = _wb.run_graph(\r\n918:            sample_graph,\r\n919:            external_results={\"base_model\": owners[\"base_model\"],\r\n920:                              \"positive_cond\": positive_cond,\r\n921:                              \"negative_cond\": negative_cond},\r\n922:            terminal=NODE_SAMPLER, on_result=_register_patched)\r\n923:        sampled_latent = (sampled[0],)\r\n924:\r\n925:        # BOTH SAMPLING PATCHERS GO BEFORE DECODE, in ADE-then-base order.\r\n926:        self._release_sampling_patchers_before_decode(owners)\r\n927:\r\n928:        del sample_graph\r\n929:        positive_cond = None\r\n930:        negative_cond = None\r\n1115:        for key in (\"model_frame_count\", \"cadence_mode\",\r\n1116:                    \"cadence_source_frame_count\",\r\n1117:                    \"cadence_delivered_frame_count\", \"cadence_tail_trim\",\r\n1118:                    \"delivery_scale_mode\"):\r\n1119:            if key in raw:\r\n1120:                clip[key] = raw[key]\r\n1121:        return clip\r\n1122:\r\n1123:    def _clip_from_raw(self, raw, request):\r\n1124:        \"\"\"The self-declared clip dict :meth:`canonicalize` returns.\"\"\"\r\n1125:        get = request.get if isinstance(request, dict) else (\r\n1126:            lambda k, d=None: getattr(request, k, d))\r\n1127:        raw = raw or {}\r\n1128:        return {\r\n1129:            \"clip_id\": (get(\"shot_id\") or get(\"request_id\")\r\n1130:                        or (\"%s_clip\" % self.name)),\r\n1131:            \"type\": \"video\",\r\n1132:            \"path\": raw.get(\"out_path\", \"\"),\r\n1133:            \"container\": \"mp4\", \"codec\": \"h264\", \"pixel_format\": \"yuv420p\",\r\n1134:            \"fps\": int(self.target