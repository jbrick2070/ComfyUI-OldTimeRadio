{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=4160; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 310 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 4160:     sid = shot[\"shot_id\"]\r\n 4161:     eng = shot[\"engine_id\"]\r\n 4162:     out_shot = dict(shot)\r\n 4163:     force = (sid == oom_shot_id and eng in (oom_engines or frozenset()))\r\n 4164:     _t_render = time.monotonic()\r\n 4165:     try:\r\n 4166:         clip = _render_one(eng, request, force_oom=force,\r\n 4167:                            host_caps=host_caps, profile=profile,\r\n 4168:                            segment=segment)\r\n 4169:     except Exception as exc:              # noqa: BLE001 - no fallback: fail LOUD\r\n 4170:         kind = _rt.FailureKind.OOM if force else classify_failure(exc)\r\n 4171:         _LOG.error(\r\n 4172:             \"[OTR video] render FAILED (no fallback) shot %s engine %s: %s: %s\",\r\n 4173:             sid, eng, type(exc).__name__,\r\n 4174:             str(exc).splitlines()[0] if str(exc) else \"\")\r\n 4175:         raise RenderError(\r\n 4176:             \"shot %s engine %r failed to render; fallbacks are disabled (%s) -- \"\r\n 4177:             \"fix the engine or its inputs: %s\" % (sid, eng, kind, exc)) from exc\r\n 4178:     # Prefer the engine's MEASURED render-window peak (LTX-AV threads it onto the\r\n 4179:     # clip via VramPeakProbe) over the instantaneous post-render read, so the\r\n 4180:     # episode report records the true render-phase peak; fall back when absent.\r\n 4181:     clip_peak = clip.get(\"vram_peak_mb\") if isinstance(clip, dict) else None\r\n 4182:     if isinstance(clip, dict):\r\n 4183:         # THE RECEIPT RIDES THE CLIP (campaign item 0): built here, where the\r\n 4184:         # engine, the request it consumed and the clip it returned are all in\r\n 4185:         # scope, and nowhere else.\r\n 4186:         try:\r\n 4187:             clip[\"receipt\"] = build_actual_receipt(\r\n 4188:                 _vreg.get_engine(eng) if _vreg.is_registered(eng) else None,\r\n 4189:                 shot, request, clip, segment=segment,\r\n 4190:                 wall_s=time.monotonic() - _t_render)\r\n 4191:         except Exception as exc:  # noqa: BLE001 -- never fail a render for a receipt\r\n 4192:             _LOG.warning(\"[OTR video] receipt for shot %s not built: %s: %s\",\r\n 4193:                          sid, type(exc).__name__, exc)\r\n 4194:     return clip, out_shot, [eng], (clip_peak or _mc.vram_used_mb())\r\n 4195: \r\n 4196: \r\n 4197: def render_beat_coverage(shot, ledger, *, request=None, request_builder=None,\r\n 4198:                          canvas=None, oom_engines=frozenset(),\r\n 4199:                          oom_shot_id=None, host_caps=None, profile=None):\r\n 4200:     \"\"\"Render ONE BEAT -- as one clip, or as its plan's segments assembled.\r\n 4201: \r\n 4202:     Multi-clip coverage chunk 6c/6d (2026-07-26). This is the loop the whole\r\n 4203:     block has been building toward, and the shape of it is the point:\r\n 4204: \r\n 4205:     * ONE :class:`beat_session.BeatSession` wraps every segment, so the beat\r\n 4206:       loads its weights once and releases them once, in one outer ``finally``;\r\n 4207:     * each segment gets its OWN request (``segment_index=``), which carries its\r\n 4208:       own still and its own length;\r\n 4209:     * the TERMINAL TRANSACTION happens INSIDE the loop -- a CHAIN successor\r\n 4210:       begins on the frame its predecessor just ended on, extracted immediately\r\n 4211:       after that segment renders, because segment N+1 cannot wait for a\r\n 4212:       post-episode pass to learn where it starts;\r\n 4213:     * the segments are assembled and PROVEN before the beat is handed back.\r\n 4214: \r\n 4215:     A beat with no plan, or a single-clip plan, takes the historical path\r\n 4216:     exactly: one request, one ``render_shot``, no session threaded, nothing\r\n 4217:     assembled. That is every beat today.\r\n 4218: \r\n 4219:     Returns ``(clip, out_shot, attempts, vram_used_mb)`` -- the same tuple\r\n 4220:     :func:`render_shot` returns, because the caller must not care how many\r\n 4221:     renders it took to make one beat.\r\n 4222:     \"\"\"\r\n 4223:     try:\r\n 4224:         # ``acceptance`` owns the beat frame arithmetic, and it lives THERE\r\n 4225:         # rather than here so the grader can reach it: a test pins that module's\r\n 4226:         # import list to exactly [\"__future__\"], so it can never import this\r\n 4227:         # one. Importing it here instead gives the mint side and the grading\r\n 4228:         # side ONE implementation -- which is the point, because a receipt the\r\n 4229:         # grader cannot re-derive is a number it has to take on faith.\r\n 4230:         from . import acceptance as _acceptance  # type: ignore\r\n 4231:         from . import beat_session as _bs  # type: ignore\r\n 4232:         from . import coverage_plan as _cp  # type: ignore\r\n 4233:         from . import foley_stems as _foley  # type: ignore\r\n 4234:         from . import wan_shared as _ws  # type: ignore\r\n 4235:         from . import wrapper_bridge as _wb2  # type: ignore\r\n 4236:         from ._tmp import otr_engine_tmp_path as _tmp_path  # type: ignore\r\n 4237:     except ImportError:  # pragma: no cover -- flat test imports\r\n 4238:         import acceptance as _acceptance  # type: ignore\r\n 4239:         import beat_session as _bs  # type: ignore\r\n 4240:         import coverage_plan as _cp  # type: ignore\r\n 4241:         import foley_stems as _foley  # type: ignore\r\n 4242:         import wan_shared as _ws  # type: ignore\r\n 4243:         import wrapper_bridge as _wb2  # type: ignore\r\n 4244:         from _tmp import otr_engine_tmp_path as _tmp_path  # type: ignore\r\n 4245: \r\n 4246:     raw_plan = shot.get(\"coverage_plan\")\r\n 4247:     plan = None\r\n 4248:     if isinstance(raw_plan, dict) and raw_plan:\r\n 4249:         plan = _cp.CoveragePlan.from_dict(raw_plan)\r\n 4250:     if plan is None or not plan.requires_coverage_execution:\r\n 4251:         # THE HISTORICAL PATH, byte for byte. The caller has usually already\r\n 4252:         # built this request (it needs it for the trace and the audio-motion\r\n 4253:         # profile), so it is used as-is rather than rebuilt -- rebuilding it\r\n 4254:         # here would be a second derivation of one request.\r\n 4255:         #\r\n 4256:         # The predicate was ``is_multi_clip`` until 2026-08-02, which asked the\r\n 4257:         # wrong question: a ONE-segment plan still owes a tail trim whenever its\r\n 4258:         # length was rounded up to a legal rung, and the trim is the coverage\r\n 4259:         # assembler's job. Such beats came down here and kept their surplus\r\n 4260:         # frames, so the video outran its audio. See\r\n 4261:         # ``CoveragePlan.requires_coverage_execution`` for why the question is\r\n 4262:         # what the plan OWES rather than how many pieces it is in.\r\n 4263:         single = request if request is not None else request_builder(\r\n 4264:             shot, ledger, canvas=canvas)\r\n 4265:         return render_shot(shot, single, oom_engines=oom_engines,\r\n 4266:                            oom_shot_id=oom_shot_id, host_caps=host_caps,\r\n 4267:                            profile=profile)\r\n 4268: \r\n 4269:     if request_builder is None:\r\n 4270:         raise RenderError(\r\n 4271:             \"shot %s carries a %d-segment coverage plan but no request builder \"\r\n 4272:             \"was passed, so its segments cannot be given their own stills and \"\r\n 4273:             \"lengths. A synthetic single-request caller cannot drive a \"\r\n 4274:             \"multi-clip beat. NO FALLBACK.\"\r\n 4275:             % (shot.get(\"shot_id\"), plan.segment_count))\r\n 4276:     engine_id = str(shot.get(\"engine_id\") or \"\")\r\n 4277:     # Multi-clip session creation is its own ingress (a frozen ledger may carry\r\n 4278:     # a stale engine id): a RETIRED id gets the NAMED refusal, never the\r\n 4279:     # generic not-registered error (rip-sfx 2026-08-06). Resolved for the\r\n 4280:     # guard only -- idempotent on the internal ids real ledgers carry.\r\n 4281:     from .._otr_shared.public_engines import (\r\n 4282:         check_retired_engine, resolve_engine_id)\r\n 4283:     check_retired_engine(resolve_engine_id(engine_id))\r\n 4284:     if not _vreg.is_registered(engine_id):\r\n 4285:         raise RenderError(\r\n 4286:             \"shot %s carries a %d-segment coverage plan but engine %r is not \"\r\n 4287:             \"registered, so there is nothing to open a beat session on.\"\r\n 4288:             % (shot.get(\"shot_id\"), plan.segment_count, engine_id))\r\n 4289:     engine = _vreg.get_engine(engine_id)\r\n 4290:     # THE CANVAS IS JUDGED BEFORE THE WEIGHTS LOAD (B5, 2026-07-27).\r\n 4291:     #\r\n 4292:     # ``BeatSession`` below PREPARES -- it loads a 6.34 GiB checkpoint -- and\r\n 4293:     # the per-segment ``request_builder`` call that would otherwise surface a\r\n 4294:     # malformed declaration runs INSIDE that session. Same pure function the\r\n 4295:     # request builder calls, so the two boundaries cannot disagree about what\r\n 4296:     # a legal canvas is.\r\n 4297:     #\r\n 4298:     # Honestly stated: since B5 reads a STATIC declaration rather than the\r\n 4299:     # ledger, this can only fire on an adapter whose own declaration is broken\r\n 4300:     # -- it is not a per-episode condition. It stays because the ordering is\r\n 4301:     # the contract the judgment asked for, and because a broken declaration\r\n 4302:     # should cost nothing to discover.\r\n 4303:     declared_render_canvas(engine_id)\r\n 4304:     beat_id = str(shot.get(\"beat_id\") or shot.get(\"shot_id\") or \"\")\r\n 4305:     chains = plan.join_mode == _cp.JOIN_CHAIN\r\n 4306: \r\n 4307:     # EVERY SEGMENT REQUEST IS BUILT BEFORE THE LEASE IS TAKEN (WIRE-W4d, r3:\r\n 4308:     # \"Prebuild and validate all segment requests and audio slices BEFORE\r\n 4309:     # entering BeatSession; only terminal-image chaining stays in the render\r\n 4310:     # loop\").\r\n 4311:     #\r\n 4312:     # The builder is not cheap and it is not pure: it resolves stills off the\r\n 4313:     # ledger and it SHELLS OUT TO FFMPEG to cut each segment's conditioning\r\n 4314:     # WAV out of the frozen master. Run inside the session, that filesystem\r\n 4315:     # and subprocess work happened while the cross-process GPU lease was held\r\n 4316:     # and a 14B UNET sat resident -- once per segment, between renders. The\r\n 4317:     # lease is the scarcest thing this build owns; nothing that does not need\r\n 4318:     # the GPU should be inside it.\r\n 4319:     #\r\n 4320:     # It is also where a bad request SHOULD surface. A builder that raises on\r\n 4321:     # segment 2 used to do it after two renders and a 6 GiB load; now the beat\r\n 4322:     # refuses before anything is taken.\r\n 4323:     #\r\n 4324:     # The CHAIN's terminal-frame substitution deliberately stays in the loop:\r\n 4325:     # segment N's init image is segment N-1's last rendered frame, which does\r\n 4326:     # not exist yet. That is the one thing here that genuinely cannot be\r\n 4327:     # prebuilt, and r3 says so in as many words.\r\n 4328:     prebuilt = []\r\n 4329:     for segment in plan.segments:\r\n 4330:         prebuilt.append(\r\n 4331:             (segment, request_builder(shot, ledger, canvas=canvas,\r\n 4332:                                       segment_index=int(segment.index))))\r\n 4333: \r\n 4334:     admission = _assert_beat_affordable(shot, prebuilt)\r\n 4335: \r\n 4336:     rendered = []            # (path, drop_head, keep_frames) in play order\r\n 4337:     #: The same tuples for the FOLEY stems, in the same play order. Empty on\r\n 4338:     #: every silent lane, which is every lane but one; an all-or-nothing check\r\n 4339:     #: below refuses a beat that produced some stems and not others.\r\n 4340:     foley_rendered = []\r\n 4341:     out_shot = dict(shot)\r\n 4342:     attempts = []\r\n 4343:     # The beat's PEAK, not its last segment's (2026-07-26 QA panel). Taking\r\n 4344:     # whatever the final segment happened to report under-reports a beat whose\r\n 4345:     # heaviest render was segment 1, which is the number the episode report\r\n 4346:     # exists to carry.\r\n 4347:     peak_used = 0\r\n 4348:     terminal = None\r\n 4349:     # PER-SEGMENT IDENTITY (operator ask, 2026-08-01). A beat that renders as\r\n 4350:     # one clip has always been traceable -- it IS the beat, and the ledger's\r\n 4351:     # shot_id names it. A beat that splits did not: the ledger recorded only the\r\n 4352:     # beat's aggregate (b001, rendered_frame_count=410) while the six real\r\n 4353:     # renders behind it landed on disk as otr_beat_zx0zqd05.mp4 -- random hex\r\n 4354:     # naming nothing. Nothing tied a file to its beat, its position in the\r\n 4355:     # sequence, or its neighbours, which made four things unanswerable: which\r\n 4356:     # clip a visible defect came from, whether segment N+1 actually began on\r\n 4357:     # segment N's terminal frame, which segment wore the fear cape, and who\r\n 4358:     # owned any given orphan in scratch.\r\n 4359:     #\r\n 4360:     # Every segment now gets a stable id -- <beat>_seg00, _seg01, ... -- that\r\n 4361:     # names its temp file AND is stamped in the ledger. Purely ADDITIVE: no\r\n 4362:     # existing field changes meaning, so every downstream consumer that reads\r\n 4363:     # the beat row keeps reading exactly what it read before.\r\n 4364:     beat_key = str(beat_id or shot.get(\"shot_id\") or \"beat\")\r\n 4365:     segment_rows = []\r\n 4366:     # The cape is painted on the still that FEEDS the next segment, so the\r\n 4367:     # segment that wears it is the one rendered on the following pass. Carry\r\n 4368:     # the fact forward rather than stamping the segment that merely produced\r\n 4369:     # the frame -- otherwise the receipt names the wrong clip.\r\n 4370:     cape_pending = False\r\n 4371:     # ``coverage_planned`` is passed EXPLICITLY rather than inferred from the\r\n 4372:     # segment count. Reaching this function at all means the plan owes coverage\r\n 4373:     # work, and a one-segment plan carrying a tail trim owes exactly that --\r\n 4374:     # but ``segment_count > 1`` would call it single-clip and route it to the\r\n 4375:     # ping-pong path.\r\n 4376:     with _bs.BeatSession(engine, host_caps=host_caps, profile=profile,\r\n 4377:                          beat_id=beat_id,\r\n 4378:                          segment_count=plan.segment_count,\r\n 4379:                          coverage_planned=True) as session:\r\n 4380:         for position, (segment, request) in enumerate(prebuilt):\r\n 4381:             index = int(segment.index)\r\n 4382:             segment_id = \"%s_seg%02d\" % (beat_key, position)\r\n 4383:             init_source = \"chain_terminal_frame\" if (chains and terminal) \\\r\n 4384:                 else \"still\"\r\n 4385:             if chains and terminal:\r\n 4386:                 # THE TERMINAL TRANSACTION. A chained successor does not get a\r\n 4387:                 # minted still at all -- it begins on the real frame its\r\n 4388:                 # predecessor ended on, which is what makes it a chain rather\r\n 4389:                 # than a jump with extra steps.\r\n 4390:                 #\r\n 4391:                 # INTO ``asset_refs``, WHICH IS WHERE AN ENGINE LOOKS (corrected\r\n 4392:                 # 2026-07-26 by the QA panel). ``build_request`` puts the init\r\n 4393:                 # image at ``asset_refs[\"init_image\"]``; every adapter and\r\n 4394:                 # ``_present_request_tokens`` read it there and NOWHERE else. An\r\n 4395:                 # earlier draft set a top-level ``request[\"init_image\"]``, which\r\n 4396:                 # no production code reads -- so a chained successor would have\r\n 4397:                 # rendered from its ORIGINAL init image, silently, and the beat\r\n 4398:                 # would have jumped at every cut it claimed to chain across.\r\n 4399:                 # The stub in the test agreed with the bug because the test's\r\n 4400:                 # own request builder used the same wrong key.\r\n 4401:                 if isinstance(request, dict):\r\n 4402:                     refs = request.get(\"asset_refs\")\r\n 4403:                     if not isinstance(refs, dict):\r\n 4404:                         refs = {}\r\n 4405:                         request[\"asset_refs\"] = refs\r\n 4406:                     refs[\"init_image\"] = terminal\r\n 4407:                     obs = request.get(\"observability\")\r\n 4408:                     if isinstance(obs, dict):\r\n 4409:                         obs[\"init_source\"] = \"chain_terminal_frame\"\r\n 4410:                         obs[\"init_image\"] = os.path.basename(terminal)\r\n 4411:             clip, out_shot, seg_attempts, seg_used = render_shot(\r\n 4412:                 shot, request, oom_engines=oom_engines, oom_shot_id=oom_shot_id,\r\n 4413:                 host_caps=host_caps, profile=profile,\r\n 4414:                 segment=_bs.SegmentSlot(session, index, beat_id))\r\n 4415:             attempts = list(attempts) + list(seg_attempts or ())\r\n 4416:             peak_used = max(int(peak_used), int(seg_used or 0))\r\n 4417:             path = str((clip or {}).get(\"path\") or \"\")\r\n 4418:             if not path:\r\n 4419:                 raise RenderError(\r\n 4420:                     \"shot %s segment %d rendered no clip path, so the beat \"\r\n 4421:                     \"cannot be assembled. NO FALLBACK.\"\r\n 4422:                     % (shot.get(\"shot_id\"), index))\r\n 4423:             # CHECK THE LENGTH HERE, where the message can still name the\r\n 4424:             # segment (2026-07-26 QA panel). A short render otherwise surfaces\r\n 4425:             # much later as an assembly count mismatch, which reads as an\r\n 4426:             # assembler bug rather than as the engine returning fewer frames\r\n 4427:             # than it was asked for.\r\n 4428:             # A SEGMENT THAT CANNOT SAY WHAT IT PRODUCED IS NOT ASSEMBLABLE\r\n 4429:             # (2026-07-27, chunk 7b C2; found by the blockers kibitz arc).\r\n 4430:             # This read `got = int(clip.get(\"frame_count\") or 0)` followed by\r\n 4431:             # `if got and got != ...`, so a clip reporting 0 -- or omitting the\r\n 4432:             # field entirely -- SKIPPED the check and was assembled anyway.\r\n 4433:             # `CanonicalClip.frame_count` defaults to 0 (``schemas.py:233``),\r\n 4434:             # so \"absent\" and \"zero\" are the same value here and neither is a\r\n 4435:             # length. That is a fail-OPEN guard inside a fail-closed function:\r\n 4436:             # the exact shape of the four swallowed fail-closed sites chunk 1a's\r\n 4437:             # QA panel found, arriving through a different door.\r\n 4438:             #\r\n 4439:             # The count is the whole basis of the plan-vs-output proof, so an\r\n 4440:             # unreadable one is a FAILED verification, not a pass -- the same\r\n 4441:             # rule `wan_shared.ffprobe_counted_frames` already states for the\r\n 4442:             # assembly boundary (\"NO GUESS -- an unreadable count is a failed\r\n 4443:             # verification, not a zero\").\r\n 4444:             raw_count = (clip or {}).get(\"frame_count\")\r\n 4445:             try:\r\n 4446:                 got = int(raw_count)\r\n 4447:             except (TypeError, ValueError):\r\n 4448:                 got = None\r\n 4449:             if got is None or got < 1:\r\n 4450:                 raise RenderError(\r\n 4451:                     \"shot %s segment %d returned frame_count=%r, which is not a \"\r\n 4452:                     \"length. The plan asked for %d frame(s) and the segment \"\r\n 4453:                     \"cannot say what it produced, so the beat cannot be proven \"\r\n 4454:                     \"against its own audio. NO FALLBACK -- an unreadable count \"\r\n 4455:                     \"is a failed verification, not a zero.\"\r\n 4456:                     % (shot.get(\"shot_id\"), index, raw_count,\r\n 4457:                        int(segment.render_frames)))\r\n 4458:             # NAME THE DIRECTION, AND DO NOT EXPLAIN A SHORTFALL THAT DID NOT\r\n 4459:             # HAPPEN. This message read \"assembling a SHORT segment would make\r\n 4460:             # the beat drift\" for both directions, and the first live firing\r\n 4461:             # (2026-07-29, ltx_video) was a SURPLUS -- 193 frames against a\r\n 4462:             # planned 169, because the boomerang loop-fill ignored the ask.\r\n 4463:             # A reader chasing that log was told to look for a shortfall.\r\n 4464:             # Both directions are still terminal and for one reason: the\r\n 4465:             # plan's count is what this segment's audio slice was cut against\r\n 4466:             # (segment_render_window), so a segment of ANY other length drifts\r\n 4467:             # the beat against its own audio. The leading clause is unchanged\r\n 4468:             # so existing receipts and assertions still match.\r\n 4469:             planned = int(segment.render_frames)\r\n","exit_code":0,"status":"completed"}}
