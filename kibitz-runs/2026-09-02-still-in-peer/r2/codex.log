{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=4800; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 240 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 4800:         \"\"\"Close ONE adapter's episode scope. Never raises.\r\n 4801: \r\n 4802:         OWNERSHIP IS POPPED FIRST, so the `finally` sweep cannot double-close\r\n 4803:         and cannot spin retrying a hook that keeps failing.\r\n 4804: \r\n 4805:         A FAILED CLOSE IS LOGGED, NOT ESCALATED TO A GLOBAL RELEASE. An earlier\r\n 4806:         version reached for ``release_encoder_cache()`` here as a belt-and-\r\n 4807:         braces cure, and the r4 panel showed the cure was worse: that call\r\n 4808:         drops the cache for EVERY owner, so one run's failing close would\r\n 4809:         destroy a concurrent run's live cache. Losing this run's share of a\r\n 4810:         cache is a slow render; taking someone else's is a broken one.\r\n 4811:         \"\"\"\r\n 4812:         entry = _scoped_engines.pop(engine_id, None)\r\n 4813:         if entry is None:\r\n 4814:             return\r\n 4815:         eng, token = entry\r\n 4816:         try:\r\n 4817:             try:\r\n 4818:                 eng.end_encoder_scope(token)\r\n 4819:             except TypeError:      # adapter predates the token argument\r\n 4820:                 eng.end_encoder_scope()\r\n 4821:         except Exception as _exc:  # noqa: BLE001 -- runs from cleanup paths\r\n 4822:             _LOG.warning(\"[OTR video] episode scope not closed for %r: %s -- \"\r\n 4823:                          \"this run's claim is leaked rather than forcing a \"\r\n 4824:                          \"release that would evict other owners too\",\r\n 4825:                          engine_id, _exc)\r\n 4826: \r\n 4827:     try:\r\n 4828:         # Beats whose required still the image model REFUSED. Read once, not\r\n 4829:         # per beat: the receipt is frozen by the time the render starts.\r\n 4830:         _gap_beats = sanctioned_gap_beat_ids(ledger)\r\n 4831:         for shot in section[\"shots\"]:\r\n 4832:             # A SANCTIONED GAP IS SKIPPED WHOLE, AND SKIPPED HERE (2026-08-28).\r\n 4833:             #\r\n 4834:             # HERE is load-bearing. The obvious place looks like the request\r\n 4835:             # builder, but ``build_request_from_shot`` returns a REQUEST, not a\r\n 4836:             # shot, and on the cheap families a missing still does not even\r\n 4837:             # raise there -- it logs and sets ``init_image=\"\"``, and the raise\r\n 4838:             # lands later in ``cheap_families.render_clip``. Skipping at the\r\n 4839:             # top of the loop is the only point that precedes BOTH the engine\r\n 4840:             # scope and every raise site, so a beat nobody will render also\r\n 4841:             # never loads an engine's weights.\r\n 4842:             #\r\n 4843:             # The ORIGINAL ShotLock shot is kept, not a synthesized stand-in:\r\n 4844:             # the beat is a real fact about the episode and it keeps its id,\r\n 4845:             # role, family, position and frame budget. What it does not get is\r\n 4846:             # a clip -- ``build_clip_manifest`` derives existence from the clip\r\n 4847:             # file, so the manifest row comes out absent on its own, and the\r\n 4848:             # composite's existing floor-fill covers the hole. Nothing is\r\n 4849:             # substituted and nothing is silent: the gap row in the receipt is\r\n 4850:             # the record, and the warning below is the log.\r\n 4851:             if str(shot.get(\"beat_id\") or \"\") in _gap_beats:\r\n 4852:                 _LOG.warning(\r\n 4853:                     \"[OTR.render_driver] SANCTIONED GAP shot %s (beat %s): not \"\r\n 4854:                     \"rendered -- the image model refused its required still. \"\r\n 4855:                     \"The beat keeps its place in the timeline and is floored.\",\r\n 4856:                     shot.get(\"shot_id\"), shot.get(\"beat_id\"))\r\n 4857:                 new_shots.append(shot)\r\n 4858:                 continue\r\n 4859:             # CS-3 inter-beat reclaim (2026-06-15): before a beat that loads a\r\n 4860:             # DIFFERENT engine than the one the prior beat left resident, drain the\r\n 4861:             # prior engine's residue and FLUSH the allocator, so two heavy engines\r\n 4862:             # never co-reside on the 16GB card -- the cause of the 29s/it edge\r\n 4863:             # page-thrash (ltx 12.5GB + humo 7GB -> 19.5GB). The per-beat teardown\r\n 4864:             # already DETACHES + waits, but it does not return the freed-but-cached\r\n 4865:             # blocks to the driver; the surgical Lever-1 freer's cuda flush does.\r\n 4866:             # SELECTIVE: same-engine consecutive beats SKIP this (no reload churn --\r\n 4867:             # the resident-stack reuse, e.g. humo x3, is preserved). Best-effort,\r\n 4868:             # never fatal; no unload_all_models (V-4/V-5); MEASURED telemetry.\r\n 4869:             _this_engine = str(shot.get(\"engine_id\") or \"\")\r\n 4870:             # CLOSE THE OUTGOING ENGINE'S SCOPE ON *ANY* ENGINE CHANGE, and on\r\n 4871:             # its own condition -- NOT inside the reclaim gate below.\r\n 4872:             #\r\n 4873:             # THIS WAS A REAL BUG AND THE PANEL CAUGHT IT.\r\n 4874:             # ``_should_reclaim_between_engines`` ends in\r\n 4875:             # ``and not _is_cloud_video_engine(this)`` (:1885-1888), because a\r\n 4876:             # VRAM reclaim only matters before a LOCAL engine loads. Nesting\r\n 4877:             # the scope release inside it meant a local -> CLOUD hand-off never\r\n 4878:             # released the local engine's 8.86 GiB: the predicate is about\r\n 4879:             # whether to drain VRAM, and ownership is a different question that\r\n 4880:             # happens to have shared a line.\r\n 4881:             #\r\n 4882:             # Ordering still matters: the release runs BEFORE the reclaim, so\r\n 4883:             # the reclaim is not draining around the largest thing in the room.\r\n 4884:             if _last_engine and _this_engine and _this_engine != _last_engine:\r\n 4885:                 _end_engine_scope(_last_engine)\r\n 4886:             if _should_reclaim_between_engines(_last_engine, _this_engine):\r\n 4887:                 try:\r\n 4888:                     from .._otr_vram_levers import (\r\n 4889:                         free_otr_pipeline_residue as _free_residue)\r\n 4890:                     _ir = _free_residue(\r\n 4891:                         reason=\"inter-beat %s->%s\" % (_last_engine, _this_engine))\r\n 4892:                     _LOG.warning(\r\n 4893:                         \"[OTR video] inter-beat reclaim %s->%s: free_gb_after=%s\",\r\n 4894:                         _last_engine, _this_engine, _ir.get(\"free_gb_after\"))\r\n 4895:                 except Exception as _exc:  # noqa: BLE001 -- best-effort, never fatal\r\n 4896:                     _LOG.warning(\r\n 4897:                         \"[OTR video] inter-beat reclaim skipped: %s\", _exc)\r\n 4898:             # OPEN THIS ENGINE'S EPISODE SCOPE. After the reclaim above, so a\r\n 4899:             # scope is never opened into memory that is about to be drained,\r\n 4900:             # and idempotent, so the 2nd..Nth beat on the same engine is free.\r\n 4901:             _begin_engine_scope(_this_engine)\r\n 4902:             if request_builder is not None:\r\n 4903:                 request = request_builder(shot, ledger, canvas=canvas)\r\n 4904:             else:\r\n 4905:                 request = build_request(shot, assets, frame_count, canvas)\r\n 4906:             # S-C C1: record this shot's resolved conditioning WAV + id/timing so the\r\n 4907:             # post-render pass can stamp a per-beat audio_motion_profile. Best-effort;\r\n 4908:             # a collection hiccup must never perturb the render.\r\n 4909:             try:\r\n 4910:                 _amp_ref = (request.get(\"audio_ref\") or {}) if isinstance(request, dict) else {}\r\n 4911:                 _amp_wav = _amp_ref.get(\"path\") if isinstance(_amp_ref, dict) else None\r\n 4912:                 if _amp_wav:\r\n 4913:                     amp_rows.append({\r\n 4914:                         \"id\": str(shot.get(\"shot_id\") or \"\"),\r\n 4915:                         \"start_s\": float(shot.get(\"start_s\") or 0.0),\r\n 4916:                         \"dur_s\": float(shot.get(\"dur_s\") or 0.0),\r\n 4917:                         \"_wav\": str(_amp_wav),\r\n 4918:                     })\r\n 4919:             except Exception:  # noqa: BLE001 -- profiling collection is never fatal\r\n 4920:                 pass\r\n 4921:             # ONE BEAT, however many renders it takes (2026-07-26, chunks 6c/6d).\r\n 4922:             # A shot with no coverage plan or a single-clip one goes straight to\r\n 4923:             # render_shot with the request already built above -- unchanged. A\r\n 4924:             # multi-segment plan opens ONE beat session, renders each segment from\r\n 4925:             # its own request, chains terminal frames inside the loop, and assembles\r\n 4926:             # the result before it comes back.\r\n 4927:             clip, out_shot, attempts, used = render_beat_coverage(\r\n 4928:                 shot, ledger, request=request, request_builder=request_builder,\r\n 4929:                 canvas=canvas, oom_engines=oom_engines, oom_shot_id=oom_shot_id,\r\n 4930:                 host_caps=_episode_host_caps, profile=_episode_profile)\r\n 4931:             # NO FALLBACKS (2026-07-02): render_shot either returns a clip or\r\n 4932:             # raises RenderError; there are no runtime fallback decisions and no\r\n 4933:             # AS-2 family-change group prune (the family can never change here).\r\n 4934:             clips[out_shot[\"shot_id\"]] = clip\r\n 4935:             new_shots.append(out_shot)\r\n 4936:             row = {\"shot_id\": out_shot[\"shot_id\"], \"attempts\": attempts,\r\n 4937:                    \"final_engine\": out_shot[\"engine_id\"]}\r\n 4938:             # Round 5 F2: prompt observability rides the trace (durable in the\r\n 4939:             # node-92 /history report) -- the diversity gate + the operator's\r\n 4940:             # \"did the prompts actually differ\" check read these. The stamps live\r\n 4941:             # on the request's schema-real ``observability`` dict (W7-pre builder\r\n 4942:             # migration; the legacy top-level ``_<key>`` spelling is still read\r\n 4943:             # for hand-built requests).\r\n 4944:             obs = (request.get(\"observability\") or {}) if isinstance(request, dict) else {}\r\n 4945:             for key in (\"prompt_source\", \"prompt_subsource\", \"prompt_sha8\",\r\n 4946:                         \"prompt_chars\", \"init_source\", \"init_image\",\r\n 4947:                         \"i2v_still_missing\", \"video_seed\",\r\n 4948:                         \"visual_style\", \"prompt_field_source\",\r\n 4949:                         # The banana receipt (docs/2026-08-06-BUILD-SPEC-banana-route.md)\r\n 4950:                         # -- without these the keys never reach the node-92 report.\r\n 4951:                         \"banana_route\", \"banana_table_version\",\r\n 4952:                         \"banana_substitutions\", \"banana_sha256_before\",\r\n 4953:                         \"banana_sha256_after\", \"banana_varieties\",\r\n 4954:                         # GHOST SIGNAL PROMPT RECEIPTS (2026-08-22). These live\r\n 4955:                         # on the REQUEST's observability, which is why they\r\n 4956:                         # belong in this loop and the cadence keys below do not.\r\n 4957:                         \"prompt_version\", \"negative_sha8\", \"negative_chars\",\r\n 4958:                         \"prompt_slots\", \"subject_sigil_sha8\",\r\n 4959:                         # GHOST PROMPT v2 RECEIPTS (2026-08-22). A key that is\r\n 4960:                         # stamped but not listed here never reaches the node-92\r\n 4961:                         # /history report, which is the only place the operator\r\n 4962:                         # can read what a published episode actually asked for.\r\n 4963:                         \"author_version\", \"ghost_schema_version\",\r\n 4964:                         \"ghost_source\", \"ghost_fallback_reason\",\r\n 4965:                         \"ghost_model_id\", \"ghost_mode\", \"ghost_motif_cue\",\r\n 4966:                         \"ghost_request_sha8\", \"ghost_output_sha8\",\r\n 4967:                         \"ghost_drawable_beat\", \"ghost_drawable_beat_sha8\",\r\n 4968:                         \"positive_clip_tokens\", \"positive_clip_windows\",\r\n 4969:                         \"negative_clip_tokens\", \"negative_clip_windows\",\r\n 4970:                         \"clip_window_max\", \"clip_counter\",\r\n 4971:                         # JOINT-AV RECEIPTS. Stamped on the request and declared\r\n 4972:                         # in the schema, but omitted from this allowlist -- so\r\n 4973:                         # the published /history evidence never carried what a\r\n 4974:                         # joint-AV beat actually asked for or was heard to say.\r\n 4975:                         # `joint_av_identity_leak` is only present when a leak\r\n 4976:                         # was detected; absent stays absent, never invented.\r\n 4977:                         \"joint_av_prompt\", \"joint_av_sounds\",\r\n 4978:                         \"joint_av_identity_leak\"):\r\n 4979:                 if key in obs:\r\n 4980:                     row[key] = obs[key]\r\n 4981:                 elif isinstance(request, dict) and (\"_\" + key) in request:\r\n 4982:                     row[key] = request[\"_\" + key]\r\n 4983:             # THE CADENCE / DELIVERY KEYS COME FROM THE CLIP, NOT THE REQUEST.\r\n 4984:             # Appending them to the loop above would have been the natural-\r\n 4985:             # looking mistake and they would ALL have been silently absent: they\r\n 4986:             # are stamped by the adapter on what it RETURNED, never on what was\r\n 4987:             # asked for -- which is the point, since a receipt sourced from\r\n 4988:             # request intent could describe a render that did not happen.\r\n 4989:             # Without this, node 92's /history report drops them entirely.\r\n 4990:             if isinstance(clip, dict):\r\n 4991:                 for key in _CADENCE_DELIVERY_RECEIPT_KEYS:\r\n 4992:                     if key in clip:\r\n 4993:                         row[key] = clip[key]\r\n 4994:             trace.append(row)\r\n 4995:             if used:\r\n 4996:                 vram_peak = max(vram_peak, int(used))\r\n 4997:             # CS-3: remember what ACTUALLY rendered (post-fallback final_engine) so\r\n 4998:             # the next beat reclaims only when it crosses to a different engine.\r\n 4999:             _last_engine = str(out_shot.get(\"engine_id\") or \"\")\r\n 5000:     finally:\r\n 5001:         # THE SCOPES CLOSE EVEN WHEN THE EPISODE DOES NOT FINISH. A raise\r\n 5002:         # anywhere in the loop -- an OOM, a refused beat, a bad ledger row --\r\n 5003:         # must still release the episode's heavy handles, or a failed render\r\n 5004:         # leaves 8.86 GiB pinned for the life of the server and the NEXT\r\n 5005:         # episode pays for this one's crash.\r\n 5006:         for _scoped_id in list(_scoped_engines):\r\n 5007:             _end_engine_scope(_scoped_id)\r\n 5008:     section[\"shots\"] = new_shots\r\n 5009:     ledger[\"video\"] = section\r\n 5010:     receipts = []\r\n 5011:     for _s in new_shots:\r\n 5012:         _c = clips.get(_s.get(\"shot_id\"))\r\n 5013:         if not isinstance(_c, dict):     # a cheap-family clip may be a bare path\r\n 5014:             continue\r\n 5015:         for _r in (_c.get(\"receipts\") or ([_c[\"receipt\"]] if _c.get(\"receipt\") else [])):\r\n 5016:             if isinstance(_r, dict):\r\n 5017:                 receipts.append(_r)\r\n 5018:     return {\"ledger\": ledger, \"clips\": clips, \"trace\": trace,\r\n 5019:             \"vram_peak_mb\": vram_peak, \"audio_motion_rows\": amp_rows,\r\n 5020:             \"receipts\": receipts}\r\n 5021: \r\n 5022: \r\n 5023: def _log_if_legacy_render_plan_present(ledger):\r\n 5024:     \"\"\"Do not let story-QA render_plan metadata drop real episode shots.\r\n 5025: \r\n 5026:     ``meta.render_plan`` was introduced for the retired/separate HuMo batch as\r\n 5027:     a cost/attention filter. The generic episode renderer is now the visible\r\n 5028:     delivery path, so every ShotLock row must render; otherwise a voiced line\r\n 5029:     can fall through to the procgen floor while its audio/caption still plays.\r\n 5030:     \"\"\"\r\n 5031:     meta = (ledger or {}).get(\"meta\") or {}\r\n 5032:     plan = meta.get(\"render_plan\") or {}\r\n 5033:     if not isinstance(plan, dict):\r\n 5034:         return ledger\r\n 5035:     if not plan:\r\n 5036:         return ledger\r\n 5037:     section = (ledger or {}).get(\"video\") or {}\r\n 5038:     shots = section.get(\"shots\") or []\r\n 5039:     if not isinstance(shots, list) or not shots:\r\n","exit_code":0,"status":"completed"}}
