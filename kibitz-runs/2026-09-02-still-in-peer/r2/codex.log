eturn _validate_contract(otr_episodes_root() / eid / \"portraits\")\r\n  334: \r\n  335: \r\n  336: def otr_videos_dir(episode_id: str) -> Path:\r\n  337:     \"\"\"Per-episode per-line HuMo + LTX clip dir:\r\n  338:     ``<output>/otr/episodes/<episode_id>/videos/``.\r\n  339: \r\n   60:     return str(output_dir)\r\n   61: \r\n   62: \r\n   63: def stills_root(output_dir: Optional[str] = None) -> Path:\r\n   64:     \"\"\"The ``<output>/otr/episodes/_shared/cache`` directory (the\r\n   65:     content-addressed cross-episode pool; OH-1). ``output_dir``\r\n   66:     overrides the ComfyUI output root (used by tests).\"\"\"\r\n   67:     return Path(_output_base(output_dir)).joinpath(*_STILLS_SUBDIR)\r\n   68: \r\n   69: \r\n   70: def episode_stills_dir(episode_id: str,\r\n   71:                        output_dir: Optional[str] = None) -> Path:\r\n   72:     \"\"\"``<output>/otr/episodes/<episode_id>/stills`` -- the EPISODE-LOCAL\r\n   73:     still directory (still-spine ST-3 / W3): every still the dispatcher mints\r\n   74:     or cache-reuses is materialized here so the episode folder is the one\r\n   75:     self-contained unit of output (and the 3D plan's future consumers read\r\n   76:     character stills from the same rows). The global pool stays the\r\n   77:     content-addressed cache; this is the per-episode view of it.\"\"\"\r\n   78:     ep = str(episode_id or \"\").strip()\r\n   79:     if not ep:\r\n   80:         raise PortraitUnresolved(\"empty episode_id for episode_stills_dir\")\r\n   81:     return Path(_output_base(output_dir)) / \"otr\" / \"episodes\" / ep / \"stills\"\r\n   82: \r\n   83: \r\n   84: def compute_portrait_hash(decoded_pixels) -> str:\r\n   85:     \"\"\"``sha256`` over the DECODED pixel bytes (re-encoding-stable identity).\r\n   86: \r\n   87:     ``decoded_pixels`` is anything exposing ``.tobytes()`` (a numpy uint8 image\r\n   88:     array) or raw ``bytes`` / ``bytearray`` / ``memoryview``. We hash the\r\n   89:     decoded pixels -- NOT the encoded PNG file -- so two byte-different PNG\r\n   90:     encodings of the same image collapse to one identity.\r\n   91:     \"\"\"\r\n   92:     if isinstance(decoded_pixels, (bytes, bytearray, memoryview)):\r\n   93:         raw = bytes(decoded_pixels)\r\n   94:     elif hasattr(decoded_pixels, \"tobytes\"):\r\n   95:         raw = decoded_pixels.tobytes()\r\n   96:     else:\r\n   97:         raise TypeError(\r\n   98:             \"decoded_pixels must be bytes-like or expose .tobytes() \"\r\n   99:             \"(a decoded uint8 image array)\"\r\n  100:         )\r\n  101:     return hashlib.sha256(raw).hexdigest()\r\n  102: \r\n  103: \r\n  104: def portrait_path_for_hash(portrait_content_hash: str,\r\n  105:                            output_dir: Optional[str] = None) -> Path:\r\n  106:     \"\"\"Deterministic path ``<output>/otr/stills/{hash}.png`` for a hash.\"\"\"\r\n  107:     h = str(portrait_content_hash or \"\").strip()\r\n  108:     if not h:\r\n  109:         raise PortraitUnresolved(\"empty portrait_content_hash\")\r\n  110:     return stills_root(output_dir) / f\"{h}.png\"\r\n  111: \r\n  112: \r\n  113: def _cast_entry_for_char(ledger: dict, char_id: str) -> Optional[dict]:\r\n  114:     \"\"\"The cast dict whose ``char_id`` matches (alias-stable key), or None.\r\n  115:     Matches ``char_id`` ONLY -- never the display name (BUG-098).\"\"\"\r\n  116:     cid = str(char_id or \"\")\r\n  117:     if not cid:\r\n  118:         return None\r\n  119:     for entry in (ledger or {}).get(\"cast\") or []:\r\n  120:         if isinstance(entry, dict) and str(entry.get(\"char_id\") or \"\") == cid:\r\n  121:             return entry\r\n  122:     return None\r\n  123: \r\n  124: \r\n  125: def portrait_hash_for_char(ledger: dict, char_id: str) -> Optional[str]:\r\n  126:     \"\"\"The stamped ``portrait_content_hash`` for ``char_id``, or None.\"\"\"\r\n  127:     entry = _cast_entry_for_char(ledger, char_id)\r\n  128:     if entry is No