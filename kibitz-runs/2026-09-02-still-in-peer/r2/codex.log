 accepted duration upward to a complete\r\n 6004:     CFR frame. ``render_target_frames`` retains the old sum as truthful work\r\n 6005:     telemetry. Sparse/legacy manifests keep the old sequential-sum behavior.\r\n 6006:     The frozen audio bytes are never read or mutated here.\"\"\"\r\n 6007:     led = result.get(\"ledger\") or {}\r\n 6008:     section = led.get(\"video\") or {}\r\n 6009:     shots = section.get(\"shots\") or []\r\n 6010:     clips = result.get(\"clips\") or {}\r\n 6011:     canvas = section.get(\"canonical_canvas\") or {}\r\n 6012:     lines = {str(ln.get(\"line_id\")): ln for ln in (led.get(\"lines\") or [])\r\n 6013:              if isinstance(ln, dict) and ln.get(\"line_id\")}\r\n 6014:     # ST-4: init observability joins the manifest rows via the trace (the\r\n 6015:     # request stamps run_episode copied; keyed by shot_id).\r\n 6016:     trace_by_shot = {str(r.get(\"shot_id\") or \"\"): r\r\n 6017:                      for r in (result.get(\"trace\") or [])\r\n 6018:                      if isinstance(r, dict)}\r\n 6019:     rows = []\r\n 6020:     total = 0\r\n 6021:     hist = {}\r\n 6022:     # Read once per manifest, from the receipt -- see the row's own note.\r\n 6023:     _gap_beats_for_manifest = sanctioned_gap_beat_ids(led)\r\n 6024:     for order, shot in enumerate(shots):\r\n 6025:         sid = shot.get(\"shot_id\")\r\n 6026:         clip = clips.get(sid) or {}\r\n 6027:         path = str(clip.get(\"path\") or \"\")\r\n 6028:         ctype = str(clip.get(\"type\") or \"video\")\r\n 6029:         if ctype == \"directory\":\r\n 6030:             # 3D plan 7.2 p3: a directory clip is real when the dir holds\r\n 6031:             # EXACTLY target_frame_count sorted nonzero frames (shared rule).\r\n 6032:             from .directory_clip import frame_dir_summary\r\n 6033:             exists, _n, _b = frame_dir_summary(\r\n 6034:                 path, expect_frames=shot.get(\"target_frame_count\"))\r\n 6035:         else:\r\n 6036:             exists = bool(path) and os.path.isfile(path)\r\n 6037:         tfc = int(shot.get(\"target_frame_count\") or 0)\r\n 6038:         total += tfc\r\n 6039:         eid = clip.get(\"engine_id\") or shot.get(\"engine_id\")\r\n 6040:         # Round 5 F5: beat ids via the shared rule (synthetic -> the bare\r\n 6041:         # beat id, not \"shot_...\"), and start_s falls back to the SHOT row's\r\n 6042:         # stamp -- one None row silently degraded the whole composite from\r\n 6043:         # positioned to sequential mode (plan_timeline_segments requires ALL\r\n 6044:         # rows positioned; the 2026-06-10 acceptance episode hit this).\r\n 6045:         bid = _beat_id_for_shot(shot)\r\n 6046:         sraw = lines.get(bid, {}).get(\"start_s\")\r\n 6047:         if sraw in (None, \"\"):\r\n 6048:             sraw = shot.get(\"start_s\")\r\n 6049:         try:\r\n 6050:             start_s = float(sraw) if sraw not in (None, \"\") else None\r\n 6051:         except (TypeError, ValueError):\r\n 6052:             start_s = None\r\n 6053:         # Round 5 F5: the talking-head face check is mechanical -- each row\r\n 6054:         # carries the resolved char_id + the portrait it staged.\r\n 6055:         row_char = str(shot.get(\"char_id\")\r\n 6056:                        or lines.get(bid, {}).get(\"char_id\") or \"\")\r\n 6057:         trow = trace_by_shot.get(str(sid or \"\"), {})\r\n 6058:         row = {\r\n 6059:             \"order\": order, \"shot_id\": sid, \"beat_id\": bid,\r\n 6060:             \"engine_id\": eid,\r\n 6061:             # C3 (2026-08-28): the sanction travels to the CONSUMERS.\r\n 6062:             # ``timeline_quality_report`` and node 92's success predicate both\r\n 6063:             # read ``manifest[\"clips\"]`` and never see ``video.shots``, so\r\n 6064:             # without this projection a refused beat and a crashed one are the\r\n 6065:             # same absent row to every reader downstream -- and counting them\r\n 6066:             # alike is what would let a broken render publish as \"degraded\".\r\n 6067:             # Stamped ONLY when the receipt says so; never inferred from the\r\n 6068:             # missing file.\r\n 6069:             \"status\": (_receipt.STATUS_SANCTIONED_GAP\r\n 6070:                        if bid in _gap_beats_for_manifest\r\n 6071:                        else _receipt.STATUS_OK),\r\n 6072:             \"role\": str(shot.get(\"role\") or \"\"),\r\n 6073:             \"family\": clip.get(\"family\") or shot.get(\"family\") or \"\",\r\n 6074:             \"path\": path,\r\n 6075:             \"type\": ctype,\r\n 6076:             \"frame_count\": int(clip.get(\"frame_count\") or 0),\r\n 6077:             \"target_frame_count\": tfc,\r\n 6078:             \"start_s\": start_s,\r\n 6079:             \"char_id\": row_char,\r\n 6080:             \"init_image\": _portrait_index(led).get(row_char, \"\"),\r\n 6081:             \"init_source\": str(trow.get(\"init_source\") or \"\"),\r\n 6082:             \"init_image_used\": str(trow.get(\"init_image\") or \"\"),\r\n 6083:             \"exists\": exists,\r\n 6084:             # S-B/E5 recipe receipt: the render engine threads recipe / quant /\r\n 6085:             # LoRA / canvas / measured peak into the canonical clip; carry it onto\r\n 6086:             # the manifest row so the ledger recipe-stamp self-documents what made\r\n 6087:             # each beat. None for engines that emit no receipt (OPTIONAL field).\r\n 6088:             \"recipe\": clip.get(\"recipe\"), \"quant\": clip.get(\"quant\"),\r\n 6089:             \"use_lora\": clip.get(\"use_lora\"),\r\n 6090:             \"render_canvas\": clip.get(\"render_canvas\"),\r\n 6091:             \"vram_peak_mb\": clip.get(\"vram_peak_mb\"),\r\n 6092:             # HOW MANY OF THOSE FRAMES ARE REAL (WIRE-W5, 2026-07-29). Same\r\n 6093:             # shape and the same reason as ``recipe`` above: the engine stamps\r\n 6094:             # them on the canonical clip and they die there unless the manifest\r\n 6095:             # carries them. ``frame_count`` cannot answer the question -- a\r\n 6096:             # ping-pong-extended clip carries exactly the number a real one\r\n 6097:             # does, which is precisely the evidence a pad forges -- so the\r\n 6098:             # acceptance grader has no way to reject a mirror-filled clip on a\r\n 6099:             # lane claiming real multi-clip coverage without these. OPTIONAL:\r\n 6100:             # None on every engine that emits no receipt.\r\n 6101:             #\r\n 6102:             # SCOPE (2026-08-06): on a single-render clip these are the engine's\r\n 6103:             # own counts. On an ASSEMBLED beat they are beat-scope --\r\n 6104:             # ``native_frame_count`` is every native frame the beat RENDERED\r\n 6105:             # (243 for a 3x81 chain) and ``delivered_native_frame_count`` is the\r\n 6106:             # 241 that survived the seams. The two are deliberately not the same\r\n 6107:             # number, and only the second may be weighed against\r\n 6108:             # ``frame_count``: comparing the work against the output is what\r\n 6109:             # reported every honest multi-segment beat as padded.\r\n 6110:             \"native_frame_count\": clip.get(\"native_frame_count\"),\r\n 6111:             \"extension_mode\": clip.get(\"extension_mode\"),\r\n 6112:             # WHAT TEXT AND WHICH SEED MADE THIS CLIP (campaign item 0,\r\n 6113:             # 2026-09-02): from the segment receipt(s) the engine's render\r\n 6114:             # attached; None when no receipt was built.\r\n 6115:             \"prompt_sha8\": _first_receipt_field(clip, \"prompt_sha8\"),\r\n 6116:             \"request_seed\": _first_receipt_field(clip, \"seed\"),\r\n 6117:             \"actual_request_sha\": _first_receipt_field(clip, \"actual_request_sha\"),\r\n 6118:             # THE CADENCE AND DELIVERY RECEIPTS (Ghost Signal, 2026-08-22).\r\n 6119:          