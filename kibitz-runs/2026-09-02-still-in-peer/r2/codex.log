CLAUSE\r\n 3033:         # IS THE SUBJECT IDENTITY, not the trailing shot law -- the shot law is a\r\n 3034:         # constant this composer can always re-emit, while the subject is the one\r\n 3035:         # phrase that makes the figure the same figure beat to beat.\r\n 3036:         _prompt_char_budget = _gsp.GHOST_PROMPT_MAX_CHARS\r\n 3037:         _prompt_protected_clause = (\r\n 3038:             _g_sigil or _g_positive.split(\",\")[0].strip())\r\n 3039:         _stamp_prompt_meta(req, _gsp.GHOST_PROMPT_SOURCE, _g_positive,\r\n 3040:                            beat=_beat_id_for_shot(shot))\r\n 3041:         _g_obs = req.setdefault(\"observability\", {})\r\n 3042:         _g_obs[\"prompt_version\"] = _gsp.GHOST_PROMPT_VERSION\r\n 3043:         _g_obs[\"negative_sha8\"] = hashlib.sha256(\r\n 3044:             _g_negative.encode(\"utf-8\")).hexdigest()[:8]\r\n 3045:         _g_obs[\"negative_chars\"] = len(_g_negative)\r\n 3046:         _g_obs[\"prompt_slots\"] = list(_g_out.get(\"slots\") or ())\r\n 3047:         if _g_sigil:\r\n 3048:             _g_obs[\"subject_sigil_sha8\"] = hashlib.sha256(\r\n 3049:                 _g_sigil.encode(\"utf-8\")).hexdigest()[:8]\r\n 3050:         # TRUE ONLY NOW -- after a non-empty positive, a non-empty negative and\r\n 3051:         # the ghost_signal prompt_source are all really installed.\r\n 3052:         _ghost_composed = (\r\n 3053:             bool(req.get(\"text_prompt\")) and bool(req.get(\"negative_prompt\"))\r\n 3054:             and _g_obs.get(\"prompt_source\") == _gsp.GHOST_PROMPT_SOURCE)\r\n 3055:         if not _ghost_composed:\r\n 3056:             raise FamilyInputGap(\r\n 3057:                 \"Ghost Signal beat %s did not install a complete composed \"\r\n 3058:                 \"request (positive/negative/prompt_source) -- refusing rather \"\r\n 3059:                 \"than letting the generic seed render as if it were Ghost.\"\r\n 3060:                 % (shot.get(\"shot_id\"),))\r\n 3061:         _LOG.warning(\r\n 3062:             \"[OTR.render_driver] GHOST SIGNAL: %s beat %s composed %d chars, \"\r\n 3063:             \"negative %d chars, slots=%s\", _shot_role, shot.get(\"shot_id\"),\r\n 3064:             len(_g_positive), len(_g_negative), \",\".join(_g_obs[\"prompt_slots\"]))\r\n 3065:     # ===================================================================== #\r\n 3066:     # PER-LANE PROMPT DISPATCH (Option B, operator ruling 2026-08-27).\r\n 3067:     # ===================================================================== #\r\n 3068:     #\r\n 3069:     # THE DEFECT THIS FIXES. Every lane used to compose its prompt as\r\n 3070:     # ``get(\"text_prompt\") or <the lane's motion default>``, and ShotLock\r\n 3071:     # populates ``text_prompt`` unconditionally for every character beat -- so\r\n 3072:     # the per-lane motion prompts committed in 65538f41 lived on the dead side\r\n 3073:     # of that ``or`` and never once rendered. The live H3 leg of 2026-08-27\r\n 3074:     # proved it from production: every character beat logged ``source=m4``.\r\n 3075:     #\r\n 3076:     # THE RULE: one path per lane, always active. No flag, no shadow state, no\r\n 3077:     # legacy route. A lane that declares its OWN ``compose_prompt`` composes\r\n 3078:     # here, and the ENTIRE legacy chain below -- the shared visual prompt, the ia2v talking\r\n 3079:     # rewrite, the env override, the motion-role branch, the brief+beat branch\r\n 3080:     # and both fallbacks -- is skipped for it. Review flagged that omitting this\r\n 3081:     # bypass would let a legacy branch silently overwrite the lane's output,\r\n 3082:     # which would be the second prompt path the operator forbade.\r\n 3083:     #\r\n 3084:     # ``type(engine).__dict__`` AND NOT ``hasattr``, deliberately. The engine\r\n 3085:     # classes are subclass chains (mime <- foley_plus <- video; h3 silent and\r\n 3086:     # h3 audio-in share a base; fastwan subclasses wan). ``hasattr`` would find\r\n 3087:     # an INHERITED formatter and hand one lane another lane's motion -- exactly\r\n 3088:     # what \"each lane independent\" forbids. Only a formatter bound to the class\r\n 3089:     # itself is visible to dispatch.\r\n 3090:     #\r\n 3091:     # SCOPE: ``character_video`` only. Announcer and music beats have no\r\n 3092:     # ``creative`` row at all (CHARACTER_BEARING_ROLES is character_video\r\n 3093:     # alone), so a formatter there would compose from nothing, return blank,\r\n 3094:     # and ``finish_joint_av_positive`` raises on a blank positive -- a dead\r\n 3095:     # episode at the foley/mime bookends. Those beats keep the motion-register\r\n 3096:     # branch they already have.\r\n 3097:     _lane_composed = False\r\n 3098:     if (not _ghost_composed\r\n 3099:             and _shot_role == \"character_video\"\r\n 3100:             and _eng_id and _vreg.is_registered(_eng_id)):\r\n 3101:         _lane_engine = _vreg.get_engine(_eng_id)\r\n 3102:         _lane_formatter = type(_lane_engine).__dict__.get(\"compose_prompt\")\r\n 3103:         if _lane_formatter is not None:\r\n 3104:             _lane_line = _line_index(ledger).get(str(_visual_beat_id)) or {}\r\n 3105:             # DIALOGUE IS STRUCTURAL, NOT POLICY. A lane that does not preserve\r\n 3106:             # dialogue is handed \"\" here, so it cannot leak a spoken line even\r\n 3107:             # if its formatter wanted to. ``_lane_preserves_dialogue`` is the\r\n 3108:             # existing authority (it keys on the engine FAMILY); a hand-written\r\n 3109:             # membership list would drift from it.\r\n 3110:             try:\r\n 3111:                 from ..otr_shot_lock import (  # type: ignore\r\n 3112:                     _lane_preserves_dialogue as _lane_keeps_dialogue)\r\n 3113:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3114:                 from otr_shot_lock import (  # type: ignore\r\n 3115:                     _lane_preserves_dialogue as _lane_keeps_dialogue)\r\n 3116:             try:\r\n 3117:                 _keeps = bool(_lane_keeps_dialogue(_eng_id, _shot_role))\r\n 3118:             except Exception:  # noqa: BLE001 -- a silent lane is the safe default\r\n 3119:                 _keeps = False\r\n 3120:             # APPEARANCE AND SETTING ARE RESOLVED HERE, NOT STORED.\r\n 3121:             # Adding them to the creative object would be a schema extension\r\n 3122:             # Option B forbids, and `creative[\"text_prompt\"]` already contains\r\n 3123:             # the appearance -- storing a second raw copy invites a formatter\r\n 3124:             # emitting it twice, and worse, re-bleeding the subject anchor's\r\n 3125:             # \"speaking to camera\" into the silent lanes. Both resolvers are\r\n 3126:             # pure ledger reads.\r\n 3127:             try:\r\n 3128:                 from ..otr_shot_lock import (  # type: ignore\r\n 3129:                     _appearance_for_char as _lane_appearance,\r\n 3130:                     _read_setting as _lane_setting)\r\n 3131:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3132:                 from otr_shot_lock import (  # type: ignore\r\n 3133:                     _appearance_for_char as _lane_appearance,\r\n 3134:                     _read_setting as _lane_setting)\r\n 3135:             try:\r\n 3136:                 _lane_look = str(_lane_appearance(\r\n 3137:                     ledger, str(shot.get(\"char_id\") or \"\")) or \"\")\r\n 3138:             except Exception:  # noqa: BLE001 -- a missing look is not fatal\r\n 3139:                 _lane_look = \"\"\r\n 3140:             try:\r\n 3141:                 _lane_where = str(_lane_setting(\r\n 3142:                     (ledger or {}).get(\"meta\") or {}) or \"\")\r\n 3143:             except Exception:  # noqa: BLE001\r\n 3144:                 _lane_where = \"\"\r\n 3145:             _lane_inputs = {\r\n 3146:                 \"appearance\": _lane_look,\r\n 3147:                 \"setting\": _lane_where,\r\n 3148:                 \"expression\": str(creative.get(\"expression\") or \"\"),\r\n 3149:                 \"motion\": str(creative.get(\"motion\") or \"\"),\r\n 3150:                 \"camera\": str(creative.get(\"camera\") or \"\"),\r\n 3151:                 \"text_prompt\": str(creative.get(\"text_prompt\") or \"\"),\r\n 3152:                 \"dialogue\": (str(_lane_line.get(\"text\") or \"\")\r\n 3153:                              if _keeps else \"\"),\r\n 3154:                 \"role\": _shot_role,\r\n 3155:                 \"beat_id\": str(_visual_beat_id or \"\"),\r\n 3156:                 \"engine_id\": _eng_id,\r\n 3157:             }\r\n 3158:             _lane_text = str(_lane_formatter(_lane_engine, _lane_inputs) or \"\")\r\n 3159:             # A FORMATTER THAT HANDED BACK THE SHARED PROMPT DID NOT COMPOSE,\r\n 3160:             # AND THE RECEIPT MUST NOT SAY IT DID. Every lane's documented rule\r\n 3161:             # for a row with no authored leaves is \"return text_prompt\r\n 3162:             # unchanged\" -- correct behaviour, but stamping `engine:<id>` over\r\n 3163:             # it would claim the lane wrote something it did not. The stamp is\r\n 3164:             # how a live leg proves reachability, so a lie here is expensive:\r\n 3165:             # it would read as success on exactly the beats that still fall\r\n 3166:             # through.\r\n 3167:             if _lane_text.strip() and _lane_text != _lane_inputs[\"text_prompt\"]:\r\n 3168:                 text_prompt = _lane_text\r\n 3169:                 _lane_composed = True\r\n 3170:             else:\r\n 3171:                 # A formatter that returns nothing is a BUG in that lane, not a\r\n 3172:                 # reason to render a blank picture. Fall through to the legacy\r\n 3173:                 # chain and say so, loudly.\r\n 3174:                 _LOG.warning(\r\n 3175:                     \"[OTR.render_driver] lane formatter for %r returned an \"\r\n 3176:                     \"empty prompt on beat %s -- falling back to the shared \"\r\n 3177:                     \"composer; this is a defect in that lane's compose_prompt\",\r\n 3178:                     _eng_id, _visual_beat_id)\r\n 3179: \r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=1089; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 85 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 1089:     def canonicalize(self, raw, request, profile):\r\n 1090:         \"\"\"The silent CanonicalClip dict, with silence and CANVAS both proved.\r\n 1091: \r\n 1092:         ONE probe, fed to both checks. The exact-512x288 refusal is what earns\r\n 1093:         the composite's right to trust the declared delivery mode and launch no\r\n 1094:         redundant input probe of its own: the clean-Lanczos path does no\r\n 1095:         aspect-ratio pad or crop, so a source that is not exactly 16:9 would be\r\n 1096:         silently distorted on the way to 1920x1080. Asserting it HERE, at the 1142:             \"domain_adapter_strength\": raw.get(\"domain_adapter_strength\"),\r\n 1143:             \"native_frame_count\": raw.get(\"native_frame_count\"),\r\n 1144:             \"extension_mode\": raw.get(\"extension_mode\"),\r\n 1145:             \"render_canvas\": raw.get(\"render_canvas\"),\r\n 1146:         }\r\n 1147: \r\n 1148: \r\n 1149: def _sha8(text) -> str:\r\n 1150:     import hashlib\r\n 1151:     return hashlib.sha256(str(text or \"\").encode(\"utf-8\")).hexdigest()[:8]\r\n 1152: \r\n 1153: \r\n 1154: __all__ = [\r\n 1155:     \"GhostSignalEngine\", \"GhostCadenceError\",\r\n 1156:     \"GHOST_RECIPE_RECEIPT\", \"GHOST_CHECKPOINT_NAME\", \"GHOST_MOTION_MODULE_NAME\",\r\n 1157:     \"GHOST_CHECKPOINT_CATEGORY\", \"GHOST_MOTION_CATEGORY\",\r\n 1158:     \"GHOST_CANVAS_W\", \"GHOST_CANVAS_H\",\r\n 1159:     \"GHOST_DELIVERY_W\", \"GHOST_DELIVERY_H\", \"GHOST_DELIVERY_SCALE_MODE\",\r\n 1160:     \"GHOST_STEPS\", \"GHOST_CFG\", \"GHOST_SAMPLER_NAME\", \"GHOST_SCHEDULER\",\r\n 1161:     \"GHOST_DENOISE\", \"GHOST_BETA_SCHEDULE\",\r\n 1162:     \"GHOST_CONTEXT_LENGTH\", \"GHOST_CONTEXT_OVERLAP\",\r\n 1163:     \"GHOST_CONTEXT_FUSE_METHOD\", \"GHOST_CONTEXT_USE_ON_EQUAL_LENGTH\",\r\n 1164:     \"GHOST_CONTEXT_START_PERCENT\", \"GHOST_CONTEXT_GUARANTEE_STEPS\",\r\n 1165:     \"GHOST_SOURCE_FLOOR\", \"GHOST_SOURCE_FPS\", \"GHOST_TARGET_FPS\",\r\n 1166:     \"GHOST_NODE_CANDIDATES\", \"GHOST_ADE_OMITTED_SOCKETS\",\r\n 1167:     \"GHOST_CONTEXT_OMITTED_SOCKETS\",\r\n 1168:     \"NODE_CKPT\", \"NODE_POSITIVE\", \"NODE_NEGATIVE\", \"NODE_CONTEXT\", \"NODE_ADE\",\r\n 1169:     \"NODE_LATENT\", \"NODE_SAMPLER\", \"NODE_DECODE\",\r\n 1170:     \"ghost_unique_source_count\", \"ghost_source_request\",\r\n 1171:     \"ghost_hold2_selector\", \"ghost_hold_selector\", \"ghost_cadence_receipts\",\r\n 1172:     \"GHOST_DEFAULT_HOLD\",\r\n 1173: ]\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=780; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 245 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  780:     # ---- render --------------------------------------------------------- #\r\n  781:     def render_clip(self, request, prepared):\r\n  782:         \"\"\"One Ghost beat: encode, sample, decode, hold-2, encode a silent MP4.\r\n  783: \r\n  784:         Four bounded executor calls so the large families are not artificially\r\n  785:         pinned by one result dictionary. The cross-stage release law is the\r\n  786:         explicit owner clearing plus the public reclaim seam -- ``free_after_use``\r\n  787:         alone cannot release an external, because ``run_graph`` keeps every\r\n  788:         external id for the duration of that call.\r\n  789:         \"\"\"\r\n  790:         from . import wrapper_bridge as _wb\r\n  791:         from ._tmp import otr_engine_tmp_mp4\r\n  792: \r\n  793:         plan = self._build_render_request(request)\r\n  794:         self._assert_required_inputs(plan)\r\n  795:         classes = self._classes or _wb.resolve_graph_classes(\r\n  796:             self._node_candidates())\r\n  797:         owners = prepared if isinstance(prepared, dict) else {}\r\n  798: \r\n  799:         # ---- STAGE 2: ENCODE ------------------------------------------- #\r\n  800:         encode_graph = {\r\n  801:             NODE_POSITIVE: {\r\n  802:                 \"class\": classes[\"text_encode\"],\r\n  803:                 \"inputs\": {\"text\": plan[\"text_prompt\"],\r\n  804:                            \"clip\": _wb.Wire(\"clip\", 0)}},\r\n  805:             NODE_NEGATIVE: {\r\n  806:                 \"class\": classes[\"text_encode\"],\r\n  807:                 \"inputs\": {\"text\": plan[\"negative_prompt\"],\r\n  808:                            \"clip\": _wb.Wire(\"clip\", 0)}},\r\n  809:         }\r\n  810:         encode_results = _wb.run_graph(\r\n  811:             encode_graph, external_results={\"clip\": owners[\"clip\"]})\r\n  812:         positive_cond = (encode_results[NODE_POSITIVE][0],)\r\n  813:         negative_cond = (encode_results[NODE_NEGATIVE][0],)\r\n  814: \r\n  815:         # The CLIP family goes now: both conditionings are extracted, so every\r\n  816:         # strong reference to it must be gone BEFORE the reclaim seam runs or\r\n  817:         # the seam has nothing to move.\r\n  818:         encode_results.clear()\r\n  819:         del encode_graph\r\n  820:         owners.pop(\"clip\", None)\r\n  821:         _wb.reclaim_idle_models(\"ghost-signal post-encode\")\r\n  822: \r\n  823:         # ---- STAGE 3: SAMPLE ------------------------------------------- #\r\n  824:         sample_graph = {\r\n  825:             NODE_CONTEXT: {\r\n  826:                 \"class\": classes[\"context\"],\r\n  827:                 # The exact six frozen literals. prev_context and view_opts are\r\n  828:                 # OMITTED, not passed None.\r\n  829:                 \"inputs\": {\r\n  830:                     \"context_length\": GHOST_CONTEXT_LENGTH,\r\n  831:                     \"context_overlap\": GHOST_CONTEXT_OVERLAP,\r\n  832:                     \"fuse_method\": GHOST_CONTEXT_FUSE_METHOD,\r\n  833:                     \"use_on_equal_length\": GHOST_CONTEXT_USE_ON_EQUAL_LENGTH,\r\n  834:                     \"start_percent\": GHOST_CONTEXT_START_PERCENT,\r\n  835:                     \"guarantee_steps\": GHOST_CONTEXT_GUARANTEE_STEPS,\r\n  836:                 }},\r\n  837:             NODE_ADE: {\r\n  838:                 \"class\": classes[\"ade\"],\r\n  839:                 # motion_lora / ad_settings / ad_keyframes / sample_settings /\r\n  840:                 # scale_multival / effect_multival / per_block are OMITTED, which\r\n  841:                 # is what leaves the pinned ADE implementation owning its own\r\n  842:                 # normal full-strength behaviour.\r\n  843:                 \"inputs\": {\r\n  844:                     \"model\": _wb.Wire(\"base_model\", 0),\r\n  845:                     \"model_name\": self.motion_module_name,\r\n  846:                     \"beta_schedule\": GHOST_BETA_SCHEDULE,\r\n  847:                     \"context_options\": _wb.Wire(NODE_CONTEXT, 0),\r\n  848:                 }},\r\n  849:             NODE_LATENT: {\r\n  850:                 \"class\": classes[\"latent\"],\r\n  851:                 \"inputs\": {\"width\": GHOST_CANVAS_W,\r\n  852:                            \"height\": GHOST_CANVAS_H,\r\n  853:                            \"batch_size\": plan[\"source_request\"]}},\r\n  854:             NODE_SAMPLER: {\r\n  855:                 \"class\": classes[\"sampler\"],\r\n  856:                 \"inputs\": {\r\n  857:                     \"model\": _wb.Wire(NODE_ADE, 0),\r\n  858:                     \"seed\": plan[\"seed\"],\r\n  859:                     \"steps\": GHOST_STEPS,\r\n  860:                     \"cfg\": GHOST_CFG,\r\n  861:                     \"sampler_name\": GHOST_SAMPLER_NAME,\r\n  862:                     \"scheduler\": GHOST_SCHEDULER,\r\n  863:                     \"positive\": _wb.Wire(\"positive_cond\", 0),\r\n  864:                     \"negative\": _wb.Wire(\"negative_cond\", 0),\r\n  865:                     \"latent_image\": _wb.Wire(NODE_LATENT, 0),\r\n  866:                     \"denoise\": GHOST_DENOISE,\r\n  867:                 }},\r\n  868:         }\r\n  869: \r\n  870:         # THE DOMAIN ADAPTER, on a lane that declares one. MODEL PATH ONLY.\r\n  871:         # The artifact is 256 UNet attention tensors with ZERO text-encoder\r\n  872:         # weights -- read off the checkpoint's own key list rather than taken\r\n  873:         # from its documentation -- so CLIP has nothing to receive and keeps its\r\n  874:         # existing direct path from the checkpoint. ComfyUI maps these legacy\r\n  875:         # diffusers attn-processor keys natively (comfy/lora.py builds the\r\n  876:         # \".processor.to_q\" key; comfy/weight_adapter/lora.py appends\r\n  877:         # \"_lora.up.weight\"), which is exactly the artifact's own spelling, so\r\n  878:         # this is the stock loader with no conversion step and no custom code.\r\n  879:         if self.lora_name:\r\n  880:             sample_graph[NODE_LORA] = {\r\n  881:                 \"class\": classes[\"lora\"],\r\n  882:                 \"inputs\": {\r\n  883:                     \"model\": _wb.Wire(\"base_model\", 0),\r\n  884:                     \"lora_name\": self.lora_name,\r\n  885:                     \"strength_model\": float(self.lora_strength),\r\n  886:                 }}\r\n  887:             sample_graph[NODE_ADE][\"inputs\"][\"model\"] = _wb.Wire(NODE_LORA, 0)\r\n  888: \r\n  889:         def _register_patched(node_id, out_tuple):\r\n  890:             \"\"\"Register a PATCHED model immediately -- before the executor can\r\n  891:             evict it.\r\n  892: \r\n  893:             BOTH patch stages register here, and that is not tidiness. The\r\n  894:             adapter clones a patcher of its own, so a haunted lane holds THREE\r\n  895:             model identities -- base, adapter-patched, ADE-patched -- and every\r\n  896:             one of them must be detached before decode or it stays resident on\r\n  897:             the card for the rest of the episode.\r\n  898:             \"\"\"\r\n  899:             if node_id == NODE_LORA:\r\n  900:                 owner_key = \"lora_model\"\r\n  901:             elif node_id == NODE_ADE:\r\n  902:                 owner_key = \"ade_model\"\r\n  903:             else:\r\n  904:                 return\r\n  905:             if not out_tuple:\r\n  906:                 raise RuntimeError(\r\n  907:                     \"%s: the %s loader returned no MODEL\" % (self.name, node_id))\r\n  908:             patched = out_tuple[0]\r\n  909:             if not callable(getattr(patched, \"detach\", None)):\r\n  910:                 raise RuntimeError(\r\n  911:                     \"%s: the patched %s MODEL has no callable detach() -- \"\r\n  912:                     \"this adapter cannot take ownership of a patcher it cannot \"\r\n  913:                     \"release\" % (self.name, node_id))\r\n  914:             owners[owner_key] = patched\r\n  915:             self._patchers.append(patched)\r\n  916: \r\n  917:         sampled = _wb.run_graph(\r\n  918:             sample_graph,\r\n  919:             external_results={\"base_model\": owners[\"base_model\"],  993:             \"tail_trim=%d @ %dx%d -> %dx%d %s\",\r\n  994:             self.name, plan[\"shot_id\"], plan[\"target_frame_count\"], unique,\r\n  995:             plan[\"source_request\"], decoded, raw[\"cadence_tail_trim\"],\r\n  996:             GHOST_CANVAS_W, GHOST_CANVAS_H, GHOST_DELIVERY_W,\r\n  997:             GHOST_DELIVERY_H, GHOST_DELIVERY_SCALE_MODE)\r\n  998:         if self.lora_name:\r\n  999:             applied = float(self.lora_strength)\r\n 1000:             # Stated on EVERY haunted beat, because the operator reads the leg\r\n 1001:             # log to know what he is looking at and the recipe id cannot tell\r\n 1002:             # him which strength produced the picture.\r\n 1003:             _LOG.info(\"%s: domain adapter %s at strength %.4f\",\r\n 1004:                       self.name, self.lora_name, applied)\r\n 1005:             if applied == 0.0:\r\n 1006:                 # Not refused -- this is the legitimate adapter-off control arm\r\n 1007:                 # of a strength sweep. But it is INDISTINGUISHABLE from the\r\n 1008:                 # clean lane by eye, so it says so out loud rather than letting\r\n 1009:                 # a published episode quietly imply the adapter did something.\r\n 1010:                 _LOG.warning(\r\n 1011:                     \"%s: strength is 0.0, so ComfyUI returns the base model \"\r\n 1012:                     \"UNPATCHED -- this beat is the clean %s picture under a \"\r\n 1013:                     \"haunted receipt. That is the adapter-off control arm; if \"\r\n 1014:                     \"it was not meant, %s was not read.\",\r\n 1015:                     self.name, \"animatediff15_v3\", \"OTR_GHOST_HAUNTED_LORA_STRENGTH\")\r\n 1016:         return raw\r\n 1017: \r\n 1018:     def _release_sampling_patchers_before_decode(self, owners):\r\n 1019:         \"\"\"Detach and identity-remove the sampling patchers, outermost first.\r\n 1020: \r\n 1021:         Order is ADE, then the domain adapter (absent on every clean lane),\r\n 1022:         then base -- each patch is undone before the thing it was layered onto.\r\n 1023: \r\n 1024:         A GENERIC COMFY ``ModelPatcher`` CONTRACT, not copied LTX/Wan loader\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=3330; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 500 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 3330:     # wan_i2v shot with NO writer creative prompt gets a prompt grounded in\r\n 3331:     # THE EPISODE'S OWN BRIEF -- the source of the old episodes' scenic,\r\n 3332:     # varied opens -- finished with the brief's era tail under the LTX char\r\n 3333:     # budget. Covers ALL roles (announcer/music opens AND character),\r\n 3334:     # killing the generic \"a 1940s radio studio\"\r\n 3335:     # default for text engines. Precedence: shared visual prompt (finished at\r\n 3336:     # ShotLock) > OTR_LTX_RADIO_PROMPT (operator override, VERBATIM, no\r\n 3337:     # finishing) > brief-composed + finished. (_shot_role parsed above, once.)\r\n 3338:     # RESOLVED ONCE, HERE, FOR EVERY MEMBERSHIP TEST BELOW (2026-08-27). All\r\n 3339:     # four consumers -- strict-text-only, the two Google sets and the LTX scene\r\n 3340:     # allowlist -- compare against INTERNAL ids, so a shot row carrying a public\r\n 3341:     # menu string matched none of them: the beat skipped scene composition\r\n 3342:     # entirely and shipped `build_request`'s hardcoded \"a 1940s radio studio\"\r\n 3343:     # with `prompt_source` never stamped, which is the exact degrade this\r\n 3344:     # change exists to close. Resolution is for the COMPARISONS only --\r\n 3345:     # `shot[\"engine_id\"]` is not rewritten and dispatch still uses what\r\n 3346:     # ShotLock stamped. `foley_stems.is_foley_route` resolves before comparing\r\n 3347:     # for the same reason and says so.\r\n 3348:     try:\r\n 3349:         from .._otr_shared.public_engines import resolve_engine_id as _rid\r\n 3350:     except ImportError:  # pragma: no cover -- flat test imports\r\n 3351:         from _otr_shared.public_engines import resolve_engine_id as _rid  # type: ignore\r\n 3352:     _engine_id = str(_rid(str(shot.get(\"engine_id\") or \"\")) or \"\")\r\n 3353:     _strict_text_only = _is_strict_text_only_engine(_engine_id)\r\n 3354:     _google_text_provider = _engine_id in _GOOGLE_SILENT_TEXT_PROVIDERS\r\n 3355:     _google_prompt_provider = _engine_id in _GOOGLE_PROVIDER_PROMPT_ENGINES\r\n 3356:     if ((_engine_id in (\"ltx_video\", \"ltx25_video\", \"wan_i2v\", \"ltx_audio_in\",\r\n 3357:                         # THE TWO LANES THAT KEEP THE MODEL'S OWN AUDIO\r\n 3358:                         # (2026-08-26). They ARE the LTX 2.5 picture graph, so\r\n 3359:                         # they compose scene prompts exactly like ltx25_video.\r\n 3360:                         # Omitted, they matched no branch at all: `roles =\r\n 3361:                         # ROLES` makes them legal on the announcer and music\r\n 3362:                         # bookends, those roles arrive with `text_prompt`\r\n 3363:                         # cleared, and `_is_char_face_beat` is False -- so the\r\n 3364:                         # beat shipped `build_request`'s hardcoded \"a 1940s\r\n 3365:                         # radio studio\" default with `prompt_source` never\r\n 3366:                         # stamped. That is the exact degrade\r\n 3367:                         # `test_ltx25_HQ_open_keeps_the_role_motion_prompt`\r\n 3368:                         # was written to stop for `ltx25_video`.\r\n 3369:                         \"ltx25_foley_plus\", \"ltx25_mime\")\r\n 3370:             or _google_prompt_provider\r\n 3371:             or _strict_text_only)\r\n 3372:             and not text_prompt and not _is_char_face_beat\r\n 3373:             # Ghost already composed this shot's positive AND negative from\r\n 3374:             # the same authorities; letting the scene branch run would\r\n 3375:             # overwrite the positive and silently orphan the negative.\r\n 3376:             and not _ghost_composed):\r\n 3377:         # Round 5 F2: synthetic-open detection by STRUCTURE -- the ShotLock\r\n 3378:         # beat-id suffix is definitive; empty source_line_ids counts only\r\n 3379:         # for OPEN roles (a hypothetical provider/b-roll shot without source\r\n 3380:         # lines must not inherit the radio-open subject).\r\n 3381:         _sids = shot.get(\"source_line_ids\")\r\n 3382:         _suffix_hit = str(shot.get(\"shot_id\") or \"\").endswith(\r\n 3383:             _OPENING_MUSIC_SUFFIX)\r\n 3384:         _no_sids = isinstance(_sids, list) and not _sids\r\n 3385:         _is_synthetic_open = (_suffix_hit\r\n 3386:                               or (_no_sids and _shot_role in\r\n 3387:                                   (\"announcer_visual\", \"music_visual\")))\r\n 3388:         _is_open = (_is_synthetic_open\r\n 3389:                     or _shot_role in (\"announcer_visual\", \"music_visual\"))\r\n 3390:         _override = (os.environ.get(\"OTR_LTX_RADIO_PROMPT\", \"\").strip()\r\n 3391:                      if _is_open else \"\")\r\n 3392:         if _override:\r\n 3393:             _LOG.warning(\"[OTR.render_driver] LTX SCENE: %s beat %s prompt \"\r\n 3394:                          \"= OTR_LTX_RADIO_PROMPT operator override \"\r\n 3395:                          \"(verbatim except the banana route, unfinished)\",\r\n 3396:                          _shot_role, shot.get(\"shot_id\"))\r\n 3397:             req[\"text_prompt\"] = _override\r\n 3398:             _stamp_prompt_meta(req, \"env\", _override,\r\n 3399:                                beat=_beat_id_for_shot(shot))\r\n 3400:         elif _is_open:\r\n 3401:             # 6/5 MOTION-CENTRIC restoration (BUG-LOCAL-112): the announcer /\r\n 3402:             # music radio-console beats render a MOTION-ONLY prompt. The i2v\r\n 3403:             # anchor carries the LOOK from the FLUX still, so the prompt's only\r\n 3404:             # job is to MOVE. The refactor had led with a scene-DESCRIPTIVE\r\n 3405:             # subject (\"a 1940s radio station studio, glowing warmly...\") which\r\n 3406:             # the model reads as \"render this set\" -> flat pans on the\r\n 3407:             # conditioned still. An optional short atmosphere fragment appends\r\n 3408:             # AFTER the motion verbs, dropped if it breaks the 240-char budget.\r\n 3409:             _motion_key = _ltx_motion_role_key(\r\n 3410:                 _shot_role, shot.get(\"shot_id\"), _is_synthetic_open)\r\n 3411:             # Chunk A2: the motion VALUE comes from the style pack (exact-key\r\n 3412:             # indexing -- the loader guarantees the 4 console keys, and the\r\n 3413:             # old silent `or ...[\"announcer\"]` fallback is RETIRED per r2\r\n 3414:             # codex S3: a missing key raises LOUD, never remaps to announcer).\r\n 3415:             # SUBSTITUTION ORDER (r3): pack motion value FIRST, THEN the\r\n 3416:             # _talking_swap override -- the probe-locked IA2V talking prompt\r\n 3417:             # is a VERBATIM Python constant (P8) and always outranks the pack.\r\n 3418:             scene_prompt = _vstyle.motion_registers[_motion_key]\r\n 3419:             _field_source = \"motion_registers:%s\" % _motion_key\r\n 3420:             # ia2v TALKING register: both explicitly audio-driven radio bookends\r\n 3421:             # use the lip-sync prompt and the matching radio-with-lips still.\r\n 3422:             # Single-pass or non-audio-driven music stays on its faceless\r\n 3423:             # console-motion register.\r\n 3424:             _talking_swap = (_shot_role in (\"announcer_visual\", \"music_visual\")\r\n 3425:                              and _talking_register)\r\n 3426:             if _talking_swap:\r\n 3427:                 scene_prompt = _IA2V_TALKING_PROMPT_ANNOUNCER\r\n 3428:                 _field_source = \"python:ia2v_talking\"\r\n 3429:                 _LOG.warning(\r\n 3430:                     \"[OTR.render_driver] IA2V TALKING register: %s \"\r\n 3431:                     \"bookend %s prompt swapped to the lip-sync register\",\r\n 3432:                     _shot_role, shot.get(\"shot_id\"))\r\n 3433:             _meta = (ledger or {}).get(\"meta\") or {}\r\n 3434:             _terms = (_meta.get(\"story_brief_terms\")\r\n 3435:                       if isinstance(_meta, dict) else None) or {}\r\n 3436:             _atmo = \", \".join([str(t).strip() for t in\r\n 3437:                                (_terms.get(\"atmosphere\") or [])\r\n 3438:                                if str(t).strip()][:1])\r\n 3439:             # kibitz r2: the talking register stays PURE -- no atmosphere\r\n 3440:             # fragment rides the lip-sync prompt (mood tokens dilute the\r\n 3441:             # speech narration the recipe follows).\r\n 3442:             if (_atmo and not _talking_swap\r\n 3443:                     and len(scene_prompt) + len(_atmo) + 7\r\n 3444:                     <= _LTX_MOTION_PROMPT_MAX):\r\n 3445:                 scene_prompt = f\"{scene_prompt} {_atmo} mood.\"\r\n 3446:             if (_google_text_provider\r\n 3447:                     and _field_source.startswith(\"motion_registers:\")):\r\n 3448:                 try:\r\n 3449:                     from .._otr_story_brief_helpers import (  # type: ignore\r\n 3450:                         finish_visual_prompt, get_open_subject)\r\n 3451:                 except ImportError:  # pragma: no cover -- flat test imports\r\n 3452:                     from _otr_story_brief_helpers import (  # type: ignore\r\n 3453:                         finish_visual_prompt, get_open_subject)\r\n 3454:                 _meta = (ledger or {}).get(\"meta\") or {}\r\n 3455:                 _subject = get_open_subject(\r\n 3456:                     _shot_role, _is_synthetic_open, _meta, style=_vstyle)\r\n 3457:                 _role_hint = (\r\n 3458:                     \"single luminous radio receiver as the only visible \"\r\n 3459:                     \"subject\")\r\n 3460:                 if _shot_role == \"announcer_visual\":\r\n 3461:                     _role_hint = (\r\n 3462:                         \"anthropomorphic radio receiver as the only visible \"\r\n 3463:                         \"host subject\")\r\n 3464:                 scene_prompt = finish_visual_prompt(\r\n 3465:                     _meta,\r\n 3466:                     f\"{_subject}, {_role_hint}, {scene_prompt}\",\r\n 3467:                     max_chars=620, style_tail=True, era_profile=\"still\",\r\n 3468:                     style=_vstyle)\r\n 3469:                 # Published INSIDE the google block on purpose: this is the only\r\n 3470:                 # one of the four sub-paths reaching the assignment below that\r\n 3471:                 # caps at all. (_field_source is REASSIGNED just below, so a\r\n 3472:                 # post-block test for \"motion_registers:\" would be false exactly\r\n 3473:                 # when the 620 cap did apply.) No engineered trailing clause.\r\n 3474:                 _prompt_char_budget = 620\r\n 3475:                 _field_source = (\r\n 3476:                     \"open_subjects:%s+motion_registers:%s\" %\r\n 3477:                     ((\"synthetic\" if _is_synthetic_open\r\n 3478:                       else (\"announcer\" if _shot_role == \"announcer_visual\"\r\n 3479:                             else \"default\")), _motion_key))\r\n 3480:             _pre_cue_chars = len(scene_prompt)\r\n 3481:             scene_prompt = _prefix_video_style_cue(_vstyle, scene_prompt)\r\n 3482:             if _prompt_char_budget is not None:\r\n 3483:                 _prompt_char_budget += len(scene_prompt) - _pre_cue_chars\r\n 3484:             _LOG.warning(\"[OTR.render_driver] LTX MOTION: %s beat %s motion-\"\r\n 3485:                          \"centric prompt (role=%s, %d chars): %.90s...\",\r\n 3486:                          _shot_role, shot.get(\"shot_id\"), _motion_key,\r\n 3487:                          len(scene_prompt), scene_prompt)\r\n 3488:             req[\"text_prompt\"] = scene_prompt\r\n 3489:             req[\"observability\"][\"prompt_field_source\"] = _field_source\r\n 3490:             _stamp_prompt_meta(req, \"motion_role\", scene_prompt,\r\n 3491:                                beat=_beat_id_for_shot(shot))\r\n 3492:         else:\r\n 3493:             try:\r\n 3494:                 from .._otr_story_brief_helpers import (  # type: ignore\r\n 3495:                     finish_visual_prompt, get_story_brief_ltx)\r\n 3496:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3497:                 from _otr_story_brief_helpers import (  # type: ignore\r\n 3498:                     finish_visual_prompt, get_story_brief_ltx)\r\n 3499:             _meta = (ledger or {}).get(\"meta\") or {}\r\n 3500:             _terms = _meta.get(\"story_brief_terms\") or {}\r\n 3501: \r\n 3502:             def _term_join(key, n):\r\n 3503:                 raw = _terms.get(key) if isinstance(_terms, dict) else None\r\n 3504:                 return \", \".join([str(t).strip() for t in (raw or [])\r\n 3505:                                   if str(t).strip()][:n])\r\n 3506: \r\n 3507:             # Non-open text-engine roles keep the brief\r\n 3508:             # logline core + beat clauses; the announcer/music OPEN roles use\r\n 3509:             # the motion-centric branch above (the i2v still carries the look).\r\n 3510:             # THE CORE TAKES ITS SHIPPED 90 CHARS. The variable budget that\r\n 3511:             # used to live here existed solely to make room for the opt-in\r\n 3512:             # motion clause, which was ripped 2026-08-27; with no clause to\r\n 3513:             # accommodate, `get_story_brief_ltx`'s own default is the whole\r\n 3514:             # answer and the arithmetic that shrank it has nothing to shrink\r\n 3515:             # for. This is the value the non-override path always used, so\r\n 3516:             # every production render is byte-identical across the rip.\r\n 3517:             core = get_story_brief_ltx(_meta, max_chars=90)\r\n 3518:             if not core:\r\n 3519:                 _setting = _term_join(\"setting\", 2)\r\n 3520:                 core = (\"cinematic establishing shot\"\r\n 3521:                         + (f\", {_setting}\" if _setting else \"\"))\r\n 3522:             # ONE PATH. The override branch that used to sit here belonged to\r\n 3523:             # the ripped motion-clause pass; with that gone this is the only\r\n 3524:             # composition, and it is the one every production render already\r\n 3525:             # took. \"no on-screen text\" stays last -- the P4 probe observed\r\n 3526:             # on-video text hallucination on this lane, so the steer is not\r\n 3527:             # optional decoration.\r\n 3528:             clauses = list(_beat_clauses(line, shot.get(\"shot_id\")))\r\n 3529:             clauses.extend([\"slow cinematic camera drift\", \"no on-screen text\"])\r\n 3530:             scene_prompt = finish_visual_prompt(\r\n 3531:                 _meta, f\"{core}, {', '.join(clauses)}\",\r\n 3532:                 max_chars=188, style_tail=False, era_profile=\"still\")\r\n 3533:             _prompt_char_budget = 188\r\n 3534:             # The tail this branch engineered and expects to survive the banana\r\n 3535:             # funnel's re-cap.\r\n 3536:             _prompt_protected_clause = \"slow cinematic camera drift\"\r\n 3537:             _pre_cue_chars = len(scene_prompt)\r\n 3538:             scene_prompt = _prefix_video_style_cue(_vstyle, scene_prompt)\r\n 3539:             # Budget is EXTENDED by exactly the cue's length, not re-truncated\r\n 3540:             # to 188 -- and that is deliberate. `_prompt_char_budget` is not a\r\n 3541:             # cap on this prompt; it is the budget published to the BANANA\r\n 3542:             # re-cap below (`_banana_cap`), which only fires when the\r\n 3543:             # substitution CROSSES it. The 188 governs the COMPOSED CONTENT;\r\n 3544:             # the style cue is additive and sits outside it, so extending the\r\n 3545:             # budget is what stops the banana cap from trimming the cue away.\r\n 3546:             # (Confirmed 2026-08-08, follow-up chip closed: intended, not a\r\n 3547:             # defect. Same idiom at the two sibling branches above.)\r\n 3548:             _prompt_char_budget += len(scene_prompt) - _pre_cue_chars\r\n 3549:             _LOG.warning(\"[OTR.render_driver] LTX SCENE: %s beat %s prompt \"\r\n 3550:                          \"composed from the episode brief (%d chars): \"\r\n 3551:                          \"%.90s...\", _shot_role, shot.get(\"shot_id\"),\r\n 3552:                          len(scene_prompt), scene_prompt)\r\n 3553:             req[\"text_prompt\"] = scene_prompt\r\n 3554:             _stamp_prompt_meta(req, \"brief+beat\", scene_prompt,\r\n 3555:                                beat=_beat_id_for_shot(shot))\r\n 3556:     # THE JOINT-AV AUDIO REQUIREMENT (2026-08-26). `ltx25_foley_plus` and\r\n 3557:     # `ltx25_mime` KEEP the audio LTX 2.5 generates alongside the picture, and\r\n 3558:     # BOTH halves are conditioned on this one positive string -- so a prompt\r\n 3559:     # that never mentions sound leaves the model to score the scene from\r\n 3560:     # whatever it guesses. Neither lane is audio-IN: no dialogue reaches here,\r\n 3561:     # and the suffix forbids voices outright.\r\n 3562:     #\r\n 3563:     # WHY THIS SEAM. Every branch above writes its result under a different\r\n 3564:     # local name (`_g_positive`, `text_prompt`, `_cf_fallback`,\r\n 3565:     # `_default_prompt`, `_override`, `scene_prompt`) but all of them assign\r\n 3566:     # into `req[\"text_prompt\"]`. That key is the ONE place they converge, and\r\n 3567:     # this is the last point before the banana route, so the finisher runs\r\n 3568:     # exactly once over whatever actually won.\r\n 3569:     # Reuses the id resolved once above -- one normalisation for the whole\r\n 3570:     # request builder, not a second copy of the same map.\r\n 3571:     _jav_engine = _engine_id\r\n 3572:     if _jav_engine in (\"ltx25_foley_plus\", \"ltx25_mime\"):\r\n 3573:         try:\r\n 3574:             from .eng_ltx25 import (finish_joint_av_positive,\r\n 3575:                                     identity_leaks_in,\r\n 3576:                                     joint_av_prompt_is_finished,\r\n 3577:                                     sounds_named_in)\r\n 3578:         except ImportError:  # pragma: no cover -- flat test imports\r\n 3579:             from eng_ltx25 import (  # type: ignore\r\n 3580:                 finish_joint_av_positive, identity_leaks_in,\r\n 3581:                 joint_av_prompt_is_finished, sounds_named_in)\r\n 3582:         # NO MOOD READ ANY MORE (operator, 2026-08-28). Mime used to lead its\r\n 3583:         # tail with the brief's music_mood_terms and ask for \"instrumental\r\n 3584:         # scene score\" -- a CATEGORY, which is precisely the defect that made\r\n 3585:         # the foley bed choose voices. The operator collapsed the two lanes to\r\n 3586:         # one prompt: \"foley / mime same thing, they use the new foley\r\n 3587:         # prompting ... the only difference between foley and mime is the mux\r\n 3588:         # layer\". The brief's mood terms still drive the MUSIC bookends through\r\n 3589:         # `_otr_music_prompt`, which was always their real owner.\r\n 3590:         _jav_before = str(req.get(\"text_prompt\") or \"\")\r\n 3591:         _jav_after = finish_joint_av_positive(_jav_engine, _jav_before)\r\n 3592:         # THE PROTECTION IS UNCONDITIONAL, THE MUTATION IS NOT (2026-08-27,\r\n 3593:         # found independently by two panel lanes). These two lines used to sit\r\n 3594:         # inside the `!=` branch below, so a prompt that ALREADY carried its\r\n 3595:         # suffix -- an idempotent re-entry, or a pre-finished fixture -- took\r\n 3596:         # the no-change path and left the scene branch's published 188-char\r\n 3597:         # budget standing. The banana re-cap would then trim the prompt back to\r\n 3598:         # 188 and throw away the mandatory non-speech tail, which is the one\r\n 3599:         # clause the whole seam exists to protect. A lane that keeps its audio\r\n 3600:         # owes that tail whether or not THIS call is what appended it.\r\n 3601:         _prompt_char_budget = None\r\n 3602:         _prompt_protected_clause = None\r\n 3603:         _jav_obs = req.setdefault(\"observability\", {})\r\n 3604:         # THE RECEIPT HAS TO BE PROVABLE, NOT ASSERTED (r3 finding, 2026-08-28).\r\n 3605:         # This field used to be stamped \"finished\" unconditionally, so a prompt\r\n 3606:         # that came back WITHOUT a sound frame -- an operator override already\r\n 3607:         # ending in the no-voice clause, say -- still reported finished. That is\r\n 3608:         # a false claim in the one field used to prove the lane received its\r\n 3609:         # audio requirement, and evidence in this repo is cited by hash.\r\n 3610:         # `joint_av_prompt_is_finished` is the one owner of that judgement\r\n 3611:         # since the 2026-08-29 golden-shape reordering (sound frame PRESENT\r\n 3612:         # plus the no-voice clause LAST -- the frame-and-clause pair is no\r\n 3613:         # longer contiguous at the tail on a normally composed prompt), and\r\n 3614:         # the sounds receipt reads the FINISHED string by phrase membership,\r\n 3615:         # because the composer now seats the sounds itself and a cue re-scan\r\n 3616:         # would match the phrases' own words.\r\n 3617:         _jav_ok = joint_av_prompt_is_finished(_jav_after)\r\n 3618:         _jav_obs[\"joint_av_prompt\"] = \"finished\" if _jav_ok else \"UNFINISHED\"\r\n 3619:         _jav_obs[\"joint_av_sounds\"] = sounds_named_in(_jav_after) 3744:                     _btext.encode(\"utf-8\")).hexdigest()[:8] 3798:     # Thread the beat identity for downstream cache keys (3D plan 7.3: the\r\n 3799:     # CURVE key needs line_id) -- the schema-real Timing.source_line_ids.\r\n 3800:     _sids = shot.get(\"source_line_ids\")\r\n 3801:     req[\"timing\"][\"source_line_ids\"] = (\r\n 3802:         [str(s) for s in _sids] if isinstance(_sids, list) and _sids\r\n 3803:         else ([_beat_id_for_shot(shot)] if _beat_id_for_shot(shot) else []))\r\n 3804:     # char_id rides in conditioning_refs (W7-pre migration: a top-level\r\n 3805:     # char_id is a schema extra; VideoRequest is extra=\"forbid\").\r\n 3806:     if char_id:\r\n 3807:         req[\"conditioning_refs\"][\"char_id\"] = char_id\r\n 3808:     _prune_strict_text_only_request(req, shot.get(\"engine_id\"))\r\n 3809:     return req\r\n 3810: \r\n 3811: \r\n 3812: # --------------------------------------------------------------------------- #\r\n 3813: # The in-process render (the GPU slice)\r\n 3814: # --------------------------------------------------------------------------- #\r\n 3815: def _present_request_tokens(request):\r\n 3816:     \"\"\"The role_compat input tokens a request dict actually carries (mirrors\r\n 3817:     ``schemas.VideoRequest._present_input_tokens`` for plain dicts).\"\"\"\r\n 3818:     get = request.get if isinstance(request, dict) else (\r\n 3819:         lambda k, d=None: getattr(request, k, d))\r\n 3820:     present = set()\r\n 3821:     if get(\"text_prompt\"):\r\n 3822:         present.add(\"text_prompt\")\r\n 3823:     if \"init_image\" in (get(\"asset_refs\") or {}):\r\n 3824:         present.add(\"init_image\")\r\n 3825:     if get(\"audio_ref\") is not None:\r\n 3826:         present.add(\"audio_ref\")\r\n 3827:     if get(\"base_clip_ref\"):\r\n 3828:         present.add(\"base_clip_ref\")\r\n 3829:     return present\r\n","exit_code":0,"status":"completed"}}
