Those ids\r\n  494:     are legal Wire sources, are never executed, and are added to ``keep`` so a\r\n  495:     ``free_after_use`` pass cannot evict a handle the NEXT segment still needs --\r\n  496:     without that the first segment's cleanup drops them and segment 1 dies on\r\n  497:     \"output slot unavailable\". An id present in both ``graph`` and\r\n  498:     ``external_results`` is a NAMED error, not a silent precedence rule. Values\r\n  499:     are normalised to tuples exactly like an executed node's output. This stays\r\n  500:     ENGINE-AGNOSTIC: it knows nothing about which ids or arities any adapter\r\n  501:     hoists -- that contract belongs to the adapter's ``prepare()``.\r\n  502: \r\n  503:     ``on_result(node_id, out_tuple)`` fires immediately after each EXECUTED\r\n  504:     node's output is normalised (never for an external), so a caller can\r\n  505:     register a detachable handle the moment it exists. A raising callback is\r\n  506:     surfaced NAMED and aborts the graph -- the caller is telling us it cannot\r\n  507:     take ownership, which is a reason to unwind, not to continue.\r\n  508: \r\n  509:     ``audit_node_ids`` opts named nodes into executor-owned positive evidence.\r\n  510:     After the real FUNCTION returns, the executor appends one structured record\r\n  511:     to the caller's EMPTY ``execution_records`` list and writes the same record\r\n  512:     as a compact ``[OTR graph-exec]`` JSON log line. Externals never count.\r\n  513:     The adapter chooses what it needs proved; only this executor can say the\r\n  514:     node actually returned and what shape it returned.\"\"\"\r\n  515:     classes = classes or {}\r\n  516:     audit_ids = set(audit_node_ids or ())\r\n  517:     if execution_records is not None:\r\n  518:         if not isinstance(execution_records, list):\r\n  519:             raise GraphExecutionError(\"execution_records must be a list\")\r\n  520:         if execution_records:\r\n  521:             raise GraphExecutionError(\r\n  522:                 \"execution_records must be empty at graph start -- prefilled \"\r\n  523:                 \"records are not execution proof\")\r\n  524:     if execution_records is not None and not audit_ids:\r\n  525:         raise GraphExecutionError(\r\n  526:             \"execution_records was supplied without audit_node_ids\")\r\n  527:     audit_ordinal = 0\r\n  528:     keep = set(keep or ())\r\n  529:     if terminal is not None:\r\n  530:         keep.add(terminal)\r\n  531:     evict = set(evict_after_use or ())\r\n  532:     if evict:\r\n  533:         if not free_after_use:\r\n  534:             raise GraphExecutionError(\r\n  535:                 \"evict_after_use=%r requires free_after_use=True -- eviction happens \"\r\n  536:                 \"at the drop, and nothing is dropped otherwise\" % (sorted(evict),))\r\n  537:         missing = sorted(n for n in evict if n not in graph)\r\n  538:         if missing:\r\n  539:             raise GraphExecutionError(\r\n  540:                 \"evict_after_use names node(s) not in the graph: %r\" % (missing,))\r\n  541:         kept = sorted(evict & keep)\r\n  542:         if kept:\r\n  543:             raise GraphExecutionError(\r\n  544:                 \"evict_after_use and keep both name %r -- a node cannot be evicted at \"\r\n  545:                 \"its drop and never dropped\" % (kept,))\r\n  546:     ext = {}\r\n  547:     for nid, out in (external_results or {}).items():\r\n  548:         if nid in graph:\r\n  549:             raise GraphExecutionError(\r\n  550:                 \"external result %r collides with a node in the graph -- \"\r\n  551:                 \"the caller and the graph both claim to produce it\" % (nid,))\r\n  552:         ext[nid] = out if isinstance(out, tuple) else (out,)\r\n  553:     keep |= set(ext)\r\n  554:     # Remaining-consumer count per source node (for free_after_use).\r\n  555:     node_srcs = {}\r\n  556:     remaining = {nid: 0 for nid in graph}\r\n  557:     for nid in graph:\r\n  558:         srcs = set()\r\n  559:         for val in (graph[nid].get(\"inputs\") or {}).values():\r\n  560:             for w in _iter_wires(val):\r\n  561:                 srcs.add(w.src)\r\n  562:         node_srcs[nid] = srcs\r\n  563:         for s in srcs:\r\n  564:             remaining[s] = remaining.get(s, 0) + 1\r\n  565:     results = dict(ext)\r\n  566:     for nid in _topo_order(graph, external_keys=set(ext)):\r\n  567:         node = graph[nid]\r\n  568:         cls = node.get(\"class\")\r\n  569:         if isinstance(cls, str):\r\n  570:             if cls not in classes:\r\n  571:                 raise GraphExecutionError(\r\n  572:                     \"node %r class %r unresolved\" % (nid, cls))\r\n  573:             cls = classes[cls]\r\n  574:         if cls is None:\r\n  575:             raise GraphExecutionError(\"node %r has no class\" % nid)\r\n  576:         fn_name = node.get(\"function\") or getattr(cls, \"FUNCTION\", None)\r\n  577:         if not fn_name:\r\n  578:             raise GraphExecutionError(\r\n  579:                 \"node %r class %r has no FUNCTION\" % (nid, getattr(cls, \"__name__\", cls)))\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=2800; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 380 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 2800:     # aliases for `ltx_audio_in` -- fell through to its `\"abstract\"` default.\r\n 2801:     # That was survivable while `_fam` only picked fallback prompts; it is\r\n 2802:     # NOT survivable now that the LTX character append keys the lip-sync\r\n 2803:     # protection on it, because an audio-in lane misread as `abstract` would\r\n 2804:     # lose the steadying clause that keeps its mouth in frame. Resolution is\r\n 2805:     # for CLASSIFICATION only -- `shot[\"engine_id\"]` is never rewritten and\r\n 2806:     # dispatch still uses what ShotLock stamped.\r\n 2807:     try:\r\n 2808:         from .._otr_shared.public_engines import resolve_engine_id as _fam_rid\r\n 2809:     except ImportError:  # pragma: no cover -- flat test imports\r\n 2810:         from _otr_shared.public_engines import resolve_engine_id as _fam_rid  # type: ignore\r\n 2811:     _fam = engine_family(\r\n 2812:         str(_fam_rid(str(shot.get(\"engine_id\") or \"\")) or \"\"), \"\")\r\n 2813:     # ia2v TALKING register decision, computed ONCE per shot (kibitz r2: the\r\n 2814:     # helper instantiates an engine to ask the recipe -- cheap today, but\r\n 2815:     # three call sites x every shot invites a regression if the ctor ever\r\n 2816:     # grows weight; memoize the bool here and reuse it below).\r\n 2817:     _talking_register = _ia2v_talking_register_active(shot.get(\"engine_id\"))\r\n 2818:     # ia2v TALKING register, radio-bookend precedence: an explicitly audio-driven\r\n 2819:     # announcer or music bookend that happens to carry an shared visual prompt would\r\n 2820:     # otherwise take the M4 branch below and the talking swap in the motion\r\n 2821:     # branch would never fire. Under the two-stage lip-sync recipe the\r\n 2822:     # talking register OUTRANKS M4 on radio bookends -- clearing the text here\r\n 2823:     # routes the shot into the matching radio-with-lips motion branch.\r\n 2824:     if (text_prompt and _shot_role in (\"announcer_visual\", \"music_visual\")\r\n 2825:             and _talking_register):\r\n 2826:         _LOG.warning(\r\n 2827:             \"[OTR.render_driver] IA2V TALKING register: %s bookend %s \"\r\n 2828:             \"M4 prompt OUTRANKED by the lip-sync register (M4 kept for \"\r\n 2829:             \"non-ia2v engines)\", _shot_role, shot.get(\"shot_id\"))\r\n 2830:         text_prompt = \"\"\r\n 2831:     # ROLE-driven (2026-06-26): the shared classifier also catches ltx_audio_in\r\n 2832:     # CHARACTER beats (audio_conditioned_video family), so the character\r\n 2833:     # fallback prompt + scene-prompt exclusion apply exactly as they do to an\r\n 2834:     # audio_driven_face talking head. Announcer/music bookends stay scenes.\r\n 2835:     _is_char_face_beat = _is_character_face_beat(shot)\r\n 2836:     # THE PROMPT-BUDGET INVARIANT (banana route, QA r2-r4). Every branch below\r\n 2837:     # that CAPS its own prompt publishes two things: the number it capped to,\r\n 2838:     # and the trailing clause it engineered and expects to survive. The banana\r\n 2839:     # funnel further down re-caps to that published number, preserves that\r\n 2840:     # published clause, and does nothing else. A branch that publishes NOTHING\r\n 2841:     # is never capped -- which is the whole point: the funnel used to cap every\r\n 2842:     # branch at `max(188, pre_transform_length)`, so branches that had promised\r\n 2843:     # nothing (the operator's verbatim OTR_LTX_RADIO_PROMPT override, the M4\r\n 2844:     # wall and its engineered composition tail, the 298-char announcer talking\r\n 2845:     # prompt) were handed zero headroom and lost their tails to any growth.\r\n 2846:     # Publish INSIDE the sub-path that composed the prompt, never at a shared\r\n 2847:     # assignment -- a sibling sub-path must not inherit a budget or a clause it\r\n 2848:     # never authored.\r\n 2849:     _prompt_char_budget = None\r\n 2850:     _prompt_protected_clause = None\r\n 2851:     # THE GHOST SIGNAL BRANCH (2026-08-22), and it runs BEFORE the shared visual prompt.\r\n 2852:     #\r\n 2853:     # CAPABILITY, NEVER AN ENGINE NAME. The branch fires on the engine's declared\r\n 2854:     # `prompt_profile`, resolved without assuming every id on a shot is\r\n 2855:     # registered -- a frozen ledger can carry an engine this build no longer\r\n 2856:     # ships, and `get_engine` on it would raise here rather than at the seam\r\n 2857:     # that actually cares.\r\n 2858:     #\r\n 2859:     # WHY IT OUTRANKS M4. Ghost owns its whole subject: it declares\r\n 2860:     # `accepts_still = False`, so nothing was minted for this beat and there is\r\n 2861:     # no still carrying the look. The ~900-char M4 identity/scene wall is a\r\n 2862:     # prompt written for a lane that HAS a still, and handing it to a 512x288\r\n 2863:     # SD1.5 sampler is how you get murk. The composer reads the same authorities\r\n 2864:     # M4 does -- the pack, the ledger motion clause, the beat's own mood and arc\r\n 2865:     # -- and states them in the order this model can act on.\r\n 2866:     #\r\n 2867:     # It also has to work for the CAST-TIME TEMPORARY SHOT, which is why it sits\r\n 2868:     # before every branch rather than inside one: ShotLock builds a request per\r\n 2869:     # beat through this same function long before the durable rows are minted.\r\n 2870:     _ghost_composed = False\r\n 2871:     #: TRUE ONLY on the Prompt v2 path. It suppresses the common banana funnel\r\n 2872:     #: below for this request and nothing else -- v2 has ALREADY applied the\r\n 2873:     #: route inside its shared finalizer, and letting the funnel transform an\r\n 2874:     #: already-transformed prompt would overwrite a real substitution receipt\r\n 2875:     #: with a zero-substitution one (the transform is idempotent, so the second\r\n 2876:     #: pass genuinely does nothing and would honestly report doing nothing).\r\n 2877:     _ghost_v2_finalized = False\r\n 2878:     _ghost_profile = (\r\n 2879:         getattr(_vreg.get_engine(_eng_id), \"prompt_profile\", None)\r\n 2880:         if _eng_id and _vreg.is_registered(_eng_id) else None)\r\n 2881:     if _ghost_profile == _gsp.GHOST_PROMPT_PROFILE:\r\n 2882:         # PROMPT v2 FIRST, and BEFORE the legacy character-sigil requirement.\r\n 2883:         # A present object is the whole authority for this beat: it carries the\r\n 2884:         # representation, the recurrence motif and the authored drawable leaf,\r\n 2885:         # and it requires no sigil. Absence is explicit v1 compatibility for a\r\n 2886:         # row frozen before this sprint. A present-but-MALFORMED object is\r\n 2887:         # neither -- it fails closed, because a silent v1 downgrade would look\r\n 2888:         # exactly like a healthy legacy replay.\r\n 2889:         _g_obj = shot.get(\"ghost_prompt\")\r\n 2890:         if _g_obj is not None:\r\n 2891:             try:\r\n 2892:                 _gsa.validate_ghost_prompt_object(_g_obj)\r\n 2893:             except _gsa.GhostAuthorError as exc:\r\n 2894:                 raise FamilyInputGap(\r\n 2895:                     \"Ghost Signal beat %s carries a malformed ghost_prompt \"\r\n 2896:                     \"(%s). A stamped object is the render authority for this \"\r\n 2897:                     \"lane; refusing rather than downgrading to the v1 composer.\"\r\n 2898:                     % (shot.get(\"shot_id\"), exc)) from exc\r\n 2899:             # THE CLOUD SAFETY HOOK IS PROVABLY INERT HERE, and it has to be:\r\n 2900:             # `_apply_visual_safety_prompt` fires only for a cloud engine, and\r\n 2901:             # it would append its clause AFTER this branch finalized, defeating\r\n 2902:             # both the component survival check and the token measurement.\r\n 2903:             if _is_cloud_video_engine(_eng_id):\r\n 2904:                 raise FamilyInputGap(\r\n 2905:                     \"Ghost Signal beat %s resolved to CLOUD engine %r. Prompt \"\r\n 2906:                     \"v2 finalizes its own prompt -- style, motif, leaf, law, \"\r\n 2907:                     \"banana receipt and measured window -- so a cloud peer \"\r\n 2908:                     \"would have a safety clause appended after finalization \"\r\n 2909:                     \"and past every check this branch just made.\"\r\n 2910:                     % (shot.get(\"shot_id\"), _eng_id))\r\n 2911:             _g_final = _gsa.finalize_ghost_prompt_v2(\r\n 2912:                 role=_shot_role, style=_vstyle, mode=_g_obj[\"mode\"],\r\n 2913:                 motif_cue=_g_obj[\"motif_cue\"],\r\n 2914:                 drawable_beat=_g_obj[\"drawable_beat\"],\r\n 2915:                 ledger_meta=(ledger or {}).get(\"meta\") or {})\r\n 2916:             _g_positive = str(_g_final[\"positive\"]).strip()\r\n 2917:             _g_negative = str(_g_final[\"negative\"]).strip()\r\n 2918:             req[\"text_prompt\"] = _g_positive\r\n 2919:             req[\"negative_prompt\"] = _g_negative\r\n 2920:             _stamp_prompt_meta(req, _gsp.GHOST_PROMPT_SOURCE, _g_positive,\r\n 2921:                                beat=_beat_id_for_shot(shot))\r\n 2922:             _g_obs = req.setdefault(\"observability\", {})\r\n 2923:             _g_obs[\"prompt_version\"] = _gsp.GHOST_PROMPT_VERSION_V2\r\n 2924:             _g_obs[\"negative_sha8\"] = hashlib.sha256(\r\n 2925:                 _g_negative.encode(\"utf-8\")).hexdigest()[:8]\r\n 2926:             _g_obs[\"negative_chars\"] = len(_g_negative)\r\n 2927:             _g_obs[\"prompt_slots\"] = list(_g_final.get(\"slots\")\r\n 2928:                                           or _gsp.GHOST_V2_SLOTS)\r\n 2929:             _g_obs[\"author_version\"] = _g_obj[\"author_version\"]\r\n 2930:             _g_obs[\"ghost_schema_version\"] = _g_obj[\"schema_version\"]\r\n 2931:             _g_obs[\"ghost_source\"] = _g_obj[\"source\"]\r\n 2932:             _g_obs[\"ghost_fallback_reason\"] = _g_obj[\"fallback_reason\"]\r\n 2933:             _g_obs[\"ghost_model_id\"] = _g_obj[\"model_id\"]\r\n 2934:             _g_obs[\"ghost_mode\"] = _g_obj[\"mode\"]\r\n 2935:             _g_obs[\"ghost_request_sha8\"] = _g_obj[\"request_sha256\"][:8]\r\n 2936:             _g_obs[\"ghost_output_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2937:             _g_obs[\"ghost_drawable_beat\"] = _g_obj[\"drawable_beat\"]\r\n 2938:             _g_obs[\"ghost_drawable_beat_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2939:             _g_obs[\"ghost_motif_cue\"] = _g_obj[\"motif_cue\"]\r\n 2940:             _g_obs[\"positive_clip_tokens\"] = _g_final[\"positive_clip_tokens\"]\r\n 2941:             _g_obs[\"positive_clip_windows\"] = _g_final[\"positive_clip_windows\"]\r\n 2942:             _g_obs[\"negative_clip_tokens\"] = _g_final[\"negative_clip_tokens\"]\r\n 2943:             _g_obs[\"negative_clip_windows\"] = _g_final[\"negative_clip_windows\"]\r\n 2944:             _g_obs[\"clip_window_max\"] = _g_final[\"clip_window_max\"]\r\n 2945:             _g_obs[\"clip_counter\"] = _g_final[\"clip_counter\"]\r\n 2946:             # The finalizer's OWN receipt, installed here so the funnel below\r\n 2947:             # does not run a second, idempotent transform over the same text.\r\n 2948:             _g_obs.update(_g_final[\"banana_receipt\"])\r\n 2949:             _ghost_v2_finalized = True\r\n 2950:             _ghost_composed = True\r\n 2951:             _LOG.warning(\r\n 2952:                 \"[OTR.render_driver] GHOST PROMPT v2: %s beat %s mode=%s \"\r\n 2953:                 \"source=%s composed %d chars / %d SD1 tokens in %d window(s), \"\r\n 2954:                 \"negative %d chars / %d tokens\",\r\n 2955:                 _shot_role, shot.get(\"shot_id\"), _g_obj[\"mode\"],\r\n 2956:                 _g_obj[\"source\"], len(_g_positive),\r\n 2957:                 _g_final[\"positive_clip_tokens\"],\r\n 2958:                 _g_final[\"positive_clip_windows\"], len(_g_negative),\r\n 2959:                 _g_final[\"negative_clip_tokens\"])\r\n 2960:     if _ghost_profile == _gsp.GHOST_PROMPT_PROFILE and not _ghost_composed:\r\n 2961:         # THE v1 COMPATIBILITY PATH, reached only when the row carries NO\r\n 2962:         # ghost_prompt -- a ledger frozen before Prompt v2, or a direct unit\r\n 2963:         # fixture. Every newly built Ghost preflight and row carries v2, so a\r\n 2964:         # production episode never lands here.\r\n 2965:         #\r\n 2966:         # The DRIVER resolves the live authorities; the composer stays pure and\r\n 2967:         # cycle-free. Deliberate: `_ltx_motion_role_key` and the exact-key\r\n 2968:         # `motion_registers` lookup already live here, and a second role-to-\r\n 2969:         # register table in the pure module is a table that drifts once.\r\n 2970:         _g_sids = shot.get(\"source_line_ids\")\r\n 2971:         _g_synthetic = (\r\n 2972:             str(shot.get(\"shot_id\") or \"\").endswith(_OPENING_MUSIC_SUFFIX)\r\n 2973:             or (isinstance(_g_sids, list) and not _g_sids\r\n 2974:                 and _shot_role in (\"announcer_visual\", \"music_visual\")))\r\n 2975:         _g_motion_key = _ltx_motion_role_key(\r\n 2976:             _shot_role, shot.get(\"shot_id\"), _g_synthetic)\r\n 2977:         _g_pack_register = (_vstyle.motion_registers[_g_motion_key]\r\n 2978:                             if _g_motion_key else \"\")\r\n 2979:         # The optional motion-clause pass was ripped 2026-08-27 (it was opt-in,\r\n 2980:         # default OFF, set by no profile, and the Ghost lane was excluded from\r\n 2981:         # it by capability anyway). Ghost resolves its action through the\r\n 2982:         # pack register / beat intent / neutral-action chain, which is what\r\n 2983:         # every production episode already did.\r\n 2984:         _g_clause = None\r\n 2985:         _g_sigil = str(shot.get(\"subject_sigil\") or \"\")\r\n 2986:         # A CHARACTER BEAT WITHOUT ITS DURABLE SIGIL IS A GAP, NOT A DEFAULT.\r\n 2987:         # `build_request` seeds every request with a generic 1940s-studio prompt,\r\n 2988:         # so required-input PRESENCE cannot prove this branch ran -- which is\r\n 2989:         # exactly why the miss is raised by name instead of being papered over by\r\n 2990:         # a seed that would render a lane-wrong picture and look fine doing it.\r\n 2991:         if _shot_role == \"character_video\" and not _g_sigil:\r\n 2992:             raise FamilyInputGap(\r\n 2993:                 \"Ghost Signal beat %s is a character_video shot with no \"\r\n 2994:                 \"subject_sigil. The durable identity is stamped by \"\r\n 2995:                 \"otr_shot_lock.build_execution_plan and this lane cannot \"\r\n 2996:                 \"compose a character without it -- the generic request seed is \"\r\n 2997:                 \"NOT acceptable evidence that a Ghost prompt was built.\"\r\n 2998:                 % (shot.get(\"shot_id\"),))\r\n 2999:         _g_open_subject = \"\"\r\n 3000:         if _shot_role == \"music_visual\":\r\n 3001:             try:\r\n 3002:                 from .._otr_story_brief_helpers import (  # type: ignore\r\n 3003:                     get_open_subject as _g_open)\r\n 3004:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3005:                 from _otr_story_brief_helpers import (  # type: ignore\r\n 3006:                     get_open_subject as _g_open)\r\n 3007:             _g_open_subject = _g_open(\r\n 3008:                 _shot_role, _g_synthetic, (ledger or {}).get(\"meta\") or {},\r\n 3009:                 _vstyle)\r\n 3010:         _g_out = _gsp.compose_ghost_prompt(\r\n 3011:             role=_shot_role, style=_vstyle, subject_sigil=_g_sigil,\r\n 3012:             motion_clause=_g_clause, pack_motion_fallback=_g_pack_register,\r\n 3013:             beat_intent=str(line.get(\"beat_intent\") or \"\"),\r\n 3014:             emotion=str(line.get(\"traits\") or \"\"),\r\n 3015:             story_accent=str(line.get(\"arc_phase\") or \"\"),\r\n 3016:             open_subject=_g_open_subject,\r\n 3017:             sigil_seed=_seed_from_hash(\r\n 3018:                 str(shot.get(\"render_request_hash\") or \"\"),\r\n 3019:                 str(shot.get(\"shot_id\") or \"\")))\r\n 3020:         _g_positive = str(_g_out.get(\"positive\") or \"\").strip()\r\n 3021:         _g_negative = str(_g_out.get(\"negative\") or \"\").strip()\r\n 3022:         if not _g_positive or not _g_negative:\r\n 3023:             raise FamilyInputGap(\r\n 3024:                 \"Ghost Signal beat %s composed an empty %s prompt -- this lane \"\r\n 3025:                 \"owns its entire subject, so an empty composition is a blank \"\r\n 3026:                 \"picture, not a default to fall through from.\"\r\n 3027:                 % (shot.get(\"shot_id\"),\r\n 3028:                    \"positive\" if not _g_positive else \"negative\"))\r\n 3029:         req[\"text_prompt\"] = _g_positive\r\n 3030:         req[\"negative_prompt\"] = _g_negative\r\n 3031:         # Published for the common banana funnel below: the number this branch\r\n 3032:         # capped to, and the clause it expects to survive. THE PROTECTED CLAUSE\r\n 3033:         # IS THE SUBJECT IDENTITY, not the trailing shot law -- the shot law is a\r\n 3034:         # constant this composer can always re-emit, while the subject is the one\r\n 3035:         # phrase that makes the figure the same figure beat to beat.\r\n 3036:         _prompt_char_budget = _gsp.GHOST_PROMPT_MAX_CHARS\r\n 3037:         _prompt_protected_clause = (\r\n 3038:             _g_sigil or _g_positive.split(\",\")[0].strip())\r\n 3039:         _stamp_prompt_meta(req, _gsp.GHOST_PROMPT_SOURCE, _g_positive,\r\n 3040:                            beat=_beat_id_for_shot(shot))\r\n 3041:         _g_obs = req.setdefault(\"observability\", {})\r\n 3042:         _g_obs[\"prompt_version\"] = _gsp.GHOST_PROMPT_VERSION\r\n 3043:         _g_obs[\"negative_sha8\"] = hashlib.sha256(\r\n 3044:             _g_negative.encode(\"utf-8\")).hexdigest()[:8]\r\n 3045:         _g_obs[\"negative_chars\"] = len(_g_negative)\r\n 3046:         _g_obs[\"prompt_slots\"] = list(_g_out.get(\"slots\") or ())\r\n 3047:         if _g_sigil:\r\n 3048:             _g_obs[\"subject_sigil_sha8\"] = hashlib.sha256(\r\n 3049:                 _g_sigil.encode(\"utf-8\")).hexdigest()[:8]\r\n 3050:         # TRUE ONLY NOW -- after a non-empty positive, a non-empty negative and\r\n 3051:         # the ghost_signal prompt_source are all really installed.\r\n 3052:         _ghost_composed = (\r\n 3053:             bool(req.get(\"text_prompt\")) and bool(req.get(\"negative_prompt\"))\r\n 3054:             and _g_obs.get(\"prompt_source\") == _gsp.GHOST_PROMPT_SOURCE)\r\n 3055:         if not _ghost_composed:\r\n 3056:             raise FamilyInputGap(\r\n 3057:                 \"Ghost Signal beat %s did not install a complete composed \"\r\n 3058:                 \"request (positive/negative/prompt_source) -- refusing rather \"\r\n 3059:                 \"than letting the generic seed render as if it were Ghost.\"\r\n 3060:                 % (shot.get(\"shot_id\"),))\r\n 3061:         _LOG.warning(\r\n 3062:             \"[OTR.render_driver] GHOST SIGNAL: %s beat %s composed %d chars, \"\r\n 3063:             \"negative %d chars, slots=%s\", _shot_role, shot.get(\"shot_id\"),\r\n 3064:             len(_g_positive), len(_g_negative), \",\".join(_g_obs[\"prompt_slots\"]))\r\n 3065:     # ===================================================================== #\r\n 3066:     # PER-LANE PROMPT DISPATCH (Option B, operator ruling 2026-08-27).\r\n 3067:     # ===================================================================== #\r\n 3068:     #\r\n 3069:     # THE DEFECT THIS FIXES. Every lane used to compose its prompt as\r\n 3070:     # ``get(\"text_prompt\") or <the lane's motion default>``, and ShotLock\r\n 3071:     # populates ``text_prompt`` unconditionally for every character beat -- so\r\n 3072:     # the per-lane motion prompts committed in 65538f41 lived on the dead side\r\n 3073:     # of that ``or`` and never once rendered. The live H3 leg of 2026-08-27\r\n 3074:     # proved it from production: every character beat logged ``source=m4``.\r\n 3075:     #\r\n 3076:     # THE RULE: one path per lane, always active. No flag, no shadow state, no\r\n 3077:     # legacy route. A lane that declares its OWN ``compose_prompt`` composes\r\n 3078:     # here, and the ENTIRE legacy chain below -- the shared visual prompt, the ia2v talking\r\n 3079:     # rewrite, the env override, the motion-role branch, the brief+beat branch\r\n 3080:     # and both fallbacks -- is skipped for it. Review flagged that omitting this\r\n 3081:     # bypass would let a legacy branch silently overwrite the lane's output,\r\n 3082:     # which would be the second prompt path the operator forbade.\r\n 3083:     #\r\n 3084:     # ``type(engine).__dict__`` AND NOT ``hasattr``, deliberately. The engine\r\n 3085:     # classes are subclass chains (mime <- foley_plus <- video; h3 silent and\r\n 3086:     # h3 audio-in share a base; fastwan subclasses wan). ``hasattr`` would find\r\n 3087:     # an INHERITED formatter and hand one lane another lane's motion -- exactly\r\n 3088:     # what \"each lane independent\" forbids. Only a formatter bound to the class\r\n 3089:     # itself is visible to dispatch.\r\n 3090:     #\r\n 3091:     # SCOPE: ``character_video`` only. Announcer and music beats have no\r\n 3092:     # ``creative`` row at all (CHARACTER_BEARING_ROLES is character_video\r\n 3093:     # alone), so a formatter there would compose from nothing, return blank,\r\n 3094:     # and ``finish_joint_av_positive`` raises on a blank positive -- a dead\r\n 3095:     # episode at the foley/mime bookends. Those beats keep the motion-register\r\n 3096:     # branch they already have.\r\n 3097:     _lane_composed = False\r\n 3098:     if (not _ghost_composed\r\n 3099:             and _shot_role == \"character_video\"\r\n 3100:             and _eng_id and _vreg.is_registered(_eng_id)):\r\n 3101:         _lane_engine = _vreg.get_engine(_eng_id)\r\n 3102:         _lane_formatter = type(_lane_engine).__dict__.get(\"compose_prompt\")\r\n 3103:         if _lane_formatter is not None:\r\n 3104:             _lane_line = _line_index(ledger).get(str(_visual_beat_id)) or {}\r\n 3105:             # DIALOGUE IS STRUCTURAL, NOT POLICY. A lane that does not preserve\r\n 3106:             # dialogue is handed \"\" here, so it cannot leak a spoken line even\r\n 3107:             # if its formatter wanted to. ``_lane_preserves_dialogue`` is the\r\n 3108:             # existing authority (it keys on the engine FAMILY); a hand-written\r\n 3109:             # membership list would drift from it.\r\n 3110:             try:\r\n 3111:                 from ..otr_shot_lock import (  # type: ignore\r\n 3112:                     _lane_preserves_dialogue as _lane_keeps_dialogue)\r\n 3113:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3114:                 from otr_shot_lock import (  # type: ignore\r\n 3115:                     _lane_preserves_dialogue as _lane_keeps_dialogue)\r\n 3116:             try:\r\n 3117:                 _keeps = bool(_lane_keeps_dialogue(_eng_id, _shot_role))\r\n 3118:             except Exception:  # noqa: BLE001 -- a silent lane is the safe default\r\n 3119:                 _keeps = False\r\n 3120:             # APPEARANCE AND SETTING ARE RESOLVED HERE, NOT STORED.\r\n 3121:             # Adding them to the creative object would be a schema extension\r\n 3122:             # Option B forbids, and `creative[\"text_prompt\"]` already contains\r\n 3123:             # the appearance -- storing a second raw copy invites a formatter\r\n 3124:             # emitting it twice, and worse, re-bleeding the subject anchor's\r\n 3125:             # \"speaking to camera\" into the silent lanes. Both resolvers are\r\n 3126:             # pure ledger reads.\r\n 3127:             try:\r\n 3128:                 from ..otr_shot_lock import (  # type: ignore\r\n 3129:                     _appearance_for_char as _lane_appearance,\r\n 3130:                     _read_setting as _lane_setting)\r\n 3131:             except ImportError:  # pragma: no cover -- flat test imports\r\n 3132:                 from otr_shot_lock import (  # type: ignore\r\n 3133:                     _appearance_for_char as _lane_appearance,\r\n 3134:                     _read_setting as _lane_setting)\r\n 3135:             try:\r\n 3136:                 _lane_look = str(_lane_appearance(\r\n 3137:                     ledger, str(shot.get(\"char_id\") or \"\")) or \"\")\r\n 3138:             except Exception:  # noqa: BLE001 -- a missing look is not fatal\r\n 3139:                 _lane_look = \"\"\r\n 3140:             try:\r\n 3141:                 _lane_where = str(_lane_setting(\r\n 3142:                     (ledger or {}).get(\"meta\") or {}) or \"\")\r\n 3143:             except Exception:  # noqa: BLE001\r\n 3144:                 _lane_where = \"\"\r\n 3145:             _lane_inputs = {\r\n 3146:                 \"appearance\": _lane_look,\r\n 3147:                 \"setting\": _lane_where,\r\n 3148:                 \"expression\": str(creative.get(\"expression\") or \"\"),\r\n 3149:                 \"motion\": str(creative.get(\"motion\") or \"\"),\r\n 3150:                 \"camera\": str(creative.get(\"camera\") or \"\"),\r\n 3151:                 \"text_prompt\": str(creative.get(\"text_prompt\") or \"\"),\r\n 3152:                 \"dialogue\": (str(_lane_line.get(\"text\") or \"\")\r\n 3153:                              if _keeps else \"\"),\r\n 3154:                 \"role\": _shot_role,\r\n 3155:                 \"beat_id\": str(_visual_beat_id or \"\"),\r\n 3156:                 \"engine_id\": _eng_id,\r\n 3157:             }\r\n 3158:             _lane_text = str(_lane_formatter(_lane_engine, _lane_inputs) or \"\")\r\n 3159:             # A FORMATTER THAT HANDED BACK THE SHARED PROMPT DID NOT COMPOSE,\r\n 3160:             # AND THE RECEIPT MUST NOT SAY IT DID. Every lane's documented rule\r\n 3161:             # for a row with no authored leaves is \"return text_prompt\r\n 3162:             # unchanged\" -- correct behaviour, but stamping `engine:<id>` over\r\n 3163:             # it would claim the lane wrote something it did not. The stamp is\r\n 3164:             # how a live leg proves reachability, so a lie here is expensive:\r\n 3165:             # it would read as success on exactly the beats that still fall\r\n 3166:             # through.\r\n 3167:             if _lane_text.strip() and _lane_text != _lane_inputs[\"text_prompt\"]:\r\n 3168:                 text_prompt = _lane_text\r\n 3169:                 _lane_composed = True\r\n 3170:             else:\r\n 3171:                 # A formatter that returns nothing is a BUG in that lane, not a\r\n 3172:                 # reason to render a blank picture. Fall through to the legacy\r\n 3173:                 # chain and say so, loudly.\r\n 3174:                 _LOG.warning(\r\n 3175:                     \"[OTR.render_driver] lane formatter for %r returned an \"\r\n 3176:                     \"empty prompt on beat %s -- falling back to the shared \"\r\n 3177:                     \"composer; this is a defect in that lane's compose_prompt\",\r\n 3178:                     _eng_id, _visual_beat_id)\r\n 3179: \r\n","exit_code":0,"status":"completed"}}
