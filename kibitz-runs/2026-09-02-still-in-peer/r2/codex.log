eceipt\"] = build_actual_receipt(\r\n 4188:                 _vreg.get_engine(eng) if _vreg.is_registered(eng) else None,\r\n 4189:                 shot, request, clip, segment=segment,\r\n 4190:                 wall_s=time.monotonic() - _t_render)\r\n 4191:         except Exception as exc:  # noqa: BLE001 -- never fail a render for a receipt\r\n 4192:             _LOG.warning(\"[OTR video] receipt for shot %s not built: %s: %s\",\r\n 4193:                          sid, type(exc).__name__, exc)\r\n 4194:     return clip, out_shot, [eng], (clip_peak or _mc.vram_used_mb())\r\n 4195: \r\n 4196: \r\n 4197: def render_beat_coverage(shot, ledger, *, request=None, request_builder=None,\r\n 4198:                          canvas=None, oom_engines=frozenset(),\r\n 4199:                          oom_shot_id=None, host_caps=None, profile=None):\r\n 4200:     \"\"\"Render ONE BEAT -- as one clip, or as its plan's segments assembled.\r\n 4201: \r\n 4202:     Multi-clip coverage chunk 6c/6d (2026-07-26). This is the loop the whole\r\n 4203:     block has been building toward, and the shape of it is the point:\r\n 4204: \r\n 4205:     * ONE :class:`beat_session.BeatSession` wraps every segment, so the beat\r\n 4206:       loads its weights once and releases them once, in one outer ``finally``;\r\n 4207:     * each segment gets its OWN request (``segment_index=``), which carries its\r\n 4208:       own still and its own length;\r\n 4209:     * the TERMINAL TRANSACTION happens INSIDE the loop -- a CHAIN successor\r\n 4210:       begins on the frame its predecessor just ended on, extracted immediately\r\n 4211:       after that segment renders, because segment N+1 cannot wait for a\r\n 4212:       post-episode pass to learn where it starts;\r\n 4213:     * the segments are assembled and PROVEN before the beat is handed back.\r\n 4214: \r\n 4215:     A beat with no plan, or a single-clip plan, takes the historical path\r\n 4216:     exactly: one request, one ``render_shot``, no session 