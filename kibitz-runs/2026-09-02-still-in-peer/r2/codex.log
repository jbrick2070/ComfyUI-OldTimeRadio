{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=190; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 90 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  190:     \"\"\"\r\n  191:     target = int(target_frame_count or 0)\r\n  192:     if target < 1:\r\n  193:         raise GhostCadenceError(\r\n  194:             \"Ghost Signal cadence needs a delivered target of at least 1 \"\r\n  195:             \"frame, got %r -- a 0-frame beat is a planning bug, not something \"\r\n  196:             \"to paper over here\" % (target_frame_count,))\r\n  197:     hold = max(1, int(hold))\r\n  198:     return (target + hold - 1) // hold\r\n  199: \r\n  200: \r\n  201: def ghost_source_request(target_frame_count,\r\n  202:                          hold=GHOST_DEFAULT_HOLD) -> int:\r\n  203:     \"\"\"How many source frames to actually ASK the model for.\r\n  204: \r\n  205:     ``max(U, 16)``: the structural floor is the pinned context length, so a very\r\n  206:     short beat still hands the sampler a full window. The surplus is discarded\r\n  207:     BEFORE cadence conversion and is reported separately -- it is model work that\r\n  208:     happened, not a delivered frame.\r\n  209:     \"\"\"\r\n  210:     return max(ghost_unique_source_count(target_frame_count, hold),\r\n  211:                GHOST_SOURCE_FLOOR)\r\n  212: \r\n  213: \r\n  214: def ghost_hold_selector(target_frame_count, hold=GHOST_DEFAULT_HOLD) -> list:\r\n  215:     \"\"\"The delivered-index -> source-index map: ``[0]*hold + [1]*hold ...[:T]``.\r\n  216: \r\n  217:     Source frames ``0..U-2`` appear exactly ``hold`` times. The last source\r\n  218:     frame appears however many delivered slots remain. Monotonically\r\n  219:     nondecreasing, every entry in ``[0, U)``, and exactly ``T`` long.\r\n  220:     \"\"\"\r\n  221:     target = int(target_frame_count or 0)\r\n  222:     hold = max(1, int(hold))\r\n  223:     unique = ghost_unique_source_count(target, hold)\r\n  224:     selector = []\r\n  225:     for index in range(unique):\r\n  226:         selector.extend([index] * hold)\r\n  227:     return selector[:target]\r\n  228: \r\n  229: \r\n  230: def ghost_hold2_selector(target_frame_count) -> list:\r\n  231:     \"\"\"The hold-2 cadence by name -- the golden lane's, and the default.\r\n  232: \r\n  233:     Kept as its own function because callers and tests refer to hold-2\r\n  234:     explicitly and a generic name would hide which cadence they assert.\r\n  235:     \"\"\"\r\n  236:     return ghost_hold_selector(target_frame_count, 2)\r\n  237: \r\n  238: \r\n  239: def _ghost_cadence_receipts_for(engine, target_frame_count,\r\n  240:                                 source_request=None) -> dict:\r\n  241:     \"\"\"``ghost_cadence_receipts`` bound to a lane's own hold factor.\"\"\"\r\n  242:     return ghost_cadence_receipts(target_frame_count, source_request,\r\n  243:                                   getattr(engine, \"hold_factor\",\r\n  244:                                           GHOST_DEFAULT_HOLD))\r\n  245: \r\n  246: \r\n  247: def ghost_cadence_receipts(target_frame_count, source_request=None,\r\n  248:                            hold=GHOST_DEFAULT_HOLD) -> dict:\r\n  249:     \"\"\"The MiniMax-H3-precedent rate-conversion accounting, as plain data.\r\n  250: \r\n  251:     The scopes are separate on purpose. ``native_frame_count`` is the EMITTED\r\n  252:     count, so it can never exceed the clip; ``model_frame_count`` is every frame\r\n  253:     actually requested from and decoded by the model; and\r\n  254:     ``cadence_source_frame_count`` is the unique prefix the selector retained.\r\n  255:     ``model_frame_count - cadence_source_frame_count`` therefore exposes,\r\n  256:     truthfully, any source frames generated only to satisfy the live node's\r\n  257:     structural minimum, while ``cadence_tail_trim`` covers ONLY the final\r\n  258:     hold-2 surplus and is always 0 or 1.\r\n  259: \r\n  260:     Keeping them apart is what stops ``native_frame_count`` being misread as\r\n  261:     \"T distinct diffusion samples\". It is not.\r\n  262:     \"\"\"\r\n  263:     target = int(target_frame_count or 0)\r\n  264:     hold = max(1, int(hold))\r\n  265:     unique = ghost_unique_source_count(target, hold)\r\n  266:     requested = int(source_request if source_request is not None\r\n  267:                     else ghost_source_request(target, hold))\r\n  268:     return {\r\n  269:         \"native_frame_count\": target,\r\n  270:         \"extension_mode\": \"none\",\r\n  271:         \"model_frame_count\": requested,\r\n  272:         # NAMES THE CADENCE THAT ACTUALLY RAN. A constant \"hold_2\" here would\r\n  273:         # have made every cadence peer's receipt claim the golden lane's rate.\r\n  274:         \"cadence_mode\": \"hold_%d\" % hold,\r\n  275:         \"cadence_source_frame_count\": unique,\r\n  276:         \"cadence_delivered_frame_count\": target,\r\n  277:         \"cadence_tail_trim\": (hold * unique) - target,\r\n  278:         \"delivery_scale_mode\": GHOST_DELIVERY_SCALE_MODE,\r\n  279:     }\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=110; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal_official.py' | Select-Object -Skip (\"'$start-1) -First 80 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  110: #: lane whose entire purpose is to be haunted. IT IS UNMEASURED: no strength  138:     and ZERO text-encoder tensors -- read off the checkpoint's own key list,  139:     not its documentation -- which is why this is ``LoraLoaderModelOnly`` and\r\n  140:     why CLIP keeps its untouched path. The keys are the legacy diffusers\r\n  141:     attn-processor spelling, which ComfyUI maps natively, so there is no\r\n  142:     conversion step and no custom loader anywhere in this lane.\r\n  143: \r\n  144:     WHAT IS NOT HERE YET: nothing schedules the strength across an episode. The\r\n  145:     dial is one frozen number per render. Driving it from the ledger's arc so\r\n  146:     the picture degrades as the story tightens needs a declared field on\r\n  147:     ``VideoRequest`` -- that model is ``extra=\"forbid\"`` and its one open dict\r\n  148:     is documented \"NEVER conditioning\" -- and a schema change is a design item,\r\n  149:     not a mechanical one. Prove the dial does something first.\r\n  150:     \"\"\"\r\n  151: \r\n  152:     name = \"animatediff15_v3_haunted_video\"\r\n  153: \r\n  154:     lora_name = ADAPTER_V3_NAME\r\n  155:     lora_min_bytes = ADAPTER_V3_MIN_BYTES\r\n  156:     recipe_receipt_id = \"animatediff_sd15_v3_haunted_static16_512x288_v1\"\r\n  157: \r\n  158:     @property\r\n  159:     def lora_strength(self):\r\n  160:         \"\"\"Frozen default, overridable for the strength sweep.\r\n  161: \r\n  162:         A property rather than a plain constant because the point of the first\r\n  163:         renders is to try several values without editing code between them.\r\n  164:         An unreadable or absent value lands on the frozen default rather than\r\n  165:         on zero: zero would render the CLEAN lane while stamping a haunted\r\n  166:         receipt, which is the one outcome this lane may never produce.\r\n  167:         \"\"\"\r\n  168:         raw = os.environ.get(ADAPTER_V3_STRENGTH_ENV)\r\n  169:         if raw is None or not str(raw).strip():\r\n  170:             return ADAPTER_V3_STRENGTH\r\n  171:         try:\r\n  172:             return float(raw)\r\n  173:         except (TypeError, ValueError):\r\n  174:             return ADAPTER_V3_STRENGTH\r\n  175: \r\n  176: \r\n  177: __all__ = [\"GhostSignalV3Engine\",\r\n  178:            \"GhostSignalV3HauntedEngine\",\r\n  179:            \"MM_V3_NAME\", \"MM_V2_NAME\",\r\n  180:            \"MM_V3_MIN_BYTES\", \"MM_V2_MIN_BYTES\",\r\n  181:            \"ADAPTER_V3_NAME\", \"ADAPTER_V3_MIN_BYTES\", \"ADAPTER_V3_STRENGTH\",\r\n  182:            \"ADAPTER_V3_STRENGTH_ENV\"]\r\n","exit_code":0,"status":"completed"}}
