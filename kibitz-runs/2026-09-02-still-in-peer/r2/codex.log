{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=2830; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 340 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 2830:         text_prompt = \"\" 2862:     # prompt written for a lane that HAS a still, and handing it to a 512x288\r\n 2863:     # SD1.5 sampler is how you get murk. The composer reads the same authorities\r\n 2864:     # M4 does -- the pack, the ledger motion clause, the beat's own mood and arc\r\n 2865:     # -- and states them in the order this model can act on.\r\n 2866:     #\r\n 2867:     # It also has to work for the CAST-TIME TEMPORARY SHOT, which is why it sits\r\n 2868:     # before every branch rather than inside one: ShotLock builds a request per\r\n 2869:     # beat through this same function long before the durable rows are minted.\r\n 2870:     _ghost_composed = False\r\n 2871:     #: TRUE ONLY on the Prompt v2 path. It suppresses the common banana funnel\r\n 2872:     #: below for this request and nothing else -- v2 has ALREADY applied the\r\n 2873:     #: route inside its shared finalizer, and letting the funnel transform an\r\n 2874:     #: already-transformed prompt would overwrite a real substitution receipt\r\n 2875:     #: with a zero-substitution one (the transform is idempotent, so the second\r\n 2876:     #: pass genuinely does nothing and would honestly report doing nothing).\r\n 2877:     _ghost_v2_finalized = False\r\n 2878:     _ghost_profile = (\r\n 2879:         getattr(_vreg.get_engine(_eng_id), \"prompt_profile\", None)\r\n 2880:         if _eng_id and _vreg.is_registered(_eng_id) else None)\r\n 2881:     if _ghost_profile == _gsp.GHOST_PROMPT_PROFILE:\r\n 2882:         # PROMPT v2 FIRST, and BEFORE the legacy character-sigil requirement.\r\n 2883:         # A present object is the whole authority for this beat: it carries the\r\n 2884:         # representation, the recurrence motif and the authored drawable leaf,\r\n 2885:         # and it requires no sigil. Absence is explicit v1 compatibility for a\r\n 2886:         # row frozen before this sprint. A present-but-MALFORMED object is\r\n 2887:         # neither -- it fails closed, because a silent v1 downgrade would look\r\n 2888:         # exactly like a healthy legacy replay.\r\n 2889:         _g_obj = shot.get(\"ghost_prompt\")\r\n 2890:         if _g_obj is not None:\r\n 2891:             try:\r\n 2892:                 _gsa.validate_ghost_prompt_object(_g_obj)\r\n 2893:             except _gsa.GhostAuthorError as exc:\r\n 2894:                 raise FamilyInputGap(\r\n 2895:                     \"Ghost Signal beat %s carries a malformed ghost_prompt \"\r\n 2896:                     \"(%s). A stamped object is the render authority for this \"\r\n 2897:                     \"lane; refusing rather than downgrading to the v1 composer.\"\r\n 2898:                     % (shot.get(\"shot_id\"), exc)) from exc\r\n 2899:             # THE CLOUD SAFETY HOOK IS PROVABLY INERT HERE, and it has to be:\r\n 2900:             # `_apply_visual_safety_prompt` fires only for a cloud engine, and\r\n 2901:             # it would append its clause AFTER this branch finalized, defeating\r\n 2902:             # both the component survival check and the token measurement.\r\n 2903:             if _is_cloud_video_engine(_eng_id):\r\n 2904:                 raise FamilyInputGap(\r\n 2905:                     \"Ghost Signal beat %s resolved to CLOUD engine %r. Prompt \"\r\n 2906:                     \"v2 finalizes its own prompt -- style, motif, leaf, law, \"\r\n 2907:                     \"banana receipt and measured window -- so a cloud peer \"\r\n 2908:                     \"would have a safety clause appended after finalization \"\r\n 2909:                     \"and past every check this branch just made.\"\r\n 2910:                     % (shot.get(\"shot_id\"), _eng_id))\r\n 2911:             _g_final = _gsa.finalize_ghost_prompt_v2(\r\n 2912:                 role=_shot_role, style=_vstyle, mode=_g_obj[\"mode\"],\r\n 2913:                 motif_cue=_g_obj[\"motif_cue\"],\r\n 2914:                 drawable_beat=_g_obj[\"drawable_beat\"],\r\n 2915:                 ledger_meta=(ledger or {}).get(\"meta\") or {})\r\n 2916:             _g_positive = str(_g_final[\"positive\"]).strip()\r\n 2917:             _g_negative = str(_g_final[\"negative\"]).strip()\r\n 2918:             req[\"text_prompt\"] = _g_positive\r\n 2919:             req[\"negative_prompt\"] = _g_negative\r\n 2920:             _stamp_prompt_meta(req, _gsp.GHOST_PROMPT_SOURCE, _g_positive,\r\n 2921:                                beat=_beat_id_for_shot(shot))\r\n 2922:             _g_obs = req.setdefault(\"observability\", {})\r\n 2923:             _g_obs[\"prompt_version\"] = _gsp.GHOST_PROMPT_VERSION_V2\r\n 2924:             _g_obs[\"negative_sha8\"] = hashlib.sha256(\r\n 2925:                 _g_negative.encode(\"utf-8\")).hexdigest()[:8]\r\n 2926:             _g_obs[\"negative_chars\"] = len(_g_negative)\r\n 2927:             _g_obs[\"prompt_slots\"] = list(_g_final.get(\"slots\")\r\n 2928:                                           or _gsp.GHOST_V2_SLOTS)\r\n 2929:             _g_obs[\"author_version\"] = _g_obj[\"author_version\"]\r\n 2930:             _g_obs[\"ghost_schema_version\"] = _g_obj[\"schema_version\"]\r\n 2931:             _g_obs[\"ghost_source\"] = _g_obj[\"source\"]\r\n 2932:             _g_obs[\"ghost_fallback_reason\"] = _g_obj[\"fallback_reason\"]\r\n 2933:             _g_obs[\"ghost_model_id\"] = _g_obj[\"model_id\"]\r\n 2934:             _g_obs[\"ghost_mode\"] = _g_obj[\"mode\"]\r\n 2935:             _g_obs[\"ghost_request_sha8\"] = _g_obj[\"request_sha256\"][:8]\r\n 2936:             _g_obs[\"ghost_output_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2937:             _g_obs[\"ghost_drawable_beat\"] = _g_obj[\"drawable_beat\"]\r\n 2938:             _g_obs[\"ghost_drawable_beat_sha8\"] = _g_obj[\"output_sha256\"][:8]\r\n 2939:             _g_obs[\"ghost_motif_cue\"] = _g_obj[\"motif_cue\"]\r\n 2940:             _g_obs[\"positive_clip_tokens\"] = _g_final[\"positive_clip_tokens\"]\r\n 2941:             _g_obs[\"positive_clip_windows\"] = _g_final[\"positive_clip_windows\"]\r\n 2942:             _g_obs[\"negative_clip_tokens\"] = _g_final[\"negative_clip_tokens\"]\r\n 2943:             _g_obs[\"negative_clip_windows\"] = _g_final[\"negative_clip_windows\"]\r\n 2944:             _g_obs[\"clip_window_max\"] = _g_final[\"clip_window_max\"]\r\n 2945:             _g_obs[\"clip_counter\"] = _g_final[\"clip_counter\"]\r\n 2946:             # The finalizer's OWN receipt, installed here so the funnel below\r\n 2947:             # does not run a second, idempotent transform over the same text.\r\n 2948:             _g_obs.update(_g_final[\"banana_receipt\"])\r\n 2949:             _ghost_v2_finalized = True\r\n 2950:             _ghost_composed = True\r\n 2951:             _LOG.warning(\r\n 2952:                 \"[OTR.render_driver] GHOST PROMPT v2: %s beat %s mode=%s \"\r\n 2953:                 \"source=%s composed %d chars / %d SD1 tokens in %d window(s), \"\r\n 2954:                 \"negative %d chars / %d tokens\",\r\n 2955:                 _shot_role, shot.get(\"shot_id\"), _g_obj[\"mode\"], 3138:             except Exception:  # noqa: BLE001 -- a missing look is not fatal\r\n 3139:                 _lane_look = \"\"\r\n 3140:             try:\r\n 3141:                 _lane_where = str(_lane_setting(\r\n 3142:                     (ledger or {}).get(\"meta\") or {}) or \"\")\r\n 3143:             except Exception:  # noqa: BLE001\r\n 3144:                 _lane_where = \"\"\r\n 3145:             _lane_inputs = {\r\n 3146:                 \"appearance\": _lane_look,\r\n 3147:                 \"setting\": _lane_where,\r\n 3148:                 \"expression\": str(creative.get(\"expression\") or \"\"),\r\n 3149:                 \"motion\": str(creative.get(\"motion\") or \"\"),\r\n 3150:                 \"camera\": str(creative.get(\"camera\") or \"\"),\r\n 3151:                 \"text_prompt\": str(creative.get(\"text_prompt\") or \"\"),\r\n 3152:                 \"dialogue\": (str(_lane_line.get(\"text\") or \"\")\r\n 3153:                              if _keeps else \"\"),\r\n 3154:                 \"role\": _shot_role,\r\n 3155:                 \"beat_id\": str(_visual_beat_id or \"\"),\r\n 3156:                 \"engine_id\": _eng_id,\r\n 3157:             }\r\n 3158:             _lane_text = str(_lane_formatter(_lane_engine, _lane_inputs) or \"\")\r\n 3159:             # A FORMATTER THAT HANDED BACK THE SHARED PROMPT DID NOT COMPOSE,\r\n 3160:             # AND THE RECEIPT MUST NOT SAY IT DID. Every lane's documented rule\r\n 3161:             # for a row with no authored leaves is \"return text_prompt\r\n 3162:             # unchanged\" -- correct behaviour, but stamping `engine:<id>` over\r\n 3163:             # it would claim the lane wrote something it did not. The stamp is\r\n 3164:             # how a live leg proves reachability, so a lie here is expensive:\r\n 3165:             # it would read as success on exactly the beats that still fall\r\n 3166:             # through.\r\n 3167:             if _lane_text.strip() and _lane_text != _lane_inputs[\"text_prompt\"]:\r\n 3168:                 text_prompt = _lane_text\r\n 3169:                 _lane_composed = True\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=5450; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\render_driver.py' | Select-Object -Skip (\"'$start-1) -First 150 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 5450:     # that carries a plan is held to it just as a frozen one is (chunk 3b) --\r\n 5451:     # but ALWAYS AFTER the route is final (2026-07-26 QA4). On the frozen path\r\n 5452:     # the route arrived final, so the check runs immediately. On the legacy\r\n 5453:     # path it must WAIT for the two mutations below: a plan stamped for the\r\n 5454:     # PICKED engine and validated before the force map or the radio-host\r\n 5455:     # redirect swaps it is a plan checked against an engine that does not\r\n 5456:     # render the beat -- the same ordering defect this function's own\r\n 5457:     # docstring exists to close for the still spine, one contract further\r\n 5458:     # down. Checking early is not merely useless there, it is a false\r\n 5459:     # receipt: it reports COVERAGE PLANS OK for routing that no longer holds.\r\n 5460:     if assert_frozen_route(ledger):\r\n 5461:         assert_coverage_plans(ledger)\r\n 5462:         return ledger\r\n 5463:     _LOG.debug(\r\n 5464:         \"[OTR.render_driver] no frozen route on this ledger (legacy / \"\r\n 5465:         \"hand-built / soak path) -- resolving the effective engines here, as \"\r\n 5466:         \"before the 2026-07-25 route freeze\")\r\n 5467:     ledger = apply_engine_override(ledger)\r\n 5468:     for shot in ((ledger.get(\"video\") or {}).get(\"shots\") or []):\r\n 5469:         if isinstance(shot, dict):\r\n 5470:             _enforce_radio_is_host(shot)\r\n 5471:     assert_coverage_plans(ledger)\r\n 5472:     return ledger\r\n 5473: \r\n 5474: \r\n 5475: def apply_engine_override(ledger):\r\n 5476:     \"\"\"Experiment knob (operator ask 2026-06-09: the all-LTX / forced-engine\r\n 5477:     episodes): when ``OTR_FORCE_ENGINE_MAP`` is set, re-route each planned\r\n 5478:     shot's ``engine_id``/``family`` by role BEFORE rendering, LOUDLY. NO\r\n 5479:     FALLBACKS (2026-07-02): a forced engine that fails raises RenderError\r\n 5480:     LOUD -- there is no degrade to a floor. Returns the (possibly\r\n 5481:     rewritten) ledger.\r\n 5482: \r\n 5483:     FAIL CLOSED ON A MALFORMED MAP (2026-07-25, kibitz per-beat-stills r1 --\r\n 5484:     codex ``gpt-5.6-sol`` high and agy reached this independently, judge\r\n 5485:     concurring). This used to log ``IGNORED (parse)`` and render the UNFORCED\r\n 5486:     plan, which is a silent fallback: the operator asks for a forced-route\r\n 5487:     episode, gets an ordinary one, and the only trace is a warning line in a\r\n 5488:     long log. It is worse for the still spine specifically -- the spine is\r\n 5489:     validated against whatever routing this function leaves behind, so a\r\n 5490:     swallowed parse error means stills were minted for engines that are not\r\n 5491:     the ones that render. A malformed ``OTR_FORCE_ENGINE_MAP`` is operator\r\n 5492:     misconfiguration and it is now terminal, before any GPU time is spent.\"\"\"\r\n 5493:     spec = os.environ.get(\"OTR_FORCE_ENGINE_MAP\", \"\").strip()\r\n 5494:     if not spec:\r\n 5495:         return ledger\r\n 5496:     try:\r\n 5497:         mapping = parse_engine_override(spec)\r\n 5498:     except ValueError as exc:\r\n 5499:         raise RenderError(\r\n 5500:             \"OTR_FORCE_ENGINE_MAP is malformed and the forced-route episode \"\r\n 5501:             \"cannot be planned: %s -- fix the map or unset it. NO FALLBACK to \"\r\n 5502:             \"the unforced plan (a silently unforced render is \"\r\n 5503:             \"indistinguishable from a working one).\" % exc) from exc\r\n 5504:     section = (ledger.get(\"video\") or {})\r\n 5505:     n = 0\r\n 5506:     try:\r\n 5507:         from .._otr_shared import role_compat as _role_compat\r\n 5508:     except Exception:  # noqa: BLE001 - never block the override on an import\r\n 5509:         _role_compat = None\r\n 5510:     for shot in section.get(\"shots\") or []:\r\n 5511:         role = str(shot.get(\"role\") or \"\")\r\n 5512:         engine = mapping.get(role) or mapping.get(\"*\")\r\n 5513:         if not engine or shot.get(\"engine_id\") == engine:\r\n 5514:             continue\r\n 5515:         # M3 delta (f): OTR_FORCE_ENGINE_MAP is an UNCONDITIONAL operator\r\n 5516:         # experiment knob (forcing any engine onto any role is intentional, e.g.\r\n 5517:         # ltx_video onto character_video for b-roll) -- so the force is ALWAYS\r\n 5518:         # applied. But annotate a force that does NOT fit the role per the shared\r\n 5519:         # role_compat filter with a LOUD warning so a mis-route is visible; the\r\n 5520:         # render-time assert_usable gate is still the final authority (forcing\r\n 5521:         # never bypasses it -- an unfit pick degrades LOUD at render).\r\n 5522:         if _role_compat is not None and role and _vreg.is_registered(engine):\r\n 5523:             _eng = _vreg.get_engine(engine)\r\n 5524:             _desc = {\"engine_id\": engine,\r\n 5525:                      \"roles\": tuple(getattr(_eng, \"roles\", ()) or ()),\r\n 5526:                      \"required_inputs\": tuple(\r\n 5527:                          getattr(_eng, \"required_inputs\", ()) or ())}\r\n 5528:             try:\r\n 5529:                 _fits = _role_compat.engine_fits_role(_desc, role)\r\n 5530:             except Exception:  # noqa: BLE001 - unknown role etc. -> warn unfit\r\n 5531:                 _fits = False\r\n 5532:             if not _fits:\r\n 5533:                 _LOG.warning(\r\n 5534:                     \"[OTR video] OTR_FORCE_ENGINE_MAP: role=%s does NOT fit \"\r\n 5535:                     \"engine=%s per role_compat (roles=%r required_inputs=%r) -- \"\r\n 5536:                     \"applying the force anyway (operator experiment knob); it \"\r\n 5537:                     \"will degrade LOUD at render if assert_usable rejects it\",\r\n 5538:                     role, engine, _desc[\"roles\"], _desc[\"required_inputs\"])\r\n 5539:         _LOG.warning(\r\n 5540:             \"[OTR video] LOUD ENGINE OVERRIDE shot=%s role=%s %s -> %s \"\r\n 5541:             \"(OTR_FORCE_ENGINE_MAP)\", shot.get(\"shot_id\"), role or \"?\",\r\n 5542:             shot.get(\"engine_id\"), engine)\r\n 5543:         shot[\"engine_id\"] = engine\r\n 5544:         shot[\"family\"] = engine_family(engine, shot.get(\"family\"))\r\n 5545:         n += 1\r\n 5546:     if n:\r\n 5547:         _LOG.warning(\"[OTR video] engine override applied to %d shot(s): %r\",\r\n 5548:                      n, mapping)\r\n 5549:     return ledger\r\n 5550: \r\n 5551: \r\n 5552: #: Engines that count as a REAL LTX radio-open render (BUG-LOCAL-413 guard):\r\n 5553: #: the prompt-only ltx_video, the LTX 2.5 HQ I2V lane, and the additive LTX-AV\r\n 5554: #: audio lane.\r\n 5555: _LTX_OPEN_ENGINES = frozenset(\r\n 5556:     {\"ltx_video\", \"ltx25_video\", \"ltx_audio_in\",\r\n 5557:      # The foley and mime lanes (2026-08-26) render the LTX 2.5 picture graph\r\n 5558:      # unchanged -- only the audio latent's fate differs -- so an open that\r\n 5559:      # renders on one is every bit as real an LTX open as `ltx25_video`.\r\n 5560:      # Omitting them would report a healthy open as a procgen soft-open and,\r\n 5561:      # under OTR_LTX_OPEN_STRICT=1, fail a build that did nothing wrong.\r\n 5562:      \"ltx25_foley_plus\", \"ltx25_mime\"}) 5568: def check_ltx_open_health(manifest, *, strict=None):\r\n 5569:     \"\"\"BUG-LOCAL-413 guard -- surface a radio-OPEN beat (announcer / music\r\n 5570:     console opener, incl. the synthetic b000 music_open) that did NOT render on\r\n 5571:     an LTX engine. The 6/15 ``eye_of_the_storm`` open was SOFT because the\r\n 5572:     episode rendered ZERO LTX clips and the open fell to the by-design procgen /\r\n 5573:     still_motion floor at raw 1472x832 (no upscale) -- a SILENT degrade. This\r\n 5574:     makes it LOUD: every offending open beat logs a warning; with strict mode\r\n 5575:     (env ``OTR_LTX_OPEN_STRICT=1`` or ``strict=True``) it RAISES so a build can\r\n 5576:     never ship a procgen-fallback open unnoticed. Pure read of the manifest\r\n 5577:     (never touches audio); the procgen floor STAYS the safety net -- this only\r\n 5578:     surfaces the degrade, it does not remove the fallback. Returns the list of\r\n 5579:     offending open rows (empty == healthy).\"\"\"\r\n 5580:     if strict is None:\r\n 5581:         strict = os.environ.get(\"OTR_LTX_OPEN_STRICT\", \"0\") == \"1\"\r\n 5582:     bad = []\r\n 5583:     for row in (manifest or {}).get(\"clips\") or []:\r\n 5584:         role = str(row.get(\"role\") or \"\")\r\n 5585:         bid = str(row.get(\"beat_id\") or \"\")\r\n 5586:         is_open = (role in _LTX_OPEN_ROLES\r\n 5587:                    or bid.endswith(_OPENING_MUSIC_SUFFIX))\r\n 5588:         if not is_open:\r\n 5589:             continue\r\n 5590:         eid = str(row.get(\"engine_id\") or \"\")\r\n 5591:         if eid in _LTX_OPEN_ENGINES and row.get(\"exists\"):\r\n 5592:             continue                      # healthy: a real LTX open clip\r\n 5593:         if _receipt.is_sanctioned_gap(row):\r\n 5594:             # C6 (2026-08-28): a SANCTIONED open beat is not a health failure.\r\n 5595:             # This check hunts an open that fell to the procgen/still floor\r\n 5596:             # when an LTX engine was expected -- a wiring fault. An opener\r\n 5597:             # whose required still the model refused never had an engine to\r\n 5598:             # fall from, and the operator's ruling says that episode still\r\n 5599:             # publishes; raising here in strict mode would contradict it.\r\n","exit_code":0,"status":"completed"}}
