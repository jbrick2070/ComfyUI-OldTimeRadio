r\n 1040:         seen = set()\r\n 1041:         for candidate in (owners.get(\"ade_model\"),\r\n 1042:                           owners.get(\"lora_model\"),\r\n 1043:                           (owners.get(\"base_model\") or (None,))[0]):\r\n 1044:             if candidate is None or id(candidate) in seen:\r\n 1045:                 continue\r\n 1046:             seen.add(id(candidate))\r\n 1047:             candidates.append(candidate)\r\n 1048: \r\n 1049:         # Every DISTINCT list that tracks patchers. `prepare` hands back\r\n 1050:         # `self._patchers` itself, so these are usually one object -- but a\r\n 1051:         # caller that copied it must not keep a released identity alive.\r\n 1052:         lists = []\r\n 1053:         for tracked in (owners.get(\"patchers\"), self._patchers):\r\n 1054:             if isinstance(tracked, list) and not any(\r\n 1055:                     tracked is existing for existing in lists):\r\n 1056:                 lists.append(tracked)\r\n 1057: \r\n 1058:         for candidate in candidates:\r\n 1059:             detach = getattr(candidate, \"detach\", None)\r\n 1060:             if not callable(detach):\r\n 1061:                 raise _wb.GraphExecutionError(\r\n 1062:                     \"%s: a sampling patcher (%s) has no callable detach() -- \"\r\n 1063:                     \"refusing to decode with it still resident. It stays \"\r\n 1064:                     \"tracked so teardown can try again.\"\r\n 1065:                     % (self.name, type(candidate).__name__))\r\n 1066:             try:\r\n 1067:                 detach(unpatch_all=True)\r\n 1068:             except Exception as exc:  # noqa: BLE001 -- surfaced NAMED\r\n 1069:                 raise _wb.GraphExecutionError(\r\n 1070:                     \"%s: detaching a sampling patcher (%s) raised %s: %s -- \"\r\n 1071:                     \"refusing to decode. It stays tracked so teardown can try \"\r\n 1072:                     \"again.\" % (self.name, type(candidate).__name__,\r\n 1073:                                 type(exc).__name__, exc))\r\n 1074:             for tracked in lists:\r\n 1075:                 for index in range(len(tracked) - 1, -1, -1):\r\n 1076:                     if tracked[index] is candidate:\r\n 1077:                         del tracked[index]\r\n 1078: \r\n 1079:         owners.pop(\"ade_model\", None)\r\n 1080:         # The adapter patcher is released beside the other two and must be\r\n 1081:         # dropped beside them as well. ModelPatcher.clone() SHARES the\r\n 1082:         # underlying module, so a retained adapter handle keeps the whole base\r\n 1083:         # model family reachable and quietly defeats the base release it sits\r\n 1084:         # next to.\r\n 1085:         owners.pop(\"lora_model\", None)\r\n 1086:         owners.pop(\"base_model\", None)\r\n 1087: \r\n 1088:     # ---- canonicalize ---------------------------------------------------- #\r\n 1089:     def canonicalize(self, raw, request, profile):\r\n 1090:         \"\"\"The silent CanonicalClip dict, with silence and CANVAS both proved.\r\n 1091: \r\n 1092:         ONE probe, fed to both checks. The exact-512x288 refusal is what earns\r\n 1093:         the composite's right to trust the declared delivery mode and launch no\r\n 1094:         redundant input probe of its own: the clean-Lanczos path does no\r\n 1095:         aspect-ratio pad or crop, so a source that is not exactly 16:9 would be\r\n 1096:         silently distorted on the way to 1920x1080. Asserting it HERE, at the\r\n 1097:         seam where the mode is stamped, is what makes that safe.\r\n  170:     def open(self):\r\n  171:         \"\"\"Take the handles ONCE. Raises before loading anything if a\r\n  172:         multi-segment beat cannot name what it is about to reuse.\"\"\"\r\n  173:         if self.prepared is not None:\r\n  174:             raise SessionError(\r\n  175:                 \"beat session for %r is already open -- a second open