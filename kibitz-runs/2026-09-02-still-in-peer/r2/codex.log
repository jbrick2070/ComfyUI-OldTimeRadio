:         p = hits[0]\r\n   44:     return json.loads(p.read_text(encoding=\"utf-8\"))\r\n   45: \r\n   46: \r\n   47: def recompute_sha(row: dict) -> str:\r\n   48:     causal = {k: row.get(k) for k in _RECEIPT_CAUSAL_KEYS}\r\n   49:     return hashlib.sha256(json.dumps(causal, sort_keys=True, separators=(\",\", \":\"),\r\n   50:                                      ensure_ascii=True, default=str).encode(\"utf-8\")).hexdigest()\r\n   51: \r\n   52: \r\n   53: def shots(led: dict):\r\n   54:     v = led.get(\"video\") if isinstance(led.get(\"video\"), dict) else {}\r\n   55:     return [s for s in (v.get(\"shots\") or []) if isinstance(s, dict)]\r\n   56: \r\n   57: \r\n   58: def trace(led: dict):\r\n   59:     m = led.get(\"meta\") if isinstance(led.get(\"meta\"), dict) else {}\r\n   60:     return [r for r in (m.get(\"render_trace\") or []) if isinstance(r, dict)]\r\n   61: \r\n   62: \r\n   63: def check(name: str, ok: bool, detail: str = \"\") -> bool:\r\n   64:     print(\"%-52s %s %s\" % (name, \"PASS\" if ok else \"FAIL\", detail))\r\n   65:     return ok\r\n   66: \r\n   67: \r\n   68: def main(argv=None) -> int:\r\n   69:     ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\r\n   70:     ap.add_argument(\"source\")\r\n   71:     ap.add_argument(\"replays\", nargs=\"+\")\r\n   72:     args = ap.parse_args(argv)\r\n   73:     src = load_ledger(args.source)\r\n   74:     reps = [load_ledger(r) for r in args.replays]\r\n   75:     ok = True\r\n   76:     src_meta = src.get(\"meta\") or {}\r\n   77:     for i, rep in enumerate(reps, 1):\r\n   78:         meta = rep.get(\"meta\") or {}\r\n   79:         tag = \"replay %d\" % i\r\n   80:         ok &= check(\"%s names the source\" % tag,\r\n   81:                     str(meta.get(\"replay_of_episode\") or \"\") == str(src.get(\"episode_id\") or \"\"),\r\n   82:                     \"%r vs %r\" % (meta.get(\"replay_of_episode\"), src.get(\"episode_id\")))\r\n   83:         ok &= check(\"%s has its own workspace id\" % tag,\r\n   84:                     bool(meta.get(\"replay_workspace_id\")) and not src_meta.get(\"replay_workspace_id\"))\r\n   85:         ok &= check(\"%s keeps the freeze receipt\" % tag,\r\n   86:                     str(meta.get(\"freeze_timestamp\") or \"\") == str(src_meta.get(\"freeze_timestamp\") or \"\"))\r\n   87:         s_hashes = [s.get(\"render_request_hash\") for s in shots(src)]\r\n   88:         r_hashes = [s.get(\"render_request_hash\") for s in shots(rep)]\r\n   89:         ok &= check(\"%s planned request hashes match (%d shots)\" % (tag, len(s_hashes)),\r\n   90:                     bool(s_hashes) and s_hashes == r_hashes)\r\n   91:         ok &= check(\"%s master audio sha256 identical\" % tag,\r\n   92:                     (src.get(\"audio\") or {}).get(\"master_audio_sha256\")\r\n   93:                     == (rep.get(\"audio\") or {}).get(\"master_audio_sha256\"))\r\n   94:         rows = trace(rep)\r\n   95:         ok &= check(\"%s carries a render trace (%d rows)\" % (tag, len(rows)), bool(rows))\r\n   96:         bad = [r.get(\"shot_id\") for r in rows if r.get(\"actual_request_sha\") != recompute_sha(r)]\r\n   97:         ok &= check(\"%s trace rows recompute their sha\" % tag, not bad, \", \".join(map(str, bad[:4])))\r\n   98:         s_rows = trace(src)\r\n   99:         if s_rows:\r\n  100:             by_shot = {(r.get(\"shot_id\"), r.get(\"segment_index\")): r for r in s_rows}\r\n  101:             diff = [r.get(\"shot_id\") for r in rows\r\n  102:                     if by_shot.get((r.get(\"shot_id\"), r.get(\"segment_index\")), {}).get(\"seed\") != r.get(\"seed\")]\r\n  103:             ok &= check(\"%s seeds equal the source's per shot\" % tag, not diff, \", \".join(map(str, diff[:4])))\r\n  104:     if len(reps) >= 2:\r\n  105:         a, b = trace(reps[0]), trace(reps[1])\r\n  106:         same = len(a) == len(b) and all(\r\n  107:             x.get(\"seed\") == y.ge