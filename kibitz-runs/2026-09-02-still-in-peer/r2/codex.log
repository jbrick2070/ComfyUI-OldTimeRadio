e):\r\n  463:     \"\"\"Execute a declarative node graph in dependency order; return the results.\r\n  464: \r\n  465:     ``graph`` maps ``node_id -> {\"class\": <class|name>, \"inputs\": {name: literal |  474:     ``free_after_use`` mirrors ComfyUI's executor memory model: a node's outputs  558:         srcs = set()\r\n  559:         for val in (graph[nid].get(\"inputs\") or {}).values():\r\n  560:             for w in _iter_wires(val):\r\n  561:                 srcs.add(w.src)\r\n  562:         node_srcs[nid] = srcs\r\n  563:         for s in srcs:\r\n  564:             remaining[s] = remaining.get(s, 0) + 1\r\n  565:     results = dict(ext)\r\n  566:     for nid in _topo_order(graph, external_keys=set(ext)):\r\n  567:         node = graph[nid]\r\n  568:         cls = node.get(\"class\")\r\n  569:         if isinstance(cls, str):\r\n  570:             if cls not in classes:\r\n  571:                 raise GraphExecutionError(\r\n  572:                     \"node %r class %r unresolved\" % (nid, cls))\r\n  573:             cls = classes[cls]\r\n  574:         if cls is None:\r\n  575:             raise GraphExecutionError(\"node %r has no class\" % nid)\r\n  576:         fn_name = node.get(\"function\") or getattr(cls, \"FUNCTION\", None)\r\n  577:         if not fn_name:\r\n  578:             raise GraphExecutionError(\r\n  579:                 \"node %r class %r has no FUNCTION\" % (nid, getattr(cls, \"__name__\", cls)))\r\n  580:         inst = cls() if isinstance(cls, type) else cls\r\n  581:         fn = getattr(inst, fn_name, None)\r\n  582:         if not callable(fn):\r\n  583:             raise GraphExecutionError(\r\n  584:                 \"node %r function %r not callable\" % (nid, fn_name))\r\n  585:         kwargs = {k: _resolve_value(v, results)\r\n  586:                   for k, v in (node.get(\"inputs\") or {}).items()}\r\n  587:         try:\r\n  588:             out = normalize_node_output(fn(**kwargs))\r\n  589:         except Exception as exc: