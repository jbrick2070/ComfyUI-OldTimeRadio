tegy: Strategy = Field(default_factory=Strategy)\r\n  160:     seed_bundle: SeedBundle = Field(default_factory=SeedBundle)\r\n  161:     quality: Quality = Field(default_factory=Quality)\r\n  162:     policy: Policy = Field(default_factory=Policy)\r\n  163:     #: Trace-only observability stamps (round-5 F2 prompt provenance +\r\n  164:     #: still-spine ST-4 init provenance). NEVER conditioning, never hashed\r\n  165:     #: into request identity; ``run_episode`` copies these onto trace rows.\r\n  166:     #: A REAL field (W7-pre builder migration) because the model is\r\n  167:     #: extra=\"forbid\" -- the old top-level ``_prompt_*``/``_init_*`` keys\r\n  168:     #: made every built request schema-invalid.\r\n  169:     observability: dict = Field(default_factory=dict)\r\n  170: \r\n  171:     @model_validator(mode=\"after\")\r\n  172:     def _check_family_required_inputs(self) -> \"VideoRequest\":\r\n  173:         fam = self.family_hint\r\n  174:         if fam not in FAMILIES:\r\n  175:             raise ValueError(\r\n  176:                 f\"VideoRequest.family_hint '{fam}' is not a known family \"\r\n  177:                 f\"{FAMILIES}\"\r\n  178:             )\r\n  179:         present = self._present_input_tokens()\r\n  180:         if fam == \"static_image_gen\":\r\n  181:             if not ({\"text_prompt\", \"init_image\"} & present):\r\n  182:                 raise ValueError(\r\n  183:                     \"static_image_gen requires text_prompt or \"\r\n  184:                     \"asset_refs{init_image}\"\r\n  185:                 )\r\n  186:             return self\r\n  187:         missing = [t for t in FAMILY_REQUIRED_INPUTS[fam] if t not in present]\r\n  188:         if missing:\r\n  189:             raise ValueError(\r\n  190:                 f\"VideoRequest for family '{fam}' is missing required \"\r\n  191:                 f\"input(s): {missing}\"\r\n  192:             )\r\n  193:         return self\r\n  194: \r\n  195:     def _present_input_tokens(self) -> set:\r\n  196:         present = set()\r\n  197:         if self.text_prompt:\r\n  198:             present.add(\"text_prompt\")\r\n  199:         if \"init_image\" in self.asset_refs:\r\n  200:             present.add(\"init_image\")\r\n  201:         if self.audio_ref is not None:\r\n  202:             present.add(\"audio_ref\")\r\n  203:         if self.base_clip_ref:\r\n  204:             present.add(\"base_clip_ref\")\r\n  205:         return present\r\n  206: \r\n  207: \r\n  208: # ---------------------------------------------------------------------------\r\n  209: # Output + plan models\r\n  210: # ---------------------------------------------------------------------------\r\n  211: \r\n  212: \r\n  213: class CanonicalClip(_Forbid):\r\n  214:     \"\"\"A normalized, ALWAYS-SILENT clip (or still/directory handoff).\r\n  215: \r\n  216:     Integer ``frame_count`` is the timing authority; color fields are recorded\r\n  217:     and ffprobe-asserted (normalized to bt709 / yuv420p); ``alpha`` is explicit\r\n  218:     and validated. ``has_audio`` is always False -- only ``OTR_MasterAudioMux``\r\n  219:     may emit audio (invariant V-1).\r\n  220:     \"\"\"\r\n  221: \r\n  222:     clip_id: str\r\n  223:     type: str = \"video\"            # video | still | directory\r\n  224:     path: str\r\n  225:     container: str = \"mp4\"\r\n  226:     codec: str = \"h264\"\r\n  227:     pixel_format: str = \"yuv420p\"\r\n  228:     w: int = 0\r\n  229:     h: int = 0\r\n  230:     fps: int = 0\r\n  231:     frame_count: int = 0\r\n  232:     duration_s: float = 0.0\r\n  233:     has_audio: bool = False\r\n  234:     color_primaries: str = \"bt709\"\r\n  235:     transfer: str = \"bt709\"\r\n  236:     matrix: str = \"bt709\"\r\n  237:     range: str = \"tv\"\r\n  238:     alpha: str = \"none\"            # none | straight | premultiplied\r\n  239:     engine_id: str = \"\"\r\n  240:     profile_id: str = \"\"\r\n  241:     family: str = \"\"\r\n  242:     request_hash: str = \"\"\r\n  243:     asset_hashes: list[str] = Field(default_factory=list)\r\n  244:     qc: dict = Field(default_factory=dict)\r\n  245:     #: THE HONESTY RECEIPTS (no-mirror enforcement, 2026-08-06). How many of\r\n  246:     #: this clip's frames the engine actually RENDERED, and how the rest got\r\n  247:     #: there. ``native_frame_count`` is always the EMITTED count -- what the\r\n  248:     #: adapter handed back -- never a pre-trim decoded length, so it can never\r\n  249:     #: exceed ``frame_count``. ``extension_mode`` is drawn from\r\n  250:     #: ``acceptance.EXTENSION_MODES``; ``\"none\"`` means every delivered frame was\r\n  251:     #: rendered, and it is the only mode that may ship.\r\n  252:     #:\r\n  253:     #: DECLARED HERE EVEN THOUGH THE RENDER PATH PASSES PLAIN DICTS. This class\r\n  254:     #: is ``extra=\"forbid\"``, so the day anything validates an adapter's return\r\n  255:     #: through it, an enriched clip carrying these two keys would be REJECTED as\r\n  256:     #: unknown fields -- the receipts would be dropped by the schema that exists\r\n  257:     #: to protect them. Adding them costs nothing today and removes a trap that\r\n  258:     #: would otherwise fire far from its cause.\r\n  259:     native_frame_count: Optional[int] = None\r\n  260:     extension_mode: Optional[str] = None\r\n  261:     #: THE CADENCE AND DELIVERY RECEIPTS (Ghost Signal, 2026-08-22). Declared\r\n  262:     #: here for the same reason the two above are: this model is extra=\"forbid\",\r\n  263:     #: so the day anything validates an adapter's return through it, an enriched\r\n  264:     #: clip carrying these keys would be REJECTED as unknown fields -- the\r\n  265:     #: receipts would be dropped by the schema that exists to protect them.\r\n  266:     #:\r\n  267:     #: ALL SIX ARE OPTIONAL AND ABSENCE IS LOAD-BEARING. A legacy row that never\r\n  268:     #: carried them must keep behaving byte-for-byte, so every projection copies\r\n  269:     #: them present-key-only rather than stamping six nulls onto history.\r\n  270:     #:\r\n  271:     #: `delivery_scale_mode` is how a lane DECLARES the enlargement it needs, so\r\n  272:     #: the composite never has to ask which engine produced a row.\r\n  273:     #: `cadence_mode` plus the three counts are the honest accounting of a RATE\r\n  274:     #: CONVERSION: `model_frame_count` is every frame actually requested from and\r\n  275:     #: decoded by the model, `cadence_source_frame_count` is the unique prefix\r\n  276:     #: the selector retained, and their difference exposes source frames\r\n  277:     #: generated only to satisfy a node's structural minimum. `cadence_tail_trim`\r\n  278:     #: covers ONLY the final hold-2 surplus. Keeping the scopes apart is what\r\n  279:     #: stops `native_frame_count` being misread as \"N distinct diffusion\r\n  280:     #: samples\" -- on a hold-2 lane it is not.\r\n  281:     delivery_scale_mode: Optional[str] = None\r\n  282:     cadence_mode: Optional[str] = None\r\n  283:     cadence_source_frame_count: Optional[int] = None\r\n  284:     cadence_delivered_frame_count: Optional[int] = None\r\n  285:     cadence_tail_trim: Optional[int] = None\r\n  286:     model_frame_count: Optional[int] = None\r\n  287:     #: THE FOLEY SIDECAR RECEIPTS (the LTX 2.5 foley bed, 2026-08-26). Declared\r\n  288:     #: for the third time for the same reason as the two groups above: this\r\n  289:     #: model is extra=\"forbid\", so an enriched clip carrying them would be\r\n  290:     #: REJECTED as unknown fields the day anything validates an adapter return\r\n  291:     #: through it -- the schema that exists to protect receipts would be the\r\n  292:     #: thing that dropped them.\r\n  293:     #:\r\n  294:     #: ``foley_path`` NAMES A SIDECAR WAV, THE AUTHORITATIVE MIX SOURCE.\r\n  295:     #: Per-SEGMENT rows stay ``has_audio`` False and ffprobe-proved silent.\r\n  296:     #: The BEAT row flips to True since 2026-08-29: the assembled beat mp4\r\n  297:     #: carries an AAC preview of the same audio, muxed in by the render\r\n  298:     #: driver and stripped again by the silent composite -- so\r\n  299:     #: ``OTR_MasterAudioMux`` is still the only node that puts audio into\r\n  300:     #: the EPISODE, and it mixes this sidecar with the master at a fixed\r\n  301:     #: 0.50/0.50 (operator, 2026-08-29).\r\n  302:     #:\r\n  303:     #: ``foley_`` AND NEVER ``sfx_``. The SFX bed -- separately GENERATED\r\n  304:     #: effects from a dedicated model -- was ripped on 2026-08-06 and is\r\n  305:     #: staying dead; ``tests/test_rip_sfx_bed_guard.py`` guards that prefix.\r\n  306:     #: This is the video model's OWN output. Two different features.\r\n  307:     #:\r\n  308:     #: ALL SIX OPTIONAL, AND ABSENCE IS LOAD-BEARING: every silent lane omits\r\n  309:     #: them entirely, and every projection copies them present-key-only rather\r\n  310:     #: than stamping six nulls onto rows that never made the declaration.\r\n  311:     foley_path: Optional[str] = None\r\n  312:     foley_sha256: Optional[str] = None\r\n  313:     foley_samples: Optional[int] = None\r\n  314:     foley_sample_rate: Optional[int] = None\r\n  315:     foley_channels: Optional[int] = None\r\n  316:     foley_duration_s: Optional[float] = None\r\n  317: \r\n  318: \r\n  319: class AdapterDescriptor(_Forbid):\r\n  320:     \"\"\"Static metadata an adapter declares (cold-import-safe, no weights).\"\"\"\r\n  321: \r\n  322:     engine_id: str\r\n  323:     adapter_api_version: int = 1\r\n  324:     family: str\r\n  325:     roles: tuple = ()\r\n  326:     required_inputs: tuple = ()\r\n  327:     optional_inputs: tuple = ()\r\n  328:     prepare_semantics: str = \"none\"\r\n  329:     canonicalizer: Optional[str] = None\r\n  330:     supports_audio_output: bool = False\r\n  331:     provides: tuple = ()\r\n  332:     allowed_consumers: tuple = ()\r\n  333:     provider_vram_tier: str = \"radio\"\r\n  334:     preprocess_manifest: dict = Field(default_factory=dict)\r\n  335:     dependency_manifest: dict = Field(default_factory=dict)\r\n  336:     # (requires_mesh_portrait was here -- retired 2026-08-23 with the\r\n  337:     # character_3d family, lean-mean order 4. Zero declarers, zero carriers in\r\n  338:     # any YAML/JSON row, and its only reader -- the ImageDirector granularity\r\n  339:     # lock -- is removed in the same change. extra=\"forbid\" means a stale row\r\n  340:     # carrying the key now fails LOUD, which is correct: that row was written\r\n  341:     # against a capability that no longer exists.)\r\n  342: \r\n  343: \r\n  344: class VideoProfileRow(_Forbid):\r\n  345:     \"\"\"One row of ``video_profiles.yaml`` (engine x preset policy data).\"\"\"\r\n  346: \r\n  347:     profile_id: str\r\n  348:     engine_id: str\r\n  349:     family: str\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=380; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 150 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  380:     commercial_clean = False\r\n  381: \r\n  382:     #: DELIVERED-FRAME UNITS, unbounded, quantum 1. A beat is ONE timeline even\r\n  383:     #: when it spans several internal context windows -- the 16 is a context\r\n  384:     #: window, never an OTR clip duration -- so there is no ceiling to split on\r\n  385:     #: and continuity is explicitly NONE rather than inherited.\r\n  386:     frame_contract = FrameContract(\r\n  387:         min_frames=1,\r\n  388:         max_frames=0,\r\n  389:         quantum=1,\r\n  390:         native_fps=GHOST_TARGET_FPS,\r\n  391:         allow_tail_trim=True,\r\n  392:         continuity=CONTINUITY_NONE,\r\n  393:     )\r\n  394: \r\n  395:     def __init__(self):\r\n  396:         super().__init__()\r\n  397:         self._classes = None\r\n  398:         self._artifacts = None\r\n  399: \r\n  400:     # ---- identity ------------------------------------------------------ #\r\n  401:     def _recipe_receipt(self):\r\n  402:         return self.recipe_receipt_id\r\n  403: \r\n  404:     def sampler_inputs_for(self, request):\r\n  405:         \"\"\"Every value that reaches the sampler for this request, from the SAME\r\n  406:         constants and resolvers the graph builder uses (campaign item 0, the\r\n  407:         pin r4 asked for): the render receipt hashes this dict, so two A/A\r\n  408:         nulls agree and a changed cell disagrees by construction.\"\"\"\r\n  409:         plan = self._build_render_request(request)\r\n  410:         return {\r\n  411:             \"checkpoint\": GHOST_CHECKPOINT_NAME,\r\n  412:             \"motion_module\": str(self.motion_module_name),\r\n  413:             \"adapter\": str(getattr(self, \"lora_name\", \"\") or \"\"),\r\n  414:             \"adapter_strength\": (float(self.lora_strength)\r\n  415:                                  if getattr(self, \"lora_name\", \"\") else None),\r\n  416:             \"steps\": GHOST_STEPS, \"cfg\": GHOST_CFG,\r\n  417:             \"sampler\": GHOST_SAMPLER_NAME, \"scheduler\": GHOST_SCHEDULER,\r\n  418:             \"denoise\": GHOST_DENOISE, \"beta_schedule\": GHOST_BETA_SCHEDULE,\r\n  419:             \"canvas_w\": GHOST_CANVAS_W, \"canvas_h\": GHOST_CANVAS_H,\r\n  420:             \"context_length\": GHOST_CONTEXT_LENGTH,\r\n  421:             \"context_overlap\": GHOST_CONTEXT_OVERLAP,\r\n  422:             \"context_fuse_method\": GHOST_CONTEXT_FUSE_METHOD,\r\n  423:             \"context_use_on_equal_length\": GHOST_CONTEXT_USE_ON_EQUAL_LENGTH,\r\n  424:             \"context_start_percent\": GHOST_CONTEXT_START_PERCENT,\r\n  425:             \"context_guarantee_steps\": GHOST_CONTEXT_GUARANTEE_STEPS,\r\n  426:             \"source_fps\": int(GHOST_SOURCE_FPS), \"target_fps\": int(self.target_fps),\r\n  427:             \"hold_factor\": int(self.hold_factor),\r\n  428:             \"source_request\": plan[\"source_request\"],\r\n  429:             \"unique_source_count\": plan[\"unique_source_count\"],\r\n  430:             \"latent\": \"EmptyLatentImage\", \"init_image\": None,\r\n  431:         }\r\n  432: \r\n  433:     def model_artifacts(self):\r\n  434:         \"\"\"``[(name, path)]`` of the weight files this lane loads, for the render\r\n  435:         receipt's once-per-run digest table.\"\"\"\r\n  436:         out = [(\"checkpoint\", self._ckpt_path() or \"\"),\r\n  437:                (\"motion_module\", self._motion_path() or \"\")]\r\n  438:         lora = getattr(self, \"lora_name\", \"\")\r\n  439:         if lora:\r\n  440:             out.append((\"adapter\", self._lora_path() or \"\"))\r\n  441:         return out\r\n  442: \r\n  443:     @staticmethod\r\n  444:     def _file_receipt(path):\r\n  445:         \"\"\"``(size, mtime_ns)`` for a resolved artifact, or ``None``.\r\n  446: \r\n  447:         Re-stat'ed on every ask rather than cached: the job is to NOTICE a\r\n  448:         weight that moved, and two stats are cheap where a hash of 3.9 GB is\r\n  449:         not.\"\"\"\r\n  450:         try:\r\n  451:             st = os.stat(path)\r\n  452:         except OSError:\r\n  453:             return None\r\n  454:         return (st.st_size, st.st_mtime_ns)\r\n  455: \r\n  456:     def session_identity(self):\r\n  457:         \"\"\"What this adapter's HANDLES are: engine, recipe, both artifacts.\r\n  458: \r\n  459:         PRE-LOAD STABLE, like its siblings -- it may only describe what does not\r\n  460:         change across the load, so per-shot state (prompt, seed, frame count) is\r\n  461:         deliberately absent. That state lives in :meth:`shot_cache_identity`,\r\n  462:         which is a different question with a different answer.\r\n  463:         \"\"\"\r\n  464:         parts = [self.name, self._recipe_receipt()]\r\n  465:         for token, path in (\r\n  466:                 (GHOST_CHECKPOINT_NAME, self._ckpt_path()),\r\n  467:                 (self.motion_module_name, self._motion_path())):\r\n  468:             parts.append(token)\r\n  469:             parts.append(repr(self._file_receipt(path or \"\")))\r\n  470:         # THE ADAPTER IS A HANDLE TOO, and its STRENGTH decides what the\r\n  471:         # patched model actually is -- two strengths are two different\r\n  472:         # sessions, not one session used twice. Absent entirely on the clean\r\n  473:         # lanes, so their identity is byte-identical to what it always was.\r\n  474:         if self.lora_name:\r\n  475:             parts.append(self.lora_name)\r\n  476:             parts.append(repr(self._file_receipt(self._lora_path() or \"\")))\r\n  477:             parts.append(\"strength=%.4f\" % float(self.lora_strength))\r\n  478:         return tuple(parts)\r\n  479: \r\n  480:     def shot_cache_identity(self, request):\r\n  481:         \"\"\"The PER-SHOT identity, and it is deliberately not the session one.\r\n  482: \r\n  483:         A hit may replay only that same shot's deterministic artifact. Two beats\r\n  484:         with identical composed text are still two beats: the shot id and the\r\n  485:         resolved seed are in here precisely so a prompt-only cache key can never\r\n  486:         collapse them into one, and so no beat can be handed another beat's\r\n  487:         source batch or output path.\r\n  488:         \"\"\"\r\n  489:         plan = self._build_render_request(request)\r\n  490:         return (\r\n  491:             self.name,\r\n  492:             self._recipe_receipt(),\r\n  493:             str(plan[\"shot_id\"]),\r\n  494:             int(plan[\"seed\"]),\r\n  495:             int(plan[\"unique_source_count\"]),\r\n  496:             \"%dx%d\" % (GHOST_CANVAS_W, GHOST_CANVAS_H),\r\n  497:             GHOST_CHECKPOINT_NAME,\r\n  498:             self.motion_module_name,\r\n  499:             _sha8(plan[\"text_prompt\"]),\r\n  500:             _sha8(plan[\"negative_prompt\"]),\r\n  501:         )\r\n  502: \r\n  503:     # ---- artifact resolution ------------------------------------------- #\r\n  504:     @staticmethod\r\n  505:     def _resolve_model_file_by_token(categories, name):\r\n  506:         \"\"\"Where the LOADER would find ``name`` -- through the live\r\n  507:         ``folder_paths`` categories, so ``extra_model_paths.yaml`` works.\r\n  508: \r\n  509:         The graphs hand their loader nodes a BARE TOKEN and ComfyUI resolves it\r\n  510:         through ``folder_paths``; asking the same way is the only check that\r\n  511:         answers the question the loader will actually ask. A directory override\r\n  512:         that satisfies a preflight while being invisible to the loader is the\r\n  513:         `wan_i2v` killer (lesson L1), and this name is the established one for\r\n  514:         exactly that reason -- it is the same question `wan_shared` asks.\r\n  515: \r\n  516:         Returns ``None`` when absent everywhere. The offline invariant means NO\r\n  517:         runtime fetch: a missing file is fail-closed, never downloaded.\r\n  518:         \"\"\"\r\n  519:         try:\r\n  520:             import folder_paths  # type: ignore\r\n  521:         except Exception:  # noqa: BLE001 -- not inside ComfyUI\r\n  522:             return None\r\n  523:         for category in ((categories,) if isinstance(categories, str)\r\n  524:                          else tuple(categories or ())):\r\n  525:             try:\r\n  526:                 found = folder_paths.get_full_path(category, name)\r\n  527:             except Exception:  # noqa: BLE001 -- unregistered category -> None\r\n  528:                 found = None\r\n  529:             if found:\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=1080; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\eng_ghost_signal.py' | Select-Object -Skip (\"'$start-1) -First 100 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":" 1080:         # The adapter patcher is released beside the other two and must be\r\n 1081:         # dropped beside them as well. ModelPatcher.clone() SHARES the\r\n 1082:         # underlying module, so a retained adapter handle keeps the whole base\r\n 1083:         # model family reachable and quietly defeats the base release it sits\r\n 1084:         # next to.\r\n 1085:         owners.pop(\"lora_model\", None)\r\n 1086:         owners.pop(\"base_model\", None)\r\n 1087: \r\n 1088:     # ---- canonicalize ---------------------------------------------------- #\r\n 1089:     def canonicalize(self, raw, request, profile):\r\n 1090:         \"\"\"The silent CanonicalClip dict, with silence and CANVAS both proved.\r\n 1091: \r\n 1092:         ONE probe, fed to both checks. The exact-512x288 refusal is what earns\r\n 1093:         the composite's right to trust the declared delivery mode and launch no\r\n 1094:         redundant input probe of its own: the clean-Lanczos path does no\r\n 1095:         aspect-ratio pad or crop, so a source that is not exactly 16:9 would be\r\n 1096:         silently distorted on the way to 1920x1080. Asserting it HERE, at the\r\n 1097:         seam where the mode is stamped, is what makes that safe.\r\n 1098:         \"\"\"\r\n 1099:         raw = raw or {}\r\n 1100:         path = raw.get(\"out_path\", \"\")\r\n 1101:         if path:\r\n 1102:             fields = ffprobe_clip_fields(path)\r\n 1103:             validate_silent_clip_contract(fields, self.target_fps)\r\n 1104:             width = int(fields.get(\"width\") or 0)\r\n 1105:             height = int(fields.get(\"height\") or 0)\r\n 1106:             if width != GHOST_CANVAS_W or height != GHOST_CANVAS_H:\r\n 1107:                 raise RuntimeError(\r\n 1108:                     \"%s produced a %dx%d clip; this lane delivers by clean \"\r\n 1109:                     \"full-frame Lanczos with no pad or crop, so only an exact \"\r\n 1110:                     \"%dx%d source can be enlarged to %dx%d without distorting \"\r\n 1111:                     \"it\" % (self.name, width, height, GHOST_CANVAS_W,\r\n 1112:                             GHOST_CANVAS_H, GHOST_DELIVERY_W, GHOST_DELIVERY_H))\r\n 1113: \r\n 1114:         clip = self._clip_from_raw(raw, request)\r\n 1115:         for key in (\"model_frame_count\", \"cadence_mode\",\r\n 1116:                     \"cadence_source_frame_count\",\r\n 1117:                     \"cadence_delivered_frame_count\", \"cadence_tail_trim\",\r\n 1118:                     \"delivery_scale_mode\"):\r\n 1119:             if key in raw:\r\n 1120:                 clip[key] = raw[key]\r\n 1121:         return clip\r\n 1122: \r\n 1123:     def _clip_from_raw(self, raw, request):\r\n 1124:         \"\"\"The self-declared clip dict :meth:`canonicalize` returns.\"\"\"\r\n 1125:         get = request.get if isinstance(request, dict) else (\r\n 1126:             lambda k, d=None: getattr(request, k, d))\r\n 1127:         raw = raw or {}\r\n 1128:         return {\r\n 1129:             \"clip_id\": (get(\"shot_id\") or get(\"request_id\")\r\n 1130:                         or (\"%s_clip\" % self.name)),\r\n 1131:             \"type\": \"video\",\r\n 1132:             \"path\": raw.get(\"out_path\", \"\"),\r\n 1133:             \"container\": \"mp4\", \"codec\": \"h264\", \"pixel_format\": \"yuv420p\",\r\n 1134:             \"fps\": int(self.target_fps),\r\n 1135:             \"frame_count\": int(raw.get(\"frame_count\", 0) or 0),\r\n 1136:             \"has_audio\": False,     # V-1: only OTR_MasterAudioMux emits audio\r\n 1137:             \"color_primaries\": \"bt709\", \"transfer\": \"bt709\", \"matrix\": \"bt709\",\r\n 1138:             \"engine_id\": self.name, \"family\": self.family,\r\n 1139:             \"vram_peak_mb\": raw.get(\"vram_peak_mb\"),\r\n 1140:             \"recipe\": raw.get(\"recipe\"),\r\n 1141:             \"domain_adapter\": raw.get(\"domain_adapter\"),\r\n 1142:             \"domain_adapter_strength\": raw.get(\"domain_adapter_strength\"),\r\n 1143:             \"native_frame_count\": raw.get(\"native_frame_count\"),\r\n 1144:             \"extension_mode\": raw.get(\"extension_mode\"),\r\n 1145:             \"render_canvas\": raw.get(\"render_canvas\"),\r\n 1146:         }\r\n 1147: \r\n 1148: \r\n 1149: def _sha8(text) -> str:\r\n 1150:     import hashlib\r\n 1151:     return hashlib.sha256(str(text or \"\").encode(\"utf-8\")).hexdigest()[:8]\r\n 1152: \r\n 1153: \r\n 1154: __all__ = [\r\n 1155:     \"GhostSignalEngine\", \"GhostCadenceError\",\r\n 1156:     \"GHOST_RECIPE_RECEIPT\", \"GHOST_CHECKPOINT_NAME\", \"GHOST_MOTION_MODULE_NAME\",\r\n 1157:     \"GHOST_CHECKPOINT_CATEGORY\", \"GHOST_MOTION_CATEGORY\",\r\n 1158:     \"GHOST_CANVAS_W\", \"GHOST_CANVAS_H\",\r\n 1159:     \"GHOST_DELIVERY_W\", \"GHOST_DELIVERY_H\", \"GHOST_DELIVERY_SCALE_MODE\",\r\n 1160:     \"GHOST_STEPS\", \"GHOST_CFG\", \"GHOST_SAMPLER_NAME\", \"GHOST_SCHEDULER\",\r\n 1161:     \"GHOST_DENOISE\", \"GHOST_BETA_SCHEDULE\",\r\n 1162:     \"GHOST_CONTEXT_LENGTH\", \"GHOST_CONTEXT_OVERLAP\",\r\n 1163:     \"GHOST_CONTEXT_FUSE_METHOD\", \"GHOST_CONTEXT_USE_ON_EQUAL_LENGTH\",\r\n 1164:     \"GHOST_CONTEXT_START_PERCENT\", \"GHOST_CONTEXT_GUARANTEE_STEPS\",\r\n 1165:     \"GHOST_SOURCE_FLOOR\", \"GHOST_SOURCE_FPS\", \"GHOST_TARGET_FPS\",\r\n 1166:     \"GHOST_NODE_CANDIDATES\", \"GHOST_ADE_OMITTED_SOCKETS\",\r\n 1167:     \"GHOST_CONTEXT_OMITTED_SOCKETS\",\r\n 1168:     \"NODE_CKPT\", \"NODE_POSITIVE\", \"NODE_NEGATIVE\", \"NODE_CONTEXT\", \"NODE_ADE\",\r\n 1169:     \"NODE_LATENT\", \"NODE_SAMPLER\", \"NODE_DECODE\",\r\n 1170:     \"ghost_unique_source_count\", \"ghost_source_request\",\r\n 1171:     \"ghost_hold2_selector\", \"ghost_hold_selector\", \"ghost_cadence_receipts\",\r\n 1172:     \"GHOST_DEFAULT_HOLD\",\r\n 1173: ]\r\n","exit_code":0,"status":"completed"}}
