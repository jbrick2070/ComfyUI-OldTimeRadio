list means the\r\n 6304:     # per-role routing leaked humo_14B_169 onto a non-character role.\r\n 6305:     humo_14b_169 = sorted(sid for sid, c in clips.items()\r\n 6306:                           if c[\"engine_id\"] == \"humo_14B_169\" and c[\"exists\"])\r\n 6307:     humo_14b_169_misrouted = sorted(\r\n 6308:         sid for sid in humo_14b_169\r\n 6309:         if (shots.get(sid) or {}).get(\"role\") != \"character_video\")\r\n 6310:     return {\r\n 6311:         \"n_clips\": len(ep[\"clips\"]),\r\n 6312:         \"all_clips_real\": all(c[\"exists\"] and c[\"size\"] > 0\r\n 6313:                               for c in clips.values()),\r\n 6314:         \"video_revision\": sec[\"video_revision\"],\r\n 6315:         \"audio_sha\": led[\"audio\"][\"master_audio_sha256\"],\r\n 6316:         \"humo_rendered\": sum(1 for c in clips.values()\r\n 6317:                              if c[\"engine_id\"] == \"humo\" and c[\"exists\"]),\r\n 6318:         \"humo_14B_169_rendered\": len(humo_14b_169),\r\n 6319:         \"humo_14B_169_misrouted\": humo_14b_169_misrouted,\r\n 6320:         \"vram_peak_mb\": ep[\"vram_peak_mb\"],\r\n 6321:         \"trace\": ep[\"trace\"],\r\n 6322:         \"receipts\": ep.get(\"receipts\") or [],\r\n 6323:         \"clips\": clips,\r\n 6324:     }\r\n 6325: \r\n 6326: \r\n 6327: def assemble_report(meta, input_ledger, e1, e2, *, elapsed_s,\r\n 6328:                     oom_contract=None):\r\n 6329:     return {\r\n 6330:         \"meta\": meta,\r\n 6331:         \"elapsed_s\": round(float(elapsed_s), 1),\r\n 6332:         \"episode_1\": _episode_facts(e1),\r\n 6333:         \"episode_2\": _episode_facts(e2),\r\n 6334:         \"input_shot_count\": len(input_ledger[\"video\"][\"shots\"]),\r\n 6335:         # NO-TRAIL LOUD contract (2026-07-02): the forced-OOM leg's outcome --\r\n 6336:         # {\"raised\": bool, \"error_type\": str, \"detail\": str} or None when the\r\n 6337:         # leg was not run.\r\n 6338:         \"oom_contract\": oom_contract,\r\n 6339:     }\r\n 6340: \r\n 6341: \r\n 6342: def assert_soak_ok(report):\r\n 6343:     \"\"\"Assert every A-S7.5 GPU-soak invariant; raise :class:`SoakError` on any\r\n 6344:     violation. Returns the list of passed-check descriptions for the report.\r\n","exit_code":0,"status":"completed"}}
