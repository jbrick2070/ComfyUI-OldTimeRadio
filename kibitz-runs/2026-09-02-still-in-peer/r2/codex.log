                     \"inputs\": {\"ckpt_name\": GHOST_CHECKPOINT_NAME}}},\r\n  716:             terminal=NODE_CKPT, on_result=_register_base)\r\n  717: \r\n  718:         if len(ckpt_out) != 3:\r\n  719:             raise RuntimeError(\r\n  720:                 \"%s: expected MODEL/CLIP/VAE from the checkpoint, got %d \"\r\n  721:                 \"output(s)\" % (self.name, len(ckpt_out)))\r\n  722: \r\n  723:         # SEPARATE ONE-SLOT HANDLES, and the three-slot tuple goes away here.\r\n  724:         prepared[\"base_model\"] = (ckpt_out[0],)\r\n  725:         prepared[\"clip\"] = (ckpt_out[1],)\r\n  726:         prepared[\"vae\"] = (ckpt_out[2],)\r\n  727:         prepared[\"recipe\"] = self._recipe_receipt()\r\n  728:         del ckpt_out\r\n  729:         return prepared\r\n  730: \r\n  731:     # ---- request -------------------------------------------------------- #\r\n  732:     def _build_render_request(self, request):\r\n  733:         \"\"\"PURE: the normalized plan this adapter renders from.\r\n  734: \r\n  735:         The negative is read from the REQUEST FIELD by name and a blank one is\r\n  736:         refused. There is deliberately no ``request.get(\"negative_prompt\") or\r\n  737:         <engine constant>`` here: an engine-side negative constant would let the\r\n  738:         lane render with lettering hygiene the composer never authored, and the\r\n  739:         receipt would describe a negative that did not come from the pack.\r\n  740:         \"\"\"\r\n  741:         get = request.get if isinstance(request, dict) else (\r\n  742:             lambda k, d=None: getattr(request, k, d))\r\n  743:         timing = get(\"timing\") or {}\r\n  744:         t_get = timing.get if isinstance(timing, dict) else (\r\n  745:             lambda k, d=None: getattr(timing, k, d))\r\n  746:         seeds = get(\"seed_bundle\") or {}\r\n  747:         s_get = seeds.get if isinstance(seeds, dict) else (\r\n  748:             lambda k, d=None: getattr(seeds, k, d))\r\n  749: \r\n  750:         target = int(t_get(\"target_frame_count\", 0) or 0)\r\n  751:         text_prompt = str(get(\"text_prompt\") or \"\").strip()\r\n  752:         negative_prompt = str(get(\"negative_prompt\") or \"\").strip()\r\n  753:         unique = ghost_unique_source_count(target, self.hold_factor)\r\n  754:         return {\r\n  755:             \"shot_id\": str(get(\"shot_id\") or get(\"request_id\") or \"\"),\r\n  756:             \"text_prompt\": text_prompt,\r\n  757:             \"negative_prompt\": negative_prompt,\r\n  758:             \"seed\": int(s_get(\"request_seed\", 0) or 0),\r\n  759:             \"target_frame_count\": target,\r\n  760:             \"unique_source_count\": unique,\r\n  761:             \"source_request\": ghost_source_request(target,\r\n  762:                                                    self.hold_factor),\r\n  763:             \"fps\": int(self.target_fps),\r\n  764:         }  858:                     \"seed\": plan[\"seed\"], 1008:                 # clean lane by eye, so it says so out loud rather than letting\r\n 1009:                 # a published episode quietly imply the adapter did something.\r\n 1010:                 _LOG.warning(\r\n 1011:                     \"%s: strength is 0.0, so ComfyUI returns the base model \"\r\n 1012:                     \"UNPATCHED -- this beat is the clean %s picture under a \"\r\n 1013:                     \"haunted receipt. That is the adapter-off control arm; if \"\r\n 1014:                     \"it was not meant, %s was not read.\",\r\n 1015:                     self.name, \"animatediff15_v3\", \"OTR_GHOST_HAUNTED_LORA_STRENGTH\")\r\n 1016:         return raw\r\n 1017: \r\n 1018:     def _release_sampling_patchers_before_decode(self, owners):\r\n 1019:         \"\"\"Detach and identity-remove the sampling patchers, outermost first.\r\n 1020: \r\n 1021:         Order is ADE, then the domain adapter (absent on every clean lane),\r\n 1022:         then base -- each