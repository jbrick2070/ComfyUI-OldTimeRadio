40:         source=\"video_render_batch\",\r\n  341:     )\r\n  342:     return len(rows)\r\n  343: \r\n  344: \r\n  345: def _stamp_audio_motion_profiles(amp_rows):\r\n  346:     \"\"\"S-C C1: build + durably stamp the per-beat ``audio_motion_profiles``\r\n  347:     onto the production ledger from the shots' resolved conditioning WAVs.\r\n  348: \r\n  349:     Read-only analysis (each WAV is a per-line voice clip or a read-only slice\r\n  350:     of the FROZEN master -- the master is NEVER touched, so audio byte-identity\r\n  351:     holds). FAIL-SOFT by design: unlike the render-engines receipt (which the\r\n  352:     credits roll requires, so it stamps LOUD), NOTHING consumes this profile yet\r\n  353:     (C2 deferred), so a load/save miss is logged and swallowed -- it must never\r\n  354:     fail the render. Uses the same in-flight-ledger discovery + save_ledger_safe\r\n  355:     seam as nodes 93/85; runs AFTER the render-engines durable stamp so the\r\n  356:     on-disk ledger is already current.\"\"\"\r\n  357:     if not amp_rows:\r\n  358:         return\r\n  359:     try:\r\n  360:         from ._otr_audio_motion import (build_audio_motion_profiles,\r\n  361:                                         stamp_ledger_audio_motion)\r\n  362:         from . import _otr_ledger as _OTRL\r\n  363:         profiles = build_audio_motion_profiles(amp_rows, lambda r: r.get(\"_wav\"))\r\n  364:         ledger_p = _OTRL.in_flight_ledger_path()\r\n","exit_code":0,"status":"completed"}}
