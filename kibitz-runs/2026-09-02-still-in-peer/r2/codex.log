{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=130; $i=$start-1; Get-Content -LiteralPath '\"'scripts\\\\otr_canonical_api_run.py' | Select-Object -Skip (\"'$start-1) -First 190 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  130: \r\n  131: def _schemas(offline: bool) -> dict:\r\n  132:     if not offline:\r\n  133:         return fetch_schemas()\r\n  134:     from nodes import _otr_workflow_apply as workflow_apply\r\n  135: \r\n  136:     return workflow_apply.build_offline_schemas()\r\n  137: \r\n  138: \r\n  139: def build_api_prompt(args) -> tuple[dict, list[str]]:\r\n  140:     # Default: the canonical workflow, with the deliberate path assertion.\r\n  141:     # Opt-in --workflow loads an EXPLICIT graph (the story-only scoring graph),\r\n  142:     # which is a workflow change the caller has deliberately asked for -- not a\r\n  143:     # silent smoke-vs-canonical drift. When --workflow is absent the behaviour is\r\n  144:     # byte-identical to before.\r\n  145:     explicit = getattr(args, \"workflow\", None)\r\n  146:     if explicit:\r\n  147:         wf_path = pathlib.Path(explicit).resolve()\r\n  148:         if not wf_path.is_file():\r\n  149:             raise SystemExit(f\"--workflow missing: {wf_path}\")\r\n  150:         print(f\"[canonical-api] workflow={wf_path} (explicit --workflow)\", flush=True)\r\n  151:     else:\r\n  152:         wf_path = CANONICAL_WORKFLOW.resolve()\r\n  153:         expected = (REPO_ROOT / \"workflows\" / \"otr_canonical.json\").resolve()\r\n  154:         if wf_path != expected:\r\n  155:             raise SystemExit(f\"canonical workflow path mismatch: {wf_path}\")\r\n  156:         if not wf_path.is_file():\r\n  157:             raise SystemExit(f\"canonical workflow missing: {wf_path}\")\r\n  158:         print(f\"[canonical-api] workflow={wf_path}\", flush=True)\r\n  159:     schemas = _schemas(args.offline_schemas)\r\n  160:     workflow = load_workflow(str(wf_path))\r\n  161: \r\n  162:     applied: list[str] = []\r\n  163:     if getattr(args, \"machine\", None):\r\n  164:         # A machine key expands to the same dict a profile file would have\r\n  165:         # produced. No file, no second applier -- config/machine_classes.json\r\n  166:         # is the only place any of these values exist.\r\n  167:         sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n  168:         from otr_machine_profile import build_profile, resolve\r\n  169:         _prof = build_profile(resolve(args.machine))\r\n  170:         workflow = apply_profile_to_workflow(workflow, _prof, schemas)\r\n  171:         applied.append(\"machine=%s\" % args.machine)\r\n  172:     elif args.profile and args.profile.lower() != \"none\":\r\n  173:         workflow = apply_profile_to_workflow(workflow, args.profile, schemas)\r\n  174:         applied.append(f\"profile={args.profile}\")\r\n  175:         checked = _assert_profile_models_present(\r\n  176:             args.profile, schemas, offline=bool(args.offline_schemas))\r\n  177:         if checked:\r\n  178:             print(\"[canonical-api] preflight: %d required model(s) visible to \"\r\n  179:                   \"the server: %s\" % (len(checked), \", \".join(checked)),\r\n  180:                   flush=True)\r\n  181: \r\n  182:     applied.extend(_apply_writer_shortcuts(workflow, schemas, args))\r\n  183:     for patch in args.set:\r\n  184:         applied.append(_apply_set(workflow, schemas, patch))\r\n  185: \r\n  186:     prompt = workflow_to_api_prompt(workflow, schemas)\r\n  187:     return prompt, applied\r\n  188: \r\n  189: \r\n  190: def _server_visible_model_names(schemas) -> set:\r\n  191:     \"\"\"Every filename the SERVER offers in any node's combo, from /object_info.\r\n  192: \r\n  193:     Deliberately not folder_paths: this asks the running server what it can\r\n  194:     actually see, which is the only authority that matters, and it needs no\r\n  195:     knowledge of extra_model_paths.yaml or of which category a weight lives in.\r\n  196:     \"\"\"\r\n  197:     names = set()\r\n  198: \r\n  199:     def _walk(node):\r\n  200:         if isinstance(node, dict):\r\n  201:             for value in node.values():\r\n  202:                 _walk(value)\r\n  203:         elif isinstance(node, (list, tuple)):\r\n  204:             # A ComfyUI combo is a list whose FIRST element is the option list.\r\n  205:             for value in node:\r\n  206:                 if isinstance(value, str):\r\n  207:                     names.add(value)\r\n  208:                 else:\r\n  209:                     _walk(value)\r\n  210: \r\n  211:     _walk(schemas)\r\n  212:     return names\r\n  213: \r\n  214: \r\n  215: #: Weight-file suffixes ComfyUI's folder_paths actually enumerates. A\r\n  216: #: `preflight.required_models` entry ending in one of these is a FILENAME and is\r\n  217: #: checkable against /object_info; anything else is a logical or repo id and is\r\n  218: #: not. Deliberately a closed list rather than \"contains a dot\": `wan2.2-ti2v-5b`\r\n  219: #: and `ltx-2.3-22b-dev` both contain dots and are ids, not files.\r\n  220: _WEIGHT_SUFFIXES = (\".safetensors\", \".ckpt\", \".pth\", \".pt\", \".bin\", \".gguf\",\r\n  221:                     \".onnx\", \".sft\")\r\n  222: \r\n  223: \r\n  224: def _is_weight_filename(name: str) -> bool:\r\n  225:     \"\"\"True for a real weight FILENAME, false for a logical or HF repo id.\"\"\"\r\n  226:     return str(name or \"\").lower().endswith(_WEIGHT_SUFFIXES)\r\n  227: \r\n  228: \r\n  229: def classify_timeout(running: int, pending: int) -> str:\r\n  230:     \"\"\"What a poll TIMEOUT actually means, given the server's queue.\r\n  231: \r\n  232:     Pure so it can be tested without a server. Three outcomes, and conflating\r\n  233:     them is the defect this exists to prevent (2026-08-23):\r\n  234: \r\n  235:       ``still_running``  the observation window closed while the render carried\r\n  236:                          on. `--timeout` defaults to 5400s and a full wan_ti2v\r\n  237:                          episode on the 16 GB box exceeds it, so this is the\r\n  238:                          COMMON case for the slowest lane -- and it is not a\r\n  239:                          failure at all. The episode still publishes.\r\n  240:       ``unknown``        the queue could not be read (``queue_snapshot`` returns\r\n  241:                          -1/-1 best-effort). Absence of evidence, reported as\r\n  242:                          such rather than guessed either way.\r\n  243:       ``not_running``    the queue is empty, so the render really has ended.\r\n  244: \r\n  245:     Before this, all three printed \"RESULT TIMEOUT\" and exited 1, which reads as\r\n  246:     \"the render died\" -- the wrong conclusion in the most common case.\r\n  247:     \"\"\"\r\n  248:     if running == -1 or pending == -1:\r\n  249:         return \"unknown\"\r\n  250:     if running > 0 or pending > 0:\r\n  251:         return \"still_running\"\r\n  252:     return \"not_running\"\r\n  253: \r\n  254: \r\n  255: def _assert_profile_models_present(profile_name, schemas, offline=False) -> list:\r\n  256:     \"\"\"Refuse in SECONDS what would otherwise fail seven minutes into a render.\r\n  257: \r\n  258:     On 2026-08-22 a Ghost domain-adapter leg ran the script pass, the whole\r\n  259:     voice pass and part of the video pass before ``assert_usable`` reported\r\n  260:     ``v3_sd15_adapter.ckpt`` missing -- the weight was on disk but under a root\r\n  261:     the headless model-paths config does not name. The engine guard did its job\r\n  262:     and failed closed; it simply could not do it until the first video beat.\r\n  263:     The bench runners already confirm every model filename in /object_info\r\n  264:     before submit (SPEC G1/O6); the canonical runner did not, so it does now.\r\n  265: \r\n  266:     Returns the checked names. A profile with no ``preflight.required_models``\r\n  267:     is not an error -- most profiles do not declare any.\r\n  268:     \"\"\"\r\n  269:     import json as _json\r\n  270: \r\n  271:     path = REPO_ROOT / \"config\" / \"profiles\" / (\"%s.json\" % profile_name)\r\n  272:     if not path.is_file():\r\n  273:         return []\r\n  274:     try:\r\n  275:         profile = _json.loads(path.read_text(encoding=\"utf-8\"))\r\n  276:     except Exception:  # noqa: BLE001 -- a malformed profile fails later, louder\r\n  277:         return []\r\n  278:     required = ((profile.get(\"preflight\") or {}).get(\"required_models\") or [])\r\n  279:     if not required:\r\n  280:         return []\r\n  281:     # ONLY A FILENAME IS GATEABLE HERE, and this split is the whole fix\r\n  282:     # (2026-08-23). `/object_info` lists what ComfyUI's folder_paths enumerates:\r\n  283:     # FILENAMES. It has never contained a logical model id (`real-esrgan-x2plus`,\r\n  284:     # `wan2.2-ti2v-5b`) or an HF repo id (`google/gemma-4-E2B-it`), and an LLM\r\n  285:     # weight is not in it at all. So for a non-filename entry, \"absent from\r\n  286:     # /object_info\" is not evidence of absence on disk -- it is the wrong\r\n  287:     # question, and answering it with SystemExit blocks a profile whose weights\r\n  288:     # are sitting right there.\r\n  289:     #\r\n  290:     # THIS WAS NOT THEORETICAL. The gate shipped 2026-08-22 validated against\r\n  291:     # the ghost_signal profiles, which are the only ones declaring filenames.\r\n  292:     # Every profile using the logical-id vocabulary -- both upscale profiles,\r\n  293:     # both 16gb_ltx, all three 8gb_*, both 4060_* -- could not pass it at any\r\n  294:     # time, for any state of the disk. `otr_upscale_ship` was carried in the\r\n  295:     # queue as \"unexercised\" for exactly this reason: `RealESRGAN_x2plus.pth`\r\n  296:     # was visible in `/object_info` the entire time.\r\n  297:     #\r\n  298:     # A filename is enforced (that is what caught the missing v3_sd15_adapter).\r\n  299:     # Anything else is REPORTED and allowed through, because a gate that cannot\r\n  300:     # verify a claim must not pretend it refuted it.\r\n  301:     gateable = [n for n in required if _is_weight_filename(n)]\r\n  302:     ungateable = [n for n in required if not _is_weight_filename(n)]\r\n  303:     visible = _server_visible_model_names(schemas)\r\n  304:     missing = [name for name in gateable if name not in visible]\r\n  305:     if missing and offline:\r\n  306:         # OFFLINE SCHEMAS ARE NOT A SERVER, so this gate cannot fire here --\r\n  307:         # the same rule the filename/logical-id split above is built on: \"a\r\n  308:         # gate that cannot verify a claim must not pretend it refuted it.\"\r\n  309:         # `build_offline_schemas()` synthesizes widget choices from the node\r\n  310:         # classes; it never had `--extra-model-paths-config` applied, so its\r\n  311:         # model lists reflect THIS process's folder_paths, not the roots the\r\n  312:         # real server booted with. Refusing on that evidence blocks a profile\r\n  313:         # whose weights are on disk and visible to the server that will\r\n  314:         # actually run it.\r\n  315:         #\r\n  316:         # NOT THEORETICAL (2026-08-26): `otr_ghost_signal_v3_haunted` was\r\n  317:         # reported FAIL by a `--dry-run --offline-schemas` validation sweep --\r\n  318:         # all three names, including two sitting under roots the yaml DOES\r\n  319:         # name -- and passed preflight cleanly against the live server\r\n","exit_code":0,"status":"completed"}}
