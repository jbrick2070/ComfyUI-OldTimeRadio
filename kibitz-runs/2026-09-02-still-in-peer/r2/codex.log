ng it would\r\n 1240:     report 77 for a three-word prompt and make the whole gate meaningless.\r\n 1241: \r\n 1242:     Measured, not derived: 75 payload tokens is 77 total in one window, and 76\r\n 1243:     payload tokens spills to two.\r\n 1244:     \"\"\"\r\n 1245:     tok = _installed_sd1_tokenizer()\r\n 1246:     rows = tok.tokenize_with_weights(str(text or \"\"), return_word_ids=True)[\"l\"]\r\n 1247:     payload = sum(1 for row in rows for entry in row if entry[2] != 0)\r\n 1248:     windows = len(rows)\r\n 1249:     return payload + 2 * windows, windows\r\n 1250: \r\n 1251: \r\n 1252: def resolve_token_measure(token_measure_fn=None) -> Optional[Callable]:\r\n 1253:     \"\"\"The measurer this call should use, or ``None`` when it may be skipped.\r\n 1254: \r\n 1255:     An INJECTED measurer always gates -- a test that supplies one is asking for\r\n 1256:     the gate, not asking to be excused from it. Only the UNAVAILABLE installed\r\n 1257:     tokenizer may be skipped, and only under ``OTR_TEST_MODE``; production\r\n 1258:     fails closed.\r\n 1259:     \"\"\"\r\n 1260:     if token_measure_fn is not None:\r\n 1261:         return token_measure_fn\r\n 1262:     try:\r\n 1263:         _installed_sd1_tokenizer()\r\n 1264:     except GhostTokenizerUnavailable as exc:\r\n 1265:         if _test_mode():\r\n 1266:             # SAID OUT LOUD (agy review, 2026-08-22). A silently ungated run\r\n 1267:             # publishes zero token counts that look like a measurement; a\r\n 1268:             # reader of a headless log must be able to see that nothing was\r\n 1269:             # measured and why.\r\n 1270:             _LOG.warning(\r\n 1271:                 \"[ghost_signal_author] token gate SKIPPED under OTR_TEST_MODE: \"\r\n 1272:                 \"%s -- receipts will carry no counts and no clip_counter\", exc)\r\n 1273:             return None\r\n 1274:         raise\r\n 1275:     return measure_clip_tokens\r\n 1276: \r\n 1277: \r\n 1278: #: The measurer's own identity, stamped beside every count so a receipt says\r\n 1279: #: which counter produced it.\r\n 1280: GHOST_CLIP_COUNTER = \"comfy.sd1_clip.SD1Tokenizer/%s\" % GHOST_AUTHOR_VERSION\r\n 1281: \r\n 1282: \r\n 1283: # --------------------------------------------------------------------------- #\r\n 1284: # The shared finalizer -- ONE path for author-time admission and render.\r\n 1285: # --------------------------------------------------------------------------- #\r\n 1286: \r\n 1287: def _banana_module():\r\n 1288:     try:\r\n 1289:         from .. import _otr_banana_route as _br  # type: ignore\r\n 1290:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1291:         import _otr_banana_route as _br  # type: ignore\r\n 1292:     return _br\r\n 1293: \r\n 1294: \r\n 1295: def finalize_ghost_prompt_v2(*, role, style, mode, motif_cue, drawable_beat,\r\n 1296:                              ledger_meta=None, token_measure_fn=None,\r\n 1297:                              banana_enabled=None) -> dict:\r\n 1298:     \"\"\"Compose, transform, validate and MEASURE one Ghost v2 prompt.\r\n 1299: \r\n 1300:     The single path both sides use. Author-time admission calls it to find out\r\n 1301:     whether a candidate leaf survives the real style, the real banana gate and\r\n 1302:     the real tokenizer; the render driver calls it to build the request. Two\r\n 1303:     code paths could not have been kept in agreement -- the whole point of the\r\n 1304:     admission check is that it predicts the render exactly.\r\n 1305: \r\n 1306:     IT NEVER TRIMS AND NEVER REPAIRS. Style cue, motif, law and negative are\r\n 1307:     immutable, and the only lever an over-budget candidate has is a different\r\n 1308:     LEAF -- which is the model's field, not this function's.\r\n 1309:     \"\"\"\r\n 1310:     composed = _gsp.compose_ghost_prompt_v2(\r\n 1311:         role=role, style=style, mode=mode, motif_cue=motif_cue,\r\n 1312:         drawable_beat=drawable_beat)\r\n 1313:     positive = str(composed[\"positive\"])\r\n 1314:     negative = str(composed[\"negative\"])\r\n 1315:     components = dict(composed[\"components\"])\r\n 1316: \r\n 1317:     meta = ledger_meta if isinstance(ledger_meta, dict) else {}\r\n 1318:     banana = _banana_module()\r\n 1319:     variety_key = str(meta.get(\"freeze_timestamp\") or \"\")\r\n 1320:     gate_on = (banana.banana_gate(meta, lane=\"video\")\r\n 1321:                if banana_enabled is None else bool(banana_enabled))\r\n 1322: \r\n 1323:     if gate_on:\r\n 1324:         result = banana.apply(positive, variety_key=variety_key,\r\n 1325:                               shield_quoted_card_text=False)\r\n 1326:         positive = result.text\r\n 1327:         receipt = banana.receipt_keys(result)\r\n 1328:         # THE COMPONENTS GO THROUGH THE SAME TABLE, so a substitution INSIDE\r\n 1329:         # the leaf (\"revolver\" -> a fruit) is recognised as the transform doing\r\n 1330:         # its job rather than as the leaf having been lost. Validating the\r\n 1331:         # pre-transform components against a post-transform prompt would fail\r\n 1332:         # exactly when the route fired, which is the one case that matters.\r\n 1333:         components = {\r\n 1334:             name: banana.apply(text, variety_key=variety_key,\r\n 1335:                                shield_quoted_card_text=False).text\r\n 1336:             for name, text in components.items()\r\n 1337:         }\r\n 1338:     else:\r\n 1339:         receipt = banana.off_receipt(positive, variety_key=variety_key)\r\n 1340: \r\n 1341:     for name, text in components.items():\r\n 1342:         if text and text not in positive:\r\n 1343:             raise GhostBudgetError(\r\n 1344:                 \"Ghost v2 protected component %r did not survive into the \"\r\n 1345:                 \"final positive -- a protected field is never trimmed or \"\r\n 1346:                 \"repaired, so this is a composer or transform defect\" % (name,))\r\n 1347: \r\n 1348:     if len(positive) > _gsp.GHOST_PROMPT_MAX_CHARS:\r\n 1349:         raise GhostBudgetError(\r\n 1350:             \"Ghost v2 positive is %d characters, over the %d ceiling\"\r\n 1351:             % (len(positive), _gsp.GHOST_PROMPT_MAX_CHARS))\r\n 1352: \r\n 1353:     measure = resolve_token_measure(token_measure_fn)\r\n 1354:     if measure is None:\r\n 1355:         pos_tokens = pos_windows = neg_tokens = neg_windows = 0\r\n 1356:     else:\r\n 1357:         pos_tokens, pos_windows = measure(positive)\r\n 1358:         neg_tokens, neg_windows = measure(negative)\r\n 1359:         for label, tokens, windows in ((\"positive\", pos_tokens, pos_windows),\r\n 1360:                                        (\"negative\", neg_tokens, neg_windows)):\r\n 1361:             if windows > 1 or tokens > GHOST_CLIP_WINDOW_TOKENS:\r\n 1362:                 raise GhostBudgetError(\r\n 1363:                     \"Ghost v2 %s measures %d installed SD1 tokens across %d \"\r\n 1364:                     \"window(s), over the one-window %d admission -- the render \"\r\n 1365:                     \"boundary refuses this rather than trimming a protected \"\r\n 1366:                     \"field\" % (label, tokens, windows,\r\n 1367:                                GHOST_CLIP_WINDOW_TOKENS))\r\n 1368: \r\n 1369:     return {\r\n 1370:         \"positive\": positive,\r\n 1371:         \"negative\": negative,\r\n 1372:         \"components\": components,\r\n 1373:         \"slots\": list(composed.get(\"slots\") or ()),\r\n 1374:         \"banana_receipt\": receipt,\r\n 1375:         \"banana_gate\": bool(gate_on),\r\n 1376:         \"positive_clip_tokens\": int(pos_tokens),\r\n 1377:         \"positive_clip_windows\": int(pos_windows),\r\n 1378:         \"negative_clip_tokens\": int(neg_tokens),\r\n 1379:         \"negative_clip_windows\": int(neg_windows),\r\n 1380:         \"clip_window_max\": GHOST_CLIP_WINDOW_TOKENS,\r\n 1381:         \"clip_counter\": GHOST_CLIP_COUNTER if measure is not None else \"\",\r\n 1382:         \"measured\": measure is not None,\r\n 1383:     }\r\n 1384: \r\n 1385: \r\n 1386: def candidate_fits(*, role, style, mode, motif_cue, drawable_beat,\r\n 1387:                    ledger_meta=None, token_measure_fn=None,\r\n 1388:                    target_tokens=GHOST_AUTHOR_TOKEN_TARGET) -> tuple:\r\n 1389:     \"\"\"``(ok, reason)`` for an AUTHOR-TIME candidate leaf.\r\n 1820:         from _otr_story_brief_helpers import (  # type: ignore\r\n 1821:             _resolve_style, get_era_tail)\r\n 1822:     _vstyle = _resolve_style(meta, style)\r\n 1823:     subject = _mesh_fodder_subject(meta, char_entry, line, setting, role,\r\n 1824:                                    style=_vstyle)\r\n 1825:     out = \"%s, %s\" % (subject, MESH_FODDER_POS_SCAFFOLD)\r\n 1826:     spice = _mesh_style_spice(_vstyle)\r\n 1827:     if spice and spice.lower() not in out.lower():\r\n 1828:         out = \"%s, %s\" % (out, spice)\r\n 1829:     # C4 (2026-07-01): the mesh radio inherits the brief's era TEXTURE (trimmed\r\n 1830:     # still profile: atmosphere line + palette/lighting top-2), so a non-1940s\r\n 1831:     # brief carries through to the meshed object. The isolation scaffold above\r\n 1832:     # still governs silhouette/plate; the tail only tints the look.\r\n 1833:     tail = get_era_tail(meta, profile=\"still\", style=_vstyle)\r\n 1834:     if tail and tail not in out:\r\n 1835:         out = \"%s, %s\" % (out, tail)\r\n 1836:     return out\r\n 1837: \r\n 1838: \r\n 1839: def _compose_background_plate_prompt(meta, setting, style=None) -> str:\r\n 1840:     \"\"\"The subject-free 16:9 world plate the mesh stands in front of. Leads with\r\n 1841:     the story setting, then the 'no subject' GEOMETRY scaffold + the pack's\r\n 1842:     ``plate_look`` (chunk A2 split; sci_fi byte-identical by construction).\r\n 1843:     Deterministic; never empty. ``style`` threaded from the entry (None =>\r\n 1844:     fail-loud resolve here).\"\"\"\r\n 1845:     # Era tail / grade so the plate matches the episode look. Stage 3\r\n 1846:     # de-swallow (kibitz r2 M1): ImportError shim only; a style error RAISES.\r\n 1847:     try:\r\n 1848:         from ._otr_story_brief_helpers import (  # type: ignore\r\n 1849:             NO_TEXT_CLAUSE, _resolve_style, finish_visual_prompt)\r\n 1850:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1851:         from _otr_story_brief_helpers import (  # type: ignore\r\n 1852:             NO_TEXT_CLAUSE, _resolve_style, finish_visual_prompt)\r\n 1853:     _style = _resolve_style(meta, style)\r\n 1854:     parts = []\r\n 1855:     if setting:\r\n 1856:         parts.append(\"%s setting\" % setting)\r\n 1857:     parts.append(\"%s, %s\" % (BACKGROUND_PLATE_GEOMETRY, _style.plate_look))\r\n 1858:     plate = \", \".join(parts)\r\n 1859:     plate = finish_visual_prompt(meta, plate, era_profile=\"still\",\r\n 1860:                                  style=_style)\r\n 1861:     if _style.image_grade_tail and _style.image_grade_tail not in plate:\r\n 1862:         plate = \"%s, %s\" % (plate, _style.image_grade_tail)\r\n 1863:     if not plate.endswith(NO_TEXT_CLAUSE):\r\n 1864:         plate = \"%s, %s\" % (plate, NO_TEXT_CLAUSE)\r\n 1865:     return plate\r\n 1866: \r\n 1867: \r\n 1868: def _clean_llm_prompt(raw: str) -> str:\r\n 1869:     \"\"\"First non-empty line of the LLM output, trimmed; '' if unusable.\"\"\"\r\n 1870:     if not raw:\r\n 1871:         return \"\"\r\n 1872:     for line in str(raw).splitlines():\r\n 1873:         line = line.strip().strip('\"').strip()\r\n 1874:         if line:\r\n 1875:             return line\r\n 1876:     return \"\"\r\n 1877: \r\n 1878: \r\n 1879: def derive_image_prompts(cast: list, meta: dict, *, llm_fn=None, max_reseed: int = 2,\r\n 1880:                          consistency_gate_warn_only: bool = False, lines=None,\r\n 1881:                          fps: int = 25, still_aspects=None,\r\n 1882:                          mesh_fodder_roles=None, talking_roles=None,\r\n 1883:                          still_word_roles=None, video_models=None,\r\n 1884:                          portrait_free_roles=None, identity_roles=None):\r\n 1885:     \"\"\"ONE versioned image-object payload: ``{\"version\": 1, \"objects\": [...]}``\r\n 1886:     (still-spine ST-2 / pass-02 item 1: portraits MIGRATED to the object\r\n 1887:     schema in the same patch; no dual-schema shims).\r\n 1888: \r\n 1889:     Each object carries ``object_id`` / ``kind`` / ``role`` / ``w`` / ``h`` /\r\n 1890:     ``prompt`` / ``prompt_hash`` / ``source`` plus ``char_id`` (portraits;\r\n 1891:     object_id == char_id) or ``beat_id`` (scene stills).\r\n 1892: \r\n 1893:     Portrait path: a bounded writer-LLM refinement is used when it\r\n 1894:     returns a non-empty line. Empty or failed refinement uses the deterministic\r\n 1895:     same-story template. No Python vocabulary or overlap classifier can reject,\r\n 1896:     rewrite, or block the prompt. The compatibility gate argument is ignored.\r\n 1897:     Returns ``(payload, warnings)``.\r\n 1898: \r\n 1899:     ``lines`` (optional, the frozen ledger lines, READ-ONLY): announcer\r\n  250:     \"\"\"Stage 3: the one style-resolution helper the composer ENTRY seams\r\n  251:     call. ``style`` already-resolved => returned as-is (helpers never\r\n  252:     re-resolve, r4 contract). ``style=None`` => fail-loud\r\n  253:     ``get_visual_style(meta)`` -- unknown meta[\"visual_style\"] RAISES\r\n  254:     (UnknownVisualStyleError); absent/empty resolves the sci_fi_radio\r\n  255:     default byte-identically. NO swallow: a style-resolution error must\r\n  256:     fail the episode loud (no-fallback law).\"\"\"\r\n  257:     if style is not None:\r\n  258:         return style\r\n  259:     from ._otr_visual_styles import get_visual_style\r\n  260:     return get_visual_style(meta)\r\n  261: \r\n  262: \r\n  263: def get_era_tail(meta: Any, profile: str = \"full\", style: Any = None) -> str:\r\n  264:     \"\"\"The brief-derived era/aesthetic tail; NEVER empty*, never raises.\r\n  265: \r\n  266:     Stage 3: ``style`` is the RESOLVED VisualStyle whose ``era_tail``\r\n  267:     replaces the :data:`ERA_TAIL_DEFAULT` fallback string EXACTLY --\r\n  268:     including a pack-declared empty string (\"never empty\" is a\r\n  269:     sci_fi_radio-pack property, not a helper invariant; r4 pin). This\r\n  270:     function does NO loader lookup itself (the composer entry resolves once\r\n  271:     and passes the style down); ``style=None`` is the LEGACY lane and keeps\r\n  272:     the byte-identical ERA_TAIL_DEFAULT fallback -- production composers\r\n  273:     always pass ``style`` (AST-pinned).\r\n  274: \r\n  275:     ``profile=\"full\"`` (default; every pre-still-spine call site, behavior\r\n  276:     unchanged) ports the legacy ``_resolve_era_tail`` precedence (Sprint\r\n  277:     8.7): ``atmosphere_line`` -> ``visual_palette`` (top 3) -> v1\r\n  278:     lighting+atmosphere (:func:`get_story_brief_lighting`) -> the\r\n  279:     :data:`ERA_TAIL_DEFAULT` constant. v2 fields come through the canonical\r\n  280:     brief reader; every failure path degrades, fail-soft.\r\n  281: \r\n  282:     ``profile=\"still\"`` (still-spine ST-1): the TRIMMED tail for still-image\r\n  283:     prompts -- atmosphere line + palette top-2 + lighting and atmosphere terms, capped at\r\n  284:     ~120 chars on a word boundary. Stills carry their subject up front; the\r\n  285:     full tail diet would push FLUX toward atmosphere soup. The per-episode\r\n  286:     palette color (e.g. Mars = red) comes through HERE by design -- the\r\n  287:     still profile trims the tail, never deletes it.\r\n  288:     \"\"\"\r\n  289:     _era_default = style.era_tail if style is not None else ERA_TAIL_DEFAULT\r\n  290:     atmosphere_line = \"\"\r\n  291:     palette: list[str] = []\r\n  292:     try:\r\n  293:         try:\r\n  294:             from ._otr_brief_reader import _read_brief_field  # type: ignore\r\n  295:         except ImportError:  # pragma: no cover -- flat test imports\r\n  296:             from _otr_brief_reader import _read_brief_field  # type: ignore\r\n  297:         raw_line = _read_brief_field(meta, \"atmosphere_line\", default=\"\")\r\n  298:         if isinstance(raw_line, str):\r\n  299:             atmosphere_line = raw_line.strip()\r\n  300:         raw_palette = _read_brief_field(meta, \"visual_palette\", default=[])\r\n  301:         if isinstance(raw_palette, list):\r\n  302:             palette = [str(t).strip() for t in raw_palette\r\n  303:                        if str(t).strip()][:3]\r\n  304:     except Exception:  # noqa: BLE001 -- reader unavailable -> v1-only\r\n  305:         pass\r\n  306:     if profile == \"portrait\":\r\n  307:         # Portrait era tail: NEVER includes the episode's ambient colour\r\n  308:         # palette (which skews blue on sci-fi, red on period drama and bleeds\r\n  309:         # directly into every character face). Lighting terms (quality/mood,\r\n  310:         # not palette colours) are safe and preserved (BUG-LOCAL-113).\r\n  311:         parts = []\r\n  312:         if atmosphere_line:\r\n  313:             parts.append(atmosphere_line)\r\n  314:         m2 = _meta(meta)\r\n  315:         terms2 = m2.get(\"story_brief_terms\") or {}\r\n  316:         if isinstance(terms2, dict):\r\n  317:             lighting = [str(t).strip() for t in (terms2.get(\"lighting\") or [])\r\n  318:                         if str(t).strip()]\r\n  319:             parts.extend(lighting)\r\n  320:         return \", \".join(parts) or _era_default\r\n  321:     if profile == \"still\":\r\n  322:         m = _meta(meta)\r\n  323:         terms = m.get(\"story_brief_terms\") or {}\r\n  324:         if not isinstance(terms, dict):\r\n  325:             terms = {}\r\n  326:         lighting = [str(t).strip() for t in (terms.get(\"lighting\") or [])\r\n  327:                     if str(t).strip()][:2]\r\n  328:         atmosphere = [str(t).strip() for t in (terms.get(\"atmosphere\") or [])\r\n  329:                       if str(t).strip()][:2]\r\n  330:         parts = []\r\n  331:         if atmosphere_line:\r\n  332:             parts.append(atmosphere_line)\r\n  333:         parts.extend(palette[:2])\r\n  334:         parts.extend(lighting)\r\n  335:         parts.extend(atmosphere)\r\n  336:         out = \", \".join(parts) or _era_default\r\n  337:         if len(out) > 120:                 # word-boundary trim (~120 chars)\r\n  338:             cut = out[:120]\r\n  339:             idx = cut.rfind(\" \")\r\n  340:             out = (cut[:idx] if idx >= 20 else cut).rstrip(\" ,\")\r\n  341:         return out\r\n  342:     v1_tail = (get_story_brief_lighting(meta) or \"\").strip()\r\n  343:     parts = []\r\n  344:     if atmosphere_line:\r\n  345:         parts.append(atmosphere_line)\r\n  346:     if palette:\r\n  347:         parts.extend(palette)\r\n  348:     if v1_tail:\r\n  349:         parts.append(v1_tail)\r\n  350:     return \", \".join(parts) or _era_default\r\n  351: \r\n  352: \r\n  353: # ---------------------------------------------------------------------------\r\n  354: # Still-spine ST-1 (2026-06-10): the shared OPEN SUBJECT + the 5-layer still\r\n  355: # prompt composer. The render driver's concrete radio-set subject wording\r\n  356: # MOVES here (one source of truth -- the driver's LTX text prompt and the\r\n  357: # scene STILL prompt for the same beat lead with the SAME subject string;\r\n  358: # the parity test in tests/test_still_spine_helpers.py locks it). Layer\r\n  359: # order restores the proven 6/5 composer (legacy otr_video_plan.py PASS-3:\r\n","exit_code":0,"status":"completed"}}
