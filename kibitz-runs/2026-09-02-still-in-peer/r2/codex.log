{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=250; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\registry.py' | Select-Object -Skip (\"'$start-1) -First 100 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }; $start=500; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_video_engines\\\\registry.py' | Select-Object -Skip (\"'$start-1) -First 80 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }; Get-Content -Raw -LiteralPath '\"'config\\\\profiles\\\\otr_ghost_signal_v3_haunted.json'\"","aggregated_output":"  250: # GATE B S1 -- per-engine capability DECLARATIONS (the registry TABLE, not the\r\n  251: # adapters). Consumed by nodes/_otr_shared/capability_profiles.py to DERIVE the\r\n  252: # per-profile enable-set -- never hand-listed per profile. A new engine ships\r\n  253: # its own row here; zero profile edits.\r\n  254: #\r\n  255: # Keys per row (validated by capability_profiles.validate_declaration):\r\n  256: #   required_toolchain     None, or \"cu128_toolkit\" (source builds; operator-\r\n  257: #                          blocked per the 3D plan -- keeps hunyuan/trellis dark).\r\n  258: #   requires_sidecar       True when the engine runs in an isolated sidecar venv.\r\n  259: #   device_backends        backends the engine can run on, e.g. [\"cuda\", \"cpu\",\r\n  260: #                          \"mps\"]; GPU-only rows list just [\"cuda\"].\r\n  261: #   requires_vendor        None, or \"nvidia\" when the adapter hard-gates on a\r\n  262: #                          vendor-only API (e.g. an NVML VRAM-telemetry probe).\r\n  263: #   needs_fp8_te           True when the engine's default weights are an\r\n  264: #                          fp8-scaled UNET/text-encoder artifact.\r\n  265: #   needs_fp4_te           True when the engine's default weights are an\r\n  266: #                          fp4-scaled UNET/text-encoder artifact.\r\n  267: #   practical_without_gpu  True when the engine can run with no GPU at all\r\n  268: #                          (procgen/CPU lanes; the cpu_floor tier filter).\r\n  269: #   sidecar_conditional    True when requires_sidecar depends on runtime\r\n  270: #                          config rather than being a fixed True/False.\r\n  271: #   model_requirements     informational model-asset ids for the S5 wizard.\r\n  272: # ---------------------------------------------------------------------------\r\n  273: CAPABILITIES = {\r\n  274:     # \"abstract\" + \"station_card\" rows REMOVED 2026-06-30 (C0 -- \"registry IS the\r\n  275:     # menu\"): both engines were UNREGISTERED (abstract redundant with visualizer;\r\n  276:     # station_card the broken black card), and the registry-consistency invariant\r\n  277:     # forbids a CAPABILITIES row without a registered engine.\r\n  278:     \"still_motion\": {\r\n  279:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  280:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  281:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  282:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  283:         \"model_requirements\": []},\r\n  284:     # viz_green (renamed from \"visualizer\" 2026-06-30, item 2; old saved values\r\n  285:     # resolve via otr_video_director._LEGACY_ENGINE_ALIASES).\r\n  286:     \"viz_green\": {\r\n  287:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  288:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  289:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  290:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  291:         \"model_requirements\": []},\r\n  292:     # viz_mxc_cpu (2026-06-30): the OTR rainbow visualizer -- pure numpy/PIL/ffmpeg,\r\n  293:     # no GPU/shaders. required_toolchain None (a GL/torch toolchain would disable it on\r\n  294:     # every shipped profile). GPU shader tier (viz_mxc_gpu) is a deferred separate row.\r\n  295:     \"viz_mxc_cpu\": {\r\n  296:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  297:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  298:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  299:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  300:         \"model_requirements\": []},\r\n  301:     # viz_mxc_mandala (2026-06-30): Cosmic Radio Mandala -- pycairo vector CPU\r\n  302:     # painter, no GPU/shaders. required_toolchain None: pycairo is NOT in\r\n  303:     # the main requirements (lazy-imported + probed by assert_usable so a box\r\n  304:     # without system libcairo never breaks any OTHER engine's install).\r\n  305:     \"viz_mxc_mandala\": {\r\n  306:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  307:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  308:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  309:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  310:         \"model_requirements\": []},\r\n  311:     # viz_camera (2026-07-05): OTR-native Golden Flicker camera visualizer --\r\n  312:     # pure numpy/PIL/ffmpeg, audio-optional, no external golden-flicker import.\r\n  313:     \"viz_camera\": {\r\n  314:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  315:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  316:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  317:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  318:         \"model_requirements\": []},\r\n  319:     \"still_flat\": {\r\n  320:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  321:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  322:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  323:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  324:         \"model_requirements\": []},\r\n  325:     \"still_pan\": {\r\n  326:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  327:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  328:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  329:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  330:         \"model_requirements\": []},\r\n  331:     # still_word (Sprint B, 2026-07-03): a still_flat sibling -- same CPU/ffmpeg\r\n  332:     # flat-hold render (zero VRAM), the delta is the WORD/TITLE-driven prompt its\r\n  333:     # base still is minted from (compose_still_word_prompt). Model-agnostic: any\r\n  334:     # image engine mints the still. cpu class, cpu_ok True, no model assets.\r\n  335:     \"still_word\": {\r\n  336:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  337:         \"device_backends\": [\"cuda\", \"cpu\", \"mps\"], \"requires_vendor\": None,\r\n  338:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  339:         \"practical_without_gpu\": True, \"sidecar_conditional\": False,\r\n  340:         \"model_requirements\": []},\r\n  341:     # S0 portability (2026-07-10): the requirement label now names the artifact\r\n  342:     # family the engine DEFAULT resolves (eng_humo._HUMO_DEFAULT_UNET = Kijai's\r\n  343:     # Wan2_1-HuMo-14B fp8-scaled UNET, fetched by scripts/download_humo_models\r\n  344:     # .ps1). The old \"HuMo-17B\" label pointed fresh installs at Comfy-Org's\r\n  345:     # differently-named file the engine never looks for.\r\n  346:     \"humo\": {\r\n  347:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  348:         \"device_backends\": [\"cuda\"], \"requires_vendor\": None,\r\n  349:         # needs_fp8_te True: the default UNET is the fp8_e4m3fn-scaled Kijai\r\n  500:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  501:         \"device_backends\": [\"cuda\"], \"requires_vendor\": None,\r\n  502:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  503:         \"practical_without_gpu\": False, \"sidecar_conditional\": False,\r\n  504:         \"model_requirements\": [\"ltx-2.5-distilled-q3-gguf\",\r\n  505:                                \"gemma4-12b-ltx-2.5-proj-gguf\",\r\n  506:                                \"ltx-2.5-video-vae\",\r\n  507:                                \"ltx-2.5-audio-vae\",\r\n  508:                                \"ltx-2.5-latent-spatial-upscaler-x2\"]},\r\n  509:     # ltx25_foley_plus (the foley bed, 2026-08-26): the SAME graph and the same\r\n  510:     # five artifacts, KEEPING the audio the model already computed instead of\r\n  511:     # discarding it. Every capability field is identical to its parent's on\r\n  512:     # purpose -- the difference between the two lanes is one extra two-node\r\n  513:     # decode after the DiT has been reclaimed, which changes nothing a preflight\r\n  514:     # gate asks about. The audio VAE was already required above (the silent lane\r\n  515:     # still MINTS an audio latent with it), so this lane adds no new fetch.\r\n  516:     #\r\n  517:     # This row is not decoration: audit_engine_roster compares CAPABILITIES\r\n  518:     # against the live registry, and a registered engine with no row here is the\r\n  519:     # roster hole that audit exists to catch.\r\n  520:     \"ltx25_foley_plus\": {\r\n  521:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  522:         \"device_backends\": [\"cuda\"], \"requires_vendor\": None,\r\n  523:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  524:         \"practical_without_gpu\": False, \"sidecar_conditional\": False,\r\n  525:         \"model_requirements\": [\"ltx-2.5-distilled-q3-gguf\",\r\n  526:                                \"gemma4-12b-ltx-2.5-proj-gguf\",\r\n  527:                                \"ltx-2.5-video-vae\",\r\n  528:                                \"ltx-2.5-audio-vae\",\r\n  529:                                \"ltx-2.5-latent-spatial-upscaler-x2\"]},\r\n  530:     # ltx25_mime (2026-08-26): the same graph and the same five artifacts\r\n  531:     # again. Every capability field matches both siblings because the\r\n  532:     # difference between all three lanes is what happens to the model's audio\r\n  533:     # AFTER the render -- discarded, mixed under, or mixed over -- and none of\r\n  534:     # that changes anything a preflight gate asks about.\r\n  535:     \"ltx25_mime\": {\r\n  536:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  537:         \"device_backends\": [\"cuda\"], \"requires_vendor\": None,\r\n  538:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  539:         \"practical_without_gpu\": False, \"sidecar_conditional\": False,\r\n  540:         \"model_requirements\": [\"ltx-2.5-distilled-q3-gguf\",\r\n  541:                                \"gemma4-12b-ltx-2.5-proj-gguf\",\r\n  542:                                \"ltx-2.5-video-vae\",\r\n  543:                                \"ltx-2.5-audio-vae\",\r\n  544:                                \"ltx-2.5-latent-spatial-upscaler-x2\"]},\r\n  545:     # minimax_h3_video (lane 19, 2026-08-12): MiniMax H3 FL2VA, the 33.1B packed\r\n  546:     # AV DiT rendered VIDEO-ONLY (this lane decodes the video half of the\r\n  547:     # NestedTensor latent and carries no audio VAE at all). cuda, no vendor gate.\r\n  548:     # needs_fp8_te is False and needs_fp4_te is TRUE: the DiT is an int8 repack\r\n  549:     # rather than fp8, and the Qwen3-VL-32B encoder it conditions on is the\r\n  550:     # NVFP4-AWQ artifact -- so the fp4 row is the one that describes this stack.\r\n  551:     # Three model_requirements because all three are separate ~5-21 GB fetches\r\n  552:     # and preflight fails CLOSED on any one of them; the audio VAE is NOT listed,\r\n  553:     # because listing an asset this lane never loads would make the S5 wizard ask\r\n  554:     # for 0.6 GB nobody needs (it belongs to lane 20).\r\n  555:     # THE ONE GHOST LANE (operator, 2026-08-23: \"delete any animatediff that are\r\n  556:     # not haunted\"). SD1.5 + AnimateDiff-Evolved's official v3 module through the\r\n  557:     # non-looped Standard Static context, plus the removable domain adapter that\r\n  558:     # gives the lane its degraded-transmission look. cuda, no vendor gate, no\r\n  559:     # sidecar, no toolchain. BOTH fp rows are False and that is the point: the\r\n  560:     # artifacts are FP16 and the profile pins dtype_policy=\"no_fp8_no_fp4\" so\r\n  561:     # nothing silently opts them into ComfyUI's optional FP8/FP4 transformations.\r\n  562:     #\r\n  563:     # THREE artifacts, where the retired siblings had two. The adapter is named\r\n  564:     # here so the S5 wizard asks for it; a haunted lane without it refuses to\r\n  565:     # render rather than quietly producing clean output.\r\n  566:     #\r\n  567:     # NO COST ROW EXISTS FOR THIS LANE. The operator declined a measurement\r\n  568:     # campaign, so it is recorded admission-unenforced in the evidence manifest\r\n  569:     # and makes no VRAM-fit claim -- see docs/2026-08-22-ghost-signal-\r\n  570:     # dependency-lock.json.\r\n  571:     \"animatediff15_v3_haunted_video\": {\r\n  572:         \"required_toolchain\": None, \"requires_sidecar\": False,\r\n  573:         \"device_backends\": [\"cuda\"], \"requires_vendor\": None,\r\n  574:         \"needs_fp8_te\": False, \"needs_fp4_te\": False,\r\n  575:         \"practical_without_gpu\": False, \"sidecar_conditional\": False,\r\n  576:         \"model_requirements\": [\"v1-5-pruned-emaonly-fp16.safetensors\",\r\n  577:                                \"v3_sd15_mm.ckpt\",\r\n  578:                                \"v3_sd15_adapter.ckpt\"]},\r\n  579:     \"minimax_h3_video\": {\r\n{\n  \"id\": \"otr_ghost_signal_v3_haunted\",\n  \"display_name\": \"Ghost Signal v3 + domain adapter (SHIP CANDIDATE -- pick this one)\",\n  \"status\": \"draft\",\n  \"platform\": \"any\",\n  \"device_backend\": \"cuda\",\n  \"gpu_vendor\": \"nvidia\",\n  \"toolchains\": [],\n  \"allow_sidecars\": true,\n  \"role_overrides\": {\n    \"announcer_visual\": \"animatediff15_v3_haunted_video\",\n    \"music_visual\": \"animatediff15_v3_haunted_video\",\n    \"character_visual\": \"animatediff15_v3_haunted_video\",\n    \"announcer_image\": \"z_image_turbo\",\n    \"music_image\": \"z_image_turbo\",\n    \"character_image\": \"z_image_turbo\"\n  },\n  \"slot_overrides\": {\n    \"voice_bank\": \"default\",\n    \"cast_voice_policy\": \"auto_registry\",\n    \"char_voice_engine\": \"indextts2\",\n    \"announcer_voice_engine\": \"kokoro\",\n    \"music_engine\": \"stable_audio_3\",\n    \"video_render_engine\": \"animatediff15_v3_haunted_video\"\n  },\n  \"features\": {\n    \"burn_captions\": true,\n    \"caption_style\": \"sdh_standard\"\n  },\n  \"seed_policy\": {\n    \"request_seed\": 42,\n    \"seed_mode\": \"request_hash\",\n    \"cast_seed_env\": null,\n    \"style_seed_env\": null\n  },\n  \"llm\": {\n    \"device\": \"cuda\",\n    \"attn_impl\": \"sdpa\",\n    \"quant_policy\": \"bnb_nf4\",\n    \"vram_ceiling_gb\": 14.5,\n    \"gguf_n_ctx\": 4096,\n    \"gguf_quant\": \"Q8_0\",\n    \"creative_model\": \"mistralai/Mistral-Nemo-Instruct-2407\",\n    \"technical_model\": \"google/gemma-4-12b-it\",\n    \"openrouter_slot_a_model\": \"(enable OpenRouter)\",\n    \"openrouter_slot_b_model\": \"(enable OpenRouter)\",\n    \"comfy_slot_a_model\": \"(enable Comfy Credits)\",\n    \"comfy_slot_b_model\": \"(enable Comfy Credits)\",\n    \"google_api_slot_a_model\": \"(select Google API model)\",\n    \"google_api_slot_b_model\": \"(select Google API model)\",\n    \"lane_allowlist\": [\n      \"transformers\",\n      \"gguf\",\n      \"openrouter\",\n      \"comfy_credits\",\n      \"google_api\"\n    ]\n  },\n  \"video\": {\n    \"device_policy\": \"cuda\",\n    \"dtype_policy\": \"no_fp8_no_fp4\"\n  },\n  \"image\": {\n    \"dtype_policy\": \"fp8_ok\"\n  },\n  \"audio\": {\n    \"voice_device\": \"cuda\"\n  },\n  \"render\": {\n    \"fps\": 25,\n    \"canvas_w\": 512,\n    \"canvas_h\": 288,\n    \"composite_res\": \"1920x1080\",\n    \"composite_w\": 1920,\n    \"composite_h\": 1080,\n    \"frame_budget\": 25,\n    \"beats\": 40\n  },\n  \"preflight\": {\n    \"required_models\": [\n      \"v1-5-pruned-emaonly-fp16.safetensors\",\n      \"v3_sd15_mm.ckpt\",\n      \"v3_sd15_adapter.ckpt\"\n    ],\n    \"required_keys\": []\n  },\n  \"launch\": {\n    \"sage_attention\": false,\n    \"extra_args\": [],\n    \"env\": {}\n  },\n  \"upscale_stage\": {\n    \"engine\": \"off\",\n    \"device\": \"cpu\"\n  }\n}\n\r\n","exit_code":0,"status":"completed"}}
