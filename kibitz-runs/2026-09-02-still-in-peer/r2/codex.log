{"type":"item.completed","item":{"id":"item_82","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=440; $i=$start-1; Get-Content -LiteralPath '\"'nodes\\\\_otr_shared\\\\capability_profiles.py' | Select-Object -Skip (\"'$start-1) -First 120 | ForEach-Object { $i++; '\"'{0,5}: {1}' -f \"'$i, $_ }'","aggregated_output":"  440: # ``practical_without_gpu`` + vendor/dtype table-visibility. A v1 row (any\r\n  441: # row still carrying ``cpu_ok``) is REJECTED outright -- the old false bark\r\n  442: # row cannot survive v2 semantics.\r\n  443: _DECL_KEYS = {\r\n  444:     \"required_toolchain\": lambda v: v is None or (isinstance(v, str) and bool(v)),\r\n  445:     \"requires_sidecar\": lambda v: isinstance(v, bool),\r\n  446:     \"device_backends\": lambda v: (\r\n  447:         isinstance(v, (list, tuple)) and bool(v)\r\n  448:         and all(b in _DEVICE_BACKENDS for b in v)),\r\n  449:     \"requires_vendor\": lambda v: v is None or v in (\"nvidia\", \"amd\", \"apple\"),\r\n  450:     \"needs_fp8_te\": lambda v: isinstance(v, bool),\r\n  451:     \"needs_fp4_te\": lambda v: isinstance(v, bool),\r\n  452:     \"practical_without_gpu\": lambda v: isinstance(v, bool),\r\n  453:     \"sidecar_conditional\": lambda v: isinstance(v, bool),\r\n  454:     \"model_requirements\": lambda v: isinstance(v, (list, tuple)) and all(isinstance(m, str) for m in v),\r\n  455: }\r\n  456: \r\n  457: # Availability reason codes (the shared availability object's vocabulary --\r\n  458: # reused by the validator, the wizard and the queue-start LOUD log).\r\n  459: REASON_OK = \"ok\"\r\n  460: REASON_REQUIRES_CUDA = \"requires_cuda\"\r\n  461: REASON_MISSING_TOOLCHAIN = \"missing_toolchain\"\r\n  462: REASON_SIDECARS_DISABLED = \"sidecars_disabled\"\r\n  463: # v2 additions:\r\n  464: REASON_REQUIRES_VENDOR = \"requires_vendor\"\r\n  465: REASON_IMPRACTICAL_ON_CPU = \"impractical_on_cpu\"\r\n  466: \r\n  467: \r\n  468: def validate_declaration(name: str, decl: Any, source: str = \"<registry>\") -> dict:\r\n  469:     \"\"\"Validate ONE engine capability declaration (registry-table row).\"\"\"\r\n  470:     if not isinstance(decl, dict):\r\n  471:         raise ProfileError(f\"{source}: declaration for {name!r} must be a dict\")\r\n  472:     unknown = set(decl) - set(_DECL_KEYS)\r\n  473:     if unknown:\r\n  474:         raise ProfileError(f\"{source}: declaration {name!r} has unknown key(s) {sorted(unknown)!r}\")\r\n  475:     missing = [k for k in _DECL_KEYS if k not in decl]\r\n  476:     if missing:\r\n  477:         raise ProfileError(f\"{source}: declaration {name!r} missing key(s) {missing!r}\")\r\n  478:     for k, check in _DECL_KEYS.items():\r\n  479:         if not check(decl[k]):\r\n  480:             raise ProfileError(f\"{source}: declaration {name!r} key {k!r} invalid: {decl[k]!r}\")\r\n  481:     return decl\r\n  482: \r\n  483: \r\n  484: def _fit_reason(decl: dict, profile: dict) -> str:\r\n  485:     \"\"\"Why does (or doesn't) ONE engine declaration fit ONE profile?\r\n  486:     Per-engine fit ONLY -- backend / vendor / toolchain / sidecar gating,\r\n  487:     never a VRAM tier or budget (the operator's tier JSON owns the OOM\r\n  488:     budget now) and never co-residency (that is a runtime invariant).\r\n  489: \r\n  490:     v2 (S3): ``device_backends`` supersedes the bare ``cpu_ok`` bool; a\r\n  491:     profile backend the engine does not list is a mismatch (the code stays\r\n  492:     ``requires_cuda`` -- vocabulary continuity for the validator/wizard/\r\n  493:     logs, and the missing backend IS cuda for every current local row).\r\n  494:     ``practical_without_gpu`` keeps technically-cpu-capable-but-impractical\r\n  495:     engines off the cpu floor; ``requires_vendor`` makes the NVML/cu128\r\n  496:     vendor pins table-visible.\"\"\"\r\n  497:     if profile[\"device_backend\"] not in decl[\"device_backends\"]:\r\n  498:         return REASON_REQUIRES_CUDA\r\n  499:     if profile[\"device_backend\"] == \"cpu\" and not decl[\"practical_without_gpu\"]:\r\n  500:         return REASON_IMPRACTICAL_ON_CPU\r\n  501:     if decl[\"requires_vendor\"] and profile.get(\"gpu_vendor\") != decl[\"requires_vendor\"]:\r\n  502:         return REASON_REQUIRES_VENDOR\r\n  503:     if decl[\"required_toolchain\"] and decl[\"required_toolchain\"] not in profile[\"toolchains\"]:\r\n  504:         return REASON_MISSING_TOOLCHAIN\r\n  505:     if decl[\"requires_sidecar\"] and not profile[\"allow_sidecars\"]:\r\n  506:         return REASON_SIDECARS_DISABLED\r\n  507:     return REASON_OK\r\n  508: \r\n  509: \r\n  510: def availability(profile: dict, declarations: dict) -> dict:\r\n  511:     \"\"\"The shared availability object: ``{engine_name: reason_code}`` for every\r\n  512:     declared engine of ONE namespace. ``reason == \"ok\"`` means enabled.\"\"\"\r\n  513:     out: dict[str, str] = {}\r\n  514:     for name in sorted(declarations):\r\n  515:         decl = validate_declaration(name, declarations[name])\r\n  516:         out[name] = _fit_reason(decl, profile)\r\n  517:     return out\r\n  518: \r\n  519: \r\n  520: def enabled_engines(profile: dict, declarations: dict) -> list:\r\n  521:     \"\"\"``enabled(P)`` for one namespace -- DERIVED, never hand-listed.\"\"\"\r\n  522:     return [n for n, reason in availability(profile, declarations).items() if reason == REASON_OK]\r\n  523: \r\n  524: \r\n  525: def cross_validate_profile(profile: dict, mapping: dict,\r\n  526:                            declarations_by_registry: dict) -> None:\r\n  527:     \"\"\"S1 capability cross-checks: every engine-valued override in the profile\r\n  528:     must be in ``enabled(P)`` of its namespace (the mapping names the\r\n  529:     namespace). Raises :class:`ProfileError` listing every violation.\r\n  530: \r\n  531:     Deliberately NO static co-residency rejection: a profile with two heavy\r\n  532:     roles is VALID (single-heavy residency is wrapper_bridge's runtime\r\n  533:     invariant, not a profile-shape concern).\"\"\"\r\n  534:     problems: list[str] = []\r\n  535:     managed = mapping[\"managed\"]\r\n  536:     flat = {}\r\n  537:     for section in (\"role_overrides\", \"slot_overrides\"):\r\n  538:         for key, value in profile.get(section, {}).items():\r\n  539:             flat[f\"{section}.{key}\"] = value\r\n  540:     for dotted, value in sorted(flat.items()):\r\n  541:         entry = managed.get(dotted)\r\n  542:         if entry is None:\r\n  543:             problems.append(\r\n  544:                 f\"{dotted}={value!r}: no widget-mapping entry (typo'd override key?)\"\r\n  545:             )\r\n  546:             continue\r\n  547:         registry = entry[\"registry\"]\r\n  548:         if registry is None:\r\n  549:             continue\r\n  550:         decls = declarations_by_registry.get(registry)\r\n  551:         if decls is None:\r\n  552:             problems.append(f\"{dotted}={value!r}: unknown registry namespace {registry!r}\")\r\n  553:             continue\r\n  554:         avail = availability(profile, decls)\r\n  555:         # Video-tiers (2026-07-20), boundary 7: resolve a PUBLIC menu id / LEGACY id\r\n  556:         # to its internal engine id before the CAPABILITIES membership check\r\n  557:         # (idempotent for a bare internal id / a non-video override).\r\n  558:         from .public_engines import resolve_engine_id\r\n  559:         reason = avail.get(resolve_engine_id(value))\r\n","exit_code":0,"status":"completed"}}
