   \"animatediff15_video\",\r\n 1521:     \"ghost_signal_official\",\r\n 1522: }\r\n 1523: # Registered OTR-native video routes that own no downloadable video weights.\r\n 1524: # They still consume the separately routed image/music lanes below. Keeping\r\n 1525: # this explicit avoids importing ComfyUI's registry before dependencies are\r\n 1526: # installed while ensuring an exact no-weight selection is not mistaken for an\r\n 1527: # unknown engine or silently replaced with another lane.\r\n 1528: _NO_WEIGHT_VIDEO_ENGINES = {\r\n 1529:     \"still_flat\",\r\n 1530:     \"still_motion\",\r\n 1531:     \"still_pan\",\r\n 1532:     \"still_word\",\r\n 1533:     \"viz_camera\",\r\n 1534:     \"viz_green\",\r\n 1535:     \"viz_mxc_cpu\",\r\n 1536:     \"viz_mxc_mandala\",\r\n 1537: }\r\n 1538: # These engines explicitly consume no init still. Keep the capability beside\r\n 1539: # the lightweight install-routing table: importing their ComfyUI adapters\r\n 1540: # before packs and weights exist would make provisioning depend on the thing it\r\n 1541: # is meant to install. AnimateDiff Ghost Signal owns its subject from text\r\n 1542: # (`required_inputs=(\"text_prompt\",)`, `accepts_still=False`), so its proven\r\n 1543: # 4060 path must not be gated on an ~11 GB Klein bundle it cannot invoke.\r\n 1544: # Still/pan/motion routes remain image consumers despite owning no video\r\n 1545: # weights.\r\n 1546: _NO_STILL_VIDEO_ENGINES = _ANIMATEDIFF_ENGINES | {\r\n 1547:     \"viz_camera\",\r\n 1548:     \"viz_green\",\r\n 1549:     \"viz_mxc_cpu\",\r\n 1550:     \"viz_mxc_mandala\",\r\n 1551: }\r\n 1552: # Provider-side routes own no local video weights. Keep them distinct from the\r\n 1553: # OTR-native set: provisioning can truthfully skip a download, while the\r\n 1554: # selected adapter still fails loud at invocation when its provider key is\r\n 1555: # absent. Only routes exercised by a shipping profile belong here.\r\n 1556: _REMOTE_NO_WEIGHT_VIDEO_ENGINES = {\r\n 1557:     \"cloud_wan_i2v\",\r\n 1558:     \"cloud_wan_i2v_audio\",\r\n 1559:     \"google_omni_video\",\r\n 1560:     \"google_veo_video\",\r\n 1561:     \"word_razzle\",\r\n 1562: }\r\n 1563: _REMOTE_NO_WEIGHT_IMAGE_ENGINES = {\r\n 1564:     \"cloud_flux_pro\",\r\n 1565:     \"cloud_nano_banana_2\",\r\n 1566:     \"cloud_seedream_2\",\r\n 1567:     \"cloud_krea_2_turbo\",\r\n 1568:     \"cloud_luma_photon_flash\",\r\n 1569:     \"ideo\",\r\n 1570:     \"google_image\",\r\n 1571: }\r\n 1572: _PROFILE_ID_RE = re.compile(r\"^[A-Za-z0-9_.-]+$\")\r\n 1573: \r\n 1574: \r\n 1575: def load_profile(profile_id: str) -> dict:\r\n 1576:     profile_id = str(profile_id or \"\")\r\n 1577:     if not _PROFILE_ID_RE.fullmatch(profile_id):\r\n 1578:         raise ProvisionFailure(\"invalid profile id: %r\" % profile_id)\r\n 1579:     path = os.path.join(_REPO, \"config\", \"profiles\", profile_id + \".json\")\r\nscripts/otr_provision.py:1516:_ANIMATEDIFF_ENGINES = {\nscripts/otr_provision.py:1546:_NO_STILL_VIDEO_ENGINES = _ANIMATEDIFF_ENGINES | {\nscripts/otr_provision.py:1640:            not in _NO_STILL_VIDEO_ENGINES)\nscripts/otr_provision.py:1659:        elif video in _ANIMATEDIFF_ENGINES:\n","exit_code":0,"status":"completed"}}
