\r\n 2745:             _lxw, _lxh = (int(x) for x in _lxc.lower().split(\"x\", 1))\r\n 2746:         except (ValueError, AttributeError):\r\n 2747:             _lxw, _lxh = 832, 480\r\n 2748:         req[\"canvas\"][\"w\"], req[\"canvas\"][\"h\"] = _lxw, _lxh\r\n 2749:     # THE ltx_audio_in INLINE CANVAS BRANCH WAS DELETED IN LANE 7 (2026-08-11).\r\n 2750:     #\r\n 2751:     # It computed the canvas here, RECIPE-DEPENDENTLY -- 832x480 when\r\n 2752:     # ia2v_canonical was live, 512x288 otherwise, either one overridable by\r\n 2753:     # OTR_LTX_AV_RENDER_CANVAS. That was three channels deciding one number\r\n 2754:     # while `declared_render_canvas` below is applied LAST and overrules all of\r\n 2755:     # them, so at most one of the three could ever have been true. The comment\r\n 2756:     # it carried also asserted the ia2v stage-A base \"416x240 (all /32)\", which\r\n 2757:     # is false -- 240 % 32 == 16 -- and that was S8b-10.\r\n 2758:     #\r\n 2759:     # The lane now DECLARES (1024, 576) on the adapter (LtxAudioInEngine.\r\n 2760:     # render_canvas), which is where the reasoning lives, and disagreement with\r\n 2761:     # OTR_LTX_AV_RENDER_CANVAS is a NAMED refusal in the adapter rather than a\r\n 2762:     # quiet re-plan here. The live receipts that walked the ladder -- 1280x720\r\n 2763:     # failing the /32 gate (proof5b) and 1280x704 breaching the 14.5 GB ceiling\r\n 2764:     # at 14,716 MB in the full production pipeline (proof6) -- are preserved at\r\n 2765:     # the declaration, because that is now the only place a reader needs to go.\r\n 2766:     # A DECLARED RENDER CANVAS WINS (B5, 2026-07-27). LAST in the chain on\r\n 2767:     # purpose: every write above is guarded by a mutually exclusive engine id\r\n 2768:     # or family, so nothing can clobber this and this clobbers nothing -- and\r\n 2769:     # being last means a future branch inserted above cannot silently displace\r\n 2770:     # it, which is precisely the defect (O1) this fixes. It reads the ADAPTER's\r\n 2771:     # own declaration rather than the family/aspect logic above, so the two\r\n 2772:     # mechanisms cannot disagree if a family mapping ever moves.\r\n 2773:     #\r\n 2774:     # Declared today: `ltx_8gb` (512x288); `ltx_video` (832x480) since\r\n 2775:     # 2026-08-02, because its 169-frame decode floor is CANVAS-DEPENDENT, so\r\n 2776:     # leaving the canvas to the env branch above left `OTR_LTX_RENDER_CANVAS`\r\n 2777:     # able to invalidate a STATIC frame contract without touching engine code;\r\n 2778:     # the four HuMo tiers and the three WAN lanes through the 2026-08-11 video\r\n 2779:     # transplant; and `ltx_audio_in` (1024x576) in lane 7, whose inline branch\r\n 2780:     # was DELETED rather than kept -- the sentence that used to sit here saying\r\n 2781:     # it \"keeps its env branch until the general resolver lands\" is no longer\r\n 2782:     # true, and a comment describing a mechanism that is gone is exactly the\r\n 2783:     # defect lesson L6 is about.\r\n 2784:     _declared = declared_render_canvas(str(shot.get(\"engine_id\") or \"\"))\r\n 2785:     if _declared is not None:\r\n 2786:         req[\"canvas\"][\"w\"], req[\"canvas\"][\"h\"] = _declared\r\n 2787:     _shot_role = str(shot.get(\"role\") or \"\")\r\n 2788:     if not _shot_role:\r\n 2789:         # Resilience: older planned ledgers carry the role only inside\r\n 2790:         # group_id (\"grp_<role>\") -- parse it so role-dependent prompt\r\n 2791:         # handling never silently skips (2026-06-10 acceptance catch).\r\n 2792:         _gid = str(shot.get(\"group_id\") or \"\")\r\n 2793:         if _gid.startswith(\"grp_\"):\r\n 2794:             _shot_role = _gid[len(\"grp_\"):]\r\n 2795:     creative = shot.get(\"creative\") or {}\r\n 2796:     text_prompt = str(creative.get(\"text_prompt\") or \"\")\r\n 2797:     # RESOLVED BEFORE CLASSIFIED (2026-08-27). `engine_family` is keyed on\r\n 2798:     # INTERNAL ids only, so a shot row carrying a public or legacy spelling\r\n 2799:     # -- `ltx23_low_audio_in`, `ltx23_16gb_audio_in`, both real registered\r\n 2800:     # aliases for `ltx_audio_in` -- fell through to its `\"abstract\"` default.\r\n 2801:     # That was survivable while `_fam` only picked fallback prompts; it is\r\n 2802:     # NOT survivable now that the LTX character append keys the lip-sync\r\n 2803:     # protection on it, because an audio-in lane misread as `abstract` would\r\n 2804:     # lose the steadying clause that keeps its mouth in frame. Resolution is\r\n 2805:     # for CLASSIFICATION only -- `shot[\"engine_id\"]` is never rewritten and\r\n 2806:     # dispatch still uses what ShotLock stamped.\r\n 2807:     try:\r\n 2808:         from .._otr_shared.public_engines import resolve_engine_id as _fam_rid\r\n 2809:     except ImportError:  # pragma: no cover -- flat test imports\r\n","exit_code":0,"status":"completed"}}
