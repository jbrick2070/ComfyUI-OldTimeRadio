leted at the\r\n  390:             # cascade-NODE surface. The orchestrator's defaults\r\n  391:             # (all OFF) carry them; B4 deletes the underlying\r\n  392:             # phase functions from _otr_lfc.py.\r\n  393:             disp = _LFC_ORCH.run_freeze_cascade(\r\n  394:                 generate_fn,\r\n  395:                 led,\r\n  396:                 polish_generate_fn=polish_generate_fn,\r\n  397:                 enable_phase_7_audio_readiness=enable_phase_7_audio_readiness,\r\n  398:                 enable_phase_8_video_readiness=enable_phase_8_video_readiness,\r\n  399:                 # Sprint 6 -- critic-to-render coupling.\r\n  400:                 render_selection=str(render_selection or \"all\"),\r\n  401:                 render_max_n=int(render_max_n or 0),\r\n  402:                 protagonist_only=bool(protagonist_only),\r\n  403:                 manual_line_ids=str(manual_line_ids or \"\"),\r\n  404:             )\r\n  405:             log.info(\r\n  406:                 \"[OTR_LedgerFreezeCascade] freeze_verdict=%s \"\r\n  407:                 \"(pre_warns=%d post_warns=%s reviewer=%s)\",\r\n  408:                 disp.verdict,\r\n  409:                 len(disp.gap_audit_pre.warnings),\r\n  410:                 (\r\n  411:                     len(disp.gap_audit_post.warnings)\r\n  412:                     if disp.gap_audit_post is not None\r\n  413:                     else \"n/a\"\r\n  414:                 ),\r\n  415:                 (\r\n  416:                     disp.reviewer_disposition.verdict\r\n  417:                     if disp.reviewer_disposition is not None\r\n  418:                     else \"n/a\"\r\n  419:                 ),\r\n  420:             )\r\n  421: \r\n  422:             # Serialize + rebuild WHILE the model is still loaded.\r\n  423:             # Neither touches torch tensors (assemble_script_text_from_ledger\r\n  424:             # is pure dict/string work; json.dumps walks the meta tree)\r\n  425:             # so placement order is safe -- the model could already be\r\n  426:             # released here. We keep the order for cleanliness; the\r\n  427:             # finally-block unload is the actual VRAM-safe gate.\r\n  428:             try:\r\n  429:                 updated_script_json = json.dumps(\r\n  430:                     led.data, indent=2, ensure_ascii=False,\r\n  431:                 )\r\n  432:             except Exception as exc:  # noqa: BLE001\r\n  433:                 log.warning(\r\n  434:                     \"[OTR_LedgerFreezeCascade] failed to serialize \"\r\n  435:                     \"post-freeze ledger to JSON (%s); falling back to \"\r\n  436:                     \"incoming script_json.\", exc,\r\n  437:                 )\r\n  438:                 updated_script_json = script_json or \"{}\"\r\n  439: \r\n  440:             try:\r\n  441:                 rebuilt_script_text = (\r\n  442:                     _PL.assemble_script_text_from_ledger(led.data)\r\n  443:                     or (script_text or \"\")\r\n  444:                 )\r\n  445:             except Exception as exc:  # noqa: BLE001\r\n  446:                 log.warning(\r\n  447:                     \"[OTR_LedgerFreezeCascade] assemble_script_text_\"\r\n  448:                     \"from_ledger raised (%s); falling back to \"\r\n  449:                     \"incoming script_text.\", exc,\r\n  450:                 )\r\n  451:                 rebuilt_script_text = script_text or \"\"\r\n  452:         finally:\r\n  453:             # B14 (commit 12.5) + B1 (commit 12.12): unload Mistral-\r\n  454:             # Nemo before downstream visual nodes load. Wrapped in\r\n  455:             # best-effort try/except -- an unload failure logs at\r\n  456:             # WARNING + stamps meta.freeze_unload_ok=False so the\r\n  457:             # next visual node can branch on the stamp instead of\r\n  458:             # OOM-ing on top of a leaked cache. The cascade itself\r\n  459:       