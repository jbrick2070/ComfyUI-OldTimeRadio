GOOGLE_API = \"google_api\"\r\n   34: \r\n   35: ALL_LANES: tuple[str, ...] = (\r\n   36:     LANE_TRANSFORMERS,\r\n   37:     LANE_GGUF,\r\n   38:     LANE_OPENROUTER,\r\n   39:     LANE_COMFY_CREDITS,\r\n   40:     LANE_GOOGLE_API,\r\n   41: )\r\n   42: \r\n   43: # Catalog row ``loader_backend`` -> lane token. Rows with no loader_backend\r\n   44: # (plain HF curated rows) are the transformers lane.\r\n   45: LANE_BY_LOADER_BACKEND: dict[str, str] = {\r\n   46:     \"transformers_safetensors\": LANE_TRANSFORMERS,\r\n   47:     \"transformers_multimodal_text_only\": LANE_TRANSFORMERS,\r\n   48:     \"transformers_gptq_int4\": LANE_TRANSFORMERS,\r\n   49:     \"gguf_native\": LANE_GGUF,\r\n   50:     \"openrouter_http\": LANE_OPENROUTER,\r\n   51:     \"comfy_credits_http\": LANE_COMFY_CREDITS,\r\n   52:     \"google_api_http\": LANE_GOOGLE_API,\r\n   53: }\r\n   54: \r\n   55: _DEVICES = (\"cuda\", \"cpu\", \"mps\")\r\n   56: _ATTN_IMPLS = (\"sdpa\", \"flash_attention_2\", \"eager\")\r\n   57: _QUANT_POLICIES = (\"bnb_nf4\", \"bnb_8bit\", \"none\")\r\n   58: _GGUF_QUANTS = (\"Q8_0\", \"Q6_K\", \"Q4_K_M\")\r\n   59: \r\n   60: \r\n   61: class LLMPolicyError(ValueError):\r\n   62:     \"\"\"A policy field is outside its enum / range. Fail loud at build.\"\"\"\r\n   63: \r\n   64: \r\n   65: @dataclasses.dataclass(frozen=True)\r\n   66: class LLMRuntimePolicy:\r\n   67:     \"\"\"Frozen, validated LLM runtime policy.\r\n   68: \r\n   69:     Defaults are the nv50 16 GB baseline (spec section 4): the identity\r\n   70:     policy. ``vram_ceiling_gb == 0`` means the pre-download VRAM-fit gate\r\n   71:     is DISABLED (cpu tier only -- there is no VRAM to fit).\r\n   72:     \"\"\"\r\n   73: \r\n   74:     device: str = \"cuda\"\r\n   75:     attn_impl: str = \"sdpa\"\r\n   76:     quant_policy: str = \"bnb_nf4\"\r\n   77:     vram_ceiling_gb: float = 14.5\r\n   78:     gguf_n_ctx: int = 4096\r\n   79:     gguf_quant: str = \"Q8_0\"\r\n   80:     lane_allowlist: tuple[str, ...] = ALL_LANES\r\n   81: \r\n   82:     def __post_init__(self) -> None:\r\n   83:         if self.device not in _DEVICES:\r\n   84:             raise LLMPolicyError(\r\n   85:                 f\"llm.device {self.device!r} not in {_DEVICES}\")\r\n   86:         if self.attn_impl not in _ATTN_IMPLS:\r\n   87:             raise LLMPolicyError(\r\n   88:                 f\"llm.attn_impl {self.attn_impl!r} not in {_ATTN_IMPLS}\")\r\n   89:         if self.quant_policy not in _QUANT_POLICIES:\r\n   90:             raise LLMPolicyError(\r\n   91:                 f\"llm.quant_policy {self.quant_policy!r} not in \"\r\n   92:                 f\"{_QUANT_POLICIES}\")\r\n   93:         if not isinstance(self.vram_ceiling_gb, (int, float)) or (\r\n   94:                 self.vram_ceiling_gb < 0):\r\n   95:             raise LLMPolicyError(\r\n   96:                 f\"llm.vram_ceiling_gb must be >= 0 (0 = disabled, cpu tier \"\r\n   97:                 f\"only); got {self.vram_ceiling_gb!r}\")\r\n   98:         if not isinstance(self.gguf_n_ctx, int) or self.gguf_n_ctx < 512:\r\n   99:             raise LLMPolicyError(\r\n  100:                 f\"llm.gguf_n_ctx must be an int >= 512; got \"\r\n  101:                 f\"{self.gguf_n_ctx!r}\")\r\n  102:         if self.gguf_quant not in _GGUF_QUANTS:\r\n  103:             raise LLMPolicyError(\r\n  104:                 f\"llm.gguf_quant {self.gguf_quant!r} not in {_GGUF_QUANTS}\")\r\n  105:         lanes = tuple(self.lane_allowlist)\r\n  106:         unknown = [l for l in lanes if l not in ALL_LANES]\r\n  107:         if unknown or not lanes:\r\n  108:             raise LLMPolicyError(\r\n  109:                 f\"llm.lane_allowlist must be a non-empty subset of \"\r\n  110:                 f\"{ALL_LANES}; got {self.lane_allowlist!r}\")\r\n  111:         object.__setattr__(self, \"lane_allowlist\", lanes)\r\n  112: \r\n  113:     # ------------------------------------------------------------------\r\n  114:     def admits_lane(self, lane: str) -> bool:\r\n  115:         return lane in self.lane_allowlist\r\n  116: \r\n  117:     def cache_key(self) -> tuple:\r\n  118:         \"\"\"The fields that shape a LOADED artifact. A resident model whose\r\n  119:         cache_key differs from the requested policy's must be torn down and\r\n  120:         reloaded -- silent stale-policy reuse is exactly the bug class this\r\n  121:         campaign kills. vram_ceiling_gb (pre-load gate) and lane_allowlist\r\n  122:         (admission) do not shape the artifact and are excluded.\"\"\"\r\n  123:         return (self.device, self.attn_impl, self.quant_policy,\r\n  124:                 self.gguf_n_ctx, self.gguf_quant)\r\n  125: \r\n  126: \r\n  127: #: The nv50 16 GB identity policy -- today's resolved baseline values.\r\n  128: BASELINE_POLICY = LLMRuntimePolicy()\r\n  129: \r\n  130: \r\n  131: def policy_from_meta(meta: Any) -> \"LLMRuntimePolicy | None\":\r\n  132:     \"\"\"Rebuild the writer-stamped policy from ledger ``meta['llm_policy']``\r\n  133:     (post-ship audit fix, 2026-07-10): downstream LLM consumers that only\r\n  134:     hold the LEDGER (freeze cascade, shot-lock derivation) read the SAME\r\n  135:     policy the writer ran under instead of silently falling back to the\r\n  136:     nv50 baseline. Returns None when the stamp is absent (pre-stamp\r\n  137:     ledgers -- callers keep the documented BASELINE backstop); a PRESENT\r\n  138:     but malformed stamp fails loud.\"\"\"\r\n  139:     raw = (meta or {}).get(\"llm_policy\") if isinstance(meta, dict) else None\r\n  140:     if raw is None:\r\n  141:         return None\r\n  142:     if not isinstance(raw, dict):\r\n  143:         raise LLMPolicyError(f\"ledger meta.llm_policy is malformed: {raw!r}\")\r\n  144:     try:\r\n  145:         return LLMRuntimePolicy(\r\n  146:             device=raw[\"device\"], attn_impl=raw[\"attn_impl\"],\r\n  147:             quant_policy=raw[\"quant_policy\"],\r\n  148:             vram_ceiling_gb=raw[\"vram_ceiling_gb\"],\r\n  149:             gguf_n_ctx=raw[\"gguf_n_ctx\"], gguf_quant=raw[\"gguf_quant\"],\r\n  150:             lane_allowlist=tuple(raw.get(\"lane_allowlist\") or ALL_LANES),\r\n  151:         )\r\n  152:     except (KeyError, TypeError) as e:\r\n  153:         raise LLMPolicyError(\r\n  154:             f\"ledger meta.llm_policy is malformed ({e!r}): {raw!r}\") from e\r\n  155: \r\n  156: \r\n  157: def lane_for_row(row: Any) -> str:\r\n  158:     \"\"\"Lane token for a catalog row (None row = transformers lane).\"\"\"\r\n  159:     lb = getattr(row, \"loader_backend\", None) if row is not None else None\r\n  160:     if lb is None:\r\n  161:         return LANE_TRANSFORMERS\r\n  162:     try:\r\n  163:         return LANE_BY_LOADER_BACKEND[str(lb)]\r\n  164:     except KeyError:\r\n  165:         raise LLMPolicyError(\r\n  166:             f\"catalog row loader_backend {lb!r} has no lane mapping -- add \"\r\n  167:             f\"it to LANE_BY_LOADER_BACKEND (no silent default)\") from None\r\n  168: \r\n  169: \r\n  170: __all__ = [\r\n  171:     \"ALL_LANES\",\r\n  172:     \"BASELINE_POLICY\",\r\n  173:     \"LANE_BY_LOADER_BACKEND\",\r\n  174:     \"LANE_COMFY_CREDITS\",\r\n  175:     \"LANE_GGUF\",\r\n  176:     \"LANE_GOOGLE_API\",\r\n  177:     \"LANE_OPENROUTER\",\r\n  178:     \"LANE_TRANSFORMERS\",\r\n  179:     \"LLMPolicyError\",\r\n  180:     \"LLMRuntimePolicy\",\r\n","exit_code":0,"status":"completed"}}
