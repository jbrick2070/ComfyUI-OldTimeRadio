{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'tests\\\\test_workflow_zod_shape.py';\"'$lines=Get-Content $p;for($n=1;$n -lt 130;$n++){'\"'{0,5}: {1}' -f (\"'$n+1),$lines[$n]}'","aggregated_output":"    2: to the canonical ComfyUI workflow shape so the Vue 3 frontend's Zod\r\n    3: validator accepts it on UI load.\r\n    4: \r\n    5: Anchored against the live-known-good shape of\r\n    6: `workflows/otr_canonical.json` (which loads cleanly in ComfyUI\r\n    7: Desktop) plus the example shipped by Nvidia_RTX_Nodes_ComfyUI. Any\r\n    8: hand-built workflow JSON (anything emitted by `outputs/_build_*.py`\r\n    9: helpers rather than exported by the ComfyUI UI) must pass these\r\n   10: checks before a user is asked to drag-and-drop it onto a canvas.\r\n   11: \r\n   12: Failure modes captured by this test (post 2026-05-02 EVENING):\r\n   13:   - missing top-level `last_node_id` / `last_link_id` / `version`\r\n   14:   - node-level `_meta` field instead of canonical `title`\r\n   15:   - input dicts containing `shape` (rejected by some Zod variants)\r\n   16:   - output dicts missing `slot_index`\r\n   17:   - link tuple length != 6\r\n   18:   - `Note` node `properties` dict containing non-empty entries\r\n   19: \"\"\"\r\n   20: from __future__ import annotations\r\n   21: import json\r\n   22: from pathlib import Path\r\n   23: from typing import Any\r\n   24: \r\n   25: import pytest\r\n   26: \r\n   27: REPO_ROOT = Path(__file__).resolve().parent.parent\r\n   28: WORKFLOWS_DIR = REPO_ROOT / 'workflows'\r\n   29: \r\n   30: # Required keys at workflow root.\r\n   31: ROOT_REQUIRED = {\r\n   32:     'last_node_id', 'last_link_id', 'nodes', 'links',\r\n   33:     'groups', 'config', 'extra', 'version',\r\n   34: }\r\n   35: \r\n   36: # Required keys per node.\r\n   37: NODE_REQUIRED = {'id', 'type', 'pos', 'size', 'flags', 'order',\r\n   38:                  'mode', 'inputs', 'outputs', 'properties'}\r\n   39: \r\n   40: # Allowed keys per input dict. Mirrors what the production workflow\r\n   41: # (`workflows/otr_canonical.json`) actually carries on its inputs\r\n   42: # in real-world use, since that workflow is known to load cleanly\r\n   43: # through ComfyUI's frontend Zod validator. `shape` is observed on\r\n   44: # optional inputs (LiteGraph optional-socket marker, value 7).\r\n   45: INPUT_ALLOWED = {'name', 'type', 'link', 'widget', 'pos',\r\n   46:                  'dir', 'label', 'localized_name', 'slot_index',\r\n   47:                  'shape'}\r\n   48: \r\n   49: # Allowed keys per output dict. `slot_index` is observed in production.\r\n   50: OUTPUT_ALLOWED = {'name', 'type', 'links', 'slot_index', 'shape',\r\n   51:                   'pos', 'dir', 'label', 'localized_name'}\r\n   52: \r\n   53: \r\n   54: def _all_workflows() -> list[Path]:\r\n   55:     if not WORKFLOWS_DIR.exists():\r\n   56:         return []\r\n   57:     return sorted(WORKFLOWS_DIR.glob('*.json'))\r\n   58: \r\n   59: \r\n   60: @pytest.mark.parametrize('wf_path', _all_workflows(),\r\n   61:                          ids=lambda p: p.name)\r\n   62: class TestWorkflowZodShape:\r\n   63:     \"\"\"Per-workflow shape checks aimed at the ComfyUI frontend Zod schema.\"\"\"\r\n   64: \r\n   65:     def _wf(self, wf_path: Path) -> dict[str, Any]:\r\n   66:         return json.loads(wf_path.read_text(encoding='utf-8'))\r\n   67: \r\n   68:     def test_json_parses(self, wf_path: Path) -> None:\r\n   69:         wf = self._wf(wf_path)\r\n   70:         assert isinstance(wf, dict), f'{wf_path.name}: root not a dict'\r\n   71: \r\n   72:     def test_root_keys_present(self, wf_path: Path) -> None:\r\n   73:         wf = self._wf(wf_path)\r\n   74:         missing = ROOT_REQUIRED - set(wf.keys())\r\n   75:         assert not missing, (\r\n   76:             f'{wf_path.name}: missing required root keys {missing}; '\r\n   77:             f'present: {sorted(wf.keys())}'\r\n   78:         )\r\n   79: \r\n   80:     def test_root_id_is_uuid(self, wf_path: Path) -> None:\r\n   81:         \"\"\"ComfyUI frontend Zod requires `id` to be a valid UUID string.\r\n   82:         Hand-built workflows that use a freeform slug get rejected with\r\n   83:         `Invalid uuid at \"id\"` (BUG-LOCAL-012, observed 2026-05-02).\"\"\"\r\n   84:         import re\r\n   85:         wf = self._wf(wf_path)\r\n   86:         wf_id = wf.get('id')\r\n   87:         if wf_id is None:\r\n   88:             # `id` is allowed to be missing entirely (some older workflows).\r\n   89:             return\r\n   90:         assert isinstance(wf_id, str), (\r\n   91:             f'{wf_path.name}: id is not a string ({type(wf_id).__name__})'\r\n   92:         )\r\n   93:         uuid_re = re.compile(\r\n   94:             r'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-'\r\n   95:             r'[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'\r\n   96:         )\r\n   97:         assert uuid_re.match(wf_id), (\r\n   98:             f'{wf_path.name}: id={wf_id!r} is not a valid UUID; '\r\n   99:             'ComfyUI Zod will reject this workflow with '\r\n  100:             '`Invalid uuid at \"id\"` on UI load'\r\n  101:         )\r\n  102: \r\n  103:     # NOTE: We do NOT enforce \"no `_meta` on nodes\" or \"every output has\r\n  104:     # slot_index\" because the production workflow has both shapes and\r\n  105:     # ComfyUI accepts it. Either Zod is lenient on those, or the field\r\n  106:     # is normalized in the loader. Only assert what is genuinely\r\n  107:     # contract-required by both known-good workflows\r\n  108:     # (otr_canonical.json + Nvidia rtx_video_upscale.json).\r\n  109: \r\n  110:     def test_no_unknown_input_keys(self, wf_path: Path) -> None:\r\n  111:         \"\"\"Catches `shape: 7` and similar fields that production\r\n  112:         workflows do not carry on inputs.\"\"\"\r\n  113:         wf = self._wf(wf_path)\r\n  114:         offenders: list[str] = []\r\n  115:         for n in wf.get('nodes') or []:\r\n  116:             if not isinstance(n, dict):\r\n  117:                 continue\r\n  118:             for i, inp in enumerate(n.get('inputs') or []):\r\n  119:                 if not isinstance(inp, dict):\r\n  120:                     continue\r\n  121:                 unknown = set(inp.keys()) - INPUT_ALLOWED\r\n  122:                 if unknown:\r\n  123:                     offenders.append(\r\n  124:                         f'node {n.get(\"id\")} ({n.get(\"type\")}) '\r\n  125:                         f'input[{i}] {inp.get(\"name\")}: extra keys '\r\n  126:                         f'{sorted(unknown)}'\r\n  127:                     )\r\n  128:         assert not offenders, (\r\n  129:             f'{wf_path.name}: inputs carry non-canonical keys: '\r\n  130:             f'{offenders[:5]}'\r\n","exit_code":0,"status":"completed"}}
