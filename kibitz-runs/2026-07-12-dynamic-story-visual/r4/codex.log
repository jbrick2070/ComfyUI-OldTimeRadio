se \"nvidia\")\r\n  283:             except Exception:  # noqa: BLE001 -- unusable CUDA = no CUDA\r\n  284:                 info[\"has_cuda\"] = False\r\n  285:                 info[\"vram_mb\"] = 0\r\n  286:                 info[\"vendor\"] = \"none\"\r\n  287:             _mps = getattr(torch.backends, \"mps\", None)\r\n  288:             if _mps is not None and _mps.is_available():\r\n  289:                 info[\"has_mps\"] = True\r\n  290:                 if info[\"vendor\"] == \"none\":\r\n  291:                     info[\"vendor\"] = \"apple\"\r\n  292:         except Exception:  # noqa: BLE001 -- detection must never crash\r\n  293:             pass\r\n  294:         return info\r\n  295: \r\n  296:     def _assert_stamp(self, workflow_json_path: str, profile_id: str,\r\n  297:                       master_hash: str, generated_by: str) -> str:\r\n  298:         \"\"\"The S2 startup assertion: a STAMPED workflow must match the\r\n  299:         committed profile AND the detected host reality, else the prompt\r\n  300:         ABORTS with a reason -> suggestion table (no cuda -> cpu_floor;\r\n  301:         mac -> cpu_floor). ACTIVE whenever profile_id is non-empty;\r\n  302:         ``validate_anyway`` can NEVER skip it. On pass, exports the active\r\n  303:         profile id (every execution -- stale values from a previous prompt\r\n  304:         are overwritten). The VRAM OOM budget is owned by the operator's\r\n  305:         tier JSON now, so no ceiling is exported.\"\"\"\r\n  306:         from ._otr_shared.capability_profiles import ProfileError, load_profile\r\n  307:         try:\r\n  308:             profile = load_profile(profile_id)\r\n  309:         except ProfileError as e:\r\n  310:             raise ValueError(\r\n  311:                 f\"OTR_WorkflowValidator: stamped profile_id {profile_id!r} \"\r\n  312:                 f\"failed to load: {e}\") from e\r\n  313: \r\n  314:         host = self._detect_host()\r\n  315:         problems = []\