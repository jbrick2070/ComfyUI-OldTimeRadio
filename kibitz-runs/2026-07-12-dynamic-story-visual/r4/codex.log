l-style problem.\"\"\"\r\n  128: \r\n  129: \r\n  130: class UnknownVisualStyleError(VisualStyleError):\r\n  131:     \"\"\"style_id has no pack under nodes/visual_styles/.\"\"\"\r\n  132: \r\n  133: \r\n  134: class VisualStyleValidationError(VisualStyleError):\r\n  135:     \"\"\"A pack file violates the v2 schema / lint / path contract.\"\"\"\r\n  136: \r\n  137: \r\n  138: @dataclass(frozen=True)\r\n  139: class VisualStyle:\r\n  140:     \"\"\"One loaded, validated style pack (attribute access only -- r2 OPT).\r\n  141:     Dict fields are immutable mappings (r2 codex OPT).\"\"\"\r\n  142:     style_id: str\r\n  143:     label: str\r\n  144:     positive_tail: str\r\n  145:     image_grade_tail: str\r\n  171: \r\n  172: \r\n  173: def _lint_template(path: Path, label: str, value: str,\r\n  174:                    placeholder: str) -> None:\r\n  175:     \"\"\"EXACTLY one ``{placeholder}`` and no other brace tokens (a stray\r\n  176:     ``{x}`` would KeyError at compose time -- fail at load instead).\"\"\"\r\n  177:     token = \"{%s}\" % placeholder\r\n  178:     if value.count(\"{\") != 1 or value.count(\"}\") != 1 or token not in value:\r\n  179:         raise VisualStyleValidationError(\r\n  180:             f\"visual style {path}: {label} must contain the placeholder \"\r\n  181:             f\"{token} exactly once and no other brace tokens; got {value!r}\")\r\n  182: \r\n  183: \r\n  184: def _validate_row(raw: dict, path: Path) -> VisualStyle:\r\n  185:     if not isinstance(raw, dict):\r\n  186:         raise VisualStyleValidationError(\r\n  187:             f\"visual style {path}: top level must be an object, \"\r\n  188:             f\"got {type(raw).__name__}\")\r\n  189:     declared = raw.get(\"schema_version\")\r\n  190:     if declared == \"v1\":\r\n  191:         raise VisualStyleValidationError(\r\n  192:             f\"visual style {path}: schema_version 'v1' is retired -- \"\r\n  193:             f\"upgrade to v2 (total-coverage slice 2026-07-05: add the \"\r\n  194:             f\"{len(_V2_STR_FIELDS)} look/subject str fields + \"\r\n  195:             f\"{len(_V2_DICT_FIELDS)} dict fields; see \"\r\n  196:             f\"STAGE3_TOTAL_COVERAGE_SUBPLAN.md section 1a)\")\r\n  197:     unknown = sorted(set(raw) - set(_REQUIRED_FIELDS))\r\n  198:     if unknown:\r\n  199:         raise VisualStyleValidationError(\r\n  200:             f\"visual style {path}: unknown key(s) {unknown!r} -- the v2 \"\r\n  201:             f\"schema is exact (subject/motion/ledger_directives lab fields \"\r\n  202:             f\"are NOT schema fields; see STAGE3_TOTAL_COVERAGE_SUBPLAN)\")\r\n  203:     missing = sorted(set(_REQUIRED_FIELDS) - set(raw))\r\n  204:     if missing:\r\n  205:         raise VisualStyleValidationError(\r\n  206:             f\"visual style {path}: missing required key(s) {missing!r}\")\r\n  207:     for key, typ in _REQUIRED_FIELDS.items():\r\n  208:         val = raw[key]\r\n  209:         if typ is bool:\r\n  210:             if not isinstance(val, bool):\r\n  211:                 raise VisualStyleValidationError(\r\n  212:                     f\"visual style {path}: {key} must be a bool, \"\r\n  213:                     f\"got {type(val).__name__}\")\r\n  214:         elif not isinstance(val, typ) or isinstance(val, bool):\r\n  215:             raise VisualStyleValidationError(\r\n  216:                 f\"visual style {path}: {key} must be {typ.__name__}, \"\r\n  217:                 f\"got {type(val).__name__}\")\r\n  218:     style_id = raw[\"style_id\"]\r\n  219:     if not _STYLE_ID_RE.match(style_id):\r\n  220:         raise VisualStyleValidationError(\r\n  221:             f\"visual style {path}: style_id {style_id!r} must match \"\r\n  222:             f\"{_STYLE_ID_RE.pattern}\")\r\n  223:     if style_id != path.stem:\r\n  224:         raise VisualStyleValidationError(\r\n  225:             f\"visual style {path}: header style_id {style_id!r} does not \"\r\n  226:             f\"match the filename {path.stem!r} -- the path IS the coordinate\")\r\n  227:     if raw[\"schema_version\"] not in KNOWN_STYLE_SCHEMA_VERSIONS:\r\n  228:         raise VisualStyleValidationError(\r\n  229:             f\"visual style {path}: unknown schema_version \"\r\n  230:             f\"{raw['schema_version']!r}; known: \"\r\n  231:             f\"{sorted(KNOWN_STYLE_SCHEMA_VERSIONS)}\")\r\n  232:     # -- v2 str fields: non-empty (one exemption) --\r\n  233:     for name in _V2_STR_FIELDS:\r\n  234:         if (name not in _V2_EMPTY_LEGAL_STR_FIELDS\r\n  235:                 and not str(raw[name]).strip()):\r\n  236:             raise VisualStyleValidationError(\r\n  237:                 f\"visual style {path}: {name} must be non-empty (only \"\r\n  238:                 f\"scene_instruction_look may be empty -- r4 AG M1)\")\r\n  239:     # -- template lints --\r\n  240:     for name, placeholder in _TEMPLATE_STR_FIELDS.items():\r\n  241:         _lint_template(path, name, raw[name], placeholder)\r\n  242:     if not any(w in raw[\"announcer_subject_ltx_mouth\"].lower()\r\n  243:                for w in _MOUTH_VOCAB):\r\n  244:         raise VisualStyleValidationError(\r\n  245:             f\"visual style {path}: announcer_subject_ltx_mouth must carry \"\r\n  246:             f\"mouth-prominence vocabulary ({'/'.join(_MOUTH_VOCAB)}) -- the \"\r\n  247:             f\"ia2v lip-sync contract drives whatever READS as a mouth\")\r\n  248:     # -- dict fields: exact keys, non-empty str values --\r\n  249:     dict_values: \"list[tuple[str, str]]\" = []\r\n  250:     for name, keys in _V2_DICT_FIELDS.items():\r\n  251:         got = raw[name]\r\n  252:         if set(got) != keys:\r\n  253:             raise VisualStyleValidationError(\r\n  254:                 f\"visual style {path}: {name} keys must be EXACTLY \"\r\n  255:                 f\"{sorted(keys)} (case-sensitive); got {sorted(got)}\")\r\n  256:         for k, v in got.items():\r\n  257:             if not isinstance(v, str) or not v.strip():\r\n  258:                 raise VisualStyleValidationError(\r\n  259:                     f\"visual style {path}: {name}[{k!r}] must be a \"\r\n  260:                     f\"non-empty string\")\r\n  261:             dict_values.append((f\"{name}[{k!r}]\", v))\r\n  262:     for k, v in raw[\"open_subjects\"].items():\r\n  263:         _lint_template(path, f\"open_subjects[{k!r}]\", v,\r\n  264:                        _OPEN_SUBJECTS_PLACEHOLDER)\r\n  265:     for k, v in raw[\"motion_registers\"].items():\r\n  266:         if len(v) > _MOTION_REGISTER_MAX_CHARS:\r\n  267:             raise VisualStyleValidationError(\r\n  268:                 f\"visual style {path}: motion_registers[{k!r}] is \"\r\n  269:                 f\"{len(v)} chars, over the {_MOTION_REGISTER_MAX_CHARS}-char \"\r\n  270:                 f\"motion budget (BUG-LOCAL-112)\")\r\n  271:     terms: \"list[str]\" = []\r\n  272:     for i, t in enumerate(raw[\"forbidden_terms\"]):\r\n  273:         if not isinstance(t, str) or not t.strip():\r\n  274:             raise VisualStyleValidationError(\r\n  275:                 f\"visual style {path}: forbidden_terms[{i}] must be a \"\r\n  276:                 f\"non-empty string\")\r\n  277:         terms.append(t)\r\n  278:     # Load-time lint (r2 codex S2): case-insensitive substring over the 4\r\n  279:     # tail fields + ALL new string leaves + dict values -- a pack must not\r\n  280:     # violate its own bans anywhere.\r\n  281:     linted: \"list[tuple[str, str]]\" = [\r\n  282:         (fld, str(raw[fld])) for fld in _LINTED_TAIL_FIELDS]\r\n  283:     linted.extend((name, str(raw[name])) for name in _V2_STR_FIELDS)\r\n  284:     linted.extend(dict_values)\r\n  285:     for term in terms:\r\n  286:         needle = term.lower()\r\n  287:         for label, text in linted:\r\n  288:             if needle in text.lower():\r\n  289:                 raise VisualStyleValidationError(\r\n  290:                     f\"visual style {path}: forbidden term {term!r} appears \"\r\n  291:                     f\"in its own {label} -- a pack must not violate its own \"\r\n  292:                     f\"bans\")\r\n  293:     return VisualStyle(\r\n  294:         style_id=style_id,\r\n  295:         label=raw[\"label\"],\r\n  296:         positive_tail=raw[\"positive_tail\"],\r\n  297:         image_grade_tail=raw[\"image_grade_tail\"],\r\n  298:         broadcast_tail=raw[\"broadcast_tail\"],\r\n  299:         allow_radio_tails=raw[\"allow_radio_tails\"],\r\n  300:         forbidden_terms=tuple(terms),\r\n","exit_code":0,"status":"completed"}}
