{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'nodes\\\\_otr_model_catalog.py';\"'$lines=Get-Content $p;for($n=1188;$n -lt 1285;$n++){'\"'{0,5}: {1}' -f (\"'$n+1),$lines[$n]}'","aggregated_output":" 1189:             hub_root=hub_root,\r\n 1190:         )\r\n 1191:     )\r\n 1192: \r\n 1193: \r\n 1194: # ---------------------------------------------------------------------------\r\n 1195: # B1b: dynamic context-cap resolution (replaces _otr_model_loader's\r\n 1196: # MODEL_CONTEXT_CAPS static dict + DEFAULT_CONTEXT_CAP)\r\n 1197: # ---------------------------------------------------------------------------\r\n 1198: \r\n 1199: \r\n 1200: # Hardware-aware ceiling on the effective context window. A small model\r\n 1201: # like Gemma-4-E4B advertises a 128k context in its config.json, but\r\n 1202: # feeding 128k tokens on a 16 GB card OOMs instantly. The clamp keeps\r\n 1203: # the upper bound sane regardless of the model's claim.\r\n 1204: #\r\n 1205: # Default: 8192 on the 5080 16 GB target. Configurable via\r\n 1206: # OTR_HARD_VRAM_CONTEXT_LIMIT so users on bigger hardware can raise it.\r\n 1207: def _hard_vram_context_limit() -> int:\r\n 1208:     raw = os.environ.get(\"OTR_HARD_VRAM_CONTEXT_LIMIT\")\r\n 1209:     if raw:\r\n 1210:         try:\r\n 1211:             return max(512, int(raw))\r\n 1212:         except (TypeError, ValueError):\r\n 1213:             pass\r\n 1214:     return 8192\r\n 1215: \r\n 1216: \r\n 1217: HARD_VRAM_CONTEXT_LIMIT = _hard_vram_context_limit()\r\n 1218: \r\n 1219: \r\n 1220: # Explicit per-model effective-context overrides for the curated set\r\n 1221: # only (where config.json advertises a larger window than what the\r\n 1222: # inference pipeline can sanely feed). The Mistral-Nemo entry pins the\r\n 1223: # C7 audio-baseline value -- _otr_model_loader's prior static dict said\r\n 1224: # 8192 for Mistral-Nemo even though config.json advertises 131072.\r\n 1225: # Holding that here keeps audio byte-identity across B1b.\r\n 1226: CURATED_CONTEXT_OVERRIDES: dict[str, int] = {\r\n 1227:     \"mistralai/Mistral-Nemo-Instruct-2407\": 8192,\r\n 1228:     \"google/gemma-2-2b-it\": 8192,\r\n 1229:     \"google/gemma-4-E2B-it\": 8192,\r\n 1230:     \"google/gemma-4-E4B-it\": 8192,\r\n 1231:     \"Qwen/Qwen2.5-14B-Instruct\": 8192,\r\n 1232:     \"Nitral-AI/Captain-Eris_Violet-V0.420-12B\": 8192,\r\n 1233:     \"inflatebot/MN-12B-Mag-Mell-R1\": 8192,\r\n 1234: }\r\n 1235: \r\n 1236: \r\n 1237: @dataclass(frozen=True)\r\n 1238: class ContextCapVerdict:\r\n 1239:     \"\"\"Tiered verdict from resolve_context_cap. Mirrors VRAMFitVerdict\r\n 1240:     shape (B1c). Never raises -- the request_slot escalation logic in\r\n 1241:     B1c makes a single combined decision.\"\"\"\r\n 1242: \r\n 1243:     tier: Literal[\"PASS\", \"WARN\", \"UNKNOWN\"]\r\n 1244:     value: int\r\n 1245:     source: str\r\n 1246: \r\n 1247: \r\n 1248: def _read_config_context(model_id: str, hub_root: Path | None = None) -> int | None:\r\n 1249:     \"\"\"Best-effort read of advertised context window from a locally-\r\n 1250:     scanned snapshot's config.json. Returns None if no snapshot is on\r\n 1251:     disk or config.json is unreadable.\"\"\"\r\n 1252:     for r in scan_local_llm_cache(hub_root=hub_root):\r\n 1253:         if r.repo_id == model_id and r.on_disk and r.advertised_context:\r\n 1254:             return r.advertised_context\r\n 1255:     return None\r\n 1256: \r\n 1257: \r\n 1258: def resolve_context_cap(\r\n 1259:     model_id: str, *, hub_root: Path | None = None\r\n 1260: ) -> ContextCapVerdict:\r\n 1261:     \"\"\"Resolve the effective context-window cap for `model_id`.\r\n 1262: \r\n 1263:     Returns a tiered verdict (never raises):\r\n 1264:         PASS    -- model_id has an explicit override (soak-tested cap);\r\n 1265:                    value = min(override, HARD_VRAM_CONTEXT_LIMIT).\r\n 1266:         WARN    -- config.json parses cleanly but model isn't in the\r\n 1267:                    override table; value = min(parsed, HARD_VRAM_CONTEXT_LIMIT).\r\n 1268:         UNKNOWN -- neither source resolves; value = HARD_VRAM_CONTEXT_LIMIT\r\n 1269:                    (the only safe default; B1c's request_slot makes the\r\n 1270:                    combined fit/cap decision).\r\n 1271: \r\n 1272:     The clamp handles two real failure modes:\r\n 1273:       * \"model says 4k but we feed 8k\": parsed used, clamped down to\r\n 1274:         limit if needed.\r\n 1275:       * \"model says 128k, we'd OOM on 16 GB\": clamped to limit.\r\n 1276:     \"\"\"\r\n 1277:     limit = HARD_VRAM_CONTEXT_LIMIT\r\n 1278:     override = CURATED_CONTEXT_OVERRIDES.get(model_id)\r\n 1279:     if override is not None:\r\n 1280:         return ContextCapVerdict(\r\n 1281:             tier=\"PASS\",\r\n 1282:             value=min(override, limit),\r\n 1283:             source=f\"curated-override (raw {override})\",\r\n 1284:         )\r\n 1285:     parsed = _read_config_context(model_id, hub_root=hub_root)\r\n","exit_code":0,"status":"completed"}}
