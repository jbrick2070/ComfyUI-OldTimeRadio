rompt\",)\r\n  237:     commercial_clean = True         # own ffmpeg + the chosen still; no model license\r\n  238:     uses_still = True               # animate a provided still (pan) when present\r\n  239:     accepts_still = True            # C1: mint the selected still (coverage gate) so an\r\n  240:     #                                 opener/beat that picks still_pan shows the chosen\r\n  241:     #                                 image instead of the dark floor (D2 BLACK fix)\r\n  242: \r\n  243: \r\n  244: @register\r\n  245: class StillFlatFamily(_CheapFamilyBase):\r\n  389:     try:\r\n  390:         from ._otr_video_engines.render_driver import _radio_is_host_redirect_applies\r\n  391:         if _radio_is_host_redirect_applies(eff):\r\n  392:             return \"ltx_audio_in\"\r\n  393:     except Exception:  # noqa: BLE001 -- fail-safe: keep the selected id\r\n  394:         return eff\r\n  395:     return eff\r\n  396: \r\n  397: \r\n  398: def _still_needed_for_role(image_policy: dict, role: str) -> bool:\r\n  399:     \"\"\"True if the SELECTED video engine for ``role`` consumes the role's still.\r\n  400:     When the role's video engine IGNORES the still (the visualizer / abstract /\r\n  401:     audio-only procedural floor -> ``accepts_still=False``), the still is never used\r\n  402:     -> skip generating it, so an all-procedural episode invokes NO image model\r\n  403:     (accessible for users with no image/video models). Fail SAFE: unknown engine /\r\n  404:     missing video_models / unknown role -> True (keep the still, legacy behaviour).\r\n  405:     Pure registry read; delegates the capability check to ``engine_consumes_still``.\"\"\"\r\n  406:     vmodels = (image_policy or {}).get(\"video_models\") or {}\r\n  407:     if not vmodels:\r\n  408:         return True                       # legacy policy: dispatch every still\r\n  409:     # Unknown role -> keep the still (fail-safe), matching the legacy\r\n  410:     # _ROLE_TO_VIDEO_SLOT.get(role) -> None -> True behaviour. engine_id_for_role\r\n  411:     # raises ValueError on an unknown role, so guard explicitly.\r\n  412:     if str(role) not in _role_slots.ROLE_TO_VIDEO_SLOT:\r\n  413:         return True\r\n  414:     # Route-A: resolve the role's video engine via the ONE shared map (per-role\r\n  415:     # slot only) so character_video correctly\r\n  416:     # reads character_video_model (humo_14B_169 consumes the still it requires).\r\n  417:     eng_id = _role_slots.engine_id_for_role(vmodels, str(role))\r\n  418:     if not eng_id:\r\n  419:         return True\r\n  420:     # Honor render-time engine rewrites (force-map + radio-is-host redirect): the\r\n  421:     # image phase must mint/skip against the same engine build_request_from_shot\r\n  422:     # will see, or a redirected talking ltx_audio_in announcer can reach render\r\n  423:     # without its mandatory wide radio-face still.\r\n  424:     eng_id = _effective_video_engine_for_role(str(role), eng_id)\r\n  425:     try:\r\n  426:         from ._otr_video_engines import registry as _vreg\r\n  427:         eng = _vreg.get_engine(eng_id)\r\n  428:     except Exception as exc:              # noqa: BLE001\r\n  429:         # No silent fallback (LOUD): an unknown/unresolvable engine keeps the still\r\n  430:         # (fail SAFE) but says so -- never a quiet force-True.\r\n  551:         prompt_hash = _prompt_content_hash(prompt)\r\n  552:         obj_w = int(obj.get(\"w\") or 0)\r\n  553:         obj_h = int(obj.get(\"h\") or 0)\r\n  554:         if not oid:\r\n  555:             continue\r\n  556:         # SKIP an unused still: when this role's SELECTED video engine ignores\r\n  557:         # init_image (the visualizer / abstract procedural floor), the still is\r\n  558:         # never consumed -> do not generate it. An all-procedural episode then\r\n  559:         # invokes NO image model at all (accessible: works for users with no\r\n  560:         # image/video models). Safe for byte-identical (the skipped still was\r\n  561:         # unused; audio + video output unchanged). LOUD trace.\r\n  562:         if not _still_needed_for_role(image_policy, role):\r\n  563:             log.info(\"[OTR_ImageGenDispatcher] skip %s (role=%s): the selected \"\r\n  564:                      \"video engine ignores init_image (procedural floor) -- no \"\r\n  565:                      \"still generated\", oid, role)\r\n  566:             continue\r\n  567:         # Slot resolution per OBJECT role (ST-3: the ImageDirector slots\r\n  568:         # finally honored); empty named slot -> character fallback, LOUD.\r\n  569:         engine_id, slot, fell_back = resolve_engine_for_role(image_policy, role)\r\n  570:         # BUG-LOCAL-405 (per-role image selection): LOUD trace of how each\r\n  571:         # object's role resolved to a policy slot + engine, so an unexpected\r\n  572:         # engine (e.g. every still minting flux_gen1 because the SAVED policy\r\n  573:         # carried flux_gen1 in all slots) is visible in the server log instead\r\n","exit_code":0,"status":"completed"}}
