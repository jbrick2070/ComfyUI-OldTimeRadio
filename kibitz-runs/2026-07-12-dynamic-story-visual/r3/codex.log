structured_call.py:682:            return _parse_and_validate(last_raw, schema, post_validator)\r\nnodes\\_otr_structured_call.py:686:                \"[OTR_StructuredCall] '%s' attempt %d failed: %s | raw \"\r\nnodes\\_otr_structured_call.py:687:                \"head: %s\", helper_name, attempts_run, exc,\r\nnodes\\_otr_structured_call.py:699:    # on json.JSONDecodeError. attempts_run advances ONLY when this branch runs.\r\nnodes\\_otr_structured_call.py:700:    if attempts_run < max_attempts and isinstance(last_error, json.JSONDecodeError):\r\nnodes\\_otr_structured_call.py:701:        attempts_run += 1\r\nnodes\\_otr_structured_call.py:703:            \"[OTR_StructuredCall] '%s' attempt %d/%d: structural retry at \"\r\nnodes\\_otr_structured_call.py:705:            helper_name, attempts_run, max_attempts,\r\nnodes\\_otr_structured_call.py:710:                slot_fn, base_messages,\r\nnodes\\_otr_structured_call.py:714:            return _parse_and_validate(last_raw, schema, post_validator)\r\nnodes\\_otr_structured_call.py:718:                \"[OTR_StructuredCall] '%s' attempt %d failed: %s | raw \"\r\nnodes\\_otr_structured_call.py:719:                \"head: %s\", helper_name, attempts_run, exc,\r\nnodes\\_otr_structured_call.py:724:    if attempts_run < max_attempts:\r\nnodes\\_otr_structured_call.py:725:        attempts_run += 1\r\nnodes\\_otr_structured_call.py:727:            \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair at \"\r\nnodes\\_otr_structured_call.py:729:            helper_name, attempts_run, max_attempts, _REPAIR_TEMPERATURE,\r\nnodes\\_otr_structured_call.py:747:            # instance still passes through post_validator so a\r\nnodes\\_otr_structured_call.py:748:            # deterministic \"fix\" that is itself content-invalid fails\r\nnodes\\_otr_structured_call.py:751:                if post_validator is not None:\r\nnodes\\_otr_structured_call.py:752:                    content_error = post_validator(repair_prompt)\r\nnodes\\_otr_structured_call.py:756:                    \"[OTR_StructuredCall] '%s' attempt %d: repair factory \"\r\nnodes\\_otr_structured_call.py:757:                    \"resolved the failure deterministically; no LLM \"\r\nnodes\\_otr_structured_call.py:759:                    helper_name, attempts_run,\r\nnodes\\_otr_structured_call.py:764:                slot_fn, repair_messages,\r\nnodes\\_otr_structured_call.py:768:            return _parse_and_validate(last_raw, schema, post_validator)\r\nnodes\\_otr_structured_call.py:772:                \"[OTR_StructuredCall] '%s' attempt %d (repair) failed: \"\r\nnodes\\_otr_structured_call.py:774:                helper_name, attempts_run, exc, _raw_head(last_raw),\r\nnodes\\_otr_structured_call.py:778:    # so typed repair can be attempt 2 of a three-call budget. If that repair\r\nnodes\\_otr_structured_call.py:784:        attempts_run < max_attempts\r\nnodes\\_otr_structured_call.py:788:        attempts_run += 1\r\nnodes\\_otr_structured_call.py:794:            \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair syntax \"\r\nnodes\\_otr_structured_call.py:796:            helper_name, attempts_run, max_attempts, retry_temperature,\r\nnodes\\_otr_structured_call.py:800:                slot_fn, repair_messages,\r\nnodes\\_otr_structured_call.py:804:            return _parse_and_validate(last_raw, schema, post_validator)\r\nnodes\\_otr_structured_call.py:808:                \"[OTR_StructuredCall] '%s' attempt %d (repair syntax retry) \"\r\nnodes\\_otr_structured_call.py:810:                helper_name, attempts_run, exc, _raw_head(last_raw),\r\nnodes\\_otr_structured_call.py:816:        \"attempt(s); raising StructuredCallFailedError\",\r\nnodes\\_otr_structured_call.py:817:        helper_name, attempts_run,\r\nnodes\\_otr_structured_call.py:821:        attempts=attempts_run,\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
