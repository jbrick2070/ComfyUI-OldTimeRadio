{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$w=Get-Content -Raw '\"'workflows\\\\otr_canonical.json' | ConvertFrom-Json; foreach(\"'$id in 81,82,83){$n=$w.nodes|Where-Object {$_.id -eq $id}; Write-Output ('\"'NODE '+\"'$id+'\"' '+\"'$n.type); foreach($x in $n.inputs){Write-Output (($x.name)+'\"' link='+(\"'$x.link))}; foreach($o in $n.outputs){Write-Output ('\"'OUT '+\"'$o.name+'\"' links='+ ((\"'$o.links)-join '\"','))}}\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
