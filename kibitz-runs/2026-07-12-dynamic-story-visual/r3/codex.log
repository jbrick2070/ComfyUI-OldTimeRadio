override.\"\r\nnodes\\video_engine.py:2101:    def render_video(self, audio, script_json, news_used,\r\nnodes\\video_engine.py:2126:        led = _OTRLC.load_ledger(script_json)\r\nnodes\\video_engine.py:2127:        # FIX3 / BUG-LOCAL-404: the script_json from the freeze cascade is\r\nnodes\\video_engine.py:2234:        # the top of render_video). HUD never re-parses script_json.\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
