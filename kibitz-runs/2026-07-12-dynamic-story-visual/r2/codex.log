"\"\r\n  537:     return {k: dict(v) for k, v in _resolved_models.items()}\r\n  538: \r\n  539: \r\n  540: # ---------------------------------------------------------------------------\r\n  541: # S3 per-run slot bindings -- the slot-picker widget values, demoting env\r\n  542: # ---------------------------------------------------------------------------\r\n  543: #\r\n  544: # The writer records the openrouter_slot_a/b_model widget values here at the\r\n  545: # start of run() (the same single per-episode entry that resets the budget),\r\n===== 1100-1185 =====\r\n 1100: \r\n 1101:     def _account_spend(self, est_tokens: int) -> None:\r\n 1102:         global _run_token_total\r\n 1103:         _run_token_total += int(est_tokens)\r\n 1104:         log.info(\r\n 1105:             \"[OpenRouter] call accounted ~%d tokens (run total ~%d)\",\r\n 1106:             est_tokens, _run_token_total,\r\n 1107:         )\r\n 1108: \r\n 1109:     def _post_with_retries(\r\n 1110:         self, *, base_url: str, api_key: str, payload: dict, slug: str,\r\n 1111:     ) -> str:\r\n 1112:         timeout_s = _int_env(\"OPENROUTER_TIMEOUT_S\", DEFAULT_TIMEOUT_S)\r\n 1113:         max_retries = _int_env(\"OPENROUTER_MAX_RETRIES\", DEFAULT_MAX_RETRIES)\r\n 1114:         last_err: str = \"\"\r\n 1115:         last_status: int = 0\r\n 1116:         last_snippet: str = \"\"\r\n 1117:         for attempt in range(max_retries + 1):\r\n 1118:             try:\r\n 1119:                 result = _post_chat_completion(\r\n 1120:                     base_url=base_url, api_key=api_key,\r\n 1121:                     payload=payload, timeout_s=timeout_s,\r\n 1122:                 )\r\n 1123:             except Exception as exc:  # noqa: BLE001 -- network/transport error\r\n 1124:                 last_err = f\"transport error: {type(exc).__name__}: {exc}\"\r\n 1125:                 last_status, last_snippet = 0, \"\"\r\n 1126:                 log.warning(\r\n 1127:                     \"[OpenRouter] attempt %d/%d failed (%s)\",\r\n 1128:                     attempt + 1, max_retries + 1, last_err,\r\n 1129:                 )\r\n 1130:                 self._sleep_backoff(attempt)\r\n 1131:                 continue\r\n 1132: \r\n 1133:             status = int(result.get(\"status_code\") or 0)\r\n 1134:             if status == 200:\r\n 1135:                 return self._extract_text(result, slug=slug)\r\n 1136: \r\n 1137:             last_snippet = self._error_snippet(result)\r\n 1138:             last_status = status\r\n 1139:             last_err = f\"HTTP {status}: {last_snippet}\"\r\n 1140:             if status in _RETRYABLE_STATUS and attempt < max_retries:\r\n 1141:                 log.warning(\r\n 1142:                     \"[OpenRouter] attempt %d/%d retryable (%s)\",\r\n 1143:                     attempt + 1, max_retries + 1, last_err,\r\n 1144:                 )\r\n 1145:                 self._sleep_backoff(attempt)\r\n 1146:                 continue\r\n 1147:             # Non-retryable (e.g. 400/401/403/404) -> abort now.\r\n 1148:             break\r\n 1149: \r\n 1150:         # A DELETION-class 404 (\"model gone\") is a renderability failure, not a\r\n 1151:         # transient one: raise the distinct subclass so the dispatch layer can\r\n 1152:         # fall over to the slot's REMOTE fallback once (LOUD). Every other\r\n 1153:         # failure stays a plain abort (C5) -- including a bodyless 404.\r\n 1154:         if is_model_gone_error(last_status, last_snippet):\r\n 1155:             raise OpenRouterModelGoneError(\r\n 1156:                 f\"OpenRouter model {slug} is gone (HTTP {last_status}: \"\r\n 1157:                 f\"{last_snippet}).\",\r\n 1158:                 slug=slug,\r\n 1159:             )\r\n 1160:         raise OpenRouterCallFailedError(\r\n 1161:             f\"OpenRouter call to {slug} failed after {max_retries + 1} \"\r\n 1162:             f\"attempt(s): {last_err}. Aborting the run (no mid-episode \"\r\n 1163:             f\"fall-back to local, per C5).\"\r\n 1164:         )\r\n 1165: \r\n 1166:     @staticmethod\r\n 1167:     def _sleep_backoff(attempt: int) -> None:\r\n 1168:         # Short, bounded backoff. Kept tiny so tests stay fast; real\r\n 1169:         # transient recovery does not need long waits here.\r\n 1170:         delay = min(2.0, 0.25 * (2 ** attempt))\r\n 1171:         if delay > 0:\r\n 1172:             time.sleep(delay)\r\n 1173: \r\n 1174:     @staticmethod\r\n 1175:     def _extract_text(result: dict, *, slug: str) -> str:\r\n 1176:         body = result.get(\"json\") or {}\r\n 1177:         if os.environ.get(\"OPENROUTER_DEBUG_RAW\") == \"1\":\r\n 1178:             log.info(\"[OpenRouter] raw %s response: %s\", slug, json.dumps(body)[:1500])\r\n 1179:         # Record the concrete model the upstream actually served (a `~latest`\r\n 1180:         # alias resolves server-side) + its cost, for the episode credits sheet.\r\n 1181:         _record_resolved(slug, body)\r\n 1182:         choices = body.get(\"choices\") or []\r\n 1183:         if not choices:\r\n 1184:             raise OpenRouterCallFailedError(\r\n 1185:                 f\"OpenRouter {slug} returned no choices: \"\r\n===== 1290-1345 =====\r\n 1290: def schema_to_response_format(schema_model: Any, *, name: str = \"otr_schema\") -> dict:\r\n 1291:     \"\"\"Map a Pydantic model class to an OpenRouter\r\n 1292:     ``response_format={type: json_schema, ...}`` payload (S4). Kept here\r\n 1293:     so the remote constrained-generate path mirrors the local\r\n 1294:     `make_constrained_generate_fn(cache_entry, schema_model)` entry.\"\"\"\r\n 1295:     schema_dict = schema_model.model_json_schema()\r\n 1296:     return {\r\n 1297:         \"type\": \"json_schema\",\r\n 1298:         \"json_schema\": {\r\n 1299:             \"name\": name,\r\n 1300:             \"strict\": True,\r\n 1301:             \"schema\": schema_dict,\r\n 1302:         },\r\n 1303:     }\r\n 1304: \r\n 1305: \r\n 1306: def openrouter_meta_for(creative_id: str, technical_id: str) -> dict[str, Any]:\r\n 1307:     \"\"\"Build run-meta remote-LLM provenance (S5).\r\n 1308: \r\n 1309:     For each slot bound to an OpenRouter virtual handle, records the\r\n 1310:     provider, the virtual handle, the RESOLVED slug, and basic params\r\n 1311:     (per-slot max-tokens cap + optional temperature override). Adds a\r\n 1312:     run-level `llm_remote_provider` and `llm_remote_schema_mode` (schema\r\n 1313:     mode = the json_schema response_format path, used when the TECHNICAL\r\n 1314:     slot is remote). Returns ``{}`` when neither slot is remote, so a\r\n 1315:     local run gets no extra meta keys and stays byte-identical (C1).\r\n 1316: \r\n 1317:     The resolved slug is a PUBLIC model id (e.g. \"openai/gpt-4o\"), not a\r\n 1318:     secret -- recording it makes the env-side binding auditable in the\r\n 1319:     run. The API key is never read here and never stamped (C9). Never\r\n 1320:     raises (PD1: provenance must not break a run); an unresolved slug is\r\n 1321:     stamped as \"<unresolved>\" rather than blowing up.\"\"\"\r\n 1322:     meta: dict[str, Any] = {}\r\n 1323:     for slot_name, model_id in ((\"creative\", creative_id), (\"technical\", technical_id)):\r\n 1324:         if not is_openrouter_row_id(model_id):\r\n 1325:             continue\r\n 1326:         try:\r\n 1327:             letter = _slot_letter(model_id)\r\n 1328:             slug, sort = resolve_route(letter, resolve_slug(model_id))\r\n 1329:         except OpenRouterError:\r\n 1330:             letter = \"?\"\r\n 1331:             slug = \"<unresolved>\"\r\n 1332:             sort = None\r\n 1333:         meta[f\"llm_{slot_name}_provider\"] = PROVIDER\r\n 1334:         meta[f\"llm_{slot_name}_handle\"] = model_id\r\n 1335:         meta[f\"llm_{slot_name}_slug\"] = slug\r\n 1336:         meta[f\"llm_{slot_name}_route\"] = sort or \"default\"\r\n 1337:         meta[f\"llm_{slot_name}_max_tokens_cap\"] = _int_env(\r\n 1338:             f\"OPENROUTER_{letter}_MAXTOK\", DEFAULT_MAX_TOKENS_PER_CALL\r\n 1339:         ) if letter != \"?\" else DEFAULT_MAX_TOKENS_PER_CALL\r\n 1340:         meta[f\"llm_{slot_name}_temperature_override\"] = (\r\n 1341:             _float_env(f\"OPENROUTER_{letter}_TEMP\") if letter != \"?\" else None\r\n 1342:         )\r\n 1343:     if meta:\r\n 1344:         meta[\"llm_remote_provider\"] = PROVIDER\r\n 1345:         meta[\"llm_remote_schema_mode\"] = is_openrouter_row_id(technical_id)\r\n","exit_code":0,"status":"completed"}}
