(\"lines\") or []\r\n  183:     if not lines:\r\n  184:         return ledger\r\n  185:     if any(isinstance(ln, dict) and (ln.get(\"dur_s\") or ln.get(\"duration_s\")\r\n  186:            or ln.get(\"samples\") or ln.get(\"audio_samples\")) for ln in lines):\r\n  187:         return ledger                       # input already carries timing\r\n  188:     try:\r\n  189:         import json\r\n  190:         from pathlib import Path\r\n  191:         from . import _otr_ledger as _OL\r\n  192:         roots = []\r\n  193:         try:\r\n  194:             from . import _otr_paths as _OP\r\n  195:             roots.append(Path(_OP.otr_episodes_root()))\r\n  196:         except Exception:                    # noqa: BLE001\r\n  197:             base = os.environ.get(\"OTR_OUTPUT_DIR\") or \".\"\r\n  198:             roots.append(Path(base) / \"otr\" / \"episodes\")\r\n  199:         p = _OL.find_most_recent_ledger(roots)\r\n  200:         if not p:\r\n  201:             return ledger\r\n  202:         disk = json.loads(Path(p).read_text(encoding=\"utf-8\"))\r\n  203:         dmap = {str(dl.get(\"line_id\")): dl for dl in (disk.get(\"lines\") or [])\r\n  204:                 if isinstance(dl, dict) and dl.get(\"line_id\")}\r\n  205:         tkeys = (\"dur_s\", \"duration_s\", \"start_s\", \"samples\", \"audio_samples\", \"sample_rate\")\r\n  206:         for ln in lines:\r\n  207:             if not isinstance(ln, dict):\r\n  208:                 continue\r\n  209:             d = dmap.get(str(ln.get(\"line_id\") or \"\"))\r\n  210:             if not d:\r\n  211:                 continue\r\n  212:             for k in tkeys:\r\n  213:                 if ln.get(k) in (None, \"\") and d.get(k) not in (None, \"\"):\r\n  214:                     ln[k] = d[k]\r\n  215:             for k, v in d.items():\r\n  216:                 if str(k).endswith(\"wav_path\") and v and not ln.get(k):\r\n  217:                     ln[k] = v\r\n  218:         log.info(\"[OTR_ShotLock] audio-timing overlay from %s\", p.name)\r\n  219:     except Exception as exc:                 # noqa: BLE001 - never block the lock\r\n  220:         log.warning(\"[OTR_ShotLock] audio-timing overlay skipped: %s\", exc)\r\n  221:     return ledger\r\n  222: \r\n  223: \r\n  224: def extract_beats(ledger: dict) -> list:\r\n  225:     \"\"\"Ordered, non-skipped beats from the frozen ledger.\r\n  226: \r\n  227:     One beat per ledger line. Each beat carries its video role, char_id, text,\r\n  228:     and whatever audio timing the frozen ledger stamped (samples + sample_rate\r\n  229:     preferred; ``dur_s`` seconds as a fallback). Never raises on a sparse line.\r\n  230:     \"\"\"\r\n===== 260-310 =====\r\n  260:     beats = []\r\n  261:     for i, ln in enumerate(lines):\r\n  262:         if not isinstance(ln, dict):\r\n  263:             continue\r\n  264:         cid = _normalize_char_id(str(ln.get(\"char_id\") or \"\"))\r\n  265:         text = str(ln.get(\"text\") or \"\").strip()\r\n  266:         # Round 5 F4 backstop (warn-only -- the ledger is FROZEN here): a\r\n  267:         # talking-head line that still opens with its own speaker's name as\r\n  268:         # a vocative means the writer's attribution repair missed it; the\r\n  269:         # beat renders with the stamped face, so make the miss LOUD.\r\n  270:         first = id_to_first.get(cid, \"\")\r\n  271:         if (len(first) > 1 and text.lower().startswith(first.lower())\r\n  272:                 and re.match(r\"^\\s*\" + re.escape(first) + r\"\\s*[,!?:;-]\",\r\n  273:                              text, flags=re.IGNORECASE)):\r\n  274:             log.warning(\r\n  275:                 \"[OTR_ShotLock] line %s text opens with its OWN speaker's \"\r\n  276:                 \"name (%s) -- probable mis-attribution shipped from the \"\r\n  277:                 \"writer; the beat renders with char_id=%s's face\",\r\n  278:                 ln.get(\"line_id\"), first, cid)\r\n  279:         beats.append({\r\n  280:             \"beat_id\": str(ln.get(\"line_id\") or f\"beat_{i:04d}\"),\r\n  281:             \"role\": _video_role_for_line(ln),\r\n  282:             \"char_id\": cid,\r\n  283:             \"text\": text,\r\n  284:             \"samples\": ln.get(\"samples\", ln.get(\"audio_samples\")),\r\n  285:             \"sample_rate\": ln.get(\"sample_rate\"),\r\n  286:             \"dur_s\": ln.get(\"dur_s\", ln.get(\"duration_s\")),\r\n  287:         })\r\n  288:     return beats\r\n  289: \r\n  290: \r\n  291: #: The synthetic OPENING-MUSIC beat id (operator look-QA 2026-06-10): the\r\n  292: #: opening theme plays over the episode head (audio starts at first-line\r\n  293: #: start_s, typically ~8-10s in) but no ledger LINE covers that span, so the\r\n  294: #: head fell to the procgen floor. A synthetic music_visual beat gives the\r\n  295: #: open a REAL rendered scene on the music engine (ltx_video in production).\r\n  296: OPENING_MUSIC_BEAT_ID = \"b000_music_open\"\r\n  297: _OPENING_MIN_S = 2.0\r\n  298: \r\n  299: \r\n  300: def derive_opening_music_beat(ledger: dict, fps: int):\r\n  301:     \"\"\"``(beat, frames)`` for the head-gap opening-music scene, or ``(None, 0)``.\r\n  302: \r\n  303:     Reads the FIRST non-skipped line's ``start_s`` from the frozen ledger\r\n  304:     (read-only); a head gap >= 2s earns the synthetic beat. Pure.\"\"\"\r\n  305:     lines = [ln for ln in (ledger or {}).get(\"lines\") or []\r\n  306:              if isinstance(ln, dict) and not ln.get(\"skip\")]\r\n  307:     if not lines:\r\n  308:         return None, 0\r\n  309:     try:\r\n  310:         first_start = float(lines[0].get(\"start_s\") or 0.0)\r\n===== 480-550 =====\r\n  480:         # keep the character on screen -- props/scenery alone lose the face.\r\n  481:         \"If you author a text_prompt, describe the named character as the \"\r\n  482:         \"VISIBLE subject (face-forward, mid-shot or closer); never describe \"\r\n  483:         \"scenery or props without the character.\",\r\n  484:         f\"Setting: {setting}\",\r\n  485:         \"Beats:\",\r\n  486:     ]\r\n  487:     for b in batch:\r\n  488:         appearance = _appearance_for_char(ledger, b[\"char_id\"])\r\n  489:         lines.append(\r\n  490:             json.dumps({\r\n  491:                 \"beat_id\": b[\"beat_id\"],\r\n  492:                 \"character\": appearance[:160],\r\n  493:                 \"line\": b[\"text\"][:240],\r\n  494:             }, ensure_ascii=True)\r\n  495:         )\r\n  496:     return \"\\n\".join(lines)\r\n  497: \r\n  498: \r\n  499: def derive_creative_directives(\r\n  500:     beats: list,\r\n  501:     meta: dict,\r\n  502:     ledger: dict,\r\n  503:     *,\r\n  504:     llm_fn=None,\r\n  505:     batch_size: int = 15,\r\n  506:     max_reseed: int = 2,\r\n  507:     consistency_gate_warn_only: bool = False,\r\n  508: ):\r\n  509:     \"\"\"Derive per-beat creative directives for character-bearing beats.\r\n  510: \r\n  511:     Returns ``(creative_by_beat, warnings)`` where ``creative_by_beat[beat_id]``\r\n  512:     is ``{expression, motion, camera, text_prompt, source, prompt_hash}``.\r\n  513:     Cheap-family beats are skipped entirely (NO llm call). ``llm_fn`` is a\r\n  514:     ``callable(prompt:str) -> str`` (injectable for tests); when None it is\r\n  515:     resolved lazily from the writer's slot and, if unavailable (llm_fn stays\r\n  516:     None), the deterministic template carries every beat -- the legit local lane.\r\n  517:     If an attempted writer LLM yields no usable directive after ``max_reseed``\r\n  518:     reseeds, or authors a prompt that fails the story-consistency gate, the\r\n  519:     deterministic template carries that beat with a loud warning. This is a\r\n  520:     prompt collapse guard, not an engine/model fallback, and it never touches\r\n  521:     frozen audio.\r\n  522:     \"\"\"\r\n  523:     warnings: list = []\r\n  524:     char_beats = [b for b in beats if b[\"role\"] in CHARACTER_BEARING_ROLES]\r\n  525:     if not char_beats:\r\n  526:         return {}, warnings\r\n  527: \r\n  528:     if llm_fn is None:\r\n  529:         llm_fn = _resolve_writer_llm(meta, warnings)\r\n  530: \r\n  531:     setting = _read_setting(meta)\r\n  532:     brief_hash = _content_hash(meta.get(\"story_brief_terms\") or meta.get(\"story_brief\") or {})\r\n  533:     cast_hash = _content_hash(ledger.get(\"cast\") or [])\r\n  534: \r\n  535:     creative: dict = {}\r\n  536:     for start in range(0, len(char_beats), max(1, int(batch_size))):\r\n  537:         batch = char_beats[start:start + max(1, int(batch_size))]\r\n  538:         expected = [b[\"beat_id\"] for b in batch]\r\n  539:         directives: dict = {}\r\n  540:         if llm_fn is not None:\r\n  541:             prompt = _build_batch_prompt(batch, meta, ledger, setting)\r\n  542:             for attempt in range(max_reseed + 1):\r\n  543:                 try:\r\n  544:                     raw = llm_fn(prompt)\r\n  545:                 except Exception as exc:  # noqa: BLE001\r\n  546:                     warnings.append(f\"derivation llm_fn raised ({exc}); reseed {attempt}\")\r\n  547:                     raw = \"\"\r\n  548:                 directives = _parse_directives(raw, expected)\r\n  549:                 # Break only on FULL batch coverage -- a partial reply (e.g. 14\r\n  550:                 # of 15 beats) must spend its remaining reseed budget before\r\n===== 600-705 =====\r\n  600:             # person-anchor detector gates or annotates the prompt. The\r\n  601:             # _subject_anchor prepended below still leads every talking-head prompt\r\n  602:             # with face/framing tokens (prompt COMPOSITION, not analysis), and the\r\n  603:             # operator QAs faces visually. Only the story-consistency gate\r\n  604:             # remains; by default an inconsistent AI prompt drops to the\r\n  605:             # deterministic collapse guard, while consistency_gate_warn_only\r\n  606:             # keeps the AI prompt.\r\n  607:             if not _prompt_is_consistent(text_prompt, appearance, setting):\r\n  608:                 msg = (f\"consistency gate for beat {b['beat_id']}: prompt missing \"\r\n  609:                        f\"cast/setting trait\")\r\n  610:                 if consistency_gate_warn_only or source != \"llm\":\r\n  611:                     warnings.append(msg + \" (kept; warn-only or template path)\")\r\n  612:                 else:\r\n  613:                     warnings.append(\r\n  614:                         msg + \"; using deterministic template collapse guard\")\r\n  615:                     text_prompt = _deterministic_template(\r\n  616:                         appearance, setting, b[\"text\"])\r\n  617:                     source = \"template_after_consistency_miss\"\r\n  618:             # The subject anchor leads EVERY talking-head prompt path (llm,\r\n  619:             # composed, template): face/framing tokens first, bounded\r\n  620:             # appearance after -- prepended AFTER the gates, BEFORE finishing.\r\n  621:             text_prompt = f\"{_subject_anchor(appearance)}, {text_prompt}\"\r\n  622:             # FINISH the prompt (gap-audit F3, 2026-06-10): era tail (brief\r\n  623:             # atmosphere/palette/lighting) + the film style tail, restored\r\n  624:             # from the deleted legacy composer. MUST run after the\r\n  625:             # consistency gate and BEFORE prompt_hash so the stored hash\r\n  626:             # matches the rendered prompt. Fail-soft.\r\n  627:             try:\r\n  628:                 try:\r\n  629:                     from ._otr_story_brief_helpers import (  # type: ignore\r\n  630:                         finish_visual_prompt)\r\n  631:                 except ImportError:  # pragma: no cover -- flat test imports\r\n  632:                     from _otr_story_brief_helpers import (  # type: ignore\r\n  633:                         finish_visual_prompt)\r\n  634:                 text_prompt = finish_visual_prompt(meta, text_prompt)\r\n  635:             except Exception:  # noqa: BLE001\r\n  636:                 pass\r\n  637:             creative[b[\"beat_id\"]] = {\r\n  638:                 \"expression\": d.get(\"expression\", \"\"),\r\n  639:                 \"motion\": d.get(\"motion\", \"\"),\r\n  640:                 \"camera\": d.get(\"camera\", \"\"),\r\n  641:                 \"text_prompt\": text_prompt,\r\n  642:                 \"source\": source,\r\n  643:                 \"request_hash\": _content_hash(\r\n  644:                     [brief_hash, cast_hash, b[\"beat_id\"], b[\"char_id\"]]\r\n  645:                 ),\r\n  646:                 \"prompt_hash\": _content_hash(text_prompt),\r\n  647:             }\r\n  648:     return creative, warnings\r\n  649: \r\n  650: \r\n  651: def _resolve_writer_llm(meta: dict, warnings: list):\r\n  652:     \"\"\"Best-effort writer-slot LLM resolver (V-11: no new model_id widget --\r\n  653:     the model name comes from the ledger meta the writer stamped). Returns a\r\n  654:     ``callable(prompt)->str`` or None. Fails soft to None in headless/test mode\r\n  655:     so the deterministic template carries the episode (the live wiring lands\r\n  656:     with the M4 GPU gate before CW-6).\"\"\"\r\n  657:     import os\r\n  658: \r\n  659:     if os.environ.get(\"OTR_TEST_MODE\") == \"1\":\r\n  660:         return None\r\n  661:     model_id = \"\"\r\n  662:     if isinstance(meta, dict):\r\n  663:         model_id = str(\r\n  664:             meta.get(\"technical_model\") or meta.get(\"creative_writing_model\") or \"\"\r\n  665:         )\r\n  666:     if not model_id:\r\n  667:         warnings.append(\"no writer model in meta; creative derivation uses template\")\r\n  668:         return None\r\n  669:     try:  # lazy: never import the loader at module scope (V-12)\r\n  670:         # FIXED 2026-06-10 (operator look-QA root cause): this called\r\n  671:         # make_generate_fn(model_id, slot=...) -- a signature that never\r\n  672:         # existed -- so the LLM path failed on EVERY live run and the\r\n  673:         # deterministic template silently carried all creative/image\r\n  674:         # derivation. The real seam is request_slot(slot, model_id) ->\r\n  675:         # cache entry (a same-model call is a cache HIT, no reload) ->\r\n  676:         # make_generate_fn(entry) -> gen(messages, ...).\r\n  677:         from ._otr_model_loader import make_generate_fn, request_slot  # type: ignore\r\n  678:         # Post-ship audit fix (2026-07-10): same policy the writer ran\r\n  679:         # under (ledger stamp); None = pre-stamp backstop.\r\n  680:         from ._otr_shared.llm_policy import policy_from_meta\r\n  681: \r\n  682:         entry = request_slot(  # LLM slot: technical\r\n  683:             \"technical\", model_id,\r\n  684:             policy=policy_from_meta(meta))\r\n  685:         gen = make_generate_fn(entry)\r\n  686: \r\n  687:         def _call(prompt: str) -> str:\r\n  688:             # 0.1 not 0.0: the local HF lane hardcodes do_sample=True and\r\n  689:             # transformers rejects a non-positive temperature (live 30w4\r\n  690:             # catch); 0.1 is near-greedy for short derivation prompts.\r\n  691:             return gen([{\"role\": \"user\", \"content\": str(prompt)}],\r\n  692:                        temperature=0.1, max_new_tokens=300)\r\n  693: \r\n  694:         return _call\r\n  695:     except Exception as exc:  # noqa: BLE001\r\n  696:         warnings.append(f\"writer LLM unavailable ({exc}); derivation uses template\")\r\n  697:         return None\r\n  698: \r\n  699: \r\n  700: # ---------------------------------------------------------------------------\r\n  701: # Execution plan (groups + shots) -> ledger['video']\r\n  702: # ---------------------------------------------------------------------------\r\n  703: \r\n  704: \r\n  705: def _assert_family_inputs_satisfiable_cast_time(engine_name, beat, ledger, policy):\r\n===== 940-1050 =====\r\n  940:             # cache_keys EXCLUDE expression on purpose (V-7 / PASS-M4): the\r\n  941:             # expression is a driver-channel directive, not part of identity.\r\n  942:             \"cache_keys\": {\r\n  943:                 \"prompt_hash\": cre.get(\"prompt_hash\", \"\"),\r\n  944:                 \"request_hash\": cre.get(\"request_hash\", \"\"),\r\n  945:             },\r\n  946:             \"degradation_trail\": [],\r\n  947:             \"creative\": {k: v for k, v in cre.items() if k != \"request_hash\"},\r\n  948:         })\r\n  949:     return groups, shots\r\n  950: \r\n  951: \r\n  952: # ---------------------------------------------------------------------------\r\n  953: # The node\r\n  954: # ---------------------------------------------------------------------------\r\n  955: \r\n  956: \r\n  957: class OTRShotLock:\r\n  958:     \"\"\"Registered as ``OTR_ShotLock``. Single ``ledger['video']`` authority.\"\"\"\r\n  959: \r\n  960:     CATEGORY = \"OldTimeRadio/v2/video\"\r\n  961:     FUNCTION = \"lock\"\r\n  962:     # episode_id output is ADDITIVE (still-spine ST-6 / DS-3): ShotLock holds\r\n  963:     # the audio-overlaid ledger, so it is the in-graph episode_id authority;\r\n  964:     # the saved json wires it into OTR_ImageGenDispatcher.episode_id so every\r\n  965:     # still lands in episodes/<ep>/stills/. Existing slot indexes unchanged.\r\n  966:     RETURN_TYPES = (\"STRING\", \"INT\", \"STRING\", \"STRING\", \"STRING\")\r\n  967:     RETURN_NAMES = (\"patched_ledger_json\", \"video_revision\", \"shot_report\",\r\n  968:                     \"done\", \"episode_id\")\r\n  969:     OUTPUT_NODE = False\r\n  970: \r\n  971:     @classmethod\r\n  972:     def INPUT_TYPES(cls):\r\n  973:         return {\r\n  974:             \"required\": {\r\n  975:                 \"script_json\": (\"STRING\", {\r\n  976:                     \"multiline\": True,\r\n  977:                     \"default\": \"{}\",\r\n  978:                     \"forceInput\": True,\r\n  979:                     \"tooltip\": (\r\n  980:                         \"Frozen ledger JSON (OTR_LedgerFreezeCascade out1 \"\r\n  981:                         \"script_json). ShotLock stamps a video section into it.\"\r\n  982:                     ),\r\n  983:                 }),\r\n  984:                 \"audio_done\": (\"STRING\", {\r\n  985:                     \"multiline\": True,\r\n  986:                     \"default\": \"\",\r\n  987:                     \"forceInput\": True,\r\n  988:                     \"tooltip\": (\r\n  989:                         \"Audio-done gate (OTR_EpisodeAssembler out3). Wiring it \"\r\n  990:                         \"orders ShotLock AFTER audio timing freezes so the clip \"\r\n  991:                         \"budget is bound against the real timeline. Opaque STRING.\"\r\n  992:                     ),\r\n  993:                 }),\r\n  994:                 \"video_policy_json\": (\"STRING\", {\r\n  995:                     \"multiline\": True,\r\n  996:                     \"default\": \"{}\",\r\n  997:                     \"forceInput\": True,\r\n  998:                     \"tooltip\": \"Per-role selection policy from OTR_VideoDirector.\",\r\n  999:                 }),\r\n 1000:             },\r\n 1001:             \"optional\": {\r\n 1002:                 \"image_done\": (\"STRING\", {\r\n 1003:                     \"multiline\": True,\r\n 1004:                     \"default\": \"\",\r\n 1005:                     \"forceInput\": True,\r\n 1006:                     \"tooltip\": (\r\n 1007:                         \"Image-done gate (mirrors audio_done). Declared to \"\r\n 1008:                         \"freeze the image-before-video contract; NON-BLOCKING \"\r\n 1009:                         \"in v1 (Flux gen-1 runs in-process, nothing emits it \"\r\n 1010:                         \"yet; C1 wires the emitter). Opaque STRING.\"\r\n 1011:                     ),\r\n 1012:                 }),\r\n 1013:                 \"consistency_gate_warn_only\": (\"BOOLEAN\", {\r\n 1014:                     \"default\": False,\r\n 1015:                     \"tooltip\": (\r\n 1016:                         \"M4 story-consistency gate. Default: an inconsistent \"\r\n 1017:                         \"writer-LLM prompt is replaced by the deterministic \"\r\n 1018:                         \"template collapse guard with a loud warning. warn-only: \"\r\n 1019:                         \"keep the AI prompt and log the miss.\"\r\n 1020:                     ),\r\n 1021:                 }),\r\n 1022:                 \"gate_in\": (\"STRING\", {\r\n 1023:                     \"multiline\": True,\r\n 1024:                     \"default\": \"\",\r\n 1025:                     \"forceInput\": True,\r\n 1026:                     \"tooltip\": \"Optional ordering signal (opaque STRING).\",\r\n 1027:                 }),\r\n 1028:             },\r\n 1029:         }\r\n 1030: \r\n 1031:     @classmethod\r\n 1032:     def VALIDATE_INPUTS(cls, **kwargs):\r\n 1033:         return True\r\n 1034: \r\n 1035:     # ------------------------------------------------------------------ #\r\n 1036:     def lock(self, script_json, audio_done=\"\", video_policy_json=\"{}\",\r\n 1037:              image_done=\"\", consistency_gate_warn_only=False, gate_in=\"\"):\r\n 1038:         from . import _otr_ledger_consumers as _OTRLC\r\n 1039: \r\n 1040:         led = _OTRLC.load_ledger(script_json)\r\n 1041:         led = overlay_audio_timing(led)     # fill per-line timing from the post-audio disk ledger\r\n 1042:         meta = led.get(\"meta\")\r\n 1043:         if not isinstance(meta, dict):\r\n 1044:             meta = {}\r\n 1045:             led[\"meta\"] = meta\r\n 1046:         try:\r\n 1047:             policy = json.loads(video_policy_json or \"{}\")\r\n 1048:             if not isinstance(policy, dict):\r\n 1049:                 policy = {}\r\n 1050:         except (ValueError, TypeError):\r\n===== 1030-1150 =====\r\n 1030: \r\n 1031:     @classmethod\r\n 1032:     def VALIDATE_INPUTS(cls, **kwargs):\r\n 1033:         return True\r\n 1034: \r\n 1035:     # ------------------------------------------------------------------ #\r\n 1036:     def lock(self, script_json, audio_done=\"\", video_policy_json=\"{}\",\r\n 1037:              image_done=\"\", consistency_gate_warn_only=False, gate_in=\"\"):\r\n 1038:         from . import _otr_ledger_consumers as _OTRLC\r\n 1039: \r\n 1040:         led = _OTRLC.load_ledger(script_json)\r\n 1041:         led = overlay_audio_timing(led)     # fill per-line timing from the post-audio disk ledger\r\n 1042:         meta = led.get(\"meta\")\r\n 1043:         if not isinstance(meta, dict):\r\n 1044:             meta = {}\r\n 1045:             led[\"meta\"] = meta\r\n 1046:         try:\r\n 1047:             policy = json.loads(video_policy_json or \"{}\")\r\n 1048:             if not isinstance(policy, dict):\r\n 1049:                 policy = {}\r\n 1050:         except (ValueError, TypeError):\r\n 1051:             policy = {}\r\n 1052: \r\n 1053:         # S4 platform-portability (2026-07-10): a NON-EMPTY policy must be\r\n 1054:         # version 2 (device_policy/dtype_policy present). A v1 policy here\r\n 1055:         # means a stale OTR_VideoDirector emitted it -- fail LOUD before\r\n 1056:         # any render work burns on it.\r\n 1057:         if policy and int(policy.get(\"policy_version\") or 0) != 2:\r\n 1058:             raise ValueError(\r\n 1059:                 \"OTR_ShotLock: video_policy_json carries policy_version=\"\r\n 1060:                 f\"{policy.get('policy_version')!r}; expected 2. Re-run \"\r\n 1061:                 \"OTR_VideoDirector (stale/hand-crafted policy).\")\r\n 1062: \r\n 1063:         canvas = (policy.get(\"canvas\") or {})\r\n 1064:         fps = int(canvas.get(\"fps\") or 25)\r\n 1065:         report: list = []\r\n 1066:         warnings: list = []\r\n 1067: \r\n 1068:         # Brief disposition, ONCE per run (gap-audit G4 restore).\r\n 1069:         try:\r\n 1070:             try:\r\n 1071:                 from ._otr_story_brief_helpers import (  # type: ignore\r\n 1072:                     log_story_brief_disposition)\r\n 1073:             except ImportError:  # pragma: no cover\r\n 1074:                 from _otr_story_brief_helpers import (  # type: ignore\r\n 1075:                     log_story_brief_disposition)\r\n 1076:             log_story_brief_disposition(meta, \"shotlock_m4\", log)\r\n 1077:         except Exception:  # noqa: BLE001\r\n 1078:             pass\r\n 1079: \r\n 1080:         beats = extract_beats(led)\r\n 1081:         budget = compute_clip_budget(beats, policy, fps)\r\n 1082:         warnings.extend(budget.get(\"warnings\", []))\r\n 1083: \r\n 1084:         # The OPENING-MUSIC scene (operator look-QA 2026-06-10): injected\r\n 1085:         # AFTER the budget so the real beats keep their exact cumulative-\r\n 1086:         # samples frame math; the synthetic head beat adds its own frames.\r\n 1087:         _open_beat, _open_frames = derive_opening_music_beat(led, fps)\r\n 1088:         if _open_beat is not None and _open_frames > 0:\r\n 1089:             beats.insert(0, _open_beat)\r\n 1090:             budget[\"per_beat\"][OPENING_MUSIC_BEAT_ID] = _open_frames\r\n 1091:             budget[\"total_frames\"] = int(budget.get(\"total_frames\") or 0) \\\r\n 1092:                 + _open_frames\r\n 1093:             report.append(\r\n 1094:                 \"opening-music scene injected: %d frames (head 0..%.2fs) on \"\r\n 1095:                 \"the music_visual engine\" % (_open_frames,\r\n 1096:                                              _open_frames / max(1, fps)))\r\n 1097: \r\n 1098:         creative, cre_warn = derive_creative_directives(\r\n 1099:             beats, meta, led,\r\n 1100:             consistency_gate_warn_only=bool(consistency_gate_warn_only),\r\n 1101:         )\r\n 1102:         warnings.extend(cre_warn)\r\n 1103: \r\n 1104:         groups, shots = build_execution_plan(beats, budget, creative, policy, led)\r\n 1105: \r\n 1106:         revision = int(meta.get(\"video_revision\") or 0) + 1\r\n 1107:         video_section = {\r\n 1108:             \"video_revision\": revision,\r\n 1109:             # S4: the v2 policy stamps ride the ledger so render_driver\r\n 1110:             # (and every adapter's assert_usable) sees the SAME device/\r\n 1111:             # dtype truth the directors emitted. Defaults = nv50 baseline\r\n 1112:             # (tolerates an empty policy in unit fixtures).\r\n 1113:             \"policy_version\": 2,\r\n 1114:             \"device_policy\": str(policy.get(\"device_policy\") or \"cuda\"),\r\n 1115:             \"dtype_policy\": str(policy.get(\"dtype_policy\") or \"fp8_ok\"),\r\n 1116:             \"canonical_canvas\": {\r\n 1117:                 \"w\": int(canvas.get(\"w\") or 832),\r\n 1118:                 \"h\": int(canvas.get(\"h\") or 480),\r\n 1119:             },\r\n 1120:             \"fps\": fps,\r\n 1121:             \"locked_against_audio_rev\": str(meta.get(\"audio_revision\") or \"\"),\r\n 1122:             \"execution_groups\": groups,\r\n 1123:             \"roles\": policy.get(\"video_models\") or {},\r\n 1124:             \"shots\": shots,\r\n 1125:             \"clip_budget\": {\r\n 1126:                 \"total_frames\": budget[\"total_frames\"],\r\n 1127:             },\r\n 1128:             \"warnings\": warnings,\r\n 1129:         }\r\n 1130:         led[\"video\"] = video_section\r\n 1131:         meta[\"video_revision\"] = revision\r\n 1132: \r\n 1133:         report.append(f\"shot_lock_revision={revision} beats={len(beats)} shots={len(shots)}\")\r\n 1134:         report.append(\r\n 1135:             f\"clip_budget: total_frames={budget['total_frames']}\"\r\n 1136:         )\r\n 1137:         report.append(f\"execution_groups={[g['group_id'] for g in groups]}\")\r\n 1138:         for w in warnings:\r\n 1139:             report.append(f\"WARN: {w}\")\r\n 1140:             log.warning(\"[OTR_ShotLock] %s\", w)\r\n 1141: \r\n 1142:         patched = json.dumps(led, ensure_ascii=True, separators=(\",\", \":\"))\r\n 1143:         done = f\"shot_lock:done:rev={revision}\"\r\n 1144:         episode_id = str(led.get(\"episode_id\")\r\n 1145:                          or (led.get(\"meta\") or {}).get(\"episode_id\") or \"\")\r\n 1146:         return (patched, int(revision), \"\\n\".join(report), done, episode_id)\r\n 1147: \r\n 1148: \r\n 1149: \r\n 1150: \r\n","exit_code":0,"status":"completed"}}
