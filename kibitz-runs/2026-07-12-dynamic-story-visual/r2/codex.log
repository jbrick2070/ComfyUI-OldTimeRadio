tr_meta_brief_image_prompt\", \"OTRMetaBriefImagePromptGen\", \" Meta-Brief Image Prompt Gen\"),\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:329: # of truth in nodes/_otr_class_registry.new_node_modules_table(), and ONLY for\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:337: new_node_modules_table as _otr_new_audio_table,\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:344: _NODE_MODULES[_otr_key] = _otr_value\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:351: for node_name, (module_path, class_name, display_name) in _NODE_MODULES.items():\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:362: NODE_CLASS_MAPPINGS[node_name] = cls\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:363: NODE_DISPLAY_NAME_MAPPINGS[node_name] = display_name\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:378: _loaded = sum(1 for k in NODE_CLASS_MAPPINGS if k.startswith(\"OTR_\"))\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:379: _total = len(_NODE_MODULES)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:462: # In-process == NODE_CLASS_MAPPINGS is populated, so the heavy engine forwards\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:556: \"NODE_CLASS_MAPPINGS\",\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\__init__.py:557: \"NODE_DISPLAY_NAME_MAPPINGS\",\r\n===== 150-280 =====\r\n 150:     # meta.style directly from the L3 ledger stamped by the writer.\r\n 151:     # The deleted Director class + registration + workflow node +\r\n 152:     # workflow links 17 + 38 all delete in lockstep. See:\r\n 153:     #   docs/voice-path-cleanbreak-execution-plan.md Sprint 2\r\n 154:     #   docs/2026-05-12-voice-path-cleanbreak-qa.md A\u00153 + Q3\r\n 155:     #\r\n 156:     # Voice-path-cleanbreak 2026-05-12 (P3): the legacy single-line\r\n 157:     # nodes OTR_BarkTTS / OTR_SFXGenerator / OTR_VoiceRender plus the\r\n 158:     # pre-L3 parser-list reader OTR_BatchKokoroGenerator are deleted.\r\n 159:     # Their registrations are removed in lockstep with the file deletes.\r\n 160:     \"OTR_SceneSequencer\":     (\".nodes.scene_sequencer\",     \"SceneSequencer\",       \" Scene Sequencer\"),\r\n 161:     \"OTR_EpisodeAssembler\":   (\".nodes.scene_sequencer\",     \"EpisodeAssembler\",     \" Episode Assembler\"),\r\n 162:     \"OTR_AudioEnhance\":       (\".nodes.audio_enhance\",       \"AudioEnhance\",         \" Spatial Audio Enhance\"),\r\n 163:     \"OTR_SignalLostVideo\":    (\".nodes.video_engine\",          \"SignalLostVideoRenderer\", \" Signal Lost Video\"),\r\n 164:     \"OTR_ProjectStateLoader\": (\".nodes.project_state\",         \"ProjectStateLoader\",      \" Project State Loader\"),\r\n 165:     \"OTR_VRAMGuardian\":       (\".nodes.vram_guardian\",          \"VRAMGuardian\",            \" VRAM Guardian\"),\r\n 166:     \"OTR_VRAMContextTest\":    (\".nodes.vram_context_test\",     \"VRAMContextTest\",         \" VRAM Context Test (diagnostics)\"),\r\n 167:     # v2.0 Visual Generation Trio\r\n 168:     # Sidecar-isolated visual (stills/portraits/motion) generation from\r\n 169:     # the L3 ledger (replaces the legacy OTR Director output the visual\r\n 170:     # bridge used to read). Audio path NEVER touched. Falls back to\r\n 171:     # OTR_SignalLostVideo on failure.  See docs/OTR_PIPELINE_EXPLAINER.md\r\n 172:     \"OTR_VisualBridge\":         (\".visual.bridge\",            \"VisualBridge\",         \" Visual Bridge\"),\r\n 173:     \"OTR_VisualPoll\":           (\".visual.poll\",              \"VisualPoll\",           \" Visual Poll\"),\r\n 174:     \"OTR_VisualRenderer\":       (\".visual.renderer\",          \"VisualRenderer\",       \" Visual Renderer\"),\r\n 175:     \"OTR_VisualPromptCoercion\": (\".visual.prompt_coercion\",   \"VisualPromptCoercion\", \" Visual Prompt Coercion\"),\r\n 176:     # S30 B5 (2026-05-14): OTR_VisualLLMSelector node + visual/llm_selector.py\r\n 177:     # DELETED. The visual-polish path now consumes the writer's broadcast\r\n 178:     # `creative_writing_model` socket directly (the selector was a\r\n 179:     # redundant local model picker that duplicated the writer's surface).\r\n 180:     # visual/llm_polish.py's _POLISH_CACHE module-level dict + _load_model()\r\n 181:     # function were collapsed into the modern _otr_model_loader.LLM_CACHE\r\n 182:     # in the same commit (Prime Directive 2: never double-load\r\n 183:     # Mistral-Nemo on the 16 GB card).\r\n 184:     \"OTR_VisualExtractFluxPrompt\": (\".visual.flux_prompt_extractor\", \"VisualExtractFluxPrompt\", \" Visual Extract FLUX Prompt\"),\r\n 185:     # OTR_FluxBranchGate -- DELETED in the Chunk E cleanbreak completion\r\n 186:     # (2026-06-09). The Sprint H 3.7 FLUX topology gate only sequenced the\r\n 187:     # legacy FLUX batch chain (deleted in the CW cleanbreak); the platform\r\n 188:     # image gate (OTR_ImageGenDispatcher) is ordered by audio_done +\r\n 189:     # script_json edges instead. Tombstoned in DELETED_NODE_TYPES.\r\n 190:     # OTR_DeferredCheckpointLoader + OTR_DeferredLtxTextEncoderLoader --\r\n 191:     # DELETED in the Chunk E cleanbreak completion (2026-06-09). V-5: ALL\r\n 192:     # model loading is adapter-internal (comfy model_management); no\r\n 193:     # deferred-loader shell nodes survive. Their only consumers were the\r\n 194:     # deleted legacy FLUX/LTX batch chains. Tombstoned in\r\n 195:     # DELETED_NODE_TYPES; the Sprint H finding they encoded (executor\r\n 196:     # pre-loads loaders at graph-start regardless of downstream gates)\r\n 197:     # lives on in the adapters' lazy in-execute loading.\r\n 198:     # OTR_VideoPlan -- DELETED in CW-1 (2026-06-06) of the OTR video platform\r\n 199:     # build. Its prompt-generation + planning was absorbed by OTR_ShotLock\r\n 200:     # (M4 per-beat creative derivation). The legacy FLUX/HuMo/LTX render chain\r\n 201:     # it fed was unwired from otr_canonical.json in the same commit; the\r\n 202:     # type is in the workflow validator's DELETED_NODE_TYPES sentinel so a\r\n 203:     # stale workflow referencing it fails loudly (must be re-saved).\r\n 204:     # OTR_FixedShotDurationStub -- registration REMOVED in the Chunk E\r\n 205:     # cleanbreak completion (2026-06-09; the module-level mapping was\r\n 206:     # already cleared 2026-06-08). OTR_ShotLock owns ALL per-episode\r\n 207:     # budget / shot-duration logic. The class + pure helpers stay in\r\n 208:     # nodes/otr_shot_duration_calculator.py for unit tests only; the type\r\n 209:     # is tombstoned in DELETED_NODE_TYPES so stale workflow JSONs fail\r\n 210:     # loudly at validation.\r\n 211:     # OTR_PostAudioVideoPipeline -- DELETED S27 (commit lands in s27-\r\n 212:     # cleanbreak-tail). The class was a subprocess trigger for the\r\n 213:     # pre-2026-04-27 HuMo batch + concat pipeline; it was superseded\r\n 214:     # in-graph by OTR_BatchHumoRender + OTR_VideoComposite. S26 kept\r\n 215:     # the registration \"so any old workflow JSON that still references\r\n 216:     # it loads without error\" -- exactly the back-compat-for-old-data\r\n 217:     # pattern S27 was authorized to delete. Old workflow JSONs that\r\n 218:     # still name the type now fail to load loudly via the workflow\r\n 219:     # validator's DELETED_NODE_TYPES sentinel; they must be re-saved.\r\n 220:     # S26 Sprint 3 (T1.2): opt-in execution-time workflow contract\r\n 221:     # validator. Reads the workflow JSON from disk and runs the same\r\n 222:     # validate_workflow_contract check the S16.6 CI test runs. Place\r\n 223:     # as the first node in a workflow to catch contract drift at queue\r\n 224:     # time. ADR: docs/2026-05-13-S14_2-active-validation-ADR.md.\r\n 225:     \"OTR_WorkflowValidator\":       (\".nodes._otr_workflow_validator\", \"WorkflowValidator\", \" Workflow Validator (opt-in, S14.2)\"),\r\n 226:     # OTR_HuMoTierLoader -- DELETED in the CW cleanbreak (2026-06-08): it only\r\n 227:     # fed the now-removed OTR_BatchHumoRender; the in-process HuMo adapter\r\n 228:     # (nodes/_otr_video_engines/eng_humo.py) loads its own stack. Tombstoned in\r\n 229:     # the workflow validator's DELETED_NODE_TYPES.\r\n 230:     # OTR_VideoComposite -- DELETED (CW-4 legacy render-path teardown,\r\n 231:     # 2026-06-07). The legacy episode compositor mixed audio inside the\r\n 232:     # graph (master_mix / per-clip-mux / humo_concat) and used\r\n 233:     # ffmpeg `-shortest`, which the frozen-audio spine forbids. The new\r\n 234:     # render path is SignalLostVideo -> OTR_SilentComposite (always\r\n 235:     # silent, no audio) -> OTR_MasterAudioMux (terminal, -c:a copy, NO\r\n 236:     # -shortest, byte-identical master). The type is tombstoned in the\r\n 237:     # workflow validator's DELETED_NODE_TYPES so any stale workflow JSON\r\n 238:     # naming it fails loudly at validation; such graphs must be re-saved.\r\n 239:     # v2.0 final-stage RTX VSR upscaler. Path-in / path-out wrapper around\r\n 240:     # NVIDIA's RTXVideoSuperResolution that preserves C7 audio identity:\r\n 241:     # decodes video frames in chunks via ffmpeg pipe, runs nvvfx HW-accel\r\n 242:     # upscale, encodes silent libx264 yuv420p, then muxes the original mp4\r\n 243:     # audio with -c:a copy (zero audio re-encode). Bypassable via the\r\n 244:     # `bypass` widget for raw 832x480 deliverables.\r\n 245:     \"OTR_RTXUpscale\":              (\".nodes.rtx_upscale\", \"RTXUpscale\", \" RTX VSR Upscale (1080p)\"),\r\n 246:     # BUG-LOCAL-028 fix (2026-05-03): per-episode-aware image save sink.\r\n 247:     # Replaces stock SaveImage nodes whose hardcoded filename_prefix\r\n 248:     # couldn't track the in-flight episode_id. Reads the Ledger singleton\r\n 249:     # at runtime and routes images to output/otr/episodes/<ep>/stills/\r\n 250:     # or .../portraits/. Falls back to legacy flat dirs in headless/test.\r\n 251:     \"OTR_SaveToEpisodeWorkspace\":  (\".nodes.otr_save_to_episode_workspace\", \"SaveToEpisodeWorkspace\", \" Save to Episode Workspace (FLUX stills/portraits)\"),\r\n 252:     # BUG-LOCAL-030 Phase B (2026-05-03 EVENING): post-RTXUpscale procgen\r\n 253:     # visual blend. Overlays 1920x1080 native procgen on the upscaled\r\n 254:     # HuMo + LTX composite at delivery res. Audio passes through with\r\n 255:     # -c:a copy so C7 byte-identity holds end-to-end. Fills the visible\r\n 256:     # HuMo black pillarbox bars from Phase A simple-pillarbox composite\r\n 257:     # with the SIGNAL LOST CRT signature (audio-reactive scanlines +\r\n 258:     # flicker over the otherwise-static black surround).\r\n 259:     \"OTR_PostUpscaleProcgenBlend\": (\".nodes.otr_post_upscale_procgen_blend\", \"PostUpscaleProcgenBlend\", \" Post-Upscale Procgen Blend (1080p)\"),\r\n 260:     # A\u00154D v2 scene-aware scopes: a late, additive node that draws GREEN-ONLY\r\n 261:     # audio-reactive scopes into the REAL per-beat gutters (read from the clip\r\n 262:     # manifest), screened+lightened over the upscaled video by the blend's 3rd\r\n 263:     # input. The floor keeps its full v1 video; only draw_scopes=False turns its\r\n 264:     # in-frame scopes off so they don't double.\r\n 265:     \"OTR_SceneAwareScopes\": (\".nodes.otr_scene_aware_scopes\", \"SceneAwareScopes\", \" Scene-Aware Scopes (v2)\"),\r\n 266: \r\n 267:     # =========================================================================\r\n 268:     # OTR Open Video Model Platform -- A-Seam core (CW-1, 2026-06-06).\r\n 269:     # Model-agnostic, per-role video model selection; NO model is \"primary\".\r\n 270:     # Additive shell: VideoProbe (usable engines + host caps) -> VideoDirector\r\n 271:     # (per-role A/B/C model + image selectors, Other-Beats clip mode) ->\r\n 272:     # ShotLock (audio-derived clip budget + DAG-validated execution_groups +\r\n 273:     # M4 per-beat creative derivation; supersedes OTR_VideoPlan). Concrete\r\n 274:     # engine adapters + the render path land in later windows.\r\n 275:     # =========================================================================\r\n 276:     \"OTR_VideoProbe\":              (\".nodes.otr_video_probe\",    \"OTRVideoProbe\",    \" Video Probe (usable engines + host caps)\"),\r\n 277:     \"OTR_VideoDirector\":           (\".nodes.otr_video_director\", \"OTRVideoDirector\", \" VideoDirector (per-role model select)\"),\r\n 278:     \"OTR_ShotLock\":                (\".nodes.otr_shot_lock\",      \"OTRShotLock\",      \" Shot Lock (video plan authority)\"),\r\n 279: \r\n 280:     # =========================================================================\r\n===== 300-390 =====\r\n 300:     \"OTR_SilentComposite\":         (\".nodes.otr_silent_composite\",   \"OTRSilentComposite\",   \" SilentComposite (render -> one always-silent video)\"),\r\n 301:     \"OTR_CaptionBurn\":             (\".nodes.otr_caption_burn\",       \"OTRCaptionBurn\",       \" CaptionBurn (SDH open captions on the silent video; default-OFF)\"),\r\n 302:     \"OTR_MasterAudioMux\":          (\".nodes.otr_master_audio_mux\",   \"OTRMasterAudioMux\",    \" MasterAudioMux (terminal mux-LAST, -c:a copy)\"),\r\n 303: \r\n 304:     # =========================================================================\r\n 305:     # v2.0 in-process render driver (A-S7.5) -- the model-agnostic render entry\r\n 306:     # that walks the registry engines (prepare->render_clip->canonicalize->\r\n 307:     # teardown) with the A-S7 retry taxonomy + fallback chain + LOUD restamp.\r\n 308:     # \"soak\" mode is the A-ship full-episode gate; \"single\" validates one\r\n 309:     # engine's in-process forward. No model is \"primary\". See\r\n 310:     # nodes/_otr_video_engines/render_driver.py.\r\n 311:     # =========================================================================\r\n 312:     \"OTR_VideoRenderBatch\":        (\".nodes.otr_video_render_batch\", \"OTRVideoRenderBatch\", \" Video Render Batch (A-S7.5 in-process render)\"),\r\n 313: \r\n 314:     # =========================================================================\r\n 315:     # v2.0 late viewer-credits surface (credits enrichment 2026-07-03). Renders\r\n 316:     # the ONE unified credits roll LATE (after nodes 91/92) from the durable\r\n 317:     # ledger stamps (S2) + the clip manifest, appends it as a SILENT tail to\r\n 318:     # node 93's output, and declares its tail duration to the mux (credits-aware\r\n 319:     # guard). Wired 93 -> OTR_CreditsRoll -> 85; no fallbacks (missing receipt\r\n 320:     # RAISES). See nodes/otr_credits_roll.py + GO_FORWARD_CREDITS.md.\r\n 321:     # =========================================================================\r\n 322:     \"OTR_CreditsRoll\":             (\".nodes.otr_credits_roll\",       \"OTRCreditsRoll\",       \" CreditsRoll (late unified viewer credits, silent tail)\"),\r\n 323: \r\n 324: \r\n 325: }\r\n 326: \r\n 327: # ---------------------------------------------------------------------------\r\n 328: # v2 audio/casting nodes (Wave 1a-c, 2a) -- registered from the single source\r\n 329: # of truth in nodes/_otr_class_registry.new_node_modules_table(), and ONLY for\r\n 330: # the nodes whose module file already exists on disk. Merging by table (not as\r\n 331: # literal \"OTR_...\" keys) keeps the class-registry collision guard meaningful;\r\n 332: # the file-existence check keeps a box-fresh load banner clean -- a node whose\r\n 333: # module has not landed yet (e.g. OTR_CastLock before Wave 2a) is simply\r\n 334: # skipped, so the loader never logs a phantom \"Skipped\" line (C-6).\r\n 335: try:\r\n 336:     from .nodes._otr_class_registry import (\r\n 337:         new_node_modules_table as _otr_new_audio_table,\r\n 338:     )\r\n 339: \r\n 340:     _otr_pkg_dir = os.path.dirname(os.path.abspath(__file__))\r\n 341:     for _otr_key, _otr_value in _otr_new_audio_table().items():\r\n 342:         _otr_rel = _otr_value[0].lstrip(\".\").replace(\".\", os.sep) + \".py\"\r\n 343:         if os.path.exists(os.path.join(_otr_pkg_dir, _otr_rel)):\r\n 344:             _NODE_MODULES[_otr_key] = _otr_value\r\n 345: except Exception as _otr_audio_reg_exc:  # noqa: BLE001\r\n 346:     log.warning(\r\n 347:         \"[OldTimeRadio] v2 audio node table merge skipped: %s\",\r\n 348:         _otr_audio_reg_exc,\r\n 349:     )\r\n 350: \r\n 351: for node_name, (module_path, class_name, display_name) in _NODE_MODULES.items():\r\n 352:     try:\r\n 353:         mod = importlib.import_module(module_path, package=__name__)\r\n 354:         cls = getattr(mod, class_name)\r\n 355: \r\n 356:         # Single canonical registration (OTR_ prefix only). The legacy\r\n 357:         # bare-name (NodeName) alias mirror loop was deleted in the\r\n 358:         # voice-path-cleanbreak 2026-05-12 sprint per the Standing\r\n 359:         # Directive. Saved workflow JSONs that reference bare-name\r\n 360:         # node types are expected to be rewritten against the OTR_\r\n 361:         # prefix; there is no parallel legacy-workflow path.\r\n 362:         NODE_CLASS_MAPPINGS[node_name] = cls\r\n 363:         NODE_DISPLAY_NAME_MAPPINGS[node_name] = display_name\r\n 364: \r\n 365:     except Exception as e:\r\n 366:         log.warning(\"[OldTimeRadio] Failed to load '%s': %s\", node_name, e)\r\n 367:         print(f\"[OldTimeRadio] Skipped '{node_name}': {e}\")\r\n 368: \r\n 369: # ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?\r\n 370: # Clean-break v2.0-alpha (2026-05-12): _RENAME_ALIASES dict removed. No\r\n 371: # back-compat surface. Every workflow JSON references the current canonical\r\n 372: # class names directly. Legacy class names (OTR_Gemma4Director,\r\n 373: # OTR_LedgerScriptReviewer, OTR_Gemma4ScriptWriter, OTR_LLMScriptWriter) are\r\n 374: # DEAD -- attempting to load a workflow that references one will fail loudly,\r\n 375: # which is the desired behaviour during a greenfield rewrite.\r\n 376: # ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?ƒ\"?\r\n 377: \r\n 378: _loaded = sum(1 for k in NODE_CLASS_MAPPINGS if k.startswith(\"OTR_\"))\r\n 379: _total = len(_NODE_MODULES)\r\n 380: if _loaded == _total:\r\n 381:     print(f\"[OldTimeRadio] OK - All {_total} nodes loaded successfully\")\r\n 382: else:\r\n 383:     print(f\"[OldTimeRadio] Loaded {_loaded}/{_total} nodes ({_total - _loaded} failed)\")\r\n 384: \r\n 385: # =====================================================================\r\n 386: # HTTP route: GET /otr/latest_ledger\r\n 387: # Exposes the freshest *_ledger.json from output/otr/audio/ (or the legacy\r\n 388: # output/old_time_radio/ fallback) as plain JSON over ComfyUI's existing\r\n 389: # HTTP server. Lets the live-run-tail Cowork artifact poll a single URL\r\n 390: # without needing Desktop Commander or any MCP transport.\r\n","exit_code":0,"status":"completed"}}
