{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(280,350),@(400,455),@(1378,1515)); $content=Get-Content -LiteralPath '\"'nodes\\\\production_ledger.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"===== 280-350 =====\r\n  280: #: identity -- they are products of the render, not the request that\r\n  281: #: produced it (l3 schema: clips[].warmup_pad_ms + humo_render_ms +\r\n  282: #: mp4_dur_s + mp4_frames + audio_fed_to_humo_dur_s, plus shared per-row\r\n  283: #: render stamps).\r\n  284: _CLIP_OUTPUT_FIELDS = frozenset({\r\n  285:     \"warmup_pad_ms\", \"humo_render_ms\", \"mp4_dur_s\", \"mp4_frames\",\r\n  286:     \"audio_fed_to_humo_dur_s\", \"start_s\", \"dur_s\", \"start_s_space\",\r\n  287:     \"render_ms\", \"generated_dur_s\", \"audio_sample_hash\",\r\n  288:     \"render_spec_sha256\",\r\n  289: })\r\n  290: \r\n  291: \r\n  292: def _canonical_sha256(payload: Any) -> str:\r\n  293:     \"\"\"SHA256 hex of a canonical (sorted-key, compact) JSON encoding of\r\n  294:     ``payload``. Deterministic across runs and machines. Falls back to\r\n  295:     ``repr`` for non-JSON-serialisable payloads (best-effort; never\r\n  296:     raises).\"\"\"\r\n  297:     try:\r\n  298:         blob = json.dumps(payload, sort_keys=True, ensure_ascii=False,\r\n  299:                           separators=(\",\", \":\"))\r\n  300:     except (TypeError, ValueError):\r\n  301:         blob = repr(payload)\r\n  302:     return hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()\r\n  303: \r\n  304: \r\n  305: def _row_identity(arr_name: str, row: Dict[str, Any]) -> Optional[str]:\r\n  306:     \"\"\"Content identity for a ROW_KEYED row (lines / music / clips),\r\n  307:     recomputed from the row's authored/source content. Returns ``None``\r\n  308:     when identity is undefined OR the identity SOURCE IS EMPTY -- the\r\n  309:     caller then falls back to the legacy (ungated) copy-forward.\r\n  310: \r\n  311:     The empty-source -> None rule is deliberate: a line whose text was\r\n  312:     CLEARED to \"\" (a Script Doctor skip, or an authoritative empty\r\n  313:     rebuild) has no new content to render, so there is nothing stale to\r\n  314:     invalidate -- the out-of-band durable field (bark_wav_path, timings)\r\n  315:     is preserved per the ownership/skip contract (BUG-108 +\r\n  316:     test_ledger_merge_ownership). The identity gate only bites when the\r\n  317:     in-memory content is MEANINGFUL and DIFFERS from disk -- i.e. an edit\r\n  318:     that would otherwise glue a stale render onto changed text.\r\n  319: \r\n  320:     - lines: sha256 of the canonical line text (the source for\r\n  321:       ``text_for_tts``); None when the text is empty/whitespace.\r\n  322:     - music: sha256 of the authored cue spec\r\n  323:       (``_MUSIC_CUE_SPEC_FIELDS``) == ``cue_spec_sha256``; None when the\r\n  324:       whole spec is empty.\r\n  325:     - clips: sha256 of the render-request fields, EXCLUDING render\r\n  326:       outputs/timing (``_CLIP_OUTPUT_FIELDS``) and the ``line_id`` merge\r\n  327:       key; None when no source fields remain.\r\n  328:     \"\"\"\r\n  329:     if not isinstance(row, dict):\r\n  330:         return None\r\n  331:     if arr_name == \"lines\":\r\n  332:         text = _safe_str(row.get(\"text\"))\r\n  333:         if not text.strip():\r\n  334:             return None\r\n  335:         return _canonical_sha256(text)\r\n  336:     if arr_name == \"music\":\r\n  337:         spec = {k: row.get(k) for k in _MUSIC_CUE_SPEC_FIELDS}\r\n  338:         if not any(v not in (None, \"\", [], {}) for v in spec.values()):\r\n  339:             return None\r\n  340:         return _canonical_sha256(spec)\r\n  341:     if arr_name == \"clips\":\r\n  342:         spec = {k: v for k, v in row.items()\r\n  343:                 if k != \"line_id\" and k not in _CLIP_OUTPUT_FIELDS}\r\n  344:         if not spec:\r\n  345:             return None\r\n  346:         return _canonical_sha256(spec)\r\n  347:     return None\r\n  348: \r\n  349: \r\n  350: # ---------------------------------------------------------------------------\r\n===== 400-455 =====\r\n  400: class LedgerStampError(RuntimeError):\r\n  401:     \"\"\"S2 durable-persistence contract (credits enrichment 2026-07-03):\r\n  402:     a required credits stamp could not be persisted to the production\r\n  403:     ledger singleton. LOUD by design -- the late OTR_CreditsRoll node can\r\n  404:     only read what is on disk, so a silent save miss here becomes a\r\n  405:     missing-receipt failure at mux time. Never catch-and-continue.\"\"\"\r\n  406: \r\n  407: \r\n  408: def stamp_durable(*, sections: Optional[Dict[str, Any]] = None,\r\n  409:                   meta_updates: Optional[Dict[str, Any]] = None,\r\n  410:                   source: str = \"\") -> Optional[str]:\r\n  411:     \"\"\"Copy credit-bearing sections from a LOCAL wire-parsed ledger dict\r\n  412:     into the process SINGLETON and persist, LOUDLY.\r\n  413: \r\n  414:     S2 gotcha this exists for: CastLock and the image dispatcher stamp a\r\n  415:     LOCAL dict parsed off the wire (``load_ledger(script_json)``), never\r\n  416:     the singleton -- so a bare ``get_ledger().save()`` would persist the\r\n  417:     singleton's EMPTY/stale state and silently drop the stamps. Callers\r\n  418:     hand the updated sections here and this helper does the copy + save.\r\n  419: \r\n  420:     - ``sections``: top-level keys replaced wholesale on the singleton\r\n  421:       (e.g. ``{\"cast\": [...]}``, ``{\"images\": {...}}``).\r\n  422:     - ``meta_updates``: merged into ``data[\"meta\"]`` (additive).\r\n  423:     - Production: ``Ledger.save()`` returns ``None`` on failure and never\r\n  424:       raises, so the return IS checked here and a ``None`` RAISES\r\n  425:       ``LedgerStampError`` (Fable BUILD-BREAKER #3).\r\n  426:     - Test mode (``OTR_TEST_MODE=1``): explicit injection path -- the\r\n  427:       in-memory singleton copy still happens (tests can read it back) but\r\n  428:       the disk save is skipped, so no placeholder ledgers leak into the\r\n  429:       real output tree. Returns ``None`` in that case.\r\n  430:     \"\"\"\r\n  431:     led = get_ledger()\r\n  432:     for key, value in (sections or {}).items():\r\n  433:         led.data[key] = value\r\n  434:     if meta_updates:\r\n  435:         meta = led.data.setdefault(\"meta\", {})\r\n  436:         if not isinstance(meta, dict):\r\n  437:             meta = {}\r\n  438:             led.data[\"meta\"] = meta\r\n  439:         meta.update(meta_updates)\r\n  440:     if os.environ.get(\"OTR_TEST_MODE\") == \"1\":\r\n  441:         log.info(\"[Ledger] stamp_durable(%s): test-mode injection \"\r\n  442:                  \"(in-memory only, disk save skipped)\", source or \"?\")\r\n  443:         return None\r\n  444:     path = led.save()\r\n  445:     if path is None:\r\n  446:         raise LedgerStampError(\r\n  447:             f\"stamp_durable({source or '?'}): Ledger.save() returned None -- \"\r\n  448:             f\"durable credits stamp NOT persisted (sections=\"\r\n  449:             f\"{sorted((sections or {}).keys())}, meta_keys=\"\r\n  450:             f\"{sorted((meta_updates or {}).keys())})\"\r\n  451:         )\r\n  452:     return path\r\n  453: \r\n  454: \r\n  455: def has_current_ledger() -> bool:\r\n===== 1378-1515 =====\r\n 1378:                 on_disk = json.load(f)\r\n 1379:         except Exception as exc:  # noqa: BLE001\r\n 1380:             log.warning(\"[Ledger] BUG-108 merge: on-disk read failed: %s\", exc)\r\n 1381:             return in_mem\r\n 1382: \r\n 1383:         # Top-level fields the Ledger class doesn't manage but must\r\n 1384:         # not destroy. final_audio_path is on the kept-list because\r\n 1385:         # SignalLostVideo overwrites it via set_final_paths -- that's\r\n 1386:         # an explicit overwrite, not a merge concern.\r\n 1387:         TOP_PRESERVE = (\r\n 1388:             \"schema_version\", \"audio_gates\", \"transitions\",\r\n 1389:             \"radio_bookend_path\",\r\n 1390:         )\r\n 1391:         for k in TOP_PRESERVE:\r\n 1392:             if k in on_disk and (k not in in_mem or in_mem.get(k) in (None, \"\", [], {})):\r\n 1393:                 in_mem[k] = on_disk[k]\r\n 1394: \r\n 1395:         # `meta` is recursive: BUG-LOCAL-018 (7c84ee8) added meta.paths\r\n 1396:         # which made in_mem[\"meta\"] always non-empty at save time, so\r\n 1397:         # the bulk-replace rule above stopped copying disk meta. That\r\n 1398:         # silently dropped schema-l3 phase telemetry written by audio\r\n 1399:         # nodes (meta.phase_ms.bark, meta.git_commit, etc.) on every\r\n 1400:         # SignalLostVideo dual-ledger save. Fix: per-key merge -- disk\r\n 1401:         # wins where in-mem doesn't have a key or has an empty value;\r\n 1402:         # in-mem wins where it has a real value.\r\n 1403:         if \"meta\" in on_disk:\r\n 1404:             disk_meta = on_disk.get(\"meta\") or {}\r\n 1405:             if not isinstance(disk_meta, dict):\r\n 1406:                 disk_meta = {}\r\n 1407:             in_mem_meta = in_mem.get(\"meta\")\r\n 1408:             if not isinstance(in_mem_meta, dict):\r\n 1409:                 in_mem_meta = {}\r\n 1410:             for mk, mv in disk_meta.items():\r\n 1411:                 if mk not in in_mem_meta or in_mem_meta.get(mk) in (None, \"\", [], {}):\r\n 1412:                     in_mem_meta[mk] = mv\r\n 1413:             in_mem[\"meta\"] = in_mem_meta\r\n 1414: \r\n 1415:         # Per-row merge. Keyed by line_id (lines, clips) or cue_id\r\n 1416:         # (music). \"sfx\": \"cue_id\" entry deleted S27 (cleanbreak-tail\r\n 1417:         # Item 2) -- the sfx[] schema scaffold was deleted in S26-A3\r\n 1418:         # and the ROW_KEYED entry was kept only to forward stale rows\r\n 1419:         # from old on-disk ledger files. Old ledgers rebuild on next\r\n 1420:         # run; the merge no longer tries to preserve a deleted shape.\r\n 1421:         ROW_KEYED = {\r\n 1422:             \"lines\": \"line_id\",\r\n 1423:             \"clips\": \"line_id\",\r\n 1424:             \"music\": \"cue_id\",\r\n 1425:         }\r\n 1426:         # Canonical row fields the in-memory Ledger OWNS outright: the\r\n 1427:         # disk merge must never resurrect stale values into them --\r\n 1428:         # neither when the fresh in-memory value is deliberately falsy\r\n 1429:         # (external QA round 1, 2026-07-10) NOR when a fresh\r\n 1430:         # authoritative rebuild simply OMITS the key (external QA r2\r\n 1431:         # P0.2: `set_lines()` builds rows without `skip`/\r\n 1432:         # `tts_skip_reason`/`reviewer_skip_reason`, and the old\r\n 1433:         # key-presence test read that omission as \"please restore old\r\n 1434:         # disk state\" -- resurrecting a stale skip flag onto a newly\r\n 1435:         # non-empty line -> Phase 10 freeze error). Ownership is at the\r\n 1436:         # ROW level: a row present in memory is the authoritative\r\n 1437:         # composition; disk may only contribute out-of-band DURABLE\r\n 1438:         # renderer fields (bark_wav_path, timings, render stamps --\r\n 1439:         # BUG-LOCAL-108). Per-field source/revision identity for the\r\n 1440:         # durable set is the S2 P1.1 follow-up.\r\n 1441:         _MERGE_OWNED_ROW_FIELDS = frozenset({\r\n 1442:             # composition / content\r\n 1443:             \"text\", \"char_count\", \"word_count\", \"traits\", \"boundary\",\r\n 1444:             \"char_id\", \"speaker_role\", \"arc_phase\", \"compose_flags\",\r\n 1445:             \"beat_intent\", \"target_words\", \"dialogue_slot_id\",\r\n 1446:             \"shot_id\", \"beat_id\",\r\n 1447:             # skip / editorial state\r\n 1448:             \"skip\", \"tts_skip_reason\", \"reviewer_skip_reason\",\r\n 1449:             \"reviewer_note\", \"needs_render_realign\",\r\n 1450:             # authored music cue spec (S2 P1.1 / C1): OWNED like line\r\n 1451:             # composition -- a re-authored cue must never have its spec\r\n 1452:             # resurrected from a stale disk row (that would make the\r\n 1453:             # identity falsely match and keep the wrong wav). cue_id is\r\n 1454:             # the merge key (never copied). The DURABLE music render\r\n 1455:             # fields (wav_path / start_s / dur_s) are deliberately NOT\r\n 1456:             # here: they copy forward on an identity MATCH.\r\n 1457:             \"description\", \"generation_prompt\", \"anchor_line_id\",\r\n 1458:             \"placement\", \"target_duration_s\", \"cue_spec_sha256\",\r\n 1459:         })\r\n 1460:         for arr_name, key_field in ROW_KEYED.items():\r\n 1461:             on_disk_rows = on_disk.get(arr_name) or []\r\n 1462:             in_mem_rows = in_mem.get(arr_name) or []\r\n 1463:             if not on_disk_rows or not in_mem_rows:\r\n 1464:                 # If disk has rows and memory doesn't, prefer disk.\r\n 1465:                 if on_disk_rows and not in_mem_rows:\r\n 1466:                     in_mem[arr_name] = on_disk_rows\r\n 1467:                 continue\r\n 1468:             on_disk_map = {\r\n 1469:                 r.get(key_field): r for r in on_disk_rows\r\n 1470:                 if r.get(key_field)\r\n 1471:             }\r\n 1472:             for row in in_mem_rows:\r\n 1473:                 key = row.get(key_field)\r\n 1474:                 if not key or key not in on_disk_map:\r\n 1475:                     continue\r\n 1476:                 disk_row = on_disk_map[key]\r\n 1477:                 # DURABLE-FIELD IDENTITY (S2 P1.1 / C1): the copy-forward\r\n 1478:                 # below exists only to preserve out-of-band DURABLE render\r\n 1479:                 # fields (wav/cache/timing/render stamps). Those are valid\r\n 1480:                 # ONLY while the row's authored/source content is unchanged.\r\n 1481:                 # Recompute the content identity on BOTH sides (never from a\r\n 1482:                 # stored hash, so legacy disk rows migrate) -- if they\r\n 1483:                 # differ, the on-disk render is STALE: skip the whole\r\n 1484:                 # copy-forward for this row so the stale wav/timing is\r\n 1485:                 # dropped rather than glued onto the edited content. Owned\r\n 1486:                 # composition fields are never copied regardless (below).\r\n 1487:                 _id_mem = _row_identity(arr_name, row)\r\n 1488:                 _id_disk = _row_identity(arr_name, disk_row)\r\n 1489:                 if (_id_mem is not None and _id_disk is not None\r\n 1490:                         and _id_mem != _id_disk):\r\n 1491:                     continue\r\n 1492:                 # Copy forward keys present on disk but absent or\r\n 1493:                 # null in memory. Never overwrite a present in-mem\r\n 1494:                 # value with a disk value -- in-memory is fresher\r\n 1495:                 # for rows the Ledger class actually manages.\r\n 1496:                 #\r\n 1497:                 # OWNERSHIP-AWARE (external QA root-cause, 2026-07-10,\r\n 1498:                 # fable2 S1b): canonical OWNED content/state fields are\r\n 1499:                 # NEVER restored from disk when the key exists in\r\n 1500:                 # memory, even when the in-memory value is falsy -- a\r\n 1501:                 # Script Doctor \"skip\" edit intentionally clears text to\r\n 1502:                 # \"\" and the old rule resurrected the STALE disk text\r\n 1503:                 # into the cleared row (skip=True + non-empty text ->\r\n 1504:                 # Phase 10 critical gap, dead run). The merge exists for\r\n 1505:                 # out-of-band DURABLE extension fields (BUG-LOCAL-108:\r\n 1506:                 # bark_wav_path, timings, render stamps) -- those still\r\n 1507:                 # copy forward.\r\n 1508:                 for k, v in disk_row.items():\r\n 1509:                     if k in _MERGE_OWNED_ROW_FIELDS:\r\n 1510:                         continue\r\n 1511:                     if k not in row or row.get(k) in (None, \"\", [], {}):\r\n 1512:                         row[k] = v\r\n 1513:         return in_mem\r\n 1514: \r\n 1515: \r\n","exit_code":0,"status":"completed"}}
