{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(868,930),@(936,1020),@(1230,1285)); $content=Get-Content -LiteralPath '\"'nodes\\\\_otr_openrouter_backend.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"===== 868-930 =====\r\n  868:     `load()` builds a provider-tagged cache_entry carrying the resolved\r\n  869:     slug + per-slot config -- no weights, no tokenizer, zero VRAM.\r\n  870:     `generate()` posts the chat request behind the cost guard + retry\r\n  871:     ladder. `unload()` is a no-op (nothing is resident).\"\"\"\r\n  872: \r\n  873:     # --- protocol: load -------------------------------------------------\r\n  874: \r\n  875:     def load(self, repo_id: str, row: Any, policy: Any = None) -> dict[str, Any]:\r\n  876:         \"\"\"Return a remote cache_entry. No network call fires here -- a\r\n  877:         bad slug surfaces at generate time, and load must stay cheap so\r\n  878:         the writer's per-call request_slot is fast (C2: it must not\r\n  879:         touch the resident local model).\r\n  880: \r\n  881:         S1 policy contract: this remote lane ASSERTS the profile\r\n  882:         lane_allowlist admits it (defense in depth behind request_slot's\r\n  883:         backstop) and deliberately IGNORES every hardware field\r\n  884:         (device/attn/quant/gguf) -- the lane uses zero local compute.\"\"\"\r\n  885:         if policy is not None and not policy.admits_lane(\"openrouter\"):\r\n  886:             raise OpenRouterConfigError(\r\n  887:                 f\"{repo_id}: 'openrouter' lane is not admitted by the \"\r\n  888:                 f\"profile lane_allowlist {list(policy.lane_allowlist)}.\"\r\n  889:             )\r\n  890:         if not openrouter_enabled():\r\n  891:             raise OpenRouterConfigError(\r\n  892:                 f\"{repo_id} selected but OpenRouter is not enabled. Set \"\r\n  893:                 f\"OPENROUTER_API_KEY \"\r\n  894:                 f\"(see docs/openrouter-setup.md).\"\r\n  895:             )\r\n  896:         letter = _slot_letter(repo_id)\r\n  897:         # Resolve the slug AND its provider-routing sort together: a ':nitro'/\r\n  898:         # ':floor' suffix on the bound slug is stripped here and carried as an\r\n  899:         # explicit sort, so the wire payload + run meta hold the clean slug.\r\n  900:         slug, provider_sort = resolve_route(letter, resolve_slug(repo_id))\r\n  901:         context_window = int(\r\n  902:             getattr(row, \"context_window\", DEFAULT_CONTEXT_WINDOW)\r\n  903:             or DEFAULT_CONTEXT_WINDOW\r\n  904:         )\r\n  905:         cache_entry: dict[str, Any] = {\r\n  906:             \"provider\": PROVIDER,\r\n  907:             \"model_id\": repo_id,          # the virtual handle\r\n  908:             \"slot_letter\": letter,        # \"A\" / \"B\"\r\n  909:             \"slug\": slug,                 # the resolved real model id\r\n  910:             \"provider_sort\": provider_sort,  # throughput|price|latency|None\r\n  911:             \"context_cap\": context_window,\r\n  912:             \"context_window\": context_window,\r\n  913:             # optional per-slot overrides (FC3) -- None 冐' caller controls\r\n  914:             \"temperature_override\": _float_env(f\"OPENROUTER_{letter}_TEMP\"),\r\n  915:             \"max_tokens_cap\": _int_env(\r\n  916:                 f\"OPENROUTER_{letter}_MAXTOK\", DEFAULT_OUTPUT_TOKENS_CAP\r\n  917:             ),\r\n  918:             \"base_url\": _env(\"OPENROUTER_BASE_URL\") or DEFAULT_BASE_URL,\r\n  919:             # no \"model\" / \"tokenizer\" keys: the generate-fn factory\r\n  920:             # branches on provider BEFORE requiring them (S3).\r\n  921:         }\r\n  922:         log.info(\r\n  923:             \"[OpenRouter] load slot=%s handle=%s slug=%s route=%s ctx=%d \"\r\n  924:             \"(remote, 0 VRAM)\",\r\n  925:             letter, repo_id, slug, provider_sort or \"default\", context_window,\r\n  926:         )\r\n  927:         return cache_entry\r\n  928: \r\n  929:     # --- protocol: generate --------------------------------------------\r\n  930: \r\n===== 936-1020 =====\r\n  936:         temperature: float | None = None,\r\n  937:         max_new_tokens: int | None = None,\r\n  938:         stop: Any = None,\r\n  939:         response_format: dict | None = None,\r\n  940:         grammar: str | None = None,\r\n  941:         **_ignored: Any,\r\n  942:     ) -> str:\r\n  943:         \"\"\"Run one remote chat completion and return the decoded string.\r\n  944: \r\n  945:         `model` is the cache_entry returned by `load()`. Enforces the\r\n  946:         cost ceiling BEFORE the call (C6), retries transient failures a\r\n  947:         bounded number of times, then aborts cleanly (C5).\"\"\"\r\n  948:         cache_entry = model\r\n  949:         api_key = _env(\"OPENROUTER_API_KEY\")\r\n  950:         if not api_key:\r\n  951:             raise OpenRouterConfigError(\r\n  952:                 \"OPENROUTER_API_KEY is not set; cannot make a remote call.\"\r\n  953:             )\r\n  954:         slug = cache_entry.get(\"slug\") or resolve_slug(cache_entry[\"model_id\"])\r\n  955:         base_url = cache_entry.get(\"base_url\") or DEFAULT_BASE_URL\r\n  956:         provider_sort = cache_entry.get(\"provider_sort\")\r\n  957: \r\n  958:         # Resolve the output budget. The remote model has NO token grammar,\r\n  959:         # so it must not inherit the local grammar-era per-call budget (which\r\n  960:         # truncates a free-form object mid-JSON). Floor at\r\n  961:         # DEFAULT_MIN_OUTPUT_TOKENS, then clamp to the per-slot cap. max_tokens\r\n  962:         # is a ceiling only -- the model stops at finish_reason=stop and bills\r\n  963:         # actual tokens, so a generous floor costs nothing on short replies.\r\n  964:         cap = int(cache_entry.get(\"max_tokens_cap\") or DEFAULT_OUTPUT_TOKENS_CAP)\r\n  965:         floor = _int_env(\"OPENROUTER_MIN_OUTPUT_TOKENS\", DEFAULT_MIN_OUTPUT_TOKENS)\r\n  966:         out_tokens = max(int(max_new_tokens or 0), floor)\r\n  967:         if out_tokens > cap:\r\n  968:             out_tokens = cap\r\n  969:         temp = (\r\n  970:             cache_entry.get(\"temperature_override\")\r\n  971:             if cache_entry.get(\"temperature_override\") is not None\r\n  972:             else temperature\r\n  973:         )\r\n  974: \r\n  975:         # --- C6 cost guard: enforce BEFORE any network call ---\r\n  976:         est = _estimate_request_tokens(messages, out_tokens)\r\n  977:         self._enforce_cost_ceiling(est, slug=slug)\r\n  978: \r\n  979:         payload: dict[str, Any] = {\r\n  980:             \"model\": slug,\r\n  981:             \"messages\": messages,\r\n  982:             \"max_tokens\": out_tokens,\r\n  983:         }\r\n  984:         if temp is not None:\r\n  985:             payload[\"temperature\"] = float(temp)\r\n  986:         if stop:\r\n  987:             payload[\"stop\"] = [s for s in stop if s]\r\n  988:         # Reasoning control (gemma-4 / thinking-model lane). The OpenAI-standard\r\n  989:         # `reasoning_effort` (high|medium|low|none) is the portable lever used\r\n  990:         # to bound or disable the <think> preamble; set\r\n  991:         # OPENROUTER_REASONING_EFFORT=none so a reasoning model emits the\r\n  992:         # structured answer directly instead of burning the output budget on\r\n  993:         # reasoning (-> finish_reason=length -> unparseable JSON). Unset -> the\r\n  994:         # field is omitted, so non-thinking models / OpenRouter-proper are\r\n  995:         # byte-identical. Not require_parameters-gated: a backend that ignores it\r\n  996:         # simply reasons as before -- the output-token floor is the safety net.\r\n  997:         reasoning_effort = _reasoning_effort_from_env()\r\n  998:         if reasoning_effort:\r\n  999:             payload[\"reasoning_effort\"] = reasoning_effort\r\n 1000:             # EVIDENT (operator 2026-06-22): log ONCE per process so any server\r\n 1001:             # log -- the soak's AND a manual workflow run -- visibly shows the\r\n 1002:             # reasoning lever is active (the fix for the finish_reason=length\r\n 1003:             # truncation epidemic on reasoning ~latest writers).\r\n 1004:             global _REASONING_EFFORT_LOGGED\r\n 1005:             if not _REASONING_EFFORT_LOGGED:\r\n 1006:                 _REASONING_EFFORT_LOGGED = True\r\n 1007:                 log.info(\"[OpenRouter] reasoning_effort=%s ACTIVE \"\r\n 1008:                          \"(OPENROUTER_REASONING_EFFORT) -- reasoning models emit \"\r\n 1009:                          \"the answer instead of burning the output budget on \"\r\n 1010:                          \"hidden reasoning\", reasoning_effort)\r\n 1011:         # Build ONE provider-routing object so the speed/cost sort and the\r\n 1012:         # require_parameters guard coexist (a second `payload[\"provider\"]`\r\n 1013:         # assignment would clobber the first).\r\n 1014:         provider_opts: dict[str, Any] = {}\r\n 1015:         if provider_sort:\r\n 1016:             # \":nitro\"/throughput = fastest provider, \":floor\"/price =\r\n 1017:             # cheapest, latency = lowest time-to-first-token (C6: the cost\r\n 1018:             # guard still applies; a faster upstream is not an uncapped one).\r\n 1019:             provider_opts[\"sort\"] = provider_sort\r\n 1020:         if response_format is not None:\r\n===== 1230-1285 =====\r\n 1230: \r\n 1231: def make_openrouter_generate_fn(cache_entry: dict, *, response_format: dict | None = None,\r\n 1232:                                 grammar: str | None = None):\r\n 1233:     \"\"\"Return a generate_fn closure for a provider-tagged remote\r\n 1234:     cache_entry (FC2 seam 2).\r\n 1235: \r\n 1236:     The closure matches the signature every OTR generate_fn uses --\r\n 1237:     ``(messages, *, temperature, max_new_tokens, stop=None, ...) -> str`` --\r\n 1238:     so the loader factories (`make_generate_fn`,\r\n 1239:     `make_polish_generate_fn`) and the writer's\r\n 1240:     `_build_truncating_generate_fn` can all return it unchanged when\r\n 1241:     ``cache_entry[\"provider\"] == \"openrouter\"``.\r\n 1242: \r\n 1243:     `response_format` is None for free-form creative + the plain\r\n 1244:     structured_call path; S4 passes an OpenRouter json_schema\r\n 1245:     response_format for the grammar-constrained technical path so remote\r\n 1246:     technical output is schema-enforced (fail-closed via structured_call's\r\n 1247:     validate + bounded-repair ladder).\r\n 1248: \r\n 1249:     `grammar` (A, 2026-06-04) is an optional GBNF string for the local\r\n 1250:     llama-server lane. It is None for every normal call; the style-picker\r\n 1251:     inventor passes its exactly-N grammar per-call so an overgenerating\r\n 1252:     model cannot break the exact-count gate. The `_otr_supports_grammar`\r\n 1253:     marker lets a caller pass a grammar ONLY to backends that honour it --\r\n 1254:     local backends lack the marker and stay byte-identical.\"\"\"\r\n 1255:     backend = OpenRouterBackend()\r\n 1256:     bound_rf = response_format\r\n 1257:     bound_grammar = grammar\r\n 1258: \r\n 1259:     def generate_fn(messages, *, temperature=None, max_new_tokens=None,\r\n 1260:                     stop=None, response_format=None, grammar=None):\r\n 1261:         # A per-call response_format (e.g. structured_call passing\r\n 1262:         # json_object on an un-schema'd creative call) overrides the bound\r\n 1263:         # one; otherwise the closure's bound response_format (S4 json_schema)\r\n 1264:         # is used. Free-form calls pass neither and get plain generation.\r\n 1265:         rf = response_format if response_format is not None else bound_rf\r\n 1266:         # A: a per-call GBNF grammar (the style-picker inventor passing its\r\n 1267:         # exactly-N grammar) overrides the bound one; both None = free-form.\r\n 1268:         g = grammar if grammar is not None else bound_grammar\r\n 1269:         return backend.generate(\r\n 1270:             cache_entry,\r\n 1271:             messages,\r\n 1272:             temperature=temperature,\r\n 1273:             max_new_tokens=max_new_tokens,\r\n 1274:             stop=stop,\r\n 1275:             response_format=rf,\r\n 1276:             grammar=g,\r\n 1277:         )\r\n 1278: \r\n 1279:     # Markers so structured_call can detect a remote fn and whether it\r\n 1280:     # already carries a schema-bound response_format (don't override that).\r\n 1281:     # _otr_supports_grammar (A) lets the style-picker inventor pass a per-\r\n 1282:     # call GBNF only to backends that honour it (the remote llama-server\r\n 1283:     # lane); local backends lack the marker and stay byte-identical.\r\n 1284:     generate_fn._otr_openrouter = True  # type: ignore[attr-defined]\r\n 1285:     generate_fn._otr_response_format = bound_rf  # type: ignore[attr-defined]\r\n","exit_code":0,"status":"completed"}}
