 % (backdrop, mood)\r\n1009:     era = _scrub_still_word_era_tail(era)               # MANDATORY word-mode scrub\r\n1010:     pieces = ['a title card displaying the words \"%s\"' % words,\r\n1011:               _STILL_WORD_LEGIBILITY_GUARD, lettering, backdrop, era,\r\n1012:               _style.image_grade_tail, _STILL_WORD_TEXT_GUARD]\r\n1013:     return \", \".join(p.strip().rstrip(\",\") for p in pieces if p and p.strip())\r\n","exit_code":0,"status":"completed"}}
