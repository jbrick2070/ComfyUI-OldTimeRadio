{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=580; $end=715; $i=0; Get-Content -LiteralPath '\"'nodes\\\\OTR_LedgerScriptWriter.py' | ForEach-Object { \"'$i++; if ($i -ge $start -and $i -le $end) { '\"'{0,4}: {1}' -f \"'$i, $_ } }'","aggregated_output":" 580:                 temperature=temperature,\r\n 581:                 max_new_tokens=max_new_tokens,\r\n 582:             )\r\n 583: \r\n 584:         return polish_fn\r\n 585: \r\n 586: \r\n 587: \r\n 588: def _build_truncating_generate_fn(\r\n 589:     cache_entry: dict,\r\n 590:     *,\r\n 591:     top_p: float = 0.92,\r\n 592:     min_p: float = 0.0,\r\n 593:     repetition_penalty: float = 1.0,\r\n 594: ):\r\n 595:     \"\"\"Return a generate_fn that normally left-truncates oversized prompts.\r\n 596: \r\n 597:     A messages-list subclass may set ``_otr_prompt_must_fit = True``.  Those\r\n 598:     provenance-sensitive callers fail loudly before generation instead of\r\n 599:     losing the system/schema prefix to left truncation.\r\n 600: \r\n 601:     Closure captures the four episode-level sampling knobs from the\r\n 602:     writer widgets: top_p, min_p, repetition_penalty. The per-call\r\n 603:     args (`temperature`, `max_new_tokens`, optional `stop`) are\r\n 604:     whatever the line composer / outline / picker passes.\r\n 605: \r\n 606:     Phase 4 v4 (2026-05-11): min_p and repetition_penalty added as\r\n 607:     closure-captured params, plus per-call `stop` support via a\r\n 608:     StoppingCriteria subclass that matches on substring at the tail\r\n 609:     of the decoded output. Defaults are conservative for the 7B-14B\r\n 610:     class:\r\n 611:       top_p              = 0.92   (current default, preserved)\r\n 612:       min_p              = 0.0    (disabled; 0.05 is the safe non-\r\n 613:                                    trivial improvement)\r\n 614:       repetition_penalty = 1.0    (disabled; 1.03 is gentle and\r\n 615:                                    doesn't damage short outputs)\r\n 616:     Each widget overrides per-episode from the workflow.\r\n 617: \r\n 618:     Cap math: max_input_tokens = max(64, context_cap - max_new_tokens).\r\n 619:     Truncation is left-side (drops oldest tokens, preserves most\r\n 620:     recent context).\r\n 621:     \"\"\"\r\n 622:     # [OpenRouter S3] Remote branch (FC2 seam 2). A provider-tagged remote\r\n 623:     # entry has no model/tokenizer/context_cap to close over; return the\r\n 624:     # remote generate_fn before capturing local handles below. The remote\r\n 625:     # model does its own prompt budgeting server-side and honours the\r\n 626:     # caller's per-call temperature + stop. Zero local VRAM.\r\n 627:     if cache_entry.get(\"provider\") == \"openrouter\":\r\n 628:         from . import _otr_openrouter_backend as _orb\r\n 629:         return _orb.make_openrouter_generate_fn(cache_entry)\r\n 630:     # [Comfy Credits] sibling remote seam (2026-06-01). Same provider-tag\r\n 631:     # dispatch as OpenRouter: a credit-billed entry has no model/tokenizer/\r\n 632:     # context_cap to close over; return the remote generate_fn before\r\n 633:     # capturing local handles below. Server-side budgeting; zero local VRAM.\r\n 634:     if cache_entry.get(\"provider\") == \"comfy_credits\":\r\n 635:         from . import _otr_comfy_backend as _occ\r\n 636:         return _occ.make_comfy_credits_generate_fn(cache_entry)\r\n 637:     if cache_entry.get(\"provider\") == \"google_api\":\r\n 638:         from ._otr_google_api import llm as _gai_llm\r\n 639:         return _gai_llm.make_google_api_generate_fn(cache_entry)\r\n 640:     # [Local OpenAI] External local server lane for Gemma 4 12B. Same\r\n 641:     # provider-tag dispatch; zero ComfyUI-process VRAM.\r\n 642:     if cache_entry.get(\"provider\") == \"gguf_native\":\r\n 643:         from . import _otr_gguf_backend as _gguf\r\n 644:         return _gguf.make_gguf_generate_fn(cache_entry)\r\n 645:     model = cache_entry[\"model\"]\r\n 646:     tokenizer = cache_entry[\"tokenizer\"]\r\n 647:     context_cap = int(cache_entry.get(\"context_cap\") or 8192)\r\n 648:     active_top_p = float(top_p)\r\n 649:     active_min_p = float(min_p or 0.0)\r\n 650:     active_rep_penalty = float(repetition_penalty or 1.0)\r\n 651:     # Tier 1 fix #8 (2026-05-11): one-shot warning + auto-fallback\r\n 652:     # for transformers versions < 4.43 that don't accept `min_p` as\r\n 653:     # a kwarg on model.generate. Closure-scoped mutable cell so the\r\n 654:     # disable persists across calls within one run without spamming\r\n 655:     # the warning more than once.\r\n 656:     _min_p_unsupported = [False]\r\n 657:     # BUG-LOCAL-262: probe the tokenizer's chat template once per model\r\n 658:     # residency. None = not yet probed; True/False = supports a system\r\n 659:     # role or not. Gemma-2's template hard-rejects the system role, so\r\n 660:     # normalize_messages_for_tokenizer folds system content into the\r\n 661:     # first user turn. Closure-cell idiom matches `_min_p_unsupported`.\r\n 662:     _system_role_supported = [None]\r\n 663: \r\n 664:     def generate_fn(messages, *, temperature, max_new_tokens, stop=None):\r\n 665:         import torch  # local import; never load torch at module import\r\n 666:         from . import _otr_loader_backends as _OTRLB\r\n 667:         prompt_must_fit = bool(getattr(messages, \"_otr_prompt_must_fit\", False))\r\n 668:         if _system_role_supported[0] is None:\r\n 669:             _system_role_supported[0] = (\r\n 670:                 _OTRLB.tokenizer_supports_system_role(tokenizer)\r\n 671:             )\r\n 672:         if not _system_role_supported[0]:\r\n 673:             messages = _OTRLB.normalize_messages_for_tokenizer(\r\n 674:                 tokenizer, messages,\r\n 675:             )\r\n 676:         prompt = tokenizer.apply_chat_template(\r\n 677:             messages, tokenize=False, add_generation_prompt=True,\r\n 678:         )\r\n 679:         inputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\r\n 680: \r\n 681:         max_input_tokens = max(64, context_cap - int(max_new_tokens))\r\n 682:         input_len = inputs[\"input_ids\"].shape[-1]\r\n 683:         if input_len > max_input_tokens:\r\n 684:             if prompt_must_fit:\r\n 685:                 raise PromptContextOverflowError(\r\n 686:                     \"prompt requires %d input tokens but only %d fit \"\r\n 687:                     \"(context_cap=%d, max_new_tokens=%d); refusing to \"\r\n 688:                     \"left-truncate an unsliceable provenance prompt\"\r\n 689:                     % (input_len, max_input_tokens, context_cap, max_new_tokens)\r\n 690:                 )\r\n 691:             trunc = input_len - max_input_tokens\r\n 692:             inputs[\"input_ids\"] = inputs[\"input_ids\"][:, trunc:]\r\n 693:             if \"attention_mask\" in inputs:\r\n 694:                 inputs[\"attention_mask\"] = inputs[\"attention_mask\"][:, trunc:]\r\n 695:             log.warning(\r\n 696:                 \"[OTR_LedgerScriptWriter] PROMPT_GUARD: Truncated \"\r\n 697:                 \"%d -> %d tokens (context_cap=%d, max_new_tokens=%d)\",\r\n 698:                 input_len, max_input_tokens, context_cap, max_new_tokens,\r\n 699:             )\r\n 700: \r\n 701:         gen_kwargs = {\r\n 702:             \"do_sample\": True,\r\n 703:             \"temperature\": float(temperature),\r\n 704:             \"top_p\": active_top_p,\r\n 705:             \"max_new_tokens\": int(max_new_tokens),\r\n 706:             \"pad_token_id\": tokenizer.eos_token_id,\r\n 707:         }\r\n 708:         # Only forward non-default values so older transformers\r\n 709:         # versions that don't accept `min_p` as a kwarg keep working\r\n 710:         # silently when the widget is at its disabled default.\r\n 711:         if active_min_p > 0.0 and not _min_p_unsupported[0]:\r\n 712:             gen_kwargs[\"min_p\"] = active_min_p\r\n 713:         if active_rep_penalty != 1.0:\r\n 714:             gen_kwargs[\"repetition_penalty\"] = active_rep_penalty\r\n 715: \r\n","exit_code":0,"status":"completed"}}
