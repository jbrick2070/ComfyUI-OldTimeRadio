uns at this STATIC low temperature. Per the\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:85: # A typed repair that starts but does not finish decodable JSON gets one\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:152: raw = schema.model_json_schema()\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:212: # repair_prompt_factory -- typed-repair prompt builder contract\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:217: \"\"\"Builds the Attempt 3 (typed repair) prompt.\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:224: `_otr_repair_prompts.py` (Sprint 2C); the ladder supplies\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:225: `default_repair_prompt_factory` when the caller passes `None`.\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:246: def default_repair_prompt_factory(\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:558: repair_prompt_factory: Optional[RepairPromptFactory] = None,\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:589: repair_prompt_factory\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:592: `default_repair_prompt_factory`. A factory may instead return a\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:627: and only burns tokens) and goes straight to typed repair.\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:628: Typed repair: `repair_prompt_factory` either builds a repair prompt\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:632: Repair syntax retry: if the typed repair returned non-decodable JSON\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:657: repair_prompt_factory\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:658: if repair_prompt_factory is not None\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:659: else default_repair_prompt_factory\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:698: # failure skip straight to the typed repair; spend the structural retry only\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:723: # --- Typed repair at a static low temperature (the final rung). ---\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:727: \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair at \"\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:737: repair_prompt = factory(\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:742: # A typed repair factory MAY resolve the failure itself --\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:750: if isinstance(repair_prompt, schema):\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:752: content_error = post_validator(repair_prompt)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:761: return repair_prompt\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:762: repair_messages = _prompt_to_messages(repair_prompt)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:778: # so typed repair can be attempt 2 of a three-call budget. If that repair\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_structured_call.py:794: \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair syntax \"\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(1,105),@(200,285),@(540,825)); $content=Get-Content -LiteralPath '\"'nodes\\\\_otr_structured_call.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(1,105),@(200,285),@(540,825)); $content=Get-Content -LiteralPath '\"'nodes\\\\_otr_structured_call.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"===== 1-105 =====\r\n    1: \"\"\"nodes/_otr_structured_call.py -- shared structured-JSON LLM call helper.\r\n    2: \r\n    3: Sprint 2A step 1. Centralises the retry ladder that every structured-\r\n    4: JSON LLM pass in the project should use. Today each structured pass\r\n    5: (story brief reflection, cast contract, critic, news interpreter)\r\n    6: hand-rolls its own \"call -> parse -> validate -> repair once\" sequence\r\n    7: with subtly different temperature math. This module is the single\r\n    8: home for that ladder.\r\n    9: \r\n   10: Step 1 ships the MODULE + TESTS only. No existing call site is\r\n   11: converted here -- migrating `run_story_brief_reflection` and the other\r\n   12: structured passes onto `structured_call` is later, separate work\r\n   13: (Sprint 2B onward) and is explicitly out of scope.\r\n   14: \r\n   15: The \"2B principle\" on temperature: raising entropy during a JSON-\r\n   16: schema repair encourages MORE structural hallucination, not less. So\r\n   17: the structural retry LOWERS temperature relative to the base attempt,\r\n   18: and the typed repair runs at a static low temperature. One bounded\r\n   19: exception exists: if that typed repair itself ends in incomplete JSON\r\n   20: syntax and call budget remains, its exact prompt may be retried once\r\n   21: above the static repair temperature to avoid repeating an early stop.\r\n   22: \r\n   23: Slot-fn calling convention is read from `nodes/_otr_story_brief.py`\r\n   24: (`run_story_brief_reflection`, `_repair_pass`): a slot fn has the\r\n   25: signature `slot_fn(messages, *, temperature, max_new_tokens[, stop])`\r\n   26: and returns a raw string. JSON extraction reuses the shared\r\n   27: `_otr_json.parse_first_json_object` -- this module does NOT hand-roll\r\n   28: a second JSON parser.\r\n   29: \r\n   30: This module is PURE: no I/O, no GPU, no ComfyUI imports, no writer\r\n   31: imports.\r\n   32: \r\n   33: UTF-8 no BOM. No em-dashes (Windows cp1252 subprocess decode trap).\r\n   34: 4-space indentation.\r\n   35: \"\"\"\r\n   36: from __future__ import annotations\r\n   37: \r\n   38: import json\r\n   39: import logging\r\n   40: from typing import Any, Callable, Optional, Protocol, TypeVar\r\n   41: \r\n   42: from pydantic import BaseModel, ValidationError\r\n   43: \r\n   44: \r\n   45: log = logging.getLogger(\"OTR\")\r\n   46: \r\n   47: \r\n   48: # Shared JSON extraction. Package import in production; flat import\r\n   49: # when the module is loaded standalone / under test. Mirrors the\r\n   50: # import guard in `_otr_story_brief.py`.\r\n   51: try:\r\n   52:     from . import _otr_json\r\n   53: except ImportError:  # pragma: no cover - standalone / test load\r\n   54:     import _otr_json  # type: ignore\r\n   55: \r\n   56: \r\n   57: # `T` is the validated-instance type the caller gets back: whatever\r\n   58: # pydantic model class they pass as `schema`.\r\n   59: T = TypeVar(\"T\", bound=BaseModel)\r\n   60: \r\n   61: \r\n   62: # ---------------------------------------------------------------------------\r\n   63: # Constants -- ladder settings shared by every structured pass\r\n   64: # ---------------------------------------------------------------------------\r\n   65: \r\n   66: # Default cap on the retry ladder: base -> structural retry -> typed\r\n   67: # repair. When a schema/content failure skips the structural rung, the\r\n   68: # remaining third call may recover JSON syntax from the typed repair.\r\n   69: _DEFAULT_MAX_ATTEMPTS: int = 3\r\n   70: \r\n   71: # Token budget for a structured-JSON pass. A JSON object plus a short\r\n   72: # payload fits comfortably here; structured passes are not narrative\r\n   73: # generation. Matches the order of magnitude used by the story-brief\r\n   74: # reflection pass.\r\n   75: _STRUCTURED_MAX_NEW_TOKENS: int = 512\r\n   76: \r\n   77: # Attempt 3 (typed repair) runs at this STATIC low temperature. Per the\r\n   78: # 2B principle the repair pass does not raise temperature -- a repair\r\n   79: # is a \"follow the schema exactly\" instruction, and low entropy is what\r\n   80: # makes a local model comply. Deliberately below any sane base\r\n   81: # temperature so the repair attempt is the calmest attempt in the\r\n   82: # ladder.\r\n   83: _REPAIR_TEMPERATURE: float = 0.10\r\n   84: \r\n   85: # A typed repair that starts but does not finish decodable JSON gets one\r\n   86: # syntax-only retry when call budget remains. The retry temperature is\r\n   87: # capped by the caller's base temperature, so callers at or below this\r\n   88: # value keep their own lower ceiling.\r\n   89: _REPAIR_SYNTAX_RETRY_FLOOR: float = 0.25\r\n   90: \r\n   91: \r\n   92: # ---------------------------------------------------------------------------\r\n   93: # Public exception -- fail-loud terminal state of the ladder\r\n   94: # ---------------------------------------------------------------------------\r\n   95: \r\n   96: \r\n   97: class StructuredCallFailedError(RuntimeError):\r\n   98:     \"\"\"Raised when the retry ladder is exhausted with no schema-valid result.\r\n   99: \r\n  100:     Carries the `helper_name` (so a log reader can attribute the\r\n  101:     failure to a specific structured pass), the number of attempts\r\n  102:     actually run, and the last validation / parse error observed. The\r\n  103:     helper NEVER returns a silent sentinel -- an exhausted ladder is a\r\n  104:     hard failure the caller must handle.\r\n  105:     \"\"\"\r\n===== 200-285 =====\r\n  200:     structure only; it never supplies or rewrites story content.\r\n  201:     \"\"\"\r\n  202:     compact = \", \".join(schema_required_paths(schema))\r\n  203:     return (\r\n  204:         \"\\nReturn exactly one JSON object, with no Markdown, headings, or prose. \"\r\n  205:         f\"Its exact top-level keys are: {', '.join(schema.model_fields)}. \"\r\n  206:         \"Every required nested path must be present, including repeated graph \"\r\n  207:         f\"references. Required paths: {compact}\"\r\n  208:     )\r\n  209: \r\n  210: \r\n  211: # ---------------------------------------------------------------------------\r\n  212: # repair_prompt_factory -- typed-repair prompt builder contract\r\n  213: # ---------------------------------------------------------------------------\r\n  214: \r\n  215: \r\n  216: class RepairPromptFactory(Protocol):\r\n  217:     \"\"\"Builds the Attempt 3 (typed repair) prompt.\r\n  218: \r\n  219:     Given the raw failed model output plus the validation / parse error\r\n  220:     that rejected it, a factory normally returns the messages payload\r\n  221:     for the repair LLM call -- in this codebase a list of\r\n  222:     `{\"role\": ..., \"content\": ...}` dicts (a plain string is also\r\n  223:     accepted and wrapped). The concrete typed factories live in\r\n  224:     `_otr_repair_prompts.py` (Sprint 2C); the ladder supplies\r\n  225:     `default_repair_prompt_factory` when the caller passes `None`.\r\n  226: \r\n  227:     A factory MAY instead resolve the failure itself and return a\r\n  228:     finished, schema-valid pydantic instance of the call's `schema`\r\n  229:     type. `structured_call` detects that, runs it through\r\n  230:     `post_validator`, and returns it WITHOUT making an LLM repair call.\r\n  231:     This is how `cast_membership_repair` short-circuits the LLM when the\r\n  232:     project's Levenshtein matcher resolves a phantom name\r\n  233:     deterministically.\r\n  234:     \"\"\"\r\n  235: \r\n  236:     def __call__(\r\n  237:         self,\r\n  238:         *,\r\n  239:         original_prompt: Any,\r\n  240:         failed_output: str,\r\n  241:         error: BaseException,\r\n  242:     ) -> Any:\r\n  243:         ...\r\n  244: \r\n  245: \r\n  246: def default_repair_prompt_factory(\r\n  247:     *,\r\n  248:     original_prompt: Any,\r\n  249:     failed_output: str,\r\n  250:     error: BaseException,\r\n  251: ) -> list[dict[str, str]]:\r\n  252:     \"\"\"Generic typed-repair prompt used when the caller passes no factory.\r\n  253: \r\n  254:     Prepends an explicit `CRITICAL:` directive naming the validation\r\n  255:     error, echoes the failed output (truncated), and restates the\r\n  256:     original instruction. Mirrors the CRITICAL-prefix repair style of\r\n  257:     `_otr_story_brief._build_repair_messages` so a structured pass that\r\n  258:     has not yet shipped a typed factory still gets a sane repair turn.\r\n  259:     \"\"\"\r\n  260:     error_text = f\"{type(error).__name__}: {error}\"\r\n  261:     original_text = _prompt_to_text(original_prompt)\r\n  262:     critical = (\r\n  263:         \"CRITICAL: Your previous response failed schema validation \"\r\n  264:         f\"because: {error_text}.\\n\\n\"\r\n  265:         \"Return ONE valid JSON object that satisfies the schema. No \"\r\n  266:         \"Markdown, no prose, no preamble -- only the JSON object.\\n\\n\"\r\n  267:         f\"Failed response: {failed_output[:400]}\\n\\n\"\r\n  268:         \"Original instruction follows.\\n\\n\"\r\n  269:     )\r\n  270:     return [{\"role\": \"user\", \"content\": critical + original_text}]\r\n  271: \r\n  272: \r\n  273: # ---------------------------------------------------------------------------\r\n  274: # Helpers -- prompt normalisation, slot-fn invocation, parse + validate\r\n  275: # ---------------------------------------------------------------------------\r\n  276: \r\n  277: \r\n  278: def _prompt_to_text(prompt: Any) -> str:\r\n  279:     \"\"\"Render an arbitrary prompt payload to a plain string.\r\n  280: \r\n  281:     `prompt` may already be a string, or a messages list of\r\n  282:     `{\"role\", \"content\"}` dicts. The default repair factory needs a\r\n  283:     flat string to embed; this normalises both shapes.\r\n  284:     \"\"\"\r\n  285:     if isinstance(prompt, str):\r\n===== 540-825 =====\r\n  540:         new_val = cut or val[:max_len]\r\n  541:         node[leaf] = new_val  # type: ignore[index]\r\n  542:         clamped.append(\".\".join(str(k) for k in loc))\r\n  543:     return (out, clamped) if clamped else None\r\n  544: \r\n  545: \r\n  546: # ---------------------------------------------------------------------------\r\n  547: # Public entrypoint -- the 3-attempt retry ladder\r\n  548: # ---------------------------------------------------------------------------\r\n  549: \r\n  550: \r\n  551: def structured_call(\r\n  552:     *,\r\n  553:     prompt: Any,\r\n  554:     schema: type[T],\r\n  555:     slot_fn: Callable[..., str],\r\n  556:     base_temperature: float,\r\n  557:     structural_retry_temperature: float,\r\n  558:     repair_prompt_factory: Optional[RepairPromptFactory] = None,\r\n  559:     post_validator: Optional[Callable[[T], Optional[str]]] = None,\r\n  560:     max_new_tokens: int = _STRUCTURED_MAX_NEW_TOKENS,\r\n  561:     max_attempts: int = _DEFAULT_MAX_ATTEMPTS,\r\n  562:     helper_name: str = \"structured_call\",\r\n  563: ) -> T:\r\n  564:     \"\"\"Run a structured-JSON LLM call through the shared retry ladder.\r\n  565: \r\n  566:     Returns the validated `schema` instance from the first attempt that\r\n  567:     yields a schema-valid result. Raises `StructuredCallFailedError`\r\n  568:     when the ladder is exhausted -- never returns a silent sentinel.\r\n  569: \r\n  570:     Parameters (all keyword-only):\r\n  571:       prompt\r\n  572:         The user/system message payload for the LLM call. A plain\r\n  573:         string is wrapped into a single `user` message; an existing\r\n  574:         messages list is passed through.\r\n  575:       schema\r\n  576:         A pydantic model class. The LLM response is parsed and\r\n  577:         validated against it; the validated instance is returned.\r\n  578:       slot_fn\r\n  579:         The LLM generate callable. Signature in this codebase:\r\n  580:         `slot_fn(messages, *, temperature, max_new_tokens[, stop])\r\n  581:         -> str`.\r\n  582:       base_temperature\r\n  583:         Attempt 1 temperature.\r\n  584:       structural_retry_temperature\r\n  585:         Attempt 2 temperature. MUST be strictly lower than\r\n  586:         `base_temperature` (the 2B principle -- the structural retry\r\n  587:         lowers entropy, it does not raise it). The invariant is\r\n  588:         asserted at entry and fails loud if violated.\r\n  589:       repair_prompt_factory\r\n  590:         Callable that builds the Attempt 3 typed-repair prompt from the\r\n  591:         failed output + the validation error. `None` selects\r\n  592:         `default_repair_prompt_factory`. A factory may instead return a\r\n  593:         finished `schema` instance, which is accepted directly with no\r\n  594:         LLM repair call (see `RepairPromptFactory`). The built repair\r\n  595:         messages are cached for one syntax-only retry if budget remains.\r\n  596:       post_validator\r\n  597:         Optional content check run on every schema-valid instance,\r\n  598:         `post_validator(instance) -> str | None`. It returns an error\r\n  599:         string to REJECT the instance (a content failure pydantic\r\n  600:         cannot see -- e.g. a voice preset outside the runtime pool, a\r\n  601:         news brief below the key-term floor, a speaker outside the\r\n  602:         locked cast) or `None` to ACCEPT it. A rejection is raised as\r\n  603:         `PostValidationError` and advances the ladder exactly like a\r\n  604:         schema failure. Mirrors the `extra_check` idiom already used by\r\n  605:         `_otr_outline._run_call_with_retry`. `None` disables the check.\r\n  606:       max_new_tokens\r\n  607:         Token budget passed to `slot_fn` on every attempt. Structured\r\n  608:         passes vary widely -- a story-brief reflection needs ~160, a\r\n  609:         cast-contract audit ~2000, a script-doctor pass ~3500 -- so the\r\n  610:         caller sets its own budget. Defaults to\r\n  611:         `_STRUCTURED_MAX_NEW_TOKENS` (512) for a small JSON object.\r\n  612:       max_attempts\r\n  613:         Caps the ladder (default 3).\r\n  614:       helper_name\r\n  615:         Short string for logging / slot attribution.\r\n  616: \r\n  617:     The ladder (stops at the first schema-valid result that also\r\n  618:     clears `post_validator`; only `json.JSONDecodeError`,\r\n  619:     `pydantic.ValidationError`, and `PostValidationError` are recoverable\r\n  620:     -- a plain `ValueError` propagates):\r\n  621:       Attempt 1: `slot_fn` at `base_temperature`.\r\n  622:       Structural retry: SAME prompt at `structural_retry_temperature`\r\n  623:                  (lower) -- run ONLY when the prior failure was a\r\n  624:                  `json.JSONDecodeError` (malformed JSON a calmer re-prompt\r\n  625:                  may fix). A `ValidationError` / `PostValidationError`\r\n  626:                  SKIPS this rung (a re-prompt re-emits the same bad shape\r\n  627:                  and only burns tokens) and goes straight to typed repair.\r\n  628:       Typed repair: `repair_prompt_factory` either builds a repair prompt\r\n  629:                  (run at the static low temperature `_REPAIR_TEMPERATURE`)\r\n  630:                  or hands back a finished `schema` instance, returned\r\n  631:                  directly with no LLM call.\r\n  632:       Repair syntax retry: if the typed repair returned non-decodable JSON\r\n  633:                  and budget remains, retry its exact cached prompt once at\r\n  634:                  a bounded temperature above the static repair floor. This\r\n  635:                  does not run for schema or content rejection.\r\n  636:     \"\"\"\r\n  637:     # --- Invariant: structural retry must LOWER temperature (2B). ---\r\n  638:     # Fail loud at entry. A structural retry at >= base temperature is\r\n  639:     # a configuration bug, not a recoverable runtime state.\r\n  640:     if not structural_retry_temperature < base_temperature:\r\n  641:         raise ValueError(\r\n  642:             f\"[OTR_StructuredCall] '{helper_name}': \"\r\n  643:             f\"structural_retry_temperature ({structural_retry_temperature}) \"\r\n  644:             f\"must be STRICTLY LOWER than base_temperature \"\r\n  645:             f\"({base_temperature}). Raising entropy during JSON-schema \"\r\n  646:             \"repair encourages more structural hallucination, not less; \"\r\n  647:             \"the structural retry lowers temperature.\"\r\n  648:         )\r\n  649: \r\n  650:     if max_attempts < 1:\r\n  651:         raise ValueError(\r\n  652:             f\"[OTR_StructuredCall] '{helper_name}': max_attempts must be \"\r\n  653:             f\">= 1, got {max_attempts}\"\r\n  654:         )\r\n  655: \r\n  656:     factory: RepairPromptFactory = (\r\n  657:         repair_prompt_factory\r\n  658:         if repair_prompt_factory is not None\r\n  659:         else default_repair_prompt_factory\r\n  660:     )\r\n  661: \r\n  662:     base_messages = _prompt_to_messages(prompt)\r\n  663:     last_error: Optional[BaseException] = None\r\n  664:     last_raw: str = \"\"\r\n  665:     attempts_run = 0\r\n  666:     repair_messages: Any = None\r\n  667: \r\n  668:     # --- Attempt 1: base temperature. ---\r\n  669:     if attempts_run < max_attempts:\r\n  670:         attempts_run += 1\r\n  671:         log.info(\r\n  672:             \"[OTR_StructuredCall] '%s' attempt %d/%d: base call at \"\r\n  673:             \"temperature=%.3f\",\r\n  674:             helper_name, attempts_run, max_attempts, base_temperature,\r\n  675:         )\r\n  676:         try:\r\n  677:             last_raw = _invoke_slot(\r\n  678:                 slot_fn, base_messages,\r\n  679:                 temperature=base_temperature,\r\n  680:                 max_new_tokens=max_new_tokens,\r\n  681:             )\r\n  682:             return _parse_and_validate(last_raw, schema, post_validator)\r\n  683:         except (json.JSONDecodeError, ValidationError, PostValidationError) as exc:\r\n  684:             last_error = exc\r\n  685:             log.warning(\r\n  686:                 \"[OTR_StructuredCall] '%s' attempt %d failed: %s | raw \"\r\n  687:                 \"head: %s\", helper_name, attempts_run, exc,\r\n  688:                 _raw_head(last_raw),\r\n  689:             )\r\n  690: \r\n  691:     # --- Structural retry: SAME prompt, lower temperature -- ONLY for a JSON\r\n  692:     # SYNTAX failure. A re-prompt at lower temperature can shake loose a\r\n  693:     # parseable object when the model emitted malformed JSON. It does NOT help a\r\n  694:     # ValidationError / PostValidationError (the JSON parsed; the SHAPE or\r\n  695:     # CONTENT is wrong) -- a re-prompt just re-emits the same shape, burning a\r\n  696:     # credit-billed call (the 2026-06-25 Opus normalize_length exhaustion: the\r\n  697:     # structural rung never helped, it only spent tokens). So on a non-syntax\r\n  698:     # failure skip straight to the typed repair; spend the structural retry only\r\n  699:     # on json.JSONDecodeError. attempts_run advances ONLY when this branch runs.\r\n  700:     if attempts_run < max_attempts and isinstance(last_error, json.JSONDecodeError):\r\n  701:         attempts_run += 1\r\n  702:         log.info(\r\n  703:             \"[OTR_StructuredCall] '%s' attempt %d/%d: structural retry at \"\r\n  704:             \"temperature=%.3f (lowered from %.3f)\",\r\n  705:             helper_name, attempts_run, max_attempts,\r\n  706:             structural_retry_temperature, base_temperature,\r\n  707:         )\r\n  708:         try:\r\n  709:             last_raw = _invoke_slot(\r\n  710:                 slot_fn, base_messages,\r\n  711:                 temperature=structural_retry_temperature,\r\n  712:                 max_new_tokens=max_new_tokens,\r\n  713:             )\r\n  714:             return _parse_and_validate(last_raw, schema, post_validator)\r\n  715:         except (json.JSONDecodeError, ValidationError, PostValidationError) as exc:\r\n  716:             last_error = exc\r\n  717:             log.warning(\r\n  718:                 \"[OTR_StructuredCall] '%s' attempt %d failed: %s | raw \"\r\n  719:                 \"head: %s\", helper_name, attempts_run, exc,\r\n  720:                 _raw_head(last_raw),\r\n  721:             )\r\n  722: \r\n  723:     # --- Typed repair at a static low temperature (the final rung). ---\r\n  724:     if attempts_run < max_attempts:\r\n  725:         attempts_run += 1\r\n  726:         log.info(\r\n  727:             \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair at \"\r\n  728:             \"temperature=%.3f\",\r\n  729:             helper_name, attempts_run, max_attempts, _REPAIR_TEMPERATURE,\r\n  730:         )\r\n  731:         try:\r\n  732:             repair_error: BaseException = (\r\n  733:                 last_error\r\n  734:                 if last_error is not None\r\n  735:                 else ValueError(\"no prior error captured\")\r\n  736:             )\r\n  737:             repair_prompt = factory(\r\n  738:                 original_prompt=prompt,\r\n  739:                 failed_output=last_raw,\r\n  740:                 error=repair_error,\r\n  741:             )\r\n  742:             # A typed repair factory MAY resolve the failure itself --\r\n  743:             # e.g. cast_membership_repair remapping a phantom speaker to\r\n  744:             # a locked-cast member via Levenshtein -- and hand back a\r\n  745:             # finished `schema` instance instead of a repair prompt.\r\n  746:             # Accept it directly: no LLM repair call is made. The\r\n  747:             # instance still passes through post_validator so a\r\n  748:             # deterministic \"fix\" that is itself content-invalid fails\r\n  749:             # the ladder loudly rather than slipping through.\r\n  750:             if isinstance(repair_prompt, schema):\r\n  751:                 if post_validator is not None:\r\n  752:                     content_error = post_validator(repair_prompt)\r\n  753:                     if content_error is not None:\r\n  754:                         raise PostValidationError(content_error)\r\n  755:                 log.info(\r\n  756:                     \"[OTR_StructuredCall] '%s' attempt %d: repair factory \"\r\n  757:                     \"resolved the failure deterministically; no LLM \"\r\n  758:                     \"repair call made\",\r\n  759:                     helper_name, attempts_run,\r\n  760:                 )\r\n  761:                 return repair_prompt\r\n  762:             repair_messages = _prompt_to_messages(repair_prompt)\r\n  763:             last_raw = _invoke_slot(\r\n  764:                 slot_fn, repair_messages,\r\n  765:                 temperature=_REPAIR_TEMPERATURE,\r\n  766:                 max_new_tokens=max_new_tokens,\r\n  767:             )\r\n  768:             return _parse_and_validate(last_raw, schema, post_validator)\r\n  769:         except (json.JSONDecodeError, ValidationError, PostValidationError) as exc:\r\n  770:             last_error = exc\r\n  771:             log.warning(\r\n  772:                 \"[OTR_StructuredCall] '%s' attempt %d (repair) failed: \"\r\n  773:                 \"%s | raw head: %s\",\r\n  774:                 helper_name, attempts_run, exc, _raw_head(last_raw),\r\n  775:             )\r\n  776: \r\n  777:     # A semantic/schema failure on the base call skips the structural rung,\r\n  778:     # so typed repair can be attempt 2 of a three-call budget. If that repair\r\n  779:     # starts but does not finish decodable JSON, spend the one remaining call\r\n  780:     # on the exact same repair prompt. Do not rebuild it from the incomplete\r\n  781:     # response (which would enlarge the prompt), and do not retry a repair that\r\n  782:     # was itself schema-valid but content-invalid.\r\n  783:     if (\r\n  784:         attempts_run < max_attempts\r\n  785:         and repair_messages is not None\r\n  786:         and isinstance(last_error, json.JSONDecodeError)\r\n  787:     ):\r\n  788:         attempts_run += 1\r\n  789:         retry_temperature = min(\r\n  790:             base_temperature,\r\n  791:             max(structural_retry_temperature, _REPAIR_SYNTAX_RETRY_FLOOR),\r\n  792:         )\r\n  793:         log.info(\r\n  794:             \"[OTR_StructuredCall] '%s' attempt %d/%d: typed repair syntax \"\r\n  795:             \"retry at temperature=%.3f\",\r\n  796:             helper_name, attempts_run, max_attempts, retry_temperature,\r\n  797:         )\r\n  798:         try:\r\n  799:             last_raw = _invoke_slot(\r\n  800:                 slot_fn, repair_messages,\r\n  801:                 temperature=retry_temperature,\r\n  802:                 max_new_tokens=max_new_tokens,\r\n  803:             )\r\n  804:             return _parse_and_validate(last_raw, schema, post_validator)\r\n  805:         except (json.JSONDecodeError, ValidationError, PostValidationError) as exc:\r\n  806:             last_error = exc\r\n  807:             log.warning(\r\n  808:                 \"[OTR_StructuredCall] '%s' attempt %d (repair syntax retry) \"\r\n  809:                 \"failed: %s | raw head: %s\",\r\n  810:                 helper_name, attempts_run, exc, _raw_head(last_raw),\r\n  811:             )\r\n  812: \r\n  813:     # --- Ladder exhausted: fail loud. ---\r\n  814:     log.error(\r\n  815:         \"[OTR_StructuredCall] '%s' exhausted the retry ladder after %d \"\r\n  816:         \"attempt(s); raising StructuredCallFailedError\",\r\n  817:         helper_name, attempts_run,\r\n  818:     )\r\n  819:     raise StructuredCallFailedError(\r\n  820:         helper_name=helper_name,\r\n  821:         attempts=attempts_run,\r\n  822:         last_error=last_error,\r\n  823:     )\r\n  824: \r\n  825: \r\n","exit_code":0,"status":"completed"}}
