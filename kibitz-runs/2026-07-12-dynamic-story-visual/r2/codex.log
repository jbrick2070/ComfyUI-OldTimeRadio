graph.\r\n 410:     \"\"\"\r\n 411:     try:\r\n 412:         data = parse_first_json_object(failed_output)\r\n 413:     except (json.JSONDecodeError, ValueError, TypeError):\r\n 414:         return None\r\n 415:     if not isinstance(data, dict):\r\n 416:         return None\r\n 417:     threads = data.get(\"caller_threads\")\r\n 418:     if not isinstance(threads, list) or not all(\r\n 419:         isinstance(row, dict) for row in threads\r\n 420:     ):\r\n 421:         return None\r\n 422: \r\n 423:     changed = False\r\n 424:     for collection in (\r\n 425:         \"causal_steps\", \"audible_clues\", \"interpretations\", \"resolution_links\",\r\n 426:     ):\r\n 427:         lifted: list[Any] = []\r\n 428:         for row in threads:\r\n 429:             if collection not in row:\r\n 430:                 continue\r\n 431:             nested = row[collection]\r\n 432:             if not isinstance(nested, list):\r\n 433:                 return None\r\n 434:             del row[collection]\r\n 435:             lifted.extend(nested)\r\n 436:             changed = True\r\n 437:         if not lifted:\r\n 438:             continue\r\n 439:         existing = data.get(collection)\r\n 440:         if existing is None:\r\n 441:             existing = []\r\n 442:         if not isinstance(existing, list):\r\n 443:             return None\r\n 444:         data[collection] = existing if existing else lifted\r\n 445: \r\n 446:     if not changed:\r\n 447:         return None\r\n 448:     try:\r\n 449:         repaired = AudibleTruthMap.model_validate(data)\r\n 450:     except ValidationError:\r\n 451:         return None\r\n 452:     if _validate_truth_map(repaired, selected) is not None:\r\n 453:         return None\r\n 454:     return repaired\r\n 455: \r\n 456: \r\n 457: def _repair_score_collection_placement(\r\n 458:     failed_output: str,\r\n 459:     truth: AudibleTruthMap,\r\n 460: ) -> BroadcastScore | None:\r\n 461:     \"\"\"Normalize scene/shot/beat placement without rewriting authored values.\"\"\"\r\n 462:     try:\r\n 463:         data = parse_first_json_object(failed_output)\r\n 464:     except (json.JSONDecodeError, ValueError, TypeError):\r\n 465:         return None\r\n 466:     if not isinstance(data, dict):\r\n 467:         return None\r\n 468:     scenes = data.get(\"scenes\")\r\n 469:     if not isinstance(scenes, list) or not all(\r\n 470:         isinstance(row, dict) for row in scenes\r\n 471:     ):\r\n 472:         return None\r\n 473: \r\n 474:     changed = False\r\n 475:     nested_shots: list[Any] = []\r\n 476:     for scene in scenes:\r\n 477:         if \"shots\" not in scene:\r\n 478:             continue\r\n 479:         value = scene[\"shots\"]\r\n 480:         if not isinstance(value, list):\r\n 481:             return None\r\n 482:         del scene[\"shots\"]\r\n 483:         nested_shots.extend(value)\r\n 484:         changed = True\r\n 485:     top_shots = data.get(\"shots\")\r\n 486:     if top_shots is None:\r\n 487:         top_shots = []\r\n 488:     if not isinstance(top_shots, list):\r\n 489:         return None\r\n 490:     data[\"shots\"] = top_shots if top_shots else nested_shots\r\n 491:     if not all(isinstance(row, dict) for row in data[\"shots\"]):\r\n 492:         return None\r\n 493: \r\n 494:     nested_beats: list[Any] = []\r\n 495:     for shot in data[\"shots\"]:\r\n 496:         if \"beats\" not in shot:\r\n 497:             continue\r\n 498:         value = shot[\"beats\"]\r\n 499:         if not isinstance(value, list):\r\n 500:             return None\r\n 501:         del shot[\"beats\"]\r\n 502:         nested_beats.extend(value)\r\n 503:         changed = True\r\n 504:     top_beats = data.get(\"beats\")\r\n 505:     if top_beats is None:\r\n 506:         top_beats = []\r\n 507:     if not isinstance(top_beats, list):\r\n 508:         return None\r\n 509:     data[\"beats\"] = top_beats if top_beats else nested_beats\r\n 510: \r\n 511:     if not changed:\r\n 512:         return None\r\n 513:     try:\r\n 514:         repaired = BroadcastScore.model_validate(data)\r\n 515:     except ValidationError:\r\n 516:         return None\r\n 517:     if _validate_score(repaired, truth) is not None:\r\n 518:         return None\r\n 519:     return repaired\r\n 520: \r\n","exit_code":0,"status":"completed"}}
