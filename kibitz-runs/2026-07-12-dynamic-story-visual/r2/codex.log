{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(1140,1238),@(1240,1368)); $content=Get-Content -LiteralPath '\"'nodes\\\\otr_meta_brief_image_prompt.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"===== 1140-1238 =====\r\n 1140:         if str(ln.get(\"speaker_role\") or \"\") != \"announcer\":\r\n 1141:             continue\r\n 1142:         cid = str(ln.get(\"char_id\") or \"\") or ANNOUNCER_CHAR_ID\r\n 1143:         if cid not in out:\r\n 1144:             out.append(cid)\r\n 1145:     return out\r\n 1146: \r\n 1147: \r\n 1148: def compose_image_prompt_fallback(meta: dict, char: dict, aspect: str = \"portrait\",\r\n 1149:                                   talking: bool = False, style=None) -> str:\r\n 1150:     \"\"\"Deterministic brief-composed portrait prompt -- NEVER empty.\r\n 1151: \r\n 1152:     ``\"{appearance}, {setting} setting, {style anchor}\"`` with empty parts\r\n 1153:     dropped; degrades to the style anchor alone if the brief + cast are bare.\r\n 1154:     ``talking`` swaps in the face-forward lip-sync anchor (S4b).\r\n 1155:     Chunk A1: ``style`` is the resolved visual-style pack threaded from the\r\n 1156:     image-prompt entry (None => this IS the entry: fail-loud resolve).\r\n 1157:     \"\"\"\r\n 1158:     try:\r\n 1159:         from ._otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1160:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1161:         from _otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1162:     _vstyle = _resolve_style(meta, style)\r\n 1163:     # Same key chain as _appearance_for_char incl. character_description\r\n 1164:     # (2026-06-10): this fallback is what actually runs whenever the LLM is\r\n 1165:     # unavailable, and it read only the two empty keys -- every character got\r\n 1166:     # the identical setting+anchor prompt -> ONE shared portrait.\r\n 1167:     appearance = str(\r\n 1168:         (char or {}).get(\"portrait_prompt\") or (char or {}).get(\"appearance\")\r\n 1169:         or (char or {}).get(\"character_description\") or \"\"\r\n 1170:     ).strip()\r\n 1171:     setting = _read_setting(meta)\r\n 1172:     parts = []\r\n 1173:     if appearance:\r\n 1174:         parts.append(appearance)\r\n 1175:     if setting:\r\n 1176:         parts.append(f\"{setting} setting\")\r\n 1177:     parts.append(_style_anchor_for_aspect(aspect, talking=talking,\r\n 1178:                                           style=_vstyle))\r\n 1179:     return _ensure_gender_anchor(\", \".join(parts), char)\r\n 1180: \r\n 1181: \r\n 1182: def _build_char_prompt_request(char: dict, meta: dict, setting: str,\r\n 1183:                                aspect: str = \"portrait\",\r\n 1184:                                talking: bool = False, style=None) -> str:\r\n 1185:     \"\"\"The instruction handed to the writer LLM (temp=0) for one character.\r\n 1186: \r\n 1187:     ``aspect`` ('wide'|'portrait') drives the framing clause so a 16:9 still asks\r\n 1188:     for a head-and-shoulders shot (the head fits the short frame) while a portrait\r\n 1189:     still keeps the three-quarter look -- both with explicit headroom so the top of\r\n 1190:     the head is never cropped (operator framing catch 2026-06-17). ``talking``\r\n 1191:     (S4b) overrides both with the face-forward lip-sync framing: the ia2v\r\n 1192:     recipe drives the mouth on THIS still, so a profile / distant / dim face\r\n 1193:     is unusable (proof8 catch 2026-07-02). Chunk A1: the LLM-facing LOOK\r\n 1194:     language (the old hard-coded \"photographic and period-consistent\") comes\r\n 1195:     from the pack's ``portrait_instruction_look``; ``style`` is the resolved\r\n 1196:     pack threaded from the entry (None => fail-loud resolve here).\"\"\"\r\n 1197:     try:\r\n 1198:         from ._otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1199:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1200:         from _otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1201:     _vstyle = _resolve_style(meta, style)\r\n 1202:     appearance = _ensure_gender_anchor(\r\n 1203:         _appearance_for_char([char], str(char.get(\"char_id\") or \"\")),\r\n 1204:         char)\r\n 1205:     if talking:\r\n 1206:         framing = (\r\n 1207:             \"face-forward frontal close-up bust looking DIRECTLY at the camera, \"\r\n 1208:             \"the whole face and mouth clearly visible and unobstructed (never a \"\r\n 1209:             \"profile, never turned away), the face brightly lit and filling much \"\r\n 1210:             \"of the frame, with headroom so the top of the head is never cropped\"\r\n 1211:         )\r\n 1212:     else:\r\n 1213:         framing = (\r\n 1214:             \"head-and-shoulders medium framing, the subject centred with the FULL head \"\r\n 1215:             \"visible and headroom above the head so the top of the head is never cropped\"\r\n 1216:             if str(aspect).lower() == \"wide\" else\r\n 1217:             \"three-quarter framing showing the full head and upper body, with headroom \"\r\n 1218:             \"above the head so the top of the head is never cropped\"\r\n 1219:         )\r\n 1220:     return (\r\n 1221:         \"Write ONE vivid still-image portrait prompt (a single comma-separated \"\r\n 1222:         \"line, no preamble) for this character. The image MUST depict the \"\r\n 1223:         \"CHARACTER THEMSELVES -- a person with a clearly visible face, \"\r\n 1224:         f\"{framing} -- IN CHARACTER \"\r\n 1225:         \"inside the story's world. NEVER an empty room, an object, or scenery \"\r\n 1226:         \"alone. Ground it in the appearance and the story setting; keep it \"\r\n 1227:         f\"{_vstyle.portrait_instruction_look}.\\n\"\r\n 1228:         f\"character_appearance: {appearance or '(unspecified)'}\\n\"\r\n 1229:         f\"story_setting: {setting or '(unspecified)'}\\n\"\r\n 1230:         \"style_anchor: \"\r\n 1231:         f\"{_style_anchor_for_aspect(aspect, talking=talking, style=_vstyle)}\\n\"\r\n 1232:         \"Do not include film-stock, film-grain, or lighting-style terms; \"\r\n 1233:         \"they are appended automatically later.\\n\"\r\n 1234:         \"Do not mention radios, microphones, studios, or any broadcasting \"\r\n 1235:         \"equipment anywhere in the prompt -- the character is a person in \"\r\n 1236:         \"the STORY's world, not a performer at a station.\\n\"\r\n 1237:         \"Return only the prompt line.\"\r\n 1238:     )\r\n===== 1240-1368 =====\r\n 1240: \r\n 1241: def _build_char_scene_request(char: dict, meta: dict, setting: str,\r\n 1242:                               line: dict, style=None) -> str:\r\n 1243:     \"\"\"BUG 1 follow-up (2026-06-20 operator): the per-beat character still must be\r\n 1244:     SHOT/BEAT AWARE -- the character IN the moment of THIS beat -- regardless of\r\n 1245:     image model (the video lane conditions on the SAME still). Mirrors\r\n 1246:     :func:`_build_char_prompt_request` but WIDE 16:9 and grounded in the beat's\r\n 1247:     own ``beat_intent`` / ``traits`` / spoken ``text`` so each character beat\r\n 1248:     yields a DISTINCT still. Temp=0 like the portrait path -> deterministic.\r\n 1249:     Chunk A1: this builder has NO existing look text, so the pack's\r\n 1250:     ``scene_instruction_look`` is appended ONLY when non-empty (sci_fi ships\r\n 1251:     \"\" -- byte-identity by construction, r4 AG M1); ``style`` is the resolved\r\n 1252:     pack threaded from the entry (None => fail-loud resolve here).\"\"\"\r\n 1253:     try:\r\n 1254:         from ._otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1255:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1256:         from _otr_story_brief_helpers import _resolve_style  # type: ignore\r\n 1257:     _vstyle = _resolve_style(meta, style)\r\n 1258:     _look_line = (f\"style_look: {_vstyle.scene_instruction_look}\\n\"\r\n 1259:                   if _vstyle.scene_instruction_look else \"\")\r\n 1260:     appearance = _appearance_for_char([char], str(char.get(\"char_id\") or \"\"))\r\n 1261:     ln = line if isinstance(line, dict) else {}\r\n 1262:     intent = str(ln.get(\"beat_intent\") or \"\").strip()[:240]\r\n 1263:     mood = str(ln.get(\"traits\") or \"\").strip()[:80]\r\n 1264:     said = str(ln.get(\"text\") or \"\").strip()[:240]\r\n 1265:     return (\r\n 1266:         \"Write ONE vivid cinematic STILL-image prompt (a single comma-separated \"\r\n 1267:         \"line, no preamble) for a 16:9 LANDSCAPE shot of this character at THIS \"\r\n 1268:         \"moment of the scene. The image MUST show the CHARACTER THEMSELVES -- a \"\r\n 1269:         \"person with a clearly visible face -- as the subject, a medium/wide shot \"\r\n 1270:         \"with the full head and headroom, framed inside the story's world; convey \"\r\n 1271:         \"the ACTION and EMOTION of this beat. Translate the beat into what is \"\r\n 1272:         \"VISIBLE (pose, expression, what they are doing) -- do NOT write the \"\r\n 1273:         \"character's name, dialogue, narration, or any on-screen text. NEVER an \"\r\n 1274:         \"empty room, an object, or scenery alone.\\n\"\r\n 1275:         f\"character_appearance: {appearance or '(unspecified)'}\\n\"\r\n 1276:         f\"beat_action: {intent or '(unspecified)'}\\n\"\r\n 1277:         f\"emotion: {mood or '(unspecified)'}\\n\"\r\n 1278:         f\"they_are_saying: {said or '(unspecified)'}\\n\"\r\n 1279:         f\"story_setting: {setting or '(unspecified)'}\\n\"\r\n 1280:         f\"style_anchor: {_style_anchor_for_aspect('wide', style=_vstyle)}\\n\"\r\n 1281:         f\"{_look_line}\"\r\n 1282:         \"Do not include film-stock, film-grain, or lighting-style terms; \"\r\n 1283:         \"they are appended automatically later.\\n\"\r\n 1284:         \"Do not mention radios, microphones, studios, or any broadcasting \"\r\n 1285:         \"equipment -- the character is a person in the STORY's world.\\n\"\r\n 1286:         \"Return only the prompt line.\"\r\n 1287:     )\r\n 1288: \r\n 1289: \r\n 1290: def _compose_char_scene_prompt(meta, char_entry, setting, line, llm_fn,\r\n 1291:                                warnings, cid, max_reseed=2, vstyle=None):\r\n 1292:     \"\"\"Beat-aware 16:9 character still prompt -> ``(prompt, source)``. LLM-refined\r\n 1293:     (the beat's action/emotion) when a writer LLM is available -- so each beat\r\n 1294:     differs -- else the deterministic per-character ``scene_character`` composer.\r\n 1295:     Always depicts the CHARACTER, never a radio booth. Guards + finishes exactly\r\n 1296:     like the portrait path (person guard, gear scrub, era+grade tail, no-text\r\n 1297:     clause).\"\"\"\r\n 1298:     ce = char_entry if isinstance(char_entry, dict) else {}\r\n 1299:     prompt = \"\"\r\n 1300:     source = \"char_scene_template\"\r\n 1301:     said = str((line or {}).get(\"text\") or \"\").strip()\r\n 1302:     # A writer LLM present AND a spoken line = the LLM lane was ATTEMPTED; if it\r\n 1303:     # then fails/returns junk we FAIL LOUD rather than swap to the deterministic\r\n 1304:     # composer (no-fallback rip 2026-07-03). llm_fn=None (no writer LLM) or a\r\n 1305:     # dialogue-less beat is the legit template lane, not a failure.\r\n 1306:     _llm_attempted = llm_fn is not None and bool(said)\r\n 1307:     if _llm_attempted:\r\n 1308:         req = _build_char_scene_request(ce, meta, setting, line, style=vstyle)\r\n 1309:         for attempt in range(max_reseed + 1):\r\n 1310:             try:\r\n 1311:                 raw = llm_fn(req)\r\n 1312:             except Exception as exc:  # noqa: BLE001\r\n 1313:                 warnings.append(f\"char-scene llm_fn raised for {cid} ({exc}); \"\r\n 1314:                                 f\"reseed {attempt}\")\r\n 1315:                 raw = \"\"\r\n 1316:             cand = _clean_llm_prompt(raw)\r\n 1317:             if cand:\r\n 1318:                 prompt = cand\r\n 1319:                 source = \"char_scene_llm\"\r\n 1320:                 break\r\n 1321:     # Person/face analysis REMOVED (operator directive 2026-07-04): no person\r\n 1322:     # detector discards or annotates a beat still. The gear scrub below still runs;\r\n 1323:     # an EMPTY LLM return still fails loud at the gate further down.\r\n 1324:     if prompt:\r\n 1325:         scrubbed = _scrub_gear_words(prompt)\r\n 1326:         if scrubbed != prompt:\r\n 1327:             warnings.append(f\"char-scene prompt for {cid}: broadcast-gear scrubbed\")\r\n 1328:             prompt = scrubbed or \"\"\r\n 1329:     try:\r\n 1330:         from ._otr_story_brief_helpers import (  # type: ignore\r\n 1331:             compose_still_prompt)\r\n 1332:     except ImportError:  # pragma: no cover -- flat test imports\r\n 1333:         from _otr_story_brief_helpers import (  # type: ignore\r\n 1334:             compose_still_prompt)\r\n 1335:     if not prompt:\r\n 1336:         if _llm_attempted:\r\n 1337:             raise RuntimeError(\r\n 1338:                 \"[OTR_ImagePrompt] char-scene: the writer LLM produced no usable \"\r\n 1339:                 \"PERSON prompt for %s (empty / non-person / all-gear after %d \"\r\n 1340:                 \"reseeds) -- NO deterministic template fallback (no-fallback rip \"\r\n 1341:                 \"2026-07-03); a failed char-scene LLM stops the episode.\"\r\n 1342:                 % (cid, max_reseed)\r\n 1343:             )\r\n 1344:         # No writer LLM (or a dialogue-less beat): the deterministic per-character\r\n 1345:         # scene composer is the PRIMARY