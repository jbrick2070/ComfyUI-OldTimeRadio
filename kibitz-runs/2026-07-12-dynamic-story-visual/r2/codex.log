{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ranges=@(@(790,1030),@(1061,1140),@(725,765)); $content=Get-Content -LiteralPath '\"'nodes\\\\_otr_model_loader.py'; foreach(\"'$range in $ranges){ Write-Output \"===== $($range[0])-$($range[1]) =====\"; for($n=$range[0];$n -le $range[1];$n++){ '\"'{0,5}: {1}' -f \"'$n,$content[$n-1] } }'","aggregated_output":"===== 790-1030 =====\r\n  790: def request_slot(slot: str, model_id: str, policy: Any = None) -> dict[str, Any]:\r\n  791:     \"\"\"Slot-aware entry point. Loads (or reuses cached) LLM, handling\r\n  792:     cache reuse vs full teardown automatically.\r\n  793: \r\n  794:     B1d order (vram-fit BEFORE any network/disk work):\r\n  795:       1. normalize model_id via catalog.validate_model_id (strips\r\n  796:          [NOT DOWNLOADED] suffix, structural rejection, admit-path check).\r\n  797:       2. Cache hit (same model_id resident) -> return entry. Done.\r\n  798:       3. resolve_context_cap(model_id) -> tiered ContextCapVerdict.\r\n  799:       4. check_vram_fit(model_id, ctx_verdict.value) -> tiered VRAMFitVerdict.\r\n  800:       5. FAIL -> raise VRAMFitFailedError. CRITICAL: this fires BEFORE\r\n  801:          auto_download so a 70B-on-16GB pick never triggers a network\r\n  802:          pull or a disk-space pre-check pass on a doomed-to-fail load.\r\n  803:       6. Combined caution log (anything below PASS/PASS).\r\n  804:       7. auto_download_if_missing -- gated/disk-space pre-flight +\r\n  805:          snapshot_download. Local-cache short-circuit fires inside the\r\n  806:          catalog helper.\r\n  807:       8. unload_llm() (only if a different model was resident), then\r\n  808:          load_llm(model_id, context_cap=ctx_verdict.value) -- skips the\r\n  809:          second catalog walk by forwarding the resolved cap.\r\n  810:       9. Cache the entry under (slot, model_id).\r\n  811: \r\n  812:     `slot` is \"creative\" or \"technical\" -- used for log lines + cache\r\n  813:     keying. The cache holds at most one resident model regardless of\r\n  814:     slot; same-slot reuse and cross-slot identity-reuse both return the\r\n  815:     cached entry without a full teardown.\r\n  816:     \"\"\"\r\n  817:     from . import _otr_model_catalog as _otr_catalog\r\n  818:     from ._otr_model_inputs import VRAMFitFailedError\r\n  819:     from ._otr_shared.llm_policy import BASELINE_POLICY, lane_for_row\r\n  820: \r\n  821:     if slot not in (\"creative\", \"technical\"):\r\n  822:         raise ModelLoaderError(\r\n  823:             f\"request_slot: slot must be 'creative' or 'technical', got {slot!r}\"\r\n  824:         )\r\n  825: \r\n  826:     # S1 platform-portability (2026-07-10): resolve the explicit runtime\r\n  827:     # policy. None = the nv50 baseline (an API backstop for direct callers;\r\n  828:     # every production call-site threads a real policy).\r\n  829:     if policy is None:\r\n  830:         log.info(\"[Selector] slot=%s policy=None -> nv50 BASELINE\", slot)\r\n  831:     _policy = policy if policy is not None else BASELINE_POLICY\r\n  832: \r\n  833:     # Step 1: normalize.\r\n  834:     normalized = _otr_catalog.validate_model_id(model_id)\r\n  835: \r\n  836:     # [OpenRouter S3] Remote branch (FC2 seam 1) -- the dispatch table is\r\n  837:     # otherwise dormant. A virtual catalog row carries\r\n  838:     # loader_backend=\"openrouter_http\"; route it to the remote backend's\r\n  839:     # load(), which returns a provider-tagged cache_entry using ZERO local\r\n  840:     # VRAM. SKIP steps 3-8 (resolve_context_cap, check_vram_fit,\r\n  841:     # auto_download_if_missing, the resident-model teardown, load_llm) and\r\n  842:     # -- critically -- LEAVE any resident local model in LLM_CACHE\r\n  843:     # UNTOUCHED (C2 no-evict). Placed before the Step 2 cache-hit read so\r\n  844:     # a remote request never reads or mutates LLM_CACHE: the common config\r\n  845:     # (creative=remote, technical=local) must not evict + reload the local\r\n  846:     # model across slot transitions. Remote makes zero CUDA / snapshot /\r\n  847:     # download calls.\r\n  848:     # BUG-LOCAL-299: this remote-routing gate shipped recognizing ONLY\r\n  849:     # \"openrouter_http\". A Comfy Credits row (loader_backend=\"comfy_credits_http\")\r\n  850:     # fell through to the LOCAL path below, so ComfyUI tried to HF-download the\r\n  851:     # virtual handle (e.g. \"comfy:slot-a\") -> HFValidationError, aborting the run\r\n  852:     # before the lane was ever exercised. Route BOTH remote loader_backends; the\r\n  853:     # _otr_model_runtime dispatch table already maps each key to its backend, so\r\n  854:     # a future remote lane only adds its key to this tuple.\r\n  855:     # Virtual catalog rows must be intercepted before the HF cache/download\r\n  856:     # path below. Remote rows are zero-VRAM and do not disturb a resident\r\n  857:     # local model. The GGUF row is different: it is in-process VRAM and must\r\n  858:     # participate in the singleton cache/teardown discipline.\r\n  859:     _REMOTE_DISPATCH_BACKENDS = (\"openrouter_http\", \"comfy_credits_http\", \"google_api_http\")\r\n  860:     _GGUF_DISPATCH_BACKENDS = (\"gguf_native\",)\r\n  861:     _virtual_row = _otr_catalog._by_repo_id().get(normalized)\r\n  862: \r\n  863:     # S1 runtime lane backstop: the profile's lane_allowlist is enforced at\r\n  864:     # validate/emit time upstream; this is the last line of defense so a\r\n  865:     # hand-crafted workflow cannot smuggle a disallowed lane through. NO\r\n  866:     # FALLBACK: pick an admitted lane or change the platform profile.\r\n  867:     _lane = lane_for_row(_virtual_row)\r\n  868:     if not _policy.admits_lane(_lane):\r\n  869:         raise ModelLoaderError(\r\n  870:             f\"request_slot: lane '{_lane}' (model {normalized!r}) is not \"\r\n  871:             f\"admitted by the profile lane_allowlist \"\r\n  872:             f\"{list(_policy.lane_allowlist)} -- NO FALLBACK.\"\r\n  873:         )\r\n  874: \r\n  875:     if (\r\n  876:         _virtual_row is not None\r\n  877:         and getattr(_virtual_row, \"loader_backend\", None) in _REMOTE_DISPATCH_BACKENDS\r\n  878:     ):\r\n  879:         from ._otr_model_runtime import get_backend_for_row\r\n  880:         log.info(\r\n  881:             \"[Selector] slot=%s remote-dispatched backend for %s (no local VRAM; \"\r\n  882:             \"resident local model left in place, no-evict)\",\r\n  883:             slot, normalized,\r\n  884:         )\r\n  885:         return get_backend_for_row(_virtual_row).load(\r\n  886:             normalized, _virtual_row, policy=_policy,\r\n  887:         )\r\n  888: \r\n  889:     if (\r\n  890:         _virtual_row is not None\r\n  891:         and getattr(_virtual_row, \"loader_backend\", None) in _GGUF_DISPATCH_BACKENDS\r\n  892:     ):\r\n  893:         from ._otr_model_runtime import get_backend_for_row\r\n  894:         if (\r\n  895:             LLM_CACHE.get(\"model_id\") == normalized\r\n  896:             and LLM_CACHE.get(\"cache_entry\") is not None\r\n  897:         ):\r\n  898:             # S1: a resident model only counts as a hit when it was loaded\r\n  899:             # under the SAME artifact-shaping policy (device / attn /\r\n  900:             # quant / gguf fields). Silent stale-policy reuse is the bug\r\n  901:             # class this campaign kills.\r\n  902:             if LLM_CACHE.get(\"policy_key\") == _policy.cache_key():\r\n  903:                 log.info(\"[Selector] slot=%s reuse cache for %s\", slot, normalized)\r\n  904:                 LLM_CACHE[\"slot\"] = slot\r\n  905:                 return LLM_CACHE[\"cache_entry\"]  # type: ignore[return-value]\r\n  906:             log.info(\r\n  907:                 \"[Selector] policy change for %s (%s -> %s): full teardown\",\r\n  908:                 normalized, LLM_CACHE.get(\"policy_key\"), _policy.cache_key(),\r\n  909:             )\r\n  910:             unload_llm()\r\n  911:         if LLM_CACHE.get(\"model_id\") not in (None, normalized):\r\n  912:             log.info(\r\n  913:                 \"[Selector] slot transition: %s -> %s (full teardown)\",\r\n  914:                 LLM_CACHE.get(\"model_id\"),\r\n  915:                 normalized,\r\n  916:             )\r\n  917:             unload_llm()\r\n  918:         cache_entry = get_backend_for_row(_virtual_row).load(\r\n  919:             normalized, _virtual_row, policy=_policy,\r\n  920:         )\r\n  921:         LLM_CACHE[\"model_id\"] = normalized\r\n  922:         LLM_CACHE[\"slot\"] = slot\r\n  923:         LLM_CACHE[\"cache_entry\"] = cache_entry\r\n  924:         LLM_CACHE[\"policy_key\"] = _policy.cache_key()\r\n  925:         return cache_entry\r\n  926: \r\n  927:     # Step 2: cache hit on the same model id (regardless of slot) -- policy\r\n  928:     # keyed (S1): a mismatched policy_key is a MISS + teardown, never reuse.\r\n  929:     if LLM_CACHE.get(\"model_id\") == normalized and LLM_CACHE.get(\"cache_entry\") is not None:\r\n  930:         if LLM_CACHE.get(\"policy_key\") == _policy.cache_key():\r\n  931:             log.info(\"[Selector] slot=%s reuse cache for %s\", slot, normalized)\r\n  932:             LLM_CACHE[\"slot\"] = slot\r\n  933:             return LLM_CACHE[\"cache_entry\"]  # type: ignore[return-value]\r\n  934:         log.info(\r\n  935:             \"[Selector] policy change for %s (%s -> %s): full teardown\",\r\n  936:             normalized, LLM_CACHE.get(\"policy_key\"), _policy.cache_key(),\r\n  937:         )\r\n  938:         unload_llm()\r\n  939: \r\n  940:     # Step 3: context cap (never raises).\r\n  941:     ctx_verdict = _otr_catalog.resolve_context_cap(normalized)\r\n  942: \r\n  943:     # Step 4: VRAM fit (never raises). Ceiling comes from the policy (S1);\r\n  944:     # 0 = gate DISABLED (cpu tier -- there is no VRAM to fit).\r\n  945:     if _policy.vram_ceiling_gb > 0:\r\n  946:         fit_verdict = _otr_catalog.check_vram_fit(\r\n  947:             normalized, ctx_verdict.value,\r\n  948:             ceiling_gb=_policy.vram_ceiling_gb,\r\n  949:         )\r\n  950: \r\n  951:         # Step 5: FAIL escalates BEFORE any network/disk work. A 70B pick on\r\n  952:         # a 16 GB card must not trigger snapshot_download or a disk-space\r\n  953:         # pre-check pass; both waste minutes on a doomed-to-OOM load.\r\n  954:         if fit_verdict.tier == \"FAIL\":\r\n  955:             raise VRAMFitFailedError(\r\n  956:                 f\"VRAMFitFailedError: {normalized!r}: {fit_verdict.reason}. \"\r\n  957:                 f\"ctx_cap={ctx_verdict.tier}@{ctx_verdict.value}\",\r\n  958:                 estimated_gb=fit_verdict.estimated_gb,\r\n  959:                 ceiling_gb=fit_verdict.ceiling_gb,\r\n  960:             )\r\n  961: \r\n  962:         # Step 6: combined caution log (everything below PASS/PASS).\r\n  963:         if not (fit_verdict.tier == \"PASS\" and ctx_verdict.tier == \"PASS\"):\r\n  964:             log.info(\r\n  965:                 \"[Selector] proceeding with caution: ctx_cap=%s@%d, \"\r\n  966:                 \"vram_fit=%s@%.1f GB\",\r\n  967:                 ctx_verdict.tier,\r\n  968:                 ctx_verdict.value,\r\n  969:                 fit_verdict.tier,\r\n  970:                 fit_verdict.estimated_gb,\r\n  971:             )\r\n  972:     else:\r\n  973:         log.info(\r\n  974:             \"[Selector] VRAM-fit gate disabled by policy \"\r\n  975:             \"(vram_ceiling_gb=0, cpu tier)\"\r\n  976:         )\r\n  977: \r\n  978:     # Step 7: ensure on-disk + handle gating / disk-space pre-flight.\r\n  979:     # Local-cache short-circuit (B1d) fires inside this helper when the\r\n  980:     # snapshot is already on disk.\r\n  981:     _otr_catalog.auto_download_if_missing(normalized)\r\n  982: \r\n  983:     # Step 8: if a different model is resident, unload it. Then load.\r\n  984:     if LLM_CACHE.get(\"model_id\") not in (None, normalized):\r\n  985:         log.info(\r\n  986:             \"[Selector] slot transition: %s -> %s (full teardown)\",\r\n  987:             LLM_CACHE.get(\"model_id\"),\r\n  988:             normalized,\r\n  989:         )\r\n  990:         unload_llm()\r\n  991: \r\n  992:     # Sprint H iter 3 (2026-05-17): orphan-model guard. load_llm may\r\n  993:     # raise AFTER AutoModelForCausalLM.from_pretrained successfully\r\n  994:     # allocates the weights on GPU (e.g. BNB quantization, warmup pass,\r\n  995:     # tripwire). If we re-raise without cleaning up, the LLM_CACHE is\r\n  996:     # never populated (line 744+ is bypassed) AND the orphan model\r\n  997:     # remains resident on GPU. The next request_slot call cache-misses\r\n  998:     # and a SECOND copy gets loaded on top -- producing the\r\n  999:     # \"Currently allocated 29.97 GiB\" OOM on the retry inside\r\n 1000:     # _otr_style_picker._run_inventor's 3-attempt loop. Wrap with\r\n 1001:     # try/except + unload_llm() to guarantee the retry starts from a\r\n 1002:     # clean slate. unload_llm()'s entry-is-None branch is a safe no-op\r\n 1003:     # for the dict update; the empty_cache + ipc_collect + synchronize\r\n 1004:     # still fire and drop the orphan.\r\n 1005:     try:\r\n 1006:         cache_entry = load_llm(\r\n 1007:             normalized, context_cap=ctx_verdict.value, policy=_policy,\r\n 1008:         )\r\n 1009:     except Exception:\r\n 1010:         log.warning(\r\n 1011:             \"[Selector] load_llm raised for %s; running unload_llm() \"\r\n 1012:             \"to drop any orphan VRAM before retry\",\r\n 1013:             normalized,\r\n 1014:         )\r\n 1015:         try:\r\n 1016:             unload_llm()\r\n 1017:         except Exception:  # noqa: BLE001\r\n 1018:             log.exception(\"[Selector] unload_llm() also raised; continuing\")\r\n 1019:         raise\r\n 1020: \r\n 1021:     # Step 9: cache (policy-keyed, S1).\r\n 1022:     LLM_CACHE[\"model_id\"] = normalized\r\n 1023:     LLM_CACHE[\"slot\"] = slot\r\n 1024:     LLM_CACHE[\"cache_entry\"] = cache_entry\r\n 1025:     LLM_CACHE[\"policy_key\"] = _policy.cache_key()\r\n 1026:     return cache_entry\r\n 1027: \r\n 1028: \r\n 1029: # ---------------------------------------------------------------------------\r\n 1030: # make_generate_fn -- chat-template adapter\r\n===== 1061-1140 =====\r\n 1061: def make_generate_fn(cache_entry: dict[str, Any]):\r\n 1062:     \"\"\"Wrap a cache_entry into the GenerateFn callable.\r\n 1063: \r\n 1064:     Returns a callable matching:\r\n 1065:         (messages, *, temperature, max_new_tokens) -> str\r\n 1066: \r\n 1067:     where `messages` is a list[dict] in chat format\r\n 1068:     ([{\"role\": \"system\", \"content\": ...}, {\"role\": \"user\", \"content\": ...}])\r\n 1069:     and the return is the raw decoded string from the model with the\r\n 1070:     prompt prefix removed.\r\n 1071: \r\n 1072:     Generation params hardcoded for the v2.0 path:\r\n 1073:         do_sample=True\r\n 1074:         top_p=0.92\r\n 1075: \r\n 1076:     Caller controls temperature and max_new_tokens per call.\r\n 1077: \r\n 1078:     Raises ModelLoaderError if the cache_entry is missing required\r\n 1079:     keys or if torch is not importable at first call time.\r\n 1080:     \"\"\"\r\n 1081:     # [OpenRouter S3] Remote branch (FC2 seam 2). A provider-tagged\r\n 1082:     # remote entry has no model/tokenizer; return the remote generate_fn\r\n 1083:     # before the local-key check below. Uses zero local VRAM.\r\n 1084:     if cache_entry.get(\"provider\") == \"openrouter\":\r\n 1085:         from ._otr_openrouter_backend import make_openrouter_generate_fn\r\n 1086:         return make_openrouter_generate_fn(cache_entry)\r\n 1087:     # BUG-LOCAL-299: Comfy Credits sibling -- same zero-VRAM remote seam.\r\n 1088:     if cache_entry.get(\"provider\") == \"comfy_credits\":\r\n 1089:         from ._otr_comfy_backend import make_comfy_credits_generate_fn\r\n 1090:         return make_comfy_credits_generate_fn(cache_entry)\r\n 1091:     if cache_entry.get(\"provider\") == \"google_api\":\r\n 1092:         from ._otr_google_api.llm import make_google_api_generate_fn\r\n 1093:         return make_google_api_generate_fn(cache_entry)\r\n 1094:     # Native GGUF lane: in-process llama-cpp-python, no daemon or port.\r\n 1095:     if cache_entry.get(\"provider\") == \"gguf_native\":\r\n 1096:         from ._otr_gguf_backend import make_gguf_generate_fn\r\n 1097:         return make_gguf_generate_fn(cache_entry)\r\n 1098:     required = {\"model\", \"tokenizer\"}\r\n 1099:     missing = required - set(cache_entry)\r\n 1100:     if missing:\r\n 1101:         raise ModelLoaderError(\r\n 1102:             f\"cache_entry missing required keys: {sorted(missing)}\"\r\n 1103:         )\r\n 1104: \r\n 1105:     model = cache_entry[\"model\"]\r\n 1106:     tokenizer = cache_entry[\"tokenizer\"]\r\n 1107: \r\n 1108:     def generate_fn(messages, *, temperature, max_new_tokens):\r\n 1109:         # Lazy torch import. Raised as ModelLoaderError to match the\r\n 1110:         # facade's exception contract.\r\n 1111:         try:\r\n 1112:             import torch\r\n 1113:         except ImportError as exc:\r\n 1114:             raise ModelLoaderError(\"torch not available\") from exc\r\n 1115: \r\n 1116:         messages = _normalize_messages_for_cache_entry(cache_entry, messages)\r\n 1117:         prompt = tokenizer.apply_chat_template(\r\n 1118:             messages, tokenize=False, add_generation_prompt=True\r\n 1119:         )\r\n 1120:         inputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\r\n 1121:         with torch.no_grad():\r\n 1122:             out = model.generate(\r\n 1123:                 **inputs,\r\n 1124:                 do_sample=True,\r\n 1125:                 temperature=temperature,\r\n 1126:                 top_p=0.92,\r\n 1127:                 max_new_tokens=max_new_tokens,\r\n 1128:                 pad_token_id=tokenizer.eos_token_id,\r\n 1129:             )\r\n 1130:         # Strip prompt prefix from decoded output.\r\n 1131:         prompt_len = inputs[\"input_ids\"].shape[1]\r\n 1132:         return tokenizer.decode(\r\n 1133:             out[0][prompt_len:],\r\n 1134:             skip_special_tokens=True,\r\n 1135:         )\r\n 1136: \r\n 1137:     return generate_fn\r\n 1138: \r\n 1139: \r\n 1140: # ---------------------------------------------------------------------------\r\n===== 725-765 =====\r\n  725:         pass\r\n  726: \r\n  727: \r\n  728: def has_local_resident_llm() -> bool:\r\n  729:     \"\"\"True when the singleton cache currently owns a local LLM resource.\r\n  730: \r\n  731:     Remote OpenRouter / Comfy Credits requests deliberately do not populate\r\n  732:     ``LLM_CACHE``. If a provider-tagged remote entry is ever present, it still\r\n  733:     carries no weights and must not trigger the local torch/CUDA teardown path.\r\n  734:     \"\"\"\r\n  735:     entry = LLM_CACHE.get(\"cache_entry\")\r\n  736:     if entry is None:\r\n  737:         return False\r\n  738:     if isinstance(entry, dict) and entry.get(\"provider\") in _REMOTE_CACHE_PROVIDERS:\r\n  739:         return False\r\n  740:     return True\r\n  741: \r\n  742: \r\n  743: def unload_llm_if_local_resident() -> bool:\r\n  744:     \"\"\"Unload only when a local LLM is actually resident.\r\n  745: \r\n  746:     Returns True when ``unload_llm()`` was called. Handoff callers use this to\r\n  747:     keep all-cloud LLM runs from importing torch just to clear an empty local\r\n  748:     allocator, while preserving ``unload_llm()`` for real local teardown and\r\n  749:     load-failure orphan cleanup.\r\n  750:     \"\"\"\r\n  751:     if not has_local_resident_llm():\r\n  752:   