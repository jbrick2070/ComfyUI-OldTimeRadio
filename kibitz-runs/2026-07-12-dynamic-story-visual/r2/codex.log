 call this helper. Kept for compatibility; do\r\n 258:     not wire new consumers to it without checking _otr_music_prompt first.\r\n 259:     \"\"\"\r\n 260:     m = _meta(meta)\r\n 261:     if get_story_brief_status(m) != \"ok\":\r\n 262:         return []\r\n 263:     terms = m.get(\"story_brief_terms\") or {}\r\n 264:     if not isinstance(terms, dict):\r\n 265:         return []\r\n 266:     atmosphere = terms.get(\"atmosphere\") or []\r\n 267:     if not isinstance(atmosphere, list):\r\n 268:         return []\r\n 269:     # Preserve order, intersect against vocab.\r\n 270:     out: list[str] = []\r\n 271:     for raw in atmosphere:\r\n 272:         t = str(raw).strip().lower()\r\n 273:         if t in _MUSIC_MOOD_VOCAB and t not in out:\r\n 274:             out.append(t)\r\n 275:     return out\r\n 276: \r\n 277: \r\n 278: # ---------------------------------------------------------------------------\r\n 279: # The prompt FINISHER (2026-06-10 brief-downstream gap audit, F1).\r\n 280: #\r\n 281: # The CW-1 teardown deleted otr_video_plan.py, the only consumer that appended\r\n 282: # the brief's era prose + the film style tail to visual prompts -- every\r\n 283: # post-refactor prompt rendered without them (gap G2/G3, roundtable-hardened\r\n 284: # fix docs/2026-06-10-brief-downstream-gaps/). These helpers restore that\r\n 285: # finishing as ONE shared seam. Pure functions: no logging here (the\r\n 286: # disposition log keeps its once-per-run contract at the NODE level), no\r\n 287: # dedupe, no style presets (3-model panel consensus cuts).\r\n 288: # ---------------------------------------------------------------------------\r\n 289: \r\n 290: # STAGE 3 (multi-modal story schema, 2026-07-05): the four tail constants\r\n 291: # below are the EXTRACTION FIXTURE for the sci_fi_radio visual-style pack\r\n 292: # (nodes/visual_styles/sci_fi_radio.json is pinned byte-identical to them by\r\n 293: # tests/test_visual_styles_3a.py). PRODUCTION prompt composition reads the\r\n 294: # PACK via _otr_visual_styles.get_visual_style(meta) -- an AST guard bans any\r\n 295: # other production read of these names. They also back the legacy no-style\r\n 296: # lane of get_era_tail (style=None) so pre-Stage-3 tests keep passing.\r\n 297: \r\n 298: #: Era-tail fallback when the brief is absent/failed/empty (legacy\r\n 299: #: _DEFAULT_ERA_TAIL, otr_video_plan.py).\r\n 300: ERA_TAIL_DEFAULT = \"timeless cinematic aesthetic\"\r\n 301: \r\n 302: #: The film aesthetic tail (legacy _DEFAULT_STYLE_TAIL, otr_video_plan.py).\r\n 303: STYLE_TAIL_DEFAULT = (\"cinematic, 35mm film look, subtle film grain, \"\r\n 304:                       \"volumetric lighting\")\r\n 305: \r\n 306: #: BUG-411 restore (2026-06-14): the 6/5 FLUX image pipeline\r\n 307: #: (visual/batch_flux_render.py) appended a RICHER cinematic grade than the\r\n 308: #: shared STYLE_TAIL_DEFAULT. The image-pipeline rewrite into\r\n 309: #: _otr_image_engines dropped the \"anamorphic lens, heavy vignette, muted color\r\n 310: #: grade, sharp focus\" grade descriptors (legacy _DEFAULT_STYLE_SUFFIX), which\r\n 311: #: flattened the look. Re-added on the IMAGE STILL path ONLY\r\n 312: #: (compose_still_prompt, after STYLE_TAIL_DEFAULT); the shared tail that LTX\r\n 313: #: scene clips + character video (style_tail=True) use stays untouched.\r\n 314: IMAGE_GRADE_TAIL = (\"anamorphic lens, heavy vignette, muted color grade, \"\r\n 315:                     \"sharp focus\")\r\n","exit_code":0,"status":"completed"}}
