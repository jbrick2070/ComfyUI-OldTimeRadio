 383: # Wiring-review #3 (2026-05-11): non-creating accessors for downstream\r\n 384: # nodes that should fail loud when called without a writer upstream.\r\n 385: # The cascade (OTR_LedgerFreezeCascade) uses these instead of\r\n 386: # get_ledger() so it never operates on an empty placeholder ledger.\r\n 387: \r\n 388: \r\n 389: def peek_ledger() -> Optional[\"Ledger\"]:\r\n 390:     \"\"\"Return the current ledger or None. Never creates a placeholder.\r\n 391: \r\n 392:     Use this from downstream nodes (reviewer, sequencer, audit\r\n 393:     artifacts) where an absent ledger is an error condition rather\r\n 394:     than a fresh-run signal.\r\n 395:     \"\"\"\r\n 396:     with _LEDGER_LOCK:\r\n 397:         return _CURRENT\r\n 398: \r\n 399: \r\n 400: class LedgerStampError(RuntimeError):\r\n 401:     \"\"\"S2 durable-persistence contract (credits enrichment 2026-07-03):\r\n 402:     a required credits stamp could not be persisted to the production\r\n 403:     ledger singleton. LOUD by design -- the late OTR_CreditsRoll node can\r\n 404:     only read what is on disk, so a silent save miss here becomes a\r\n 405:     missing-receipt failure at mux time. Never catch-and-continue.\"\"\"\r\n","exit_code":0,"status":"completed"}}
