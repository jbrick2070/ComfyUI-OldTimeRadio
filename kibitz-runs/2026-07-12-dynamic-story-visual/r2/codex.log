{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$start=130; $end=200; $i=0; Get-Content -LiteralPath '\"'nodes\\\\_otr_story_brief_helpers.py' | ForEach-Object { \"'$i++; if ($i -ge $start -and $i -le $end) { '\"'{0,4}: {1}' -f \"'$i, $_ } }'","aggregated_output":" 130:     if status in (\"ok\", \"failed\"):\r\n 131:         return status\r\n 132:     return \"absent\"\r\n 133: \r\n 134: \r\n 135: def get_story_brief_full(meta: Any) -> str:\r\n 136:     \"\"\"Full brief prose, empty string if absent or failed.\r\n 137: \r\n 138:     Returning \"\" on non-ok status lets consumers fall through to\r\n 139:     legacy prompt construction without branching on status -- a\r\n 140:     one-liner truthiness check (`if brief: ...`) does the right\r\n 141:     thing in both ok and non-ok cases.\r\n 142:     \"\"\"\r\n 143:     m = _meta(meta)\r\n 144:     if get_story_brief_status(m) != \"ok\":\r\n 145:         return \"\"\r\n 146:     return (m.get(\"story_brief\") or \"\").strip()\r\n 147: \r\n 148: \r\n 149: def get_story_brief_ltx(meta: Any, max_chars: int = 90) -> str:\r\n 150:     \"\"\"Brief fragment safe for LTX motion prompts.\r\n 151: \r\n 152:     Per refinement section 6.1: LTX motion budget is 220-240 chars\r\n 153:     total with 80-100 chars for the brief fragment. Default max_chars\r\n 154:     is 90 (centerpoint of the 80-100 window). Trimmed at the nearest\r\n 155:     sentence-end or clause-boundary before max_chars; NEVER mid-word.\r\n 156:     \"\"\"\r\n 157:     full = get_story_brief_full(meta)\r\n 158:     if not full or len(full) <= max_chars:\r\n 159:         return full\r\n 160: \r\n 161:     candidate = full[:max_chars]\r\n 162:     # Prefer sentence-end (. ! ?) then clause boundary (, ; :) then\r\n 163:     # word boundary. All inside the [0:max_chars] window.\r\n 164:     for sep in (\". \", \"! \", \"? \", \"; \", \", \", \": \", \" \"):\r\n 165:         idx = candidate.rfind(sep)\r\n 166:         if idx >= 20:  # avoid trimming so aggressively the brief is empty\r\n 167:             return candidate[: idx + (0 if sep == \" \" else 1)].rstrip()\r\n 168:     # Fall back: hard-trim and append ellipsis. Never returns mid-word\r\n 169:     # because the \" \" sep above catches that case.\r\n 170:     return candidate.rstrip()\r\n 171: \r\n 172: \r\n 173: def get_story_brief_lighting(meta: Any) -> str:\r\n 174:     \"\"\"lighting + atmosphere terms, comma-joined.\r\n 175: \r\n 176:     Per refinement section 6.2: portrait builders want lighting and\r\n 177:     atmosphere terms WITHOUT setting-terms noise (which would push\r\n 178:     the portrait prompt toward env composition). Returns empty\r\n 179:     string when the brief is absent or failed.\r\n 180:     \"\"\"\r\n 181:     m = _meta(meta)\r\n 182:     if get_story_brief_status(m) != \"ok\":\r\n 183:         return \"\"\r\n 184:     terms = m.get(\"story_brief_terms\") or {}\r\n 185:     if not isinstance(terms, dict):\r\n 186:         return \"\"\r\n 187:     lighting = [str(t).strip() for t in (terms.get(\"lighting\") or []) if str(t).strip()]\r\n 188:     atmosphere = [str(t).strip() for t in (terms.get(\"atmosphere\") or []) if str(t).strip()]\r\n 189:     return \", \".join(lighting + atmosphere)\r\n 190: \r\n 191: \r\n 192: def log_story_brief_disposition(meta: Any, consumer_id: str, log: Any) -> str:\r\n 193:     \"\"\"Sprint E E3 / H4: uniform one-line disposition log for every\r\n 194:     visual + audio consumer.\r\n 195: \r\n 196:     Returns the resolved status string so the caller can branch on it\r\n 197:     if needed. Each consumer calls this exactly ONCE per run with its\r\n 198:     own `log` (logging.Logger) and a string consumer_id from the\r\n 199:     canonical set (refreshed 2026-06-10 gap audit -- the legacy batch\r\n 200:     renderers are gone; the live consumers are):\r\n","exit_code":0,"status":"completed"}}
