=[])\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:393: if atmosphere_line:\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:394: parts.append(atmosphere_line)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:410: if atmosphere_line:\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:411: parts.append(atmosphere_line)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:422: if atmosphere_line:\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:423: parts.append(atmosphere_line)\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:590: def compose_still_prompt(meta: Any, *, kind: str, role: str = \"\",\r\nC:\\Users\\jeffr\\Documents\\ComfyUI\\custom_nodes\\ComfyUI-OldTimeRadio\\nodes\\_otr_story_brief_helpers.py:667: def finish_visual_prompt(meta: Any, prompt: str, *, max_chars: int = 0,\r\n===== 315-445 =====\r\n 315:                     \"sharp focus\")\r\n 316: \r\n 317: #: BUG-411: the 6/5 radio bookend / radio stills carried a broadcast-distress\r\n 318: #: identity suffix appended to every radio prompt (legacy _RADIO_PROMPT_SUFFIX);\r\n 319: #: the \"35mm film grain, broadcast-distressed\" grade IS the lush distressed\r\n 320: #: tint the operator wants back. Re-added to the radio scene stills\r\n 321: #: (open/announcer/music) so they read as a distressed period broadcast still.\r\n 322: RADIO_BROADCAST_TAIL = (\"35mm film grain, broadcast-distressed cinematic \"\r\n 323:                         \"aesthetic, centered composition\")\r\n 324: \r\n 325: #: The render-constraint clause the LTX scene prompts carry; preserved\r\n 326: #: verbatim through max_chars trimming.\r\n 327: NO_TEXT_CLAUSE = \"no on-screen text\"\r\n 328: \r\n 329: \r\n 330: def _resolve_style(meta: Any, style: Any = None):\r\n 331:     \"\"\"Stage 3: the one style-resolution helper the composer ENTRY seams\r\n 332:     call. ``style`` already-resolved => returned as-is (helpers never\r\n 333:     re-resolve, r4 contract). ``style=None`` => fail-loud\r\n 334:     ``get_visual_style(meta)`` -- unknown meta[\"visual_style\"] RAISES\r\n 335:     (UnknownVisualStyleError); absent/empty resolves the sci_fi_radio\r\n 336:     default byte-identically. NO swallow: a style-resolution error must\r\n 337:     fail the episode loud (no-fallback law).\"\"\"\r\n 338:     if style is not None:\r\n 339:         return style\r\n 340:     from ._otr_visual_styles import get_visual_style\r\n 341:     return get_visual_style(meta)\r\n 342: \r\n 343: \r\n 344: def get_era_tail(meta: Any, profile: str = \"full\", style: Any = None) -> str:\r\n 345:     \"\"\"The brief-derived era/aesthetic tail; NEVER empty*, never raises.\r\n 346: \r\n 347:     Stage 3: ``style`` is the RESOLVED VisualStyle whose ``era_tail``\r\n 348:     replaces the :data:`ERA_TAIL_DEFAULT` fallback string EXACTLY --\r\n 349:     including a pack-declared empty string (\"never empty\" is a\r\n 350:     sci_fi_radio-pack property, not a helper invariant; r4 pin). This\r\n 351:     function does NO loader lookup itself (the composer entry resolves once\r\n 352:     and passes the style down); ``style=None`` is the LEGACY lane and keeps\r\n 353:     the byte-identical ERA_TAIL_DEFAULT fallback -- production composers\r\n 354:     always pass ``style`` (AST-pinned).\r\n 355: \r\n 356:     ``profile=\"full\"`` (default; every pre-still-spine call site, behavior\r\n 357:     unchanged) ports the legacy ``_resolve_era_tail`` precedence (Sprint\r\n 358:     8.7): ``atmosphere_line`` -> ``visual_palette`` (top 3) -> v1\r\n 359:     lighting+atmosphere (:func:`get_story_brief_lighting`) -> the\r\n 360:     :data:`ERA_TAIL_DEFAULT` constant. v2 fields come through the canonical\r\n 361:     brief reader; every failure path degrades, fail-soft.\r\n 362: \r\n 363:     ``profile=\"still\"`` (still-spine ST-1): the TRIMMED tail for still-image\r\n 364:     prompts -- atmosphere line + palette top-2 + lighting top-2, capped at\r\n 365:     ~120 chars on a word boundary. Stills carry their subject up front; the\r\n 366:     full tail diet would push FLUX toward atmosphere soup. The per-episode\r\n 367:     palette color (e.g. Mars = red) comes through HERE by design -- the\r\n 368:     still profile trims the tail, never deletes it.\r\n 369:     \"\"\"\r\n 370:     _era_default = style.era_tail if style is not None else ERA_TAIL_DEFAULT\r\n 371:     atmosphere_line = \"\"\r\n 372:     palette: list[str] = []\r\n 373:     try:\r\n 374:         try:\r\n 375:             from ._otr_brief_reader import _read_brief_field  # type: ignore\r\n 376:         except ImportError:  # pragma: no cover -- flat test imports\r\n 377:             from _otr_brief_reader import _read_brief_field  # type: ignore\r\n 378:         raw_line = _read_brief_field(meta, \"atmosphere_line\", default=\"\")\r\n 379:         if isinstance(raw_line, str):\r\n 380:             atmosphere_line = raw_line.strip()\r\n 381:         raw_palette = _read_brief_field(meta, \"visual_palette\", default=[])\r\n 382:         if isinstance(raw_palette, list):\r\n 383:             palette = [str(t).strip() for t in raw_palette\r\n 384:                        if str(t).strip()][:3]\r\n 385:     except Exception:  # noqa: BLE001 -- reader unavailable -> v1-only\r\n 386:         pass\r\n 387:     if profile == \"portrait\":\r\n 388:         # Portrait era tail: NEVER includes the episode's ambient colour\r\n 389:         # palette (which skews blue on sci-fi, red on period drama and bleeds\r\n 390:         # directly into every character face). Lighting terms (quality/mood,\r\n 391:         # not palette colours) are safe and preserved (BUG-LOCAL-113).\r\n 392:         parts = []\r\n 393:         if atmosphere_line:\r\n 394:             parts.append(atmosphere_line)\r\n 395:         m2 = _meta(meta)\r\n 396:         terms2 = m2.get(\"story_brief_terms\") or {}\r\n 397:         if isinstance(terms2, dict):\r\n 398:             lighting = [str(t).strip() for t in (terms2.get(\"lighting\") or [])\r\n 399:                         if str(t).strip()]\r\n 400:             parts.extend(lighting)\r\n 401:         return \", \".join(parts) or _era_default\r\n 402:     if profile == \"still\":\r\n 403:         m = _meta(meta)\r\n 404:         terms = m.get(\"story_brief_terms\") or {}\r\n 405:         if not isinstance(terms, dict):\r\n 406:             terms = {}\r\n 407:         lighting = [str(t).strip() for t in (terms.get(\"lighting\") or [])\r\n 408:                     if str(t).strip()][:2]\r\n 409:         parts = []\r\n 410:         if atmosphere_line:\r\n 411:             parts.append(atmosphere_line)\r\n 412:         parts.extend(palette[:2])\r\n 413:         parts.extend(lighting)\r\n 414:         out = \", \".join(parts) or _era_default\r\n 415:         if len(out) > 120:                 # word-boundary trim (~120 chars)\r\n 416:             cut = out[:120]\r\n 417:             idx = cut.rfind(\" \")\r\n 418:             out = (cut[:idx] if idx >= 20 else cut).rstrip(\" ,\")\r\n 419:         return out\r\n 420:     v1_tail = (get_story_brief_lighting(meta) or \"\").strip()\r\n 421:     parts = []\r\n 422:     if atmosphere_line:\r\n 423:         parts.append(atmosphere_line)\r\n 424:     if palette:\r\n 425:         parts.extend(palette)\r\n 426:     if v1_tail:\r\n 427:         parts.append(v1_tail)\r\n 428:     return \", \".join(parts) or _era_default\r\n 429: \r\n 430: \r\n 431: # ---------------------------------------------------------------------------\r\n 432: # Still-spine ST-1 (2026-06-10): the shared OPEN SUBJECT + the 5-layer still\r\n 433: # prompt composer. The render driver's concrete radio-set subject wording\r\n 434: # MOVES here (one source of truth -- the driver's LTX text prompt and the\r\n 435: # scene STILL prompt for the same beat lead with the SAME subject string;\r\n 436: # the parity test in tests/test_still_spine_helpers.py locks it). Layer\r\n 437: # order restores the proven 6/5 composer (legacy otr_video_plan.py PASS-3:\r\n 438: # subject first, scene context, framing hint, era tail, style tail -- FLUX\r\n 439: # weights earlier tokens more heavily).\r\n 440: # ---------------------------------------------------------------------------\r\n 441: \r\n 442: # ---------------------------------------------------------------------------\r\n 443: # BRIEF-DRIVEN RADIO FORM (2026-07-01) -- kills the hardcoded-1940s anchors.\r\n 444: #\r\n 445: # A DETERMINISTIC brief -> radio-form-noun map (NO LLM: nondeterminism would\r\n===== 560-705 =====\r\n 560: \r\n 561: #: Framing hints (layer 3 of the 5-layer still composer). The macro framing\r\n 562: #: is the 6/5 look the operator wants back; the portrait framing matches the\r\n 563: #: round-5 three-quarter STYLE_ANCHOR decision (\"more body -- better\").\r\n 564: STILL_FRAMING_OPEN = \"full-frame macro, centered subject\"\r\n 565: STILL_FRAMING_PORTRAIT = (\"three-quarter framing, full head and shoulders with \"\r\n 566:                           \"clear headroom above, face unobstructed\")\r\n 567: #: Scene-BEAT framing (person beats, 2026-06-16 framing fix): the old scene path\r\n 568: #: reused STILL_FRAMING_OPEN (\"full-frame macro\") which has NO headroom directive\r\n 569: #: -> LTX i2v inherits the tight still and crops heads. Positive-only (FLUX plants\r\n 570: #: negated tokens -- the c01 lesson); keeps the operator's wider three-quarter\r\n 571: #: look, just guarantees the whole head + headroom. scene_open (the radio-set\r\n 572: #: object beat) KEEPS the macro -- no person, no head to frame.\r\n 573: STILL_FRAMING_SCENE_BEAT = (\"cinematic three-quarter framing, people shown with \"\r\n 574:                             \"full heads and clear headroom inside frame, faces \"\r\n 575:                             \"unobstructed, balanced composition\")\r\n 576: #: Scene-CHARACTER framing (BUG 1, 2026-06-20 operator directive): the LANDSCAPE\r\n 577: #: still-only character beat (still_flat / still_pan / ltx_video on a character\r\n 578: #: line). Leads with the CHARACTER (compose_still_prompt subject = appearance) in\r\n 579: #: a WIDE 16:9 environment shot -- a medium shot framing the person inside the\r\n 580: #: scene, NEVER the vertical portrait (which pillarboxes -> the radio-booth floor\r\n 581: #: fills the sides) and NEVER the generic radio-set scene subject. Positive-only\r\n 582: #: (FLUX plants negated tokens). The radio broadcast tail is dropped for this kind\r\n 583: #: so the frame reads as the character in their world, not an on-air booth.\r\n 584: STILL_FRAMING_SCENE_CHARACTER = (\r\n 585:     \"cinematic medium shot, the character framed within a wide 16:9 environment, \"\r\n 586:     \"full head and shoulders with clear headroom inside frame, face unobstructed, \"\r\n 587:     \"balanced landscape composition\")\r\n 588: \r\n 589: \r\n 590: def compose_still_prompt(meta: Any, *, kind: str, role: str = \"\",\r\n 591:                          beat_id: str = \"\", char_entry: Any = None,\r\n 592:                          style: Any = None) -> str:\r\n 593:     \"\"\"ONE still-image prompt in the legacy 5-layer order: subject /\r\n 594:     setting top-2 / framing hint / TRIMMED era tail (still profile) /\r\n 595:     style tail. Scene kinds append the :data:`NO_TEXT_CLAUSE` (a render\r\n 596:     constraint stills must carry; portraits never need it).\r\n 597: \r\n 598:     ``kind``: ``\"portrait\"`` leads with the character's own description\r\n 599:     (``portrait_prompt`` -> ``appearance`` -> ``character_description`` on\r\n 600:     ``char_entry``); ``\"scene_character\"`` (BUG 1, 2026-06-20) ALSO leads with\r\n 601:     the character description but composes a WIDE 16:9 medium shot (the landscape\r\n 602:     still-only character beat -- still_flat/still_pan/ltx_video) and DROPS the\r\n 603:     radio-booth tail; every other scene kind (``scene_open`` / ``scene_beat``)\r\n 604:     leads with :func:`get_open_subject` (``synthetic`` = kind==\"scene_open\"\r\n 605:     -- the b000 opening-music beat is the synthetic open). Never returns\r\n 606:     empty (the subject layer always exists). Stage 3: the tails come from\r\n 607:     the resolved visual-style pack (``style`` param, or a fail-loud\r\n 608:     ``get_visual_style(meta)`` when None -- a composer ENTRY seam); the\r\n 609:     broadcast tail additionally gates on ``pack.allow_radio_tails``. A\r\n 610:     style-resolution error RAISES (no-fallback law).\r\n 611:     \"\"\"\r\n 612:     _style = _resolve_style(meta, style)\r\n 613:     is_portrait = (kind == \"portrait\")\r\n 614:     is_char_scene = (kind == \"scene_character\")\r\n 615:     if is_portrait or is_char_scene:\r\n 616:         # Both lead with the CHARACTER's own description; scene_character just\r\n 617:         # frames them in a wide environment instead of a tight portrait.\r\n 618:         ce = char_entry if isinstance(char_entry, dict) else {}\r\n 619:         subject = str(ce.get(\"portrait_prompt\") or ce.get(\"appearance\")\r\n 620:                       or ce.get(\"character_description\") or \"\").strip()\r\n 621:         if not subject:\r\n 622:             subject = \"a period-dressed character, face clearly visible\"\r\n 623:     else:\r\n 624:         subject = get_open_subject(role, synthetic=(kind == \"scene_open\"),\r\n 625:                                    meta=meta, style=_style)\r\n 626:     m = _meta(meta)\r\n 627:     terms = m.get(\"story_brief_terms\") or {}\r\n 628:     if not isinstance(terms, dict):\r\n 629:         terms = {}\r\n 630:     setting = \", \".join([str(t).strip() for t in (terms.get(\"setting\") or [])\r\n 631:                          if str(t).strip()][:2])\r\n 632:     if is_portrait:\r\n 633:         framing = STILL_FRAMING_PORTRAIT\r\n 634:     elif is_char_scene:\r\n 635:         framing = STILL_FRAMING_SCENE_CHARACTER\r\n 636:     elif kind == \"scene_beat\":\r\n 637:         framing = STILL_FRAMING_SCENE_BEAT\r\n 638:     else:\r\n 639:         framing = STILL_FRAMING_OPEN\r\n 640:     pieces = [subject]\r\n 641:     if setting:\r\n 642:         pieces.append(setting)\r\n 643:     pieces.append(framing)\r\n 644:     pieces.append(get_era_tail(meta, profile=\"still\", style=_style))\r\n 645:     pieces.append(_style.positive_tail)\r\n 646:     if not is_portrait:\r\n 647:         # BUG-411: restore the 6/5 cinematic grade + the radio broadcast-distress\r\n 648:         # identity the image-pipeline rewrite dropped. Scene stills are all radio\r\n 649:         # context (open/announcer/music), so both tails apply; appended AFTER the\r\n 650:         # shared style tail and BEFORE the NO_TEXT_CLAUSE so the 5-layer\r\n 651:         # order and the no-text contract are preserved. Portraits are unchanged\r\n 652:         # (they keep their three-quarter framing + the shared style tail).\r\n 653:         # Stage 3: both come from the pack; empty strings vanish in the join.\r\n 654:         pieces.append(_style.image_grade_tail)\r\n 655:         # BUG 1 (2026-06-20): the character SCENE still is NOT a radio booth --\r\n 656:         # it shows the character in their world, so the broadcast-booth tail\r\n 657:         # (\"centered composition\", broadcast-distress) is dropped for this kind.\r\n 658:         # Stage 3: also gated by the pack's allow_radio_tails.\r\n 659:         if not is_char_scene and _style.allow_radio_tails:\r\n 660:             pieces.append(_style.broadcast_tail)\r\n 661:     out = \", \".join(p.strip().rstrip(\",\") for p in pieces if p and p.strip())\r\n 662:     if not is_portrait:\r\n 663:         out = f\"{out}, {NO_TEXT_CLAUSE}\"\r\n 664:     return out\r\n 665: \r\n 666: \r\n 667: def finish_visual_prompt(meta: Any, prompt: str, *, max_chars: int = 0,\r\n 668:                          style_tail: bool = True,\r\n 669:                          era_profile: str = \"full\",\r\n 670:                          style: Any = None) -> str:\r\n 671:     \"\"\"``prompt + \", \" + era_tail [+ \", \" + pack.positive_tail]`` -- the one\r\n 672:     shared finishing seam every visual prompt site calls.\r\n 673: \r\n 674:     Stage 3: the style tail + the era-tail default come from the resolved\r\n 675:     visual-style pack (``style`` param; None => fail-loud\r\n 676:     ``get_visual_style(meta)`` -- this IS a composer entry seam). A\r\n 677:     style-resolution error RAISES; callers must NOT wrap this in a bare\r\n 678:     except (AST-pinned, no-fallback law).\r\n 679: \r\n 680:     ``max_chars`` (0 = uncapped): word-boundary trim of the FINISHED string\r\n 681:     for budgeted consumers (LTX motion budget is 220-240 chars); a trailing\r\n 682:     :data:`NO_TEXT_CLAUSE` present in ``prompt`` survives the trim (it is a\r\n 683:     render constraint, not flavor). Callers run their guards BEFORE this and\r\n 684:     compute prompt hashes AFTER it. Pure; raises ONLY on a visual-style\r\n 685:     resolution failure (fail-loud by design); empty ``prompt``\r\n 686:     returns '' (finishing never invents a subject).\r\n 687: \r\n 688:     ``era_profile`` (LTX-I2V ticket Part A, 2026-06-11): passed through to\r\n 689:     :func:`get_era_tail`. Default ``\"full\"`` = every pre-existing call site,\r\n 690:     byte-identical. The LTX scene composer passes ``\"still\"`` so VIDEO\r\n 691:     prompts share the stills' trimmed palette diet (the full top-3 palette\r\n 692:     tail is what dragged LTX scene clips reddish while the FLUX stills,\r\n 693:     already on the still profile, stayed balanced).\r\n 694:     \"\"\"\r\n 695:     base = (prompt or \"\").strip().rstrip(\",\")\r\n 696:     if not b