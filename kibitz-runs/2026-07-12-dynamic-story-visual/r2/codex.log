937:           * text starts EMPTY for voiced beats (the composer will fill\r\n  938:             it via update_line_text) AND for music render-contract rows\r\n  939:             (never transcript text -- rip-sfx-broll 2026-07-01).\r\n  940:           * speaker_role, arc_phase, compose_flags are additive Phase\r\n  941:             2A / Phase 0 fields stamped at init time so the schema is\r\n  942:             uniform across rows.\r\n  943: \r\n  944:         Returns self so call sites can chain `.save()`.\r\n  945:         \"\"\"\r\n  946:         char_id_by_name = char_id_by_name or {}\r\n  947:         beats = list(getattr(outline, \"beats\", []) or [])\r\n  948:         rows: List[Dict[str, Any]] = []\r\n  949:         for beat in beats:\r\n  950:             def _g(k: str, default=\"\"):\r\n  951:                 if isinstance(beat, dict):\r\n  952:                     return beat.get(k, default)\r\n  953:                 return getattr(beat, k, default)\r\n  954:             beat_id = _safe_str(_g(\"beat_id\"))\r\n  955:             speaker = _safe_str(_g(\"speaker\"))\r\n  956:             role = _safe_str(_g(\"speaker_role\")) or \"character\"\r\n  957:             mood = _safe_str(_g(\"mood\"))\r\n  958:             intent = _safe_str(_g(\"intent\"))\r\n  959:             arc_phase = _safe_str(_g(\"arc_phase\"))\r\n  960:             # Script Doctor row fields (Sprint 3E, 2026-05-25): persist\r\n  961:             # the owning beat's narrative `intent` and Python-allocated\r\n  962:             # per-beat `target_words` on each line record so the\r\n  963:             # downstream Script Doctor cleanup pass receives the full\r\n  964:             # 7-field row. Both ride on the validated outline Beat\r\n  965:             # objects (`intent` Field + `target_words` Field; the\r\n  966:             # latter is stamped by the outline combiner's\r\n  967:             # `_allocate_phase_target_words` allocation). A genuinely\r\n  968:             # absent value stays None rather than being fabricated.\r\n  969:             _beat_intent_raw = _g(\"intent\", None)\r\n  970:             beat_intent = (\r\n  971:                 _safe_str(_beat_intent_raw) or None\r\n  972:                 if _beat_intent_raw is not None\r\n  973:                 else None\r\n  974:             )\r\n  975:             _target_words_raw = _g(\"target_words\", None)\r\n  976:             target_words = (\r\n  977:                 _safe_int(_target_words_raw)\r\n  978:                 if _target_words_raw is not None\r\n  979:                 else None\r\n  980:             )\r\n  981:             # Sprint 1 keystone (2026-05-28): copy dialogue_slot_id\r\n  982:             # from the outline beat onto the ledger line so\r\n  983:             # OTR_StoryRoomCommit can join StoryRoom dialogue rows by\r\n  984:             # slot id rather than raw beat_id. Voiced beats carry a\r\n  985:             # `d\\d{3}` id stamped by `stamp_dialogue_slot_ids`;\r\n  986:             # non-voiced beats (music_open / music_close /\r\n  987:             # music_inter) stay None. The getattr default keeps\r\n  988:             # the line schema additive -- pre-Sprint-1 outlines that\r\n  989:             # never ran through the stamper just produce None slots,\r\n  990:             # and the legacy compose path is byte-identical.\r\n  991:             dialogue_slot_id = _g(\"dialogue_slot_id\", None)\r\n  992:             if role == \"character\":\r\n  993:                 cid = char_id_by_name.get(speaker, \"\")\r\n  994:             elif role == \"announcer\":\r\n  995:                 cid = \"announcer\"\r\n  996:             else:\r\n  997:                 cid = role\r\n  998:             if is_spoken_role(role):\r\n  999:                 text = \"\"    # composer fills via update_line_text\r\n 1000:             else:\r\n 1001:                 # S1 (2026-06-22) + rip-sfx-broll (2026-07-01): non-spoken\r\n 1002:                 # render-contract rows (music_open / music_inter /\r\n 1003:                 # music_close) NEVER carry transcript text -- the old\r\n 1004:                 # intent fallback stamped filler like \"Musical interlude\r\n 1005:                 # bridging <phase>...\" into the transcript, and the\r\n 1006:                 # sfx_cue carrier died with the sfx subsystem. The beat\r\n 1007:                 # intent is still preserved separately in `beat_intent`\r\n 1008:                 # below for any visual/music-prompt consumer.\r\n 1009:                 text = \"\"\r\n 1010:             rows.append({\r\n 1011:                 \"line_id\":       beat_id,\r\n 1012:                 \"shot_id\":       None,\r\n 1013:                 \"beat_id\":       beat_id,\r\n 1014:                 \"char_id\":       cid,\r\n 1015:                 \"text\":          text,\r\n 1016:                 \"traits\":        mood or None,\r\n 1017:                 \"boundary\":      None,\r\n 1018:                 \"char_count\":    _char_count(text),\r\n 1019:                 \"word_count\":    _word_count(text),\r\n 1020:                 \"bark_wav_path\": None,\r\n 1021:                 \"start_s\":       None,\r\n 1022:                 \"dur_s\":         None,\r\n 1023:                 # Phase 0 / 2A additive fields (stamped at init time).\r\n 1024:                 \"speaker_role\":  role,\r\n 1025:                 \"arc_phase\":     arc_phase or None,\r\n 1026:                 \"compose_flags\": [],\r\n 1027:                 # Script Doctor row fields (Sprint 3E): the owning\r\n 1028:                 # beat's narrative intent + Python-allocated per-beat\r\n 1029:                 # target word count. None when the source beat does\r\n 1030:                 # not carry the value.\r\n 1031:                 \"beat_intent\":   beat_intent,\r\n 1032:                 \"target_words\":  target_words,\r\n 1033:                 # Sprint 1 keystone (2026-05-28): voiced slot id.\r\n 1034:                 \"dialogue_slot_id\": dialogue_slot_id,\r\n 1035:             })\r\n 1036:         self.data[\"lines\"] = rows\r\n 1037:         self._recompute_totals()\r\n 1038:         return self\r\n 1039: \r\n 1040:     def update_line_text(\r\n","exit_code":0,"status":"completed"}}
