legacy FLUX/HuMo/LTX render chain\r\n  __init__.py:201:    # it fed was unwired from otr_canonical.json in the same commit; the\r\n  __init__.py:202:    # type is in the workflow validator's DELETED_NODE_TYPES sentinel so a\r\n  __init__.py:204:    # OTR_FixedShotDurationStub -- registration REMOVED in the Chunk E\r\n  __init__.py:205:    # cleanbreak completion (2026-06-09; the module-level mapping was\r\n> __init__.py:206:    # already cleared 2026-06-08). OTR_ShotLock owns ALL per-episode\r\n  __init__.py:207:    # budget / shot-duration logic. The class + pure helpers stay in\r\n  __init__.py:208:    # nodes/otr_shot_duration_calculator.py for unit tests only; the type\r\n  __init__.py:209:    # is tombstoned in DELETED_NODE_TYPES so stale workflow JSONs fail\r\n  __init__.py:276:    \"OTR_VideoProbe\":              (\".nodes.otr_video_probe\",    \"OTRVideoProbe\",    \" Video Probe \r\n(usable engines + host caps)\"),\r\n  __init__.py:277:    \"OTR_VideoDirector\":           (\".nodes.otr_video_director\", \"OTRVideoDirector\", \" VideoDirector \r\n(per-role model select)\"),\r\n> __init__.py:278:    \"OTR_ShotLock\":                (\".nodes.otr_shot_lock\",      \"OTRShotLock\",      \" Shot Lock \r\n(video plan authority)\"),\r\n  __init__.py:279:\r\n  __init__.py:280:    # =========================================================================\r\n  __init__.py:281:    # v2.0 Image platform (Subproject C1) -- model-agnostic image-gen adapters,\r\n  __init__.py:286:    # =========================================================================\r\n  __init__.py:287:    \"OTR_ImageDirector\":           (\".nodes.otr_image_director\",          \"OTRImageDirector\",        \r\n   \" ImageDirector (per-role image model + granularity)\"),\r\n> __init__.py:288:    \"OTR_MetaBriefImagePromptGen\": (\".nodes.otr_meta_brief_image_prompt\", \r\n\"OTRMetaBriefImagePromptGen\", \" Meta-Brief Image Prompt Gen\"),\r\n> __init__.py:289:    \"OTR_ImageGenDispatcher\":     